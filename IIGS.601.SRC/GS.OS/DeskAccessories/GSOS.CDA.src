RY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_id		longa	on		longi	on						cmp	#$0015		; was key a right arrow?		beq	id_arrow	; yes				cmp	#$0008		; was key a left arrow?		beq	id_arrow	; yes		clc		rtsid_arrow				jsr	home		; clear screen		jsr	wait_vbl	; wait for vertical blanking time                pea     id_page>>16	; Display GS/OS user ID's                pea     id_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays all the GS/OS FST ID numbers** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_fst		longa	on		longi	on						cmp	#$0015		; was key a right arrow?		beq	fst_arrow	; yes				cmp	#$0008		; was key a left arrow?		beq	fst_arrow	; yes		clc		rtsfst_arrow			jsr	home		; clear screen		jsr	wait_vbl	; wait for vertical blanking time                pea     fst_page>>16	; Display GS/OS FST ID's                pea     fst_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays all the GS/OS FST headers.** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_fst_hdr		longa	on		longi	on						cmp	#$0015			; was key a right arrow?		beq	fst_hdr_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	fst_hdr_arrow		; yes				cmp	#$000A			; was key a down arrow?		bne	not_fst_dn		; no		dec	|cur_fst_num		; point at previous FST header		bra	fst_hdr_rdynot_fst_dn		cmp	#$000B			; was key an up arrow?		bne	not_fst_up		; no, all done here		inc	|cur_fst_num		; point at next FST		bra	fst_hdr_rdynot_fst_up		clc		rtsfst_hdr_arrow			jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     fst_hdr_page>>16	; Display GS/OS FST Headers                pea     fst_hdr_page                jsr     writecstringfst_hdr_rdy		pei	temp+2			; get some zero page		pei	temp		lda	>fst_table_ptr		sta	<temp		lda	>fst_table_ptr+2		sta	<temp+2				lda	|cur_fst_num		; is fst number in range?		beq	set_last_fst		; no		bmi	set_last_fst		; no		cmp	[<temp]		blt	have_fst_num		; yes		beq	have_fst_num		; yes		lda	#$0001			; else set to first		sta	|cur_fst_num		bra	have_fst_numset_last_fst		lda	[<temp]			; get last fst number & set it as current		sta	|cur_fst_numhave_fst_num		lda	|cur_fst_num		; create pointer into fst table		dec	a			; index = [(fst num - 1) * 16] +2		asl	a		asl	a		asl	a		asl	a		clc		adc	#$0002		tay				lda	[<temp],y		; set direct page pointer to current fst header		tax		iny		iny		lda	[<temp],y		sta	<temp+2		stx	<temp		lda	#3			; string position for name		sta	|cv		lda	#11		sta	|ch		ldy	#fst_hdr_string		; get FST string length		lda	[<temp],y		iny		and	#$001F		beq	fst_name_done		taxfst_name_loop		lda	[<temp],y		; get fst string character		and	#$007F		cmp	#$000D		bne	not_fst_cr		lda	#'@'not_fst_cr		jsr	writechar		; display it		iny		dex		bne	fst_name_loopfst_name_loop1		lda	|ch			; done enough?		cmp	#60		bge	fst_name_done				lda	#' '			; fill to end of line		jsr	writechar		bra	fst_name_loop1		fst_name_done		lda	#4			; display FST header base address		jsr	set_ch3		ldy	<temp+2		lda	<temp		jsr	display_long				lda	#5			; adjust cursor position		jsr	set_ch3				ldy	#fst_hdr_app		; index in fst header for application call entry		jsr	do_temp_long		lda	#6			; adjust cursor position		jsr	set_ch3				ldy	#fst_hdr_sys		; index in fst header for system call entry		jsr	do_temp_long		lda	#7			; adjust cursor position		jsr	set_ch4				ldy	#fst_hdr_id		; index in fst ID		jsr	do_temp_int		lda	#8			; adjust cursor position		jsr	set_ch4				ldy	#fst_hdr_flag		; index in fst flag		jsr	do_temp_int		lda	#9			; adjust cursor position		jsr	set_ch4				ldy	#fst_hdr_ver		; index in fst version		jsr	do_temp_int		lda	#10			; adjust cursor position		jsr	set_ch4				ldy	#fst_hdr_blk		; index in fst block size		jsr	do_temp_int		lda	#11			; adjust cursor position		jsr	set_ch3				ldy	#fst_hdr_max_blk	; index in fst maximum block count		jsr	do_temp_long		lda	#12			; adjust cursor position		jsr	set_ch3				ldy	#fst_hdr_min_blk	; index in fst minimum block count		jsr	do_temp_long		lda	#13			; adjust cursor position		jsr	set_ch3				ldy	#fst_hdr_max_f		; index in fst file size		jsr	do_temp_long		lda	#14			; adjust cursor position		jsr	set_ch3				ldy	#fst_hdr_res		; index in fst reserved		jsr	do_temp_long		pla		sta	<temp		pla		sta	<temp+2		clc		rts		cur_fst_num	dc.w	1			; number of current FST being displayed				eject******************************************************************* This routine displays the GS/OS traps** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_trap		longa	on		longi	on						cmp	#$0015			; was key a right arrow?		beq	trap_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	trap_arrow		; yes				cmp	#$0030			; is it a numeric?		blt	trap_exit		; no		cmp	#$0038		blt	trap_advancetrap_exit		clc		rtstrap_arrow			stz	|trap_pg_index		; start at base trap page		bra	trap_dispatch		trap_advance		and	#$0007			; set display page		sta	|trap_pg_indextrap_dispatch		jsr	home			; clear screen		jsr	wait_vbl		; wait until vertical retrace blanking time		lda	|trap_pg_index		; get display page address		asl	a		tax		lda	|trap_goto_tbl,x		pha				; address of function to dispatch to -1		txa		asl	a		tax		lda	|trap_pg_tbl+2,x	; screen page address		pha		lda	|trap_pg_tbl,x		pha                jsr     writecstring		; display pageno_trap		rts				; dispatch to function		ejectsys_call_trap	jsr	wait_word		; wait for call number		bcs	no_trap			; done if escaped		sta	|sys_call		tay				; is it a removal call?		beq	put_sys_trap		; yes				pea	sys_err_str>>16		; display error number prompt		pea	sys_err_str		jsr	writecstring		jsr	wait_word		; wait for error number		bcs	no_trap			; done if escaped		sta	|sys_err				pea	sys_cnt_str>>16		; display occurance number prompt		pea	sys_cnt_str		jsr	writecstring		jsr	wait_word		; wait for occurance number		bcs	no_trap			; done if escaped		sta	|sys_occuranceput_sys_trap		jsr	install_sys_trap	; go install or remove the trap		pea	trigger_str>>16		; display logic anaylizer trigger points		pea	trigger_str		jsr	writecstring		brl	say_trap_in				ejectdrvr_call_trap	jsr	wait_word		; wait for call number		bcs	drvr_installed		; done if escaped		sta	|drvr_call		tay				; is it a removal call?		beq	put_drvr_trap		; yes				pea	drvr_err_str>>16	; display error number prompt		pea	drvr_err_str		jsr	writecstring		jsr	wait_word		; wait for error number		bcs	drvr_installed		; done if escaped		sta	|drvr_err				pea	drvr_dev_str>>16	; display device number prompt		pea	drvr_dev_str		jsr	writecstring		jsr	wait_word		; wait for device number		bcs	drvr_installed		; done if escaped		sta	|drvr_dev				pea	drvr_blk_str>>16	; display block number prompt		pea	drvr_blk_str		jsr	writecstring		jsr	wait_long		; wait for block number		bcs	drvr_installed		; done if escaped		sta	|drvr_blk		stx	|drvr_blk+2				pea	drvr_cnt_str>>16	; display occurance number prompt		pea	drvr_cnt_str		jsr	writecstring		jsr	wait_word		; wait for occurance number		bcs	drvr_installed		; done if escaped		sta	|drvr_occuranceput_drvr_trap		jsr	install_drvr_trap	; go install or remove the trapdrvr_installed				brl	say_trap_in				ejectsup_call_trap	jsr	wait_word		; wait for call number		bcs	sup_installed		; done if escaped		sta	|sup_call		tay				; is it a removal call?		beq	put_sup_trap		; yes				pea	sup_err_str>>16		; display error number prompt		pea	sup_err_str		jsr	writecstring		jsr	wait_word		; wait for error number		bcs	sup_installed		; done if escaped		sta	|sup_err				pea	sup_num_str>>16		; display supervisor number prompt		pea	sup_num_str		jsr	writecstring		jsr	wait_word		; wait for supervisor number		bcs	sup_installed		; done if escaped		sta	|sup_num				pea	sup_cnt_str>>16		; display occurance number prompt		pea	sup_cnt_str		jsr	writecstring		jsr	wait_word		; wait for occurance number		bcs	sup_installed		; done if escaped		sta	|sup_occuranceput_sup_trap		jsr	install_sup_trap	; go install or remove the trapsup_installed				brl	say_trap_in		os_queue_trap	jsr	wait_word		; wait for queue number		bcs	queue_installed		; done if escaped		sta	|queue_numqueue_installed			say_trap_in	pea	trap_in_str>>16		; display message indicating trap is installed		pea	trap_in_str		jsr	writecstring		clc		rts				ejecttrap_pg_index	dc.w	0trap_pg_tbl	dc.l	trap_page		; 0 = main trap menu		dc.l	systrap_page		; 1 = system call trap menu		dc.l	drvrtrap_page		; 2 = driver call trap menu		dc.l	suptrap_page		; 3 = supervisor call trap menu		dc.l	queue_trap		; 4 = OS queue trap menu		dc.l	trap_page		; 5 = main trap menu (unimplemented)		dc.l	trap_page		; 6 = main trap menu (unimplemented)		dc.l	trap_page		; 7 = main trap menu (unimplemented)		trap_goto_tbl	dc.w	no_trap-1		; 0 = main trap menu item		dc.w	sys_call_trap-1		; 1 = system call trap menu		dc.w	drvr_call_trap-1	; 2 = driver call trap menu		dc.w	sup_call_trap-1		; 3 = supervisor call trap menu		dc.w	os_queue_trap-1		; 4 = OS queue call trap menu		dc.w	no_trap-1		; 5 = system call trap menu		dc.w	no_trap-1		; 6 = system call trap menu		dc.w	no_trap-1		; 7 = system call trap menu		sys_call	dc.w	0			; system call number for trapsys_err		dc.w	0			; system error number for trapsys_occurance	dc.w	0			; system occurance number for trapdrvr_call	dc.w	0			; driver call number for trapdrvr_err	dc.w	0			; driver error number for trapdrvr_dev	dc.w	0			; driver device number for trapdrvr_blk	dc.l	0			; driver block number for trapdrvr_occurance	dc.w	0			; driver occurance number for trapsup_call	dc.w	0			; supervisor call number for trapsup_err		dc.w	0			; supervisor error number for trapsup_num		dc.w	0			; supervisor number for trapsup_occurance	dc.w	0			; supervisor occurance number for trapqueue_num	dc.w	0			; OS queue number for trap				eject******************************************************************* This entry point is for running the desk accessory.  It * installs or removes the trap from the GS/OS inline and* stack based entry points dependending on whether the trap* is currently installed.  If currently installed, the trap* will be removed.  If currently not installed, the trap will* be installed.** ENTRY: Call via 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************install_sys_trap		longa	on		longi	on				lda	|sys_call		; is this a request to remove the trap?		beq	remove_sys_trap		; yes				bit	|sys_trap_flag		; is trap installed?		bpl	install_sys_1		; no		rts** Install the trap.*install_sys_1	dec	|sys_trap_flag		; indicate trap is installed				lda	>os_entry+1		; preserve original inline entry		sta	|os_call+1		lda	>os_entry+2		sta	|os_call+2				lda	#inline_trap		; install inline trap in inline entry		sta	>os_entry+1		lda	#inline_trap>>8		sta	>os_entry+2		lda	>os_stk_entry+1		; preserve original stack entry		sta	|os_stk_call+1		lda	>os_stk_entry+2		sta	|os_stk_call+2				lda	#stk_trap		; install stack trap in stack entry		sta	>os_stk_entry+1		lda	#stk_trap>>8		sta	>os_stk_entry+2		rts		eject** Remove the system call trap.*remove_sys_trap	bit	|sys_trap_flag		; is trap installed?		bmi	remove_sys_1		; yes, go remove it		rts		remove_sys_1	lda	|os_call+1		; remove error trap from inline entry		sta	>os_entry+1		lda	|os_call+2		sta	>os_entry+2		lda	|os_stk_call+1		; remove error trap from stack entry		sta	>os_stk_entry+1		lda	|os_stk_call+2		sta	>os_stk_entry+2				stz	|sys_trap_flag		; indicate trap not installed		rtssys_trap_flag	dc.w	0			; 0 = trap not installed, -1 = trap installed				eject******************************************************************* The is the entry point to the trap.  This entry point reads * the current call parameters stack relative to create it's * own call to the operating system.  The return address on the * stack is modified to return to the application at the address* one past the application's call parameters.** INLINE ENTRY: $E100A8**	sp+5	K	; PC = (call number-1)*	sp+4	PCH*	sp+3	PCL ---------->	*	sp+2	PSTAT		Call Number (msb)*	sp+1	BANK		Call Number (lsb)*	SP ---->		Parm Block Ptr (msb, msw)*				Parm Block Ptr (lsb, msw)*				Parm Block Ptr (msb, lsw)*				Parm Block Ptr (lsb, lsw)** ENTRY: Call via 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************inline_trap			longa	on		longi	on				php				; preserve application environment		phb				rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on				lda	3,s			; get address of call number -1		tax		lda	4,s		pha		plb		plb				lda	|1,x			; transfer call number from app to our call		sta	>call_num		lda	|3,x			; transfer parm blk ptr from app to our call		sta	>plist		lda	|5,x		sta	>plist+2				clc				; adjust return address + 6		lda	3,s		adc	#6		sta	3,s				sep	#$20		longa	off				lda	5,s		adc	#0		sta	5,s				rep	#$20		longa	on				lda	>call_num		; do logic analyzer trigger		tax				sep	#$20		longa	off				sta	>$F80000,x				rep	#$20		longa	onos_call		jsl	>$000000		; trap GS/OS system callcall_num	dc.w	0			; trap GS/OS call numberplist		dc.l	0			; trap GS/OS parameter block pointeros_return	php		phd		pha		phx		phy				jsr	chk_sys_trap		; check if trap should be displayed		bcs	no_sys_trap		; dont display this call				sep	#$20			; 8 bit 'm'		longa	off				lda	>$E0C068		; set for ram read		pha		and	#%11110111		sta	>$E0C068				rep	#$20			; 16 bit 'm'		longa	on				lda	>call_num		; obtain call number for display		pha		pea	str_val>>16		; location in string to display call number		pea	str_val		pea	$0004			; length of call number		ldx	#$220B			; int2hex		jsl	tool_locator				pea	$0000			; substitution string #1		pea	str_0FF>>16		pea	str_0FF		jsl	full_error				sep	#$20			; 8 bit 'm'		longa	off				pla				; restore ram state		sta	>$E0C068no_sys_trap		lda	9,s			; get error status		ror	a			; and generate an error flag		php		lda	12,s			; and preserve for exit		ror	a		plp		rol	a		sta	11,s				rep	#$20			; 16 bit 'm'		longa	on				ply		plx		pla		pld		plp		plb		plp		rtl				eject******************************************************************* The is the entry point to the stack trap.  This entry point reads * the current call parameters stack relative to create it's * own call to the operating system.  The return address on the * stack is modified to return to the application at the address* one past the application's call parameters.** STACK ENTRY: $E100B0**	sp+9	PARAMETER BLOCK (msb, msw)*	sp+8	PARAMETER BLOCK (lsb, msw)*	sp+7	PARAMETER BLOCK (msb, lsw)*	sp+6	PARAMETER BLOCK (lsb, lsw)*	sp+5	CALL NUMBER (msb)*	sp+4	CALL NUMBER (lsb)*	sp+3	K	*	sp+2	PCH*	sp+1	PCL*	SP ---->** ENTRY: Call via 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************stk_trap			longa	on		longi	on		php				; preserve application processor mode		lda	1,s		and	#$00FE			; but clear carry		sta	>app_mode		plp				rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on				lda	8,s			; push parameter list pointer (msw)		pha		lda	8,s			; push parameter list pointer (lsw)		pha		lda	8,s			; push call number		pha		tax				; do logic analyzer trigger				sep	#$20		longa	off				sta	>$F80000,x				rep	#$20		longa	onos_stk_call	jsl	>$000000		; trap GS/OS system callos_stk_return	php		pha		phd				jsr	chk_sys_trap		; check if trap should be displayed		bcs	no_stk_trap		; dont display this call				sep	#$20			; 8 bit 'm'		longa	off				lda	>$E0C068		; set for ram read		pha		and	#%11110111		sta	>$e0c068				rep	#$20			; 16 bit 'm'		longa	on				lda	10,s			; obtain call number for display		pha		pea	stk_val>>16		; location in string to display call number		pea	stk_val		pea	$0004			; length of call number		ldx	#$220B			; int2hex		jsl	tool_locator				pea	$0000			; substitution string #1		pea	str_stk>>16		pea	str_stk		jsl	full_error				sep	#$20			; 8 bit 'm'		longa	off				pla				; restore ram state		sta	>$E0C068no_stk_trap		rep	#$20			; 16 bit 'm'		longa	on				tsc		tcd				ldx	#6			; stack pointermove_stk_parms		lda	<1,x			; remove inline parameters from stack		sta	<7,x		dex		dex		bpl	move_stk_parms				clc				; adjust stack pointer		tsc		adc	#6		tcs				pld				; restore state & exit				lda	3,s			; get carry from current call exit		and	#$FF01				ora	>app_mode		; restore mode with carry from current call exit		sta	3,s				pla		plp		rtl		app_mode	dc.w	0			; processor mode of application		eject******************************************************************* This routine checks to see if the system call trap should* be displayed based on the trap call number, error number* and occurance count.** ENTRY: Call via 'JSR'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error occured*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error occured** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if trap should not be displayed*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if trap should be displayed******************************************************************chk_sys_trap		longa	on		longi	on				phb		phd		phk		plb		pea	gsos_dir_page		pld				lda	<call_number		; do logic analyzer trigger for exit		tax				sep	#$20		longa	off				sta	>$F90000,x				rep	#$20		longa	on				stz	|sys_err_num		; assume no error occured		bcc	assume_no_err		; if assumption was correct		sta	|sys_err_num		; save the current error codeassume_no_err		lda	|sys_call		; is there a specific call?		bmi	chk_sys_err		; no, it's a wild card		cmp	<call_number		; else was this the correct call?		bne	no_sys_display		; nochk_sys_err		lda	|sys_err		; is error trap on?		bmi	chk_sys_occur		; no if wild card, display anything		cmp	|sys_err_num		; else did the error match?		bne	no_sys_display		; no, dont display the trapchk_sys_occur		inc	|sys_occur_cnt		lda	|sys_occurance		; are occurances enabled?		beq	sys_display		; no, display it anyway		cmp	|sys_occur_cnt		; else, is this the correct occurance?		bne	no_sys_display		; no, dont display the trapsys_display		stz	|sys_occur_cnt		; restart occurance count		pld		plb		clc				; display the trap		rts		no_sys_display		pld		plb		sec				; dont display the trap		rts		sys_err_num	dc.w	0			; running error codesys_occur_cnt	dc.w	0			; running count of occurances		eject******************************************************************* This entry point installs or removes the driver call trap.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************install_drvr_trap		longa	on		longi	on				lda	|drvr_call		; is this a request to remove the trap?		beq	remove_drvr_trap	; yes				bit	|drvr_trap_flag		; is trap installed?		bpl	install_drvr_1		; no		rts** Install the trap.*install_drvr_1	dec	|sys_trap_flag		; indicate trap is installed				lda	>dev_dispatcher+1	; preserve original inline entry		sta	|device_call+1		lda	>dev_dispatcher+2		sta	|device_call+2				lda	#dev_trap		; install inline trap in inline entry		sta	>dev_dispatcher+1		lda	#dev_trap>>8		sta	>dev_dispatcher+2		rts		eject** Remove the driver call trap.*remove_drvr_trap			bit	|drvr_trap_flag		; is trap installed?		bmi	remove_drvr_1		; yes, go remove it		rts		remove_drvr_1	lda	|device_call+1		; remove error trap from inline entry		sta	>dev_dispatcher+1		lda	|device_call+2		sta	>dev_dispatcher+2		stz	|sys_trap_flag		; indicate trap not installed		rtsdrvr_trap_flag	dc.w	0			; 0 = trap not installed, -1 = trap installed				eject******************************************************************* The is the entry point for the driver the trap.** ENTRY: Call via 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************dev_trap			longa	on		longi	on		device_call		jsl	$000000			; call the real device dispatcher				php				; preserve application environment		pha		phd		pea	gsos_dir_page		pld		jsr	chk_drvr_trap		; check if trap should be displayed		bcs	no_drvr_trap		; dont display this call		lda	<drvr_call_num		; obtain call number for display		pha		pea	drvr_val>>16		; location in string to display call number		pea	drvr_val		pea	$0004			; length of call number		ldx	#$220B			; int2hex		jsl	tool_locator				pea	$0000			; substitution string #1		pea	driver_string>>16		pea	driver_string		jsl	full_error		no_drvr_trap		pld		pla		plp		rtl				eject******************************************************************* This routine checks to see if the driver call trap should* be displayed based on the trap call number, error number* device number and occurance count.** ENTRY: Call via 'JSR'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error occured*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error occured** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if trap should not be displayed*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if trap should be displayed******************************************************************chk_drvr_trap		phb		phd		phk		plb		pea	gsos_dir_page		pld				stz	|drvr_err_num	; assume no error occured		bcc	drvr_no_err	; if assumption was correct		sta	|drvr_err_num	; save the current error codedrvr_no_err		lda	|drvr_call	; is there a specific call?		bmi	chk_drvr_err	; no, it's a wild card		cmp	<drvr_call_num	; else was this the correct call?		bne	no_drvr_display	; nochk_drvr_err		lda	|drvr_err	; is error trap on?		bmi	chk_drvr_num	; no if wild card, display anything		cmp	|drvr_err_num	; else did the error match?		bne	no_drvr_display	; no, dont display the trapchk_drvr_num		lda	|drvr_dev	; is this the correct device?		beq	chk_blk_num	; don't care		cmp	<drvr_dev_num		bne	no_drvr_display	; dont display if wrong device numberchk_blk_num		lda	|drvr_blk	; should block number be checked?		and	|drvr_blk+2		cmp	#$FFFF		beq	drvr_display	; dont care, go display trap		lda	|drvr_blk		cmp	<drvr_blk_num		bne	no_drvr_display		lda	|drvr_blk+2		cmp	<drvr_blk_num+2		bne	no_drvr_displaychk_drvr_occur		inc	|drvr_occur_cnt		lda	|drvr_occurance	; are occurances enabled?		beq	drvr_display	; no, display it anyway		cmp	|drvr_occur_cnt	; else, is this the correct occurance?		bne	no_drvr_display	; no, dont display the trapdrvr_display		stz	|drvr_occur_cnt	; restart occurance count		pld		plb		clc			; display the trap		rts		no_drvr_display		pld		plb		sec			; dont display the trap		rts		drvr_err_num	dc.w	0		; running error codedrvr_occur_cnt	dc.w	0		; running count of occurances		eject******************************************************************* This entry point installs or removes the supervisor call trap.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************install_sup_trap		longa	on		longi	on				lda	|sup_call		; is this a request to remove the trap?		beq	remove_sup_trap		; yes				bit	|sup_trap_flag		; is trap installed?		bpl	install_sup_1		; no		rts** Install the trap.*install_sup_1	dec	|sys_trap_flag		; indicate trap is installed				lda	>sup_drvr_disp+1	; preserve original inline entry		sta	|supervisor_call+1		lda	>sup_drvr_disp+2		sta	|supervisor_call+2				lda	#sup_trap		; install inline trap in inline entry		sta	>sup_drvr_disp+1		lda	#sup_trap>>8		sta	>sup_drvr_disp+2		rts		eject** Remove the driver call trap.*remove_sup_trap			bit	|sup_trap_flag		; is trap installed?		bmi	remove_sup_1		; yes, go remove it		rts		remove_sup_1	lda	|supervisor_call+1	; remove error trap from inline entry		sta	>sup_drvr_disp+1		lda	|supervisor_call+2		sta	>sup_drvr_disp+2		stz	|sys_trap_flag		; indicate trap not installed		rtssup_trap_flag	dc.w	0			; 0 = trap not installed, -1 = trap installed				eject******************************************************************* The is the entry point for the supervisor the trap.** ENTRY: Call via 'JSL'*               A Reg = Supervisor Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************sup_trap			longa	on		longi	on		sta	>cur_sup_call		; preserve current supervisor call numbersupervisor_call		jsl	$000000			; call the real device dispatcher		php				; preserve application environment		pha		jsr	chk_sup_trap		; check if trap should be displayed		bcs	no_sup_trap		; dont display this call		lda	>sup_num		; obtain call number for display		pha		pea	sup_val>>16		; location in string to display call number		pea	sup_val		pea	$0004			; length of call number		ldx	#$220B			; int2hex		jsl	tool_locator				pea	$0000			; substitution string #1		pea	sup_string>>16		pea	sup_string		jsl	full_error		no_sup_trap		pla		plp		rtl				eject******************************************************************* This routine checks to see if the supervisor call trap should* be displayed based on the trap call number, error number* supervisor number and occurance count.** ENTRY: Call via 'JSR'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error occured*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error occured** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if trap should not be displayed*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if trap should be displayed******************************************************************chk_sup_trap		phb		phd		phk		plb		pea	gsos_dir_page		pld				stz	|sup_err_num	; assume no error occured		bcc	sup_no_err	; if assumption was correct		sta	|sup_err_num	; save the current error codesup_no_err		lda	|sup_call	; is there a specific call?		bmi	chk_sup_err	; no, it's a wild card		cmp	|cur_sup_call	; else was this the correct call?		bne	no_sup_display	; nochk_sup_err		lda	|sup_err	; is error trap on?		bmi	chk_sup_num	; no if wild card, display anything		cmp	|sup_err_num	; else did the error match?		bne	no_sup_display	; no, dont display the trapchk_sup_num		lda	|sup_num	; is this the correct device?		beq	chk_sup_occur	; don't care		cmp	<drvr_dev_num		bne	no_sup_display	; dont display if wrong device numberchk_sup_occur		inc	|sup_occur_cnt		lda	|sup_occurance	; are occurances enabled?		beq	sup_display	; no, display it anyway		cmp	|sup_occur_cnt	; else, is this the correct occurance?		bne	no_sup_display	; no, dont display the trapsup_display		stz	|sup_occur_cnt	; restart occurance count		pld		plb		clc			; display the trap		rts		no_sup_display		pld		plb		sec			; dont display the trap		rts		cur_sup_call	dc.w	0		; running supervisor call numbersup_err_num	dc.w	0		; running error codesup_occur_cnt	dc.w	0		; running count of occurances		eject******************************************************************* This routine checks to see if the queue trap should* be displayed based on the queue event code.** ENTRY: Call via 'JSR'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error occured*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error occured** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if trap should not be displayed*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if trap should be displayed******************************************************************chk_queue_trap		phb		phd		phk		plb		pea	gsos_dir_page		pld				pld		plb		clc			; display the trap		rts		no_q_display		pld		plb		sec			; dont display the trap		rts				eject******************************************************************* This routine displays device information block.** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_dib_pg		longa	on		longi	on		cmp	#$0015		; was key a right arrow?		beq	p3_arrow	; yes				cmp	#$0008		; was key a left arrow?		beq	p3_arrow	; yes		cmp	#$000A		; is it an down arrow?		bne	not_p3_down	; no				dec	<drvr_dev_num	; else decrement device number		bne	p3_ready	; if device number is valid				lda	[<drvr_dev_ptr]	; else point at last device in list		sta	<drvr_dev_num		bra	p3_ready		not_p3_down				cmp	#$000B		; is it an up arrow?		bne	p3_ready	; no				inc	<drvr_dev_num	; else increment device number		lda	<drvr_dev_num	; at end of device list?		cmp	[<drvr_dev_ptr]		blt	p3_ready	; no		beq	p3_ready	; no				lda	#$0001		; else point at first device in list		sta	<drvr_dev_nump3_ready			jsr	set_dib_ptr	; point at current DIB		jsr	wait_vbl	; wait for vertical blanking time		bra	p3_changedp3_arrow				jsr	home		; clear screen		jsr	wait_vbl	; wait for vertical blanking time                pea     cda_page3>>16	; Display Device Information Block                pea     cda_page3                jsr     writecstringp3_changed				lda	#4		; adjust cursor position		jsr	set_ch2		                lda     <drvr_dev_num                jsr     display_int		lda	#4		; adjust cursor position		jsr	set_ch3		                ldy     #link_ptr+2                lda     [<drvr_dib_ptr],y                pha                dey                dey                lda     [<drvr_dib_ptr],y                ply                jsr     display_long		lda	#5		; adjust cursor position		jsr	set_ch2		                lda     <drvr_call_num                jsr     display_int		lda	#5		; adjust cursor position		jsr	set_ch3		                ldy     #entry_ptr+2                lda     [<drvr_dib_ptr],y                pha                dey                dey                lda     [<drvr_dib_ptr],y                ply                jsr     display_long		lda	#6		; adjust cursor position		jsr	set_ch1		                lda     <drvr_buf_ptr                ldy     <drvr_buf_ptr+2                jsr     display_long		lda	#6		; adjust cursor position		jsr	set_ch4		                ldy     #dev_char                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#7		; adjust cursor position		jsr	set_ch1		                lda     <drvr_req_cnt                ldy     <drvr_req_cnt+2                jsr     display_long		lda	#7		; adjust cursor position		jsr	set_ch3		                ldy     #blk_cnt+2                lda     [<drvr_dib_ptr],y                pha                dey                dey                lda     [<drvr_dib_ptr],y                ply                jsr     display_long		lda	#8		; adjust cursor position		jsr	set_ch1		                lda     <drvr_tran_cnt                ldy     <drvr_tran_cnt+2                jsr     display_long		lda	#8		; adjust cursor position		jsr	set_ch3				ldy	#dev_name+1		ldx	#0copy_name_loop		lda	[<drvr_dib_ptr],y		sta	|cda_mem,x		iny		iny		inx		inx		cpx	#20		bne	copy_name_loop                txa     		; number of characters to display                jsr	writeblock		lda	#9		; adjust cursor position		jsr	set_ch1		                lda     <drvr_blk_num                ldy     <drvr_blk_num+2                jsr     display_long		lda	#9		; adjust cursor position		jsr	set_ch4		                ldy     #slot_num                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#10		; adjust cursor position		jsr	set_ch2		                lda     <drvr_blk_size                jsr     display_int		lda	#10		; adjust cursor position		jsr	set_ch4		                ldy     #unit_num                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#11		; adjust cursor position		jsr	set_ch2		                lda     <drvr_fst_num                jsr     display_int		lda	#11		; adjust cursor position		jsr	set_ch4		                ldy     #ver_num                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#12		; adjust cursor position		jsr	set_ch2		                lda     <drvr_vol_id                jsr     display_int		lda	#12		; adjust cursor position		jsr	set_ch4		                ldy     #dev_id_num                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#13		; adjust cursor position		jsr	set_ch2		                lda     <drvr_cache                jsr     display_int		lda	#13		; adjust cursor position		jsr	set_ch4		                ldy     #head_link                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#14		; adjust cursor position		jsr	set_ch1		                lda     <drvr_cach_ptr                ldy     <drvr_cach_ptr+2                jsr     display_long		lda	#14		; adjust cursor position		jsr	set_ch4		                ldy     #forward_link                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#15		; adjust cursor position		jsr	set_ch1		                lda     <drvr_dib_ptr                ldy     <drvr_dib_ptr+2                jsr     display_long		lda	#15		; adjust cursor position		jsr	set_ch3		                ldy     #ext_dib_ptr+2	; get extended DIB pointer                lda     [<drvr_dib_ptr],y		pha		dey		dey                lda     [<drvr_dib_ptr],y		ply                jsr     display_long		lda	#16		; adjust cursor position		jsr	set_ch1		                ldy     #$0002		; number of DIBs                lda     [<drvr_dev_ptr],y                tay                lda     [<drvr_dev_ptr]                jsr     display_long		lda	#16		; adjust cursor position		jsr	set_ch4		                ldy     #dib_dev_num	; DIB device number                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#17		; adjust cursor position		jsr	set_ch4		                ldy     #drvr_class                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#18		; adjust cursor position		jsr	set_ch2		                lda     <drvr_dev_num	; device number		dec	a		asl	a		asl	a		asl	a		clc		adc	#$000A		tay			; point at user ID		lda	[<drvr_dev_ptr],y                jsr     display_int		lda	#18		; adjust cursor position		jsr	set_ch4		                ldy     #drvr_type                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#19		; adjust cursor position		jsr	set_ch2		                lda     <drvr_dev_num	; device number		dec	a		asl	a		asl	a		asl	a		clc		adc	#$0008		tay			; point at disk switch		lda	[<drvr_dev_ptr],y                jsr     display_int		lda	#19		; adjust cursor position		jsr	set_ch4		                ldy     #drvr_subtype                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#20		; adjust cursor position		jsr	set_ch4		                ldy     #cache_mask                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#21		; adjust cursor position		jsr	set_ch1		lda	<post_drvr_tbl		ldy	<post_drvr_tbl+2                jsr     display_long		lda	#21		; adjust cursor position		jsr	set_ch4		                ldy     #block_size                lda     [<drvr_dib_ptr],y                jsr     display_int		lda	#22		; adjust cursor position		jsr	set_ch1		lda	<drvr_dev_ptr		ldy	<drvr_dev_ptr+2                jsr     display_long		lda	#22		; adjust cursor position		jsr	set_ch4		                ldy     #hardware_unit                lda     [<drvr_dib_ptr],y                jsr     display_int		clc		rts				eject******************************************************************* This routine displays Supervisor Information Block.** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_sib_pg		longa	on		longi	on				cmp	#$0015		; was key a right arrow?		beq	p4_arrow	; yes				cmp	#$0008		; was key a left arrow?		beq	p4_arrow	; yes		cmp	#$000A		; is it an down arrow?		bne	not_p4_up	; no				dec	|sib_num	; else decrement supervisor number		bmi	adjust_sib_num		bne	p4_ready	; if device number is validadjust_sib_num				lda	[<sup_drvr_ptr]	; else point at last supervisor in list		sta	|sib_num		bra	p4_readynot_p4_up				cmp	#$000B		; is it an up arrow?		bne	p4_ready	; no				inc	|sib_num	; else increment supervisor number		lda	[<sup_drvr_ptr]	; at end of supervisor list?		cmp	|sib_num		bge	p4_ready	; no				lda	#$0001		; else point at supervisor device in list		sta	|sib_num		lda	[<sup_drvr_ptr]	; are there any sibs?		bne	p4_ready		stz	|sib_nump4_ready			jsr	set_sib_ptr	; point at current SIB		jsr	wait_vbl	; wait for vertical blanking time		bra	p4_changed		p4_arrow		jsr	home		; clear screen		jsr	wait_vbl	; wait for vertical blanking time		pea     cda_page4>>16	; Display GS/OS Direct Page                pea     cda_page4                jsr     writecstringp4_changed		lda	[<sup_drvr_ptr]	; are there any SIBs?		bne	display_sibs	; yes		clc		rtsdisplay_sibs		lda	#4		; adjust cursor position		jsr	set_ch2		                lda     |sib_num                jsr     display_int		lda	#4		; adjust cursor position		jsr	set_ch3		ldy	#$0002		; supervisor entry pointer                lda	[<sib_ptr],y		pha                lda	[<sib_ptr]		ply                jsr     display_long		lda	#5		; adjust cursor position		jsr	set_ch1		                lda	<sib_ptr                ldy	<sib_ptr+2                jsr     display_long		lda	#5		; adjust cursor position		jsr	set_ch4				ldy	#$0004		; supervisor ID                lda	[<sib_ptr],y                jsr     display_int		lda	#6		; adjust cursor position		jsr	set_ch1		                lda	<sup_parm_ptr                ldy	<sup_parm_ptr+2                jsr     display_long		lda	#6		; adjust cursor position		jsr	set_ch4				ldy	#$0006		; supervisor version                lda	[<sib_ptr],y                jsr     display_int		lda	#7		; adjust cursor position		jsr	set_ch1		ldy	#2		                lda	[<sup_drvr_ptr],y		tay		lda	[<sup_drvr_ptr]                jsr     display_long				lda	#7		; adjust cursor position		jsr	set_ch3				ldx	#0		ldy	#$000A		; is there a supervisor name?		lda	[<sib_ptr],y		dey		dey		ora	[<sib_ptr],y		bne	copy_sib_name	; yes				lda	#$A0A0			; name is '  'null_name_loop		sta	|cda_mem,x		inx		inx		cpx	#20		bne	null_name_loop		bra	display_sib_namecopy_sib_name		pei	temp			; preserve GS/OS direct page		pei	temp+2		lda	[<sib_ptr],y		; install temporary pointer to name		sta	<temp		iny		iny		lda	[<sib_ptr],y		sta	<temp+2		ldy	#$0001sib_name_loop		lda	[<temp],y		; copy SIB name for display		sta	|cda_mem,x		iny		iny		inx		inx		cpx	#16		bne	sib_name_loop		pla				; restore GS/OS direct page		sta	<temp+2		pla		sta	<tempdisplay_sib_name		lda     #$000F		; characters to display                jsr	writeblock				lda	#8		; adjust cursor position		jsr	set_ch1		                lda	<sup_drvr_ptr                ldy	<sup_drvr_ptr+2                jsr     display_long		lda	#8		; adjust cursor position		jsr	set_ch4				ldy	#$000C                lda	[<sib_ptr],y                jsr     display_int		lda	#9		; adjust cursor position		jsr	set_ch4				ldy	#$000E                lda	[<sib_ptr],y                jsr     display_int		clc		rts		eject******************************************************************* This routine displays the current volume control record.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_vcr_pg		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	p5_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	p5_arrow		; yes						cmp	#$000A			; is it an down arrow?		bne	not_p5_down		; no		lda	|current_vcr		; are we already at the beginning?		dec	a		beq	p5_exit			; yes, just ignore the keypress		dec	|current_vcr		; else step to previous vcr		bra	p5_do_it2not_p5_down	cmp	#$000B			; is it an up arrow?		beq	p5_do_it		not_p5_up	cmp	#$0009			; is it a tab?		bne	p5_exit			; no				lda	#$0015			; act like it is a right arrow		jsr	display_as_fst		; else display AppleShare FST stuffwait_tab		jsr	wait_key		; tab to return		cmp	#$0009		bne	wait_tab		bra	p5_arrow		; back to this screenp5_do_it		inc	|current_vcr		; point at next VCRp5_do_it2		lda	|current_vcr		jsl	get_vcr			; get virtual pointer to the vcr		stx	<vcr_ptr		sty	<vcr_ptr+2		bcc	p5_half_home		; if vcr existsinvalid_ptr		lda	#$0001			; else reset to 1st vcr (looped scrolling)		sta	|current_vcr		jsl	get_vcr			; get virtual pointer to the vcr		stx	<vcr_ptr		sty	<vcr_ptr+2		bcc	p5_half_home		; if no vcr exists		p5_exit		clc		rts		p5_arrow		jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     cda_page5>>16		; Display CDA options                pea     cda_page5                jsr     writecstring		lda	<vcr_ptr		; check pointer on direct page		ora	<vcr_ptr+2		beq	invalid_ptr		; if null, just start with first VCR		bra	p5_continue		p5_half_home	lda	#6			; clear volume name		sta	|cv		lda	#12		sta	|ch		ldy	#16p5_home_loop1	lda	#$00A0			; ascii ' '		jsr	writechar		dey		bne	p5_home_loop1		lda	#12			; clear fst specific area		sta	|cv		stz	|chclr_to_eol	lda	#$00A0			; ascii ' '		jsr	writechar		lda	|ch			; at end of line yet?		bne	clr_to_eol		lda	|cv			; at end of page yet		bne	clr_to_eol		p5_continue	lda	#3			; display VCR pointer		ldx	<vcr_ptr		ldy	<vcr_ptr+2		jsr	display_vp				lda	|deref_vp+2		; space for vcr pointer		pha		lda	|deref_vp		pha		ora	|deref_vp+2		; null VP?		bne	@valid_vp		brl	null_vp			; yup, don't bother displaying anything@valid_vp		phd				; turn stack into zp		tsc		tcd		lda	#5			; adjust cursor position		jsr	set_ch4		                ldy	#vcr_id			; display vcr ID		lda	[<$03],y                jsr     display_int		ldy	#vcr_name+2		; display VCR name vp		lda	[<$03],y		pha		dey		dey		lda	[<$03],y		ply				; vp (in x & a reg) for derefence		tax		lda	#6		jsr	display_vp				lda	#12			; cursor position for vcr name string		sta	|ch		lda	#6		sta	|cv		lda	|deref_vp+2		; turn stack into zp for [<dp],y mode		pha		lda	|deref_vp		pha		phd		tsc		tcd				lda	[<$03]			; get volume name length		beq	truncate_vcr		tax		cpx	#17			; is name to long?		blt	vcr_name_len_ok		; notruncate_vcr		ldx	#16			; truncate the namevcr_name_len_ok		ldy	#2			; point at last character in vcr name		do_vcr_name		lda	[<$03],y		and	#$007F		cmp	#$000D		bne	no_vcr_cr		lda	#'@'no_vcr_cr		jsr	writechar		iny		dex		bne	do_vcr_name				pld				; restore stack & zp		pla		pla				lda	#7			; adjust cursor position		jsr	set_ch4		                ldy	#vcr_status		; display vcr status		lda	[<$03],y                jsr     display_int		lda	#8			; adjust cursor position		jsr	set_ch4		                ldy	#vcr_open_cnt		; display vcr open file count		lda	[<$03],y                jsr     display_int                ldy	#vcr_fst_id		; display FST ID 		lda	[<$03],y		ldx	#9			; adjust cursor position                jsr     display_fst_id				lda	#10			; adjust cursor position		jsr	set_ch4		ldy	#vcr_dev		lda	[<$03],y                jsr     display_int		pld		jsr	display_fst_vcr		; display FST specific vcrnull_vp		pla		pla		clc		rts				eject******************************************************************* This routine displays the current file control record.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_fcr_pg		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	p6_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	p6_arrow		; yes		cmp	#$000A			; is it an down arrow?		bne	not_p6_down		; no				lda	|current_fcr		; are we already at the beginning?		dec	a		beq	p6_exit			; yes, just ignore the keypress		dec	|current_fcr		; point at previous fcr		bne	get_fcr_vp		; if refnum might be legal		not_p6_down	cmp	#$000B			; is it an up arrow?		bne	p6_exit			; no		inc	|current_fcr		; point at next fcr		get_fcr_vp	lda	|current_fcr		jsl	get_fcr			; get virtual pointer to the fcr		stx	<fcr_ptr		sty	<fcr_ptr+2		bcc	p6_half_home		; if fcr exists		lda	#$0001			; else reset to 1st fcr (looped scrolling)		sta	|current_fcr		jsl	get_fcr			; get virtual pointer to the fcr		stx	<fcr_ptr		sty	<fcr_ptr+2		bcc	p6_half_home		; if no fcr exists		p6_exit		clc		rts		p6_arrow		jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     cda_page6>>16		; Display CDA options                pea     cda_page6                jsr     writecstring		lda	#1			; setup for fcr scrolling		sta	|current_fcr		lda	<fcr_ptr		; null pointer?		ora	<fcr_ptr+2		beq	get_fcr_vp		; yes, just start with the first VCR		bra	p6_continue		p6_half_home	lda	#6			; clear volume name		sta	|cv		lda	#12		sta	|ch		ldy	#50p6_home_loop1	lda	#$00A0			; ascii ' '		jsr	writechar		dey		bne	p6_home_loop1		lda	#15			; clear fst specific area		sta	|cv		stz	|chclear_to_eol	lda	#$00A0			; ascii ' '		jsr	writechar		lda	|ch			; at end of line yet?		bne	clear_to_eol		lda	|cv			; at end of page yet		bne	clear_to_eol		p6_continue	ldx	<fcr_ptr		; display FCR pointer		ldy	<fcr_ptr+2		lda	#2		jsr	display_vp		lda	|deref_vp+2		; NULL pointer returned?		ora	|deref_vp		beq	get_fcr_vp		; yes, just start over		lda	|deref_vp+2		; space for vcr pointer		pha		lda	|deref_vp		pha		phd				; turn stack into zp		tsc		tcd				lda	#4			; line number		jsr	set_ch4		                ldy	#fcr_ref_num		lda	[<$03],y                jsr     display_int		ldy	#fcr_path_name+2		lda	[<$03],y		pha		dey		dey		lda	[<$03],y		ply		tax		lda	#5			; line number                jsr     display_vp		lda	#11			; cursor position for vcr name string		sta	|ch		lda	#6		sta	|cv		lda	|deref_vp+2		; turn stack into zp for [<dp],y mode		pha		lda	|deref_vp		pha		phd		tsc		tcd		lda	[<$03]			; get file name length		beq	truncate_fcr		tax		cpx	#51			; is name to long?		blt	fcr_name_len_ok		; notruncate_fcr		ldx	#50			; truncate the namefcr_name_len_ok		ldy	#2			; point at last character in fcr name		do_fcr_name		lda	[<$03],y		; display the file name path		and	#$007F		cmp	#$000D		bne	no_fcr_cr		lda	#'@'no_fcr_cr		jsr	writechar		iny		dex		bne	do_fcr_name				pld				; restore stack & zp		pla		pla				ldx	#7		; adjust cursor position                ldy	#fcr_fst_id	; display FST ID		lda	[<$03],y		jsr	display_fst_id				lda	#8		; adjust cursor position		jsr	set_ch4		                ldy	#fcr_vol_id		lda	[<$03],y                jsr     display_int		lda	#9		; adjust cursor position		jsr	set_ch4		                ldy	#fcr_level		lda	[<$03],y                jsr     display_int		lda	#10		; adjust cursor position		jsr	set_ch3		ldy	#fcr_newline+2		lda	[<$03],y		pha		dey		dey		lda	[<$03],y		ply                jsr     display_long		lda	#11		; adjust cursor position		jsr	set_ch4		ldy	#fcr_newline_len		lda	[<$03],y                jsr     display_int		lda	#12		; adjust cursor position		jsr	set_ch4		ldy	#fcr_mask		lda	[<$03],y                jsr     display_int		lda	#13		; adjust cursor position		jsr	set_ch4		ldy	#fcr_access		lda	[<$03],y                jsr     display_int		pld		jsr	display_fst_fcr		; display FST specific fcr				pla		pla		clc		rts								eject******************************************************************* This routine displays the current cache block header.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_cmi_pg		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	p7_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	p7_arrow		; yes		cmp	#$000A			; is it an down arrow?		beq	p7_scroll_dn		; yes		cmp	#$000B			; is it an up arrow?		beq	p7_scroll_up		; nop7_end_scroll		clc		rts		p7_scroll_up		ldy	#c_lru_fwd+2		; get cache forward vp		lda	[<cache_cur_ptr]		tax		lda	[<cache_cur_ptr],y		tay		jsr	deref_my_vp		; dereference forward vp		bcs	p7_end_scroll		stx	<cache_cur_ptr		sty	<cache_cur_ptr+2		jsr	wait_vbl		; wait for vertical blanking time		bra	p7_continuep7_scroll_dn		ldy	#c_lru_bwd		; get cache backward vp		lda	[<cache_cur_ptr],y		tax		iny		iny		lda	[<cache_cur_ptr],y		tay		jsr	deref_my_vp		; dereference forward vp		stx	<cache_cur_ptr		sty	<cache_cur_ptr+2		jsr	wait_vbl		; wait for vertical blanking time		bcs	p7_end_scroll		bra	p7_continuep7_arrow		jsr	home		; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     cda_page7>>16		; Display CDA options                pea     cda_page7                jsr     writecstringp7_continue		ldy	#c_lru_fwd+2		; display cache forward vp		lda	[<cache_cur_ptr]		tax		lda	[<cache_cur_ptr],y		tay		lda	#3                jsr     display_vp		ldy	#c_lru_bwd		; display cache backward vp		lda	[<cache_cur_ptr],y		tax		iny		iny		lda	[<cache_cur_ptr],y		tay		lda	#4                jsr     display_vp		ldy	#c_bkt_fwd		; display cache forward bucket vp		lda	[<cache_cur_ptr],y		tax		iny		iny		lda	[<cache_cur_ptr],y		tay		lda	#5                jsr     display_vp		ldy	#c_bkt_bwd		; display cache backward bucket vp		lda	[<cache_cur_ptr],y		tax		iny		iny		lda	[<cache_cur_ptr],y		tay		lda	#6                jsr     display_vp				lda	#7			; display cache block number		jsr	set_ch3		ldy	#c_blknum+2		lda	[<cache_cur_ptr],y		pha		dey		dey		lda	[<cache_cur_ptr],y		ply		jsr	display_long		lda	#8			; display cache block size		jsr	set_ch4		ldy	#c_blksize		lda	[<cache_cur_ptr],y		jsr	display_int		ldx	#9			; display cache fst number		ldy	#c_fstnum		lda	[<cache_cur_ptr],y		jsr	display_fst_id		lda	#10			; display cache volume ID number		jsr	set_ch4		ldy	#c_volumeid		lda	[<cache_cur_ptr],y		jsr	display_int		lda	#11			; display cache device number		jsr	set_ch4		ldy	#c_devnum		lda	[<cache_cur_ptr],y		jsr	display_int		lda	#12			; display cache priority		jsr	set_ch4		ldy	#c_priority		lda	[<cache_cur_ptr],y		jsr	display_int		lda	#13			; display cache cell size		jsr	set_ch4		ldy	#c_cellsize		lda	[<cache_cur_ptr],y		jsr	display_int		lda	#14			; display cache RESERVED		jsr	set_ch3		ldy	#c_reserved+2		lda	[<cache_cur_ptr],y		pha		dey		dey		lda	[<cache_cur_ptr],y		ply		jsr	display_long		lda	#15			; display cache header length		jsr	set_ch3		ldy	#c_headerlen+2		lda	[<cache_cur_ptr],y		pha		dey		dey		lda	[<cache_cur_ptr],y		ply		jsr	display_long		clc		rts								eject******************************************************************* This routine displays the Express Load information.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_express		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	express_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	express_arrow		; yes		cmp	#$000A			; is it an down arrow?		bne	not_express_dn		; no				dec	|current_express	; point at previous express entry		bne	get_express		; if refnum might be legal		inc	|current_express		bra	get_express		not_express_dn			cmp	#$000B			; is it an up arrow?		bne	express_exit		; no		inc	|current_express	; point at next express entry		lda	|current_express		cmp	|max_express		blt	get_express		lda	#$0001		sta	|current_express		get_express			pei	<temp+2		pei	<temp				ldx	express_hndl		; get express handle		ldy	express_hndl+2		jsr	deref_handle		; get pointer		stx	<temp		sty	<temp+2				lda	|current_express	; get pointer to entry #		asl	a		asl	a		asl	a		asl	a		sta	|express_index		bra	exp_half_home		; if no fcr exists		express_exit	clc		rts		express_arrow		pei	temp+2		pei	temp				jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     express_page>>16	; Display CDA options                pea     express_page                jsr     writecstring				lda	#1			; setup for fcr scrolling		sta	|current_express		lda	#128			; artificial maximum (I cant tell how many)		sta	|max_express				pha				; space for result		pha		ldx	#$1E11			; private loader call to get globals address		jsl	$E10000		pla		sta	<temp		pla		sta	<temp+2		ldy	#$0006			; offset to direct page pointer		lda	[<temp],y		sta	<temp			; set up pointer		stz	<temp+2		ldy	#$0078			; offset within direct page of user_id_ptr		lda	[<temp],y		sta	express_hndl		iny		iny		lda	[<temp],y		sta	express_hndl+2		ldx	express_hndl		; get express handle		ldy	express_hndl+2		jsr	deref_handle		; get pointer		stx	<temp		sty	<temp+2				lda	|current_express	; get pointer to entry #		asl	a			; index = entry * 16		asl	a		asl	a		asl	a		sta	|express_index		bra	express_1		exp_half_home			lda	#14			; clear filename name		sta	|cv		lda	#1		sta	|ch		ldy	#75exp_home_loop1			lda	#' '			; ascii ' '		jsr	writechar		dey		bne	exp_home_loop1express_1			ldx	express_hndl		; display express handle		ldy	express_hndl+2		lda	#3		jsr	display_handle				lda	#4			; display express entry number		jsr	set_ch4		lda	|current_express		jsr	display_int				lda	#6			; display express segment user ID		jsr	set_ch4		ldy	|express_index		lda	[<temp],y		sta	|express_user_id		jsr	do_temp_int				clc				; display express segment handle		lda	#$0002		adc	|express_index		tay		lda	[<temp],y		pha		iny		iny		lda	[<temp],y		tay		plx		lda	#7		jsr	display_handle		lda	#8			; display express segment stack address		jsr	set_ch4		clc		lda	#$0006		adc	|express_index		tay		jsr	do_temp_int		lda	#9			; display express segment stack size		jsr	set_ch4		clc		lda	#$0008		adc	|express_index		tay		jsr	do_temp_int		lda	#10			; display express segment starting address		jsr	set_ch3		clc		lda	#$000A		adc	|express_index		tay		jsr	do_temp_long		lda	#11			; display express segment reserved		jsr	set_ch4		clc		lda	#$000E		adc	|express_index		tay		jsr	do_temp_int				lda	|express_user_id	; user ID for express segment entry		bne	@good_userid		stz	<temp			; else assume null pathname pointer		stz	<temp+2		bra	@fake_it@good_userid		pea	$0000			; space for result pointer		pea	$0000		pha		pea	$0001			; express segment always file number $0001		ldx	#$1111			; GetPathname		jsl	tool_locator				pla		sta	<temp		pla		sta	<temp+2@fake_it		lda	#12			; display filename pointer		jsr	set_ch3		lda	<temp		ldy	<temp+2		jsr	display_long				lda	<temp			; NULL pathname pointer?		ora	<temp+2		beq	exp_done		; yes, just skip the name display		lda	#14			; display filename		sta	|cv		stz	|ch		lda	[<temp]			; any characters to output?		and	#$00FF		sta	|exp_name_len		beq	exp_done		; no		ldy	#1			; point at 1st characterexp_name_loop		lda	[<temp],y		and	#$007F		cmp	#$000D		bne	not_exp_cr		lda	#'@'not_exp_cr		jsr	writechar		cpy	|exp_name_len		beq	exp_done		iny		bra	exp_name_loopexp_done		pla		sta	<temp		pla		sta	<temp+2				clc		rts					express_hndl	dc.l	0current_express	dc.w	0max_express	dc.w	0express_user_id	dc.w	0exp_name_len	dc.w	0express_index	dc.w	0		eject******************************************************************* This routine displays the device dispatcher file list information.* The structure of the filename list is as follows:*			 _________________*	BASE		|_               _|   Filename entry #1*			|_               _|*			|_               _|*			|_________________|*				 ¥*				 ¥*				 ¥*			 _________________*	BASE+(n*48)	|_               _|   Filename entry #n*			|_               _|*			|_               _|*			|_________________|** The structure of each filename entry is a 48 byte structure as follows:**			 _________________*	BASE=0		|_               _|   FileType of filename entry*			|_________________|*	BASE+2		|_               _|   AuxType of filename entry*			|_________________|*	BASE+4		|_               _|   User ID of filename entry*			|_________________|*	BASE+6		|_               _|   Load Address of filename entry*			|_               _|*			|_               _|*			|_________________|*	BASE+10		|_               _|   32 byte filename*			|	          |*				 ¥*				 ¥*				 ¥*			|_               _|*			|_________________|*	BASE+42		|_               _|   Restart Flag of filename entry*			|_________________|*	BASE+44		|_               _|   Base device number of filename entry*			|_________________|*	BASE+46		|_               _|   RESERVED for filename entry*			|_________________|** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_file_list		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	file_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	file_arrow		; yes		cmp	#$000A			; is it an down arrow?		bne	not_file_dn		; no				dec	|current_file		; point at previous express entry		bne	get_file		; if refnum might be legal		lda	|max_file		; else wrap around to end of list		dec	a		sta	|current_file		bra	get_file		not_file_dn			cmp	#$000B			; is it an up arrow?		bne	file_exit		; no		inc	|current_file		; point at next express entry		lda	|current_file		cmp	|max_file		blt	get_file		lda	#$0001		sta	|current_file		get_file			pei	<temp+2		pei	<temp				jsr	calc_file_index		; get pointer to entry #		bra	file_half_home		; if no fcr exists		file_exit	clc		rts		file_arrow		pei	temp+2		pei	temp				jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     file_list_page>>16	; Display CDA options                pea     file_list_page                jsr     writecstring				phb		lda	>file_list_hndl		; dereference file list handle		tax		lda	>file_list_hndl+1		pha		plb		plb		lda	|0,x			; and set file list pointer		sta	<file_list_ptr		lda	|2,x		sta	<file_list_ptr+2		plb				lda	>file_list_cnt		; get # of entries in list		inc	a			; bump for ease of comparisons		sta	|max_file		jsr	calc_file_index		; get pointer to entry #		bra	file_1		file_half_home			lda	#11			; clear filename name		sta	|cv		lda	#12		sta	|ch		ldy	#32file_home_loop1			lda	#' '			; ascii ' '		jsr	writechar		dey		bne	file_home_loop1file_1		lda	#3			; display dispatcher file list pointer		jsr	set_ch3		lda	<file_list_ptr		tax		lda	<file_list_ptr+2		tay		txa		jsr	display_long				lda	#4			; display current entry number		jsr	set_ch4		lda	|current_file		jsr	display_int				lda	#5			; display current entry		jsr	set_ch3		clc		lda	<file_entry_ptr		ldy	<file_entry_ptr+2		jsr	display_long				lda	<file_entry_ptr		; set pointer to file entry		sta	<temp		lda	<file_entry_ptr+2		sta	<temp+2				lda	#7			; display file filetype		jsr	set_ch4		ldy	#file_filetype		jsr	do_temp_int				lda	#8			; display file auxtype		jsr	set_ch4		ldy	#file_auxtype		jsr	do_temp_int				lda	#9			; display file User ID		jsr	set_ch4		ldy	#file_user_id		jsr	do_temp_int		lda	#10			; display file load address		jsr	set_ch3		ldy	#file_load_addr		jsr	do_temp_long				lda	#11			; display driver file name		sta	|cv		lda	#12		sta	|ch		ldy	#file_name		lda	[<temp],y		; any characters to output?		and	#$001F		beq	file_name_done		; no				clc				; else calculate end of line index		adc	#file_name+1		sta	|file_name_len		iny				; point at 1st character		inyfile_name_loop		lda	[<temp],y		and	#$007F		cmp	#$000D			; is it a cr/lf?		bne	not_file_cr		; no		lda	'@'not_file_cr		jsr	writechar		cpy	|file_name_len		beq	file_name_done		iny		bra	file_name_loopfile_name_done		lda	#12			; display driver file restart_flag		jsr	set_ch4		ldy	#file_restart		jsr	do_temp_int		lda	#13			; display driver base device number		jsr	set_ch4		ldy	#file_dev_num		jsr	do_temp_intfile_done		pla		sta	<temp		pla		sta	<temp+2				clc		rts					current_file	dc.w	1max_file	dc.w	255file_userid	dc.w	0file_name_len	dc.w	0file_index	dc.w	0calc_file_index		lda	|current_file		; need current file number		dec	a		and	#$000F		asl	a		tax		lda	|file_list_tbl,x		sta	|file_index		lda	|current_file		dec	a		and	#$00F0		lsr	a		lsr	a		lsr	a		tax		lda	|file_list_tbl,x		asl	a		asl	a		asl	a		asl	a		adc	|file_index		sta	|file_index				clc		adc	<file_list_ptr		sta	<file_entry_ptr		lda	#0		adc	<file_list_ptr+2		sta	<file_entry_ptr+2		rtsfile_list_tbl	dc.w	$0000			; entry # 1 index		dc.w	$0030			; entry # 2 index		dc.w	$0060			; entry # 3 index		dc.w	$0090			; entry # 4 index		dc.w	$00C0			; entry # 5 index		dc.w	$00F0			; entry # 6 index		dc.w	$0120			; entry # 7 index		dc.w	$0150			; entry # 8 index		dc.w	$0180			; entry # 9 index		dc.w	$01B0			; entry # 10 index		dc.w	$01E0			; entry # 11 index		dc.w	$0210			; entry # 12 index		dc.w	$0240			; entry # 13 index		dc.w	$0270			; entry # 14 index		dc.w	$02A0			; entry # 15 index		dc.w	$02D0			; entry # 16 index				eject******************************************************************* This routine displays the VBL interrupt queue.  The queue * head link address is located at $E100D8.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_vbl		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	vbl_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	vbl_arrow		; yes		cmp	#$000A			; is it an down arrow?		beq	vbl_head		; yes				cmp	#$000B			; is it an up arrow?		beq	vbl_2			; yes				cmp	#' '			; is it an ' '?		bne	vbl_exit		; no				pei	temp+2			; need long for pointer on gsos direct page		pei	temp				lda	|vbl_ptr		; set indirect pointer to vbl queue		sta	<temp		lda	|vbl_ptr+2		sta	<temp+2		bra	vbl_1		vbl_exit	clc		rts		vbl_arrow		jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     vbl_page>>16		; Display CDA options                pea     vbl_page                jsr     writecstringvbl_head		lda	#<vbl_head_ptr		; get vbl head link pointer		sta	|vbl_ptr		lda	#vbl_head_ptr>>16		sta	|vbl_ptr+2vbl_2		pei	temp+2			; need long for pointer on gsos direct page		pei	temp				lda	|vbl_ptr		; set indirect pointer to vbl queue		sta	<temp		lda	|vbl_ptr+2		sta	<temp+2				ldy	#$0002			; point at next queue entry		lda	[<temp]		tax		ora	[<temp],y		beq	vbl_1			; if queue entry is zero, then no more entries		lda	[<temp],y		stx	<temp		sta	<temp+2				stx	|vbl_ptr		sta	|vbl_ptr+2vbl_1		lda	#3			; display current task header address		jsr	set_ch3		lda	<temp		ldy	<temp+2		jsr	display_long				lda	#4			; display link address		jsr	set_ch3		ldy	#$0000		jsr	do_temp_long				lda	#5			; display task count		jsr	set_ch4		ldy	#4		jsr	do_temp_int				lda	#6			; display signature		jsr	set_ch4		ldy	#6		jsr	do_temp_int				lda	#7			; display task address		jsr	set_ch3		clc		lda	<temp		adc	#8		tax		lda	<temp+2		adc	#0		tay		txa		jsr	display_long				pla		sta	<temp		pla		sta	<temp+2				clc		rts					vbl_ptr		dc.l	0		eject******************************************************************* This routine switches the system to text mode and calls the* CDA as the result of a system death error.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************death_trap		longa	on		longi	on		cmp	#$0015			; was key a right arrow?		beq	death_prompt		; yes				cmp	#$0008			; was key a left arrow?		beq	death_prompt		; yes		cmp	#$000A			; is it an down arrow?		beq	remove_death		; yes				cmp	#$000B			; is it an up arrow?		beq	install_death		; yes		clc		rtsdeath_prompt		jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     death_page>>16		; Display page                pea     death_page                jsr     writecstring		clc		rtsremove_death		lda	|to_old_trap+2		; has original trap address been preserved?		beq	cant_remove		; no				lda	|to_old_trap		; restore old system death trap		sta	>system_death		lda	|to_old_trap+2		sta	>system_death+2cant_remove		jsr	wait_vbl		; wait for vertical blanking time		lda	#5		sta	|cv		stz	|ch                pea     death_page1>>16		; Display page                pea     death_page1                jsr     writecstring		clc		rts		install_death		lda	|to_old_trap+2		; has original trap address been preserved?		bne	have_old_trap		; yes				lda	>system_death		; preserve old system death trap		sta	|to_old_trap		lda	>system_death+2		sta	|to_old_trap+2have_old_trap		lda	|to_death_trap		; install system death trap		sta	>system_death		lda	|to_death_trap+2		sta	>system_death+2				jsr	wait_vbl		; wait for vertical blanking time		lda	#5		sta	|cv		stz	|ch                pea     death_page2>>16		; Display page                pea     death_page2                jsr     writecstring		clc		rts		to_death_trap		jmp	>d_trap_entry		to_old_trap		jmp	>$000000		** System Death Trap Entry:**		{Word}		Error Code*		{LongWord}	Pointer to ascii replacement string*		{24 bit pc}	Return address to routine calling System Death*	sp----->*d_trap_entry		sei				; no interrupts for now (just making sure)				sep	#$20			; 8 bit 'm' & 'x'		longa	off		longi	off				lda	>newvideo		; turn off superhires		and	#%01111111		sta	>newvideo				sta	>txtset			; turn on text mode				rep	#$20			; 16 bit 'm' & 'x'		longa	on		longi	on				pla				; clean up stack		plb		phk				; point at my data area		plb				pla				; replacement string pointer		sta	|death_str		pla		sta	|death_str+2		pla				; error code		sta	|death_codestuck		lda	#page_cnt		; point at one past last display page		sta	|vector_index		jsl	da_start		bra	stuck		display_death		longa	on		longi	on		cmp	#$0015			; was key a right arrow?		beq	death_error		; yes				cmp	#$0008			; was key a left arrow?		beq	death_error		; yes		cmp	#$000A			; is it an down arrow?		beq	death_error		; yes				cmp	#$000B			; is it an up arrow?		beq	death_error		; yes		clc		rtsdeath_error		jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     death_trap_pg>>16	; Display page                pea     death_trap_pg                jsr     writecstring				lda	#2		jsr	set_ch4		lda	|death_code		jsr	display_int				lda	#3		jsr	set_ch3		lda	|death_str		ldy	|death_str+2		jsr	display_long				clc		rtsdeath_code	dc.w	0death_str	dc.l	0		eject******************************************************************* This routine displays all the driver calls, status codes &* control codes.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_driver		longa	on		longi	on				cmp	#$0015		; was key a right arrow?		beq	drvr_arrow	; yes				cmp	#$0008		; was key a left arrow?		beq	drvr_arrow	; yes		clc		rtsdrvr_arrow			jsr	home		; clear screen		jsr	wait_vbl	; wait for vertical blanking time                pea     drvr_page>>16	; Display GS/OS driver calls                pea     drvr_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays device characteristics bit encoding.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_dev_char		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	dev_char_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	dev_char_arrow		; yes		clc		rtsdev_char_arrow			jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     dev_char_page>>16	; Display GS/OS driver characteristics                pea     dev_char_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays supervisor characteristics bit encoding.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_sup_char		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	sup_char_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	sup_char_arrow		; yes		clc		rtssup_char_arrow			jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     sup_char_page>>16	; Display GS/OS supervisor characteristics                pea     sup_char_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays memory attributes bit encoding.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_mem_attr		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	mem_attr_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	mem_attr_arrow		; yes		clc		rtsmem_attr_arrow			jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     mem_attr_page>>16	; Display memory attributes word                pea     mem_attr_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays the GS/OS memory map.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_mem_map		longa	on		longi	on				cmp	#$0015			; was key a right arrow?		beq	mem_map_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	mem_map_arrow		; yes				cmp	#$000B			; was it an up arrow?		bne	not_mem_up		; no				inc	|map_page_index		bra	mem_map_arrownot_mem_up		cmp	#$000A			; was key a down arrow?		bne	not_mem_down		; no				dec	|map_page_index		bra	mem_map_arrownot_mem_down		clc		rtsmem_map_arrow			jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time				lda	|map_page_index		ror	a		bcs	do_mem_page2		                pea     mem_map_page>>16	; Display GS/OS memory map                pea     mem_map_page		bra	draw_pagedo_mem_page2                pea     mem_map_page2>>16	; Display GS/OS memory map                pea     mem_map_page2draw_page                jsr     writecstring		clc		rts		map_page_index	dc.w	0			; indicates which map page to display				eject******************************************************************* This routine is for visiting the monitor.** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************goto_monitor		longa	on		longi	on						cmp	#$0015			; was key a right arrow?		beq	monitor_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	monitor_arrow		; yes		clc		rtsmonitor_arrow				jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     monitor_page>>16	; Display GS/OS user ID's                pea     monitor_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays the SCSI manager direct page** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_scsi		longa	on		longi	on						cmp	#$0015			; was key a right arrow?		beq	scsi_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	scsi_arrow		; yes				clc		rts		scsi_arrow			stz	|sib_num		; point at 1st sib		bra	check_sib_numfind_scsi_mgr		jsr	set_sib_ptr		; point at current SIB		ldy	#$0004			; is this the SCSI manager?		lda	[<sib_ptr],y		cmp	#$0002		beq	found_scsi_mgr		; yescheck_sib_num		inc	|sib_num		; next supervisor		lda	|sib_num		; is this a valid supervisor entry?		cmp	[<sup_drvr_ptr]		blt	find_scsi_mgr		beq	find_scsi_mgr		brl	no_scsi_mgrfound_scsi_mgr		jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     scsi_page>>16		; Display SCSI Manager Display Page                pea     scsi_page                jsr     writecstring		stz	|scsi_index		pei	<temp		pei	<temp+2				ldy	#$0010			; get SCSI data structure pointer		lda	[<sib_ptr],y		sta	<temp		sta	|scsi_mgr_dp		iny		iny		lda	[<sib_ptr],y		sta	<temp+2		sta	|scsi_mgr_dp+2				lda	#2			; location of SCSI manager dp		jsr	set_ch3		lda	<temp		ldy	<temp+2		jsr	display_long				lda	#3			; number of SCSI cards		jsr	set_ch4		ldy	#$0046		jsr	do_temp_int				lda	#4			; number of device records		jsr	set_ch4		ldy	#$0048		jsr	do_temp_int				lda	#5			; I/O table pointer		jsr	set_ch3		ldy	#$0050		jsr	do_temp_long				lda	#6			; device record table pointer		jsr	set_ch3		ldy	#$0058		jsr	do_temp_long				lda	#7			; SCSI routine table		jsr	set_ch3		ldy	#$0072		jsr	do_temp_long				pla		sta	<temp+2		pla			sta	<temp				clc		rtsno_scsi_mgr		jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     no_scsi_page>>16	; Display I cant find it!!!                pea     no_scsi_page                jsr     writecstring		clc		rts		scsi_index	dc.w	0			; index into scsi data structurescsi_page_num	dc.w	0			; which scsi page we are displayingscsi_mgr_dp	dc.l	0			; SCSI Manager direct page location		eject******************************************************************* This routine displays I/O records maintained by the SCSI* manager.** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_scsi_io		longa	on		longi	on						cmp	#$0015			; was key a right arrow?		beq	scsi_io_arrow1		; yes				cmp	#$0008			; was key a left arrow?		beq	scsi_io_arrow1		; yes				cmp	#$000B			; was key a up arrow?		beq	next_scsi_data1		; yes				cmp	#$000A			; was key a down arrow?		beq	prev_scsi_data1		; yes				clc		rts		scsi_io_arrow1			stz	|sib_num		; point at 1st sib		bra	check_sib_num1find_scsi_mgr1		jsr	set_sib_ptr		; point at current SIB		ldy	#$0004			; is this the SCSI manager?		lda	[<sib_ptr],y		cmp	#$0002		beq	found_scsi_mgr1		; yescheck_sib_num1		inc	|sib_num		; next supervisor		lda	|sib_num		; is this a valid supervisor entry?		cmp	[<sup_drvr_ptr]		blt	find_scsi_mgr1		beq	find_scsi_mgr1		brl	no_scsi_mgrfound_scsi_mgr1		pei	<temp		pei	<temp+2				ldy	#$0010			; get SCSI data structure pointer		lda	[<sib_ptr],y		sta	<temp		sta	|scsi_mgr_dp		iny		iny		lda	[<sib_ptr],y		sta	<temp+2		sta	|scsi_mgr_dp+2				pla		sta	<temp+2		pla			sta	<temp		jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     scsi_page1>>16		; Display SCSI Manager Display Page                pea     scsi_page1                jsr     writecstring		bra	do_scsi_data1		prev_scsi_data1		lda	|cur_scsi_slot		; point at next data structure		dec	a		and	#$000F		sta	|cur_scsi_slot		jsr	wait_vbl		bra	do_scsi_data1		next_scsi_data1		lda	|cur_scsi_slot		; point at next data structure		inc	a		and	#$000F			; limit slot to 0 through 15		sta	|cur_scsi_slot		jsr	wait_vbldo_scsi_data1		pei	<temp		pei	<temp+2				lda	|scsi_mgr_dp		; point at scsi manager direct page		sta	<temp		lda	|scsi_mgr_dp+2		sta	<temp+2				ldy	#$0050			; point to I/O table address		lda	[<temp],y		tax		iny		iny		lda	[<temp],y		sta	<temp+2		stx	<temp				lda	|cur_scsi_slot		; point at current I/O record		asl	a		asl	a		asl	a		asl	a		asl	a		clc		adc	<temp		sta	<temp		lda	#0		adc	<temp+2		sta	<temp+2				lda	#2			; viewing slot n		jsr	set_ch4		lda	|cur_scsi_slot		jsr	display_int				lda	#4			; slot number		jsr	set_ch4		ldy	#0		jsr	do_temp_int				lda	#5			; hardware type		jsr	set_ch4		ldy	#2		jsr	do_temp_int				lda	#6			; 5380 base address		jsr	set_ch3		ldy	#4		jsr	do_temp_long				lda	#7			; DMA base address		jsr	set_ch3		ldy	#8		jsr	do_temp_long				lda	#8			; SCSI i/o record attributes		jsr	set_ch4		ldy	#$000C		jsr	do_temp_int				lda	#9			; initiator priority		jsr	set_ch4		ldy	#$000E		jsr	do_temp_int				lda	#11			; target 0 logicals		jsr	set_ch2		ldy	#$0010		jsr	do_temp_int				lda	#12			; target 1 logicals		jsr	set_ch2		ldy	#$0012		jsr	do_temp_int				lda	#13			; target 2 logicals		jsr	set_ch2		ldy	#$0014		jsr	do_temp_int				lda	#14			; target 3 logicals		jsr	set_ch2		ldy	#$0016		jsr	do_temp_int				lda	#11			; target 4 logicals		jsr	set_ch4		ldy	#$0018		jsr	do_temp_int				lda	#12			; target 5 logicals		jsr	set_ch4		ldy	#$001A		jsr	do_temp_int				lda	#13			; target 6 logicals		jsr	set_ch4		ldy	#$001C		jsr	do_temp_int				lda	#14			; target 7 logicals		jsr	set_ch4		ldy	#$001E		jsr	do_temp_int				pla		sta	<temp+2		pla			sta	<temp				clc		rts		cur_scsi_slot	dc.w	0			; slot of current I/O record				eject******************************************************************* This routine displays device records maintained by the SCSI* manager.** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_scsi_dev		longa	on		longi	on						cmp	#$0015			; was key a right arrow?		beq	scsi_io_arrow2		; yes				cmp	#$0008			; was key a left arrow?		beq	scsi_io_arrow2		; yes				cmp	#$000B			; was key a up arrow?		beq	next_scsi_data2		; yes				cmp	#$000A			; was key a down arrow?		beq	prev_scsi_data2		; yes				clc		rts		scsi_io_arrow2			stz	|sib_num		; point at 1st sib		bra	check_sib_num2find_scsi_mgr2		jsr	set_sib_ptr		; point at current SIB		ldy	#$0004			; is this the SCSI manager?		lda	[<sib_ptr],y		cmp	#$0002		beq	found_scsi_mgr2		; yescheck_sib_num2		inc	|sib_num		; next supervisor		lda	|sib_num		; is this a valid supervisor entry?		cmp	[<sup_drvr_ptr]		blt	find_scsi_mgr2		beq	find_scsi_mgr2		brl	no_scsi_mgr