c.l	str_clrbackup	; $0B = Clear backup		dc.l	str_setsyspref	; $0C = Set system prefix		dc.l	str_null	; $0D = Null		dc.l	str_expandpath	; $0E = Expand pathname		dc.l	str_getsysprefs	; $0F = Get system prefix		dc.l	str_open	; $10 = Open		dc.l	str_newline	; $11 = Newline		dc.l	str_read	; $12 = Read		dc.l	str_write	; $13 = Write		dc.l	str_close	; $14 = Close		dc.l	str_flush	; $15 = Flush		dc.l	str_setmark	; $16 = Set mark		dc.l	str_getmark	; $17 = Get mark		dc.l	str_seteof	; $18 = Set EOF		dc.l	str_geteof	; $19 = Get EOF		dc.l	str_setlevel	; $1A = Set level		dc.l	str_getlevel	; $1B = Get level		dc.l	str_getdirentry	; $1C = Get directory entry		dc.l	str_beginsess	; $1D = Begin session		dc.l	str_endsession	; $1E = End session		dc.l	str_sessionstat	; $1F = Session status		dc.l	str_getdevnum	; $20 = Get device number		dc.l	str_getlastdev	; $21 = Get last device		dc.l	str_readblock	; $22 = Read (512 byte) block		dc.l	str_writeblock	; $23 = Write (512 byte) block		dc.l	str_format	; $24 = Format		dc.l	str_erasedisk	; $25 = Erase disk		dc.l	str_invalid	; $26 = invalid call type		dc.l	str_getname	; $27 = Get name		dc.l	str_getbootvol	; $28 = Get boot volume		dc.l	str_quit	; $29 = Quit		dc.l	str_getversion	; $2A = Get version		dc.l	str_getfstinfo	; $2B = Get FST info		dc.l	str_dinfo	; $2C = Get device info		dc.l	str_dstatus	; $2D = Device status		dc.l	str_dcontrol	; $2E = Device control		dc.l	str_dread	; $2F = Device read		dc.l	str_dwrite	; $30 = Device write		dc.l	str_bindint	; $31 = Bind interrupt source		dc.l	str_unbindint	; $32 = Unbind interrupt source		dc.l	str_fstspec	; $33 = FST specific				eject** The following data area is used for screen I/O routines.*ch		dc.w	$0000		; cursor horizontal positioncv		dc.w	$0000		; cursor vertical positionstring_len	dc.w	$0000		; length of string to displayvtab_table	dc.w	$0400		; Row 0		or $00		dc.w	$0480		; Row 1		or $01		dc.w	$0500		; Row 2		or $02		dc.w	$0580		; Row 3		or $03		dc.w	$0600		; Row 4		or $04		dc.w	$0680		; Row 5		or $05		dc.w	$0700		; Row 6		or $06		dc.w	$0780		; Row 7		or $07		dc.w	$0428		; Row 8		or $08		dc.w	$04A8		; Row 9		or $09		dc.w	$0528		; Row 10	or $0A		dc.w	$05A8		; Row 11	or $0B		dc.w	$0628		; Row 12	or $0C		dc.w	$06A8		; Row 13	or $0D		dc.w	$0728		; Row 14	or $0E		dc.w	$07A8		; Row 15	or $0F		dc.w	$0450		; Row 16	or $10		dc.w	$04D0		; Row 17	or $11		dc.w	$0550		; Row 18	or $12		dc.w	$05D0		; Row 19	or $13		dc.w	$0650		; Row 20	or $14		dc.w	$06D0		; Row 21	or $15		dc.w	$0750		; Row 22	or $16		dc.w	$07D0		; Row 23	or $17		main_text_buf	ds	1024		; screen save bufferalt_text_buf	ds	1024		; screen save buffercda_mem		ds	64		; buffer used to convert hex to ascii		ejectstr_0FF		dc.l	error_str		dc.l	str_00		str_00		dc.b	27		dc.b	'Press <RETURN> to continue.'		error_str	dc.b	30		dc.b	'Inline GS/OS System Call $'str_val		dc.l	0str_stk		dc.l	stk_str		dc.l	str_00		stk_str		dc.b	29		dc.b	'Stack GS/OS System Call $'stk_val		dc.l	0driver_string	dc.l	drvr_trap_str		dc.l	str_00		drvr_trap_str	dc.b	33		dc.b	'Completed GS/OS Driver Call $'drvr_val	dc.l	0sup_string	dc.l	sup_trap_str		dc.l	str_00		sup_trap_str	dc.b	37		dc.b	'Completed GS/OS Supervisor Call $'sup_val		dc.l	0saved_page	ds	256		endp		end