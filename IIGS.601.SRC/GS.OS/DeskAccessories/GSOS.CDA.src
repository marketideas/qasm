          X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_as_fst		longa	on		longi	on						jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     as_fst_page>>16		; Display CDA options                pea     as_fst_page                jsr     writecstring		pei	<temp+2		pei	<temp		lda	|current_vcr		; get virtual pointer to the vcr		jsl	get_vcr		ldx	<vcr_ptr		; dereference VCR virtual pointer		ldy	<vcr_ptr+2		jsr	deref_my_vp		stx	<temp		sty	<temp+2				ldy	#vcr_fst_id		; is this an AppleShare VCR?		lda	[<temp],y		cmp	#$000D		bne	not_as_vcr		; no				ldy	#$0018			; point at mod pointer		lda	[<temp],y		tax		iny		iny		lda	[<temp],y		sta	<temp+2		stx	<temp		ldx	#as_fst_script		; display AppleShare FST stuff		jsr	scriptnot_as_vcr				pla		sta	<temp		pla		sta	<temp+2				clc		rts				eject******************************************************************* This routine is for visiting the monitor.** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_s		longa	on		longi	on						cmp	#$0015			; was key a right arrow?		beq	s_arrow			; yes				cmp	#$0008			; was key a left arrow?		beq	s_arrow			; yes		clc		rtss_arrow				jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     s_page>>16		; Display GS/OS user ID's                pea     s_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays all the system user ID numbers** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_user_id		longa	on		longi	on						cmp	#$0015			; was key a right arrow?		beq	user_id_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	user_id_arrow		; yes		clc		rtsuser_id_arrow				jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     user_id_page>>16	; Display GS/OS user ID's                pea     user_id_page                jsr     writecstring		clc		rts				eject******************************************************************* These routines set the cursor positions for the data field* to be displayed.** ENTRY: Call via 'JSR'*               A Reg = Vertical line number ( 0 - 23 )*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************set_ch1		longa	on		longi	on				ldx	#21		; ch for left field longword		bra	set_chset_ch2				ldx	#25		; ch for left field word		bra	set_chset_ch2_5			ldx	#41		; ch for left field word		bra	set_chset_ch3				ldx	#53		; ch for right field longword		bra	set_ch		set_ch4				ldx	#57		; ch for right field wordset_ch		stx	|ch		sta	|cv		rts				eject******************************************************************************** This routine displays the longword pointed to by [<temp],y.** ENTRY: Call via 'JSR'*		<temp =	pointer to base of data structure*               A Reg = Integer to be displayed and converted*               X Reg = Undefined*               Y Reg = Index into data structure*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************do_temp_long		longa	on		longi	on				lda	[<temp],y		; get longword data		pha		iny		iny		lda	[<temp],y		tay		pla		jsr	display_long		; display it at the current cursor position		rts		eject******************************************************************************** This routine displays the word pointed to by [<temp],y.** ENTRY: Call via 'JSR'*		<temp =	pointer to base of data structure*               A Reg = Integer to be displayed and converted*               X Reg = Undefined*               Y Reg = Index into data structure*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************do_temp_int		longa	on		longi	on				lda	[<temp],y		; get longword data		jsr	display_int		; display it at the current cursor position		rts		eject******************************************************************************** This routine displays the current FST ID name at the ch cv position.** ENTRY: Call via 'JSR'*               A Reg = Integer to be displayed and converted*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************display_fst_id     		longa	on		longi	on			sta	|cur_fst_id	; save fst ID for string table index		stx	|cv		; cursor position for FST ID field		ldx	#41		stx	|ch		jsr	display_int	; display FST ID in hex				ldx	#48		; cursor postition for fst name		stx	|ch		lda	|cur_fst_id	; get current fst ID to index string address table		beq	illegal_fst_id	; if FST ID is not legal		cmp	#$000E		blt	legal_fst_id	; if FST ID is legal		lda	#$000E		; display FST ID = unknownlegal_fst_id		dec	a		; index for string display		asl	a		asl	a		tax		lda	|fst_id_table+2,x		pha		lda	|fst_id_table,x		pha		jsr	writecstring	; display current FST ID		illegal_fst_id			rts				eject******************************************************************************** This routine displays both a virtual pointer and a dereferenced virtual* pointer on the line specified in the call input.  The horizontal cursor * position is fixed at 41.** ENTRY: Call via 'JSR'*               A Reg = Line number to display vp & dereferenced vp*               X Reg = Least significant word of VP*               Y Reg = Most significant word of VP*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************display_vp		longa	on		longi	on		phy			; save vp for dereferencing later		phx		sta	|cv		; set vertical line number		lda	#41		; set cursor horizontal position		sta	|ch		lda	3,s		; display virtual pointer		tay		lda	1,s		jsr	display_long		lda	#53		; set CH for derefereced vp display		sta	|ch		plx			; prepare to dereference the vp		ply		jsr	deref_my_vp	; go dereference the VP		sty	|deref_vp+2	; keep a copy of derefereced vp		stx	|deref_vp		txa		jsr	display_long	; and display the dereferenced vp		rts		eject******************************************************************************** This routine displays both a handle and a dereferenced handle* pointer on the line specified in the call input.  The horizontal cursor * position is fixed at 41.** ENTRY: Call via 'JSR'*               A Reg = Line number to display vp & dereferenced vp*               X Reg = Least significant word of VP*               Y Reg = Most significant word of VP*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************display_handle		longa	on		longi	on		phy			; save vp for dereferencing later		phx		sta	|cv		; set vertical line number		lda	#41		; set cursor horizontal position		sta	|ch		lda	3,s		; display handle		tay		lda	1,s		jsr	display_long				lda	#53		; set CH for derefereced vp display		sta	|ch		plx			; prepare to dereference the handle		ply		jsr	deref_handle	; go dereference the handle		jsr	display_long	; and display the dereferenced vp		rts				eject******************************************************************************** This routine dereferences a handle** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Least significant word of handle*               Y Reg = Most significant word of handle*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Least significant word of pointer*               X Reg = Least significant word of pointer*               Y Reg = Most significant word of pointer*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************deref_handle		longa	on		longi	on				phb		phy		plb		ldy	|2,x		lda	|0,x		tax		plb		plb		rts				eject******************************************************************************** Validation of the virtual pointer is done by checking that the offset (x reg)* is less than or equal to 8k while the index (y reg) is an integral multiple* of 4.  This scheme will only work as long as GS/OS continues to allocate memory* in 8k segments.  A better solution would be to add a system service call to the* operating system to validate an virtual pointer.*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | INDEX (Y Register)* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |___|___ must be 0   *   |___|___|___|___|___|___|___|___|___|___|___|___|___|___________ unknown   **  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | OFFSET (X Register)* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |___|___|___|___|___|___|___|___|___|___|___|___|___ unknown   *   |___|___|_______________________________________________________ must be 0      ** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Least significant word of VP*               Y Reg = Most significant word of VP*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Least significant word of dereferenced VP*               Y Reg = Most significant word of dereferenced VP*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0   if current call is an fst call*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0   if current call is not an fst call*******************************************************************************deref_my_vp		longa	on		longi	on				tya			; is this a valid vp?		and	#$0003		bne	not_valid_vp	; no		txa		and	#$E000		bne	not_valid_vp	; novalid_vp		phd		pea	direct_base	; GS/OS system service call requires OS direct page		pld		jsl	deref		; GS/OS system service call - dereference virtual pointer		pld		tya			; is dereferenced vp a valid bank?		cmp	#$00E0		; legal bank is < $E0?		bge	not_valid_vp	; if invalid		phy			; is dereferenced vp = $00000000?		txa		ora	1,s		sta	1,s		pla		beq	not_valid_vp	; yeshave_vp		clc			; clear error flag		rtsnot_valid_vp		ldy	#0		; always point invalid dereferenced vp at $00000000		tyx		sec			; set error flag		rts				eject******************************************************************************** This routine checks to see that the current system call is an FST call.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0   if current call is an fst call*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0   if current call is not an fst call*******************************************************************************check_fst_call     		longa	on		longi	on				lda	<call_number	; get current fst ID to index string address table		and	#$00FF		; do not care about the call class		sta	|current_call	; save current OS call		ldx	#0check_call_loop		cmp	|fst_call_table,x		beq	valid_fst_call		inx		inx		cpx	#fst_call_end-fst_call_table		bne	check_call_loop		sec		rtsvalid_fst_call		clc		rts		                eject******************************************************************************** This routine displays all the fst specific data associated with the* vcr page display.  Data is displayed from the script indicated by the* current fst id.  Script data indicates the number of entries in a script* followed by each script entry.  Script entries indicates the screen position* for the script display as well as where the data to be displayed can be * obtained relative to the base address of the vcr data structure.**	SCRIPT	dc.w	n			; number of elements in script*		dc.w	ch,cv,len,offset	; 1st script element*		dc.w	ch,cv,len,offset	; 2nd script element*		dc.w	ch,cv,len,offset	; 3rd script element*		etc.**	where:	cv is a word value indicating horizontal screen position.*		ch is a word value indicating vertical screen position.*		len is a word value indicating length of the display field.*		offset is a word indicating the data position relative to *		the base address of the vcr data structure.  Note that if*		bit 15 of the offset is set, the data is a virtual pointer*		and indicates that both the raw virtual pointer as well as*		the dereferenced virtual pointer are to be displayed.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*	   cur_fst_id = word value indicating which FST is in use** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************display_fst_vcr     		longa	on		longi	on				lda	|cur_fst_id	; is the current fst id legal?		beq	no_fst_vcr	; no		cmp	#$000E		blt	fst_vcr_ok	; yesno_fst_vcr		rtsfst_vcr_ok			lda	|cur_fst_id	; caclulate pointer to fst vcr display page		dec	a		asl	a		asl	a		tax		lda	|fst_vcr_table+2,x		pha		lda	|fst_vcr_table,x		pha		lda	#12		sta	|cv		stz	|ch		jsr	writecstring	; display the fst vcr page				lda	|cur_fst_id	; caclulate pointer to fst vcr script		dec	a		asl	a		tax		lda	|fst_vcr_data,x		tax		stx	|fst_vcr_ptr		lda	|0,x		; are there any items in the script?		beq	no_fst_vcr	; no		sta	|item_count	; save item count		pei	temp		pei	temp+2				ldy	<vcr_ptr+2	; dereference vcr pointer & place on zp for [<vcr],y mode		ldx	<vcr_ptr		jsr	deref_my_vp		sty	<temp+2		stx	<temp		inc	|fst_vcr_ptr	; point at next script item		inc	|fst_vcr_ptrfst_vcr_loop		ldx	|fst_vcr_ptr	; get pointer to script data		lda	|0,x		; set cursor horizontal position		sta	|ch		lda	|2,x		; set cursor vertical position		sta	|cv		lda	|6,x		; get offset to data field from base of vcr		and	#$7FFF		; strip the flag off		tay		lda	|4,x		; get length of data field		jsr	display_field	; go display the script item data field		ldx	|fst_vcr_ptr	; was the item a virtual pointer?		lda	|6,x		bpl	no_fst_vcr_vp	;no		clc			; adjust cursor position		lda	|ch		adc	#4		sta	|ch				lda	|6,x		; get virtual pointer		and	#$7FFF		tay		lda	[<temp],y		tax		iny		iny		lda	[<temp],y			jsr	deref_my_vp	; dereference virtual pointer		txa		jsr	display_long		no_fst_vcr_vp				clc			; calculate next script item address		lda	|fst_vcr_ptr		adc	#8		sta	|fst_vcr_ptr		dec	|item_count	; any more script items?		bne	fst_vcr_loop	; yes				pla			sta	<temp+2		pla		sta	<temp		rts                eject******************************************************************************** This routine displays all the fst specific data associated with the* fcr page display.  Data is displayed from the script indicated by the* current fst id.  Script data indicates the number of entries in a script* followed by each script entry.  Script entries indicates the screen position* for the script display as well as where the data to be displayed can be * obtained relative to the base address of the vcr data structure.**	SCRIPT	dc.w	n			; number of items in script*		dc.w	ch,cv,len,offset	; script item**	where:	cv is a word value indicating horizontal screen position.*		ch is a word value indicating vertical screen position.*		len is a word value indicating length of the display field.*		offset is a word indicating the data position relative to *		the base address of the fcr data structure.  Note that if*		bit 15 of the offset is set, the data is a virtual pointer*		and indicates that both the raw virtual pointer as well as*		the dereferenced virtual pointer are to be displayed.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*	   cur_fst_id = word value indicating which FST is in use** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************display_fst_fcr     		longa	on		longi	on				lda	|cur_fst_id	; is the current fst id legal?		beq	no_fst_fcr	; no		cmp	#$000E		blt	fst_fcr_ok	; yesno_fst_fcr		rtsfst_fcr_ok		lda	|cur_fst_id	; caclulate pointer to fst vcr display page		dec	a		asl	a		asl	a		tax		lda	|fst_fcr_table+2,x		pha		lda	|fst_fcr_table,x		pha		lda	#15		sta	|cv		stz	|ch		jsr	writecstring	; display the fst fcr page				lda	|cur_fst_id	; caclulate pointer to fst fcr script		dec	a		asl	a		tax		lda	|fst_fcr_data,x		tax		stx	|fst_fcr_ptr		lda	|0,x		; are there any items in the script?		beq	no_fst_fcr	; no		sta	|item_count	; save item count		pei	temp		pei	temp+2				ldy	<fcr_ptr+2	; dereference vcr pointer & place on zp for [<vcr],y mode		ldx	<fcr_ptr		jsr	deref_my_vp		sty	<temp+2		stx	<temp		inc	|fst_fcr_ptr	; point at next script item		inc	|fst_fcr_ptrfst_fcr_loop		ldx	|fst_fcr_ptr	; get pointer to script data		lda	|0,x		; set cursor horizontal position		sta	|ch		lda	|2,x		; set cursor vertical position		sta	|cv		lda	|6,x		; get offset to data field from base of fcr		and	#$7FFF		; strip the flag off		tay		lda	|4,x		; get length of data field		jsr	display_field	; go display the script item data field		ldx	|fst_fcr_ptr	; was the item a virtual pointer?		lda	|6,x		bpl	no_fst_fcr_vp	;no		clc			; adjust cursor position		lda	|ch		adc	#4		sta	|ch				lda	|6,x		; get virtual pointer		and	#$7FFF		tay		lda	[<temp],y		tax		iny		iny		lda	[<temp],y			jsr	deref_my_vp	; dereference virtual pointer		txa		jsr	display_long		no_fst_fcr_vp				clc			; calculate next script item address		lda	|fst_fcr_ptr		adc	#8		sta	|fst_fcr_ptr		dec	|item_count	; any more script items?		bne	fst_fcr_loop	; yes				pla			sta	<temp+2		pla		sta	<temp		rts                eject******************************************************************************** Data is displayed from the script indicated by the a pointer passed in X.* Script data indicates the number of entries in a script followed by each * script entry.  Script entries indicates the screen position for the script * display as well as where the data to be displayed can be obtained relative* to the [<temp] and the type of data to display.**	SCRIPT	dc.w	n					; number of elements in script*		dc.w	ch,cv,len,type,type,res1,res2,res3	; 1st script element*		dc.w	ch,cv,len,type,type,res1,res2,res3	; 2nd script element*		dc.w	ch,cv,len,type,type,res1,res2,res3	; 3rd script element*		dc.w	ch,cv,len,type,type,res1,res2,res3	; 4th script element*		etc.**	where:	cv	A word value indicating horizontal screen position.*		ch	A word value indicating vertical screen position.*		len	A word value indicating length of the display field.*		offset	A word value indicating the position of data relative to [<temp]*		type	A word indicating the type of data to be displayed:*				$0000 = Hex*				$0001 = Handle*				$0002 = Virtual Pointer*				$0003 = Pascal String*				$0004 = Class 1 input string*				$0005 = Class 1 output string*				$0006 = C String*				$0007 = Binary*		res1	A reserved word.*		res2	A reserved word.*		res3	A reserved word.** ENTRY: Call via 'JSR'*	      [<temp] = Pointer to array containing data to display*               A Reg = Undefined*               X Reg = Pointer to script*               Y Reg = Undefined*             Dir Reg = GS/OS Direct page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************script     		longa	on		longi	on				lda	|0,x			; save number of script elements		sta	|script_count		inx		inx		stx	|script_ptr		; save pointer to scriptscript_loop		ldx	|script_ptr		; get pointer to script data		lda	|0,x			; set cursor horizontal position		sta	|ch		lda	|2,x			; set cursor vertical position		sta	|cv		lda	|4,x			; get length of data field		sta	|data_length		lda	|6,x			; get offset to data relative to [<temp]		tay		lda	|8,x			; get data type		and	#$0007			; practice safe software here!		sta	|data_type		asl	a			; dispatch for special data type case		tax		lda	|type_tbl,x		pea	next_script-1		pha		rtsnext_script				clc				; calculate next element position		lda	|script_ptr		adc	#16		sta	|script_ptr				dec	|script_count		; any more script items?		bne	script_loop		; yes		rts		type_hex		lda	|data_length		jsr	display_field		rts		type_handle		phy		lda	|data_length		; display handle		jsr	display_field		jsr	ch_plus_4		; adjust cursor		ply		lda	[<temp],y		; dereference handle		tax		iny		iny		lda	[<temp],y		pha		plb		lda	|2,x		tay		lda	|0,x			; ya = dereferenced handle		plb		phk		plb		jsr	display_long		; display dereferenced handle		rts		type_vp		phy		lda	|data_length		; display handle		jsr	display_field		jsr	ch_plus_4		; adjust cursor		ply		lda	[<temp],y		; get virtual pointer		tax		iny		iny		lda	[<temp],y			jsr	deref_my_vp		; dereference virtual pointer		txa		jsr	display_long		rts		type_pstring		rts		type_c1instr		rts		type_c1outstr		rts		type_cstr		rts		type_binary		rtsch_plus_4				clc				; adjust cursor position		lda	|ch		adc	#4		sta	|ch		rts		script_ptr	dc.w	0script_count	dc.w	0data_length	dc.w	0data_type	dc.w	0type_tbl	dc.w	type_hex-1		dc.w	type_handle-1		dc.w	type_vp-1		dc.w	type_pstring-1		dc.w	type_c1instr-1		dc.w	type_c1outstr-1		dc.w	type_cstr-1		dc.w	type_binary-1                eject******************************************************************************** This routine displays a script item data field.** ENTRY: Call via 'JSR'*               A Reg = length of script item field to display (in bytes)*               X Reg = Undefined*               Y Reg = Offset from base of record where data resides*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*	   	   CH = Horizontal display position of data field*	   	   CV = Vertical display position of data field*	      [<temp] = Pointer to record containing data to display** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************display_field     		longa	on		longi	on				sta	|field_length	; length of field to display		cmp	#1		; is this a byte display request?		bne	not_a_byte	; no				lda	[<temp],y	; obtain integer to convert		and	#$00FF		pha		pea	cda_mem>>16	; location of ascii string		pea	cda_mem		pea	2		; number of digits		ldx	#$220B		; convert parameter for display		jsl	tool_locator		lda	#2		; 1 character to display		jsr	writeblock		rtsnot_a_byte			cmp	#2		; is this a word display request?		bne	not_a_word	; no		lda	[<temp],y	; obtain integer to convert		pha		pea	cda_mem>>16	; location of ascii string		pea	cda_mem		pea	4		; number of digits		ldx	#$220B		; convert parameter for display		jsl	tool_locator		lda	#4		; 1 character to display		jsr	writeblock		rts		not_a_word			cmp	#3		; is this a 3 byte display request?		bne	not_3_byte	; no		lda	[<temp],y	; obtain integer to convert		tax		iny		iny		lda	[<temp],y		and	#$00FF		; truncate to 3 byte value		pha		phx		pea	cda_mem>>16	; location of ascii string		pea	cda_mem		pea	8		; number of digits		ldx	#$230B		; convert parameter for display		jsl	tool_locator		lda	#8		; 1 character to display		jsr	writeblock		rts		not_3_byte			cmp	#4		; is this a long word display request?		bne	not_a_long	; no		lda	[<temp],y	; obtain integer to convert		tax		iny		iny		lda	[<temp],y		pha		phx		pea	cda_mem>>16	; location of ascii string		pea	cda_mem		pea	8		; number of digits		ldx	#$230B		; convert parameter for display		jsl	tool_locator		lda	#8		; 1 character to display		jsr	writeblocknot_a_long		rts		                eject******************************************************************************** This routine takes the integer passed in the accumulator, converts it to* a four digit ascii string and displays the string at the current cursor* position.** ENTRY: Call via 'JSR'*               A Reg = Integer to be displayed and converted*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************display_int     		longa	on		longi	on		                pha                     ; integer to be converted                pea	cda_mem>>16	; location to return ascii                pea	cda_mem                pea     $0004		; number of digits                ldx	#$220B		; convert parameter for display		jsl	tool_locator	; int2hex                                jsr	writeword	; and display it                rts		eject******************************************************************************** This routine converts the long integer passed in the accumulator and* Y register into an eight digit ascii string and displays the string* at the current cursor position.** ENTRY: Call via 'JSR'*               A Reg = Least significant word of integer*               X Reg = Undefined*               Y Reg = Most significant word of integer*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************display_long    		longa	on		longi	on		                phy                     ; integer to be converted                pha                pea	cda_mem>>16	; location to return ascii                pea	cda_mem                pea     $0008		; number of digits                ldx	#$230B		; convert parameter for display		jsl	tool_locator	; long2hex                jsr	writelong	; and display it                rts                eject******************************************************************************** This routine sets the DIB pointer on GS/OS direct page in preparation for* updating the current display window.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************set_dib_ptr 		longa	on		longi	on				pha                phy                lda     <drvr_dev_num   ; get device number                dec     a               ; index = dev_num-1*8+4                asl     a                asl     a                asl     a                clc                adc     #$0004                tay                lda     [<drvr_dev_ptr],y                sta     <drvr_dib_ptr                iny                iny                lda     [<drvr_dev_ptr],y                sta     <drvr_dib_ptr+2                ply                pla                rts                eject******************************************************************************** This routine sets the SIB pointer on GS/OS direct page in preparation for* updating the current display window.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************set_sib_ptr 		longa	on		longi	on				pha                phy                lda     |sib_num	; get supervisor number                dec     a               ; index = dev_num-1*8+4                asl     a                asl     a                asl     a                clc                adc     #$0004                tay                lda     [<sup_drvr_ptr],y                sta     <sib_ptr                iny                iny                lda     [<sup_drvr_ptr],y                sta     <sib_ptr+2                ply                pla                rts                eject******************************************************************************** This routine sets the vertical line pointer for screen output.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Pointer to vertical line*               X Reg = Bank indicated by current CH*               Y Reg = Unchanged*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************vtab		longa	on		longi	on				lda	|ch		and	#$0001		eor	#$00E1		pha		lda	|cv		asl	a		tax		lda	|vtab_table,x		plx		rts                eject******************************************************************************** This routine delays screen output until a vertical blanking interval** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Pointer to vertical line*               X Reg = Bank indicated by current CH*               Y Reg = Unchanged*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************wait_vbl		longa	on		longi	on				sep	#$20		; 8 bit 'm'		longa	off				lda	>rdvbl		; is VBL occuring?		bmi	not_vbl_yet	; nowait_not_vbl		lda	>rdvbl		; is VBL occuring?		bpl	wait_not_vbl	; yes, wait until the end of this periodnot_vbl_yet			lda	>rdvbl		; is VBL occuring?		bmi	not_vbl_yet	; no, wait until a blanking period				rep	#$20		; 16 bit 'm'		longa	on				rts				                eject******************************************************************************** This routine outputs a C-String to the text screen.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*			 Long pointer to C String*			 Word return address -1*	Stack Pointer ->*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Pointer to vertical line*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************writecstring		longa	on		longi	on				phd		tsc		tcd** Stack and direct page looks like . . .**			 (+5)	Long	pointer to C String*			 (+3)	Word	return address -1*			 (+1)	Word	old direct page address*	Stack Pointer ->*		ldy	#0		; set c string pointer to start of stringcstring_loop		lda	[<$05],y	; get c string character		and	#$007F		beq	cstring_done	; if end of string		cmp	#tab		; is it a tab?		bne	not_a_tab** When a TAB is encountered, the next character in the string is* interpretted as the cursor horizontal position rather than an* ascii character.  Set the cursor position and advance to the* next character in the C string.*		iny			; get CH contiguous to TAB		lda	[<$05],y		and	#$00FF		sta	|ch		bra	next_c_str_char** If not a TAB, just output the ascii character.*not_a_tab		jsr	writechar	; else output characternext_c_str_char		iny			; set pointer for next character		bra	cstring_loop	; loop for next character		cstring_done			lda	<$03		; clean up stack		sta	<$07		; move return address		pld		pla		pla		rts                eject******************************************************************************** This routine outputs a an eight byte ascii numerical field to the text screen.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Pointer to vertical line*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************writeword		longa	on		longi	on				lda	#4		; number of characters per string		bra	writeblock		writelong		longa	on		longi	on				lda	#8		; number of characters per string		writeblock		sta	|string_len                pea	cda_mem>>16	; location to return ascii                pea	cda_mem		phd		tsc		tcd** Stack and direct page looks like . . .**			 (+3)	Long	pointer to 8 byte numerical string*			 (+1)	Word	old direct page address*	Stack Pointer ->*		ldy	#0		; set c string pointer to start of stringstring_loop		lda	[<$03],y	; get string character		jsr	writechar	; and write to screen		iny			; point at next numerical string character		cpy	|string_len	; done all characters?		bne	string_loop	; no, loop for next character		string_done			pld		pla		pla		rts		                eject******************************************************************************** This routine outputs a single 7 bit ascii character at the current screen* location specified by CH and CV.  ** ENTRY: Call via 'JSR'*               A Reg = 7 bit ascii character in lsb*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Unchanged*               Y Reg = Unchanged*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************writechar		longa	on		longi	on				and	#$00FF		; limit character to 8 bit Apple ASCII		bit	|mode-1		; is this in flashing mode?		bmi	normal1		; no, it's in normal mode		bvc	normal1		; no, it's in inverse mode		bra	its_a_flasher	; yes,normal1				ora	#$0080its_a_flasher		phx		phy				ldx	#$0000		; normal character table indexnormal_chk		cmp	|normal_char_tbl,x		beq	normal_char		inx		inx		cpx	#$000C		; 1 past end of table		bne	normal_chk		and	|modenormal_char		pha			; character to print		pha			; space for screen pointer		pha		phd		tsc		tcd**		+12	X Register (msb)*		+11	X Register (lsb)*		+10	Y Register (msb)*		+9	Y Register (lsb)*		+8	Character (msb - undefined)*		+7	Character (lsb)*		+6	Screen memory pointer (msb)*		+5	Screen memory pointer*		+4	Screen memory pointer*		+3	Screen memory pointer (lsb)*		+2	Direct register (msb)*		+1	Direct register (lsb)*	Stack Pointer ->*					jsr	vtab		; calculate screen line address		sta	<$03		stx	<$05				lda	|ch		; calculate screen position on line		lsr	a		tay		lda	<$07		; get character to output		cmp	#$008D		; is this a cr/lf?		beq	cr_lf		; yes				sep	#$20		; 8 bit 'm'		longa	off				sta	[<$03],y	; and write to screen				rep	#$20		; 16 bit 'm'		longa	on				inc	|ch		; point at next screen position		lda	|ch		; at end of line?		cmp	#80		bne	position_ok	; nocr_lf		stz	|ch		; point at beginning of next line		inc	|cv		lda	|cv		; at end of screen?		cmp	#24		blt	position_ok	; no		stz	|ch		stz	|cv		*		jsr	home		; clear screen & home cursor		position_ok				pld		pla		pla		pla		ply		plx		rtsnormal_char_tbl		dc.w	$008D		; is it a 'cr'?		dc.w	$00A0		; is it a ' '?		dc.w	$00DF		; is it a '_'?		dc.w	$00FC		; is it a '|'?		dc.w	$00BD		; is it a '='?		dc.w	$00AA		; is it a '*'?		eject******************************************************************************** This routine clears the 80 column screen and positions the cursor to the* top left corner** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************home		longa	on		longi	on				lda	#$A0A0			; normal video spaces		sta	>main_text_pg		sta	>alt_text_pg		pea	main_text_pg>>16	; clear text page to spaces		pea	|main_text_pg		pea	main_text_pg>>16		pea	|main_text_pg		pea	$0000		pea	$0400		pea	$0804		jsl	move_info		pea	alt_text_pg>>16		; clear text page to spaces		pea	|alt_text_pg		pea	alt_text_pg>>16		pea	|alt_text_pg		pea	$0000		pea	$0400		pea	$0804		jsl	move_info				stz	|ch			; position cursor @ upper left		stz	|cv		rts						eject******************************************************************************** This routine clears the 80 column screen and positions the cursor to the* top left corner** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************save_screen		longa	on		longi	on		pea	main_text_pg>>16		pea	|main_text_pg		pea	main_text_buf>>16		pea	main_text_buf		pea	$0000		pea	$0400		pea	$0805		jsl	move_info		pea	alt_text_pg>>16		pea	|alt_text_pg		pea	alt_text_buf>>16		pea	alt_text_buf		pea	$0000		pea	$0400		pea	$0805		jsl	move_info		rts				eject******************************************************************************** This routine clears the 80 column screen and positions the cursor to the* top left corner** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************restore_screen		longa	on		longi	on				pea	main_text_buf>>16		pea	main_text_buf		pea	main_text_pg>>16		pea	|main_text_pg		pea	$0000		pea	$0400		pea	$0805		jsl	move_info		pea	alt_text_buf>>16		pea	alt_text_buf		pea	alt_text_pg>>16		pea	|alt_text_pg		pea	$0000		pea	$0400		pea	$0805		jsl	move_info		rts		eject********************************************************************************************** The following strings are used to display a menu of CDA options.*                                                                   ********************************************************************************************cda_page1		dc.b	tab,22,'GS/OS Internal Snooper Version 6.0d2',$0D,$0D		dc.b	tab,27,'Copyright (c) 1987-1992',$0D		dc.b	tab,29,'Apple Computer, Inc.',$0D		dc.b	tab,29,'All rights reserved',$0D,$0D		dc.b	tab,22,'Written by: Ray Montagne, ext. 4-6255',$0D		dc.b	tab,22,'Updated by: Greg Branche, ext. 4-5523',$0D,$0D		dc.b	'THIS CDA DISPLAYS INTERNAL OPERATING SYSTEM DATA STRUCTURES AND MUST NOT BE',$0D		dc.b	'DISTRIBUTED OUTSIDE OF APPLE COMPUTER, INC. UNDER ANY CIRCUMSTANCES',$0D,$0D		dc.b	'Quick Keys:    (? returns to this page)',$0D		dc.b	'_____________________________________________________________________________',$0D		dc.b	' 1 = System Calls | A = Cache Dumper  | J = Death Trap   | S = SCSI I/O Rec. ',$0D		dc.b	' 2 = System Svc   | B = Traps         | K = Driver Calls | T = SCSI Dev. Rec.',$0D		dc.b	' 3 = Error Codes  | C = FST Numbers   | L = Device Char. | U = SCSI Internals',$0D		dc.b	' 4 = User ID      | D = FST Headers   | M = Sup. Char.   | V = Device ID List',$0D		dc.b	' 5 = Direct Page  | E = Block Diagram | N = Mem. Attr.   | W = Device Status ',$0D		dc.b	' 6 = DIB Dumper   | F = $E1 Vectors   | O = Memory Map   | X = ASCII Chart   ',$0D		dc.b	' 7 = SIB Dumper   | G = ExpressLoad   | P = GOTO Monitor | Y =               ',$0D		dc.b	' 8 = VCR Dumper   | H = File List     | Q = User ID      | Z =               ',$0D		dc.b	' 9 = FCR Dumper   | I = VBL Queue     | R = SCSI Dir. Pg | ESC = Quit        ',$00				ejectcda_page2		dc.b	'GS/OS Direct Page               GS/OS Call =',$0D		dc.b	$0D		dc.b	'=============================================================',$0D		dc.b	'Drvr_dev_num',tab,24,'$',tab,30,'| Call_number',tab,56,'$',$0D		dc.b	'Drvr_call_num',tab,24,'$',tab,30,'| Param_blk_ptr',tab,52,'$',$0D		dc.b	'Drvr_buf_ptr',tab,20,'$',tab,30,'|==============================',$0D		dc.b	'Drvr_req_cnt',tab,20,'$',tab,30,'| SIB_ptr',tab,52,'$',$0D		dc.b	'Drvr_tran_cnt',tab,20,'$',tab,30,'| Sup_parm_ptr',tab,52,'$',$0D		dc.b	'Drvr_blk_num',tab,20,'$',tab,30,'| Sup_drvr_ptr',tab,52,'$',$0D		dc.b	'Drvr_blk_size',tab,24,'$',tab,30,'|==============================',$0D		dc.b	'Drvr_fst_num',tab,24,'$',tab,30,'| Dev1_num',tab,56,'$',$0D		dc.b	'Drvr_vol_id',tab,24,'$',tab,30,'| Dev2_num',tab,56,'$',$0D		dc.b	'Drvr_cache',tab,24,'$',tab,30,'| Path1_ptr/Fcr_ptr',tab,52,'$',$0D		dc.b	'Drvr_cach_ptr',tab,20,'$',tab,30,'| Path2_ptr/Vcr_ptr',tab,52,'$',$0D		dc.b	'Drvr_dib_ptr',tab,20,'$',tab,30,'| Path_flag',tab,56,'$',$0D		dc.b	'==============================| Span1',tab,56,'$',$0D		dc.b	'Post_drvr_tbl',tab,20,'$',tab,30,'| Span2',tab,56,'$',$0D		dc.b	'=============================================================',$0D		dc.b	'Cache_cur_ptr',tab,20,'$',tab,32,'Cache_pre_ptr',tab,52,'$',$0D		dc.b	'Cache_nxt_ptr',tab,20,'$',tab,32,'Cache_bkt_ptr',tab,52,'$',$0D		dc.b	'=============================================================',$00str_invalid	dc.b	'Invalid call type',$00str_create	dc.b	'Create',$00str_destroy	dc.b	'Destroy',$00str_osshutdown	dc.b	'OS shut down',$00str_changepath	dc.b	'Change