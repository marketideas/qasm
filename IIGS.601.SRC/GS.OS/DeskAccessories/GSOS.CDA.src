_mgr3		; yescheck_sib_num3		inc	|sib_num		; next supervisor		lda	|sib_num		; is this a valid supervisor entry?		cmp	[<sup_drvr_ptr]		blt	find_scsi_mgr3		beq	find_scsi_mgr3		brl	no_scsi_mgrfound_scsi_mgr3		pei	<temp		pei	<temp+2				lda	<sib_ptr		; get SCSI internal data structure pointer		sta	|scsi_mgr_dp		lda	<sib_ptr+2		sta	|scsi_mgr_dp+2				pla		sta	<temp+2		pla			sta	<temp		jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     scsi_page3>>16		; Display SCSI Manager Display Page                pea     scsi_page3                jsr     writecstring		stz	|scsi_index		pei	<temp		pei	<temp+2				lda	|scsi_mgr_dp		; point at scsi manager direct page		sta	<temp		lda	|scsi_mgr_dp+2		sta	<temp+2						lda	#2			; misc. tools user id		jsr	set_ch4		ldy	#$004D		jsr	do_temp_int				ldy	#$004F			; work area handle		lda	[<temp],y		tax		iny		iny		lda	[<temp],y		tay		lda	#3		jsr	display_handle				ldy	#$0053			; driver/manager direct page handle		lda	[<temp],y		tax		iny		iny		lda	[<temp],y		tay		lda	#4		jsr	display_handle				lda	#5			; manager direct page		jsr	set_ch4		ldy	#$0057		lda	[<temp],y		xba		inc	a		xba		jsr	display_int				lda	#6			; gs/os direct page		jsr	set_ch4		ldy	#$0059		jsr	do_temp_int				lda	#7			; manager driver number		jsr	set_ch4		ldy	#$005B		jsr	do_temp_int				lda	#8			; previous slot		jsr	set_ch4		ldy	#$0067		jsr	do_temp_int				lda	#9			; previous id		jsr	set_ch4		ldy	#$0069		jsr	do_temp_int				lda	#10			; previous device record pointer		jsr	set_ch3		ldy	#$006B		jsr	do_temp_long				lda	#11			; next most previous slot		jsr	set_ch4		ldy	#$006F		jsr	do_temp_int				lda	#12			; next most previous id		jsr	set_ch4		ldy	#$0071		jsr	do_temp_int				lda	#13			; next most previous device record pointer		jsr	set_ch3		ldy	#$0073		jsr	do_temp_long				lda	#14			; boot slot		jsr	set_ch4		ldy	#$009B		jsr	do_temp_int				lda	#