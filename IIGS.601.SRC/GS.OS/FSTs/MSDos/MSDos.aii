dbg_brk_in	equ	0	;change to 0 to remove the debugging break    if dbg_brk_in then	writeln '#   Debugging Break still installed!'	writeln 'File "{MSDos}"MSDos.aii; Line 1'    endif;======================================================================;; MSDos FST - A GS/OS File System Translator used to access the MSDos; file system.  Based on the ProDOS FST by Rob Turner.;;Created:   November 15, 1990;Modified:  ;Author:    Greg Branche;;;Copyright Apple Computer Inc. 1987-92  ALL RIGHTS RESERVED;;======================================================================;; Date          Who             What; --------      ----            ---------------------------------------; 11/15/90      Greg Branche    Initial conversion started; 07/01/91      Greg Branche    Brought up to date with latest ProDOS FST; 09/??/91	Greg Branche	Volume call working (for the most part); 12/??/91	Greg Branche	GetFileInfo call working; 01/03/92	Greg Branche	Open and Close calls working; 01/09/92	Greg Branche	Brought up to date with latest ProDOS FST; 01/12/92	Greg Branche	GetDirEntry and GetDevNumber working; 01/29/92	Greg Branche	id_disk now properly synthesizes a volume;				label for a disk that has none.; 03/30/92	Greg Branche	Updated with ProDOS FST v4.01.;				GetEOF is now working.;				GetMark is now working.;				Started getting Read and SetMark working.; 05/15/92	Greg Branche	Read, SetMark, and Flush now working, which;				means we now have a full, read-only FST!; 07/21/92	Dave Lyons	Fixed multichar newline bug in slow_read,;				like earlier ProDOS FST fix.; 08/11/92	Dave Lyons	Added auxtype word to map table.; 08/25/92	Dave Lyons	FSTSpecific map_enable and set_map_table;				now walk the VCR list and post a volume;				changed event for every swapped-in MS-DOS;				VCR.; 09/01/92	Greg Branche	Fixed bug #1041461.  check_block was;				returning success when it found a;				matching volume label directory entry.;				Fixed bug in find_file which prevented;				proper searching of multi-block;				subdirectories.  The logic was not setting;				the cluster number and sectors-per-cluster;				variables prior to starting the search;				through the subdirectory.; 10/10/92	Greg Branche	Add resource fork support (as also;				supported by PC Exchange on the Mac) to;				GetDirEntry, GetFileInfo, and Open.; 01/18/93	Greg Branche	Fix check_vol_syntax in MSDos.Subs.aii to;				allow _any_ character in a volume label;				except the GS/OS separator character.;; 2-Apr-93   Steve Stephenson	Changed version to $0100 for 6.0.1 (final);;======================================================================		include	'MSDos.equ';======================================================================;Below is the FST header definition used by GS/OS at boot time;======================================================================fst_header	PROC		Import	appl_call,system_call		DC.B	'FST '			;Says I'm a FST		DC.L	appl_call		;Process a normal application call		DC.L	system_call		;Process a FST system call		DC.W	fst_id			;My ID number (MSDos)		Export	fst_attr;			 Upper-case pathnames;			 |Character-based FST;			 ||Format capable;			 |||Strip high bits from pathname characters;			 ||||Read-Only FST;			 |||||Reserved;			 ||||||||||||||Format type;			 ||||||||||||||||  (00 = Universal);			 ||||||||||||||||  (01 = Apple-generic);			 ||||||||||||||||  (10 = Non-Apple);			 ||||||||||||||||  (11 = Apple-][ specific)fst_attr	DC.W	%1000100000000010	;attributes						;(UpperCase, ReadOnly)		DC.W	$0100			;Version 1.0		DC.W	512			;block size		DC.L	$10000			;Max Blocks (32 meg)		DC.L	$0004			;Min Blocks		DC.L	$ffffffff		;max file size		DC.L	$0000			;reserved		DC.B	6		DC.B	'MS-DOS'		string	pascal		DC.B	'MS-DOS FST            v01.00'		DC.W	0000			;reserved field		dc.b	'MS-DOS FST written by Greg Branche V1.00'		string	asis		ENDP;======================================================================;Below is the main entry point for ALL standard operating system calls.;;Input:         X = Call number * 2;               Y = Class number * 2;               A = undefined		longa	on		longi	onappl_call	PROC		with	my_dp				import	max_call,write_occurred,write_dev_num		import	cp_device_flag,fake_name_str,error_priority		import	show_damage		import	cmd_tbl,dirty_flags,chk_dirty_flag,flags		Entry	cmd_error		EXPORT	error_exit,main_exit		phk				;setup our bank register		plb		rep	#$30		cpx	#max_call+1		;check command number		bcs	cmd_error		jmp	(cmd_tbl-2,x)		;call the functioncmd_error    if dbg_brk_in then	txa		;convert to application call #	lsr a	brk 'G'		;then halt so we can find out what call it is	dc.b $42,'B'	;(unique signature, I hope)    endif		lda	#bad_system_callerror_exit		secmain_exit; If we're reporting an error, then check cp_device_flag to see if we were; renaming a duplicate volume.  If so, we built a vcr with a fake name.  Since we ; got an error at some point in the process, we need to find the vcr with the fake; name and release it if it still exists.  1/22/91 CAE		pha				;save the error code		php				;save error flag		bcc	@cont			;branch if no error		lda	cp_device_flag		;did we build a vcr with a fake name?		bpl	@cont			;no - so no need to clean up		ldx	#fake_name_str		;get pointer to fake name string		ldy	#^fake_name_str		lda	#0000			;search by name		jsl	find_vcr		bcs	@cont			;didn't find the vcr so we're ok		jsl	deref			;dereference vcr pointer		stx	<temp_ptr		sty	<temp_ptr+2		lda	[temp_ptr]		;get vcr id 		jsl	release_vcr		;release the vcr@cont		jsl	unlock_mem		;unlock the used handles		plp		php		bcc	no_damage		lda	2,s			;get access to the error code		and	#$00FF			;clear the garbage from the high byte please		cmp	#drvr_bad_block		;the disk is probably bad		beq	mark_damaged		;mark the volume as damaged		cmp	#damaged_bitmap		beq	mark_damaged		cmp	#dir_error		bne	no_damage		;the disk is still okmark_damaged		lda	msdos_vcr_ptr		;make sure there is a vcr		ora	msdos_vcr_ptr+2		beq	no_damage		ldy	#msdos_vcr.vol_damaged	;mark the VCR please		lda	[msdos_vcr_ptr],y		inc	a			;see if we have already told the user about the damage		beq	no_damage		;we have told the user so skip the message		lda	#$FFFF		sta	[msdos_vcr_ptr],y		lda	1,s			;tell the user about the problem		jsr	show_damageno_damage;;Now we need to set the Global Clean Flag if we need to;		lda	msdos_fcr_ptr		;make sure there is a fcr		ora	msdos_fcr_ptr+2		beq	@no_fcr			;don't worry about it		lda	flags			;There is a FCR now make sure it was used during the call.		and	#fcr_used		beq	@no_fcr			;no FCR is used by the call		ldy	#msdos_fcr.status	;get the status out of the File Control Record		lda	[msdos_fcr_ptr],y;;If my bit (15) is set then the file is dirty so we must clear the Global_Clean Bit.;		and	#file_dirty		;clear all but the file dirty bit 15		eor	#set_global_clean		sta	math_temp		ldy	#fcr.access		lda	[my_fcr_ptr],y		and	#clr_global_clean		ora	math_temp		sta	[my_fcr_ptr],y;;Now we need to see if we should check if the file has become dirty during the call;		lda	chk_dirty_flag		beq	@no_fcr			;This call does not require processing;;Now lets see if the file was dirty at the beginning of the call.  If it was then just;exit.  Otherwise update the dirty_file count in the VCR;		lda	dirty_flags		bne	@no_fcr			;the file was dirty at the beginning		ldy	#msdos_fcr.status	;get the status out of the File Control Record		lda	[msdos_fcr_ptr],y		and	#file_dirty+\			data_dirty+\			index_dirty+\			master_dirty		beq	@no_fcr			;The file is still clean;;Now we must update the dirty file count;		ldy	#msdos_vcr.dirty_file_cnt ;get the original count		lda	[msdos_vcr_ptr],y		inc	a		sta	[msdos_vcr_ptr],y@no_fcr		lda	write_occurred		;see if a volume was modified during the call		beq	@no_write		;no write occurred		lda	call_number		;the call that was made by application		pha		ldx	write_dev_num		;push the device number		phx		phy				;we do not care about Y		lda	#volume_change		;this is the event code		ldx	#^volume_change		jsl	post_os_event		;post the event please@no_write		plp				;restore error flag		pla				;restore error code		ora	error_priority		;put error priority in hi byte  3/5/91 CAE		jml	sys_exit		ENDP	if read_only_fst then		eject********************************************************************************	 Name:	write_protect** Description:	A common handler for all calls which require writing to	disk.*		Will call process_path,	and if successful, will	return a*		drvr_wr_prot error.  Always returns an error.**     Created:	Dec 14,	1987*    Modified:	Dec 14,	1987*      Author:	Bryan Atsatt**	Entry:	jsr**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**      Output:	A = error code*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*		B = K**	 Uses:	All registers*		process_path*******************************************************************************write_protect	proc		with	my_dp		Import	process_path** Go look for the requested file.  Found?*		jsr	process_path		;Go find it.		bcs	exit			;Error,	so exit.** Yes, but we can't write, so exit with write protect error...*		Entry	wp_errorwp_error		lda	#drvr_wr_prot		;Get error code.exit2		sec				;Indicate error.exit		jmp	main_exit		;Exit.		Entry	INVALID_OPinvalid_op					;	        		lda	#invalid_fst_op		;Get invalid op error.		bra	exit2		ENDP	endif		Eject;======================================================================;Below is the main entry point for ALL FST system calls;;Input:     X = Call number * 2;           Y = Class number * 2;           A = undefinedsystem_call	PROC	Export		import	max_sys,sys_tbl		phk				;setup our bank register		plb		cpx	#max_sys+1		;maximum system calls		bcs	sys_err		jmp	(sys_tbl-2,x)		;call system routinesys_err		lda	#bad_system_call		rtl				;return error to Jim and Mike		ENDP		Eject;======================================================================;Below are my dispatch tables for application and system callsdispatch_tables	Record		Import	create,destroy,change_path,set_file_info,\			get_file_info,judge_name,volume,clear_backup,\			open,read,write,close,flush,set_mark,\			get_mark,set_eof,get_eof,get_dir_entry,\			get_dev_num,format_disk,erase_disk,fst_specific		Entry	cmd_tblcmd_tbl		DC.W	create		;01 Create : create a file call		DC.W	write_protect	;02 destroy : delete a file		DC.W	cmd_error	;03 OSShutdown (SCM)		DC.W	write_protect	;04 change_path : rename or move a file or subdir		DC.W	write_protect	;05 set_file_info : alter directory info on a file		DC.W	get_file_info	;06 GetFileInfo : return directory info on a file		DC.W	invalid_op	;07 judge_name : judge a name		DC.W	volume		;08 Volume : return information on a volume		DC.W	cmd_error	;09 SetPrefix (SCM)		DC.W	cmd_error	;0A GetPrefix (SCM)		DC.W	write_protect	;0B clear_backup : clear the backup bit on a file		DC.W	cmd_error	;0C SetSysPrefs (SCM)		DC.W	cmd_error	;0D RESERVED		DC.W	cmd_error	;0E ExpandPath (SCM)		DC.W	cmd_error	;0F GetSysPrefs (SCM)		DC.W	open		;10 Open : open a file or subdirectory		DC.W	cmd_error	;11 NewLine (SCM)		DC.W	read		;12 Read : read 'n' bytes from a file		DC.W	wp_error	;13 write : write 'n' bytes to a file		DC.W	close		;14 Close : close a file or subdirectoy		DC.W	flush		;15 Flush : flush a file(s)		DC.W	set_mark	;16 SetMark : set a file marker		DC.W	get_mark	;17 GetMark : return file marker		DC.W	wp_error	;18 set_eof : change EOF of a file		DC.W	get_eof		;19 GetEOF : return EOF of a file		DC.W	cmd_error	;1A SetLevel (SCM)		DC.W	cmd_error	;1B GetLevel (SCM)		DC.W	get_dir_entry	;1C GetDirEntry : return an entry from a directory		DC.W	cmd_error	;1D BeginSession (SCM)		DC.W	cmd_error	;1E EndSession (SCM)		DC.W	cmd_error	;1F SessionStatus (SCM)		DC.W	get_dev_num	;20 GetDevNum		DC.W	cmd_error	;21 GET_LAST_DEV (SCM)		DC.W	cmd_error	;22 READ_BLOCK : only in ProDOS fst		DC.W	cmd_error	;23 WRITE_BLOCK : only in ProDOS fst		DC.W	wp_error	;24 format_disk : format media and build directory		DC.W	wp_error	;25 erase_disk : build directory structure		DC.W	cmd_error	;26 ResetCache (SCM)		DC.W	cmd_error	;27 GetName (SCM)		DC.W	cmd_error	;28 GetBootVol (SCM)		DC.W	cmd_error	;29 Quit (SCM)		DC.W	cmd_error	;2A GetVersion (SCM)		DC.W	cmd_error	;2B GetFSTInfo (SCM)		DC.W	cmd_error	;2C DInfo (SCM)		DC.W	cmd_error	;2D DStatus (SCM)		DC.W	cmd_error	;2E DControl (SCM)		DC.W	cmd_error	;2F DRead (SCM)		DC.W	cmd_error	;30 DWrite (SCM)		DC.W	cmd_error	;31 BindInt (SCM)		DC.W	cmd_error	;32 UnbindInt (SCM)		DC.W	fst_specific	;33 FSTSpecific : map table handlingend_tbl		Export	Max_call:EQUMax_call	equ	end_tbl-cmd_tbl		;Last valid call I support		Import	startup,shutdown,sys_remove_vol,deferred_flush		Entry	sys_tblsys_tbl		DC.W	startup			;set ready for work		DC.W	shutdown		;get ready to quit		DC.W	sys_remove_vol		;remove local data from VCR		DC.W	deferred_flush		;flush deferred blocks.		Export	max_sys:equmax_sys		equ	*-sys_tbl		EndR		End