;======================================================================;; MSDos.Subs.aii;; This file contains the subroutines used by the main application-level; calls.;;======================================================================		Import	main_exit		PRINT	GEN		msb	off		longa	on		longi	on		include	'MSDos.equ'		print	push		print	off		include 'MSDos.Data.inc'		print	pop		Eject;======================================================================;get_time:   This routine will read the time from the GS Clock.;; ;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..0;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               hours,minutes;               year,month,day          ;all are setup with the time;               day_of_week;;uses:          Misc tools              ;(Gets hex time); ;======================================================================		longa	on		longi	onget_time	PROC		lda	#0000			;setup default time to zero		pha				;minutes,seconds result		pha				;year,hour results		pha				;month,day results		pha				;weekday,null results		ldx	#(read_time_hex*$100)+misc_tools		jsl	tool_locator		longa	off		sep	#$20		pla		sta	seconds		pla		sta	minutes		pla		sta	hours		pla		sta	year		pla		bcs	no_inc1		inc	ano_inc1		sta	day			;convert 0 to 30 ->  1 to 31		pla		bcs	no_inc2		inc	ano_inc2		sta	month			;convert 0 to 11 ->  1 to 12		pla				;null field		pla		sta	day_of_week		longa	on		rep	#$30		rts		ENDP		Eject;======================================================================;DOW_Convert:This routine convert Month,Day,Year into day of week;;Input:         A = Year;               X = Month;               Y = Day;               P = saved;               b = k;;Output:        A = day of week;               X = undefined;               Y = undefined;               P = restored;               b = k;;Uses:          all register;               local temps ;		longa	off		longi	offdow_convert	PROC		php		sep	#$30		phy		tay;Figure the number of leap years since 1900		lsr	a		lsr	a		sta	dow_temp;If it's a leap year and it's Jan or Feb subtract 1 from the total		tya				;get the year back		and	#%00000011		bne	stim015		cpx	#03		bcs	stim015		dey;add the number of leap years elapsed, the year, a constant for the;month, and the daystim015		clc		tya				;get the year again		adc	dow_temp		;# of leap years since 1900		adc	wkmon-1,x		adc	1,s		ply				;clean the stack;Now mod the result by seven, but exit in the range [1..7]		secstim016		sbc	#07		cmp	#08		bcs	stim016		plp				;restore mode		rtsdow_temp	DC.B	0wkmon		DC.B	$08,$0B,$0B,$07,$09,$0C,$07,$0A,$0D,$08,$0B,$0D		ENDP		Eject;======================================================================;Pack_Time:  This routine will read the time from the GS Clock and;            convert it to packed msdos disk format; ;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..0;               b = k;;Output:        A = undefined;               X = low word of time;               Y = High word of time;;               time is also stored at Pro_Time and Pro_Time+2 ;;Format of time:; ; |<-------- X Register --------->|<-------- Y Register --------->|; |                               |                               | ; |<--high Byte-->|<--low  Byte-->|<--high Byte-->|<--low  Byte-->| ;  _______________________________________________________________; | | | | | | | | | | | | | | | | | | | | | | | | | | | | | | | | |; |    year     | month |   day   |  hour   |   minute  |   secs  |; |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|; ; ;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          all register;               get_time                (Subroutine that reads time);               hours,minutes           (data words);               year,month,day; 		longa	on		longi	onpack_time	PROC	Export		stz	pro_time		stz	pro_time+2		jsr	get_time		;read the time from tool set;We call this entry point if the time parameters are setup and need;only to be convert to the MSDOS format.		EXPORT	convert_timeconvert_time		lda	day		sta	pro_time		;save the day in prodos format		lda	month		asl	a		asl	a		asl	a		asl	a		asl	a			;shift to correct position		ora	pro_time		;month is now happy		sta	pro_time		lda	year			;IIGS year is offset from 1900		sec		sbc	#80			;offset relative to 1980 for MSDOS		xba		asl	a			;shift year to upper 7 bits		ora	pro_time		sta	pro_time		tax				;return in X register too		lda	seconds		lsr	a			;MSDOS stores this in 2-second increments		sta	pro_time+2		lda	minutes		asl	a			;shift into position		asl	a		asl	a		asl	a		asl	a		ora	pro_time+2		;combine with seconds		sta	pro_time+2		lda	hours		xba		asl	a			;shift into position		asl	a		asl	a		ora	pro_time+2		sta	pro_time+2		tay				;return in Y register		clc				; 27-Jan-92 MSD: valid date/time		rts		ENDP		Eject;======================================================================;unpack_time:   This routine will unpack an msdos time into a GS/OS time.;;Input:         A = undefined;;Format of time:; ; |<-------- X Register --------->|<-------- Y Register --------->|; |                               |                               | ; |<--high Byte-->|<--low  Byte-->|<--high Byte-->|<--low  Byte-->| ;  _______________________________________________________________; | | | | | | | | | | | | | | | | | | | | | | | | | | | | | | | | |; |    year     | month |   day   |  hour   |   minute  |   secs  |; |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|; ;               P = nvmxdizc;                   ..000..0;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;               hours                   (Times are all hex format);               minutes;               year;               month;               day;               day_of_week ;;Uses:          all register;               dow_convert             (Subroutine);		longa	on		longi	onunpack_time	PROC	Export		stx	pro_time		sty	pro_time+2;Init time to zero (unknown)		jsr	zero_date		txa		ora	pro_time+2		beq	end_unpack		lda	pro_time		and	#$001F			;isolate day		sta	day		cmp	#32			;valid days are 01 to 31		bcs	zero_date		;sorry bud you get unknown		tay				;save for DOW convert		txa				;get year/month/day again (X is still valid here)		lsr	a		lsr	a		lsr	a		lsr	a		lsr	a		and	#$000F			;isolate month		sta	month		cmp	#13			;is the month 13 or >?		bcs	zero_date		tax		lda	pro_time		xba		lsr	a		and	#$007F			;isolate the year		clc		adc	#80			;adjust relative to 1980 (IIGS offsets from 1900)		sta	year		jsr	dow_convert		;go ahead and calculate the day of week		sta	day_of_week		lda	pro_time+2		;get seconds		and	#%000000000001111	;isolate		asl	a			;stored as # of 2-second increments		sta	seconds		cmp	#60		bcs	zero_date		lda	pro_time+2		lsr	a			;shift down		lsr	a		lsr	a		lsr	a		lsr	a		and	#%0000000000111111	;isolate minutes		sta	minutes		cmp	#60		bcs	zero_date		lda	pro_time+2		xba		lsr	a		lsr	a		lsr	a		and	#$001F			;isolate hours		sta	hours		cmp	#24		bcc	end_unpackzero_date					;indicate that the date is unknown		stz	hours		stz	minutes		stz	year		stz	month		stz	day		stz	day_of_weekend_unpack	rts		ENDP		Eject;==========================================================================;set_default_buf:       sets up the default buffer pointer;;;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          A register;		longa	on		longi	onset_default_buf	PROC	Export		lda	gbuf_addr		;setup the general I/O buffer		sta	drvr_buf_ptr		lda	gbuf_addr+2		sta	drvr_buf_ptr+2		rts		EXPORT	standard_reqstandard_req		lda	#blk_size		sta	drvr_req_cnt		stz	drvr_req_cnt+2		rts		ENDP		Eject;======================================================================;clear_gbuf_low This routine will zero the lower half of the general;               buffer.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               gbuf_ptr;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          All registers;               gbuf_ptr; 		longa	on		longi	onclear_gbuf_low	PROC	Export		with	my_dp		lda	#$0000		bra	do_clear		EXPORT	fill_gbuf_lowfill_gbuf_low		lda	#$FFFFdo_clear		ldy	#$01FEclear		sta	[gbuf_ptr],y		dey		dey		bpl	clear		rts		ENDP		Eject;======================================================================;clear_gbuf_hi. This routine will zero the upper half of the general;               buffer.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               gbuf_ptr;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          All registers;               gbuf_ptr;               temp3_ptr; 		longa	on		longi	onclear_gbuf_high	PROC	Export		with	my_dp		clc		lda	gbuf_ptr		adc	#$0200		sta	temp3_ptr		lda	gbuf_ptr+2		adc	#$0000		sta	temp3_ptr+2		ldy	#$01FE		lda	#$0000clear		sta	[temp3_ptr],y		dey		dey		bpl	clear		rts		ENDP		Eject;======================================================================;Device_call:calls the dispatcher and trys to read or write.  If the;            call returns a disk switched error then the routine will;            re-read the disk again. ;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               all parameters for the driver must be setup except for;               drvr_blk_size and drvr_fst_num, these are setup by the;               call. (ONLY if the call is a READ or WRITE) ;          ;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;Uses:          All registers;               Device Dispatcher  (subroutine);device_call	PROC	Export		lda	drvr_call_num		cmp	#drvr_status		bcs	to_device		;just call the device		cmp	#drvr_write		beq	is_write		lda	drvr_cache		and	#$7FFF			;clear the deferred bit if not a write		sta	drvr_cache		bra	do_itis_write		sta	write_occurred		;indicate that a write occured during this call		lda	drvr_dev_num		;save the device number that I have written too.		sta	write_dev_numdo_it		lda	#blk_size		sta	drvr_blk_size		stz	drvr_blk_num+2to_device		jsl	dev_dispatcher		;call the read routine		rts		ENDP		Eject;======================================================================;read_with_cache:;write_with_cache:;               This routine with make a device read/write call and;               store the data in the system cache. error occurs;               (other then the I/O error) the mount volume routine;               will be called.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               all parameters for the driver must be setup.;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;Uses:          All registers;               Device Dispatcher  (subroutine);               device_callread_with_cache	PROC	Export		with	my_dp		Import	dev_with_mount		lda	#drvr_read		bra	continue		EXPORT	write_with_cachewrite_with_cache		lda	#drvr_writecontinue		sta	drvr_call_num		lda	[my_vcr_ptr]		;setup the Volume ID field		sta	drvr_vol_id		lda	drvr_cache		;save current cache setting		pha		lda	#in_cache		;store this block in the cache		sta	drvr_cache		jsr	dev_with_mount		php				;save processor status 'A' = error code		tax				;save any error code		lda	2,s			;restore old cache value		sta	drvr_cache		txa		plp				;restore carry bit		plx				;fix the stack		rts		ENDP		Eject;============================================================================;get_fat_entry	Proc	Export;; This routine accepts a cluster number as input, and returns the FAT entry; corresponding to that cluster number.;; Input:	A = cluster number;; Output:	A = entry contents;		carry set if = end of chain ($FFx);; Uses:		FAT_ptr;		Y;;============================================================================		longa	on		longi	on		with	my_dp		pha				;save cluster # on stack		ldy	#msdos_vcr.FAT_type	;what type of FAT do we have		lda	[msdos_vcr_ptr],y		bne	@16_bit			;FAT uses 16-bit entries@12_bit		lda	1,s			;retrieve cluster number again		lsr	a			;divide by 2		php				;save carry		clc		adc	2,s			;cluster *= 1.5		tay				;into indexor		lda	[fat_ptr],y		;get the entry from the FAT		plp				;was cluster odd or even?		bcc	@even			;even, no shift necessary		lsr	a			;else must shift down		lsr	a		lsr	a		lsr	a@even		and	#$0FFF			;cluster #'s are only 12-bits wide		ply				;remove cluster # from stack		cmp	#$0FF0			;set carry if cluster # >= $0FF0		rts				;back to caller@16_bit		lda	1,s			;retrieve cluster number again		asl	a			;multiply by 2		tay		lda	[fat_ptr],y		;get the next link of the chain		ply				;remove number from stack		cmp	#$FFF0			;set carry if end of chain		rts		EndP		Eject;============================================================================;Cluster2Block	Proc	Export;;		This routine converts a cluster number supplied in the;		acccumulator into an absolute block number.;; Input:	Acc = cluster number;; Output:	Acc = absolute block number;; Uses:		with	my_dp;;============================================================================		phy		phx				;save registers to be used		tay				;cluster 0?		bne	@real_cluster		;zero means it's the root directory		ldy	#msdos_vcr.root_dir_block		lda	[msdos_vcr_ptr],y	;get the starting block number		bra	@was_root@real_cluster		dec	a			;first data cluster is always #2		dec	a		pha				;save cluster number		ldy	#msdos_vcr.cluster_size		lda	[msdos_vcr_ptr],y	;get sectors-per-cluster		and	#$00FF			;only a byte-wide parameter@loop		lsr	a			;multiply cluster # by sectors-per-cluster		tax		bcs	@done		pla		asl	a		pha		txa		bra	@loop@done		pla				;retrieve result		ldy	#msdos_vcr.data_start		clc		adc	[msdos_vcr_ptr],y	;combine with first data block@was_root		plx				;restore registers		ply		rts		EndP		Eject******************************************************************************** Deref_map - dereferences virtual pointer to file type translation table and places* the real pointer into map_ptr*deref_map	Proc	Export		with	my_dp		ldx	map_buffer_vp		;Get vp.		ldy	map_buffer_vp+2		jsl	deref			;Dereference it.		stx	map_ptr			;Put in	direct page pointer.		sty	map_ptr+2		rts		EndP		eject********************************************************************************	 Name:	get_file_type** Description:	Scans name in file_name buffer and tries to assign file type*		by matching entries in the file type map table.**		The file type map is a list of file name suffixes and associated*		file types.  Each record is variable length and consists of an*		ascii string followed by a zero and a one byte file type.  The*		table is terminated will a 1 byte null (00):**		map_size		;(w) size in bytes.*		record_0		;file type record.*		record_1		;file type record.*		.*		.*		.*		null			;(b) map terminator.**		If no matching entry is found, the 'unknown' (00) type is*		returned.**     Created:	Dec 3, 1987*    Modified:	Feb 23, 1989*      Author:	Bryan Atsatt**	Entry:	jsr**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		filename		;holds name in gstring format*		map_buffer_vp		;holds a virtual pointer to the file type map*		map_enable_flag		;0 if disabled.**      Output:	A = auxiliary_type (was undefined) 11-Aug-92 DAL*		X = file_type*		Y = unchanged*		P = nvmxdizc*		    ..000...*		B = K**	 Uses:	All registers*		temp1*		length********************************************************************************** 11-Aug-92 DAL -- Modified routine somewhat extensively to return auxtype in A.get_file_type	proc	Export		with	my_dp** If map_enable_flag is zero, then exit with unknown file type...*		phy				;Save Y.		ldx	#0			;anticipate unknown filetype		lda	map_enable_flag		;Flag zero?		beq	exit			;Yep. (A and X are both zero for unknown)** Copy the pointer into map_ptr, init offset and set 8 bit accumulator...*		jsr	deref_map		lda	#0			;pre-zero the high byte of A		longa	off			;Set 8 bit A.		sep	#$20** Have we checked all records? If so, exit with file type 00...*init_search	ldy	#2			;Init offset past length.record_loop		ldx	#0			;anticipate filetype zero		lda	[map_ptr],y		;Get byte. Zero?		beq	exit			;Yes, so exit with file type 00.** Nope, let's find the end of the string for this record and get its length...*		ldx	#0			;Init count.end_loop	inx				;Bump count.		iny				;Bump offset.		lda	[map_ptr],y		;Get byte. Zero?		bne	end_loop		;Nope, so continue.		phy				;Yes, save offset.		stx	length			;Save length.		dey				;Point to last character.** Does the string match?*		cpx	filename.length		;String longer than filename?		beq	check_it		;Nope.		bcs	next_record		;Yep, so don't check.check_it	ldx	filename.length		;Get length of filename.match_loop	lda	[map_ptr],y		;Get character.		cmp	filename.text-1,x	;Match?		bne	next_record		;Nope.		dey				;Yes, back up one.		dex		dec	length			;Done with string?		bne	match_loop		;Nope, so loop.** Yes, so get file type, restore 16 bit accumulator and exit...*		ply				;Recover offset.		iny				;Point to file type.		lda	[map_ptr],y		;Get file type.		longa	on			;Restore 16 bit A.		rep	#$20		and	#$00ff			;Clear high byte.		tax				;Put file type in X.		iny				;point to auxiliary type		lda	[map_ptr],y		;Put auxiliary type into Aexit		rep	#$20		ply				;Recover Y.		rts				;Exit.** No, so let's point to the next record and loop...*next_record	ply				;Recover offset.		iny				;Point to file type.*** added 11-Aug-92 DAL		iny				;point to auxtype low byte		iny				;point to auxtype high byte*** end 11-Aug-92		iny				;Point to next record.		bra	record_loop		;Loop.		ENDP		Eject;======================================================================;setup_fat_ptr: This routine will return a pointer to the fat;               buffer and setup 'fat_ptr' to point to the fat buffer;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               my_vcr_ptr              (Points to main VCR);;Output:        A = undefined;               X = low word of fat_ptr;               Y = high word of fat_ptr;               P = nvmxdizc;                   ..000...;               b = k;;               fat_ptr                 (fat_ptr pointer is setup);;Uses:          All registers;               my_vcr_ptr; 		longa	on		longi	onsetup_fat_ptr	PROC		with	my_dp		clc		lda	my_vcr_ptr		adc	#vcr.fat_start		;starting location of FAT		sta	fat_ptr		tax		lda	my_vcr_ptr+2		adc	#$0000		sta	fat_ptr+2		tay		rts		ENDP		Eject;======================================================================;setup_my_vcr:  this routine sets up a pointer to the MSDOS specific;               volume control record.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               my_vcr_ptr              (Points to main VCR);;Output:        A = undefined;               X = low word of MSDOS vcr;               Y = high word of MSDOS vcr;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          All registers;               my_vcr_ptr; 		longa	on		longi	onsetup_my_vcr	PROC	Export		with	my_dp		jsr	setup_fat_ptr		;first, set the FAT pointer		clc		lda	my_vcr_ptr		adc	#vcr.dev+2		;start of local data for vcr		sta	msdos_vcr_ptr		tax		lda	my_vcr_ptr+2		adc	#$0000		sta	msdos_vcr_ptr+2		tay		rts		ENDP		Eject;======================================================================;setup_my_fcr:  this routine sets up a pointer to the MSDOS specific;               file control record data.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               my_fcr_ptr              (Points to main FCR);;Output:        A = undefined;               X = low word of MSDOS fcr;               Y = high word of MSDOS fcr;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          All registers;               my_fcr_ptr; 		longa	on		longi	onsetup_my_fcr	PROC	Export		with	my_dp		clc		lda	my_fcr_ptr		adc	#fcr.msdos_stuff	;start of local data for fcr		sta	msdos_fcr_ptr		tax				;return in X and Y		lda	my_fcr_ptr+2		adc	#$0000		sta	msdos_fcr_ptr+2		tay		rts		ENDP		Eject;======================================================================;setup_io_ptrs  this routine sets up pointers to the active data buffers;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               my_fcr_ptr              (Points to main FCR);               msdos_fcr_ptr           (points to specific data);;Output:        A = undefined;               X = low word of MSDOS vcr;               Y = high word of MSDOS vcr;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          All registers;               my_fcr_ptr;               math_temp;		longa	on		longi	onsetup_io_ptrs	PROC	Export		with	my_dp		stz	data_ptr		;init the pointers		stz	data_ptr+2		ldy	#msdos_fcr.status	;see if there is a data block		lda	[msdos_fcr_ptr],y		and	#data_active		beq	end_io_setup		;there is no data block		clc		lda	my_fcr_ptr		adc	#fcr.io_start		sta	data_ptr		lda	my_fcr_ptr+2		adc	#$0000		sta	data_ptr+2end_io_setup		rts		ENDP		Eject;==========================================================================;calc_free_blks This routine will calculate the number of blocks that are;               free on a volume.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_vcr_ptr          (must be setup correctly);               drvr_dev_num            (must be setup up);;Output:        A = error code if carry set otherwise total blocks free;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               device_call;               I/O buffer;		longa	on		longi	oncalc_free_blks	PROC	Export		with	my_dp;before we start going to disk lets see if we already know the number of;free blocks.   IF free_blocks = $FFFF then free blocks are unknown.		ldy	#msdos_vcr.free_blocks		lda	[msdos_vcr_ptr],y		inc	a		beq	go_figure		;we need to calculate it		dec	a			;A = total blocks		clc		rtsgo_figure;		jsr	force_bitmap		;flush the bitmap if needed;setup a pointer to the FAT		jsr	setup_fat_ptr;go do a run on the FAT calculating the number of blocks free; calculate the number of clusters we need to scan		ldy	#msdos_vcr.total_sectors		lda	[msdos_vcr_ptr],y	;get total # of sectors		sta	math_temp		;store as dividend		ldy	#msdos_vcr.cluster_size		lda	[msdos_vcr_ptr],y		and	#$00FF			;this is only a byte-wide parameter		pha				;save for accumulation		lsr	a			;start the division		beq	@one_block		;only 1 block per cluster@count_clusters		lsr	math_temp		lsr	a			;divide total by blocks per cluster		bne	@count_clusters@one_block		ldx	math_temp		;get count of clusters;We now have the number of clusters on disk in the X register.  Loop through;the FAT looking for free clusters.  When one is found, update the free;blocks count by the numbers of blocks contained within each cluster.		stz	math_temp		;counts the free blocksfor_loop		txa		jsr	get_FAT_entry		;retrieve an entry from the FAT		tay		bne	used			;if non-zero, the cluster is in use		lda	math_temp		;else update the free blocks count		clc		adc	1,s			;cluster_size still on stack		sta	math_tempused		dex				;loop through entire FAT		bne	for_loop		;(cluster 0 is ALWAYS in use)		pla				;clean up stack;When we get here we have counted all the blocks that are marked as free.calc_done		lda	math_temp		;number of blocks free;Now lets update the VCR to indicate that we know the number of free blockssave_and_exit		ldy	#msdos_vcr.free_blocks		sta	[msdos_vcr_ptr],y	;total free count		clc		rts		EndP		Eject;==========================================================================;count_blks_used: counts the number of blocks used by a file's FAT chain;;Input:         A = first cluster number of chain;;output:        A = low word-blocks used by file;               X = high word-blocks used by file;count_blks_used	Proc	Export		with	my_dp		tax				;start cluster = 0?		bne	@real_file		;no, it's a real file		ldy	#msdos_vcr.data_start	;else it's root directory		lda	[msdos_vcr_ptr],y	;return size of root directory		sec		ldy	#msdos_vcr.root_dir_block		sbc	[msdos_vcr_ptr],y		rts				;X is already 0@real_file		stz	math_temp+2		;this is our block accumulatorloop		inc	math_temp+2		;include first cluster		jsr	get_fat_entry		;get the next FAT entry		bcc	loop			;loop through entire chain		ldy	#msdos_vcr.cluster_size		lda	[msdos_vcr_ptr],y	;get the # of blocks per cluster		and	#$00FF			;only a byte-sized parameter		pha				;space for result		pha		pha				;put multiplier on stack		pei	math_temp+2		;put multiplicand on stack		ldx	#$090B			;IntMath Multiply call		jsl	$E10000		pla				;retrieve results		plx		rts				;back to caller		EndP		Eject;======================================================================;free_vcr:      This routine will free all memory associated with a;               volume control record.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               my_vcr_ptr              (Points to main VCR);;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          All registers;               release_seg             (system routine to release a vcr); ;======================================================================		longa	on		longi	onfree_vcr	PROC	Export		with	my_dp		lda	[my_vcr_ptr]		;get the volume ID		jsl	release_vcr		;and call the systems nuke vcr routine		rts		ENDP		Eject;======================================================================;Remove_fcr:    This routine will remove a FCR;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               my_fcr_ptr              (must be setup);;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          All registers;;======================================================================		longa	on		longi	onremove_fcr	PROC	Export		with	my_dp		ldy	#msdos_vcr.dirty_file_cnt ;check if bitmap needs to be flushed		lda	[msdos_vcr_ptr],y		dec	a		bne	@did_flush		;we do not need to flush the bitmap	if NOT read_only_fst then		jsr	force_bitmap		;force a dirty block to disk		bcs	@error			;we have to be able to flush	endif@did_flush		ldy	#vcr.open_cnt		;subtract one from the open count		lda	[my_vcr_ptr],y		dec	a		bmi	die_die_die		;the system is very sick		sta	[my_vcr_ptr],y		;Update the open count in the VCR		lda	[my_fcr_ptr]		;reference number to remove		jsl	release_fcr		;nuke the puppy		clc				;we are very happy now@error		rtsdie_die_die		lda	#'SK'		jml	sys_death		ENDP		Eject;======================================================================;activate_vcr:  This routine will mark the vcr as being logged in;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               my_vcr_ptr              (Points to main VCR);;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;                                       (the VCR is logged in);;Uses:          All registers;               my_vcr_ptr; 		longa	on		longi	onactivate_vcr	PROC		with	my_dp		ldy	#vcr.status		lda	[my_vcr_ptr],y		and	#vcr_swapped_in		sta	[my_vcr_ptr],y		rts		ENDP		Eject;======================================================================;ID.Disk:       This file contains the code that will id the media;               to determine if the media is in MSDos format.;               If the disk is an MSDos disk and there is no VCR then;               a new VCR will be generated for that disk.  If there is;               a VCR then it is marked active.;;Input:         A = device number;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               drvr_buf_ptr            ;points to storage/vol name field;                                       ;with storage type removed;Uses:          All registers;               Device Dispatcher  (subroutine);               General I/O Buffer (1K buffer, I read 512 bytes);;Diagram of pointers and memory segments;; (I/O Buffer);  ___________; |           | <--- pointed to by 'drvr_buf_ptr'; |           | <---               'drvr_buf_ptr' later points to volume name; |___________|    |;                  |____ 'temp3_ptr' points to data AFTER volume name area;;;  (vcr);  ___________ <-- pointed to by 'my_vcr_ptr'; |           |         ___________________; | vol name -|------> |___________________| <-- pointed to by 'Temp2_Ptr'; |           |; |           | ; |           |; |           | <-- pointed to by 'msdos_vcr_ptr'; |___________|;		longa	on		longi	onid_disk		PROC	Export		with	my_dp		sta	drvr_dev_num		;driver number		lda	#drvr_read		sta	drvr_call_num		stz	drvr_blk_num		;read in block 0		stz	drvr_blk_num+2		jsr	standard_req		jsr	set_default_buf		;setup pointer to general I/O buffertry_again	jsr	device_call		;make a system call to drive		bcc	id_no_error		and	#$00FF			;clear the dispatcher error code		beq	id_no_error		;Dispatcher returning disk switched		cmp	#drvr_disk_sw		;was the disk switched?		beq	try_again		sec				;swapped out by device call routineerror_out		rts				;if the disk was switched ;======================================================================;ID method used to determine disk is MSDOS format:;;(1)            read in block 0 (the boot sector);(2)            the first byte (offset $00) must be $E9 or $EB;(3)            byte at offset $1FE must be $55;(4)            byte at offset $1FF must be $AA;(5)		bytes per sector must be 512;;======================================================================id_no_error	lda	[drvr_buf_ptr]		;id byte		and	#$00ff		cmp	#$EB			;8088 short jump instruction?		beq	@1			;yup		cmp	#$E9			;8088 long jump instruction?		bne	bad_format		;nope, can't be MSDOS@1		ldy	#$1FE			;offset to last two bytes of the block		lda	[drvr_buf_ptr],y		cmp	#$AA55			;signature bytes?		bne	bad_format		;no...		ldy	#$000B			;check the bytes per sector value		lda	[drvr_buf_ptr],y		cmp	#blk_size		;is it normal?		beq	build_vcr		;yes, go build the VCRbad_format		lda	#unknown_vol		;I don't know what this disk is		sec		rts		Eject;======================================================================;Build_VCR:     This routine will add a new VCR if one is currently not;               allocated, if the VCR is allocated then it will be;               marked as active.; ;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               drvr_buf_ptr            (points to boot sector) ;               cp_device_flag = 1 if doing a ChangePath call and source is device #;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;;Uses:          All registers;               find_vcr                (system subroutine);               alloc_vcr               (system subroutine) ;               General I/O Buffer      (1K buffer, I read 512 bytes); 		longa	on		longi	onbuild_vcr;Now that I know i have an MSDos disk, I have to read the root directory;and scan for a volume label entry.; first, copy the bios parameter block out of the block buffer		with	bios_parm_block				lda	drvr_buf_ptr		;bump pointer to beginning of bpb		clc		adc	#$000b		sta	drvr_buf_ptr		ldy	#bpb_size-1		sep	#$20			;move a byte at a time		longa	off@loop		lda	[drvr_buf_ptr],y		sta	bios_parm_block,y		dey		bpl	@loop		rep	#$20		longa	on; calculate first block of root directory		lda	FAT_count		;retrieve # of FATs		and	#$00FF			;(only a 1 byte field)		tax				;into X as multiplier		lda	#0			;clear accumulator		clc@multiply		adc	FAT_size		;multiply # of FATs by # of sectors per FAT		dex		bne	@multiply		adc	reserved_sectors	;include # of reserved sectors		sta	root_dir_block		;store as beginning block of root directory		sta	drvr_blk_num		;and block # to read		lda	root_dir_count		;retrieve # of entries in root directory		lsr	a			;calculate # of directory blocks		lsr	a		lsr	a		lsr	a		sta	root_dir_size;Now we go into a loop, reading root directory blocks and examining the;directory entries until we either (a) find a volume label entry or;(b) hit the end of the directory.@read_next_block		lda	gbuf_addr		;use second half of global buffer		sta	drvr_buf_ptr		jsr	device_call		;read the directory block		bcs	error_out		ldx	#blk_size/32		;init counter		ldy	#dir_entry.attributes	;initialize index@entry_loop		lda	[drvr_buf_ptr]		;read the first byte of the entry		and	#$00FF		beq	@no_label_found		;end of directory found		cmp	#$00E5			;inactive entry?		beq	@next_entry		;yes, skip it		lda	[drvr_buf_ptr],y	;read the attribute byte		bit	#vol_label		;is this a volume label?		beq	@next_entry		;no...		brl	@found_label		;yes!@next_entry		clc				;bump pointer to next entry		lda	drvr_buf_ptr		adc	#32			;each entry is 32 bytes		sta	drvr_buf_ptr		dex				;decrement entries per block counter		bne	@entry_loop		;loop until all entries in this block are done		inc	drvr_blk_num		;try the next block		lda	drvr_blk_num		;but only if we still have directory left		sec		sbc	root_dir_block		;subtract beginning block number		cmp	root_dir_size		;done all directory blocks yet?		blt	@read_next_block	;no, go read another; At this point, we didn't find a volume label, so we have to make one up@no_label_found		stz	parent_blk		stz	entry_offset		lda	FAT_size		;get size of each FAT		and	#$00FF		xba				;turn into a byte count		asl	a		sta	drvr_req_cnt		;we're (hopefully) going to read this many bytes		stz	drvr_req_cnt+2		jsl	alloc_seg		;get some memory		bcs	@no_memory		;none available?		phy				;save VP for disposal later		phx		jsl	deref			;turn into a real pointer		stx	FAT_ptr		sty	FAT_ptr+2		stx	drvr_buf_ptr		;now read the FAT into memory		sty	drvr_buf_ptr+2		lda	reserved_sectors	;FAT starts after the reserved sectors		sta	drvr_blk_num		stz	drvr_blk_num+2		jsr	device_call		;read the FAT		bcc	@fat_read		;we got it		plx				;clean up stack		plx@no_memory		rts				;and return error to caller@fat_read		lda	FAT_size		;get # of blocks in FAT		and	#$00FF		xba				;turn into a byte count		asl	a		tay				;into index		lda	#0			;init checksum		clc@inner_loop		dey		dey		beq	@chksum_done		adc	[FAT_ptr],y		;checksum the FAT		bra	@inner_loop@chksum_done		adc	[FAT_ptr]		;add in final word		pha				;put on stack for Int2Dec call		pea	default_name+6>>16	;put address of destination		pea	default_name+6		pea	5			;string length		pea	0			;the number is unsigned		ldx	#$260B			;Int2Dec		jsl	$E10000		plx				;retrieve VP		ply		jsl	release_seg		;we're done with the memory now		lda	#default_name		;point to the default name		sta	drvr_buf_ptr		lda	#^default_name		sta	drvr_buf_ptr+2		bra	@copy_name		; When we get here, we've found a volume label that we can use as a volume name@found_label		lda	drvr_blk_num		;save the block number of the volume label		sta	parent_blk		lda	drvr_buf_ptr		;calculate offset to entry		sec		sbc	gbuf_addr		sta	entry_offset@copy_name		sep	#$20			;copy label into gstring buffer		longa	off		ldy	#dir_entry.name+10	;volume labels are up to 11 characters@loop2		lda	[drvr_buf_ptr],y		sta	gstring+2,y		;leave room for leading length word		dey		bpl	@loop2				ldy	#dir_entry.attributes	;scan for last non-space character		lda	#' '@loop3		dey		cmp	gstring+2,y		beq	@loop3		iny				;correct character count		sty	gstring			;store the length		rep	#$20			;back to 16-bit accumulator		longa	on;; If bit 15 of cp_flag is set, assume the source disk is a duplicate volume; and fall into the code that handles duplicate volumes with open files.; Since cp_device_flag is already set, it will cause a fake VCR to be allocated.;					5-Dec-91 MSD;		bit	cp_flags	; should we assume the disk is a duplicate?		bpl	@not_dup	; no, so do the usual		brl	is_open		; yes, pretend duplicate volume with open files@not_dup; End of 5-Dec-91 MSD change.;Call system routine to see if it can find a vcr with the same volume;name.  If the accum contains a zero then the routine will;use x and y as a pointer to a volume name.  If the accum contains;a non zero value then the routine will try to find a vcr with;the same volume id.		ldx	#gstring		;pointer to the volume name		ldy	#^gstring		lda	#0000			;0000=search for vcr by name		jsl	find_vcr		bcs	no_vcr			;this name is not in any VCR		jsl	deref			;convert virtual to real		stx	my_vcr_ptr		sty	my_vcr_ptr+2		;setup pointer to VCR		ldy	#vcr.fst_id		lda	[my_vcr_ptr],y		cmp	#fst_id			;is this my vcr		bne	check_active		;if not, can we kick it out?		jsr	setup_my_vcr		;make a pointer to my vcr stuff		bit	drvr_fst_num		;are we looking at name only?		bmi	name_only		;yes.		sep	#$20			;byte-sized comparison		ldy	#bpb_size-1		;else compare the bios parmscompare_loop	lda	bios_parm_block,y		cmp	[msdos_vcr_ptr],y		bne	check_active2		dey		bpl	compare_loop		rep	#$20			;back to 16-bit accumulatorname_only		ldy	#vcr.dev		;update the last known device		lda	drvr_dev_num		sta	[my_vcr_ptr],y		jsr	activate_vcr		;mark the vcr as swapped in		clc		rtssorry_dup		lda	#dup_volume		;duplicate volume online		secerror_exit		rts;If we get here it means that the volume name already exist in vcr.;So I need to see if there are any open files on the volume.  If there;are no open files then I can kick the current vcr out of memory and;build a new one.  If there are open files then I will return a;duplicate volume error.  Note:  I check to make sure that the volume;header has not changed.  This protects me from marking a volume as;being swapped in and writing to it blindly if it has the same name.; Note - If we get a duplicate volume error and cp_device_flag = 1 then ignore;        the error since we are doing a ChangePath call with a device # as the source.;        1/22/91 CAEcheck_active2		rep	#$20			;back to 16-bit accumulatorcheck_active		ldy	#vcr.open_cnt		lda	[my_vcr_ptr],y		;any open files?		beq	not_open		;nois_open						;Added 5-Dec-91 MSD		lda	cp_device_flag		;are we doing a special ChangePath call?		beq	sorry_dup		;no - so report a duplicate volume error		ora	#$8000			;yes - so indicate we got a dup vol error		sta	cp_device_flag		lda	<drvr_dev_num		; 5-Feb-92 MSD: Force other VCR's for this		jsl	swap_out		; 5-Feb-92 MSD: to be swapped out.		bra	no_vcr			;and continuenot_open	jsr	free_vcr		;free vcr pointed to by 'my_vcr_ptr';below begins the grunt work.  we now have to allocate a new vcr and;setup all are fields. ; Note - If cp_device_flag = $8001 then we need to use a fake name for the VCR ;        since we got a duplicate volume error.  1/22/91 CAEno_vcr		lda	FAT_size		;calculate # of bytes in FAT		and	#$00FF		xba		asl	a		sta	FAT_byte_count		ldx	#gstring		;pointer to the name		ldy	#^gstring		lda	cp_device_flag		;do we need to use fake name for vcr?		bpl	@cont			;no		ldx	#fake_name_str		;yes - so point to fake name string		ldy	#^fake_name_str@cont		lda	#vcr.FAT_start		;calculate number of bytes to allocate		clc		adc	FAT_byte_count		;add enough room for a copy of the FAT		jsl	alloc_vcr		bcs	error_exitalloc_ok					;now build my data structures		jsl	deref			;convert virtual to real address		stx	my_vcr_ptr		sty	my_vcr_ptr+2		jsr	setup_my_vcr		;setup pointer to my data		ldy	#vcr.fst_id		;indicate that this vcr is owned by me.		lda	#fst_id		sta	[my_vcr_ptr],y		ldy	#vcr.dev		;save the device number		lda	drvr_dev_num		sta	[my_vcr_ptr],y		ldy	#vcr.status		lda	#0000			;zero the status word		sta	[my_vcr_ptr],y		ldy	#bpb_size-1		;copy the bios parm block to VCR		sep	#$20		longa	offentry_loop	lda	bios_parm_block,y		sta	[msdos_vcr_ptr],y		dey		bpl	entry_loop		;move the entire directory entry		rep	#$20		longa	on;warning: if the 'BPL' instruction above changes, then the accum will;         have to be loaded with $FFFF directly.		tya				;now init free blocks to $FFFF.  This		ldy	#msdos_vcr.free_blocks	;indicates that free blks is unknown		sta	[msdos_vcr_ptr],y; store the root directory starting block		ldy	#msdos_vcr.root_dir_block		lda	root_dir_block		sta	[msdos_vcr_ptr],y; now we have to determine whether the FAT uses 12-bit or 16-bit cluster numbers		ldy	#msdos_vcr.cluster_size		lda	[msdos_vcr_ptr],y	;get sectors per cluster		and	#$00FF		tax				;into X		ldy	#msdos_vcr.total_sectors		lda	[msdos_vcr_ptr],y	;get total sectors on volume@loop		pha				;save result		txa				;divide by 2		lsr	a		tax				;back into x		pla				;retrieve result		bcs	@done			;and done with cluster count in Acc		lsr	a			;divide by 2		bra	@loop@done		ldx	#0			;assume 12-bit cluster numbers		cmp	#4088			;>4087 clusters?		bcc	@12_bit			;assumed correctly		inx				;else flag 16-bit cluster numbers@12_bit		ldy	#msdos_vcr.FAT_type		txa		sta	[msdos_vcr_ptr],y; now calculate the first block of the data area		ldy	#msdos_vcr.root_dir_count		lda	[msdos_vcr_ptr],y	;get # of entries in root directory		lsr	a			;calculate # of root directory blocks		lsr	a		lsr	a		lsr	a		clc		ldy	#msdos_vcr.root_dir_block		adc	[msdos_vcr_ptr],y	;calculate block # of first data block		ldy	#msdos_vcr.data_start		sta	[msdos_vcr_ptr],y; now read the FAT into the VCR		lda	my_vcr_ptr		;calculate address within VCR		clc		adc	#vcr.FAT_start		sta	drvr_buf_ptr		lda	my_vcr_ptr+2		adc	#0		sta	drvr_buf_ptr+2		lda	FAT_byte_count		sta	drvr_req_cnt		;that's how many bytes we'll read		stz	drvr_req_cnt+2				lda	reserved_sectors	;FAT starts after the reserved sectors		sta	drvr_blk_num		stz	drvr_blk_num+2		jsr	device_call		;read the FAT				rts				;just return with any error		ENDP		Eject;======================================================================;Find_volume:   This routine will locate a volume using the ID routine.;;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               volume_name             (contains the volume name to find);;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;;Uses:          All registers;               find_vcr                (system subroutine);               id_disk                 (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes);               volume_name;               drvr_buf_ptr 		longa	on		longi	onfind_volume	PROC		with	my_dp		lda	#$0001			;start with device number 1		sta	search_device		stz	skip_dev		jsr	chk_vol_syntax		ldx	#volume_name		;try to find the volume in a vcr		ldy	#^volume_name		lda	#$0000		jsl	find_vcr		bcs	check_drive;check to see if this vcr is mine		jsl	deref			;convert to real pointer		stx	my_vcr_ptr		sty	my_vcr_ptr+2		ldy	#vcr.fst_id		lda	[my_vcr_ptr],y		cmp	#fst_id		beq	get_device		lda	#unknown_vol		;tell caller its another fsts		sec		rts				;return;setup the device number to check firstget_device		ldy	#vcr.dev		lda	[my_vcr_ptr],y		sta	search_device		sta	skip_dev		;indicate we are starting in the middle 		bra	do_idcheck_drive		lda	search_device		cmp	skip_dev		;do I need to skip this one?		beq	next_devdo_id		jsr	id_disk		bcc	compare_vol		cmp	#invalid_dev_num	;have we looked at all the devices?		beq	vol_not_avail		cmp	#dup_volume		;is the volume a duplicate?		beq	abort_search		bra	check_search		;go ahead and try another drive.vol_not_avail		lda	#vol_not_foundabort_search		sec		rts				;sorry not todaynext_dev		inc	search_device		bra	check_drivecompare_vol		lda	gstring			;get the length		cmp	volume_name		;sixteen bit name length		bne	check_search		;Cannot be the same		tay				;save the length		php		longa	off		sep	#$20			;short accum for string comparecomp_loop	lda	gstring+1,y		eor	volume_name+1,y		;case insensitive comparison		beq	@equal			;same character!		cmp	#$20			;difference only in case?		bne	not_same		;nope!		lda	gstring+1,y		;get character again		cmp	#'A'			;make sure it's alphabetic		bcc	not_same		cmp	#'Z'+1		bcc	@equal		cmp	#'a'			;lower case?		bcc	not_same		cmp	#'z'+1		bcs	not_same@equal		dey		bne	comp_loop		longa	on			;keep the assembler in line		plp		clc		rts				;this is it.not_same		plpcheck_search		lda	skip_dev		cmp	search_device		;are we looking at a default drive?		bne	next_dev		;no we are not.		stz	search_device		;start the search from the beginning		bra	next_devchk_vol_syntax					;check the syntax of the volume name		longa	off		longi	off		sep	#$30		ldy	volume_name		;get the length word		cpy	#12			;no more than 11 characters allowed		bcs	syntax_deathvol_syntax_loop		lda	volume_name+1,y	if 0 then	;original code, which will not allow volume label characters			;that the MSDOS documentation states are illegal, but which			;everybody uses anyways (and the OS doesn't really seem to care).		bmi	good_syntax		;quick validity check		cmp	#'A'			;quick check for normal characters		bcc	@must_check		cmp	#'Z'+1		bcc	good_syntax		cmp	#'a'		bcc	@must_check		cmp	#'z'+1		bcc	good_syntax@must_check		ldx	#illegal_count-1	;scan table of illegal characters@table_check		cmp	illegal_chars,x		beq	syntax_death		dex		bpl	@table_check	else		cmp	#delimiter		;pathname delimiter? (':')		beq	syntax_death		;yup, can't allow it in a volume name!	endifgood_syntax		dey		bne	vol_syntax_loop		rep	#$31			;clears carry too!		rtssyntax_death		longa	on		longi	on		rep	#$30		lda	#bad_path_syntax		brl	main_exit		;carry is already set from equal comparison	if 0 then	;original illegal character table;table of characters not allowed in volume nameillegal_chars		dc.b	'*','?','/','\','|','.'		dc.b	',',';',':','+','='		dc.b	'<','>','[',']',$09illegal_count	equ	*-illegal_chars	endif;local data for find volumesearch_device	DC.W	00skip_dev	DC.W	00		ENDP		Eject;======================================================================;Find_File:     This file contains the code that will locate a file on;               disk.;;revisions:;               apr 09 1987             ;added forward/backward link verify ;               apr 09 1987             ;changed routine to read a block;                                       ;at a time instead of 1K;               apr 10 1987             ;added additional check for path;                                       ;searching.;               apr 27 1987             ;changed code to handle 'C' strings;               may 02 1987             ;added memory based tree routines;                                       ;so all accessed directories will;                                       ;be added into a b-tree. ;               sep 14 1987             ;added support for searching for;                                       ;blank entries in the directory;;Input:         A = device number;               X = low word: pointer to name;               Y = high word: pointer to name;               P = nvmxdizc;                   ..000...;               b = k;;               drvr_vol_id;               my_vcr_ptr;               msdos_vcr_ptr;               search_flag             ;IF bit 14 = 1 then search for blank;                                       ;blank entry in directory, as well;                                       ;as checking for duplicate file error.;;Format of pathname:;               1) volume name is NOT part of the pathname;               2) pathname begins with a length byte (NOT!!!);               3) each part of the pathname is seperated with a colon char.;               4) pathname MUST end with a NULL char.; ;Output:        A = error code or offset to entry within the I/O buffer;               X = pointer to name (low word);               Y = pointer to name (high word);               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               dir_start_blk           ;starting block of last dir searched;               free_dir_blk            ;first block with a blank entry;               free_dir_offset         ;offset to first free entry within blk;               dir_last_blk            ;block number that contains found file.;            or drvr_blk_num            ;or the last block of the directory.;               path_searched           ;if + then entire path NOT searched;                                       ;if - then the entire path was searched;               slug_block              ;block number of the entry;               slug_offset             ;offset to the entry.;;Uses:          All registers;               Device Dispatcher  (subroutine);               General I/O Buffer (1K buffer, I read 1K bytes);               temp_ptr;               gbuf_ptr ;               path_level;		longa	on		longi	onfind_file	PROC	Export		with	my_dp		sta	drvr_dev_num		;device number to search on		stx	temp_ptr		;pointer to the name		sty	temp_ptr+2		lda	gbuf_addr		sta	gbuf_ptr		sta	drvr_buf_ptr		lda	gbuf_addr+2		sta	gbuf_ptr+2		sta	drvr_buf_ptr+2		stz	curr_mod_date		;zero the latest mod date field		stz	curr_mod_date+2		ldy	#msdos_vcr.root_dir_count		lda	[msdos_vcr_ptr],y	;get # of root directory entries		lsr	a			;divide by # of entries per block (16)		lsr	a			;to determine # of blocks used to hold directory		lsr	a		lsr	a		sta	sector_count		;this is the maximum number of sectors to read		stz	cluster_num		;cluster 0 signifies root directory		ldy	#msdos_vcr.root_dir_block		lda	[msdos_vcr_ptr],y	;default starting block		sta	dir_start_blk		;starting block for current directory		sta	dir_last_blk		;last block read by find file		sta	drvr_blk_num		stz	drvr_blk_num+2		jsr	standard_req		lda	#drvr_read		;setup for reading		sta	drvr_call_num		stz	chars_checked		stz	path_searched		;indicates if entire path searched		jsr	setup_name		;setup first part to look for		stz	entries_blk_num		;block that contains the entryoutter_loop		stz	last_blk		;used to verify directory structure		stz	free_dir_blk		;indicate no free dir entry		stz	free_dir_offset		stz	searching_free		;we are looking for free entriessearch_loop		jsr	read_with_cache		;issue the read command		bcs	error_leave		;some error has occured		ldy	#0			;start at beginning of block		stz	entries_checked		;initialize counter		jsr	check_block		;see if name is in the block		bcc	found		bit	searching_free		;are we looking for a free entry?		bpl	check_active		;no we are looking for the file.		lda	free_dir_blk		;Have we found a free entry yet?		beq	load_next		;No, so load the next block		bit	path_searched		;are we looking for the last name?		bpl	load_next		;No.		bra	no_more_blks		;yes, so return datacheck_active		lda	entries_checked		;all entries in block examined?		cmp	#entries_per_block		bne	not_found		;no, must have reached end of directoryload_next		dec	sector_count		;decrement count		beq	@next_cluster		;done all blocks in this cluster		inc	drvr_blk_num		;read this block next		inc	dir_last_blk		;save last block read		bra	search_loop@next_cluster		lda	cluster_num		;get the current cluster number		beq	no_more_blks		;if 0, we reached the end of the root directory		jsr	get_FAT_entry		;find the next cluster to process		bcs	no_more_blks		;we reached the end of the chain		sta	cluster_num		;remember for later		jsr	cluster2block		;convert to block number		sta	drvr_blk_num		;read this block next		sta	dir_last_blk		ldy	#msdos_vcr.cluster_size		lda	[msdos_vcr_ptr],y	;get # of sectors per cluster		and	#$00FF			;only a byte-wide parameter		sta	sector_count		bra	search_loop		;keep scanningnot_found		bit	search_flag		;are we suppose to find a free entry?		bvc	no_more_blks		;no we are not		lda	free_dir_blk		;do we already have a free entry?		bne	no_more_blks		;yes we do!		dec	searching_free		bra	load_next		;continue to look for a blank entry.no_more_blks		lda	path_searched		;was the entire path searched?		bne	file_err		;yes the entire path was searched		lda	#path_not_found		;a subdirectory was not found		sec		rtsfile_err		lda	#file_not_found		;you guessed it, no file today		sec				;sorry no file by that nameerror_leave	rts;If we get here then we have found the name we were looking for.;Now we need to see if there is anymore pathname to process.  If there;is nothing left to process then we exit all happy.  If there is more;to process then we make sure that the entry we just found is a;subdirectory.  If it is not then we exit with file not found. found		lda	drvr_blk_num		;block number that contains entry		sta	entries_blk_num		;block number that contains the entry		sta	dir_last_blk		;last block read		sty	entries_offset		;offset to the entry		tyx		ldy	chars_checked		dey		lda	[temp_ptr],y		;see if we are done		and	#$00FF		beq	find_success		;yes we have succeeded		txa		clc		adc	#dir_entry.attributes	;offset to attributes field		tay		lda	[gbuf_ptr],y		;see if type is directory		and	#subdirectory		beq	not_found		;nope, can not go any further		lda	drvr_blk_num		;save the entries block number for		sta	slug_block		;slug ripple routine.		stx	slug_offset		;offset to file entry.		txa		clc		adc	#dir_entry.start_cluster ;make index to starting cluster number field		tay		lda	[gbuf_ptr],y;; 09/01/92 - GAB; Save starting cluster number for the subdirectory;		sta	cluster_num		;remember for later; 09/01/92 - End		jsr	cluster2block		;convert to block number		sta	drvr_blk_num		sta	dir_start_blk		;starting block for next directory		sta	dir_last_blk		;save last block read;; 09/01/92 - GAB; While searching the subdirectory, we should really reset the sector_count to the number of blocks; that are contained in a cluster, instead of leaving it set to the number of blocks used for the; root directory.;		ldy	#msdos_vcr.cluster_size		lda	[msdos_vcr_ptr],y	;get # of sectors per cluster		and	#$00FF			;only a byte-wide parameter		sta	sector_count; 09/01/92 - End		jsr	setup_name		;setup next partial to find		brl	outter_loop;Below is a happy place to be.  This means that we have found the;file that we were commissioned to find.  So we will setup a pointer;to the name and return to the caller.  Isnt' that special. find_success	txa				;we have located the name		pha				;save the offset 		clc		adc	gbuf_ptr		;adjust buffer pointer		tax		lda	#0000		adc	gbuf_ptr+2		tay		pla				;offset (0 to 512)		clc		rts				;X,Y contains a pointer to the namesector_count	dc.w	0			;# of sectors in current clustercluster_num	dc.w	0			;current cluster number;==========================================================================;The following routine will look at all the entries within a directory;block.  The entry is skipped if it is an inactive entry.  If an entry is;found that is active then it is checked against the name we are looking for.;If the name is found then we exit indicating that we have found the file.  We;continue to look for the name until we have looked at all the entries;or the file is found. check_block		lda	entries_checked		cmp	#entries_per_block		beq	check_done		inc	entries_checked		lda	[gbuf_ptr],y		;get first two characters of entry		cmp	#'..'			;dummy second entry of subdirectory?		beq	next_entry		;yes, skip it		and	#$00FF			;clear to just first character		beq	check_done		;if 0, we reached the end of the directory		cmp	#'.'			;dummy first entry?		beq	next_entry		;yes, skip it		cmp	#$E5			;inactive entry?		beq	chk_need_free		;the entry is not active.		jsr	save_latest_mod		;save the lastest mod date		jsr	check_name		bcs	next_entry;; 09/01/92 - GAB; Make sure the matching entry does not refer to a volume label;		phy				;save entry offset		tya				;look at the attributes		clc		adc	#dir_entry.attributes		tay		lda	[gbuf_ptr],y		ply				;restore Y		and	#vol_label		;is this entry a volume label?		bne	next_entry		;yes, so just ignore it		clc; 09/01/92 - End		rts				;we have found itchk_need_free		lda	free_dir_blk		;block that contains a free entry		bne	next_entry		lda	drvr_blk_num		sta	free_dir_blk		;save directory block number		sty	free_dir_offset		;save offset to free entrynext_entry		tya		clc		adc	#entry_length		;adjust pointer to next entry		tay		bra	check_blockcheck_done	sec				;sorry entry not found		rts;Save_lastest_mod will save the lastest mod date that we find.  The reason;we do this is to allow the mod date to be returned for the volume header.save_latest_mod		phy				;save directory entry index		phx		pha		tya		clc		adc	#dir_entry.date		tay		lda	[gbuf_ptr],y		tax		cmp	curr_mod_date		;see if the date is greater		bcc	@not_greater		beq	@check_time		dey		dey		lda	[gbuf_ptr],y		;get the minutes etc.		sta	curr_mod_date+2		stx	curr_mod_date		;save the new latest date		bra	@not_greater		;just exit@check_time		dey		dey		lda	[gbuf_ptr],y		;get the minutes etc.		cmp	curr_mod_date+2		bcc	@not_greater		sta	curr_mod_date+2		stx	curr_mod_date		;save the new latest date@not_greater		pla		plx		ply		rts;==========================================================================;Check name will examine the name to see if it is the one that;we are looking for.  If it is not then we return with carry set;otherwise we return with carry clear. check_name		phy				;save y during search		ldx	#0000		longa	off		sep	#$20name_loop		lda	[gbuf_ptr],y		;get a character		cmp	#$05			;special case for $E5 character		bne	@1		cpx	#0			;at beginning of name?		bne	@1			;no, just a normal character		lda	#$E5			;$E5 normally used to mark deleted entry@1		eor	search_name,x		;case insensitive comparison		and	#$DF		bne	not_it		inx		iny		cpx	#11			;done all 11 characters yet?		bne	name_loop		;nope		clc				;found it!		dc.b	$b0			;BCS opcode (hides SEC instruction)not_it		sec		rep	#$20		longa	on		ply		rts;==========================================================================;The following routine when called, will isolate the next name to;locate.  It does this by looking for the delimiter(delimiter = ':');The last delimiter is a null character.		EXPORT	setup_namesetup_name		phy		ldy	chars_checked		;index into source name		lda	[temp_ptr],y		;are we done yet		and	#$00FF		bne	more_names		dec	path_searched		;the entire path has been searched		ply		sec				;indicate we are thru		rtsmore_names		longa	off		longi	on		sep	#$20			;short accumulator please		ldx	#$0000looper		lda	[temp_ptr],y		beq	end_path		;end of name and end of string		cmp	#delimiter		beq	end_name		;we found a delimiter		cmp	#'A'			;alphabetic?		bcc	@not_alpha		;no...		cmp	#'Z'+1		bcc	@is_legal		;yes, must be a legal character@not_alpha		cmp	#'.'			;extension separator?		bne	@not_extension		;no...		lda	#' '			;else fill out to 8 characters with spaces@space_fill		cpx	#8		bcs	do_extension		;then go do the 3-character extension		sta	search_name,x		inx		bra	@space_fill@not_extension		phx				;save index		ldx	#illegal_count-1	;get count of illegal characters@char_check		cmp	illegal_chars,x		;is it an illegal character?		beq	bad_filename		;yes, return error		dex		bpl	@char_check		;check all illegals		plx				;retrieve index@is_legal		cpx	#8			;have we got all 8 characters yet?		bcs	@truncate		;yes, just silently truncate it		sta	search_name,x		;finally, we can store the character		inx				;bump index to next position@truncate		iny		bra	looper			;go back for next characterbad_filename		plx				;clean up stacksyntax_prob		longa	on		longi	on		rep	#$20		lda	#bad_path_syntax		sec		brl	main_exit		;return to Jim with the error		longa	off		longi	ondo_extension		iny				;bump to next source character		lda	[temp_ptr],y		;get a character		beq	end_path		;end of name and end of string		cmp	#delimiter		beq	end_name		;we found a delimiter		cmp	#'A'			;alphabetic?		bcc	@not_alpha		;no...		cmp	#'Z'+1		bcc	@is_legal		;yes, must be a legal character@not_alpha		phx				;save index		ldx	#illegal_count-1	;get count of illegal characters@char_check		cmp	illegal_chars,x		;is it an illegal character?		beq	bad_filename		;yes, return error		dex		bpl	@char_check		;check all illegals		plx				;retrieve index@is_legal		cpx	#11			;have we got all 3 characters yet?		bcs	@truncate		;yes, just silently truncate it		sta	search_name,x		;finally, we can store the character		inx				;bump index to next position@truncate		bra	do_extension		;then go back for next characterend_path		dec	path_searched+1		;the entire path has been searchedend_name		iny		sty	chars_checked		lda	#' '			;fill out remainder with spaces@space_fill		cpx	#11			;do we have an entire name?		bcs	@full_name		;yes		sta	search_name,x		inx		bra	@space_fill@full_name		stx	search_length		longa	on		longi	on		rep	#$30		ply		clc		rts; illegal filename characters.  MSDOS uses these as filename termination characters; (See MSDOS Encylopedia, page 269)illegal_chars		dc.b	'.'			;in case this is seen within extension field		dc.b	';'		dc.b	','		dc.b	'='		dc.b	'+'		dc.b	'/'		dc.b	'"'		dc.b	'['		dc.b	']'		dc.b	'|'		dc.b	'<'		dc.b	'>'		dc.b	' '			;space character		dc.b	$09			;tab characterillegal_count	equ	*-illegal_chars		ENDP		Eject;======================================================================;Issue Mount:calls the Mount_Message Routine with a pointer to the name;            stored in Volume_name.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               volume_name             ;must be setup;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;Uses:          All registers;               Mount_Message;issue_mount	PROC		lda	volume_name		xba		sta	volume_name		pea	volume_name>>16		pea	volume_name+1		;push a pointer to the volume name		lda	#$0001			;1 = manditory mount!		jsl	mount_message		tax				;get the result code		lda	volume_name		xba		sta	volume_name		txa				;restore result code 0 = ok 1 = cancel		bne	cancel_mount		clc				;user selected OK		rtscancel_mount		sec				;return volume not found error to user		lda	#vol_not_found		rts		ENDP		Eject;======================================================================;Mount_volume:  This routine is called when we need to force the user;               To give us our disk back.;;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               my_vcr_ptr              (points to needed VCR);;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;               b = k;;;Uses:          All registers;               find_volume;		longa	on		longi	onmount_volume	PROC	Export		with	my_dp		Import	setup_vol_mesg		jsr	save_the_world		;save alot of data.		jsr	setup_vol_mesg		;move the VCR name to local buffertry_again	jsr	find_volume		;go get the volume		bcc	volume_online		;go and update everything		jsr	issue_mount		;issue a mount request		bcc	try_again		;user said volume is now online		jsr	restore_world		;restore everything please		rtsvolume_online	lda	drvr_dev_num		;where the volume was found		jsr	restore_world		;A is saved		sta	drvr_dev_num		ldy	#vcr.dev		;update with the new device number		sta	[my_vcr_ptr],y		ldy	#vcr.status		;indicate that the volume is online		lda	[my_vcr_ptr],y		and	#vcr_swapped_in		sta	[my_vcr_ptr],y		clc		rts				;volume is back on-linesave_the_world	php		phy		phx		pha		lda	world_flag		;see if data already saved		bne	to_sys_death		;debug		inc	world_flag		ldx	#$004A			;save the direct page datasave_direct	lda	drvr_dev_num,x		sta	direct_page,x		dex		bpl	save_direct		ldx	#$0052			;save my direct pagesave_my_direct		lda	fst_start,x		sta	my_direct,x		dex		bpl	save_my_direct		bra	save_rest_exitrestore_world	php		phy		phx		pha		ldx	#$004A			;save the direct page datarestore_direct	lda	direct_page,x		sta	drvr_dev_num,x		dex		bpl	restore_direct		ldx	#$0052			;save my direct pagerestore_dp	lda	my_direct,x		sta	fst_start,x		dex		bpl	restore_dp		dec	world_flagsave_rest_exit	pla		plx		ply		plp		rtsto_sys_death	jsl	sys_death		ENDP		Eject;======================================================================;dev_with_mount This routine with make a device call and if an;               error occurs (other then the I/O error) the mount;               volume routine will be called.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               all parameters for the driver must be setup.;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;Uses:          All registers;               Device Dispatcher  (subroutine);               device_calldev_with_mount	PROC		jsr	device_call		bcs	check_err		rtscheck_err		cmp	#drvr_disk_sw		;is this a disk switch error?		beq	do_find			;go and find the volume please		cmp	#drvr_off_line		;is the volume off-line?		beq	do_find		sec		rts				;This is some real error from the userdo_find		jsr	mount_volume		bcc	dev_with_mount		;re-issue the original call please.		rts				;return the error please		ENDP		Eject;======================================================================;read_with_mount:;               This routine with make a device read call and if an;               error occurs (other then the I/O error) the mount;               volume routine will be called.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               all parameters for the driver must be setup.;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;Uses:          All registers;               Device Dispatcher  (subroutine);               device_callread_with_mount	PROC	Export		lda	#drvr_read		bra	do_call		EXPORT	write_with_mountwrite_with_mount		lda	#drvr_writedo_call		sta	drvr_call_num		jsr	dev_with_mount		rts		ENDP		Eject;======================================================================;setup_params   This routine is called at the beginning of each system;               call.  It will setup parameters and verify certain fields;               of the os call.  If a VCR is used and the media is swapped;               out of the system then the system mount routine will be called;;Input:         A = undefined;               X = two times the call number;               Y = two times the class;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = class of call/2     (MUST be last instruction before RTS!!);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               pcount                  (contains pcount for call. 0=class0);               my_pblk_ptr             (points past pcount to first param);               my_vcr_ptr              (if available);                       msdos_vcr_ptr;               my_fcr_ptr              (if available);                       msdos_fcr_ptr;;Uses:          All registers;               math_temp;               pcount;;What the table looks like and what fields we verify.;;               1) Max PCount for the call;               2) Max Class for the call;               3) Pathnames used by call;               4) volume control record used;               5) file control record used.;               6) io buffer used.;               7) flush file to disk;               8) damaged disk protect;;              |8|7|6|5|4|3|  2  |    1    |;           ___|_|_|_|_|_|_|_____|_________|;          | | | | | | | | | | | | | | | | |;          |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|;          |               |               |;         1 6             0 8             0 0;		longa	on		longi	onsetup_params	PROC	Export		with	my_dp;First we load the flags from the start table and save them for later;use.		lda	gbuf_addr		;setup the general buffer pointer		sta	gbuf_ptr		lda	gbuf_addr+2		sta	gbuf_ptr+2		stz	drvr_vol_id		;zero the volume ID(for Mike).  Allow each call to set it up		stz	search_flag		;indicate normal find file		stz	msdos_vcr_ptr		stz	msdos_vcr_ptr+2		stz	my_vcr_ptr		stz	my_vcr_ptr+2		stz	msdos_fcr_ptr		stz	msdos_fcr_ptr+2		stz	case_bits		;indicate that the case is all upper.		stz	slug_block		;indicate no slug_ripple		stz	close_flag		;indicate that 'flush_file' will not						;call slug_ripple		stz	expand_record.expand_file		stz	expand_record.expand_flag		stz	chk_dirty_flag		;do not check the VCR to see if the file is dirty		stz	dirty_flags		stz	dirty_cnt_changed		stz	write_occurred		;If non-zero a write occurred to the disk.		stz	cp_device_flag		;indicate normal ChangePath     1/22/91 CAE		stz	cp_flags		;assume not a duplicate volume	5-Dec-91 MSD		stz	error_priority		;error priority is 0            3/05/91 CAE		lda	start_tbl-2,x		;get the flags for the call		sta	flags		and	#$001F		sta	max_pcount;Go ahead and setup the default parameters.		stz	pcount;Now verify the max class of the call.;;To do this we divide class by two and compare to the calls max class		tya		lsr	a		sta	class		beq	class0			;this is a OLD style call		lda	flags		and	#$00E0			;clear other flags please		asl	a		asl	a		asl	a		xba		cmp	class		bcs	good_class		lda	#invalid_class		bra	error_outgood_class;Now we need to verify the max pcount for the new class calls		lda	[param_blk_ptr]		cmp	max_pcount		bcc	good_pcount		lda	#invalid_pcount;Carry has to be set before calling error_out!!error_out		brl	main_exitgood_pcount;We get here if the pcount is good.  We also get here with a 'BCC';so if this changes we must add a CLC to the following 'ADD'		sta	pcount		lda	param_blk_ptr		;CARRY CLEAR on entry!!!!		adc	#$0002		sta	my_pblk_ptr		lda	param_blk_ptr+2		adc	#$0000		sta	my_pblk_ptr+2		bra	cont01class0		lda	param_blk_ptr		sta	my_pblk_ptr		lda	param_blk_ptr+2		sta	my_pblk_ptr+2cont01		ldx	#fst_id			;setup FST number for our FST.		stx	drvr_fst_num		jsl	lock_mem		;make sure data blocks do not move		lda	dev_num			;move the device number to driver		sta	drvr_dev_num		;direct page area;when we get here we know that both class and pcount are valid.;now we need to check if a VCR or FCR is used by the call.		lda	flags		and	#vcr_used		beq	check_fcr		;no VCR is used by the call;setup my pointer to the VCR and deref VP to my local data.		ldx	vcr_ptr		ldy	vcr_ptr+2		jsl	deref		stx	my_vcr_ptr		sty	my_vcr_ptr+2		jsr	setup_my_vcr		lda	flags			;do we need to check damage?		and	#damage		beq	vol_ok			;this must be a read only call.		ldy	#msdos_vcr.vol_damaged	;is this volume damaged??		lda	[msdos_vcr_ptr],y		inc	a			;Have I already showed the error message		bne	vol_ok			;the disk is not damaged		sec		lda	#invalid_access		;get the error code please		brl	main_exitvol_ok		ldy	#vcr.status		;see if the volume is swapped out		lda	[my_vcr_ptr],y		and	#vcr_swapped		beq	check_fcr		;the volume is online.		lda	call_number		;see if this is a close call.		and	#$DFFF			;get rid of the class please		cmp	#$0014			;Compare class zero close call number		bne	@do_mount		;we must do a mount message	if NOT read_only_fst then		ldy	#msdos_vcr.bitmap_dirty	;See if the Bitmap is dirty		lda	[msdos_vcr_ptr],y		bne	@do_mount		;we need the disk bad!!!	endif		ldy	#msdos_vcr.dirty_file_cnt ;see if there open files on disk that are dirty?		lda	[msdos_vcr_ptr],y		beq	check_fcr		;no open dirty files so skip mount.@do_mount		jsr	mount_volume		;force the user to put our disk onlinecheck_fcr		lda	flags		and	#fcr_used		beq	check_path		;no FCR is used by the call;setup my pointer to the FCR and deref VP to my local data.		ldx	fcr_ptr		ldy	fcr_ptr+2		jsl	deref		stx	my_fcr_ptr		sty	my_fcr_ptr+2		jsr	setup_my_fcr		;build pointer to local data		lda	flags			;do we need to flush the file?		and	#flush_1st		beq	check_path		;no flush needed		ldy	#msdos_fcr.status	;see if the file is dirty		lda	[msdos_fcr_ptr],y		and	#file_dirty		beq	check_path		;file is clean!	if NOT read_only_fst then		jsr	setup_io_ptrs		jsr	flush_file		;force dirty blocks to disk		tax		lda	flags			;clear IO needed bit		and	#clr_io_used		sta	flags		txa		bcc	check_path		brl	main_exit	endif;Moved the check_path code into a seperate routine and we now;only check for bad spans after we have located the target vol;and determined that it is indeed an MSDos volume.;					10/10/91 JEVcheck_path;		lda	flags;		and	#path_used;		beq	check_io_buf	;no pathname is used;See if there are any pathnames available;		lda	path_flag;		and	#path1_mask;		beq	check_path2;		lda	span1;		beq	bad_span	;added 11/12/90 CAE;		cmp	#12;		bcc	check_path2;bad_span	sec			;added 11/12/90 CAE;backup		lda	#bad_path_syntax;		brl	error_out;check_path2;We don't check span2 here if we are doing a change path call;we need to do some preprocessing first so that error priority;gets setup properly for the change path call.. added 8/21/91 JEV;		lda	call_number	;see if this is a changepath call.;		and	#$DFFF		;get rid of the class please;		cmp	#$0004		;Compare with changepath call number;		beq	check_io_buf	;just continue		;		lda	path_flag;		and	#path2_mask;		beq	check_io_buf;		lda	span2;		beq	bad_span	;added 11/12/90 CAE;		cmp	#12;		bcs	backupcheck_io_buf		lda	flags		and	#io_used		beq	end_buf_setup;now we need to setup real pointers to the I/O buffer.  There is only;one I/O buffer for a file.  However, the I/O buffer varies in it's size;and structure.		jsr	setup_io_ptrsend_buf_setup		lda	flags			;see if we need to check for file dirty		and	#do_dirty		beq	@exit		sta	chk_dirty_flag		; 00 = do not check		ldy	#msdos_fcr.status	;get the status out of the File Control Record		lda	[msdos_fcr_ptr],y		and	#file_dirty+data_dirty+index_dirty+master_dirty		sta	dirty_flags		;save the flags@exit		lda	class		rts		ENDP		Eject;======================================================================;Damaged_message: This routine will tell the user that the disk cannot;               be written too.  The routine will also jmp to the;               main exit routine.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;Uses:          All registers;damaged_message	PROC		with	my_dp		Export	show_damage		pha		jsr	show_damage		jsl	unlock_mem		;release any memory		sec		pla				;get the error code please		jml	sys_exitshow_damage		jsr	setup_vol_mesg		;move the name from the VCR to buffer		lda	volume_name		;make Gstring a Pstring		xba		sta	volume_name		pea	$0003			;message number three		pea	volume_name>>16		pea	volume_name+1		;push a pointer to the volume name.		pea	$0000		pea	$0000			;push dummy space.		jsl	report_error		lda	volume_name		;make Pstring a Gstring		xba		sta	volume_name		rts		Entry	setup_vol_mesgsetup_vol_mesg		ldy	#vcr.name		;index to Name VP		lda	[my_vcr_ptr],y		tax		iny		iny		lda	[my_vcr_ptr],y		tay		jsl	deref			;make a real pointer to vol name		stx	temp_ptr		sty	temp_ptr+2		lda	[temp_ptr]		;get the length of the string		tay		inymove_loop		lda	[temp_ptr],y		sta	volume_name,y		dey		bpl	move_loop		rts		ENDP		Eject;======================================================================;check_spans	This routine is called when a pathname is used and we;               we need to verify that the spans are valid.  If they;               are incorrect then we bail out.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = error code;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;check_spans	PROC	Export		lda	path_flag		and	#path1_mask		beq	check_path2		lda	span1		beq	bad_span		cmp	#max_span+1		bcc	check_path2bad_span	secbackup		lda	#bad_path_syntax		brl	main_exitcheck_path2		lda	path_flag		and	#path2_mask		beq	@spans_ok		lda	span2		beq	bad_span		cmp	#max_span+1		bcs	backup@spans_ok		rts		ENDP				Eject;======================================================================;build_path:    This procedure will parse off the volume name out of a;               pathname if needed.;;Input:         A = AND mask used on path_flag ($BFFF or $FFBF);               X = low word pointer to pathname;               Y = high word pointer to pathname;               P = nvmxdizc;                   ..000...;               b = k;;               path_flag               ;GS/OS parameter (See common equates);               dev_num                 ;GS/OS parameter; ;Output:        A = undefined;               X = low word pointer to pathname;               Y = high word pointer to pathname;               P = nvmxdizc;                   ..000..1 = no pathname (device # or vol name only);                          0 = X and Y contain a pathname pointer;               b = k;;               volume_name             ;if volume name is available;                                       ;e.g. no device number is given          ;;Uses:          All registers;               temp_ptr;               path_flag;               dev_num ;               and_mask;		longa	on		longi	onvol_to_buffer	Proc		with	my_dp		ldy	#$0001			;to point past ':' in volume namevol_name_loop		lda	[temp_ptr],y		and	#$00FF		beq	loop_end		;we have hit the last character		cmp	#delimiter		;see if it is a seperator		beq	loop_end		sta	volume_name+1,y		;store name in buffer		iny		cpy	#11+2			;is length > 11 characters?		bcc	vol_name_loop		;no, keep copying		lda	#bad_path_syntax	;else we've got a bad pathname		sec		brl	main_exitloop_end		tax				;save the terminating reason		lda	#$0000			;terminate the string with a null byte		sta	volume_name+1,y		dey				;adjust string length		sty	volume_name		txa		rts		EndPbuild_path	PROC	Export		with	my_dp		sta	and_mask		;setup by caller;now adjust the pointer to point past the length word		inx		bne	do_again		inydo_again	inx		bne	cont		inycont		stx	temp_ptr		sty	temp_ptr+2		;pointer to pathname		lda	path_flag		;see if there is a pathname to process		and	and_mask		bne	proc_path		;there is a pathname so handle it		sec		rts				;device number the only thing availableproc_path		lda	dev_num			;see if there is a device		beq	no_device		;no device so isolate volume name						;tell caller device # and pathnamedone;		jsr	set_case_bits		;save the case bits as needed please and convert to upper case		clc		rtsno_device		jsr	vol_to_buffer		;out: A = terminator Y = length		pha				;save termination reason		iny		iny		tya				;length of name +1		ldy	temp_ptr+2		clc		adc	temp_ptr		tax		bcc	do_end		iny				;adjust high worddo_end		pla				;restore terminator		bne	done			;tell caller volume name and pathname!		sec				;tell caller volume name only!		rts		EndP		Eject;======================================================================;process_path   This routine is called when a pathname needs to be;               processed and located on the disk.  If the pathname is;               not an MSDOS name then we bail out.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = error code;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               drvr_buf_ptr            (points to the file entry);               entry_offset            (offset to entry within I/O buffer);               parent_blk              (entries parent block address);;Uses:          All registers;               math_temp;               pcount;		longa	on		longi	onprocess_path	PROC	Export		with	my_dp		lda	#in_cache		;put directories in the cache		sta	drvr_cache		lda	#path1_mask		;and mask for path_flag		ldx	path1_ptr		ldy	path1_ptr+2		jsr	build_path		bcc	@chk_root_only		brl	dev_or_vol		;No path just a device # or vol. name@chk_root_only		lda	search_flag		;do we allow a pathname?		and	#root_only		beq	@path_ok		lda	#bad_path_syntax		sec		rts				;return error to caller@path_ok;If we fall thru then we know that there is a pathname to find.;We also know that there is either a volume name or device.		stx	hold_path_ptr		sty	hold_path_ptr+2		lda	dev_num			;There is a device number		beq	cont01			;Find Volume Name		sta	drvr_dev_num;Look on a specific devicego_id_disk		lda	drvr_dev_num		jsr	id_disk			;go and find out if it is our disk						;this also allocates a VCR if needed		bcc	find_path		;I own the disk.to_main_exit2		brl	main_exit		;return error to GS/OScont01		jsr	vol_to_buffer		jsr	find_volume		;locate the volume		bcs	to_main_exit2find_path	lda	#$8000			;indicate that we found the volume		sta	error_priority		;and it's an MSDOS volume;So it's one of our volumes, now check to see if we are using paths, and;the spans are ok.							      10/10/91 JEV		lda	flags		and	#path_used		beq	check_damage		;no pathname is used		jsr	check_spans		;so check them		check_damage	lda	flags			;is this a call to check the disk		and	#damage		beq	vol_good		jsr	setup_my_vcr		;setup the pointer first		ldy	#msdos_vcr.vol_damaged	;see if the volume is damaged		lda	[msdos_vcr_ptr],y		beq	vol_good		lda	#dir_error		;write protected		brl	damaged_messagevol_good		lda	drvr_dev_num		ldx	hold_path_ptr		ldy	hold_path_ptr+2		jsr	find_file		;try to locate the file		bcc	save_parent		cmp	#drvr_disk_sw		;was the media switched?		beq	go_id_disk		bit	search_flag		;is 'file not found' ok for this call?		bvc	not_ok			;no, tell caller about the error		cmp	#file_not_found		bne	not_ok			;this error cannot be handled!		sec		rts				;tell caller that an error occured.not_ok		sec		brl	main_exitsave_parent		sta	entry_offset		;offset to the entry within the blk		lda	drvr_blk_num		;block number of parent		sta	parent_blkcont02		stx	drvr_buf_ptr		;save pointer to name		sty	drvr_buf_ptr+2process_exit		jsr	set_user_cache		rts;If we get here we know that there is no pathname to process.;We also know if there is no device number then 'volume_name' contains;a volume name that I am suppose to open.dev_or_vol		lda	dev_num		beq	use_vol_name		;we must have a volume name.		jsr	id_disk			;go and find out if it is our disk		bcs	to_main_exit;Before we check to see if the volume name is legal we must see if the;volume is online.  The reason we do this is to be compatible with P16.;;Example:;               Create '/VOLUME'        ;If '/VOLUME' is online then;                                       ;the error returned is 'BadPath';               Create '/VOLUME'        ;If '/VOLUME' is offline then;                                       ;the error returned is 'VolNotFound';its_mine	lda	#$8000			;indicate that we found the volume      3/5/91 CAE		sta	error_priority		;and it's an MSDOS volume               3/5/91 CAEcheck_root	bit	search_flag		;is a root level valid?		bmi	bad_path_error		;no, issue errorcontinue1		lda	parent_blk		;was there a volume label?		beq	@no_vol_label		;no, must synthesize it		lda	entry_offset		;calculate address of volume label		clc		adc	gbuf_addr		sta	drvr_buf_ptr		lda	gbuf_addr+2		sta	drvr_buf_ptr+2		bra	process_exit@no_vol_label		lda	#default_name		sta	drvr_buf_ptr		lda	#^default_name		sta	drvr_buf_ptr+2		bra	process_exitbad_path_error		lda	#bad_path_syntax		secto_main_exit		brl	main_exit		;return error to M.A. and J.J.use_vol_name		jsr	find_volume		;locate the volume		bcc	its_mine		brl	main_exitset_user_cache		pha				;save entry offset		lda	user_cache		;set cache to user setting		sta	drvr_cache		pla		rts		ENDP		Eject;======================================================================;send_info      This routine is called when we need to return the;               informational parameters from a directory entry.;               This routine is called by 'OPEN' and 'GET_FILE_INFO';WARNING:;               This routine assumes parameters are in a certain order.;               I did this so I could use that same routine across several;               calls!;;Input:         A = number of entries to send;               X = low word pointer to start of parameters;               Y = high word pointer to start of parameters;               P = nvmxdizc;                   ..000...;               b = k;;               one_entry               (contains the info to send);               drvr_buf_ptr            (points to resource header block);;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          All registers;               math_temp;               temp_ptr;               one_entry;               time_routines;		longa	on		longi	onsend_info	PROC	Export		with	my_dp		stx	temp_ptr		sty	temp_ptr+2;Save the number of entries the user wants.		sta	math_temp		tax		bne	continue		rts;First we return the access as it is stored on disk.continue		ldx	#$00C3			;assume full access		lda	one_entry.attributes	;get the attributes		bit	#read_only		;read_only bit set?		beq	@not_read_only		;no...		ldx	#$0001			;else clear Delete/Rename/Write enable bits@not_read_only		bit	#archive		;backup bit set?		beq	@no_backup_bit		;no...		pha				;else set backup bit in returned attributes		txa		ora	#%00100000		tax		pla@no_backup_bit		bit	#hidden_file+sys_file	;hidden or system file?		beq	@visible		;no...		txa		ora	#%00000100		;else set invisible bit		tax@visible		ldy	#pblk_s_access		txa				;put synthesized attributes into Accumulator		sta	[temp_ptr],y		dec	math_temp		bne	send_twoend_send1		clc		rts;If we are here then we know the user wants the file type as wellsend_two		ldx	#$000F			;Assume subdirectory		lda	one_entry.attributes	;get the attributes		bit	#subdirectory		;is it a directory entry		bne	@is_directory		;no...		jsr	get_file_type		;else go translate the extension@is_directory		txa		ldy	#pblk_s_ftype		sta	[temp_ptr],y		dec	math_temp		beq	end_send1;Now the user wants the aux type!		ldy	#pblk_s_aux		lda	#0		sta	[temp_ptr],y		iny		iny		sta	[temp_ptr],y*** added 11-Aug-92 DAL		lda	one_entry.attributes	;get the attributes		bit	#subdirectory		bne	@no_auxtype		jsr	get_file_type		;returns auxtype in A		ldy	#pblk_s_aux		sta	[temp_ptr],y@no_auxtype*** end 11-Aug-92		dec	math_temp		beq	end_send1;Also send the storage type of the file		ldy	#pblk_s_storage		lda	storage_type		lsr	a		lsr	a		lsr	a		lsr	a		sta	[temp_ptr],y		dec	math_temp		beq	end_send1;Now convert the create date and send it to.send_five		ldx	#0			;MSDOS doesn't support a create date		txy		jsr	unpack_time		ldy	#pblk_s_create		jsr	send_time		dec	math_temp		beq	end_send1;Now convert the modification data and time		ldx	one_entry.date		ldy	one_entry.time		jsr	unpack_time		ldy	#pblk_s_mod		jsr	send_time		dec	math_temp		beq	@go_to_end; We now store the MSDOS FST ID in the 5th byte of the option list buffer		ldy	#pblk_s_opt		;index to option list pointer		lda	[temp_ptr],y		;get the address of the option list buffer		tax		iny		iny		lda	[temp_ptr],y		tay		bne	@save_fst_id		txa		beq	@skip_save@save_fst_id		pei	temp_ptr		;save the working temp_ptr since I am going to use it		pei	temp_ptr+2		;to handle the option list pointer		stx	temp_ptr		sty	temp_ptr+2;;Now I need to verify the option list length.  I need at least 6 bytes.;		lda	[temp_ptr]		;get the length of the option list		cmp	#$0004			;is the minimum count OK		bcc	opt_range_err		;the user doesn't even have the minimum size>>>>		tax		lda	#$0002			;length of the MSDOS FST ID.		tay		sta	[temp_ptr],y		;save the number of bytes stored		txa		cmp	#$0006		bcc	opt_size_error		iny		iny		lda	#fst_id		sta	[temp_ptr],y		pla		sta	temp_ptr+2		;restore		pla		sta	temp_ptr@skip_save		dec	math_temp		;Option List is included in PCount@go_to_end	beq	end_send;Give the EOF as well.		ldy	#pblk_s_eof		;send the EOF for the file		ldx	one_entry.file_size+2		lda	one_entry.file_size		jsr	store_longword		dec	math_temp		beq	end_send; Return number of blocks used by data fork		ldx	#0			;assume no blocks used by file		lda	one_entry.start_cluster	;get starting cluster #		beq	@no_blks_used		jsr	count_blks_used		;count the # of blocks used by file@no_blks_used		ldy	#pblk_s_blks		;send the number of blocks used		jsr	store_longword		dec	math_temp		beq	end_send; Return resource fork eof		ldy	#pblk_s_res_eof		;send the resource eof		ldx	rfork_entry.file_size+2		lda	rfork_entry.file_size		jsr	store_longword		dec	math_temp		beq	end_send; Return resource fork blocks used		ldx	#0			;assume no blocks used		lda	rfork_entry.start_cluster	;get starting cluster #		beq	@no_blks_used2		jsr	count_blks_used		;count the # of blocks used by file@no_blks_used2		ldy	#pblk_s_res_blk		;send the number of blocks used by res		jsr	store_longwordend_send	clc		rtsopt_range_err		pla		sta	temp_ptr+2		;restore		pla		sta	temp_ptr		lda	#parm_range_err		sec		rtsopt_size_error		pla		sta	temp_ptr+2		;restore		pla		sta	temp_ptr		lda	#buff_too_small		sec		rtsstore_longword		sta	[temp_ptr],y		;store low order 16 bits of EOF		iny		iny		txa				;now store the upper 16 bits		sta	[temp_ptr],y		rts;======================================================================;This routine will store the time into the user's parameters block		EXPORT	send_timesend_time		lda	minutes		xba				;swap minutes and seconds		sta	[temp_ptr],y		iny		iny		lda	hours		sta	[temp_ptr],y		iny		lda	year		sta	[temp_ptr],y		iny		lda	day		beq	zero_day		;the day is unknown		dec	a			;convert to misc. tools hex formatzero_day		sta	[temp_ptr],y		iny		lda	month		beq	zero_month		dec	a			;convert to misc. tools hex formatzero_month		sta	[temp_ptr],y		iny		lda	day_of_week		xba				;swap day of week and null byte		sta	[temp_ptr],y		rts		ENDP		Eject;======================================================================;chk_protected: This routine will see if a volume is write protected.;;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               drvr_dev_num            ;must be setup.;;Output:        A = status Word         ;see if driver ERS;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;;               b = k;;;Uses:          All registers;		longa	on		longi	onchk_protected	PROC		with	my_dp		jsr	save_drvr		lda	#drvr_status		;issue a status call to the device		sta	drvr_call_num		lda	#^status_list		;setup a pointer to the status list		sta	drvr_slist_ptr+2		lda	#status_list		sta	drvr_slist_ptr		lda	#$0006			;a six byte request count		sta	drvr_req_cnt		stz	drvr_req_cnt+2		lda	#blk_size		sta	drvr_blk_size		stz	drvr_stat_code		;issue a 'driver status' call.		jsr	device_call		;blast off!!		bcs	status_error		;An error?		lda	status_list		;get the return statusstatus_error	php		pha		jsr	restore_drvr		pla		plp		rtssave_drvr	ldx	#drvr_bytes		;number of bytes to savesave_it	lda	drvr_dev_num,x		sta	drvr_save,x		dex		bpl	save_it		rtsrestore_drvr	ldx	#drvr_bytesrestore_it	lda	drvr_save,x		sta	drvr_dev_num,x		dex		bpl	restore_it		rts		EXPORT	chk_disk_protectchk_disk_protect		stz	chk_prot_swap		; haven't got disk switched yet (20-Dec-91 MSD)				lda	my_vcr_ptr		;see if we have a VCR		ora	my_vcr_ptr+2		beq	do_chk			;go ahead and do the check		ldy	#vcr.status		;do I need to status the disk?		lda	[my_vcr_ptr],y		and	#vcr_wr_enable		beq	do_chk			;yes we need to check the media		rts				;just return to the callerdo_chk		jsr	chk_protected		;is the disk protected?		bcs	big_problem		tax		and	#$0010			;is the disk offline?		beq	not_in_drive		;there is no disk!!!		txa		and	#$0001			;disk switched??		bne	not_in_drive		;disk has been switched!		txa		and	#disk_protect		bne	is_protected		lda	my_vcr_ptr		;see if we have a VCR		ora	my_vcr_ptr+2		beq	no_change		;go ahead and set the vcr status flag		ldy	#vcr.status		;set the 'No Status' bit		lda	[my_vcr_ptr],y		ora	#vcr_wr_enable		;no need to do the status next time		sta	[my_vcr_ptr],yno_change	txa				;restore original status word		rtsis_protected	sec		lda	#drvr_wr_prot		;return write protect error to callerbig_problem	brl	main_exitnot_in_drive;; Begin 20-Dec-91 MSD;; We got a disk switched status, so try to find the volume (ask the user if necessary).; This will force a new VCR to be built, and my_vcr_ptr will point to it.;		lda	chk_prot_swap		; already switched once?		bne	do_disk_sw		; yes, so return disk switched error				inc	chk_prot_swap		; found one disk swithced status		*** added 28-Feb-92 DAL and GAB -- Save GBUF and important direct page stuff		jsr 	save_drvr		pei	<gbuf_ptr+2		pei	<gbuf_ptr		pea	chk_protect_gbuf>>16		pea	chk_protect_gbuf		pea	0		pea	$0200		; move 512 bytes		pea	move_sinc_dinc		jsl	move_info*** end 28-Feb-92, part one		jsr	mount_volume	; find the volume and build a VCR for it*** added 28-Feb-92 DAL and GAB -- Restore GBUF and important direct-page stuff		php		pha		jsr 	restore_drvr		pea	chk_protect_gbuf>>16		pea	chk_protect_gbuf		pei	<gbuf_ptr+2		pei	<gbuf_ptr		pea	0		pea	$0200		; move 512 bytes		pea	move_sinc_dinc		jsl	move_info		pla		plp*** end 28-Feb-92, part two		bcs	big_problem		; better not be an error (we already found the path)				bra	do_chk			; try the status againdo_disk_sw		sec		lda	#drvr_disk_sw		; give up, 2 consecutive disk switched statuses		bra	big_problem;; End 20-Dec-91 MSD;; The following code was commented out because we should really retry the status call.;;		ldy	#vcr_dev	;update the VCR status please;		lda	[my_vcr_ptr],y;		cmp	drvr_dev_num	;is this the same device?;		bne	just_exit	;no;		ldy	#vcr_status	;mark volume swapped;		lda	[my_vcr_ptr],y;		ora	#vcr_swapped	;disk has been removed from drive;		sta	[my_vcr_ptr],y;just_exit				; ;		txa			;original status word;		rtschk_prot_swap	dc.w	0		; flag for disk switched (20-Dec-91 MSD)		ENDP		Eject;==========================================================================;Move_vol_name: This routine will move the volume name pointed to by;               drvr_buf_ptr into the buffer pointed to by the address;               in the X and Y registers;;Input:         A = undefined;               X = low word pointer to the destination buffer;               Y = high word pointer to the destination buffer;               P = nvmxdizc;                   ..000...;               b = k;;               drvr_buf_ptr            ;points to the volume header in blk two;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          All registers;               temp_ptr;		longa	on		longi	onmove_vol_name	PROC		with	my_dp		stx	temp_ptr		sty	temp_ptr+2		lda	[drvr_buf_ptr]		and	#$000F			;isolate name length		sta	[temp_ptr]		;save the length in word format		tay		clc		lda	temp_ptr		adc	#$0002		sta	temp_ptr		bcc	ar1		inc	temp_ptr+2ar1		longa	off		sep	#$20move_loop		lda	[drvr_buf_ptr],y		sta	[temp_ptr],y		dey		bne	move_loop		longa	on		rep	#$20		rts		ENDP		Eject;======================================================================;read_write_setup:;               this routine sets up common parameters between read/write;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               pcount                  ;for cache check;               my_pblk_ptr             ;must be setup;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               user_buf_ptr;               user_req_cnt;               drvr_cache;               tran_cnt                ;set to zero;;Uses:          All registers;		longa	on		longi	onread_write_setup PROC	Export		with	my_dp;Start code by turning off disk caching and setting up other parameters		lda	user_cache		sta	drvr_cache		stz	tran_cnt		stz	tran_cnt+2		lda	pcount			;is cache priority avail?		cmp	#$0005		bne	no_cache;If we get here then the user has provided a cache priority for the file.;So we must verify that it is a legal value for caching.get_priority		ldy	#pblk_12_cache		lda	[my_pblk_ptr],y		beq	no_cache		;same as mine		cmp	#user_cache_val		beq	good_cacheparam_err		sec		lda	#parm_range_err		brl	main_exitgood_cache	sta	drvr_cache;Setup a pointer to the user's buffer.no_cache	ldy	#pblk_12_buf		lda	[my_pblk_ptr],y		sta	users_buf_ptr		iny		iny		lda	[my_pblk_ptr],y		and	#$00FF		sta	users_buf_ptr+2;Go ahead and zero the user's transfer count.		ldy	#pblk_12_tran		;zero the transfer count		lda	#$0000		sta	[my_pblk_ptr],y		iny		iny		sta	[my_pblk_ptr],y;Now lets get the user's request count.		ldy	#pblk_12_req		lda	[my_pblk_ptr],y		sta	user_req_cnt		iny		iny		lda	[my_pblk_ptr],y		sta	user_req_cnt+2;Handle the easy case of a request count of zero first.good_cnt	txa		ora	user_req_cnt		beq	@skip_it		rts@skip_it	clc		brl	main_exit		ENDP		Ejectrw_adjust	PROC	Export			;read/write adjust		with	my_dp;==========================================================================;adjust the buffer pointer by the number of bytes read;;IMPORTANT NOTES:;               drvr_req_cnt is always =< $0001FE00;               users_buf_ptr is always < $00FFFFFF;		clc		lda	users_buf_ptr		adc	drvr_req_cnt		sta	users_buf_ptr		lda	users_buf_ptr+2		adc	drvr_req_cnt+2		sta	users_buf_ptr+2;==========================================================================;adjust the total number of bytes read from file;;IMPORTANT NOTES:;               tran_cnt is always =< $00FFFFFF;               drvr_req_cnt is always =< $0001FE00;;Carry is clear from the above addition.		lda	tran_cnt		adc	drvr_req_cnt		sta	tran_cnt		lda	tran_cnt+2		adc	drvr_req_cnt+2		sta	tran_cnt+2;==========================================================================;adjust the current file marker;;IMPORTANT NOTES:;               curr_mark is always =< $00FFFFFF;               drvr_req_cnt is always =< $0001FE00;		lda	curr_mark		adc	drvr_req_cnt		sta	curr_mark		lda	curr_mark+2		adc	drvr_req_cnt+2		sta	curr_mark+2;adjust the number of bytes remaining to send		sec		lda	user_req_cnt		sbc	drvr_req_cnt		sta	user_req_cnt		lda	user_req_cnt+2		sbc	drvr_req_cnt+2		sta	user_req_cnt+2		rts		ENDP		Eject;==========================================================================;entry_to_offset This routine will convert the data from a directory;               header to an offset.;;Input:         A = entry_number;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = entry_offset;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;;Uses:          All registers		longa	on		longi	onentry_to_offset	PROC		and	#$00FF		dec	a		cmp	#$000D			;is it out of range?		bcs	error		asl	a		tay		lda	dir_offset_tbl,y		clcerror		rts		ENDP		Eject;==========================================================================;flush_file:    This routine will write any modified blocks to disk.;;Input:         A = dev_number;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_fcr_ptr           (points to data to write);               my_vcr_ptr              (points to main VCR);;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          All registers		longa	on		longi	onflush_file	PROC	Export		with	my_dp		stz	flush_entry		;indicate that we should flush everything		bra	cont_flush		Export	do_fast_flush		;entry point used by the fast version of the flush calldo_fast_flush		lda	#1			;set flag		bra	stuffit		EXPORT	flush_io_Bufferflush_io_buffer		lda	#$FFFF			;do not flush the directory entrystuffit		sta	flush_entrycont_flush	if read_only_fst then	;used for read-only version of FST		clc		rts				;do nothing	else		;used for write-enabled version of FST		jsr	standard_req;First lets call flush bitmap which will update the bitmap for us		jsr	flush_bitmap		bcs	error_return		;return the error directly;No we need to flush the file itself.  We only flush blocks that need to;be flushed.  We will always update the file entry.flushed		ldy	#msdos_fcr.status	;get the status bits		lda	[msdos_fcr_ptr],y		sta	flush_flags		bit	#file_dirty		;see if there is anything to update		bne	do_update		clcerror_return		rts				;file does not need to be updated;First lets see if we need to update the master index block.do_update		bit	#master_dirty		beq	check_index		ldy	#msdos_fcr.master_blk_num ;get the block number		lda	[msdos_fcr_ptr],y		sta	drvr_blk_num		beq	clear_master		;master block is sparse so do not update disk		ldx	master_ptr		ldy	master_ptr+2		jsr	flush_block		bcs	error_return		;return the error codeclear_master		lda	#master_clean		jsr	clr_fcr_status		;mark master block as clean;Update the index block if neededcheck_index		lda	flush_flags		bit	#index_dirty		;is the index block dirty		beq	check_data		jsr	flush_index		bcs	error_return;Update the data block if needed.check_data		lda	flush_flags		bit	#data_dirty		;is the data block dirty		beq	update_entry		jsr	flush_data_blk		bcs	error_returnupdate_entry		lda	flush_entry		;do we update the directory entry?		beq	@do_entry		;yup, update the whole thing		bmi	@just_data		;no, just flush the data blocks						; else we're doing a fast flush call here.  flush dirty bitmap and						; dirty directory ('dirty' meaning that anything besides mod date						; and backup-bit have been changed).		jsr	force_bitmap		;force the bitmap update		lda	flush_flags		;is the directory dirty?		bit	#dirEntry_dirty		bne	@do_entry		;yes, so just go ahead and do the full flush@just_data		clc		rts@do_entry		lda	#file_clean		jsr	clr_fcr_status		;mark master block as clean;;Now lets update the VCR count to indicate that the file is clean;		lda	dirty_cnt_changed		bne	@changed_once		;have we adjusted the number already?		inc	dirty_cnt_changed		ldy	#msdos_vcr.dirty_file_cnt		lda	[msdos_vcr_ptr],y		beq	@major_error		dec	a		sta	[msdos_vcr_ptr],y		jsr	flush_bitmap		;now go and update the bitmap		bcs	go_cannot_update@major_error@changed_once		jsr	set_default_buf		;use the system buffer		jsr	standard_req		jsr	update_mod_time		;make sure we use the correct time		jsr	get_parent		;load the I/O buffer with directory blkgo_cannot_update		bcs	to_cannot_update		jsr	verify_storage		;verify storage type;;Change for final release 8/16/88;;; First we update the File Control Record to indicate the correct backup state;		ldy	#msdos_fcr.disk_acc	;update fcr along with dir entry		lda	[msdos_fcr_ptr],y		ora	#backup_on		sta	[msdos_fcr_ptr],y;;Now we update the directory entry to indicate the correct backup state;		ldy	#access_index		;index to the access byte in a dir entry		lda	[temp_ptr],y		ora	#backup_on		;set the backup bit before update of disk		sta	[temp_ptr],y		bcs	to_cannot_update;If the file is a resource file then only update the modification time.;Otherwise update the entire directory entry.		ldy	#msdos_fcr.file_id		lda	[msdos_fcr_ptr],y		ldy	#msdos_fcr.key_blk		cmp	[msdos_fcr_ptr],y		beq	entry_ok		;file is not a resource file		jsr	update_resource		;update the resource header		bcs	to_cannot_update	;cannot write info to disk!		jsr	set_default_buf		;restore buffer pointer		ldy	#msdos_fcr.modified	;index into FCR		lda	[msdos_fcr_ptr],y		ldy	#last_mod_index		;index into directory block		sta	[temp_ptr],y		;update the directory entry		ldy	#msdos_fcr.modified+2		lda	[msdos_fcr_ptr],y		ldy	#last_mod_index+2		sta	[temp_ptr],y		bra	update_disk		;now update the directory;Move the entire directory info then write the block back to disk.entry_ok		ldy	#msdos_fcr.storage		lda	[temp_ptr]		and	#$FF0F			;clear current storage type		ora	[msdos_fcr_ptr],y	;adjust the storage type		sta	[temp_ptr]		ldx	#msdos_fcr.eof		ldy	#msdos_fcr.curr_eof	;move the current EOF to disk EOF		lda	[msdos_fcr_ptr],y		phy		txy		sta	[msdos_fcr_ptr],y		inx		ply		iny		lda	[msdos_fcr_ptr],y		txy		sta	[msdos_fcr_ptr],y		ldy	#msdos_fcr.header_ptr	;start at the end		ldx	#header_ptr_indexblast_loop		lda	[msdos_fcr_ptr],y		phy		txy		sta	[temp_ptr],y		dex		ply		dey		cpy	#msdos_fcr.file_type		bne	blast_loopupdate_disk		jsr	write_with_cacheto_cannot_update		bcs	cannot_update		lda	#dirEntry_clean		jsr	clr_fcr_status		;mark directory entry as clean		lda	close_flag		;should we update the directories?		ora	time_stamp_opt		;check user's option for time stamp too		ora	flush_flags		;and which type of flush we're doing		beq	dont_bother		;no directory updates please		ldy	#header_ptr_index		lda	[temp_ptr],y		sta	drvr_blk_num		cmp	#vol_dir_start		beq	dont_bother		jsr	read_with_cache		bcs	cannot_update		ldy	#parent_index		;get the parent block number		lda	[drvr_buf_ptr],y		sta	slug_block		;save the block number		ldy	#par_entry_num		lda	[drvr_buf_ptr],y		jsr	entry_to_offset		sta	slug_offset		jsr	slug_ripple		;do the slug ripple		rtsdont_bother		clccannot_update		rts		EXPORT	flush_indexflush_index		ldy	#msdos_fcr.index_blk_num ;get the block number		lda	[msdos_fcr_ptr],y		sta	drvr_blk_num		beq	clear_index		;the block is sparse so don't write it!		ldx	index_ptr		ldy	index_ptr+2		jsr	flush_block		bcc	clear_index		rts				;return the error codeclear_index		lda	#index_clean		jsr	clr_fcr_status		;mark master block as clean		rts		EXPORT	flush_data_blkflush_data_blk		ldy	#msdos_fcr.data_blk_num	;get the block number		lda	[msdos_fcr_ptr],y		sta	drvr_blk_num		beq	clear_data		;the block is sparse so don't write it to disk		ldx	data_ptr		ldy	data_ptr+2		jsr	flush_block2		bcc	clear_data		rts				;return the error codeclear_data		lda	#data_clean		jsr	clr_fcr_status		;mark master block as clean		clc		rts;If we get here then we are updating a resource file.  So we need to update;the resource header block with the following information.;;               Storage Type;               key_block;               blocks used;               eof;update_resource		lda	drvr_blk_num		;save the block number please		pha		jsr	standard_req		jsr	set_default_buf		inc	drvr_buf_ptr+1		inc	drvr_buf_ptr+1		;use the high block of the buffer!!!		ldy	#msdos_fcr.file_id	;index to header block		lda	[msdos_fcr_ptr],y		sta	drvr_blk_num		;read in the block please		jsr	read_with_cache		bcs	end_res_update		ldy	#msdos_fcr.res_num	;which resource are we updating?		lda	[msdos_fcr_ptr],y		xba				;make an index $0000 or $0100		tax				;point to start of header		ldy	#msdos_fcr.storage	;storage type of file		lda	[msdos_fcr_ptr],y		lsr	a			;convert $10,$20,$30 -> $1,$2,$3		lsr	a		lsr	a		lsr	a		txy				;index to storage type		sta	[drvr_buf_ptr],y		inx				;advance to key block		ldy	#msdos_fcr.key_blk		lda	[msdos_fcr_ptr],y		txy		sta	[drvr_buf_ptr],y		inx		inx				;advance to blocks used		ldy	#msdos_fcr.blks_used		lda	[msdos_fcr_ptr],y		txy		sta	[drvr_buf_ptr],y		inx		inx				;advance to EOF		ldy	#msdos_fcr.curr_eof		lda	[msdos_fcr_ptr],y		txy		sta	[drvr_buf_ptr],y		inx		ldy	#msdos_fcr.curr_eof+1		lda	[msdos_fcr_ptr],y		txy		sta	[drvr_buf_ptr],y		jsr	write_with_cache	;Update the disk		bcs	end_res_update		clc		ldy	#$0003			;index to the blocks used data		lda	[drvr_buf_ptr],y		ldy	#$0103			;index to blocks used resource		adc	[drvr_buf_ptr],y		adc	#$0001			;add in the header block		ldy	#blks_used_index	;index into directory block		sta	[temp_ptr],y		;update the directory entry		clcend_res_update		plx				;restore the block number		stx	drvr_blk_num		rts;==========================================================================;This routine reads the GS clock and stores the time in the modification;field of the current FCR.update_mod_time		jsr	pack_time		;time for mod date (X=low Y=high)		phy				;save high word		ldy	#msdos_fcr.modified		txa		sta	[msdos_fcr_ptr],y		iny		iny		pla		sta	[msdos_fcr_ptr],y	;update high word		rts;==========================================================================;This routine will read in the parent block for a FCR and update the;modification date.;;input:         msdos_fcr_ptr           ;MUST be setup;;output:        carry = error;               temp_ptr                ;points to the file entryget_parent		ldy	#msdos_fcr.parent		lda	[msdos_fcr_ptr],y	;get the address of the directory blk		sta	drvr_blk_num		jsr	read_with_cache		;get the directory block please		bcc	block_loaded		rtsblock_loaded		ldy	#msdos_fcr.entry_offs	;offset to directory entry		lda	[msdos_fcr_ptr],y		adc	drvr_buf_ptr		sta	temp_ptr		lda	#$0000		adc	drvr_buf_ptr+2		sta	temp_ptr+2		clc		rts;==========================================================================;This routine verifies that the entry pointed to by 'temp_ptr' is a valid;MSDOS entry.  It verifies this by looking at the storage type.verify_storage		lda	[temp_ptr]		;get stoarge/length byte		and	#$00F0			;verify the storage type please		cmp	#resource_type		beq	good_entry		cmp	#seedling_type		beq	good_entry		cmp	#sapling_type		beq	good_entry		cmp	#tree_type		beq	good_entry		cmp	#subdir_type		beq	good_entry		lda	#dir_error		;the directory must be damaged		sec		rtsgood_entry	clc		rts;Force the block to diskflush_block		stx	drvr_buf_ptr		sty	drvr_buf_ptr+2		jsr	write_with_cache		rtsflush_block2		stx	drvr_buf_ptr		sty	drvr_buf_ptr+2		jsr	write_with_mount		rts		EXPORT	clr_fcr_statusclr_fcr_status		ldy	#msdos_fcr.status		and	[msdos_fcr_ptr],y		sta	[msdos_fcr_ptr],y		rts	endif		ENDP		Eject;==========================================================================;Chk_swapped:   This routine will determine if the volume has been swapped;               If the volume has been swapped then we will request the;               user to put the volume back online.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               my_vcr_ptr              ;pointer to vcr;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;Uses:          All registers;               temp_ptr;               volume_name;               find_volume;		longa	on		longi	onchk_swapped	PROC	Export		with	my_dp;Now we have all of our data setup for the read.  Now we need to see if;the volume has been swapped out.  If it has then we must go and find;it again.		ldy	#vcr.status		lda	[my_vcr_ptr],y		and	#vcr_swapped		;disk logged out?		beq	disk_back;Little Bo-Peep-Show has lost her disk and doesn't know where to find it!;Therefore we will go and find it for her.		ldy	#vcr.name		lda	[my_vcr_ptr],y		tax		iny		iny		lda	[my_vcr_ptr],y		tay		jsl	deref		stx	temp_ptr		sty	temp_ptr+2;Now we have a pointer to the name but we must move it to 'volume_name'		lda	[temp_ptr]		and	#$000F		tay		deymove_name		lda	[temp_ptr],y		sta	volume_name,y		dey		bpl	move_name;Now that we have moved the name to volume_name buffer we need to call;'find_volume' and let it look for it.		jsr	mount_volume		rtsdisk_back		clc		rts		ENDP	if NOT read_only_fst then		Eject;============================================================================;;Calc_Bit:      This routine will convert a 16 bit block number into;               the correct index into the bitmap block, the correct pattern;               to indicate which bit it is, and which relative block in the;               bitmap contains the bit;;Input:         X = Block number to convert;               m = 0;               x = 0;               b = k;;Output:        A = Bit Pattern (Which bit that needs to be changed);               Y = Byte offset into bitmap block that contains bit;               X = Relative Block number of the bitmap that contains the bit;               Carry Clr;               All other flags undefined;;Uses:          Local Table;               All registers;calc_bit	PROC	Export		txa				;X=Block number		and	#$0007			;isolate bit index    		tay		lda	bit_table,y		;get the bit pattern		and	#$00FF			;table is a byte table		pha		txa				;now isolate byte index		and	#$0FF8		lsr	a		lsr	a		lsr	a		tay				;Y=Offset into bitmap block     		jsr	abs_to_rel		;absolute to relative block number		pla				;A=Bit pattern		rts		entry	abs_to_relabs_to_rel		clc		txa				;now isolate relative block number		and	#$F000		rol	a		rol	a		rol	a		rol	a		rol	a		tax				;X=Relative block number in bitmap		rtsbit_table	DC.B	$80,$40,$20,$10,$08,$04,$02,$01		ENDP	endif	if NOT read_only_fst then		Eject;============================================================================;Alloc_block    This routine will allocate a block in the bitmap.;               If the block is not in memory then it will load it.;;Input:         X = Block number that you want to allocate;               m = 0;               x = 0;               b = k;               msdos_vcr_ptr;;Output:        carry clr = no error;               carry set = could not allocate;               A = error code if carry set;                       01 = User would not mount the volume;               all flags undefined;;Uses:          All Registers;               Calc_bit        (Subroutine);               Get_Bit_block   (Subroutine);               bitmap_changed  (Subroutine);alloc_block	PROC		with	my_dp		jsr	calc_bit		;calculate bit(A),byte(Y),block(X)		pha		phy		jsr	get_bit_block		;load the correct block if needed		ply		pla		tax				;save mask		bcs	done			;could not load block from disk		and	[fat_ptr],y		;is the block already allocated?		beq	bitmap_corrupt		;the bitmap is in bad shape, sorry.		txa				;restore the AND mask		eor	#$FFFF			;we need to flip the patterns		and	[fat_ptr],y		;clear the correct bit		sta	[fat_ptr],y		jsr	bitmap_changed		;update bitmap flags		jsr	sub_free_blk		;adjust free block countdone		rtsbitmap_corrupt					;we get here if the bitmap is corrupt		lda	#damaged_bitmap		sec		rts				;return the errorsub_free_blk		ldy	#msdos_vcr.free_blocks		lda	[msdos_vcr_ptr],y		inc	a		beq	who_knows		dec	a			;$FFFF = major problem		dec	a		sta	[msdos_vcr_ptr],ywho_knows		clc		rts		ENDP	endif	if NOT read_only_fst then		Eject;============================================================================;DeAlloc_block  This routine will deallocate a block in the bitmap.;               If the bitmap block is not in memory then it will load it.;               The routine will also update the free block count if needed;;Input:         X = Block number that you want to deallocate;               m = 0;               x = 0;               b = k;               msdos_vcr_ptr          (must be setup);               my_vcr_ptr              (must be setup);;Output:        carry clr = no error;               carry set = could not allocate;               A = error code if carry set;                       01 = User would not mount the volume;               all flags undefined;;Uses:          All Registers;               Calc_bit        (Subroutine);               Get_Bit_block   (Subroutine);dealloc_block	PROC	Export		with	my_dp		jsr	calc_bit		;calculate bit(A),byte(Y),block(X)		phx		pha		phy		jsr	get_bit_block		;load the correct block if needed		ply		pla		plx		bcs	done			;could not load block from disk		pha				;save the mask please		and	[fat_ptr],y		;is the block already deallocated?		beq	no_prob			;the block is currently allocated		pla				;fix the stack		lda	#damaged_bitmap		sec		rts				;return the errorno_prob		pla				;restore the mask please		ora	[fat_ptr],y		;set the correct bit		sta	[fat_ptr],y;We have just deallocated some blocks so lets make sure the first bitmap block;that contains available space is correct for the current VCR		ldy	#msdos_vcr.avail_bitmap		txa				;relative block number		cmp	[msdos_vcr_ptr],y;; 2/3/90        Mensch, Hauser,Benaresh;; Rob says that avail_bitmap should *ALWAYS* be equal to the lowest bitmap; block that has space in it. So, the branch that was a BEQ should really be; a BCS (BGE) this way, so it will work right.;		bge	go_changed		;the relative block num is the same;If we freed up a block in a previously full bitmap then lets update the VCR		sta	[msdos_vcr_ptr],ygo_changed		jsr	add_free_blk		Entry	bitmap_changedbitmap_changed		clc;==========================================================================;This routine will mark the current bitmap block dirty.  NOTE: This routine;must not change the state of the carry.		ldy	#msdos_vcr.bitmap_dirty		lda	#bitmap_mod		;bitmap modified		sta	[msdos_vcr_ptr],ydone		rts;==========================================================================;This routine will add one to the free block count for a volume.  If the;number of free blocks is unknown then the routine will just exit.add_free_blk		ldy	#msdos_vcr.free_blocks		lda	[msdos_vcr_ptr],y		inc	a			;$FFFF = free block count unknown		beq	end_free		;free block count is not known		sta	[msdos_vcr_ptr],yend_free		rts		ENDP	endif	if NOT read_only_fst then		Eject;==========================================================================;get_bit_block: This routine will load in the correct bitmap block from;               disk.  If the correct block is already loaded then the;               routine will just exit.;;Input:         A = undefined;               X = relative block number to load;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_vcr_ptr          (must be setup correctly);;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               fat_ptr                 (points to file allocation table);               drvr_buf_ptr            (same as fat_ptr);;Uses:          All registers;               device_call;               drvr_call_num;		longa	on		longi	onget_bit_block	PROC		with	my_dp		phx				;save the block number		jsr	setup_fat_ptr		stx	drvr_buf_ptr		sty	drvr_buf_ptr+2		pla				;retore relative block number		sta	math_temp		ldy	#msdos_vcr.curr_bitmap		cmp	[msdos_vcr_ptr],y		beq	good_exit		pha;force dirty bitmap block back to disk if needed.		jsr	force_bitmap		;force the bitmap to disk		bcc	flushed		plx		rtsflushed;If we get here we have to calculate the right block to read into memory		pla		clc		ldy	#msdos_vcr.bitmap_addr		adc	[msdos_vcr_ptr],y		sta	drvr_blk_num		jsr	read_with_cache		bcc	read_ok		jsr	kill_bitmap		sec		rts				;return the errorread_ok;Now we need to update the current bitmap		ldy	#msdos_vcr.curr_bitmap		lda	math_temp		sta	[msdos_vcr_ptr],ygood_exit		clc		rts		ENDP	endif	if NOT read_only_fst thenkill_bitmap	Proc		with	my_dp		pha		lda	#bitmap_unknown		;flag bitmap as unknown		ldy	#msdos_vcr.curr_bitmap		sta	[msdos_vcr_ptr],y		pla		rts		ENDP	endif	if NOT read_only_fst then		Eject;==========================================================================;find_free_blks This routine will scan the bitmap looking for a sequence;               of blocks that are marked as free.  The routine will always;               try to allocate the blocks in one large group.  If a group;               cannot be found to satisfy the request count then this;               routine will allocate the first available block.;               At least one block MUST be free for allocation!!!!!!!!!!;;Input:         A = number of blocks to allocate. ( 'n' blocks);               X = starting block number for search. (might be minus 7 blks);               msdos_vcr_ptr          (must be setup);                       ^avail_bitmap   (must be valid);;output:        A = error or number of blocks allocated. (1 or 'n');               X = starting block number of allocated blocks;               P = nvmxdizc;                   ..000..1 = no blocks allocated (error);                          0 = allocated;;uses:          calc_bits;               math_temp;		longa	on		longi	onfind_free_blks	PROC	Export		with	my_dp		sta	alloc_count		;number of blocks to allocate		stx	alloc_start		;starting block number for search		stx	first_free		jsr	calc_bit		;absolute blk to relative blk.;; calc_bit results:;;A = bit mask $80 $40 $20 $10 $08 $04 $02 $01;Y = byte offset in the bitmap buffer;X = relative block number that contains the block number passed as input;		sty	byte_offset		;starting byte in block		xbaalign_loop					; ;set blk num to byte boundary		asl	a			;check bit position of user block num		bcs	chk_avail		;ok here		dec	first_free		bra	align_loop		;check next bitchk_avail		lda	byte_offset		;are we word aligned?		lsr	a		bcc	aligned			;yes we are OK		dec	byte_offset		;now set starting block to word boundary		sec		lda	first_free		sbc	#$0008		sta	first_free		;everything should be word aligned now.aligned		txa		ldy	#msdos_vcr.avail_bitmap	;see if start is >= first free		cmp	[msdos_vcr_ptr],y		bcs	start_ok		;start is >= first free		lda	[msdos_vcr_ptr],y		tax		ror	a		ror	a		ror	a		ror	a		ror	a			;calc starting block number		sta	first_free		;ex. rel blk #1 = blk #4096 or $1000		txa		stz	byte_offsetstart_ok		stz	last_blk		;starting block for caller		stz	math_temp		;reset the free block counter		tax				;now load in the bitmap blocknext_blk		lda	math_temp		pha				;save temp count		jsr	get_bit_block		bcc	got_block		ply				;fix the stack		rts				;return error pleasegot_block		pla				;reset temp count		sta	math_temp		stz	some_free		;indicates if ANY blocks are free!		ldy	byte_offset		;start looking here for 1st free block		cpy	#$01FF			;are we near then end?		bcc	next_word		ldy	#$01FEnext_word		ldx	#16			;scan all 16 bits		lda	[fat_ptr],y		;get a bitmap word (16 blocks)		bne	check_16		;sorry no bits here.		stz	math_temp		;reset the counter please.		stz	last_blk		bra	no_changecheck_16		xba				;put bits in the right order		sta	bits		sta	some_free		;there are free blocks in this dir.		inc	a			;check 16 please		bne	scan_loop;;special case of all sixteen blocks allocated;		clc		lda	math_temp		adc	#16			;easy case		sta	math_temp		lda	last_blk		;do we have the starting blk yet?		bne	chk_req_cnt		;we already have start block		lda	first_free		sta	last_blkchk_req_cnt		lda	math_temp		;see if we are done		cmp	alloc_count		bcs	req_filled		;request filled. We are done!!!no_change		clc		lda	first_free		adc	#16			;bump block number		sta	first_free		bra	bump_index		;go get the next wordscan_loop		lda	math_temp		;see if we are done		cmp	alloc_count		bcs	req_filled		;request filled. We are done!!!		asl	bits			;see if this block is available		bcc	reset_count		;a used block		inc	math_temp		;add one to block count		lda	last_blk		bne	next_bit		lda	first_free		sta	last_blk		;update start block		bra	next_bitreset_count		stz	math_temp		;reset the counter		stz	last_blk		;reset start blocknext_bit		inc	first_free		;bump the block number		dex		bne	scan_loop		lda	math_temp		;see if we are done		cmp	alloc_count		bcs	req_filled		;request filled. We are done!!!bump_index		iny		iny		cpy	#$01FF			;are we done?		bcc	next_word		;not yet		ldy	#msdos_vcr.curr_bitmap	;current loaded bitmap block		lda	[msdos_vcr_ptr],y		inc	a			;convert 0 to 'n' to 1 to 'n'+1		ldy	#msdos_vcr.num_bitmap_blks		cmp	[msdos_vcr_ptr],y		bcs	find_one		;no more bitmap blocks to search!		jsr	bump_1st_free		;bump to next block if needed.		stz	byte_offset		;reset byte offset		ldx	first_free		jsr	abs_to_rel		;calc relative block number		brl	next_blk		;load in the next blockfind_one					; ;allocate one block only		lda	#$0001		ldx	#$0000			;start at block 0		jsr	find_free_blks		rts;now we need to update the bitmap blocks!req_filled		ldx	last_blk		ldy	alloc_count		dey				;convert 1 to 'n' -> 0 to 'n-1'alloc_loop		phy				;number of blocks wanted		phx				;block number to allocate		jsr	alloc_block		;mark the block as used!		plx		ply		bcs	bad_news		inx				;allocate the next block		dey		bpl	alloc_loop		lda	alloc_count		;user request satisfied		ldx	last_blk		;starting block for allocation		clc				;no errorbad_news		rtsbump_1st_free		lda	some_free		;is this block empty?		bne	bad_news		;no...		ldy	#msdos_vcr.avail_bitmap	;bump avail to next block if needed		lda	[msdos_vcr_ptr],y		ldy	#msdos_vcr.curr_bitmap		cmp	[msdos_vcr_ptr],y		bne	bad_news		ldy	#msdos_vcr.avail_bitmap		lda	[msdos_vcr_ptr],y		inc	a		sta	[msdos_vcr_ptr],y		rts		ENDP	endif	if NOT read_only_fst then		Eject;======================================================================;flush_bitmap:  This routine forces a dirty bitmap to be written to;               disk.  The bitmap will be written to disk only if the;               file counter is equal to zero.;;force_bitmap:  same as flush_bitmap except the bitmap block is ALWAYS;               flushed.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_vcr_ptr;               my_vcr_ptr;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;Uses:          All registers;               drvr_buf_ptr;               dev_with_mount;		longa	on		longi	onflush_bitmap	PROC	Export		with	my_dp		ldy	#msdos_vcr.dirty_file_cnt ;see if there open files on disk?		lda	[msdos_vcr_ptr],y		beq	force_bitmap		;no open files so do flush.		clc		rts				;just exit.		EXPORT	force_bitmapforce_bitmap					;This entry point force block to disk		ldy	#msdos_vcr.bitmap_dirty		lda	[msdos_vcr_ptr],y		beq	no_change;Get the device number first		ldy	#vcr.dev		lda	[my_vcr_ptr],y		sta	drvr_dev_num;We need to update the disk since the bitmap is corrupt;First we calculate the block number of the block to write		ldy	#msdos_vcr.bitmap_addr		lda	[msdos_vcr_ptr],y		ldy	#msdos_vcr.curr_bitmap		clc		adc	[msdos_vcr_ptr],y		sta	drvr_blk_num		stz	drvr_blk_num+2;Get the address of where the bitmap block is located.;setup drvr_buf_ptr to point to the bitmap buffer		jsr	setup_fat_ptr		stx	drvr_buf_ptr		sty	drvr_buf_ptr+2;setup the call to do a write;Force the request count to 512 bytes		lda	#blk_size		sta	drvr_req_cnt		stz	drvr_req_cnt+2;Call the device.		jsr	write_with_cache		bcc	clear_dirty		rtsclear_dirty		ldy	#msdos_vcr.bitmap_dirty		lda	#$0000		sta	[msdos_vcr_ptr],y		ldy	#msdos_vcr.curr_bitmap	;see if this is first free block.		lda	[msdos_vcr_ptr],y		ldy	#msdos_vcr.avail_bitmap		cmp	[msdos_vcr_ptr],y		bne	no_change		inc	a			;see if this is the last bitmap blk.		ldy	#msdos_vcr.num_bitmap_blks		cmp	[msdos_vcr_ptr],y		bcs	no_change		;this is the last bitmap block		ldy	#$01FE			;we must check first freechk_first_free		lda	[drvr_buf_ptr],y		bne	no_change		dey		dey		bpl	chk_first_free		;check the entire block please.		ldy	#msdos_vcr.avail_bitmap	;bump avail to next block please		lda	[msdos_vcr_ptr],y		inc	a		sta	[msdos_vcr_ptr],yno_change		clc		rts		ENDP	endif	if NOT read_only_fst then		Eject;==========================================================================;slug_ripple:   This routine will time stamp the parent directories for ALL;               operations that require writing to the directory.  This;               routine is SLOW and is very stupid on our type of system.;               It is put here for compatability only.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               drvr_buf_ptr            (points to the directory entry);;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          All registers;               device_dispatcher;		longa	on		longi	onslug_ripple	PROC	Export		with	my_dp		lda	time_stamp_opt		;are we time stamping at all?		bne	do_stamp		clc		rtsdo_stamp		lda	drvr_blk_num		pha		lda	drvr_buf_ptr		pha		lda	drvr_buf_ptr+2		pha		jsr	pack_time		;get the time please		clc		lda	gbuf_addr		adc	#blk_size		sta	drvr_buf_ptr		lda	gbuf_addr+2		adc	#$0000		sta	drvr_buf_ptr+2		lda	slug_block		;setup the block		bne	@around		brl	do_volume_mod		;no slug block, so time stamp the volume please@around		sta	drvr_blk_numslug_loop		jsr	read_with_cache		;read in the block please		bcs	end_slug_err		ldy	slug_offset		;offset to the entry		lda	[drvr_buf_ptr],y		and	#$00F0			;check the storage type		cmp	#subdir_type		bne	bad_slug_dir		;sorry bud		tya		clc		adc	#dir_entry.time		tay				;index to the last mod field		lda	pro_time+2		;Get the time we are going to stamp with		sta	[drvr_buf_ptr],y		lda	pro_time		;and the date		iny		iny		sta	[drvr_buf_ptr],y		ldy	slug_offset		;offset to the entry		tya		clc		adc	#dir_entry.attributes		tay				;index to the access field		sep	#$20		lda	[drvr_buf_ptr],y	;only an 8-bit field		ora	#archive		;set the backup bit		sta	[drvr_buf_ptr],y		rep	#$20		longa	on		jsr	write_with_cache		bcs	end_slug_err		;a major error		lda	time_stamp_opt		;are we walking to root?		dec	a		beq	end_slug		;not today.		clc		lda	slug_offset		;offset to the entry		adc	#header_ptr_index	;point to the header pointer please		tay		lda	[drvr_buf_ptr],y		cmp	#vol_dir_start		;is this the root?		beq	do_volume_mod		;set the volume modification date		cmp	drvr_blk_num		;is the block already loaded?		beq	block_loaded		;you bet-cha		sta	drvr_blk_num		;next block to read		jsr	read_with_cache		bcs	end_slug_err		;sorry bud major errorblock_loaded		ldy	#parent_index		lda	[drvr_buf_ptr],y		sta	drvr_blk_num		;new block number		iny		iny				;get the entry number		lda	[drvr_buf_ptr],y		jsr	entry_to_offset		sta	slug_offset		;the new offset		bra	slug_loop		;ripple to the top.bad_slug_dir		lda	#dir_error		bra	end_slug_errend_slug		clcend_slug_err		plx		stx	drvr_buf_ptr+2		plx		stx	drvr_buf_ptr		plx		stx	drvr_blk_num		rts;;Now lets go and time stamp the volume please;do_volume_mod		lda	#vol_dir_start		;Setup the block number for the Root		sta	drvr_blk_num		jsr	read_with_cache		;read in the block please		bcs	end_slug_err		;I hate it with this happens		ldy	#vol_mod_offset		;offset to the Mod time field for the volume		lda	pro_time		sta	[drvr_buf_ptr],y		iny		iny		lda	pro_time+2		sta	[drvr_buf_ptr],y	;store the time						;new code added 3/15/91 CAE		ldy	#vol_acc_offset		;offset to the access field		lda	[drvr_buf_ptr],y		ora	#backup_on		;set the backup bit on disk		sta	[drvr_buf_ptr],y						;end of new code		ldy	#msdos_vcr.mod_date	;update the VCR as well as the disk		lda	pro_time		sta	[msdos_vcr_ptr],y		iny		iny		lda	pro_time+2		sta	[msdos_vcr_ptr],y						;new code added 4/4/91 CAE		ldy	#msdos_vcr.access	;offset to the access field		lda	[msdos_vcr_ptr],y		ora	#backup_on		;set the backup bit in the VCR		sta	[msdos_vcr_ptr],y	;so that the disk and VCR match		jsr	write_with_cache		bcs	end_slug_err		;a major error		bra	end_slug		;no error, all is wonderful		ENDP	endif	if NOT read_only_fst then		Eject;==========================================================================;extend_subdir  This routine will extend a directory if needed.;;input:         free_dir_blk            ;dir blk with a empty entry.;               dir_start_blk           ;starting block of the directory;               dir_last_blk            ;last block of the directory;;output:        free_dir_blk            ;dir blk with a empty entry.;               free_dir_offset         ;offset to directory entry within block;               dir_start_blk           ;starting block of the directory;               dir_last_blk            ;last block of the directory;		longa	on		longi	onextend_subdir	PROC	Export		with	my_dp,expand_record		bit	expand_file		;are we adding a directory entry?		bmi	good_exit		;if we are expanding a file we donot need to extend the						;directory		lda	free_dir_blk		;is there a free entry for this file?		bne	good_exit		;do not extend the directory		lda	dir_start_blk		cmp	#vol_dir_start		;is this the root directory?		bne	not_root		lda	#vol_dir_full		;return an error please		sec		rtsnot_root		lda	#$0001			;allocate one block for directory.		ldx	dir_last_blk		;start looking here for next block		jsr	find_Free_blks		;go and get one		bcs	error_out		;error out		stx	drvr_blk_num		;this is the new directory block		stx	free_dir_blk		;new block number		lda	#$0004			;index to first free entry		sta	free_dir_offset		jsr	set_default_buf		;use the genaral buffer		jsr	standard_req		;512 byte write		jsr	clear_dir_buf		;clear the 512 byte general buffer		jsr	append_last_blk		bcs	error_out		;major problem		jsr	update_forw_lnk		;update forward link to new block		bcs	error_out		jsr	update_parent		;update parents blocks used count		bcs	error_outgood_exit		clcerror_out		rts				;extend complete;==========================================================================;Update_parent: This routine will update the blocks used and last mod date;               of the parent entry for the directory.update_parent		lda	dir_start_blk		sta	drvr_blk_num		;key block for directory		jsr	read_with_cache		bcs	exit_update		ldy	#parent_index		lda	[gbuf_ptr],y		;get the parent block number		sta	drvr_blk_num		ldy	#par_entry_num		lda	[gbuf_ptr],y		and	#$00FF			;get the number		dec	a		cmp	#$000D			;number of entries		bcs	bad_dir_bud		asl	a			;times 2 for a word table		tay		lda	dir_offset_tbl,y		sta	entry_offset		;save offset to dir entry		jsr	read_with_cache		;read in the parent block		bcs	exit_update		ldy	entry_offset		lda	[gbuf_ptr],y		and	#$00F0			;is this a subdir entry?		cmp	#subdir_type		bne	bad_dir_bud		tyx		clc		tya		adc	#$0013			;index to blocks used for file		tay		lda	[gbuf_ptr],y		inc	a		sta	[gbuf_ptr],y		iny		iny				;point to EOF		clc		lda	[gbuf_ptr],y		adc	#blk_size		sta	[gbuf_ptr],y		;add 512 to the EOF field		bcc	good_eof		iny		iny				;point to the third byte of EOF		longa	off		sep	#$20			;short A		lda	[gbuf_ptr],y		inc	a		sta	[gbuf_ptr],y		longa	on		rep	#$20good_eof		clc		txa		adc	#$0021			;index to mod time		pha		jsr	pack_time		ply				;index		lda	pro_time		sta	[gbuf_ptr],y		;update mod time		iny		iny		lda	pro_time+2		sta	[gbuf_ptr],y		jsr	write_with_cacheexit_update		rtsbad_dir_bud		lda	#dir_error		;bad directory block		sec		rts;==========================================================================;update_forw..  This routine will link the new directory block just;               allocated to the current last block of the directory.update_forw_lnk		lda	dir_last_blk		sta	drvr_blk_num		;now read in the directory block.		jsr	read_with_cache		bcs	forw_exit		;major problems. sorry about droppings!		ldy	#$0002			;index to next pointer		lda	[gbuf_ptr],y		bne	bad_dir_bud		lda	free_dir_blk		;forward link directory block.		sta	[gbuf_ptr],y		jsr	write_with_cacheforw_exit	rts;==========================================================================;append_last..  This routine will link the new block to the previous;               block in the directory.append_last_blk		lda	dir_last_blk		;setup the backward link		sta	[gbuf_ptr]		jsr	write_with_cache		rtsclear_dir_buf		ldy	#$01FE			;clear the general work buffer		lda	#$0000clear_dir		sta	[gbuf_ptr],y		dey		dey		bpl	clear_dir		;every body happy now!		rts		ENDP	endif		Eject;======================================================================;make_rfork_name;		This routine will build a pathname to the resource fork;		file associated with the filename specified in path1.;		It does this by inserting the RESOURCE.FRK subdirectory;		name into the pathname prior to the leaf name (filename).;;Created:       Oct 06, 1992;Modified:      ;Author:        Greg Branche;;;Enter:         ;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               path1_ptr	points to pathname to convert;		drvr_dev_num	device number of drive containing file; ;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               namebuf_vp	virtual pointer to pathname;		namebuf_ptr	pointer to pathname;		NOTE: namebuf_vp must be deallocated by caller; ;Uses:          All registers;               temp4_ptr;		build_path;		find_file;;======================================================================		longa	on		longi	onmake_rfork_name	Proc	Export		with	my_dp; save math_temp		pei	math_temp		lda	[path1_ptr]		;retrieve existing length		clc		adc	#25			;allow for extra names		jsl	alloc_seg		;get some memory		bcc	@1		brl	main_exit		@1		stx	namebuf_vp		sty	namebuf_vp+2		jsl	deref		stx	namebuf_ptr		sty	namebuf_ptr+2		lda	[path1_ptr]		;get length		inc	a			;allow for leading length word		sta	temp4_ptr		;save temporarily		inc	temp4_ptr		;for comparison later		tay		sep	#$20			;8-bit accumulator		longa	off		lda	#':'			;looking for separator@loop		dey		cpy	#2			;found beginning of pathname?		bcc	at_separator		;yup, no volume name supplied		cmp	[path1_ptr],y		;at separator?		bne	@loop			;no, keep lookingat_separator		iny		sty	math_temp		;this is the offset of the first character of the filename		cpy	#2			;was there a path name?		beq	@no_pathname		;no, just the filename		ldy	#2			;start copying pathname into temp buffer@1		lda	[path1_ptr],y		sta	[namebuf_ptr],y		iny		cpy	math_temp		bcc	@1@no_pathname		ldx	#0@2		lda	ResForkName+2,x		;now copy in the subdirectory name		sta	[namebuf_ptr],y		iny		inx		cpx	ResForkName		;done entire name yet?		bcc	@2			;no				tyx				;save destination index		ldy	math_temp		;retrieve source index@3		lda	[path1_ptr],y		;get a character		phy		txy		sta	[namebuf_ptr],y		inx		ply		iny		cpy	temp4_ptr		;done with filename yet?		bcc	@3			;no, loop		lda	#0			;null terminate the pathname		txy		sta	[namebuf_ptr],y		rep	#$20			;16-bit accumulator		longa	on		txa				;get final length		dec	a			;adjust for final length		dec	a		sta	[namebuf_ptr]		;and store		pla		sta	math_temp		rts		Endp		Eject;======================================================================;move_dir_entry This routine will move the 32 byte entry pointed to by;               drvr_buf_ptr to one_entry.  If the entry pointed to;               is a volume header then I will simulate a normal 32;               byte entry. ;;Created:       may 05, 1987;Modified:      may 05, 1987;Author:        Rob Turner;;;Enter:         from open call;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               drvr_buf_ptr            (points to the 32 byte entry from disk) ; ;Output:        A = undefiend;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               one_entry               (contains a 32 byte entry); ;Uses:          All registers;               General I/O Buffer      (1K buffer, I read 512 bytes);               drvr_buf_ptr;;======================================================================		longa	on		longi	onmove_dir_entry	PROC	Export		ldy	#entry_length-2		;move a file entrymove_loop	lda	[drvr_buf_ptr],y		sta	one_entry,y		lda	#0			;zero resource fork entry		sta	rfork_entry,y		dey		dey		bpl	move_loop		ldy	#dir_entry.attributes	;look at the entry's attributes		lda	[drvr_buf_ptr],y		bit	#vol_label		;volume label?		bne	simulate_entry		;yes, must simulate entry		ldx	#seedling_type		;storage type always = 1		bit	#subdirectory		;unless it's a directory		beq	@not_directory		ldx	#subdir_type@not_directory		stx	storage_type;==========================================================================;Now copy the filename from the entry into a separate buffer so we can;insert the period if necessary.  We also set the string length word to;make the whole thing into a class 1 string;==========================================================================		sep	#$20			;8-bit accumulator		longa	off		ldy	#0			;start at the beginning		tyx				;set x too (for later)@loop		lda	one_entry,y		;get a character		cmp	#' '			;space?		beq	@do_extension		;yes, now do the extension		sta	filename.text,y		;else store it		iny		cpy	#8			;done 8 characters?		bcc	@loop			;nope, back for more@do_extension		lda	#'.'			;insert the field separator		sta	filename.text,y		iny@ext_loop		lda	one_entry+8,x		;get an extension character		cmp	#' '			;space?		beq	@set_length		;yup, save the final length		sta	filename.text,y		;else add it to the name		iny		inx		cpx	#3			;done all three characters?		bcc	@ext_loop		;no...@set_length		txa				;WAS there any extension character?		bne	@store_it		;yes...		dey				;else fix length so '.' isn't included@store_it		sty	filename.length		;save the final length		rep	#$20			;back to full native mode		longa	on;; we now check the call number to see if we should look for a resource; fork.  Currently, we only do this for GetFileInfo and Open;		lda	call_number		and	#(Åclass_mask) AND $FFFF	;strip class field		cmp	#$0010			;open call?		beq	@rfork_chk		;yup		cmp	#$0006			;GetFileInfo?		bne	@skip_rfork		;no, skip it@rfork_chk		jsr	chk_4_rfork		;go see if there's a resource fork@skip_rfork		rts;==========================================================================;below we setup the volume directory as a subdirectory.  To do this;we setup the following fields:;==========================================================================; File_type     := $0F                  (directory File); Key_pointer   := vol_dir_start        (starting block for directory = 2); Blocks_used   := (Calculated from disk); EOF           := (Calculated from disk); AUX Type      := $0000                (zero the aux field); Last_mod      := $00000000            (don't have this info); Header Ptr    := $0002                (Starting block of owning directory);==========================================================================simulate_entry		lda	#volume_header		sta	storage_type;==========================================================================;Now setup the file type as a subdirectory entry;==========================================================================		sep	#$20		longa	off		lda	#subdirectory		tsb	one_entry.attributes		ldy	#0			;start at the beginning@loop		lda	one_entry,y		cmp	#' '			;end it at the first space		beq	@set_length		sta	filename.text,y		iny		cpy	#11			;done 11 characters yet?		bcc	@loop			;no...@set_length		sty	filename.length		rep	#$20		longa	on		rts;=========================================================================;Perform some magic to see if there's a resource fork associated with this;file;=========================================================================chk_4_rfork		with	my_dp		jsr	make_rfork_name		;go make the pathname; we now have the pathname built.  Go find the file		lda	#path1_mask		;and mask for path_flag		ldx	namebuf_ptr		ldy	namebuf_ptr+2		jsr	build_path		lda	drvr_dev_num		jsr	find_file		;try to locate the file		bcs	no_rfork		;not found, for whatever reason		stx	temp4_ptr		;save pointer to entry		sty	temp4_ptr+2		ldy	#entry_length-2		;move the file entry into special storagermove_loop	lda	[temp4_ptr],y		sta	rfork_entry,y		dey		dey		bpl	rmove_loop		lda	#resource_type		;set the proper storage type		sta	storage_typeno_rfork; clean up after ourselves		ldx	namebuf_vp		ldy	namebuf_vp+2		jsl	release_seg		rts		ENDP		Eject;======================================================================;get_next_fcr:  This routine will load find the next FCR that belongs;               to MSDOS.;;Created:       may 23, 1987;Modified:      may 23, 1987;Author:        Rob Turner;;;Enter:         from open call;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               fcr_wanted              (counter for FCR, reset by caller!); ;Output:        A = undefiend;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error    (end of FCRs);                          0 = no error;               b = k;;               msdos_fcr_ptr;               my_fcr_ptr              (points to the found FCR);;Uses:          All registers;               system_routines;;======================================================================		longa	on		longi	onget_next_fcr	PROC	Export		with	my_dploop		lda	fcr_wanted		inc	a		sta	fcr_wanted		jsl	get_fcr			;see if this is a fcr		bcs	done		jsl	deref			;convert VP to RP		stx	my_fcr_Ptr		sty	my_fcr_ptr+2		ldy	#fcr.fst_id		;see if this one is mine		lda	[my_fcr_ptr],y		cmp	#fst_id		bne	loop			;not mine so who cares		jsr	setup_my_fcr		clcdone		rts		ENDP		Eject;======================================================================;check_dup:     This routine will check for duplicate file entries.;               To do this I look to see if the starting block of;               the FCR is equal to the starting block of the file I am;               trying to open. ;;Created:       may 04, 1987;Modified:      may 06, 1987;Author:        Rob Turner;;;Enter:         from open call;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               one_entry               (39 byte entry from disk) ;               access                  (requested access for open); ;Output:        A = error code if carry set. (duplicate error);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               General I/O Buffer      (1K buffer, I read 512 bytes);               find_fcr                (system routine to find a fcr;               my_fcr_ptr;               msdos_fcr_ptr;               access;               resource_num; ;======================================================================		longa	on		longi	oncheck_dup	PROC	Export		with	my_dp		stz	fcr_wanted		;reset for get_next_fcr		ldx	one_entry.start_cluster		lda	resource_num		;trying to open resource fork?		beq	@store_start		;nope		ldx	rfork_entry.start_cluster@store_start		stx	key_blocknext_loop		jsr	get_next_fcr		bcs	done		ldy	#fcr.vol_id		lda	[my_fcr_ptr],y		;get the Volume ID so we can make sure the file is on		cmp	[my_vcr_ptr]		;the same volume.		bne	next_loop		;File is on another volume		ldy	#msdos_fcr.start_cluster ;index to key block of this file		lda	[msdos_fcr_ptr],y		cmp	key_block		;is this the same block?		bne	next_loop		;no problem with this file		ldy	#fcr.access		;see if this file was open for writing		lda	[my_fcr_ptr],y		and	#ClrAllButAccess		cmp	#write_access		bcs	file_is_busy		;sorry this file is busy right now;==========================================================================;If we get here we know that the current file is the same and that it is;open for read only.  Therefore we must check the requested access of the;file that we are currently opening.  If the user wants read only access;then there is no problem.;==========================================================================		lda	users_access		;did the user want "open_as_permitted"		beq	open_as_perm		;user request open as permitted. 		cmp	#write_access		bcc	open_okfile_is_busy		lda	#file_busy		;carry already set when we get hereopen_ok		rts				;error out to caller open_as_perm		lda	#read_access		sta	access			;change the user's access to Read Only.done		clc				;indicate no problem		rts		ENDP		Eject;==========================================================================;set_fcr_status This routine will set bits in the FCR pointed to by;               'msdos_fcr_ptr';;Input:         A = ORA Mask;;OutPut:        Operation complete;;Uses:          A and Y registers;==========================================================================set_fcr_status	PROC	Export		with	my_dp		ldy	#msdos_fcr.status		ora	[msdos_fcr_ptr],y		sta	[msdos_fcr_ptr],y		rts		ENDP		Eject;========================================================================== ;setup_io_buf   This routine will fill the I/O buffer with the correct;               data;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               one_entry               (32 byte entry from disk) ;               FCR                     (setup);;Output:        A = error code if carry set.;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;;==========================================================================setup_io_buf	PROC	Export		with	my_dp		jsr	standard_req		ldy	#msdos_fcr.start_cluster		lda	[msdos_fcr_ptr],y	;get the starting cluster number		ldy	#msdos_fcr.curr_cluster		sta	[msdos_fcr_ptr],y	;remember where we're at		jsr	cluster2block		;convert to a block number		sta	drvr_blk_num		stz	drvr_blk_num+2		ldy	#msdos_fcr.cluster_blk_num		lda	#0			;fresh cluster, reset the block number		sta	[msdos_fcr_ptr],y		lda	#in_cache		sta	drvr_cache		ldx	data_ptr		ldy	data_ptr+2		stx	drvr_buf_ptr		sty	drvr_buf_ptr+2		;save the pointer to the buffer		jsr	read_with_cache		rts		ENDP		Eject;==========================================================================;setup_curr_mark This routine will load the current file marker out of the;               FCR and store it in curr_mark;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_fcr_ptr           (points to my FCR data);;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               curr_mark               (contains current file marker);;Uses:          All registers;==========================================================================		longa	on		longi	onsetup_curr_mark	PROC	Export		with	my_dp		ldy	#msdos_fcr.curr_mark		lda	[msdos_fcr_ptr],y		sta	curr_mark		iny		iny		lda	[msdos_fcr_ptr],y		sta	curr_mark+2		rts		ENDP		Eject;==========================================================================;setup_curr_eof This routine will load the current end of file out of the;               FCR and store it in curr_eof;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_fcr_ptr           (points to my FCR data);;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               curr_eof                (contains current end fo file);;Uses:          All registers;==========================================================================		longa	on		longi	onsetup_curr_eof	PROC	Export		with	my_dp		ldy	#msdos_fcr.eof		lda	[msdos_fcr_ptr],y		sta	curr_eof		iny		iny		lda	[msdos_fcr_ptr],y		sta	curr_eof+2		rts		ENDP		Eject;==========================================================================;save_curr_mark This routine will save the current end of file into the;               FCR.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_fcr_ptr           (points to my FCR data);               curr_mark;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          A and Y  registers;==========================================================================		longa	on		longi	onsave_curr_mark	PROC	Export		with	my_dp		ldy	#msdos_fcr.curr_mark		lda	curr_mark		sta	[msdos_fcr_ptr],y		iny		iny		lda	curr_mark+2		sta	[msdos_fcr_ptr],y		rts		ENDP		Eject;==========================================================================;check_base     This routine will verify that the base is within range;;Created:       may 23, 1987;Modified:      may 23, 1987;Author:        Rob Turner;;;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = offset to base field;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               BASE                    (contains value of the base);;Uses:          All registers;;==========================================================================		longa	on		longi	oncheck_base	PROC	Export		with	my_dp		lda	[my_pblk_ptr],y		cmp	#max_base+1		bcs	range_error		sta	base		rtsrange_error		lda	#parm_range_err		brl	main_exit		ENDP		End