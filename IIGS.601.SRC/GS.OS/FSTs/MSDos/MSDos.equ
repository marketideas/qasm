; include system-level equates		print	push		print	off		include 'common.equ.src'		include 'hw.equ.src'		print	pop;fst_id		equ	10			;identifies msdos fstread_only_fst	equ	1			;set to 0 to make writeable FSTprodos		equ	0			;used to conditionalize out some codeCallStringToText equ	1			;conditional code for JudgeName, 14-Apr-91 DAL;; MSDos-specific extensions to the VCR;msdos_vcr	record	0; copy of volume's bios parameter blocksector_size	ds.w	1			;bytes per sectorcluster_size	ds.b	1			;sectors per allocation unitreserved_sectors ds.w	1			;# of reserved sectorsFAT_count	ds.b	1			;# of file allocation tablesroot_dir_count	ds.w	1			;# of entries in root directorytotal_sectors	ds.w	1			;total # of blocks on volumemedia_desc	ds.b	1			;media descriptor byteFAT_size	ds.w	1			;# of sectors per FATtrack_size	ds.w	1			;# of sectors per trackhead_count	ds.w	1			;# of headshidden_sectors	ds.w	1			;# of hidden sectors; other fields of usefree_blocks	ds.w	1			;Free blocks on volume,$FFFF = unknownroot_dir_block	ds.w	1			;block number of first directory entrydirty_file_cnt	ds.l	1			;number of files that are open for writing and are dirtyFAT_type	ds.w	1			;==0 - 12-bit cluster numbers, !=0 - 16-bitdata_start	ds.w	1			;first block number of data areavol_damaged	ds.w	1			;stops writing to bad disk if <> 00	if prodos then;old prodos fields, delete when we get this sucker done;reserved	ds.b	8			;8 bytes of reserved field from disk		org	-6mod_date	ds.w	2			;volume mod date		orgcreate		ds.w	2			;create date/time from headerversion		ds.b	1			;version of OS that created filemin_version	ds.b	1			;minimum version of OS that can accessaccess		ds.b	1			;access for a fileentry_len	ds.b	1			;entry length of each entryentries		ds.b	1			;number of entries per blockfile_count	ds.w	1			;number of files in volume directorybitmap_addr	ds.w	1			;starting block of bitmaptotal_blks	ds.w	1			;total number of blocks on disknum_bitmap_blks	ds.w	1			;total number of bitmap blocksend_bitmap	ds.w	1			;1st byte that starts all zerosavail_bitmap	ds.w	1			;1st bitmap block(rel)  with free spacecurr_bitmap	ds.w	1			;current bitmap(rel) block in memorybitmap_dirty	ds.w	1			;0 = bitmap clean, <> 0 = bitmap dirty	endif		endr;; VCR structure definition;vcr		record	0id		ds.w	1			;volume idname		ds.l	1			;volume name pointerstatus		ds.w	1			;volume statusopen_cnt	ds.w	1			;number of open files on volumefst_id		ds.w	1			;owner ID numberdev		ds.w	1			;where volume was last seenMSDos_stuff	ds	msdos_vcr		;MSDos-specific stuffFAT_startsize		EndRbitmap_mod	equ	$FFFFbitmap_unknown	equ	$FFFFvcr_entry_length equ	$000F;; MSDos extensions to FCR structure;msdos_fcr	Record	0;fields copied from directory entryattributes	ds.w	1			;attribute byte (extended to word size)mod_time	ds.w	1			;modified time of filemod_date	ds.w	1start_cluster	ds.w	1eof		ds.l	1			;current end of filecurr_cluster	ds.w	1			;cluster # of current block in buffercluster_blk_num	ds.w	1			;block # within current clustercluster_size	ds.w	1			;# of blocks per clusterstatus		ds.w	1			;offset: current status of fileparent		ds.w	1			;block number of directory blockentry_offs	ds.w	1			;index to entry within parent blockcurr_mark	ds.l	1			;current file markstorage		ds.w	1			;real storage type on diskgde_entry_num	ds.w	1			;current entry for Get_Dir_Entrygde_offset	ds.w	1			;current offset to entry; old prodos fields - nuke when we get everything working if prodos thenentry_type	ds.w	1			;storage type from directory entryfile_id		ds.w	1			;used to ID duplicate filesfile_type	ds.b	1			;file typekey_blk		ds.w	1			;key block of the fileblks_used	ds.w	1			;number of blocks usedcreate		ds.b	4			;create date/time ProDOSvers		ds.b	1			;version of o/s that made filemin_vers	ds.b	1			;min version of o/s alloweddisk_acc	ds.b	1			;file accessaux_type	ds.w	1			;aux type for this fileheader_ptr	ds.b	2			;key block of dir ownerblks_alloc	ds.b	2			;current number of blks allocgde_curr_blk	ds.w	1			;current directory block loadedgde_tot_files	ds.w	1			;total files in directorycurr_eof	ds.l	1			;current end of filedata_blk_num	ds.b	2			;block number of current data blockindex_blk_num	ds.b	2			;block number of current index blockmaster_blk_num	ds.b	2			;block number of master index block endif		EndR;; FCR Structure definition;fcr		Record	0ref_num     	ds.w	1			;file's refnumpath_name   	ds.l	1			;VP to file's pathnamefst_id      	ds.w	1			;FST ID of owning FSTvol_id      	ds.w	1level       	ds.w	1			;level that file was opened withnewline     	ds.l	1			;VP to list of newline charactersnewline_len 	ds.w	1			;length of newline listmask        	ds.w	1			;newline mask (?)access      	ds.w	1			;access used to open filemsdos_stuff	ds	msdos_fcrio_start	ds.b	$200			;i/o buffer built in to fcrsize		EndR;; Direct Page usage;my_dp		Record	fst_startmy_pblk_ptr	ds.l	1my_vcr_ptr	ds.l	1msdos_vcr_ptr	ds.l	1my_fcr_ptr	ds.l	1msdos_fcr_ptr	ds.l	1gbuf_ptr	ds.l	1temp_ptr	ds.l	1temp2_ptr	ds.l	1temp3_ptr	ds.l	1temp4_ptr	ds.l	1map_ptr		ds.l	1math_temp	ds.l	1data_ptr	ds.l	1index_ptr	ds.l	1master_ptr	ds.l	1fat_ptr		ds.l	1users_buf_ptr	ds.l	1newline_ptr	ds.l	1namebuf_vp	ds.l	1namebuf_ptr	ds.l	1dp_end	if (dp_end-my_dp) > $54 then		aerror "Direct Page Overflow"	endif		EndRdir_entry	Record	0name		ds.b	11			;nameattributes	ds.b	1			;attributesreserved	ds.b	10			;reservedtime		ds.w	1			;timedate		ds.w	1			;datestart_cluster	ds.w	1			;starting clusterfile_size	ds.l	1			;file sizesizeof						;sizeof dir_entry		EndRfile_dirty	equ	$8000			;ora masks to active fielddata_active	equ	$4000index_active	equ	$2000master_active	equ	$1000file_clean	equ	$7FFF			;and masks to deactivate fielddata_inactive	equ	$BFFBindex_inactive	equ	$DFFDmaster_inactive	equ	$EFFEdirEntry_dirty	equ	$0008dirEntry_clean	equ	ÅdirEntry_dirty		;'Å' is the assembler's one's complement operatordata_dirty	equ	$0004data_clean	equ	$FFFBindex_dirty	equ	$0002index_clean	equ	$FFFDmaster_dirty	equ	$0001master_clean	equ	$FFFEclr_global_clean equ	$7FFF			;clear the global clean bitset_global_clean equ	$8000			;set the file clean in the FCRset_access_res	equ	$4000			;set the resource fork bit in the FCRClrAllButAccess	equ	$3FFF			;clear the resource bit from access word.path_used	equ	$0100vcr_used	equ	$0200fcr_used	equ	$0400io_used		equ	$0800clr_io_used	equ	$F7FF; file attributesarchive		equ	%00100000subdirectory	equ	%00010000vol_label	equ	%00001000sys_file	equ	%00000100hidden_file	equ	%00000010read_only	equ	%00000001; miscellaneous equatesword		equ	02			;two bytes for a wordblk_size	equ	512			;standard size of a sectordelimiter	equ	$3A			;pathname delimiter = ":"min_send_cnt	equ	$21			;If read < 33 bytes use local routineprodos_version	equ	$0005			;current version of the PRODOS.path1_mask	equ	$4000			;used to determine if path1 is avail.path2_mask	equ	$0040			;used to determine if path2 is avail.max_span	equ	12			;maximum length of filename:						; 8 char name + 3 char extension + .carry		equ	$01			;used to set the carryoverflow	equ	$40			;used to set the overflow flagin_cache	equ	$8002user_cache_val	equ	$0001class_mask	equ	$E000disk_protect	equ	$0004			;bit to see if disk is protectedmax_base	equ	$0003pcount1		equ	1pcount2		equ	2pcount3		equ	3pcount4		equ	4pcount5		equ	5pcount6		equ	6pcount7		equ	7pcount8		equ	8pcount9		equ	9write_call	equ	$13read_enabled	equ	$0001			;1=Read Enabledwrite_enabled	equ	$0002			;1=Write Enabledbackup_enabled	equ	$0020			;1=Needs to be backed uprename_enabled	equ	$0040			;1=Rename alloweddestroy_enabled	equ	$0080			;1=Destroy is enabledread_access	equ	$01write_access	equ	$02invis_bit	equ	$04read_write_acc	equ	$03seedling_type	equ	$0010			;$0000000 < EOF < $0000201sapling_type	equ	$0020			;$0000200 < EOF < $0020001tree_type	equ	$0030			;$0020000 < EOF < $1000000pascal_area	equ	$0040			;Area set aside for Pascalresource_type	equ	$0050			;Special type for resource filespurge_dir	equ	$0060			;directory that contains purged filessubdir_type	equ	$00D0			;Subdirectorysubdir_header	equ	$00E0			;First entry in sudbirectoryvolume_header	equ	$00F0			;First entry in the volume directoryvol_dir_start	equ	$0002			;start of the volume directorybitmap_strt_blk	equ	$0006			;start of the volume bitmapentry_length	equ	$0020			;length of each directory entryentries_per_block equ	blk_size/entry_lengthparent_index	equ	$0027par_entry_num	equ	$0029header_file_cnt	equ	$0025			;number of files in a directorybackup_on	equ	%00100000backup_off	equ	Åbackup_onfile_type_index	equ	$10			;look at page 168 (ProDOS 8 manual)key_blk_index	equ	$11			;index into disk entryblks_used_index	equ	$13eof_index	equ	$15create_index	equ	$18version_index	equ	$1Cmin_version	equ	$1Daccess_index	equ	$1Eaux_type_index	equ	$1Flast_mod_index	equ	$21header_ptr_index equ	$25no_root		equ	$8000			;indicates root level name is invalidno_dup		equ	$4000			;indicates duplicates are not validroot_only	equ	$2000			;allow only the root level in pathnamevol_mod_offset	equ	$16			;offset to the volume mod date fieldvol_acc_offset	equ	$22			;offset to the volume access fielddir_file_type	equ	$0Ftool_locator	equ	$E10000misc_tools	equ	$0003read_time_hex	equ	$000D			;read the clock via misc_toolsset_time_stamp	equ	$0001get_time_stamp	equ	set_time_stamp+$8000set_upper_case	equ	$0002get_upper_case	equ	set_upper_case+$8000debugger_cmnd	equ	$0002debugger_status	equ	debugger_cmnd+$8000hfs_id		equ	$0006			;HFS FST IDashare_id	equ	$000D			;AppleShare FST IDfinfo_type	equ	1			;HFS FInfo entry typexfinfo_type	equ	2			;HFS xFInfo entry type;------------------------------------------;; Equates from procedure data;;------------------------------------------drvr_bytes	equ	$1A			;start at byte $1A and $1Bflush_1st	equ	$1000damage		equ	$2000max_class1	equ	$0020max_pcnt1	equ	1+1max_pcnt2	equ	2+1max_pcnt3	equ	3+1max_pcnt4	equ	4+1max_pcnt5	equ	5+1max_pcnt6	equ	6+1max_pcnt7	equ	7+1max_pcnt8	equ	8+1max_pcnt9	equ	9+1max_pcnt10	equ	10+1max_pcnt11	equ	11+1max_pcnt12	equ	12+1max_pcnt13	equ	13+1max_pcnt14	equ	14+1max_pcnt15	equ	15+1max_pcnt16	equ	16+1max_pcnt17	equ	17+1do_dirty	equ	$4000;equates for the read call.pblk_12_ref	equ	$0000			;index to the reference numberpblk_12_buf	equ	pblk_12_ref+2		;index to user's buffer pointerpblk_12_req	equ	pblk_12_buf+4		;index to request countpblk_12_tran	equ	pblk_12_req+4		;index to transfer countpblk_12_cache	equ	pblk_12_tran+4		;index to user provided cache prioritymax_read_pcnt	equ	$0005;equates used by openpblk_10_access	equ	$000Apblk_10_ftype	equ	pblk_10_access+2pblk_10_aux	equ	pblk_10_ftype+2pblk_10_storage	equ	pblk_10_aux+4pblk_10_eof	equ	pblk_10_storage+2pblk_10_num_res	equ	pblk_10_eof+4pblk_10_create	equ	pblk_10_num_res+2pblk_10_mod	equ	pblk_10_create+8pblk_10_blks	equ	pblk_10_mod+8pblk_10_map	equ	pblk_10_blks+4;equates used by set_markpblk_16_base	equ	$0002pblk_16_disp	equ	pblk_16_base+2;equates used by get_markpblk_17_pos	equ	$0002;equates used by get_eofpblk_19_eof	equ	$0002;equates used by send_infopblk_s_access	equ	$0000pblk_s_ftype	equ	pblk_s_access+2pblk_s_aux	equ	pblk_s_ftype+2pblk_s_storage	equ	pblk_s_aux+4pblk_s_create	equ	pblk_s_storage+2pblk_s_mod	equ	pblk_s_create+8pblk_s_opt	equ	pblk_s_mod+8pblk_s_eof	equ	pblk_s_opt+4pblk_s_blks	equ	pblk_s_eof+4pblk_s_res_eof	equ	pblk_s_blks+4pblk_s_res_blk	equ	pblk_s_res_eof+4;equates used by volumepblk_08_vol	equ	$0004pblk_08_tot	equ	pblk_08_vol+4pblk_08_free	equ	pblk_08_tot+4pblk_08_id	equ	pblk_08_free+4pblk_08_size	equ	pblk_08_id+2pblk_08_purge	equ	pblk_08_size+2;equates used by set_file_infopblk_05_accs	equ	$0004pblk_05_ftype	equ	pblk_05_accs+2pblk_05_aux	equ	pblk_05_ftype+2pblk_05_create	equ	pblk_05_aux+6pblk_05_mod	equ	pblk_05_create+8pblk_05_opt	equ	pblk_05_mod+8;equates used by get_file_infopblk_06_map	equ	$0028;equates used by set_eofpblk_18_odisp	equ	$0002pblk_18_base	equ	$0002pblk_18_disp	equ	pblk_18_base+2;equates used by createpblk_01_accs	equ	$0004pblk_01_ftype	equ	pblk_01_accs+2pblk_01_aux	equ	pblk_01_ftype+2pblk_01_stype	equ	pblk_01_aux+4pblk_01_eof1	equ	pblk_01_stype+2pblk_01_eof2	equ	pblk_01_eof1+4pblk_01_old_time equ	$000E;equates used by get dir entrypblk_1c_flags	equ	$0002pblk_1c_disp	equ	$0002pblk_1c_name	equ	pblk_1c_disp+2pblk_1c_entry	equ	pblk_1c_name+4pblk_1c_ftype	equ	pblk_1c_entry+2pblk_1c_eof	equ	pblk_1c_ftype+2pblk_1c_blks	equ	pblk_1c_eof+4pblk_1c_create	equ	pblk_1c_blks+4pblk_1c_mod	equ	pblk_1c_create+8pblk_1c_access	equ	pblk_1c_mod+8pblk_1c_aux	equ	pblk_1c_access+2pblk_1c_id	equ	pblk_1c_aux+4pblk_1c_opt	equ	pblk_1c_id+2pblk_1c_res_eof	equ	pblk_1c_opt+4pblk_1c_res_blks equ	pblk_1c_res_eof+4gde_max_base	equ	$0002bad_file_format	equ	$004a;equates used by judge_name             1/22/91 CAEpblk_07_ntype	equ	$0002pblk_07_syntax	equ	pblk_07_ntype+2pblk_07_max_len	equ	pblk_07_syntax+4pblk_07_name	equ	pblk_07_max_len+2pblk_07_nflags	equ	pblk_07_name+4;equates used by change_path		5-Dec-91 MSDpblk_04_src	equ	$0000		; (long) source pathnamepblk_04_dest	equ	$0004		; (long) destination pathnamepblk_04_flags	equ	$0008		; (word) $8000 = assume source is duplicate volume; equates used by fst_specificmap_enable_off	equ	$0006		;Offset	into parm list for fst_specific.map_size	equ	$0006		;Offset	into parm list for fst_specific.map_buffer	equ	$0006		;Offset	into parm list for fst_specific.;; data template definitions;GSStr255	Record	0length		ds.w	1text		ds.b	255		EndRtExpandRecord	Record	0expand_flag	ds.w	1expand_file	ds.w	1			;used to indicate we are extending a fileexpand_storage	ds.w	1			;storage type of the data fork on extensionexpand_key_blk	ds.w	1expand_blks_used ds.w	1expand_eof	ds.l	1		EndRtBiosParmBlock	Record	0sector_size	ds.w	1cluster_size	ds.b	1reserved_sectors ds.w	1FAT_count	ds.b	1root_dir_count	ds.w	1total_sectors	ds.w	1media_desc	ds.b	1FAT_size	ds.w	1track_size	ds.w	1head_count	ds.w	1hidden_sectors	ds.w	1bpb_size	equ	*-tBiosParmBlock		EndR