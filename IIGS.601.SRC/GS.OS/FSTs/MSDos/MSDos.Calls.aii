;======================================================================;; MSDos.Calls.aii;; This file contains the subroutines necessary to support the system-level; and application-level calls (Open, Read, etc.);;======================================================================		string	asis		Import	main_exit,fst_attr		entry	post_volume_changed		PRINT	GEN		msb	off		longa	on		longi	on;------------------------------------------;; Equates from procedure ;;------------------------------------------		include	'MSDos.equ'		print	push		print	off		include 'MSDos.Data.inc'		include	'MSDos.Subs.inc'		print	pop		Eject;======================================================================;init the MSDOS fst		longa	on		longi	onstartup		PROC	Export		with	my_dp		jsl	get_sys_gbuf		;get the systems general buffergood		stx	gbuf_addr		sty	gbuf_addr+2		;save pointer to general work buffer** Get memory for map_buffer and	save vp...*		lda	default_map		;Get size from default_map.		jsl	alloc_seg		;Get a hunk that size.		lda	#out_of_mem		;Get error code	in case	full.		bcs	exit			;Error,	so exit	with carry set.		stx	map_buffer_vp		;Save it.		sty	map_buffer_vp+2** Copy default map into	map buffer...*		jsl	deref			;Dereference vp.		stx	temp_ptr		;Save pointer.		sty	temp_ptr+2		longa	off			;Set 8 bit A.		sep	#$20		ldy	default_map		;Get map size.copy_loop	dey				;Done all?		bmi	restore_a		;Yep.		lda	default_map,y		;Nope, get byte.		sta	[temp_ptr],y		;Put it	in buffer.		bra	copy_loop		;And loop.		longa	on			;Restore 16 bit	A.restore_a	rep	#$21			;clear carry tooexit		rtl		ENDP		eject********************************************************************************	 Name:	shutdown** Description:	Releases file type translation table**     Created:	Oct 6, 1987*    Modified:	Oct 6, 1987*      Author:	Bryan Atsatt**	Entry:	jmp**	Input:	A = undefined*		X = call number	times 2*		Y = class number times 2*		P = nvmxdizc*		    ..000...**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error**	 Exit:	rtl*******************************************************************************shutdown	PROC	Export** Are we doing a warm shutdown?  Do nothing if so...*		clc				;Precondition to no error.		lda	>warm_cold_flag		;Get flag. Warm shutdown?		bne	exit			;Yes, so do nothing.** Release memory...*		ldx	map_buffer_vp		;Get virtual pointer.		ldy	map_buffer_vp+2		jsr	release_seg		;Free it up.** Unlock memory	and exit...*		entry	my_sys_exitmy_sys_exit					;	        		php				;Save carry.		pha				;Save error code.		jsr	unlock_mem		;Unlock	memory.		pla				;Recover error code.		plp				;Recover carry.exit		rtl				;Pass any errors back to Mike &	Jim.		ENDP		Eject;======================================================================;Sys_Remove_vol This file contains code that is called by the system;               to remove a volume control record (VCR).;;Input:         A = undefined;               X = (call number * 2);               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..0 = no error;               b = k;;Uses:          All registers;		longa	on		longi	onsys_remove_vol	PROC	Export		clc		rtl		ENDP		Eject;======================================================================;deferred_flush This file contains code that flush any deferred blocks;               blocks to disk. This routine is called when the stop;               session call is issued, and when swapout is called.;               Since the routine can be called from swapout it must;               save most of the direct page and local buffers.;;Input:         A = undefined;               X = (call number * 2);               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..0 = no error;               b = k;;Uses:          All registers;;======================================================================		longa	on		longi	ondeferred_flush	PROC	Export		with	my_dp;;Save the world.  We do this in case we are called by SwapOut.;		jsr	save_def		;save the deferred envirnoment		jsr	standard_req		;write 512 bytes		lda	#blk_size		sta	drvr_blk_size		ldx	vcr_ptr		ldy	vcr_ptr+2		stx	my_vcr_ptr		sty	my_vcr_ptr+2		jsr	setup_my_vcr;;Setup ID_Disk routine to ID by volume name ONLY!!  This is important;since block two is deferred and we are reading block two from the disk.;Therefore the two blocks will problably not be the same.;		lda	#$8001			;set the high bit of FST_NUM		sta	drvr_fst_num		;to force device access;;Try to locate the volume we are trying to write too.  We do this by;calling 'find_Volume'.  More then likely the volume is still in the;same drive.;		jsr	mount_volume		;go and locate the volume please		bcs	bad_bad_news		;we our up the creek!;;After finding the volume I will call the 'cache_flsh_def' routine.  This;routine will write all the deferred blocks to disk.;		lda	[my_vcr_ptr]		;setup the VOL ID		sta	drvr_vol_id		jsl	cache_flsh_def		bcc	exit_deferred;;Now that we are here we must restore the world and return back to scm;via an RTL instruction.;bad_bad_newsexit_deferred		jsr	restore_def		clc		rtlsave_def		php		phy		phx		pha		ldx	#$004A			;save the direct page datasave_direct		lda	drvr_dev_num,x		sta	def_dir_page,x		dex		bpl	save_direct		ldx	#$0052			;save my direct pagesave_my_direct		lda	fst_start,x		sta	def_my_direct,x		dex		bpl	save_my_direct		ldx	#19			;save the volume name bufferssave_def_vol		lda	volume_name,x		sta	def_vol_name,x		dex		bpl	save_def_vol		bra	save_rest_exit;======================================================================restore_def		php		phy		phx		pha		ldx	#$004A			;restore the direct page datarestore_direct		lda	def_dir_page,x		sta	drvr_dev_num,x		dex		bpl	restore_direct		ldx	#$0052			;restore my direct pagerestore_dp		lda	def_my_direct,x		sta	fst_start,x		dex		bpl	restore_dp		ldx	#19			;restore the volume name buffersrestore_def_vol		lda	def_vol_name,x		sta	volume_name,x		dex		bpl	restore_def_volsave_rest_exit		pla		plx		ply		plp		rts		ENDP		Eject;======================================================================;Create:        This file will create a new fresh file on disk.;;Input:         A = undefined;               X = (call number * 2);               Y = (class number * 2);               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set (exit via system exit routine);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               Device Dispatcher       (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes);               find_file               (subroutine);;Call Format:;;Class 0        Pathname Pointer        (4 Bytes);               Access                  (2 Bytes);               File Type               (2 Bytes);               Aux Type                (4 Bytes);               Storgae_type            (2 Bytes);               Create Date/Time        (4 Bytes: ProDOS Format);;Class 1        PCount                  (2 Bytes);               Pathname Pointer        (4 Bytes);               Access                  (2 Bytes: E3 if not supplied);               File Type               (2 Bytes: 00 if not supplied);               Aux Type                (4 Bytes: 00 if not supplied);               Storage Type            (2 Bytes: 01 if not supplied);               Size Data Fork          (4 Bytes: 00 if not supplied);               Size Resource Fork      (4 Bytes: 00 if not supplied);		longa	on		longi	oncreate		PROC	Export		with	expand_record,my_dp	if read_only_fst then; Process the pathname to ensure that it's our disk that they're trying to; create the file on.  If the pathname processing succeeds, simply return; a write-protect error.		jsr	setup_params		lda	#no_root+no_dup		;root level or duplicate is not valid.		sta	search_flag		jsr	process_path		bcc	@write_protected		cmp	#file_not_found		;was it the expected file_not_found error?		bne	@other_error		;no, was some other error, return it@write_protected		lda	#drvr_wr_prot		;Get error code.		sec@other_error		brl	main_exit	else;Setup the defaults for the create call.		stz	data_eof		stz	data_eof+2		stz	res_eof		stz	res_eof+2		jsr	setup_params		php		jsr	do_create_path		jsr	default_entry		;Build a Entry with All defaults!		plp		bne	class1			;this is a new wonder version		lda	#$0005			;set PCount for common setup		sta	pcount		jsr	create_common		ldy	#pblk_01_old_time		lda	[my_pblk_ptr],y		;load the old format time		tax		iny		iny		lda	[my_pblk_ptr],y		bne	users_date		;user has supplied the data		txy		beq	both_classes		;us the GS system clock for the timeusers_date		and	#$1F3F			;force the date to correct format.		beq	clock_time		;use the GS clock time please		sta	one_entry+create_index+2clock_time		txa				;is the date field set?		beq	both_classes		;use GS clock Date		stx	one_entry+create_index		bra	both_classesclass1		jsr	create_commonboth_classes		bit	expand_flag		;are we expanding a current file?		bpl	@no_expansion		lda	one_entry+last_mod_index		pha		lda	one_entry+last_mod_index+2		pha		lda	storage_type		pha		lda	one_entry		pha		jsr	move_dir_entry		;copy the entry from the disk		pla		sta	one_entry		pla		sta	storage_type		pla		sta	one_entry+last_mod_index+2		pla		sta	one_entry+last_mod_index@no_expansion		jsr	eof_to_blks		;convert bytes to blocks;;Blocks needed := Data_fork_blks + Res_fork_blks + subdir_blks + storage;chk_dir		lda	#$0000			;assume zero		bit	expand_file		;are we adding a directory entry?		bmi	no_extend		ldx	free_dir_blk		;is there room for a dir entry?		bne	no_extend		;yes, so don't bump blks needed		inc	a			;add one for directory block neededno_extend		clc		adc	blks_used1		;blocks for data fork		clc		adc	blks_used2		;blocks for resource fork		sta	blocks_needed		;save total blocks needed for file		bcs	@no_room		lda	storage_type		;if the file is an extended file then add		cmp	#resource_type		;one block for the extended file header		bne	@not_extended		inc	blocks_needed		;bump the blocks needed@not_extended		jsr	calc_free_blks		;see if we have enough room for the file		bcs	to_exit		bit	expand_flag		;are we expanding a current file?		bpl	@chk_sum		;no, so check the sum of the blocks needed;;We now know that we are extending a file, so we must check the blocks free against the;number of blocks needed to add the resource fork.  The blocks needed for the resource;fork is equal to blks_used2 + 1 (for resource header blk).  To compensate for the extra;block needed, we will reduce the number of free blocks by 1, then compare against;blks_used2 (blocks needed for resource fork).;But first, we need to check if the number of free blocks is 0!!  CAE 11-6-90;		cmp	#0			;is free blocks = 0?		beq	@no_room		;yes - so can't extend the file		dec	a			;free blocks := free blocks -1; (compensate for header)		cmp	blks_used2		bcs	it_fits		bra	@no_room		;sorry you cannot extend the file.@chk_sum		cmp	blocks_needed		;do we have enough?		bcs	it_fits			;yes we do.@no_room		lda	#volume_full		;no room on volumeto_exit		sec		brl	main_exitit_fits		jsr	build_file		;go and make the file		bcs	create_err		jsr	force_bitmap		;make sure the bitmap is up to date		bcs	create_err		jsr	slug_ripple		;time stamp previouscreate_err		brl	main_exit;===============END OF THE CREATE CALL;==========================================================================;Build_file     This routine will allocate all needed blocks and build;               the file.  It will also handle directory extending etc.;;input:         free_dir_blk            ;dir blk with a empty entry.;               dir_start_blk           ;starting block of the directory;               dir_last_blk            ;last block of the directory;               used_blks1              ;blocks needed for data fork;               used_blks2              ;blocks needed for resource fork;               stoarge_type            ;type of file to be created;               data_storage            ;storage type of data fork;               res_storage             ;storage type of resource fork;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               Device Dispatcher       (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes)build_file		jsr	extend_subdir		;extend the directory IF needed.		bcc	chk_storage		rtschk_storage		lda	storage_type		;see what we are creating		cmp	#subdir_type		bne	chk_next1		jsr	create_subdir		;make a subdirectory		bcs	build_failed		bra	write_dir_entrychk_next1		cmp	#tree_type		bne	chk_next3		jsr	create_tree		;make a tree file		bcs	build_failed		bra	write_dir_entrychk_next3		cmp	#sapling_type		bne	do_seedling		jsr	create_sapling		;make a sapling file		bcs	build_failed		bra	write_dir_entrybuild_failed		rtsdo_seedling	jsr	create_seedling		bcs	build_failedwrite_dir_entry		jsr	set_default_buf		;get ready to write the dir entry.		jsr	standard_req		lda	free_dir_blk		;where to store dir entry		sta	drvr_blk_num		jsr	read_with_cache		;read in the directory block		bcs	build_failed		;this is real bad news! bitmap killed.		lda	dir_start_blk		sta	one_entry+header_ptr_index;;now lets save the case state of the file please;		lda	case_bits		;case bits for this file		beq	@its_all_upper		bit	fst_attr		;If the user has set all upper then skip case code		bmi	@its_all_upper		ora	#$8000			;set the case active bit.		sta	case_bits		sta	one_entry+version_index@its_all_upper		ldx	#$0001		ldy	free_dir_offset		lda	one_entry		sta	[gbuf_ptr],y		inymove_it		lda	one_entry,x		;move in the directory entry.		sta	[gbuf_ptr],y		iny		iny		inx		inx		cpx	#entry_length		bcc	move_it		lda	drvr_blk_num		;is this 'dir_start_blk'		cmp	dir_start_blk		;If yes then do not write twice		beq	write_once		jsr	write_with_cache		bcs	build_failed		;sorry, your disk is bad now		bit	expand_flag		;are we expanding the file?		bmi	chk_pcount		;dont change the number of files in the directory		lda	dir_start_blk		;now update file count		sta	drvr_blk_num		jsr	read_with_cache		bcs	build_failedwrite_once		bit	expand_flag		;are we expanding the file? minus = yes		bmi	dont_update_vcr		;dont change the number of files in the directory		ldy	#header_file_cnt		lda	[gbuf_ptr],y		;load current file count		inc	a			;bump it by one		sta	[gbuf_ptr],y		lda	drvr_blk_num		;see if this is the volume header		cmp	#vol_dir_start		bne	dont_update_vcr		ldy	#msdos_vcr.file_count		lda	[msdos_vcr_ptr],y		inc	a			;bump file count in vcr also		sta	[msdos_vcr_ptr],ydont_update_vcr		jsr	write_with_cache		bcs	no_store_typechk_pcount	lda	pcount		cmp	#$0005			;can we return the storage type		bcs	do_store		rtsdo_store		ldy	#pblk_01_stype		;set the user's storage type		lda	storage_type		lsr	a		lsr	a		lsr	a		lsr	a		sta	[my_pblk_ptr],y		clcno_store_type		rts				;exit with error / no error;==========================================================================;create_seed..  This routine will create a seedling file on disk.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = error code if carry set (exit via system exit routine);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               one_entry               ;ready to be written to disk;;Uses:          All registers;               Device Dispatcher       (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes)create_seedling		lda	#$0001			;allocate one block please		sta	one_entry+blks_used_index;                                       ;setup in default entry		ldx	#$0000			;start from the beginning.		jsr	find_free_blks		;go and get it		bcs	end_seed		;sorry.		stx	one_entry+key_blk_index		stx	drvr_blk_num		jsr	set_default_buf		jsr	standard_req		;write 512 bytes please		jsr	clear_gbuf_low		;we must write zeros for seedling		jsr	write_with_cacheend_seed	rts;==========================================================================;create_sapl..  This routine will create a sapling file one disk.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = error code if carry set (exit via system exit routine);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               one_entry               ;ready to be written to disk;;Uses:          All registers;               Device Dispatcher       (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes)create_sapling		jsr	setup_index_ptr		;setup pointer for add index		jsr	clear_gbuf_high		;clear high 512 bytes of general buffer		lda	one_entry		;adjust the storage type		and	#$FF0F			;clear old stoarge type		ora	#sapling_type		sta	one_entry		lda	blks_used1		;number of blocks needed for file		sta	one_entry+blks_used_index		ldx	#$0000			;start from the beginning		jsr	find_free_blks		;see if I have enough room?		bcs	end_sapling		stx	one_entry+key_blk_index		inx		stx	math_temp		cmp	blks_used1		;did we get all the blocks needed?		beq	big_sapling		stz	first_free		;start from the beginning		ldy	#$0000			;starting index		ldx	blks_used1		dex				;blocks to allocatesapling_loop		jsr	get_one_blk		;allocate another block		bcs	end_sapling		;major problems		lda	first_free		;block number		jsr	add_index		iny		dex		beq	write_sap_index		bra	sapling_loopend_sapling		rtsbig_sapling		ldy	#$0000			;starting index value		ldx	blks_used1		;number of blocks allocated		dex				;minus one for index blockbuild_loop		lda	math_temp		;block number		jsr	add_index		;add block to the index		iny				;move to the next index		dex		beq	write_sap_index		;write the block to disk		inc	math_temp		;bump to the next block please		bra	build_loopwrite_sap_index		lda	temp4_ptr		;pointer to index block		sta	drvr_buf_ptr		lda	temp4_ptr+2		sta	drvr_buf_ptr+2		jsr	standard_req		;512 byte transfer		lda	one_entry+key_blk_index		sta	drvr_blk_num		;write the index		jsr	write_with_cache		rts;==========================================================================;create_tree..  This routine will create a tree file on disk.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = error code if carry set (exit via system exit routine);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               one_entry               ;ready to be written to disk;;Uses:          All registers;               Device Dispatcher       (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes)create_tree		sec				;allocate a 512 byte buffer please		lda	#blk_size		jsl	alloc_seg		bcs	end_tree		;sorry out of memory!!		stx	virtual		sty	virtual+2		;save the VP for release seg		jsl	deref			;convert to a real pointer		stx	temp2_ptr		sty	temp2_ptr+2		;save a pointer to buffer		lda	#$0001			;allocate one block for master index		ldx	#$0000			;start from the beginning		jsr	find_free_blks		bcs	end_tree		stx	tree_key_blk		;save key block of tree file.		lda	blks_used1		sta	key_block		;save total blocks please		sec		lda	blks_used1		;remove overhead blocks from count		sbc	data_indexes		;number of index blocks needed		dec	a			;subtract one for master index block		sta	tree_blks		ldy	#$0000			;starting index for master blocktree_loop		ldx	#256			;number of blocks to allocate		lda	tree_blks		cmp	#256			;max blocks+1 in an index block		bcs	use_max		tax				;use the remaining blocksuse_max		inx				;add one for index block itself		stx	blks_used1		;this is the amount to allocate		phy		jsr	create_sapling		;build a sapling index		ply		bcs	end_tree		;major problems		jsr	add_master_index		iny				;advance to next index please		sec		lda	tree_blks		;number of blocks left		sbc	#256		sta	tree_blks		beq	write_tree		bcs	tree_loop		;do another index blockwrite_tree		lda	one_entry		and	#$FF0F			;change storage to tree type		ora	#tree_type		sta	one_entry		lda	key_block		sta	one_entry+blks_used_index		lda	temp2_ptr		;setup pointer for write		sta	drvr_buf_ptr		lda	temp2_ptr+2		sta	drvr_buf_ptr+2		lda	tree_key_blk		sta	drvr_blk_num		sta	one_entry+key_blk_index		jsr	write_with_cacheend_tree		php				;save error flag		pha				;save error if any		ldx	virtual		ldy	virtual+2		jsl	release_seg		;give up the temp buffer		pla		plp		rts				;return any erroradd_master_index		lda	temp2_ptr		;setup pointer to master index block		sta	temp4_ptr		lda	temp2_ptr+2		sta	temp4_ptr+2		lda	one_entry+key_blk_index		jsr	add_index		rts;==========================================================================;create_subdir  This routine will create a new subdirectory on disk;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = error code if carry set (exit via system exit routine);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               one_entry               ;ready to be written to disk;;Uses:          All registers;               Device Dispatcher       (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes);create_subdir		jsr	setup_index_ptr		;setup temp4_ptr to point to gbuf+$200		jsr	clear_gbuf_high		;clear high 512 bytes of general buffer		lda	#$000F			;force file type to subdirectory		sta	one_entry+file_type_index		lda	blks_used1		;number of blocks needed for subdir.		sta	one_entry+blks_used_index		tax		asl	a			;convert blocks to EOF		sta	one_entry+eof_index+1		txa		ldx	#$0000			;start from the beginning		jsr	find_free_blks		;see if I have enough room?		bcs	end_subdir		;major problem my friend		stx	one_entry+key_blk_index		stx	parent_blk		inx		stx	math_temp		pha				;save number of blocks allocated		jsr	make_sub_header		;build the header block to disk		pla		cmp	blks_used1		;did we get all the blocks needed?		beq	seq_subdir		;yes we can make the directory seq		dec	blks_used1non_seq_loop		lda	#$0001			;allocate one block		ldx	#$0000			;start from the beginning		jsr	find_free_blks		bcs	end_subdir		stx	math_temp		;the new block.		txa		ldx	parent_blk		;block that needs to be written		jsr	update_forward		bcs	end_subdir		lda	one_entry+key_blk_index		cmp	parent_blk		bne	no_clr		jsr	clear_gbuf_high		;clear high 512 bytes of general bufferno_clr		lda	parent_blk		;update backward link please		sta	[temp4_ptr]		lda	math_temp		;this is the new block to write		sta	parent_blk		dec	blks_used1		;see if we are done		bne	non_seq_loop		lda	#$0000		ldx	math_temp		jsr	update_forward		bcc	end_subdir		rtsgood_subdir		clcend_subdir		php				;save error flag		pha		lda	one_entry		and	#$FF0F			;change storage to subdirectory		ora	#subdir_type		sta	one_entry		pla				;restore possible error code		plp				;restore error flag		rtsseq_subdir		lda	#$0000			;default forward link		ldy	blks_used1		dey				;is there another block?		beq	last_dir_blk		lda	math_temp		;forward linklast_dir_blk		ldx	one_entry+key_blk_index	;block to write to disk		jsr	update_forward		;write the block to disk		bcs	end_subdir		;bad news		jsr	clear_gbuf_high		;clear high 512 bytes of general bufferseq_sub_loop		dec	blks_used1		;see if we are done		beq	good_subdir		lda	drvr_blk_num		;this is the backward link now		sta	[temp4_ptr]		lda	#$0000		ldy	blks_used1		;is there more blocks to write?		dey		beq	write_last		;no this is the last one		lda	math_temp		inc	a			;make a forward linkwrite_last		ldx	math_temp		;block number to write		inc	math_temp		;bump to the next block		jsr	update_forward		bcc	seq_sub_loop		bra	end_subdir;==========================================================================;update_forward This routine will update the forward link of a directory;               block then write the block to disk.;;input:         A = forward link;               X = block number to write;;output:        A = error code if carry set;update_forward		ldy	#$0002			;forward link		sta	[temp4_ptr],y		stx	drvr_blk_num		;save block number to write		lda	temp4_ptr		;setup pointer to block.		sta	drvr_buf_ptr		lda	temp4_ptr+2		sta	drvr_buf_ptr+2		jsr	write_with_cache		rts				;update the disk!;==========================================================================;This routine will create the header block for the subdirectory.;;input:         X = header block +1;               temp4_ptr = pointer to work buffermake_sub_header		dex				;block number to write		stx	drvr_blk_num		clc		lda	temp4_ptr		sta	drvr_buf_ptr		adc	#$0004		sta	temp_ptr		lda	temp4_ptr+2		;setup pointer for the write		sta	drvr_buf_ptr+2		adc	#$0000		sta	temp_ptr+2		;setup pointer to header		ldy	#entry_length-1move_header		lda	one_entry,y		sta	[temp_ptr],y		dey		dey		bpl	move_header		;move the header into first block		ldy	#access_index		lda	[temp_ptr],y		and	#$FF00		ora	#$00C3		sta	[temp_ptr],y		lda	[temp_ptr]		and	#$FF0F		ora	#subdir_header		sta	[temp_ptr]		ldy	#$001F			;index to entry len and entries per blk		lda	#$0D27			;13 entries per blk and 39 byte entries		sta	[temp_ptr],y		iny		iny				;point to file count		lda	#$0000		sta	[temp_ptr],y		;no files yet		iny		iny		lda	free_dir_blk		;parent pointer		sta	[temp_ptr],y		iny		iny		jsr	make_entry_num		bcc	go_on_please		brl	main_exitgo_on_please		sta	[temp_ptr],y		ldy	#$0010			;clear reserved area		lda	#$0000clear_reserved		sta	[temp_ptr],y		iny		iny		cpy	#$0018		bcc	clear_reserved		ldy	#$0010			;setup for no 'HUSTON'		lda	#$0076		sta	[temp_ptr],y		rts		entry	make_entry_nummake_entry_num		ldx	#(12*2)			;index into offset table		lda	free_dir_offsetoffset_loop	cmp	dir_offset_tbl,x		beq	found_offset		dex		dex		bpl	offset_loop		lda	#dir_error		sec		rtsfound_offset		txa		lsr	a			;divide by two		inc	a			;add one to convert from zero based.		ora	#$2700			;add in parent entry length		clc		rts;==========================================================================;setup_index... This routine will setup temp4_ptr to point to the second;               half of the general work buffer supplied by GS/OS.;==========================================================================setup_index_ptr		clc		lda	gbuf_ptr		;set temp4_ptr to point to second		adc	#$0200			;have of the general work buffer.		sta	temp4_ptr		lda	gbuf_ptr+2		adc	#$0000		sta	temp4_ptr+2		rts;==========================================================================;get_one_blk    This routine will allocate one block from disk;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               gbuf_ptr;;Output:        A = restored  or error code if carry set.;               X = restored;               Y = restored;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;               first_free              ;block number allocated;;Uses:          find_free_blks;;==========================================================================get_one_blk		pha		phx		phy		lda	#$0001			;allocate one block		ldx	first_free		;start at the beginning		jsr	find_free_blks		bcs	exit_with_err		stx	first_free		bra	exit_one_blkexit_with_err		sta	5,s			;store the error code on the stack!exit_one_blk		ply		plx		pla		rts;==========================================================================;add_index      This routine will add in a block to an index buffer.;;Input:         A = block number;               X = undefined;               Y = index into buffer;               P = nvmxdizc;                   ..000...;               b = k;;               temp4_ptr;;Output:        A = restored;               X = restored;               Y = restored;               P = nvmxdizc;                   ..000...;               b = k;;;Uses:          temp4_ptr;;==========================================================================		Entry	add_indexadd_index		phx		phy		pha		tya		ora	#$0100			;index to second half of buffer		tax		lda	1,s		longa	off		sep	#$20		sta	[temp4_ptr],y		;store the low byte please		txy				;index to second half of buffer		xba				;high word of the block number		sta	[temp4_ptr],y		longa	on		rep	#$20		pla				;restore A		ply				;restore Y		plx				;restore X		rts				;exit;==========================================================================;eof_to_blks    This routine will convert the size of the file into the;               number of blocks needed to store the file on disk.  The;               routine does NOT account for directory extension that is;               handled elsewhere,  it does however account for storage;               type.;;Input:         data_eof                ;size of data fork;               res_eof                 ;size of resource fork;;output:        blks_used1              ;blocks needed for data fork/subdir;               blks_used2              ;blocks needed for resource fork;;==========================================================================		Entry	eof_to_blkseof_to_blks		lda	expand_file		;are we expanding a file or building a new one?		bpl	@its_new		lda	expand_blks_used		sta	blks_used1		;set the number of blocks needed for current file		bra	do_res			;now do the resource fork@its_new		lda	data_eof+1		;convert bytes to blocks		lsr	a		sta	blks_used1		;blocks needed by data fork		beq	bump_blks1		;see if we need to round up		lda	data_eof		;see if size is < 512		and	#$01FF		beq	do_res			;no need to bumpbump_blks1		inc	blks_used1do_res		lda	storage_type		;do we need resources?		cmp	#resource_type		bne	end_eof_conv		;not a resource file		lda	res_eof+1		;convert bytes to blocks		lsr	a		sta	blks_used2		;blocks needed by data fork		beq	bump_blks2		;see if we need to round up		lda	res_eof			;see if size is < 512		and	#$01FF		beq	end_eof_conv		;no need to bump resource sizebump_blks2		inc	blks_used2		;add for resource fileend_eof_conv		lda	expand_file		;are we expanding a file or building a new one?		bmi	@skip_adjust		;since the blocks used is already the total skip adjust		lda	blks_used1		;add any storage overhead for data fork		jsr	adjust_storage		sta	blks_used1		sty	data_storage		;storage type for data fork		stx	data_indexes		;number of index blocks@skip_adjust		lda	blks_used2		;add any storage overhead for res. fork		jsr	adjust_storage		sta	blks_used2		sty	res_storage		;storage type for resource fork		stx	res_indexes		;number if inedx blocks		rts;==========================================================================;do_create_path This routine will setup the flags needed to process the;               input pathname. we only return from the subroutine if;               everything with the pathname is OK.;;input:         none;;output:        seach_name is still valid from find file.;;==========================================================================do_create_path		lda	#no_root+no_dup		;root level or duplciate is not valid.		sta	search_flag		jsr	process_path		bcs	no_dup_problem		;there is no duplicate file;;If the file already is on the disk we need to see if we are adding the resource;fork.  If we are adding the resource fork we will pull out the important information;from the current file entry (data fork) and save if so we can use it to build the;data fork of are new extended file;		ldy	#pblk_01_stype		;see if we are adding a resource fork to the file		lda	[my_pblk_ptr],y		;get the input storage type		cmp	#(resource_type/$10)+$8000		bne	@not_an_extend		sta	expand_file		;set the flag indicating we are extending the file		sta	expand_flag		;expand_flag lives thru the entire call, whereas expand_file						;only lives thru the create data fork portion of the call.;;now lets setup the important information:;       storage type;       key block;       blks_used;       eof;;Remember drvr_buf_ptr points to the MSDOS directory entry;		lda	[drvr_buf_ptr]		;get the storage type please		and	#$00F0			;clear the garbage		cmp	#resource_type		;see if the resource fork is already here.		beq	@no_extend		cmp	#tree_type+1		;file must be a seedling sapling or tree		bcs	@storage_err		;we cannot extend this file		sta	expand_storage		sta	data_storage		;this will be a 10,20 or 30 (seedling, sapling or tree)		ldy	#key_blk_index		lda	[drvr_buf_ptr],y		sta	expand_key_blk		;save the key block for the data fork		ldy	#blks_used_index		lda	[drvr_buf_ptr],y		sta	expand_blks_used		ldy	#eof_index		lda	[drvr_buf_ptr],y		sta	expand_eof		iny		lda	[drvr_buf_ptr],y		sta	expand_eof+1		bra	no_dup_problem@no_extend		lda	#resource_exist		;the resource already exist bud.		sec		bra	real_problem@storage_err		lda	#res_add_err		;the resource cannot be added to this type file		sec		bra	real_problem@not_an_extend		sec		lda	#dup_pathnamereal_problem		sec		brl	main_exitno_dup_problem		bit	path_searched		;was the entire path searched?		bpl	real_problem		;no, only a portion.		jsr	chk_disk_protect	;is the volume write protected?		rts				;If protected, routine will not return;==========================================================================;adjust_storage This routine will add in the overhead of the storage type;               to the blocks used for a file.;;input:         A = blocks;;output:        A = blocks + overhead;               Y = storage type needed for size;               X = number of index blocks needed (for tree only);;uses:          math_temp;;Overhead:;               subdirectories:         no overhead;               seedling:               no overhead;               sapling:                1 block of overhead;               tree:                   ((blks div 256) + (blks mod 256)) + 1;==========================================================================adjust_storage		sta	math_temp		;number of file blocks		stz	index_blks		;no tree index blocks. (default)		ldy	#subdir_type		ldx	storage_type		cpx	#subdir_type		beq	end_overhead		;no overhead for directories		ldy	#seedling_type		;this is a seedling type		cmp	#$0002		bcc	end_overhead		;no overhead		cmp	#$0101			;check high end of sapling		bcs	data_tree		;this is a tree file		inc	math_temp		;add one for sapling overhead		ldy	#sapling_type		bra	end_overheaddata_tree		lda	math_temp+1		;see how many sapling blocks we need		and	#$00FF		sta	index_blks		;number of index blocks needed		clc		adc	math_temp		tax		lda	math_temp		and	#$00FF		beq	no_extra		inc	index_blks		;add one to number of indexes needed		inx		stx	math_temp		;adjust for $xx01 thru $xxFFno_extra		inx		stx	math_temp		;add extra block for tree header.		ldy	#tree_typeend_overhead		lda	math_temp		ldx	index_blks		;index blocks for the tree file.		rts;==========================================================================;Default_entry: This routine will fill 'one_entry' with the default;values for a file.;;               storage type            = seedling;               File Type               = unknown ($00);               Blks Used               = $0001;               EOF                     = $000000;               Version                 = $05;               Minimum Version         = $00;               access                  = $E3;               create date/time        = Current Time;               mod date/time           = Current Time;               aux type                = $0000;;NOTE: The store operations happen in a certain order so as to not overwrite;      information already stored.;==========================================================================default_entry		ldy	#$0026			;zero the entry		lda	#$0000clr_name		sta	one_entry,y		dey		dey		bpl	clr_name		lda	#seedling_type		;set the default storage type		sta	storage_type		stz	one_entry+file_type_index		lda	#$0001		sta	one_entry+blks_used_index		stz	one_entry+eof_index		stz	one_entry+eof_index+1		jsr	pack_time		;read the GS Clock and set the current time		stx	one_entry+create_index		sty	one_entry+create_index+2		stx	one_entry+last_mod_index		sty	one_entry+last_mod_index+2		lda	#prodos_version		sta	one_entry+version_index		lda	#$00E3		sta	one_entry+access_index		stz	one_entry+aux_type_index		rts;==========================================================================;Create_Common: This routine will setup and verify parameters supplied;               by the caller. It will also move the file name into;               one_entry.;;input:         my_pblk_ptr             ;must point to pathname field;;output:        returns to caller or jmps to sys_exit with error;; Access Byte:;                _______________________________;               |   |   |   |   |   |   |   |   |;               | 1 | 1 | 1 |   |   | 1 | 1 | 1 |;               |___|___|___|___|___|___|___|___|;                ^    ^   ^           ^   ^   ^;                |    |   |           |   |   |;                |    |   |  Invisible    |    Read-Enabled;                |    |   |                Write-Enabled;                |    |    Backup-Enabled;                |     Rename-Enabled;                 Destroy-Enabled;;==========================================================================create_common		ldy	search_length		;length of name to create		longa	off		sep	#$20name_loop	lda	search_name-1,y		;move name to directory entry		sta	one_entry,y		dey		bne	name_loop		lda	search_length		ora	storage_type		;add in the storage type		sta	one_entry		;store storage/length byte		longa	on		rep	#$20		lda	pcount			;see if we are done		dec	a		bne	cont01		rtscont01		sta	math_temp		ldy	#pblk_01_accs		;check the access		lda	[my_pblk_ptr],y		tax				;save access so we can verify range		and	#$FF18			;Destroy,Rename,Backup,Invisible,Write,Read		beq	good_access		;no problemnot_in_range		sec		lda	#parm_range_err		brl	main_exit		;no return from heregood_access					;WARNING zero is stored in half of aux.		txa		ora	#backup_enabled		;force the backup bit please.		sta	one_entry+access_index		dec	math_temp		;see if any more fields?		beq	to_end_common		ldy	#pblk_01_ftype		;get the user's file type		lda	[my_pblk_ptr],y		xba		bne	not_in_range		xba				;put file type in low byte please		sep	#$20			;08 bit accum		sta	one_entry+file_type_index		rep	#$20			;16 bit accum		cmp	#dir_file_type		;set storage to SubDir incase PCount = 4		bne	skip_storage		;do not setup the storage type		lda	#subdir_type		sta	storage_typeskip_storage		dec	math_temp		;are we done?		beq	end_common		ldy	#pblk_01_aux+2		;get the user's aux type		lda	[my_pblk_ptr],y		bne	not_in_range		;sorry bud		dey		dey		lda	[my_pblk_ptr],y		sta	one_entry+aux_type_index		dec	math_temp		;are we done?to_end_common		beq	end_common		;yes		ldy	#pblk_01_stype		;get the user's storage type		lda	[my_pblk_ptr],y		and	#$7FFF			;clear the expand file bit please		beq	standard_file		;seedling is the default		xba		bne	not_in_range		;parameter not valid		xba		cmp	#(tree_type/$10)+1		bcc	standard_file		;seedling is the default		cmp	#(resource_type/$10)		beq	force_resource		cmp	#(subdir_type/$10)		bne	not_in_range		lda	#subdir_type		sta	storage_type		;we are making a directory		bra	next_parmforce_resource		lda	#resource_type		sta	storage_type		bra	next_parmstandard_file		lda	#seedling_type		sta	storage_typenext_parm		lda	storage_type		;if storage is subdirectory then force filetype		cmp	#subdir_type		bne	@not_subdir		lda	#dir_file_type		;set file type to subdirectory		sep	#$20		sta	one_entry+file_type_index		rep	#$20			;16 bit accum@not_subdir		dec	math_temp		;are we done?		beq	end_common		ldy	#pblk_01_eof1+2		;data fork EOF		jsr	create_eof		stx	data_eof		sty	data_eof+2		dec	math_temp		;is there a resource eof.		beq	end_common		lda	storage_type		;is this a resource file?		cmp	#resource_type		bne	end_common		;don't bother checking		ldy	#pblk_01_eof2+2		jsr	create_eof		stx	res_eof		sty	res_eof+2end_common		rts;==========================================================================;Create_Eof:    This routine returns the EOF supplied by the user;;Input:         my_pblk_ptr             (must be setup);               Y register              (index into parameter block);;Output:        X register = low word of EOF;               Y register = high word of EOF;               storage_type adjusted for correct eof;;==========================================================================create_eof		lda	[my_pblk_ptr],y		xba		bne	not1_in_range		;I cannot make a file this large		xba		pha		dey		dey		lda	[my_pblk_ptr],y		;get the low word		tax				;save low word of eof		ply				;save high word of eof		lda	storage_type		;adjust storage type as needed		cmp	#resource_type		beq	end_create_eof		cmp	#subdir_type		beq	entry_to_bytes		tya				;see what type of file is needed		lsr	a		beq	not_tree		;this cannot be a tree file		cmp	#$0002			;still might be a sapling		bcs	is_tree		txa				;if low word is zero then its a sapl.		beq	make_sapis_tree		lda	#tree_type		sta	storage_type		rtsnot_tree		tya				;See if EOF greater then 512		bne	make_sap		;This file must be a sapling file!		txa		cmp	#$0201			;is the eof < 512		bcc	make_seedlingmake_sap		lda	#sapling_type		sta	storage_type		rtsmake_seedling		lda	#seedling_type		sta	storage_typeend_create_eof		rts				;exit to callernot1_in_range		sec		lda	#parm_range_err		brl	main_exitentry_to_bytes					; ;convert file entries to bytes		tya				;check high byte of entries wanted		bne	not1_in_range		cpx	#1664			;no more then 1663 entries for subdirs.		bcs	not1_in_range		txa				;convert entries to bytes		pha;; Convert number of entries to bytes needed.;; Bytes := ((entries * 3) * 13 + ((entries / 13) + 5));		clc		asl	a			;times 2		adc	1,s			;times 3		sta	1,s			;math_temp		asl	a			;times 2		asl	a			;times 4		adc	1,s			;times 5		adc	1,s			;times 6		asl	a			;times 12		adc	1,s			;times 13		adc	#13			;add 13 for the header field needed		pha				;save partialsub_loop		txa				;restore number if entries left		sec		sbc	#13			;subtract 13 entries		beq	sub_done		;we are done		bcc	sub_done		tax		clc		lda	1,s			;get the partial		adc	#$0005			;add in block overhead for each block		sta	1,s		bra	sub_loopsub_done	plx				;save bytes in X register		pla				;clean up stack		rts	endif		ENDP	if NOT read_only_fst then		Eject;==========================================================================;Destroy:       This routine will delete a file from the disk.;;Created:       may 28, 1987;Modified:      jun 04, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               find_file;;Call Format:;;Class 0        Pathname Pointer        (4 Bytes);;Class 1        PCount                  (2 Bytes);               Pathname Pointer        (4 Bytes);;==========================================================================		longa	on		longi	ondestroy		PROC	Export		with	my_dp;==========================================================================;Go and setup the defaul parameters for the call.;==========================================================================		jsr	setup_params;==========================================================================;Process the file name and locate it.;==========================================================================		jsr	process_path		jsr	chk_disk_protect;==========================================================================;Now that we have located the file we need to see if its OK to destroy it.;;We can delete any file except the volume header, or a file that is destroy;disabled.;==========================================================================		lda	[drvr_buf_ptr]		and	#$00F0		sta	math_temp		;save the storage type for later		cmp	#volume_header		bne	check_accesswrong_access		lda	#invalid_accessdestroy_error		secdestroy_exit		brl	main_exitcheck_access		jsr	move_dir_entry		ldy	#access_index		lda	[drvr_buf_ptr],y		and	#destroy_enabled		beq	wrong_access		;file is marked as 'destory disabled';==========================================================================;make sure the file that they are deleting is NOT open;==========================================================================		ldy	#key_blk_index		;see if the file is open		lda	[drvr_buf_ptr],y		sta	files_key_block		stz	fcr_wanted		;reset for searchlook_loop		jsr	get_next_fcr		bcs	not_open		ldy	#fcr.vol_id		lda	[my_fcr_ptr],y		;get the Volume ID so we can make sure the file is on		cmp	[my_vcr_ptr]		;the same volume.		bne	look_loop		;File is on another volume		ldy	#msdos_fcr.file_id		lda	[msdos_fcr_ptr],y	;see if this is the same file		cmp	files_key_block		bne	look_loop		lda	#file_busy		bra	destroy_error		;cannot delete an open filenot_open		ldy	files_key_block		lda	math_temp		;storage TYPE!!!		cmp	#subdir_type		bne	check_tree;==========================================================================;It's a directory so go ahead and try to delete it.  We can only delete;it if there are no files in the directory.  Y=key block of the file;==========================================================================		jsr	kill_dir		;Y=key block		bra	update_dircheck_tree		cmp	#tree_type		bne	check_sapling;==========================================================================;Go ahead and remove the tree file if you can.  Y=Key block of the file;==========================================================================		jsr	kill_tree		;Y=Key block of the file		bra	update_dir		;update the directory nowcheck_sapling		cmp	#sapling_type		bne	check_seedling;==========================================================================;it's a sapling file so remove it.  Y=key block of the file;==========================================================================		jsr	kill_sapling		bra	update_dircheck_seedling		cmp	#seedling_type		bne	check_res		;it better be a resource file;==========================================================================;This is a simple file to delete.  Y=data block that needs to be deleted;==========================================================================		jsr	kill_seedling		bra	update_dircheck_res		cmp	#resource_type		bne	wrong_type;==========================================================================;This is the hardest of the files to delete, since it is made up of many;files.  Y=key block of the file;==========================================================================		jsr	kill_resource		bra	update_dirwrong_type		lda	#bad_store_type		;I should NEVER get this error!		brl	destroy_errorupdate_dir		php		pha				;save the error code and flag		jsr	flush_bitmap		;write out any left over bitmap changes		bcs	piggy_back;==========================================================================;at this point we have removed all the blocks of the file.  We now need;to update the directory entry itself.  The following parameters better;be setup correctly or death and destruction will occur.;;               entries_blk_num         (block number of the entry to delete);               entry_offset            (offset to entry within the block);               dir_start_blk           (header block for this directory);;==========================================================================;==========================================================================;Setup the buffer pointer and device parameters;==========================================================================		jsr	set_default_buf;==========================================================================;We want to load in the block that contains the files entry.;==========================================================================		lda	entries_blk_num		sta	drvr_blk_num		jsr	read_with_cache		bcs	piggy_back;==========================================================================;We have loaded the block, now lets zap the entry to indicate that it's;dead.;==========================================================================		ldy	entry_offset		lda	[drvr_buf_ptr],y		and	#$FF00			;clear storage type and name length		sta	[drvr_buf_ptr],y;==========================================================================;before we write the block back to disk lets see if it is the key block;This way we save an extra write to disk;==========================================================================		lda	[drvr_buf_ptr]		;check the previous link		beq	update_header		;don't write block twice;==========================================================================;write the entries block back to disk.;==========================================================================		jsr	write_with_cache		bcc	fix_headerpiggy_back	brl	destroy_exit		;Major problems.fix_header;==========================================================================;Now lets go and update the header of this directory.;==========================================================================		lda	dir_start_blk		sta	drvr_blk_num		jsr	read_with_cache		bcs	piggy_backupdate_header		lda	[drvr_buf_ptr]		bne	dir_damaged		ldy	#$0023		lda	[drvr_buf_ptr],y		cmp	#$0D27		bne	dir_damaged		ldy	#header_file_cnt		lda	[drvr_buf_ptr],y		dec	a		bmi	dir_damaged		sta	[drvr_buf_ptr],y		ldx	drvr_blk_num		;see if this is the root directory		cpx	#vol_dir_start		bne	not_root		pha		jsr	setup_my_vcr		pla		ldy	#msdos_vcr.file_count	;update the file count in VCR also		sta	[msdos_vcr_ptr],y;==========================================================================;write the header block back to disk.;==========================================================================not_root		jsr	write_with_cache		bcs	piggy_back;==========================================================================;Now we need to ripple back.  This routine will time stamp all previous;subdirectory files with the current time.;==========================================================================do_ripple		jsr	slug_ripple		pla				;restore any error code		plp				;restore error flag from delete		bra	piggy_backdir_damaged		lda	#dir_error		brl	destroy_error;==========================================================================;==========================================================================;=====  END of MAIN CODE FOR DESTROY ======================================;==========================================================================;==========================================================================kill_dir;==========================================================================;This routine is called when we are deleting a directory.  Before we delete;the directory we must make sure that there are NO files in the directory.;;input:         Y = key block address of the directory;==========================================================================		sty	drvr_blk_num		jsr	standard_req		;read of 512 bytes		jsr	set_default_buf		;use GS/OS system work buffer		lda	drvr_buf_ptr		sta	temp_ptr		lda	drvr_buf_ptr+2		sta	temp_ptr+2		jsr	read_with_cache		bcs	dir_err_exit		lda	[drvr_buf_ptr]		;the previous link better be zero		bne	dir_damaged		ldy	#$0023			;verify that this is a directory		lda	[drvr_buf_ptr],y		cmp	#$0D27		bne	dir_damaged		ldy	#header_file_cnt		lda	[drvr_buf_ptr],y		beq	remove_dir		;it's ok to delete the directory		brl	wrong_accessremove_dir		lda	[drvr_buf_ptr]		beq	first_block		cmp	data_ptr		bne	dir_damagedfirst_block		ldx	drvr_blk_num		stx	data_ptrdir_loop		jsr	dealloc_block		;remove the block please		bcs	dir_err_exit		lda	temp_ptr		sta	drvr_buf_ptr		lda	temp_ptr+2		sta	drvr_buf_ptr+2;==========================================================================;Verify that the backward link is correct, and if it is then delete the blk;==========================================================================		ldy	#$0002			;walk the forward links		lda	[drvr_buf_ptr],y		sta	drvr_blk_num		beq	dir_done		;the forward link is nill so we are done		jsr	read_with_cache		bcc	remove_dirdir_err_exit		rtsdir_done		clc		rtskill_resource		sty	drvr_blk_num		sty	data_ptr		;save key block of the file		jsr	standard_req;==========================================================================;Allocate a one block buffer;==========================================================================		clc		lda	#blk_size		jsl	alloc_seg		;allocate a one block buffer		bcs	res_err_exit		stx	virtual		stx	displacement		sty	virtual+2		;save the virtual pointer please		sty	displacement+2		jsl	deref			;convert this to a real address		stx	drvr_buf_ptr		;save the address of the buffer		stx	temp2_ptr		sty	drvr_buf_ptr+2		sty	temp2_ptr+2		jsr	read_with_cache		;read in the resource header block		bcs	res_err_exit		lda	[temp2_ptr]		;get the storage type		and	#$00FF		tax				;save storage type		ldy	#$0001		lda	[temp2_ptr],y		beq	res_bad		tay				;key block of the resource		jsr	zap_branch		;delete the resource		bcs	res_err_exit		ldy	#$0100		lda	[temp2_ptr],y		;get the storage type		and	#$00FF		tax				;save storage type		iny		lda	[temp2_ptr],y		beq	res_bad		tay				;key block of the resource		jsr	zap_branch		;delete the resource		bcs	res_err_exitres_done		ldx	displacement		;release memory used by the call		ldy	displacement+2		jsl	release_seg		;release the one block of head space		ldy	data_ptr		brl	kill_seedling		;remove the last block now;==========================================================================res_bad		lda	#out_of_range		;resource block is screwed upres_err_exit		jsr	free_header_buf		sec		rts;===========================================================================;this routine will delete a resource branch.;X = storage type;Y = key block;output : carry clear = no error;zap_branch		dex		bne	not_seedling		jsr	kill_seedling		rtsnot_seedling		dex		bne	not_sapling		jsr	kill_sapling		rtsnot_sapling	dex		bne	@res_error		;file screwed up		jsr	kill_tree		rts@res_error		sec		rts;==========================================================================free_header_buf		pha				;save the error code		ldx	displacement		ldy	displacement+2		jsl	release_seg		;release the one block of head space		pla		rts;==========================================================================;The following code will delete a tree file.  It will also flip the index;block and write it back out to disk.;;input:         Y = key block of the file;;==========================================================================kill_tree		sty	drvr_blk_num		sty	master_ptr		clc		lda	gbuf_addr		adc	#blk_size		sta	drvr_buf_ptr		sta	temp3_ptr		lda	gbuf_addr+2		adc	#$0000		sta	drvr_buf_ptr+2		sta	temp3_ptr+2		jsr	standard_req		jsr	read_with_cache		bcs	master_error		lda	#$0100			;start at the last entry		phamaster_loop		lda	temp3_ptr		;restore pointer to I/O buffer		sta	temp_ptr		lda	temp3_ptr+2		sta	temp_ptr+2inner_master		pla				;get the current index		dec	a		bmi	master_done		pha		tax		ora	#$0100		tay		jsr	get_and_flip		;get and flip the index block number		tay		beq	inner_master		jsr	kill_sapling		bcs	master_pop		bra	master_loopmaster_done		ldx	temp_ptr		ldy	temp_ptr+2		lda	master_ptr		jsr	write_flipped		;write master index block flipped		bcs	master_error		ldy	master_ptr		bra	kill_seedlingmaster_error		rtsmaster_pop		pla		sec		rts;==========================================================================;The following code will delete a sapling file.  It will also flip the index;block and write it back out to disk.;;input:         Y = key block of the file;;==========================================================================kill_sapling;==========================================================================;Now we need to read in the index block and deallocate all allocated blocks;==========================================================================		sty	drvr_blk_num		sty	index_ptr		;save for later delete		jsr	set_default_buf		lda	drvr_buf_ptr		sta	temp_ptr		lda	drvr_buf_ptr+2		sta	temp_ptr+2		jsr	standard_req		jsr	read_with_cache		bcs	index_error		lda	#$0100			;start at the last entry		phaindex_loop		pla				;get the current index		dec	a		bmi	index_done		pha		tax		ora	#$0100		tay		jsr	get_and_flip		;get the block number from index buffer		tax		beq	index_loop		jsr	dealloc_block		;free the block up please		bcc	index_loop		plx		rtsindex_done		ldx	temp_ptr		ldy	temp_ptr+2		lda	index_ptr		jsr	write_flipped		bcc	kill_indexindex_error	rtskill_index		ldy	index_ptr		;now release the last block please;==========================================================================;This routine will free up a seedling files block.;;input:         Y = key block of the file.;;==========================================================================kill_seedling		tyx		jsr	dealloc_block		rts				;return error;==========================================================================;this routine will write a flipped index block to disk;;input:;               X = low word of buffer pointer;               Y = high word '''';               A = block number;;Output:;               A = error if carry set;;==========================================================================write_flipped		stx	drvr_buf_ptr		sty	drvr_buf_ptr+2		sta	drvr_blk_num		jsr	write_with_cache		rts;==========================================================================;This routine will flip the block number within an index block.;;input:;               X  =  Index into the lower half of the index block;               Y  =  Index into the higher half of the index block;        temp_ptr  =  pointer to the index block;;OutPut:;               A  =  Block number from index block;;==========================================================================get_and_flip		longa	off		sep	#$20		lda	[temp_ptr],y		;grab the high block number		xba				;put high block number in upper byte		phy				;save high byte index		txy		lda	[temp_ptr],y		;get the low block number		xba				;restore high block number		sta	[temp_ptr],y		;store high block number in low half		xba				;restore low block number		ply				;get high byte index		sta	[temp_ptr],y		;store low block number in high half		longa	on		rep	#$20		rts		ENDP	endif	if NOT read_only_fst then		Eject;======================================================================;Change_Path    This file will RENAME or MOVE a file to a new directory;;Created:       Nov 04, 1987;Modified:      Nov 04, 1987;Author:        Rob Turner;;Enter:         From GS/OS jmp table;;Input:         A = undefined;               X = (call number * 2);               Y = (class number * 2);               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set (exit via system exit routine);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               Device Dispatcher       (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes);               find_file               (subroutine);;Call Format:;;Class 0        Source Pathname Pointer (4 Bytes);               Destination Path Pointer(4 Bytes);;Class 1        PCount                  (2 Bytes);               Source Pathname Pointer (4 Bytes);               Destination Path Pointer(4 Bytes);		Flags			(2 Bytes);;======================================================================		longa	on		longi	onchange_path	PROC	Export		with	my_dp		jsr	setup_params		; If the source is only a device # then set cp_device_flag to 1. ; This is a special case so that the Finder can rename a volume whose current name ; is a duplicate of another volume which has open files.  1/22/91 CAE 		lda	<path_flag		;get pathname flags		and	#path1_mask		;is pathname 1 defined?		bne	@not_dev		;yes		lda	<dev_num		;do we have a device #?		beq	@not_dev		;no		inc	cp_device_flag		;yes - so indicate source was a device #; If pCount was 3 or more, get the cp_flags from the parameter block.  5-Dec-91 MSD		lda	pcount		cmp	#3			; did it include cp_flags?		blt	@not_dev		; no, so leave cp_flags set to 0.		ldy	#pblk_04_flags		lda	[my_pblk_ptr],y		; get flags from param block		sta	cp_flags; End 5-Dec-91 MSD@not_dev		jsr	process_path		;see if the source file exist also sets up priority bit						;and now checks the spans.		10/10/91 JEV				jsr	valid_change		bcs	end_change		lda	slug_block		;save for slug ripple routine		sta	src_slug_blk		lda	slug_offset		sta	src_slug_offset		jsr	chk_disk_protect		jsr	save_src_parms		jsr	move_dir_entry		;move entry into one_entry		jsr	chk_open		;see if the file is currently open		bcs	end_change		jsr	process_dest		;find the destination name		bcs	end_change		; Moved this code from valid change to here to make ProDOS conform to the way HFS; and AppleShare do a change path.  The check for a moving to a child of the original ; does not occur until after we check to see if the destination allready exsists.;			      					10/3/91 JEV		;; IF (path1 is a subset of path2) THEN;    Bad_path_syntax		;The following code has been changed to do a case-insensitive		;compare in order to fix a bug which was allowing illegal moves		;if the case of the pathnames was different.  1/22/91 CAE		jsr	setup_path1	;Path1_ptr --> temp_ptr		jsr	setup_path2	;Path2_ptr --> temp2_ptr				ldy	#$0000		;start scan at beginning		longa	off		sep	#$20		subset_loop			lda	[temp_ptr],y	;get source file char		cmp	[temp2_ptr],y	;get dest file char		bne	@no_match	;nope		iny			;adjust index		bra	subset_loop	;and loop@no_match		more_chk				; 		lda	[temp2_ptr],y	;this cannot be a 'delimiter'		cmp	#delimiter		longa	on		;go ahead and fix the mode		rep	#$20		bne	@not_subset		lda	[temp_ptr],y	;is this the end of the source?		and	#$00FF		bne	@not_subset	;not the end of source name		; 27-Jan-92 MSD: We let valid_change see if the source path is a subset of the; destination path (i.e. we're trying to move an item into its own child).  If; that was the case, cp_to_child will be non-zero		lda	cp_to_child	; were we moving into our own child?		beq	@not_subset	; no, so do the move				lda	#bad_path_syntax ; source path was a subset of destination path		sec		bra	end_change@not_subset		jsr	save_dest_parms		jsr	rename_or_moveend_change		pha				;save the error code		php		jsr	flush_bitmap		;make sure the bitmap is OK!		plp				;restore error flag		pla				;restore error code if any		brl	main_exit;======================================================================chk_open		stz	fcr_wanted		;start from the beginning		lda	one_entry+key_blk_index		sta	key_blockopen_loop		jsr	get_next_fcr		bcs	end_chk_open		ldy	#fcr.vol_id		lda	[my_fcr_ptr],y		;get the Volume ID so we can make sure the file is on		cmp	[my_vcr_ptr]		;the same volume.		bne	open_loop		;File is on another volume		ldy	#msdos_fcr.file_id		lda	[msdos_fcr_ptr],y		cmp	key_block		bne	open_loop		lda	#file_busy		sec		rtsend_chk_open					; ;the file is not open		clc		rts;======================================================================rename_or_move					; ;what will we do?		lda	src_dev_num		cmp	dest_dev_num		bne	bad_device		;cannot rename on different devices		lda	src_start_blk		cmp	dest_start_blk		;is the file in the same directory?		beq	do_rename		;this can only be a rename;;IF here we are doing a change_path;		jsr	move_file		;do a change_path please		rts;;IF here we are doing a simple rename;do_rename		jsr	rename_file		rtsbad_device		brl	bad_path;======================================================================move_file; First, we need to check the file/dir that we're moving to see if it's; 'rename enabled'.  If it isn't, then we need to make sure we're just; doing a move and not a 'move and rename'.; Added 3/15/91 CAE		jsr	standard_req		;read in 512 bytes		jsr	set_default_buf		lda	src_dev_num		sta	drvr_dev_num		lda	src_dir_blk		;block that contains the entry		sta	drvr_blk_num		jsr	read_with_cache		bcs	to_end_move_file		clc		lda	src_offset		adc	#access_index		tay		lda	[drvr_buf_ptr],y		and	#rename_enabled		;can we rename the file?		bne	@ok			;branch if rename is OK		ldy	src_offset		;rename is not allowed so		lda	[drvr_buf_ptr],y	;get file's name length		and	#$000f			;strip off storage nibble and hi byte		cmp	search_length		;same as dest name length?		beq	@cont			;yes - so compare the names@uh_oh		rep	#$20			;ensure 16 bit mode		sec		lda	#invalid_access		;report an error		rts@cont		tax				;calculate offset to end of dest name		dex				;and put in X		clc		adc	src_offset		;calculate offset to end of file's name		tay				;in the dir entry and put in Y		longa	off		sep	#$20			;begin 8 bit mode@loop		lda	[drvr_buf_ptr],y	;compare file's name		cmp	search_name,x		;to dest name		bne	@uh_oh			;branch if mis-match		dey		dex		bpl	@loop			;loop until done		longa	on		rep	#$20			;begin 16 bit mode@ok; End of new code.		ldx	free_dir_blk		;do we need to extend the directory?		bne	no_extend		jsr	calc_free_blks		;do we have a free block		bcs	to_end_move_file	;NO we have an error		tax		bne	not_full		brl	full_disknot_full		jsr	extend_subdir		;grow the subdirectory		bcs	end_move_file		lda	free_dir_offset		;offset to directory entry		sta	dest_offset		lda	free_dir_blk		;block that contains entry		sta	dest_dir_blkno_extend		jsr	standard_req		;512 bytes		jsr	set_default_buf		;use the temp buffer		lda	src_dir_blk		;move and delete the old entry		sta	drvr_blk_num		jsr	read_with_cache		bcs	end_move_file		jsr	delete_entry		;move entry and delete it		jsr	write_with_cacheto_end_move_file		bcs	end_move_file		lda	src_start_blk		sta	drvr_blk_num		jsr	read_with_cache		bcs	end_move_file		jsr	dec_file_cnt		jsr	write_with_cache		bcs	end_move_file		jsr	do_src_slug		lda	dest_start_blk		;new header pointer		sta	one_entry+header_ptr_index		lda	dest_dir_blk		;block		sta	drvr_blk_num		jsr	read_with_cache		bcs	end_move_file		jsr	move_old_entry		ldy	dest_offset		jsr	move_new_name		;rename the entry		jsr	write_with_cache		bcs	end_move_file		lda	dest_start_blk		;now update the file count		sta	drvr_blk_num		jsr	read_with_cache		bcs	end_move_file		jsr	inc_file_cnt		jsr	write_with_cache		bcs	end_move_file		jsr	do_dest_slug		lda	storage_type		and	#$00F0			;see if this is a subdirectory		cmp	#subdir_type		bne	move_done		jsr	fix_subdir		rtsmove_done		clcend_move_file		rtsfull_disk		lda	#volume_full		sec		rtsdo_src_slug		lda	src_slug_blk		sta	slug_block		lda	src_slug_offset		sta	slug_offset		bra	do_slugdo_dest_slug		lda	dest_slug_blk		sta	slug_block		lda	dest_slug_offset		sta	slug_offsetdo_slug		jsr	slug_ripple		rtsfix_subdir		lda	one_entry+key_blk_index		sta	drvr_blk_num		jsr	read_with_cache		;read in the key block		bcs	end_fix_subdir		lda	dest_dir_blk		;block number where entry is		ldy	#parent_index		sta	[drvr_buf_ptr],y		lda	#subdir_header		sta	storage_type		ldy	#$0004			;rename the subdirectory as well		jsr	move_new_name		jsr	make_entry_num		bcs	end_fix_subdir		ldy	#parent_index+2		sta	[drvr_buf_ptr],y		jsr	write_with_cacheend_fix_subdir		rtsdec_file_cnt		ldy	#header_file_cnt		lda	[drvr_buf_ptr],y		dec	a			;update the file count for directory		bmi	end_dec		sta	[drvr_buf_ptr],y		jsr	chk_vol_cnt		;pass the new count in the accumend_dec		rtsinc_file_cnt		ldy	#header_file_cnt		lda	[drvr_buf_ptr],y		inc	a			;update the file count for directory		sta	[drvr_buf_ptr],y		jsr	chk_vol_cnt		;pass the new count in the accum		rts;;The new count is in the accumulator;chk_vol_cnt		ldy	drvr_blk_num		;our we updating the Root Level of the disk?		cpy	#vol_dir_start		bne	@not_vol;;Now we need to update the VCR;		ldy	#msdos_vcr.file_count		sta	[msdos_vcr_ptr],y@not_vol		rtsdelete_entry		ldx	#$0000		ldy	src_offsetdelete_loop					; ;move the entry to one_entry		lda	[drvr_buf_ptr],y		sta	one_entry,x		iny		inx		cpx	#entry_length		bne	delete_loop		ldy	src_offset		lda	[drvr_buf_ptr],y		and	#$FF00			;clear storage/length field		sta	[drvr_buf_ptr],y		rtsmove_old_entry		ldx	#$0000		ldy	dest_offset		longa	off		sep	#$20change_loop		lda	one_entry,x		sta	[drvr_buf_ptr],y		iny		inx		cpx	#entry_length		bne	change_loop		longa	on		rep	#$20		rts;======================================================================rename_file		jsr	standard_req		;read in 512 bytes		jsr	set_default_buf		lda	src_dev_num		sta	drvr_dev_num		lda	src_dir_blk		;block that contains the entry		sta	drvr_blk_num		jsr	read_with_cache		bcs	end_rename		clc		lda	src_offset		adc	#access_index		tay		lda	[drvr_buf_ptr],y		and	#rename_enabled		;can we rename the file?		bne	@10			;rename is OK		sec		lda	#invalid_access		;sorry bud		rts				;return with the error please@10		clc		lda	src_offset		;get the key block		adc	#key_blk_index		tay		lda	[drvr_buf_ptr],y		sta	one_entry+key_blk_index		ldy	src_offset		;offset the old name		lda	[drvr_buf_ptr],y		and	#$00F0			;isolate the storage type		sta	storage_type		cmp	#volume_header		beq	rename_vol		cmp	#subdir_type		beq	type_ok		cmp	#seedling_type		beq	type_ok		cmp	#sapling_type		beq	type_ok		cmp	#tree_type		beq	type_ok		cmp	#resource_type		bne	bad_typetype_ok		ldy	src_offset		jsr	move_new_name		jsr	write_with_cache		bcs	end_rename		lda	storage_type		and	#$00F0			;clear the garbage		cmp	#subdir_type		bne	end_rename_clr		lda	src_dir_blk		sta	dest_dir_blk		lda	src_offset		sta	free_dir_offset		jsr	fix_subdir		bcs	end_renameend_rename_clr		jsr	slug_ripple		;ripple the time pleaseend_rename		rtsbad_type		lda	#bad_store_type		sec		rts;Rename a volume.;;Note - if cp_device_flag is $8001 then we're renaming a duplicate volume. In this;       case, don't call chk_boot_vol since the duplicate volume could have the same;       name as the boot volume and we don't want to change the boot prefix.;       3/26/91 CAErename_vol		pei	my_vcr_ptr		pei	my_vcr_ptr+2		jsr	Check_dup_dest		;see if the destination name is an active VCR		ply		sty	my_vcr_ptr+2		ply		sty	my_vcr_ptr		bcc	@not_active		rts@not_active		ldy	volume_name		;terminate the new name with a null		lda	#$0000		sta	volume_name+2,y;               jsr     chk_boot_vol    ;moved after call to setup_name 3/26/91 CAE		lda	#volume_name		;move the name to search_name and		sta	temp_ptr		;do syntax checking on the name		lda	#^volume_name		sta	temp_ptr+2		lda	#$0002			;starting index for check		sta	chars_checked		jsr	setup_name						;following 2 lines added 3/26/91 CAE		lda	cp_device_flag		;are we renaming a duplicate volume?		bmi	@skip_chk		;yes - so don't change the boot prefix		jsr	chk_boot_vol		;change boot prefix if renaming boot volume@skip_chk		lda	[my_vcr_ptr]		;get the VCR ID		ldx	#volume_name		;pointer to the new name		ldy	#^volume_name		jsl	rename_vcr@go_type_ok		clc		brl	type_ok;======================================================================;We need to make sure that the destination name is not an allocated;VCR with open files.  If we find a VCR with open files then we should;remove it or return duplicate volume error.;======================================================================Check_dup_dest		lda	[my_vcr_ptr]		;get the VCR ID of the source		pha		ldx	#volume_name		;pointer to the volume name		ldy	#^volume_name		lda	#0000			;0000=search for vcr by name		jsl	find_vcr		bcc	@handle_dup@no_dup_error		pla				;just fix the stack		clc		rts				;no problem@handle_dup		jsl	deref			;convert virtual to real		stx	my_vcr_ptr		sty	my_vcr_ptr+2		;setup pointer to VCR		lda	[my_vcr_ptr]		;get the VCR ID of the destination.		cmp	1,s			;is source = dest?		beq	@no_dup_error		pla				;we must fix the stack		ldy	#vcr.open_cnt		lda	[my_vcr_ptr],y		bne	@sorry_dup		;files open so don't log in new volume		jsr	free_vcr		;free vcr pointed to by 'my_vcr_ptr'		clc		rts				;we are happy again!@sorry_dup		lda	#dup_volume		;duplicate volume online		sec		rts;======================================================================move_new_name		phy		ldx	#14		lda	#$0000clear_old		sta	[drvr_buf_ptr],y		iny		dex		bpl	clear_old		ply		phy		ldx	#$0000			;index into new name		longa	off		sep	#$20			;8 bit mode		lda	storage_type		ora	search_length		sta	[drvr_buf_ptr],y		inyname_store		lda	search_name,x		;first ascii character		sta	[drvr_buf_ptr],y		iny		inx		cpx	search_length		bne	name_store		;move the entire name		longa	on		rep	#$20		pla				;get index to the storage type 		clc		adc	#version_index		tay		lda	storage_type		cmp	#volume_header		beq	@skip_case_save@do_both	lda	case_bits		;set the case bits please		beq	@do_save		;the case is all upper		bit	fst_attr		;user does not want case info		bmi	@do_save		ora	#$8000			;set the case on bit.@do_save		sta	[drvr_buf_ptr],y		rts@skip_case_save		ldy	#create_index+4-2	;save the case bits please		jsr	@do_both		ldy	#msdos_vcr.create-2		sta	[msdos_vcr_ptr],y		rts;======================================================================chk_boot_vol					;change the boot prefix if needed		ldy	src_offset		;original name of volume		lda	[drvr_buf_ptr],y		and	#$000F			;clear storage type etc.		inc	a			;add one for leading ':'		sta	def_vol_name		;length word		lda	#'::'			;leading ':'		sta	def_vol_name+2		iny				;point to the first character		ldx	#$0000boot_loop		lda	[drvr_buf_ptr],y		sta	def_vol_name+3,x		iny		inx		cpx	#16			;move the max number of characters		bne	boot_loop		jsl	get_boot_pfx		;get the pointer to the current volume		stx	temp_ptr		sty	temp_ptr+2		lda	[temp_ptr]		;verify the length		cmp	def_vol_name		bne	not_same		tay				;use as index		iny				;get the last character please		longa	off		sep	#$20boot_loop2		lda	[temp_ptr],y		cmp	def_vol_name,y		bne	not_same		dey		bpl	boot_loop2		;check the entire volume name		longa	on		rep	#$20		lda	volume_name		;get the length word of the new name		tay		inc	a			;add one for leading ':'		sta	def_vol_name		lda	#'::'		sta	def_vol_name+2new_boot		lda	volume_name+1,y		sta	def_vol_name+2,y		dey		bne	new_boot		ldx	#def_vol_name		;pointer to the new name		ldy	#^def_vol_name		jsl	set_boot_pfxnot_same		longa	on		rep	#$20		rts;======================================================================save_src_parms		lda	drvr_dev_num		;save source info		sta	src_dev_num		lda	dir_start_blk		;starting block of directory		sta	src_start_blk		lda	entry_offset		;offset to directory entry		sta	src_offset		lda	parent_blk		;block that contains entry		sta	src_dir_blk		rtssave_dest_parms		lda	drvr_dev_num		;save source info		sta	dest_dev_num		lda	dir_start_blk		;starting block of directory		sta	dest_start_blk		lda	free_dir_offset		;offset to directory entry		sta	dest_offset		lda	free_dir_blk		;block that contains entry		sta	dest_dir_blk		rts;======================================================================process_dest		lda	path1_ptr		;save pathname one pointer		sta	curr_mark		lda	path1_ptr+2		sta	curr_mark+2		;temp save area!!!!!!!!!!!!!!!		lda	dev1_num		sta	curr_eof		lda	path_flag		sta	curr_eof+2		;temp storage		lda	path2_ptr		;make path two appear as path one		sta	path1_ptr		lda	path2_ptr+2		sta	path1_ptr+2		lda	dev2_num		sta	dev_num		lda	path_flag		and	#path2_mask		xba		sta	path_flag;;IF vol_rename_flag = minus then we are renaming the volume;		bit	vol_rename_flag		bpl	normal_rename		lda	#path1_mask		ldx	path1_ptr		ldy	path1_ptr+2		jsr	build_path		lda	src_dev_num		sta	drvr_dev_num		lda	src_start_blk		sta	dir_start_blk		lda	src_dir_blk		sta	free_dir_blk		lda	src_offset		sta	free_dir_offset		jsr	restore_path1		clc		rtsnormal_rename		lda	#no_dup			;duplicate not allowed		sta	search_flag		jsr	process_path		;find the destination		ldx	slug_block		;save for slug_ripple routine		stx	dest_slug_blk		ldx	slug_offset		stx	dest_slug_offset		bcs	no_dup_problem		lda	drvr_dev_num		;did the user enter the same name?		cmp	src_dev_num		bne	dup_prob		;duplicate filename		lda	dir_start_blk		cmp	src_start_blk		bne	dup_prob		lda	parent_blk		;block that contains entry		cmp	src_dir_blk		bne	dup_prob		lda	entry_offset		;offset to directory entry		cmp	src_offset		bne	dup_prob		jsr	restore_path1		clc		rts				;renaming the same filedup_prob		jsr	restore_path1		lda	#dup_pathnamereal_problem		sec		rtsno_dup_problem		pha		jsr	restore_path1		pla		bit	path_searched		;was the entire path searched?		bpl	real_problem		clc		rtsrestore_path1					; ;restore path1 stuff		lda	curr_mark		sta	path1_ptr		lda	curr_mark+2		sta	path1_ptr+2		lda	curr_eof		sta	dev_num		lda	curr_eof+2		sta	path_flag		rts;======================================================================;Possible combinations of pathnames;;(1)            .DEV1                --> /FOO          (Rename);(2)            /FOO1                --> /FOO          (Rename);(3)            /FOO1/PATHNAME       --> /FOO1/NEWNAME (Rename);(4)            /FOO1/SUB/FILE       --> /FOO1/FILE    (Change path);(5)            .DEV1/FILE           --> /FOO/NEW.NAME (Rename);(6)            .DEV1/FILE           --> /FOO/SUB/FILE (Change path);(7)            /FOO/FILE            --> .DEV1/SUB/NEW (Change path);(8)            /FOO/FILE            --> .DEV1/NEW     (rename);;Invalid Pathnames:;;(1)            /FOO                 --> .DEV1;(2)            /FOO                 --> /FOO/FILE;(3)            /FOO/SUB/            --> /FOO/SUB/SUB1/SUB;(4)            /FOO/FILE            --> /FOO;(5)            /FOO/FILE            --> .DEV1;;======================================================================valid_change		stz	cp_to_child	; assume source is not a subset of dest		stz	vol_rename_flag		lda	path_flag		and	#path2_mask		;there has to be a second pathname		beq	to_bad_path		jsr	setup_path1		;Path1_ptr --> temp_ptr		jsr	setup_path2		;Path2_ptr --> temp2_ptr;;IF (Path1 = device_name) THEN;   (Path2 must be a volume name only);;		lda	path_flag		;is path1 a device name only?		and	#path1_mask		bne	not_device		;not just a device name		lda	dev2_num		bne	to_bad_path		;path2 cannot contain a device name		ldx	temp2_ptr		ldy	temp2_ptr+2		jsr	scan_pass_vol		;pass the volume name IF possible		bcc	to_bad_path		;there is more then just a volume name;;We are doing the following:  '.DEV1' to '/FOO';		bra	volume_renameto_bad_path		brl	bad_path;; IF (Path1 = volume_only) THEN;    (Path2 must be volume only);not_device		lda	dev1_num		;IF dev <> 00 THEN not volume only		bne	chk_same_dev		ldx	temp_ptr		;pointer to path1		ldy	temp_ptr+2		jsr	scan_pass_vol		bcc	not_vol_only		;path1 <> volume only;; IF (path1 - volume) and ((path2 = device) or (path2 = dev/vol)) THEN;    bad_path_syntax;		lda	path_flag		and	#path2_mask		beq	to_bad_path		lda	dev2_num		;is there a device name also?		bne	a_bad_path		ldx	temp2_ptr		ldy	temp2_ptr+2		jsr	scan_pass_vol		;pass the volume name IF possible		bcc	to_bad_path		;path2 <> volume only;;We are doing the following:  '/FOO1' to '/FOO';volume_rename		dec	vol_rename_flag		clc		rts;;IF (Path1 <> volume only) THEN;   (Path2 MUST be a pathname);chk_same_dev		lda	dev2_num		;is the rename on the same device?		beq	not_vol_only		cmp	dev1_numa_bad_path	bne	to_bad_pathnot_vol_only		lda	path_flag		and	#path2_mask		;is there a pathname?		beq	bad_path		;must be device name only		lda	dev2_num		;IF (dev = true) and (path = true) THEN		bne	path2_is_path		;   (path2 = pathname)		ldx	temp2_ptr		ldy	temp2_ptr+2		jsr	scan_pass_vol		bcs	bad_path		;Path2 = volume name only!		stx	temp2_ptr		sty	temp2_ptr+2;;IF (path2 = path2-volume_name) and (path1 = volume_name) THEN;   Path1 := Path1-volume_name;		lda	dev1_num		;does path1 contain a volume name?		bne	do_scan			;no it does not		ldx	temp_ptr		ldy	temp_ptr+2		jsr	scan_pass_vol		;scan past the volume name		stx	temp_ptr		sty	temp_ptr+2		bra	do_scan;; When Here Path1 and Path2 are both pathnames!;; IF (Path1 = dev) and (path2 = vol) THEN;    path2 := path2-volume name;path2_is_path		lda	dev1_num		;does path1 contain a device name?		beq	path1_volume		;NO		lda	dev2_num		;does path2 contain a device name?		bne	do_scan			;path1 and path2 contains device names		ldx	temp2_ptr		ldy	temp2_ptr+2		;scan pass the volume name		jsr	scan_pass_vol		stx	temp2_ptr		sty	temp2_ptr+2		bra	do_scan			;everything is OK so far;; IF (path1 = volume) and (path2 = dev) THEN;    path1 := path1-volume_namepath1_volume		lda	dev2_num		;does path2 contain a		beq	do_scan			;Path1 and path2 contain volume names;; IF (path2 = dev) and (path1 = vol) THEN;    path1 := path1-volume_name;scan_path1		ldx	temp_ptr		;path1		ldy	temp_ptr+2		jsr	scan_pass_vol		;pass the volume name		stx	temp_ptr		sty	temp_ptr+2		;The following code was moved into the changepath code so		;that ProDOS conforms to the way AppleShare and HFS do a 		;changepath.  The check to see if the path1 is a subset 		;of path2 should not be done until after we check to see 		;if the path2 allready exsists.               10/3/91 JEV;; IF (path1 is a subset of path2) THEN;    set cp_to_child						;The following code has been changed to do a case-insensitive						;compare in order to fix a bug which was allowing illegal moves						;if the case of the pathnames was different.  1/22/91 CAEdo_scan					; 		ldy	#$0000		;start scan at beginning		longa	off		sep	#$20subset_loop				; ;		lda	[temp_ptr],y		;source file;		cmp	[temp2_ptr],y		;destination;		bne	more_chk;		iny;		bra	subset_loop				lda	[temp_ptr],y		;get source file char		cmp	#'a'			;upper case?		bcc	@its_upper1		;yes		and	#$DF			;no - so convert to upper case@its_upper1	pha				;save char		lda	[temp2_ptr],y		;get dest file char		cmp	#'a'			;upper case?		bcc	@its_upper2		;yes		and	#$DF			;no - so convert to upper case@its_upper2	cmp	1,s			;same as source file char?		bne	@no_match		;nope		pla				;yes - so clean up stack		iny				;adjust index		bra	subset_loop		;and loop@no_match	pla				;clean up stack		more_chk		lda	[temp2_ptr],y		;this cannot be a 'delimiter'		cmp	#delimiter		longa	on			;go ahead and fix the mode		rep	#$20		bne	paths_ok		lda	[temp_ptr],y		;is this the end of the source?		and	#$00FF		bne	paths_ok		;not the end of source name		inc	cp_to_child		; source was subset of dest! 27-Jan-92 MSDbad_path		lda	#bad_path_syntax		sec		brl	main_exitpaths_ok	clc		rts;======================================================================scan_pass_vol		stx	temp3_ptr		;pointer to the string		sty	temp3_ptr+2		ldy	#$0001		longa	off		sep	#$20scanner		lda	[temp3_ptr],y		beq	scan_failed		;sorry volume name only		cmp	#delimiter		beq	scan_passed		iny		bra	scannerscan_passed; 27-Jan-92 MSD: This routine was returning a pointer to the character; before the pathname separator.  It should have been returning a pointer; to the character after the separator.  Removed the DEY and changed a; CLC to a SEC before adding (so it will add 1 to point past separator).;;		dey		longa	on		rep	#$20			;back to 16 bit mode		sec				; 27-Jan-92 MSD (was CLC)		dey		longa	on		rep	#$20			;back to 16 bit mode		clc		tya		adc	temp3_ptr		tax		lda	#$0000		adc	temp3_ptr+2		tay		clc				;not just a volume name		rtsscan_failed		longa	on		rep	#$20;               ldx     temp3_ptr		ldy	temp3_ptr+2		;restore X and Y		sec		rts;======================================================================setup_path2		ldx	path2_ptr		ldy	path2_ptr+2		inx		bne	do_again		inydo_again	inx		bne	cont		inycont		stx	temp2_ptr		;pointer to pathname two		sty	temp2_ptr+2		rts;======================================================================setup_path1		ldx	path1_ptr		ldy	path1_ptr+2		inx		bne	do2_again		inydo2_again	inx		bne	cont2		inycont2		stx	temp_ptr		;pointer to pathname one		sty	temp_ptr+2		rts		ENDP	endif	if NOT read_only_fst then		Eject;==========================================================================;Set_file_info: This routine will alter information about a file on disk.;;Created:       may 26, 1987;Modified:      jan 06, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               find_file;;Call Format:;;Class 0        Pathname Pointer        (4 Bytes);               Access                  (2 Bytes: Disk Format);               File Type               (2 Bytes);               Aux Type                (4 Bytes);               Null Field              (2 Bytes);               Create Date/Time        (4 Bytes: ProDOS Format);               Mod Date/Time           (4 Bytes: ProDOS Format);;Class 1        PCount                  (2 Bytes);               Pathname Pointer        (4 Bytes);               Access                  (2 Bytes: Disk Format);               File Type               (2 Bytes);               Aux Type                (4 Bytes);               Null Field              (2 Bytes);               Create Date/Time        (8 Bytes: Misc. Tools Format);               Mod Date/Time           (8 Bytes: Misc. Tools Format);               Option List             (4 Bytes);               Null Field              (4 Bytes);               Null Field              (4 Bytes);               Null Field              (4 Bytes);               Null Field              (4 Bytes);==========================================================================		longa	on		longi	onset_file_info	PROC	Export		with	my_dp;==========================================================================;Reset all time fields to zero.  This forces me to calculate the time if;needed.  However, if the create time is set to zero then the create date;and time fields will be left unchanged.;==========================================================================		stz	mod_time		stz	mod_time+2		stz	create_time		stz	create_time+2;==========================================================================;Go and setup the default parameters for the call.;==========================================================================		jsr	setup_params		php				;save class state;==========================================================================;Process the file name and locate it.;==========================================================================		jsr	process_path		jsr	chk_disk_protect;==========================================================================;See if this is a volume header.  If it is then return 'bad_path_syntax';==========================================================================		lda	[drvr_buf_ptr]		and	#$00F0		cmp	#volume_header		bne	ok_to_change		lda	#bad_path_syntaxset_info_err		secset_info_exit		brl	main_exit;==========================================================================;Move the directory entry into one entry please;==========================================================================ok_to_change		jsr	move_dir_entry		plp				;restore class flag.		beq	class0;==========================================================================;When we get here we know that this is a class one call.;So now we start processing the parameters supplied.;==========================================================================		dec	pcount		dec	pcount		jsr	get_access		;setup the access field		dec	pcount		bmi	to_no_time_change;==========================================================================;go and grab the file type that the user has provided.;If the storage type is a directory then we must nake sure the file;type field is $0F, which indicates that the file is a directory.;==========================================================================		jsr	get_ftype		jsr	set_dir_type		dec	pcount		bmi	to_no_time_change;==========================================================================;The user's has also provided the aux type.;==========================================================================		jsr	get_aux_type;==========================================================================;Skip all the  null fields;==========================================================================		dec	pcount		dec	pcount		bpl	contto_no_time_change		brl	no_time_changecont;==========================================================================;user's has also provided the create data.  Isn't that special!;==========================================================================		ldy	#pblk_05_create		jsr	get_pblk_time		bcc	@good1		; 27-Jan-92 MSD:		ldy	#$8000		; invalid, but non-zero@good1		stx	create_time		sty	create_time+2		dec	pcount		bmi	do_create_only;==========================================================================;Holly Cow Batman the user's has even given us the modification date!;==========================================================================		ldy	#pblk_05_mod		jsr	get_pblk_time		bcc	@good2		; 27-Jan-92 MSD:		ldy	#$8000		; invalid, but non-zero@good2		stx	mod_time		sty	mod_time+2						;new code added 2/13/91 CAE             		dec	pcount		bra	set_the_infoclass0;==========================================================================;The old style call has to provide everything, So go ahead and get it.;==========================================================================		jsr	get_access		jsr	get_ftype		jsr	set_dir_type		jsr	get_aux_type;==========================================================================;get the create date and time;==========================================================================		ldy	#$000E			;index to the create time		lda	[my_pblk_ptr],y		sta	create_time		iny		iny		lda	[my_pblk_ptr],y		sta	create_time+2;==========================================================================;Get the modification date and time.;==========================================================================		iny		iny		lda	[my_pblk_ptr],y		sta	mod_time		iny		iny		lda	[my_pblk_ptr],y		sta	mod_time+2;==========================================================================;We get to 'set_the_info' from both the class1 and class0 style calls.;==========================================================================set_the_info		jsr	pack_time		;read the system clock please						;X & Y contain the date and time		lda	mod_time		;did the user supply the date and time?		ora	mod_time+2		;(i.e. is the parameter != 0?)		beq	@use_current		;yes, use the current date and time		ldx	mod_time		;else use the user supplied values		lda	mod_time+2		and	#$1F3F			;make sure parameters are in range		tay@use_current		stx	one_entry+last_mod_index		sty	one_entry+last_mod_index+2do_create_only		lda	create_time		;did the user supply a creation date & time?		ora	create_time+2		beq	no_time_change		;no, just leave it alone		lda	create_time		;else copy user's values to entry		sta	one_entry+create_index		lda	create_time+2		and	#$1F3F			;make sure parameters are in range		sta	one_entry+create_index+2no_time_change		ldy	#entry_length-1put_back		lda	one_entry,y		sta	[drvr_buf_ptr],y		dey		dey		bpl	put_back		lda	gbuf_addr		sta	drvr_buf_ptr		lda	gbuf_addr+2		sta	drvr_buf_ptr+2		jsr	standard_req		jsr	write_with_cache		bcs	all_done		jsr	fix_the_fcr		;update the File Control Record if needed		jsr	slug_rippleall_done	brl	set_info_exit;==========================================================================;=============== END OF THE MAIN CODE FOR SET_FILE_INFO ===================;==========================================================================;==========================================================================;Below is the subroutines used by SET_FILE_INFO.;==========================================================================;==========================================================================;Now we see if the file is already open.  We do this by calling;get_next_fcr.  If this routine finds a MSDOS FCR then we see if the key;block is the same.  If it is then we also update the FCR along with the;disk;==========================================================================fix_the_fcr		stz	fcr_wanted		;reset counter for Get_Next_FCRlook_loop		jsr	get_next_fcr		;go grab a FCR		bcs	no_fcr		ldy	#fcr.vol_id		lda	[my_fcr_ptr],y		;get the Volume ID so we can make sure the file is on		cmp	[my_vcr_ptr]		;the same volume.		bne	look_loop		;File is on another volume		ldy	#msdos_fcr.file_id		lda	[msdos_fcr_ptr],y		cmp	one_entry+key_blk_index		bne	look_loop;==========================================================================;Save a modified Aux type please;==========================================================================		ldy	#msdos_fcr.aux_type	;update the aux type please		lda	one_entry+aux_type_index		sta	[msdos_fcr_ptr],y;==========================================================================;Save file type please;==========================================================================		ldy	#msdos_fcr.file_type		lda	one_entry+file_type_index		sep	#$20			;a short store		sta	[msdos_fcr_ptr],y		rep	#$20;==========================================================================;Save create time please;==========================================================================		ldy	#msdos_fcr.create	;update the create time		lda	one_entry+create_index		sta	[msdos_fcr_ptr],y		iny		iny		lda	one_entry+create_index+2		sta	[msdos_fcr_ptr],yno_fcr		rts;==========================================================================;Store the user's access field in the;==========================================================================get_access;		ldy	#pblk_05_accs		lda	[my_pblk_ptr],y		tax		and	#$FF18			;clear the reserved bits		bne	bad_bits		;sorry bud you are out of range		longa	off		sep	#$20		txa		ora	#backup_on		;force the backup bit on		sta	one_entry+access_index		longa	on		rep	#$20		rtsbad_bits		lda	#parm_range_err		brl	set_info_err;==========================================================================;get_aux_type and store it;==========================================================================get_aux_type		ldy	#pblk_05_aux+2		lda	[my_pblk_ptr],y		bne	range_problem		dey		dey		lda	[my_pblk_ptr],y		sta	one_entry+aux_type_index		rtsrange_problem		lda	#parm_range_err		brl	set_info_err;==========================================================================;Get the file type;==========================================================================get_ftype		ldy	#pblk_05_ftype		lda	[my_pblk_ptr],y		tax		and	#$FF00		bne	range_problem		longa	off		sep	#$20		txa		sta	one_entry+file_type_index		longa	on		rep	#$20		rts;==========================================================================;This routine is used to convert the extended date and time fields into;MSDOS data and time fields;==========================================================================get_pblk_time		lda	[my_pblk_ptr],y		;Get the second field so I can range check it		and	#$00FF			;clear the minutes field		cmp	#60		bcs	range_problem		iny				;get the minutes field		lda	[my_pblk_ptr],y		tax		and	#$00FF		cmp	#60			;minutes are 00 to 59		bcs	range_problem		sta	minutes			;save the minutes field		txa		xba		and	#$00FF		cmp	#24			;hours are 00 to 23		bcs	range_problem		sta	hours			;save the hours field		iny		iny		lda	[my_pblk_ptr],y		tax		and	#$00FF		sta	year			;save the year as well		txa		xba		and	#$00FF		cmp	#31			;days are 00 to 30		bcs	range_problem		sta	day			;don't forget the day now.		iny		iny		lda	[my_pblk_ptr],y		and	#$00FF		sta	month		cmp	#12			;month = 0 to 11		bcs	range_problem		iny				;get the null/day of week field		lda	[my_pblk_ptr],y		xba				;put null in the high byte for easy compare		cmp	#$0008			;max value is 7 for day of week		bcs	range_problem		lda	hours		ora	minutes		ora	year		ora	day		ora	month		beq	use_clock		inc	day		inc	month			;convert to MSDOS format		jsr	convert_time		;convert the time to MSDOS format		rtsuse_clock		tax				;return 0000 so we use the current time		txy		clc			; 27-Jan-92 MSD: date was valid		rts;==========================================================================;This routine will change the file type to $0F if the storage type of the;file is a subdirectory;==========================================================================set_dir_type		lda	storage_type		;if storage is a directory only allow		cmp	#subdir_type		;file type of $0F please		bne	norm_file		longa	off			;short mode for a second please		sep	#$20		lda	#$000F			;File type for directories		sta	one_entry+file_type_index		longa	on		rep	#$20			;back to 16 bit modenorm_file		rts		ENDP	endif		Eject;==========================================================================;Get_file_info: This routine will return information about a file on disk.;               If the file is open and has been modified then the EOF;               and Blocks used fields come from the FCR.  I do not;               return the current time for the modification time, since;               This would require a call to the SLOW clock routines.;;;Created:       May 23, 1987;Modified:      Aug 26, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               find_file;;Call Format:;;Class 0        Pathname Pointer        (4 Bytes);               Access                  (2 Bytes: Disk Format);               File Type               (2 Bytes);               Aux Type                (4 Bytes);               Storage Type            (2 Bytes);               Create Date/Time        (4 Bytes: ProDOS Format);               Mod Date/Time           (4 Bytes: ProDOS Format);               Blocks Used             (4 Bytes);;Class 1        PCount                  (2 Bytes);               Pathname Pointer        (4 Bytes);               Access                  (2 Bytes: Disk format);               File Type               (2 Bytes);               Aux Type                (4 Bytes);               Storage Type            (2 Bytes);               Create Date/Time        (8 Bytes: Misc. Tools Format);               Mod Date/Time           (8 Bytes: Misc. Tools Format);               Option List Pointer     (4 Bytes);               EOF Data Fork           (4 Bytes);               Blocks Used Data Fork   (4 Bytes);               EOF Resource Fork       (4 Bytes);               Blocks Used Res. Fork   (4 Bytes);;==========================================================================		longa	on		longi	onget_file_info	PROC	Export		with	my_dp;==========================================================================;Go and setup the default parameters for the call.;==========================================================================		jsr	setup_params;==========================================================================;Process the file name and locate it.;==========================================================================		jsr	process_path;==========================================================================;Move the directory entry into one entry please;==========================================================================		jsr	move_dir_entry		;move the entry to one_entry;==========================================================================;Now we see if the file is already open.  We do this by calling;get_next_fcr.  If this routine finds an MSDOS FCR then we see if the key;block is the same.  If it is then we get the EOF and Number of blocks;used from the FCR instead of from disk.;(Modified to handle resource files correctly 3/13/91 CAE);==========================================================================		stz	fcr_wanted		;reset counter for Get_Next_FCRlook_loop		jsr	get_next_fcr		;go grab a FCR		bcs	loop_done		ldy	#fcr.vol_id		lda	[my_fcr_ptr],y		;get the Volume ID so we can make sure the file is on		cmp	[my_vcr_ptr]		;the same volume.		bne	look_loop		;File is on another volume		ldy	#msdos_fcr.start_cluster		lda	[msdos_fcr_ptr],y		cmp	one_entry.start_cluster		bne	look_loop;Check the status bit to see if the file info is different from the info on disk.;If not, then loop.		ldy	#msdos_fcr.status		lda	[msdos_fcr_ptr],y		bpl	look_loop;Get the current EOF		ldy	#msdos_fcr.eof		lda	[msdos_fcr_ptr],y		sta	one_entry.file_size		iny		iny		lda	[msdos_fcr_ptr],y		sta	one_entry.file_size+2loop_done;==========================================================================;Check to see if we're dealing with a volume header.;==========================================================================		lda	storage_type		cmp	#volume_header		bne	go_send_info		jsr	calc_free_blks		;A = free blocks		bcc	have_free		brl	main_exit		;sorry there is an errorhave_free		sta	one_entry.reserved		ldy	#msdos_vcr.total_sectors		lda	[msdos_vcr_ptr],y		sta	one_entry.file_size		sec		sbc	one_entry.reserved		sta	one_entry.reserved+4go_send_info		lda	pcount		beq	old_style_info		clc		lda	my_pblk_ptr		adc	#$0004		tax		lda	my_pblk_ptr+2		adc	#$0000		tay		lda	pcount		dec	a		jsr	send_info		brl	main_exitold_style_info;==========================================================================;Just return the old style info for class 0 calls;first field is ACCESS;==========================================================================		ldx	#$00C3			;assume full access		lda	one_entry.attributes	;get the attributes		bit	#read_only		;read_only bit set?		beq	@not_read_only		;no...		ldx	#$0001			;else clear Delete/Rename/Write enable bits@not_read_only		bit	#archive		;backup bit set?		beq	@no_backup_bit		;no...		pha				;else set backup bit in returned attributes		txa		ora	#%00100000		tax		pla@no_backup_bit		bit	#hidden_file+sys_file	;hidden or system file?		beq	@visible		;no...		txa		ora	#%00000100		;else set invisible bit		tax@visible		txa				;retrieve final attributes		ldy	#$0004		sta	[my_pblk_ptr],y;==========================================================================;now send the FILE TYPE;==========================================================================		iny		iny		ldx	#$000f			;assume subdirectory		lda	one_entry.attributes	;get the attributes		bit	#subdirectory		;is it a directory entry		bne	@is_directory		;no...		jsr	get_file_type		;translate extension into filetype@is_directory		txa		sta	[my_pblk_ptr],y;==========================================================================;go ahead and give them the AUX TYPE;==========================================================================		iny		iny		lda	#0		sta	[my_pblk_ptr],y		;anticipate zero auxtype		iny		iny		sta	[my_pblk_ptr],y*** added 11-Aug-92 DAL		lda	one_entry.attributes		bit	#subdirectory		bne	@directory		jsr	get_file_type		dey		dey		sta	[my_pblk_ptr],y		iny		iny@directory*** end 11-Aug-92;==========================================================================;throw in the storage type for good measure;==========================================================================		iny		iny		lda	storage_type		sta	[my_pblk_ptr],y;==========================================================================;how about the CREATE DATE and TIME;==========================================================================		iny		iny		lda	one_entry.date		and	#%0000000111111111	;leave only month & day		pha		lda	one_entry.date		;get it again		xba				;shift year to low byte		lsr	a		and	#$007f		clc		adc	#80			;add in offset		xba				;put back where it belongs		asl	a		ora	1,s			;recombine with month & day		sta	[my_pblk_ptr],y		sta	1,s			;store for modification date too		iny		iny		lda	one_entry.time		;now get the time		tax				;save for a bit		and	#%1111100000000000	;mask off minutes & seconds		lsr	a			;shift into position		lsr	a		lsr	a		pha				;save for a bit		txa				;get minutes/seconds		lsr	a			;shift minutes into position		lsr	a		lsr	a		lsr	a		and	#$003f			;mask unused bits		ora	1,s			;combine with minutes		sta	[my_pblk_ptr],y		tax				;save in X;==========================================================================;Send the last MODIFICATION DATE and TIME;==========================================================================		iny		iny		pla				;retrieve saved date		sta	[my_pblk_ptr],y		iny		iny		txa				;retrieve saved time		sta	[my_pblk_ptr],y;==========================================================================;and lastly, the number of blocks used.;==========================================================================		iny		iny		lda	one_entry.reserved+4		sta	[my_pblk_ptr],y		iny		iny		lda	#$0000		sta	[my_pblk_ptr],y		clc		brl	main_exit;==========================================================================;Calculate the modification date for the volume.  We do this since the mod;date is not stored on the disk.  This should not be bad since the blocks;are stored in the cache.;;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1= error;               b = k;;               one_entry+last_mod_index        ;is setup with the date;;==========================================================================calc_last_mod		lda	drvr_dev_num		;pass in the device number		ldx	#dummy_name		; and a pointer to the name		ldy	#^dummy_name		jsr	find_file		;this will fail but we do not care		lda	curr_mod_date		tax		ora	curr_mod_date+2		beq	@same_time		;there are no files on the disk!		stx	one_entry+last_mod_index		lda	curr_mod_date+2		sta	one_entry+last_mod_index+2		rts@same_time		lda	one_entry+create_index		sta	one_entry+last_mod_index		lda	one_entry+create_index+2		sta	one_entry+last_mod_index+2		rts		ENDP		Eject;==========================================================================;Judge_name:    Returns information about MSDOS filename syntax.;               Modifies name (if supplied) to conform to MSDOS syntax.;;Note:          This is a class 1 call only.;;Created:       Jan 22, 1991;Author:        Cheryl Ewy;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               <temp_ptr;               <temp2_ptr;               <temp3_ptr;;Call Format:;;Class 1        PCount                  (2 Bytes);               File System ID          (2 Bytes);               Name Type               (2 Bytes);               Syntax                  (4 Bytes);               Max Len                 (2 Bytes);               Name                    (4 Bytes);               Name Flags              (2 Bytes);;==========================================================================		longa	on		longi	onjudge_name	PROC	Export		with	my_dpname_flags	equ	temp2_ptr		;local equatesbuf_size	equ	temp2_ptr+2temp_val	equ	temp3_ptrnul_flag	equ	temp3_ptr+2max_len		equ	15			;maximum name length; Setup the default parameters for the call.		jsr	setup_params; Init flags word to 0.		stz	<name_flags; Make sure the name_type input parameter is valid.		ldy	#pblk_07_ntype		lda	[my_pblk_ptr],y		;get name_type input param		cmp	#4			;is it < 4?		bcs	bad_param		;no - so report error; Minimum pcount is 3 so we'll always return a ptr to the syntax string.		lda	#syntax_str		;get lo word of ptr to string		ldy	#pblk_07_syntax		sta	[my_pblk_ptr],y		;store it in output param		iny		iny		lda	#^syntax_str		;get hi word of ptr to string		sta	[my_pblk_ptr],y		;store it in output param; Adjust the pcount to reflect the number of remaining parameters to deal with.		dec	pcount			;done with file_sys_id param		dec	pcount			;done with name_type param		dec	pcount			;done with syntax param; Return the maximum name length if requested.		dec	pcount		bmi	done		lda	#max_len		;get maximum name length		ldy	#pblk_07_max_len		sta	[my_pblk_ptr],y		;store it in the max_len output param; Get the ptr to the name buffer if supplied.  The name buffer is a class 1 output buffer. ; If the ptr is 0 then there's no name to judge.		dec	pcount		bmi	done		ldy	#pblk_07_name		lda	[my_pblk_ptr],y		;get lo word of ptr to name buffer		sta	<temp_ptr		;and store		iny		iny		lda	[my_pblk_ptr],y		;get hi word of ptr to name buffer		and	#$00ff			;mask off hi byte		sta	<temp_ptr+2		;and store		ora	<temp_ptr		;is the ptr 0?		beq	do_flags		;yes - so there's no name to judge; Check the name buffer size to make sure the buffer is large enough to contain; the maximum size name.  If not, return an error.		lda	[temp_ptr]		;get buffer size		cmp	#max_len+4		;is the buffer big enough?		bcc	buf_err			;no - so return an error		sta	<buf_size		;yes - so save buffer size; Adjust <temp_ptr so that it points to the length word of the name string instead of; to the buffer size word.  		clc		lda	<temp_ptr		;adjust ptr to point to the name length 		adc	#2		sta	<temp_ptr		lda	<temp_ptr+2		adc	#0		sta	<temp_ptr+2; Judge the name.		jsr	judge_it; Return the name_flags parameter if requested.do_flags	dec	pcount		bmi	done		lda	<name_flags		;get name_flags		ldy	#pblk_07_nflags		sta	[my_pblk_ptr],y		;store it in the output param; Indicate no error and return.done		clc		brl	main_exit; Return a parameter range error.bad_param	lda	#parm_range_err		sec		brl	main_exit; Return a buffer too small error.buf_err		lda	#buff_too_small		sec		brl	main_exit;--------------------------------------------------------------------------judge_it; If the name length = 0 then set the name string to "A", indicate that there; was a syntax error, then return.		lda	[temp_ptr]		;is the name length = 0?		bne	@got_name		;no - so we have a name@nameIsNull	lda	#1		sta	[temp_ptr]		;set name length to 1		ldy	#2		lda	#'A'		sta	[temp_ptr],y		;set name string to "A"		lda	#$2000			;set bit 13 of name_flags to indicate		tsb	<name_flags		;that there was a syntax error		rts				;and return@got_name; We have a name to judge.*** added 14-Apr-91 DAL -- call StringToText in the Misc Tools	if CallStringToText=1 then		pha				;space for StringToText result flags		pha				;space for StringToText result length		pea	$6000			;flags: force "English", allow expansion		ldx	temp_ptr+2		;push [temp_ptr]+2 -- input text		lda	temp_ptr		clc		adc	#2		bcc	@ok		inx@ok		phx		pha		lda	[temp_ptr]		pha				;push input string length		ldx	temp_ptr+2		;push [temp_ptr]-2 -- result buffer		lda	temp_ptr		sec		sbc	#2		bcs	@ok2		dex@ok2		phx		pha		ldx	#$3b03		jsl	$e10000;               _StringToText		pla				;printable length (ignore)		pla				;result flags		bpl	@noChange		lda	#$8000			;set bit 15 = illegal characters		tsb	<name_flags@noChange	endif*** end of 14-Apr-91 DAL; Set bit 14 of name_flags if the name is too long.; Note - we have to do this now because the name length may change. 		lda	[temp_ptr]		;get name length*** added 29-Apr-91 DAL		beq	@nameIsNull*** end of 29-Apr-91 DAL		cmp	#max_len+1		;is it too long?		bcc	@len_ok			;no		lda	#$4000			;yes - so set bit 14 of name_flags 		tsb	<name_flags		;to indicate name was too long@len_ok; Convert all illegal characters to NULs. They'll be converted to periods later.		lda	[temp_ptr]		;get length of pathname		inc	a			;adjust for extra length byte		tay		ldx	#0			;init to 0		longa	off			;set 8 bit A		sep	#$20loop1		lda	[temp_ptr],y		;get byte		cmp	#'a'		bcc	@check_upper		cmp	#'z'+1		bcs	@bad_char		bra	@ok			;it's a lower-case letter@check_upper	cmp	#'A'		bcc	@check_num		cmp	#'Z'+1		bcs	@bad_char		bra	@ok			;it's an upper-case letter@check_num	cmp	#'0'		bcc	@check_period		cmp	#'9'+1		bcs	@bad_char		bra	@ok			;it's a number@check_period	cmp	#'.'		beq	@ok			;it's a period@bad_char	lda	#$00			;it's an illegal character so		sta	[temp_ptr],y		;replace char with a NUL		ldx	#$8000			;indicate illegal character found@ok		dey				;decrement offset		cpy	#1		bne	loop1			;loop until done		longa	on			;set 16 bit A		rep	#$20		txa				;set bit 15 if an illegal		tsb	<name_flags		;character was found; If the name doesn't begin with a letter, then indicate that there was a syntax error.; Note - we have to check this now because if the first character is illegal, it will ;        be removed by the next section of code. 		ldy	#2		lda	[temp_ptr],y		;get first 2 chars		and	#$00ff			;only want first char		cmp	#'A'			;is it a letter?		bcs	@syntax_ok		;yes - so we're ok		lda	#$2000			;set bit 13 to indicate that		tsb	<name_flags		;there was a syntax error@syntax_ok; Replace runs of 2 or more NULs with a single period.; All leading and trailing NULs will be removed.; Note - if no illegal characters were found, then skip this section. 		lda	<name_flags		;were there any illegal characters?		bpl	skip_it			;no - so skip this section		lda	[temp_ptr]		;get name length		inc	a			;add 2 to account for the length bytes		inc	a		sta	<temp_val		;and save		longa	off		sep	#$20			;set 8 bit A		ldx	#2			;init offsets		phx		stx	<nul_flag		;init flag to indicate we've seen a NULloop2		ply				;get offset		cpy	<temp_val		;are we done?		bcs	loop2_done		;yes		lda	[temp_ptr],y		;no - so read next character		iny				;adjust offset 		phy				;and save		cmp	#$00			;is the char a NUL?		bne	@not_nul		;no - so branch		ldy	<nul_flag		;was the last character a NUL?		bne	loop2			;yes - so loop		inc	<nul_flag		;no - so indicate we've seen a NUL		lda	#'.'			;convert the NUL into a period		bra	@store_char		;and store the period@not_nul	stz	<nul_flag		;indicate we've seen a non-NUL  @store_char	txy		sta	[temp_ptr],y		;store the character		tyx		inx				;adjust offset		bra	loop2			;and looploop2_done	lda	<nul_flag		;was the last char read a NUL?		beq	@ok			;no		cpx	#2			;yes - was it stored?		beq	@ok			;no 		dex				;yes - so don't count it@ok		longa	on		rep	#$20			;set 16 bit A		txa				;determine new name length		dec	a		dec	a		sta	[temp_ptr]		;and storeskip_it; If the name doesn't begin with a letter, insert an 'A' as the first character.; If the buffer has no extra space, then lose the last character.; Note - we need to check for a zero-length name in case all chars were illegal.		lda	[temp_ptr]		;get name length		bne	@not_zero		;branch if it's > 0		inc	a			;name length is 0 so		sta	[temp_ptr]		;set length to 1		bra	stuff_a			;and insert the 'A'@not_zero		ldy	#2		lda	[temp_ptr],y		;get first 2 chars		and	#$00ff			;only want first char		cmp	#'A'			;is it a letter?		bcs	char1_ok		;yes - so we're ok		lda	[temp_ptr]		;get name length		tay				;and save		clc		adc	#4		cmp	<buf_size		;does the buffer have any unused space?		bcs	@lose_last		;no - so lose last char		iny				;yes - so save last char		tya		sta	[temp_ptr]		;add 1 to name length@lose_lastloop3		lda	[temp_ptr],y		;move all chars over by 1		xba		sta	[temp_ptr],y		dey		cpy	#1		bne	loop3		longa	offstuff_a		sep	#$20			;set 8 bit A		ldy	#2		lda	#'A'		sta	[temp_ptr],y		;stuff an 'A' in as first char		longa	on		rep	#$20			;set 16 bit Achar1_ok; If the name is too long then keep the first 7 chars, insert '..', keep the last 6 chars.		lda	[temp_ptr]		;get name length		cmp	#max_len+1		;is it too long?		bcc	length_ok		;no		ldy	#9			;get offset to 8th char		lda	#'..'		sta	[temp_ptr],y		;insert the '..'		lda	[temp_ptr]		;get length of name		sec		sbc	#4			;subtract 4 to get offset		pha				;to last part of name to keep		longa	off			;set 8 bit A		sep	#$20		ldx	#11			;set offset after the '..' (10th char)                  loop4		ply		lda	[temp_ptr],y		;move the last 6 characters		iny				;so they are after the '..'		phy		txy		sta	[temp_ptr],y		inx		cpx	#17			;are we done?		bne	loop4			;no - so loop		ply				;clean up stack		longa	on			;set 16 bit A		rep	#$20		lda	#max_len		;adjust the name length		sta	[temp_ptr]length_ok; Done with name.		rts		ENDP		Eject;==========================================================================;Volume:        This routine will return the volume information on a disk;;Created:       may 24, 1987;Modified:      may 24, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               fill_io_buf;;Call Format:;;Class 0        Device Name Pointer     (4 Bytes);               Volume Name Pointer     (4 Bytes);               Total Blocks            (4 Bytes);               Free Blocks             (4 Bytes);               File System ID          (2 Bytes);;Class 1        PCount                  (2 Bytes);               Device Name Pointer     (4 Bytes);               Volume Name Pointer     (4 Bytes);               Total Blocks            (4 Bytes);               Free Blocks             (4 Bytes);               File System ID          (2 Bytes);               Block Size              (2 Bytes);;==========================================================================		longa	on		longi	onvolume		PROC	Export		with	my_dp;==========================================================================;Call setup routine.  This routine will verify input parameters like;                     call class, max pcount and span.  It will also setup;                     any pointers that are used.;;The routine loads the class of the call as the last instruction before RTS;==========================================================================		jsr	setup_params;==========================================================================;Now lets go and and ID that puppy.  The device number to ID is on ZP;==========================================================================		lda	dev_num		jsr	id_disk			;go see if it belongs to me		bcc	its_my_puppyvol_exit		brl	main_exitits_my_puppy;==========================================================================;move the name into the user's buffer.;==========================================================================		ldy	#pblk_08_vol		lda	[my_pblk_ptr],y		;copy user's buffer pointer to		sta	temp_ptr		;direct page		iny		iny		lda	[my_pblk_ptr],y		sta	temp_ptr+2		stz	case_bits		;all upper case please		bit	fst_attr		;if the high bit is set skip Upper/Lower stuff		bpl	@no_case_change		lda	#Å$0020			;set mask		sta	case_bits@no_case_change		lda	pcount		bne	class1;==========================================================================;before we send the name we have to add in the damn leading slash.;==========================================================================		lda	gstring			;get the length		inc	a		sta	[temp_ptr]		;length of the name		inc	temp_ptr		;bump past length byte		bne	class0_name		inc	temp_ptr+2class0_name		ldy	#$0001			;start at the beginning		longa	off		sep	#$20			;8 bit moves please		lda	#'/'		sta	[temp_ptr]		;store the leading slashclass0_loop		lda	gstring+1,y		sta	[temp_ptr],y		cpy	gstring		beq	@were_done		iny		bra	class0_loop@were_done		longa	on		rep	#$20;==========================================================================;Since this is a class zero call lets set the pcount to three so all the;parameters will be returned to the caller.;==========================================================================		lda	#$0003			;setup pcount		sta	pcount		bra	do_bitmapclass1;==========================================================================;If we get here we need to verify that the buffer is large enought to hold;the volume name.;;diagram;                ______________;               | Buffer size  | W;               |--------------|;               | Name Length  | W;               |--------------|;               | Leading '/'  | B;               |--------------|;               |     THE      |;               |   REST OF    | 'n';               |  THE  NAME   |;               |______________|;;==========================================================================		lda	gstring			;get the length of the volume name		tax		inc	a		sta	math_temp		;save the size of the name + slash.		sec		lda	[temp_ptr]		sbc	#$0004			;minus overhead		bmi	too_small		;get out of here!		cmp	math_temp		beq	size_ok		bcs	size_ok		ldy	#$0002		lda	math_temp		sta	[temp_ptr],y		;store the length of the nametoo_small		sec		lda	#buff_too_small		;return the errorback_to_exit	brl	vol_exitsize_ok;==========================================================================;now move the name to the user's buffer.;==========================================================================		ldy	#$0002			;index to the length result		lda	math_temp		sta	[temp_ptr],y		iny		iny		lda	#delimiter+(delimiter*$100)		sta	[temp_ptr],y;==========================================================================;adjust the pointer to point to the beginning of the name buffer.;==========================================================================		phx		tya		clc		adc	temp_ptr		sta	temp_ptr		lda	#$0000		adc	temp_ptr+2		sta	temp_ptr+2		ply		sty	math_temp		ldy	#$0001		longa	off		sep	#$20class1_loop		lda	gstring+1,y		sta	[temp_ptr],y		cpy	math_temp		;are we done?		beq	@were_done		iny		bra	class1_loop@were_done		longa	on		rep	#$20;==========================================================================;adjust the pcount to reflect the number of parameters that the user still;wants.;==========================================================================		dec	pcount		dec	pcountdo_bitmap;==========================================================================;now lets see if the caller wants the total blocks on the volume;==========================================================================		dec	pcount		bpl	send_tot_blksend_volume	clcbackup2		brl	vol_exitsend_tot_blks		ldy	#msdos_vcr.total_sectors		lda	[msdos_vcr_ptr],y		ldy	#pblk_08_tot		sta	[my_pblk_Ptr],y		iny		iny		lda	#$0000		sta	[my_pblk_ptr],y;==========================================================================;see if the caller wants the number of free blocks.  We call calc_free_blks;to calculate the number of free blocks.  The routine returns the TOTAL;number of blocks available in the 'A' register.;==========================================================================		dec	pcount		bmi	end_volume		jsr	calc_free_blks		bcs	backup2			;some major error occured		ldy	#pblk_08_free		sta	[my_pblk_ptr],y		iny		iny		lda	#$0000		sta	[my_pblk_ptr],y;==========================================================================;do they want the file system ID?;==========================================================================		dec	pcount		bmi	end_volume		;no they do not!		lda	#fst_id		ldy	#pblk_08_id		sta	[my_pblk_ptr],y;==========================================================================;do they want to know my block size?;==========================================================================		dec	pcount		bmi	end_volume		;no they do not!		lda	#blk_size		ldy	#pblk_08_size		sta	[my_pblk_ptr],y		bra	end_volume		ENDP	if NOT read_only_fst then		Eject;==========================================================================;Clear_backup:  This routine will clear the backup bit for a file.;;Created:       may 27, 1987;Modified:      may 27, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               find_file;;Call Format:;;Class 0        Pathname pointer        (4 Bytes);;Class 1        PCount                  (2 Bytes);               Pathname pointer        (4 Bytes);;==========================================================================		longa	on		longi	onclear_backup	PROC	Export		with	my_dp;==========================================================================;Setup the general parameters.;==========================================================================		jsr	setup_params;==========================================================================;Process the file name and locate it.  On exit 'drvr_buf_ptr' points to the;file entry that we are suppose to act on.;==========================================================================		jsr	process_path		bcc	goodclear_exit		brl	main_exitgood		jsr	chk_disk_protect		ldy	#access_index		longa	off		sep	#$20;==========================================================================;Clear the backup bit for the file/directory;==========================================================================		lda	[drvr_buf_ptr],y		and	#backup_off		;clear the backup bit		sta	[drvr_buf_ptr],y; If we're dealing with a volume directory then we need to clear the backup bit; in the VCR also so that the disk and VCR match.       4/5/91 CAE		lda	[drvr_buf_ptr]		;get storage type		and	#$F0			;only want hi nibble		cmp	#volume_header		;is this a volume directory?		bne	@not_vol		;no - so branch		ldy	#msdos_vcr.access		lda	[msdos_vcr_ptr],y		and	#backup_off		;clear the backup bit in the vcr		sta	[msdos_vcr_ptr],y@not_vol		longa	on		rep	#$20;==========================================================================;Reset the I/O buffer pointer to the beginning of the buffer.;The request count and all that stuff is still correct from the find file;==========================================================================		lda	gbuf_addr		sta	drvr_buf_ptr		lda	gbuf_addr+2		sta	drvr_buf_ptr+2		jsr	write_with_cache		bra	clear_exit		ENDP	endif		Eject;======================================================================;Open:          This file contains code that is used to open a file on;               disk. ;;Created:       Apr 13, 1987;Modified:      Apr 16, 1988;Author:        Rob Turner;;Enter:         From GS/OS jmp table;;Input:         A = undefined;               X = (call number * 2);               Y = (class number * 2);               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set (exit via system exit routine);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               Device Dispatcher       (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes);               find_file               (subroutine);;Call Format:;;Class 0        Reference Number        (2 Bytes);               Pathname Pointer        (4 Bytes);               Reserved                (4 Bytes);;Class 1        PCount                  (2 Bytes);               Reference Number        (2 Bytes);               Pathname Pointer        (4 Bytes);               Request Access          (2 Bytes: New Format);               Resource Number         (2 Bytes);               (Returned Info);               Access                  (2 Bytes);               File Type               (2 Bytes);               Aux Type                (4 Bytes);               Storage Type            (2 Bytes);               Create Date/Time        (8 Bytes: Misc. Tools Format);               Mod Date/Time           (8 Bytes: Misc. Tools Format);               Option List Pointer     (4 Bytes);               EOF Data Fork           (4 Bytes);               Blocks Used Data Fork   (4 Bytes);               EOF Resource Fork       (4 Bytes);               Blocks Used Res. Fork   (4 Bytes);;======================================================================		longa	on		longi	onopen		PROC	Export		with	my_dp		Import	error_exit		Import	build_the_fcr;==========================================================================;Setup the defaults for the open call.;The defaults are set to OPEN resource number $0000(main data) and open file;as permitted. ;========================================================================== 		stz	resource_num		;set resource to main data fork		stz	access			;set users access to 'as permitted'		stz	users_access		;set the users access please.		jsr	setup_params		beq	class0		jsr	get_access		;get the user's access byte if avail		bcs	class0			;branch if no access provided 		jsr	get_res_num		;get the user's resource num if availclass0;==========================================================================;Now go and find the file we need.  If the disk is not MSDOS then we;never return from the call.  It will automatically exit thru 'SYS_EXIT';==========================================================================		jsr	process_path;==========================================================================;We get here when we have found the file and are ready to open it.;This section of code expects 'drvr_buf_ptr' to point to the file name to open;==========================================================================open_the_file		jsr	move_dir_entry		;put the disk entry in a common place		jsr	verify_storage		;make sure I can deal with the file		bcs	open_exit		;sorry bud;; Here's where I have to perform a little magic if the caller is attempting to; open the "resource fork" of a file.;		jsr	check_dup		;see if this is a duplicate open		bcs	open_exit		;yes this is a duplicate open		jsr	build_the_fcr		;build the file control record		bcs	open_exit;==========================================================================;Now that we have setup the entrire FCR we need to send back any info;that the user requested.;==========================================================================		ldy	#$0000			;default = Class zero type call		lda	call_number		;determine class		and	#class_mask		beq	class0_call		ldy	#$0002			;index to ref field for new class calls;==========================================================================;Return the file reference number to the caller.;==========================================================================class0_call		lda	[my_fcr_ptr]		sta	[param_blk_ptr],y		jsr	send_open_parms		bcc	open_exit		pha		jsr	remove_fcr		;remove this puppy		pla		secopen_exit		brl	main_exit;==========================================================================;==========================================================================;====== MAIN END OF OPEN CALL  ============================================;==========================================================================;==========================================================================;==========================================================================;now see how many parameters the user would like with the open call.;;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;==========================================================================send_open_parms		lda	pcount		cmp	#pcount5		;see if there is more then 4 params		bcc	end_send		;no additional parameters needed		sbc	#pcount5-1		pha;==========================================================================;If we fall thru to here then we know the user wants to receive additional;information with the open.  So we start sending the number of field;the user wants.  The routine that sends the info expects the following:;;               A = number of fields to send;               X = low word address of where to start storing the info;               Y = high word address ...;               one_entry  = the entry from the disk;==========================================================================		clc				;make a pointer to data start		lda	my_pblk_ptr		adc	#$000A		tax		lda	my_pblk_ptr+2		adc	#$0000		tay		pla				;recall number of params wanted		jsr	send_infoend_send		rts;=============================================================================;Now we check the storage type.  The only storage types that I know about are:;;(1) seedling   ($0010);(2) sapling    ($0020);(3) tree       ($0030);(4) pascal area        (Access not allowed to pascal area);(5) resource   ($0050);(6) purge_dir          (access not allowed to purged directory);(7) subdir     ($00D0);(8) subdir H           (access not allowed to header entry);(9) vol header ($00F0);;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;=============================================================================verify_storage		lda	storage_type		sta	entry_sto_type		cmp	#resource_type		beq	setup_access		ldx	resource_num	;make sure the resource number is zero		bne	bad_resource		cmp	#seedling_type		beq	setup_access		cmp	#subdir_type		beq	dir_access		cmp	#volume_header		bne	bad_storage;=============================================================================;If the file is a directory then we must set the access to read only;=============================================================================dir_access		lda	access			;make sure user wants read only		beq	force_read_only		;He wants as permitted, so force read		cmp	#write_access		bcs	bad_accessforce_read_only		lda	#read_access		sta	access		clc		rts;==========================================================================;Now we need to check the access.  If the access is 'as_permitted' then we;must convert the disk access to one of our types (read only, read write, etc) ;==========================================================================setup_access		lda	access		bne	verify_access;==========================================================================;Load the disk based access byte ;==========================================================================		ldx	#read_access		;assume read-only		lda	one_entry.attributes		and	#read_only		;read-only file?		bne	set_access		;yup...		ldx	#read_access+write_accessset_access		stx	access			;access now set from disk 		clc		rts;==========================================================================;make sure the user's access agrees with the disk based access.;==========================================================================verify_access		lsr	a		lsr	a			;does the user want write access?		bcc	exit_access		;no		lda	one_entry.attributes	;access byte from disk		and	#read_only		beq	bad_access		;write access not allowed		clcexit_access		rtsbad_resource		lda	#res_not_found		sec		rtsbad_access		lda	#invalid_access		sec		rtsbad_storage	lda	#bad_store_type		sec		rts;==========================================================================;see if the user provided resource number.;;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;==========================================================================get_res_num		lda	pcount		cmp	#$0004		bcc	end_res			;no resource number provided		ldy	#$0008		lda	[my_pblk_ptr],y		sta	resource_num		;save the resource. must be zero		beq	end_res			;default resource number so exit		dec	a		bne	not_in_range		;not even close.end_res		rts;==========================================================================;get_access     This routine will load the user's access byte if available;;;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = no more parameters;                          0 = more paramters may follow;               b = k;;==========================================================================get_access		lda	pcount		cmp	#$0003		bcc	no_params		;there is no parameters		ldy	#$0006		lda	[my_pblk_ptr],y		sta	users_access		;save the user's access please.		beq	end_access		;same as default access so exit;==========================================================================;access:;               00 = open as permitted  ;default value for open call;               01 = open for reading only;               02 = open for writing only;               03 = open for reading and writing;========================================================================== 		sta	access			;save user's choice		cmp	#read_write_acc+1		bcc	end_accessnot_in_range		lda	#parm_range_err		;I don't know what to do with this		brl	error_exit		;sorry budno_params		sec		rtsend_access		clc		rts		EndP;==========================================================================;Calculate the size of the root directory.  This is a pain but we cannot;assume that the root directory will be four blocks long. So we might as;well put the directory blocks in the cache while we are at it;;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = no more parameters;                          0 = more paramters may follow;               b = k;==========================================================================vol_file_size	Proc		with	my_dp		ldy	#msdos_vcr.root_dir_count		lda	[msdos_vcr_ptr],y	;get count of root directory entries		asl	a			;multiply by 32 (bytes per entry)		asl	a			;to determine size of root directory		asl	a		asl	a		asl	a		sta	one_entry.file_size		rts		ENDP		Eject;==========================================================================;This routine will build the FCR.;;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k; ;==========================================================================build_the_fcr	PROC		with	my_dp		ldy	#vcr.name		;pass in the name of the Volume please		lda	[my_vcr_ptr],y		;get the VP please		tax		iny		iny		lda	[my_vcr_ptr],y		tay				;High word of the VP		jsl	deref			;convert the VP to a real pointer						;return X&Y pointer to the name		pei	temp_ptr		;save the pointer I am going to use		pei	temp_ptr+2		stx	temp_ptr		;save the address of the string		sty	temp_ptr+2		lda	[temp_ptr]		;get the length word please		tay				;save the count		inc	a			;add one for the :		sta	gstring			;save the count		lda	#'::'		sta	gstring+2		;save the seperator		inc	temp_ptr		bne	@01		inc	temp_ptr+2@01		sep	#$20			;8-bit accumulator		longa	off@02		lda	[temp_ptr],y		;get a char please		sta	gstring+2,y		dey		bne	@02		rep	#$20		longa	on		pla		sta	temp_ptr+2		;restore the pointer I used		pla		sta	temp_ptr		ldx	#gstring		;pointer to the file name or Volume Name to Open		ldy	#^gstring		;high word		lda	#fcr.size		;size of FCR to allocate		sec				;better clear the buffer		jsl	alloc_fcr		;build a new fcr for file		bcc	success		rts				;return with the errorsuccess		jsl	deref			;convert VP to RP		stx	my_fcr_ptr		sty	my_fcr_ptr+2		jsr	setup_my_fcr		;build a pointer to local data		ldy	#vcr.open_cnt		;advance the open count please by one		lda	[my_vcr_ptr],y		inc	a		sta	[my_vcr_ptr],y		ldy	#msdos_fcr.status		lda	#$0000			;zero the status word		sta	[msdos_fcr_ptr],y		lda	#data_active		;restore the I/O buffer active bits		jsr	set_fcr_status		lda	access			;save the user's access		ldy	#fcr.access		ora	#set_global_clean		sta	[my_fcr_ptr],y		ldy	#fcr.vol_id		lda	[my_vcr_ptr]		;get the volume ID from the VCR		sta	[my_fcr_ptr],y		;and save it in the new FCR		ldy	#fcr.fst_id		lda	#fst_id			;save the ownership id word		sta	[my_fcr_ptr],y;==========================================================================;Now start saving data into my local data segment;==========================================================================		ldy	#msdos_fcr.storage		lda	storage_type		;save the storage type		sta	[msdos_fcr_ptr],y		cmp	#volume_header		;if file is a volume then calc EOF		bne	no_adjust2		jsr	vol_file_size		;calculate the EOF for the root volno_adjust2		ldy	#msdos_fcr.parent		lda	parent_blk		;save address of parent block number		sta	[msdos_fcr_ptr],y		ldy	#msdos_fcr.entry_offs		lda	entry_offset		;save offset to entry within parent blk		sta	[msdos_fcr_ptr],y		lda	resource_num		;opening resource fork?		bne	@do_rfork_stuff		;yes, use rfork_entry instead		ldy	#msdos_fcr.eof		;move the directory entry into the FCR		lda	one_entry.file_size		sta	[msdos_fcr_ptr],y		iny		iny		lda	one_entry.file_size+2		sta	[msdos_fcr_ptr],y		lda	one_entry.start_cluster		bra	@store_start@do_rfork_stuff		ldy	#msdos_fcr.eof		;move the directory entry into the FCR		lda	rfork_entry.file_size		sta	[msdos_fcr_ptr],y		iny		iny		lda	rfork_entry.file_size+2		sta	[msdos_fcr_ptr],y		lda	rfork_entry.start_cluster@store_start		ldy	#msdos_fcr.start_cluster		sta	[msdos_fcr_ptr],y		tay		bne	@not_root		;if 0, it's the root directory		ldy	#msdos_vcr.data_start	;calculate # of blocks of root directory		lda	[msdos_vcr_ptr],y		sec		ldy	#msdos_vcr.root_dir_block		sbc	[msdos_vcr_ptr],y		bra	@store_size@not_root		ldy	#msdos_vcr.cluster_size	;read cluster size out of BPB		lda	[msdos_vcr_ptr],y		and	#$00FF			;only a byte-sized parameter@store_size		ldy	#msdos_fcr.cluster_size		sta	[msdos_fcr_ptr],y	;store the # of blocks per cluster				ldy	#msdos_fcr.mod_date		lda	one_entry.date		sta	[msdos_fcr_ptr],y		ldy	#msdos_fcr.mod_time		lda	one_entry.time		sta	[msdos_fcr_ptr],y				ldy	#msdos_fcr.attributes		lda	one_entry.attributes		and	#$00FF			;clear high byte (not used)		sta	[msdos_fcr_ptr],y		jsr	setup_io_ptrs		;build pointers to data structures		jsr	setup_io_buf		bcc	no_prob		pha		jsr	remove_fcr		;remove this puppy		pla		secno_prob		rts		ENDP		Eject;======================================================================;check_vcr_first: This routine trys to find a vcr from the device number;               in 'A'.  If a vcr is found then no error is reported.;               otherwise the error is returned. ;;Created:       may 08, 1987;Modified:      may 08, 1987;Author:        Rob Turner;;;Enter:         from open call;;Input:         A = device number to find;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               dev_num                 ;device number we are looking for;;Output:        A = error code if carry set.;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               find_vcr;               math_temp;               my_vcr_ptr;;======================================================================		longa	on		longi	oncheck_vcr_first	PROC		with	my_dp		stz	math_tempsearch_loop		lda	math_temp		inc	a		sta	math_temp		jsl	get_vcr		bcc	good		rts;==========================================================================;If we find a vcr then make sure that I own it.;==========================================================================good		jsl	deref		stx	my_vcr_ptr		sty	my_vcr_ptr+2		ldy	#vcr.fst_id		lda	[my_vcr_ptr],y		cmp	#fst_id		bne	search_loop		ldy	#vcr.dev		;is this the correct device		lda	[my_vcr_ptr],y		cmp	dev_num		bne	search_loop		ldy	#vcr.status		lda	[my_vcr_ptr],y		and	#vcr_swapped		bne	do_mount		clc				;this is it.		rtsdo_mount		jsr	mount_volume		rts		ENDP		Eject;==========================================================================;Read:          This file contains code used to read data from a file.;               The types of files supported are:;;                       1) seedling;                       2) sapling;                       3) tree;                       4) directory;;Created:       May 16, 1987;Modified:      Apr 16, 1988;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               Device Dispatcher  (subroutine);               General I/O Buffer (1K buffer, I read 512 bytes);               and lots of other stuff to.;;Call Format:;;Class 0        Reference Number        (2 Bytes);               Pointer to Data Buffer  (4 Bytes);               Request Count           (4 Bytes);               Transfer Count          (4 Bytes);;Class 1        PCount                  (2 Bytes);               Reference Number        (2 Bytes);               Pointer to Data Buffer  (4 Bytes);               Request Count           (4 Bytes);               Transfer Count          (4 Bytes);               Cache Priority          (2 Bytes);;==========================================================================		longa	on		longi	onread		PROC	Export		with	my_dp		Import	send_partial		Import	num_seq_blks		lda	#drvr_read		;setup for device read		sta	drvr_call_num;==========================================================================;sets up parameters from GS/OS call block, and verifies class and max pcnt;;setup params returns the class in the Accumulator.  It also does the;load as the last instruction before the 'RTS';==========================================================================		jsr	setup_params		jsr	read_write_setup;==========================================================================;Go and get the newline length from the FCR and save it on zero page.;==========================================================================		stz	newline_len		;disable newline mode please;==========================================================================;We need to get the mask as well as the newline list pointer;==========================================================================		ldy	#fcr.mask		lda	[my_fcr_ptr],y		sta	newline_mask		beq	no_newline		ldy	#fcr.newline_len		lda	[my_fcr_ptr],y		sta	newline_len		beq	no_newline		;ok I like this read;==========================================================================;Since newline is enabled we must dereference the newline VP and save it;==========================================================================		ldy	#fcr.newline		lda	[my_fcr_ptr],y		tax		iny		iny		lda	[my_fcr_ptr],y		tay		jsl	deref		stx	newline_ptr		sty	newline_ptr+2;==========================================================================;When we finally get here we are thru with setting up the newline list;==========================================================================no_newline		ldy	#vcr.dev		lda	[my_vcr_ptr],y		sta	drvr_dev_num;==========================================================================;Just to be complete I guess I should check if the file is read enabled.;==========================================================================		ldy	#fcr.access		;check the user's access privs.		lda	[my_fcr_ptr],y		and	#ClrAllButAccess		cmp	#write_access		;does the file have write only access?		bne	i_can_read		;read is allowed		lda	#invalid_accesserror_out		sec		brl	main_exitI_can_read;==========================================================================;Now we need to move some variables from the FCR to zero page.;We do this just to make it easy to get to the variables.;;First lets move the current file marker and EOF to direct page;==========================================================================		jsr	setup_curr_mark		jsr	setup_curr_eof;==========================================================================;Now lets see if we are at the end of the file.;IF curr_mark = EOF THEN return EOF error;==========================================================================		lda	curr_mark+2		cmp	curr_eof+2		bcc	not_eof		lda	curr_mark		cmp	curr_eof		bne	not_eof		lda	#end_of_file		;sorry no more bytes to read		bra	error_outnot_eof;==========================================================================;OK go and get the storage type for the file;We use this field to determine how to read the file.;==========================================================================		ldy	#msdos_fcr.storage		lda	[msdos_fcr_ptr],y		cmp	#subdir_type		;trying to read a directory directly?		bcc	@allow_read		;no...		lda	#bad_store_type		;else error out (like HFS)		bra	error_out@allow_read		jsr	chk_swapped		;mount the volume if needed		bcc	disk_online		brl	main_exitdisk_online;==========================================================================;when we get here we have found the lost volume.  So we must reset our;flags and change our device number, in both the VCR and FCR;==========================================================================		lda	drvr_dev_num		;new device number		ldy	#vcr.dev		sta	[my_vcr_ptr],y		;update VCR		ldy	#vcr.status		lda	[my_vcr_ptr],y		and	#vcr_swapped_in		;set 'disk in' flag		sta	[my_vcr_ptr],y;==========================================================================;Now the disk is ready to be talked to;==========================================================================disk_in;==========================================================================;Now we need to compare req_cnt to EOF.;;IF (req_count + curr_mark) > EOF THEN;    req_cnt := (EOF-curr_mark);;NOTE: carry must be clear when we get here.;==========================================================================		lda	curr_mark		adc	user_req_cnt		sta	math_temp		lda	curr_mark+2		adc	user_req_cnt+2		cmp	curr_eof+2		bcc	not_greater		;no problem with request count		bne	too_large		lda	math_temp		cmp	curr_eof		;check lower 16 bits		bcc	not_greater		beq	not_greatertoo_large;==========================================================================;If the request is too large then we need to adjust the request count.;==========================================================================		sec		lda	curr_eof		sbc	curr_mark		sta	user_req_cnt		lda	curr_eof+2		sbc	curr_mark+2		sta	user_req_cnt+2not_greater;==========================================================================;see if newline is enabled.  If it is not then call the fast routines.;otherwise fall into snell mode.;==========================================================================		lda	newline_len		beq	fast_read		;runs like a bat out of hell!		dec	a			;see if this is a single char newline		bne	fast_read		lda	[newline_ptr]		and	#$00FF			;clear garbage byte		sta	newline_charfast_read;==========================================================================;If we get here we know that newline is disabled so we do not have to check;each character that we read.  This means that multiple blocks can be moved;into the user's buffer directly without having to go into the I/O buffer.;Note however that the last block is moved into the I/O buffer.;;before we can start sending multiple blocks we must empty the current;data block that is in our buffer.  If there are enough bytes to satisfy;the read request we just send the bytes and exit.;==========================================================================single_block		jsr	send_partial		bcc	fast_loop		clc		brl	end_read_write		;all done with read.;==========================================================================;First lets calculate how many bytes are left in this block.;==========================================================================fast_loop		lda	user_req_cnt+2		bne	do_seq_blks		lda	user_req_cnt		cmp	#blk_size+1		bcs	do_seq_blks		brl	send_last		;we have less then 512 bytes leftdo_seq_blks;==========================================================================;We know that the user still has more then 512 bytes to go before the read;request is satisfied.  So lets go and see if there are any sequential;blocks that we can read.  If there are no sequential blocks then we must;get the block address our selves and issue a read of one block.  This;of course makes mister happy face very sad since he will have to double;buffer.;==========================================================================		lda	newline_len		;newline mode enabled?		bne	single_block		;yup, can't read sequential blocks		jsr	num_seq_blks		;see if there are any sequential blks		beq	single_blockseq_avail;==========================================================================;when we get here we know that there are some sequential blocks that can;be read.  But we must see if the number of sequential blocks is less then;the number of blocks wanted.;==========================================================================		phy				;save starting block offset		txa				;put cluster # into accumulator		jsr	Cluster2Block		;convert to physical block #		clc		adc	1,s			;combine with offset		sta	drvr_blk_num		;save block number for read		stz	drvr_blk_num+2		stz	drvr_req_cnt		stz	drvr_req_cnt+2		pla				;clean up stack		lda	user_req_cnt+1		;first convert bytes wanted to blocks		lsr	a		cmp	math_temp		bcc	use_users_size		lda	math_temp		;use ALL sequential blocks.use_users_size		asl	a			;convert block count to bytes		sta	drvr_req_cnt+1;==========================================================================;Now setup the buffer pointer to point to the user's buffer.;==========================================================================		lda	users_buf_ptr		sta	drvr_buf_ptr		lda	users_buf_ptr+2		sta	drvr_buf_ptr+2		jsr	read_with_mount		bcc	cont001			;good.		brl	end_read_writecont001		jsr	rw_adjust		;adjust the following:;                                       	;(1) user_buf_ptr;                                       	;(2) tran_cnt;                                       	;(3) curr_mark;                                       	;(4) user_req_cnt		brl	fast_loop;==========================================================================;;==========================================================================send_last		jsr	send_partial		clc;==========================================================================;===== END of READ call.  We save the processor status and error code =====;=====                    We then send back the number of bytes that  =====;=====                    were read successfully.  Then we restore any=====;=====                    error condition and exit thru sys_exit.     =====;==========================================================================		Entry	end_read_writeend_read_write					;common exit for read and write		php		pha		ldy	#pblk_12_tran		lda	tran_cnt		sta	[my_pblk_ptr],y		iny		iny		lda	tran_cnt+2		sta	[my_pblk_ptr],y;==========================================================================;Save the current file marker after the read call completes.;==========================================================================		jsr	save_curr_mark		pla		plp		brl	main_exit;==========================================================================;bump_mark      This routine will adjust the following fields:;;               1) users_buf_ptr        := users_buf_ptr + bytes_sent;               2) curr_mark            := curr_mark + bytes_sent;               3) user_req_cnt         := user_req_cnt - bytes_sent;               4) tran_cnt             := tran_cnt+bytes_sent;input:;               A = number of bytes to bump fields by.;;Uses:          math_temp;==========================================================================		Entry	bump_markbump_mark		sta	math_temp		clc		lda	users_buf_ptr		adc	math_temp		sta	users_buf_ptr		bcc	do_mark		inc	users_buf_ptr+2		clcdo_mark;==========================================================================;IMPORTANT NOTES:;;               users_buf_ptr is always =< $00FFFFFF;;WARNING! --> CARRY must be clear when we get here!;==========================================================================		lda	curr_mark		adc	math_temp		sta	curr_mark		bcc	do_tran		inc	curr_mark+2		clcdo_tran;==========================================================================;IMPORTANT NOTES:;;               curr_mark+math_temp is always less the $00FFFFFF;;WARNING! --> CARRY must be clear when we get here!;==========================================================================		lda	tran_cnt		adc	math_temp		sta	tran_cnt		bcc	do_req_cnt		inc	tran_cnt+2do_req_cnt		sec		lda	user_req_cnt		sbc	math_temp		sta	user_req_cnt		bcs	end_bump		dec	user_req_cnt+2end_bump	rts;==========================================================================;Set_users_buf  This routine moves the users buffer pointer into;               drvr_buf_ptr.  This allows block read from a device driver;               to go directly to the users buffer.;==========================================================================set_users_buf		lda	users_buf_ptr		;bypass my I/O buffer		sta	drvr_buf_ptr		lda	users_buf_ptr+2		sta	drvr_buf_ptr+2		rts		ENDP		Eject;==========================================================================;send_partial   This routine will send data from the current file marker to;               the end of the data buffer.;;Input:         A = undefined;               X = indefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               curr_mark               (must be correct);;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = data transfer complete;                          0 = no error;               b = k;;Uses:          All registers;               move_block;==========================================================================send_partial	PROC		with	my_dp		Import	fill_io_buf;==========================================================================;first make sure the I/O buffer is filled to the brim.;==========================================================================		jsr	fill_io_buf		bcc	filled_up		;buffer is now ok		brl	end_read_write;==========================================================================;lets see how many bytes are left in the currently loaded data block.;==========================================================================filled_up		lda	curr_mark		and	#$01FF		sec		sbc	#blk_size		;Bytes_left := buf_size-curr_position		eor	#$FFFF			;(complemented math)		inc	a			;number of bytes left in buffer.;==========================================================================;now lets calculate how many bytes we need to send to the user;==========================================================================		ldx	user_req_cnt+2		bne	send_all_bytes		;he wants as many as I can give		cmp	user_req_cnt		beq	send_all_bytes		bcc	send_all_bytes		lda	user_req_cnt		;the user wants less then I havesend_all_bytes		sta	math_temp		tay;==========================================================================;If newline is enabled then we have to do processing on each character;so we avoid the block move routine.;==========================================================================		lda	newline_len		bne	check_newline;==========================================================================;If we get here then newline is disabled so use the block move instruction;==========================================================================		clc		lda	curr_mark		;adjust the starting position		and	#$01FF		adc	data_ptr		tax				;save low address of buf pointer		lda	#$0000		adc	data_ptr+2		cpy	#min_send_cnt		;minimum bytes needed to use blk move		bcc	send_small		pha				;push high word of buffer pointer		phx				;push low word of buffer pointer		pei	users_buf_ptr+2		;destination address		pei	users_buf_ptr		pea	$0000			;high word of count		phy				;number of bytes to send		pea	move_sinc_dinc		jsl	move_info		bra	end_partial;==========================================================================;This routine will transfer a request count of less than $20 characters to;the user's buffer.  We do this to speed things up.;==========================================================================send_small		stx	temp_ptr		sta	temp_ptr+2		;pointer to the user's buffer		dey		tya		bmi	end_partial		;zero bytes to move?		cmp	#$0002			;are we moving less then two bytes?		bcc	send_8_bit		dec	a			;second decrement for word check		ror	a			;is it an even transfer?		bcs	send_8_bit		deyloop_16		lda	[temp_ptr],y		sta	[users_buf_ptr],y		dey		dey		bpl	loop_16		bra	end_partialsend_8_bit		sep	#$20			;8 bit accumloop_8		lda	[temp_ptr],y		sta	[users_buf_ptr],y		dey		bpl	loop_8		rep	#$20;==========================================================================;Now that we have send the data adjust the pointers etc.;==========================================================================end_partial		lda	math_temp		jsr	bump_mark		lda	user_req_cnt		ora	user_req_cnt+2		beq	all_done		;request count satisfied		ldy	#msdos_fcr.status	;we are going to read another block so make sure		lda	[msdos_fcr_ptr],y	;the I/O buffer is clean		and	#file_dirty		beq	@not_dirty	if NOT read_only_fst then		jsr	flush_io_buffer		;write the dirty blocks to disk		bcc	@not_dirty		brl	main_exit	endif@not_dirty		clc		rtsall_done		sec		rts;==========================================================================;Below is the code used to handle the newline checking.  For this code we;set the accumulator into 8 bit mode so we do not overflow the user's;buffer.;==========================================================================check_newline		tax				;save newline length for a second		lda	curr_mark		;isolate block index		and	#$01FF		tay		sta	entries_checked		sec		lda	users_buf_ptr		sbc	entries_checked		sta	temp_ptr		lda	users_buf_ptr+2		sbc	#$0000		sta	temp_ptr+2		clc		tya		adc	math_temp		;calculate the last byte address		sta	entries_checked		dex				;see if this is a special case		bne	slow_read		php				;save the mode please		longa	off		sep	#$20			;short accumulatorfast_newline		lda	[data_ptr],y		sta	[temp_ptr],y		and	newline_mask		cmp	newline_char		beq	found_newline		iny		cpy	entries_checked		;are we done yet		bne	fast_newline		plp				;be nice and restore last mode please.		bra	end_partialfound_newline		plp				;restore last mode please		longa	on;==========================================================================;Number of bytes := Ending position minus starting position;               Y = ending position;       curr_mark = starting position;==========================================================================		lda	curr_mark		and	#$01FF		sta	math_temp		sec		tya		sbc	math_temp		inc	a		jsr	bump_mark		;adjust the pointers etc		stz	user_req_cnt		stz	user_req_cnt+2		sec		rts;==========================================================================;This routine is called when there is more then one newline character to;check.  This routine is slower then the above newline read since I have;to scan all newline characters against a list;==========================================================================slow_read;==========================================================================;newline_len := newline_len-1  So I can use it as an index into the newline;list.;==========================================================================*** removed 21-Jul-92 DAL -- See corresponding change in ProDOS FST;;;		dec	newline_len		php		longa	off		sep	#$20slow_newline		lda	[data_ptr],y		sta	[temp_ptr],y		and	newline_mask		tyx				;save index first		ldy	newline_len*** added 21-Jul-92 DAL -- decrement the count here instead of above		dey*** end 21-Jul-92next_newline		cmp	[newline_ptr],y		beq	found_one		dey		bpl	next_newline		txy				;restore index first		iny		cpy	entries_checked		;are we done yet		bne	slow_newline		plp				;be nice and restore last mode please.		brl	end_partialfound_one		txy				;restore Index first		bra	found_newline		ENDP		Eject;==========================================================================;fill_io_buf:   This routine will load into the I/O buffer the correct;               data blocks.  It will also adjust the FCR data;;               WARNING: curr_mark must not point beyond the current;               structure of the file, even though that mark may be within;               the file's EOF. This could happen if a file has a trailing;               portion which is all sparse from a position <128K to a;               position >128K. In this case the file is stored as a;               sapling, not a tree, but owns a sparse area that is;               logically within the "tree" range. In such a case,curr_mark;               must never be in that range when entering this routine.;;Input:         A = undefined;               X = indefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               curr_mark               (must be correct);               data_ptr;               msdos_fcr_ptr           (points to MSDOS data in FCR);;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               drvr_blk_num;               drvr_call_num;               drvr_buf_ptr;               drvr_req_cnt;               device_dispatcher;;;==========================================================================		longa	on		longi	onfill_io_buf	PROC		with	my_dp		stz	mark_changed		jsr	setup_curr_eof		lda	curr_mark		;is the mark zero?		ora	curr_mark+2		beq	mark_ok			;yes so don't subtract one		lda	curr_mark+2		cmp	curr_eof+2		;see if current mark = eof		bcc	mark_ok		lda	curr_mark		cmp	curr_eof		bcc	mark_ok			;no problem		sbc	#$0001			;curr_mark := curr_mark-1		sta	curr_mark		lda	curr_mark+2		sbc	#$0000		sta	curr_mark+2		dec	mark_changedmark_ok		jsr	standard_req		;read 512 bytes only;==========================================================================;Fill_data:     This routine will fill up the data block if it can.;;Below is pascal type segment which indicates how Fill_data works.;;   BEGIN;     blk_num := get_blk_address(curr_mark) ; {Get block address from index blk};     IF blk_num = $0000 THEN;        sparse_blk(data_buffer) ;       {Fill Index buffer with zeros};        ELSE;         IF curr_blk <> blk_to_read THEN;            read_blk(index_buffer) ;    {Load index block from disk};    END;;==========================================================================fill_datacluster_num	equ	index_ptrrel_blk_num	equ	index_ptr+2		jsr	get_data_num		;setup drvr_blk_num from index blk		stx	cluster_num		sta	rel_blk_num		ldy	#msdos_fcr.cluster_blk_num		cmp	[msdos_fcr_ptr],y	;already at the correct block?		bne	load_data		;no, must load new block		ldy	#msdos_fcr.curr_cluster	;same cluster?		txa		cmp	[msdos_fcr_ptr],y		beq	exit_fill_data		;block is already loaded!load_data		jsr	chk_data_clean		;make sure the data buffer is OK		bcs	outta_here		;must have gotten error during flush		lda	cluster_num		jsr	Cluster2Block		;convert cluster # to block #		clc		adc	rel_blk_num		;include block offset within cluster		sta	drvr_blk_num		;save as block # to read		stz	drvr_blk_num+2				lda	data_ptr		;read into FCR buffer		sta	drvr_buf_ptr		lda	data_ptr+2		sta	drvr_buf_ptr+2		jsr	read_with_mount		;read in the block please		bcs	outta_herestore_data_num		ldy	#msdos_fcr.curr_cluster	;update current cluster loaded fields		lda	cluster_num		sta	[msdos_fcr_ptr],y		ldy	#msdos_fcr.cluster_blk_num		lda	rel_blk_num		sta	[msdos_fcr_ptr],yexit_fill_data		clcoutta_here		php				;save error flag		pha				;save error code		bit	mark_changed		bpl	no_change		inc	curr_mark		bne	no_change		inc	curr_mark+2no_change		pla		plp		rts;==========================================================================; get_data_num:	Convert current mark into a relative block number from the;		beginning of the file.  Then walk the file's FAT chain to;		determine the cluster number and block number within the;		cluster.;; on exit:	X = cluster number containing block;		Acc = block # within cluster;		drvr_blk_num = physical block number		entry	get_data_numget_data_num; first, divide current mark by 512 to determine the relative block offset; (divide by 256 by ignoring the low byte, then divide by 2 by shifting; the upper 3 bytes right 1 bit.)		lda	curr_mark+3		;get high byte		lsr	a			;get low bit into carry		lda	curr_mark+1		;get middle two bytes		ror	a			;24-bit division by 2; we now have the relative block number in the accumulator		pha				;save on stack; cluster = start_cluster		ldy	#msdos_fcr.start_cluster		lda	[msdos_fcr_ptr],y	;get starting cluster		tax				;into X; while(rel_blk_num > cluster_size) {@while_loop		ldy	#msdos_fcr.cluster_size		lda	1,s			;get rel_blk_num		cmp	[msdos_fcr_ptr],y	;compare against cluster size		beq	@1			;if equal, try again		bcc	@end_loop		;found it!@1;	rel_blk_num -= cluster_size		sec		sbc	[msdos_fcr_ptr],y	;update loop counter		sta	1,s;	cluster = get_fat_entry(cluster)		txa				;get cluster number		jsr	get_fat_entry		;get next entry in chain		tax; }		bra	@while_loop@end_loop		pla				;retrieve final block offset (within cluster)		rts				;with cluster number in X;==========================================================================;Chk_data_clean will determine if the current data block needs to be ;written to disk before the new block is loaded;==========================================================================chk_data_clean		clc				;assume no errors (yea, right!)		phy		ldy	#msdos_fcr.status	;we are going to read another block so make sure		lda	[msdos_fcr_ptr],y	;the I/O buffer is clean		and	#data_dirty		beq	@not_dirty		;easy case.	if NOT read_only_fst then		jsr	flush_data_blk		;save the data to disk	endif@not_dirty		ply		rts				;carry will return any error		EndP		Eject;==========================================================================;num_seq_blks: This routine will calculate the number of sequential;               blocks in a file.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               index_ptr               (points to the index pointer);               curr_mark               (curr_mark must be on block boundary!);;Output:        A = number of blocks that are sequential;               X = starting cluster number;               Y = starting block offset within cluster;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          All registers;               math_temp               (just a temp counter);               check_cluster = entries_checked;		rel_blk_num = index_ptr+2;;==========================================================================		longa	on		longi	onnum_seq_blks	PROC			with	my_dp;==========================================================================;Local equates for this routine;==========================================================================check_cluster	equ	entries_checked		;(same ZP location different name)rel_blk_num	equ	index_ptr+2;==========================================================================;First we convert the current mark into a current cluster/block offset;==========================================================================		jsr	get_data_num		;get the cluster and block numbers		sta	rel_blk_num		;save starting block # position within cluster				ldy	#msdos_fcr.cluster_size	;calculate # of blocks remaining		sec				; within this cluster		sbc	[msdos_fcr_ptr],y		eor	#-1			;(complemented math)		inc	a		sta	math_temp		;store as # of sequential blocks (so far)				phx				;save starting cluster number		txa		inc	a			;increment for comparison below		sta	check_clustercalc_loop;==========================================================================;Retrieve the next cluster number in the chain, compare for sequentiality (?); and update the block count if it is sequential.;==========================================================================		txa				;cluster # to Acc		jsr	get_fat_entry		;read the FAT		bcs	seq_exit		;we have looked at the entire chain		cmp	check_cluster		;immediately follows previous cluster?		bne	seq_exit		;nope, not sequential		tax				;else save in X		inc	a			;bump for next comparison		sta	check_cluster		;setup for next compare		ldy	#msdos_fcr.cluster_size	;add cluster size to counter		clc		lda	[msdos_fcr_ptr],y		adc	math_temp		sta	math_temp		bra	calc_loopseq_exit;==========================================================================;return the number of sequential blocks and starting cluster #.;==========================================================================		plx				;load X with starting cluster		ldy	rel_blk_num		;return this too		lda	math_temp		;return number of sequential blocks		rts		ENDP	if NOT read_only_fst then		Eject;==========================================================================;Write:         This file contains code used to write data to a file.;               The types of files supported are:;;                       1) seedling;                       2) sapling;                       3) tree;;Created:       oct 06, 1987;Modified:      oct 15, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               Device Dispatcher  (subroutine);               General I/O Buffer (1K buffer, I read 512 bytes);               and lots of other stuff.;;Call Format:;;Class 0        Reference Number        (2 Bytes);               Pointer to Data Buffer  (4 Bytes);               Request Count           (4 Bytes);               Transfer Count          (4 Bytes);;Class 1        PCount                  (2 Bytes);               Reference Number        (2 Bytes);               Pointer to Data Buffer  (4 Bytes);               Request Count           (4 Bytes);               Transfer Count          (4 Bytes);               Cache Priority          (2 Bytes);;==========================================================================		longa	on		longi	onwrite		PROC	Export		with	my_dp		stz	seq_write_cnt		;reset sequential block counter		jsr	setup_params		;setup standard parameters		ldy	#fcr.access		;see if the file is write protected		lda	[my_fcr_ptr],y		and	#ClrAllButAccess		cmp	#write_access		bcs	write_ok		;write access is enabled.bad_access					; ;user cannot write to this file.		lda	#invalid_access		sec		brl	main_exitwrite_ok		ldy	#vcr.dev		;last known location of volume		lda	[my_vcr_ptr],y		sta	drvr_dev_num		;I hope that the disk is still here.		jsr	chk_disk_protectnot_protected		jsr	read_write_setup		jsr	setup_curr_mark		jsr	setup_curr_eof		jsr	setup_io_ptrs		;setup pointers to I/O buffer		jsr	chk_swapped		;mount the volume if needed		bcc	vol_online		brl	main_exit;==========================================================================; IF curr_mark NOT block_aligned THEN;==========================================================================vol_online		jsr	users_to_drvrs		;move user's pointer to driver's ptr		jsr	user_to_temp		;temp_ptr := user_buf_ptrblock_loop		lda	curr_mark		;see if we are block aligned		and	#$01FF		beq	block_aligned		;yes we are block aligned		jsr	partial_write		;write until data is block aligned.		bcs	write_exit		;major problem		bra	next_blockblock_aligned		lda	user_req_cnt+2		;is req_cnt >= 512?		bne	more_then_512		lda	user_req_cnt		cmp	#blk_size		bcc	less_then_512more_then_512		jsr	full_write		;transfer full 512 bytes.		bcs	write_exit		bra	next_block		;go to the next block please;==========================================================================;Less_then_512. we have less then 512 bytes to write.;==========================================================================less_then_512		jsr	partial_write		;write the partial block to disk		bcs	write_exit		;major problem.next_block		jsr	rw_adjust		;adjust the following:;                                       ;(1) user_buf_ptr;                                       ;(2) tran_cnt;                                       ;(3) curr_mark;                                       ;(4) user_req_cnt		lda	user_req_cnt+2		;see if we are done yet		bne	block_loop		lda	user_req_cnt		bne	block_loop		clcwrite_exit		php		pha		bcc	@10			;there is no error so skip flush		jsr	flush_file		;try to save the world@10		jsr	update_mark_eof		;make sure the mark is OK		ldy	#msdos_fcr.curr_eof	;update the current end of file please		lda	curr_eof		sta	[msdos_fcr_ptr],y		iny		iny		lda	curr_eof+2		sta	[msdos_fcr_ptr],y		lda	#file_dirty		jsr	set_fcr_status		;indicate that something changed.		jsr	standard_req		;make sure we write 512 bytes only		jsr	flush_blocks		;flush any blocks to disk.		bcs	write_failed		;bad news we cannot complete the flush!!!;       ;We know that the mark actually points to one past where the last byte is so;lets reduce the mark by one please;v00.06 a06;               		lda	curr_mark		bne	@no_high		dec	curr_mark+2@no_high		dec	curr_mark		clc		jsr	get_write_blk		;make sure I/O buffer is OK		bcs	write_failed		txa				;block to load		beq	holy_cow		;I hope not		jsr	load_data		;load the data buffer please		bcs	write_failedholy_cow		inc	curr_mark		bne	@low_only		inc	curr_mark+2@low_only		pla				;restore error code		plp		brl	end_read_write		;exit thru wonder code in read filewrite_failed		plx				;kill the old exit code		plp				;kill the old processor flag		sec				;make sure the error is set		brl	end_read_write		;exit please.;==========================================================================;Write blocks of 512 to disk;==========================================================================full_write		lda	#blk_size		jsr	range_chk_eof		;see if we overrun the EOF		bcs	eof_error		;sorry we have an eof error		jsr	standard_req		;transfer of 512 bytes		ldy	#msdos_fcr.status	;see if the data block is dirty		lda	[msdos_fcr_ptr],y		and	#data_dirty		beq	clean_blk		;no flush needed		jsr	flush_data_blk		;write the data block to disk		bcs	write_exit		;get out of here with the error codeclean_blk		jsr	user_to_temp		;temp_ptr := user_buf_ptr		clc		jsr	get_write_blk		;is there a current block allocated?		bne	block_allocated		;yes there is a block allocated.		jsr	chk_sparse		;is the user's data sparse?		bcc	do_flush		;data sparse so flush queued data blocks;               sec		jsr	get_write_blk		;allocate a block please		bcc	@no_error		brl	write_exit		;cannot allocate a new block?@no_error		pha		jsr	user_to_temp		;point to user's buffer		plablock_allocated		sta	drvr_blk_num		;save the block number to write.		jsr	user_to_data		;move user's data to data buffer		jsr	write_data_blk		;write the data block to disk.		rtsdo_flush		jsr	flush_blocks		;issue the flush command		rtsuser_to_data		lda	users_buf_ptr		;setup driver buffer pointer to		sta	drvr_buf_ptr		;point to the user's data!		lda	users_buf_ptr+2		sta	drvr_buf_ptr+2		rtseof_error		lda	#out_of_range		;you have pushed me too far!!!		sec		rts;               ldy     #$01FE          ;move 512 bytes please;user_loop       anop;               lda     [drvr_buf_ptr],y;               sta     [data_ptr],y;               dey;               dey;               bpl     user_loop;               rts;==========================================================================;partial_write: This routine will handle reading/writing a partial block;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;==========================================================================partial_write		jsr	build_index		;simulate a disk write		jsr	range_chk_eof		;see if we overrun the EOF		bcs	eof_error		;sorry we have an eof error		jsr	standard_req		;we can only write 512 bytes!		jsr	flush_blocks		;write any left over seq. blocks		bcs	end_partial		;error condition		clc		jsr	get_write_blk		;is there a current block allocated?		bne	block_is_avail		;there is a block allocated.; we know that the block is not allocated so check the data		jsr	chk_sparse		;AND (data NOT sparse)		bcc	is_sparse		;... (data IS sparse)		jsr	get_write_blk		;allocate a block for the new data		bcs	end_partial		pha				;save the block number		ldx	data_ptr		;clear the new data block		ldy	data_ptr+2		jsr	clear_index		plablock_is_avail		jsr	load_data		;load in the data block		bcs	end_partial		jsr	user_to_temp		jsr	merge_data		;add data to current block!		lda	#file_dirty+data_dirty		jsr	set_fcr_status		;indicate that something changed.		clc		rtsis_sparse		ldy	#msdos_fcr.data_blk_num		lda	[msdos_fcr_ptr],y	;is block already loaded?		beq	@sparse_loaded		ldy	#msdos_fcr.status		lda	[msdos_fcr_ptr],y		and	#data_dirty		beq	@just_clear_buf		;no need to update the data block		jsr	flush_data_blk		bcs	end_partial@just_clear_buf		ldx	data_ptr		;clear the new data block		ldy	data_ptr+2		jsr	clear_index		ldy	#msdos_fcr.data_blk_num		lda	#$0000		sta	[msdos_fcr_ptr],y	;is block already loaded?@sparse_loaded		jsr	build_index		;simulate a disk write		sta	drvr_req_cnt		stz	drvr_req_cnt+2		clcend_partial		rts;==========================================================================;Range_chk_eof  This routine will make sure the write call will work with;               the three byte eof.;;Input:         A = write_count;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               curr_eof        ;the current eof;;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;==========================================================================range_chk_eof		clc		adc	curr_mark		lda	#0000		adc	curr_mark+2		;check the high word		and	#$FF00			;clear the result		bne	range_err		clc		rtsrange_err		sec		rts;==========================================================================;write_data_blk This routine will write data blocks to disk. The code will;               determine if we can hold off writing to disk so we can;               gain performance by doing a multi-block transfer call.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               drvr_blk_num            ;block number to write;               drvr_buf_ptr            ;pointer to the data;;;Output:        A = error code if carry set otherwise undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;==========================================================================write_data_blk		lda	seq_write_cnt		;do we have anything to write?		beq	new_block		;no		lda	drvr_blk_num		;is this a sequential block write?		dec	a		cmp	seq_write_blk		beq	bump_seq		;bump the sequential counter		lda	drvr_blk_num		;save block number to write		pha		lda	drvr_buf_ptr		pha		lda	drvr_buf_ptr+2		pha		jsr	flush_blocks		;write any seq. blocks to disk		plx		stx	drvr_buf_ptr+2		plx		stx	drvr_buf_ptr		plx		stx	drvr_blk_num		stz	seq_write_cnt		bcs	end_write_data		;errornew_block		inc	seq_write_cnt		;advance the number of sequential blks		lda	drvr_blk_num		sta	seq_write_blk		;starting block for write call		jsr	move_to_data_buf		lda	drvr_buf_ptr		sta	seq_write_start		lda	drvr_buf_ptr+2		sta	seq_write_start+2end_write_data		lda	#data_clean		;indicate that we have written block.		jsr	clr_fcr_status		jsr	standard_req		;set drvr_req_cnt to 512 bytes.		clc				;exit		rtsbump_seq		inc	seq_write_cnt		;advance the block counter		inc	seq_write_blk		;update new last sequential block		lda	user_req_cnt+2		bne	end_write_data		lda	user_req_cnt		cmp	#blk_size*2		bcs	end_write_data		ldy	#msdos_fcr.data_blk_num		lda	drvr_blk_num		cmp	[msdos_fcr_ptr],y	;Should I Copy the data to the buffer		bne	end_write_data		;Do not move the data.		jsr	do_data_update		bra	end_write_data;;This routine copies the user's data to the I/O Buffer;;input: A = block number;move_to_data_buf		ldy	#msdos_fcr.data_blk_num		cmp	[msdos_fcr_ptr],y	;is block already loaded?		bne	io_buf_ok		;don't worry about I/O buffer updatedo_data_update		pei	drvr_buf_ptr+2		;address of user's data		pei	drvr_buf_ptr		pei	data_ptr+2		;destination address		pei	data_ptr		pea	$0000			;high word of count		pea	blk_size		;number of bytes to send		pea	move_sinc_dinc		jsl	move_infoio_buf_ok	rts;==========================================================================;flush_blocks:  This routine will write out any data blocks that have not;               been written to disk.  If will also make sure that the I/O;               buffer contains valid data.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = error code if carry set otherwise undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;==========================================================================		Entry	flush_blocksflush_blocks		lda	seq_write_cnt		;is there anything to write?		bne	must_write		clc		rtsmust_write		stz	seq_write_cnt		;reset the sequential block counter		stz	drvr_req_cnt		;setup the write count		asl	a			;convert blocks to bytes		sta	drvr_req_cnt+1		lsr	a			;now get the starting block		dec	a			;subtract one please		pha		sec		lda	seq_write_blk		sbc	1,s		sta	drvr_blk_num		;starting block number		pla				;fix the stack		lda	seq_write_start		sta	drvr_buf_ptr		lda	seq_write_start+2		sta	drvr_buf_ptr+2		;pointer to the data		jsr	write_with_mount		bcs	flush_error		jsr	standard_req		clcflush_error		rts;==========================================================================;Set temp_ptr to the user's buffer pointer;==========================================================================user_to_temp		lda	users_buf_ptr		sta	temp_ptr		;set pointer to head of data		lda	users_buf_ptr+2		sta	temp_ptr+2		rtsusers_to_drvrs		lda	users_buf_ptr		sta	drvr_buf_ptr		;set pointer to head of data		lda	users_buf_ptr+2		sta	drvr_buf_ptr+2		rts;==========================================================================;merge_data:    This routine will add in the user's data into the I/O;               buffer.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               curr_mark               ;current file marker;               msdos_fcr_ptr           ;points to file control record;               data_ptr                ;points to data block in I/O buffer.;               temp_ptr                ;points to user data;               user_req_cnt            ;used by build_index;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;;               b = k;;               drvr_req_cnt            ;equals bytes moved;;;uses:          all registers;               math_temp;==========================================================================merge_data		jsr	build_index		;'A' = 1 to $1FF		sta	math_temp		;save count		sta	drvr_req_cnt		;simulate a write to disk.		dec	a			;A,X,Y perserved by 'update..' routine		pha		tay				;'Y' = 0 to $1FE (move count)		clc		lda	curr_mark		and	#$01FF		adc	1,s			;make index from END of buffer		tax				;index into data buffer		pla				;fix the stack		longa	off			;block after the merge		sep	#$20merge_loop		lda	[temp_ptr],y		;pointer to user's data		phy				;save user index		txy		sta	[data_ptr],y		;store in the I/O buffer		dex		ply		dey		bpl	merge_loop		;I/O buffer updated.		longa	on		rep	#$20		clc		lda	curr_mark		;save the mark		pha		adc	math_temp		sta	curr_mark		lda	curr_mark+2		pha		adc	#$0000		sta	curr_mark+2		jsr	clr_to_boundary		;Clear to blk boundary		pla		sta	curr_mark+2		pla		sta	curr_mark		rts;==========================================================================;See if we have to deal with a sparse block.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               curr_mark               ;current file marker;               msdos_fcr_ptr           ;pointer to file control record;               temp_ptr                ;pointer to user's data buffer;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = sparse;                          0 = not sparse;               b = k;;uses:          all registers;               math_temp;;FUNCTION sparse():boolean; BEGIN;  index := (curr_mark MOD 512);  sparse := true;  While (index < block_size) and (index < user_req) and (sparse = true) DO;        BEGIN;           IF data[index] <> 0 THEN;              sparse := flase;           index := index + 1;        END; END;==========================================================================chk_sparse		jsr	user_to_temp		;temp_ptr := user_buf_ptr		jsr	build_index		tay				;number of bytes to scan		dey				;force 1 to $0200 to 0 to $01FF		longa	off		sep	#$20			;short accum for testscan_loop		lda	[temp_ptr],y		;pointer to user's data		bne	non_sparse		dey		bpl	scan_loop		longa	on		rep	#$20			;restore 16 bit mode		clc		rts				;user data is all sparsenon_sparse		longa	on		rep	#$20			;restore 16 bit mode		sec		rtsbuild_index		lda	curr_mark		;number of bytes to check in user buf.		and	#$01FF			;0 to $1FF		pha		sec		lda	#blk_size		;calc number of bytes to scan		sbc	1,s			;range $0001 to $0200		ply				;fix the stack		ldy	user_req_cnt+2		;how many bytes do we need to write?		bne	full_scan		cmp	user_req_cnt		bcc	full_scan		lda	user_req_cntfull_scan		rts		ENDP	endif		Eject;==========================================================================;update_mark_eof:;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               curr_mark               ;current file marker;               curr_eof                ;current end of file;               msdos_fcr_ptr           ;pointer to file control record;;Output:        A = restored;               X = restored;               Y = restored;               P = nvmxdizc;                   ..000...;;               b = k;==========================================================================update_mark_eof	PROC		pha		phx		phy		lda	curr_mark+2		cmp	curr_eof+2		bcc	end_update		;EOF still OK		beq	chk_low_eof		bra	update_the_eofchk_low_eof		lda	curr_mark		cmp	curr_eof		beq	end_update		bcc	end_update		;EOF still OKupdate_the_eof		lda	curr_mark+2		sta	curr_eof+2		;save the high byte		lda	curr_mark		sta	curr_eof		;save the low byteend_update		ply		plx		pla		rts		ENDP	if NOT read_only_fst then		Eject;==========================================================================;get_write_blk: This routine will return the block number for the new data.;               If the file has a block allocated then that block number;               is returned otherwise a new block is allocated for the file.;               If the file needs to be expanded then it will be.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = allocate a new block if block not allocated;                          0 = just return current block number. (0 or blk num);               b = k;;               curr_mark               ;current file marker;               msdos_fcr_ptr           ;points to file control record;;Output:        A = block number of error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;;uses:          all registers;               math_temp;==========================================================================get_write_blk	PROC		with	my_dp		php				;save check flag.		php		pla		sta	alloc_chk_flag		lsr	a			;are we looking for a		bcs	do_allocation		jsr	chk_allocation		rts;;If here then we need to allocate or return the current block.;do_allocation		clc		lda	curr_mark		adc	#$0001		sta	data_eof		lda	curr_mark+2		adc	#$0000		sta	data_eof+2		jsr	eof_to_blks		;convert current position to blks.		lda	data_storage		;storage type needed (seed,sapling,tree)		cmp	#seedling_type		bne	sapling_case		brl	add_new_block		;just go and get the block pleasesapling_case		cmp	#sapling_type		bne	tree_case;;IF new_type = sapling THEN;   IF old_type = seedling THEN;      seedling_to_sapling;   ELSE;      add_index;;		ldy	#msdos_fcr.storage	;current storage type		lda	[msdos_fcr_ptr],y		cmp	#seedling_type		bne	add_new_block		jsr	seed_to_sap		;convert a seedling to a sapling		bcc	add_new_block		rts;;IF new_type = tree THEN;   IF old_type = seedling THEN;      BEGIN;          seedling_to_sapling;          sapling_to_tree;      END;   ELSE;      IF old_type = sapling THEN;         sapling_to_tree;      ELSE;         IF old_type = tree THEN;            BEGIN;              IF master_index[curr_mark] = nil THEN;                 add_master_index;              add_index;            END;tree_case		ldy	#msdos_fcr.storage	;current storage type		lda	[msdos_fcr_ptr],y		cmp	#seedling_type		bne	not_seed		jsr	seed_to_sap		;convert seedling to a sapling		bcs	abort_tree		jsr	sapling_to_tree		;convert a sapling to a tree		bcc	add_new_blockabort_tree	rtsnot_seed		cmp	#sapling_type		;is this a sapling file		bne	not_sapling		jsr	sapling_to_tree		;convert a sapling to a tree		bcs	abort_tree		bra	add_new_blocknot_sapling		lda	curr_mark+2		;see if the index block is allocated		lsr	a		ldx	master_ptr		ldy	master_ptr+2		jsr	get_index_blk		;get the index block out of master blk		tax		bne	add_new_block		;we do not need to add an index block		jsr	tree_to_tree		;add a new index block		bcs	abort_tree;==========================================================================;Now lets see if we need to add a new block or return the current block.;==========================================================================add_new_block		jsr	calc_free_blks		;make sure that we have a block avail.		bcs	abort_tree		;just exit		tax		bne	we_have_room		brl	out_of_roomwe_have_room		ldy	#msdos_fcr.master_blk_num ;see if we should even have looked at		lda	[msdos_fcr_ptr],y		beq	no_master		;there is no master block for this file		lda	curr_mark+2		;see if we need the master index block		lsr	a		ldx	master_ptr		;get the block number from index block		ldy	master_ptr+2		jsr	get_index_blk		;A = block number		tax		bne	cont01			;there is an index block		ldy	#msdos_fcr.status	;see if old index needs to be flushed		lda	[msdos_fcr_ptr],y		and	#index_dirty		beq	no_index_flush		jsr	flush_index		bcs	abort_tree		;exitno_index_flush		ldx	master_ptr		ldy	master_ptr+2		lda	curr_mark+2		lsr	a			;now build a new index block		jsr	new_block		bcs	abort_tree		;sorry major problem		pha				;save the block number		lda	#master_dirty+index_dirty+file_dirty		jsr	set_fcr_status		;indicate master block dirty		ldx	index_ptr		;clear the new buffer		ldy	index_ptr+2		jsr	clear_index		pla		ldy	#msdos_fcr.index_blk_num		sta	[msdos_fcr_ptr],ycont01		ldy	#msdos_fcr.index_blk_num		cmp	[msdos_fcr_ptr],y	;is the block loaded?		beq	no_master		;no problem		sta	key_block		;save the block wanted.		jsr	flush_index		;write any dirty blocks to disk		bcs	end_write_blk		;major problems		lda	key_block		;load in the index block please		pha		jsr	load_index		plx				;restore block number		bcs	end_write_blk		txa		ldy	#msdos_fcr.index_blk_num		sta	[msdos_fcr_ptr],yno_master		lda	curr_mark+1		lsr	a		and	#$00FF		ldx	index_ptr		;get the block number from index block		ldy	index_ptr+2		jsr	get_index_blk		;A = block number		tax		bne	have_blk		ldy	#msdos_fcr.status	;see if data block needs to be written		lda	[msdos_fcr_ptr],y		and	#data_dirty		beq	data1_clean		jsr	flush_data_blk		bcs	end_write_blkdata1_clean		ldx	index_ptr		ldy	index_ptr+2		lda	curr_mark+1		lsr	a			;now build a new index block		and	#$00FF		jsr	new_block		bcs	end_write_blk		;sorry major problem		pha				;save the block number		ldy	#msdos_fcr.data_blk_num		sta	[msdos_fcr_ptr],y	;save the new block number		lda	#index_dirty+file_dirty+data_dirty		jsr	set_fcr_status		;indicate master block dirty		plahave_blk		jsr	load_data		bcs	end_write_blk		lda	drvr_blk_num		clcend_write_blk		rts		Entry	load_dataload_data					;input A= block to load		ldy	#msdos_fcr.data_blk_num		cmp	[msdos_fcr_ptr],y	;is block already loaded?		beq	exit_load_data		pha				;save the block to load		ldy	#msdos_fcr.status		lda	[msdos_fcr_ptr],y		and	#data_dirty		beq	dont_update		jsr	flush_data_blk		bcs	end_load_datadont_update		lda	data_ptr		sta	drvr_buf_ptr		lda	data_ptr+2		sta	drvr_buf_ptr+2		lda	1,s			;get the block number to load		sta	drvr_blk_num		jsr	read_with_mount		;read in the new data block		bcs	end_load_data		ldy	#msdos_fcr.data_blk_num	;update current loaded block		lda	drvr_blk_num		sta	[msdos_fcr_ptr],y		plaexit_load_data		clc		sta	drvr_blk_num		rtsend_load_data		plx				;fix the stack please		sec		rts;==========================================================================;new_block:     This routine will allocate a new block from the system;               and add the block number in the index block pointed to;               by the X and Y registers.;;Input:         A = index;               X = low word pointer to index block;               Y = high word pointer to index block;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = block number allocated or error code;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;;uses:          all registers;               temp4_ptr;==========================================================================new_block		stx	temp4_ptr		;pointer to the index block		sty	temp4_ptr+2		pha				;save the index		jsr	calc_free_blks		;make sure that we a free block		bcs	add_failed		tax		beq	to_no_room		lda	#$0001			;allocate one block		ldx	#$0000			;start at block zero		jsr	find_free_blks		bcs	add_failed		phx				;save the block number		jsr	bump_blks_used		lda	3,s			;get the index please		tay				;save the low index		ora	#$0100		tax				;save the high index		pla		longa	off		sep	#$20			;8 bit mode		sta	[temp4_ptr],y		xba		txy		sta	[temp4_ptr],y		longa	on		rep	#$20			;16 bit mode		xba		plx				;fix the stack		clc		rtsadd_failed	plx				;fix the stack		rtsto_no_room	pla				;fix the stack		brl	out_of_roombump_blks_used		ldy	#msdos_fcr.blks_used		lda	[msdos_fcr_ptr],y		inc	a			;advance the blocks used count		sta	[msdos_fcr_ptr],y		lda	#dirEntry_dirty		;the directory entry needs updating when flushed		jsr	set_fcr_status		rts;==========================================================================;get_index_blk: This routine will load a block number out of an index block;;Input:         A = index;               X = low word pointer to index block;               Y = high word pointer to index block;               P = nvmxdizc;                   ..000...;               b = k;;;Output:        A = block number;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;uses:          all registers;               temp_ptr;==========================================================================		Entry	get_index_blkget_index_blk		stx	temp_ptr		sty	temp_ptr+2		tax				;low word index		ora	#$0100			;high word index		tay		longa	off		sep	#$20			;8 bit accum		lda	[temp_ptr],y		;get the high word block number		xba		txy		lda	[temp_ptr],y		;get the low word block number		longa	on		rep	#$20			;16 bit accum		rts;==========================================================================;Convert a seedling file into a sapling file.;==========================================================================seed_to_sap		jsr	flush_blocks		;flush anydata still around		bcc	do_sap		rtsdo_sap		jsr	calc_free_blks		;see how many blocks we have		tax		bne	lots_of_room		brl	out_of_room		;sorry bud not todaylots_of_room		lda	#$0001			;go get me a new block		ldx	#$0000			;start looking at block zero		jsr	find_free_blks		bcs	end_to_sap		txa				;new key block		pha		ldy	index_ptr		sty	temp4_ptr		ldy	index_ptr+2		sty	temp4_ptr+2		dec	a			;see if we should flip data and index		ldy	#msdos_fcr.key_blk		cmp	[msdos_fcr_ptr],y		beq	do_flip		txa		ldy	#msdos_fcr.index_blk_num		sta	[msdos_fcr_ptr],y	;save the new index block number		jsr	bump_blks_used		ldy	#msdos_fcr.key_blk	;data block address		lda	[msdos_fcr_ptr],y		ldy	#$0000			;store as first entry in index block		jsr	add_index		lda	#index_active+index_dirty+file_dirty		jsr	set_fcr_status		;mark index block active		pla				;restore key block		ldx	#sapling_type		jsr	update_new_type		rtsend_to_sap		rtsdo_flip		ldy	#msdos_fcr.status	;see if the data block is dirty		lda	[msdos_fcr_ptr],y		and	#data_dirty		beq	onward		jsr	flush_data_blk		bcc	onward		plx				;fix the stack!!!!		rtsonward		ldy	#msdos_fcr.key_blk	;load in the data block		lda	[msdos_fcr_ptr],y		sta	drvr_blk_num		ldy	#msdos_fcr.data_blk_num		sta	[msdos_fcr_ptr],y	;update current data block		lda	data_ptr		sta	drvr_buf_ptr		lda	data_ptr+2		sta	drvr_buf_ptr+2		jsr	read_with_mount		;read in the data block		bcc	onward2		plx				;fix the stack		rtsonward2		pla				;get the new block number		ldy	#msdos_fcr.data_blk_num		sta	[msdos_fcr_ptr],y	;now the data block has changed		ldy	#$0000			;store as first entry in index block		jsr	add_index		lda	#index_active+index_dirty+file_dirty+data_dirty		jsr	set_fcr_status		;mark index block active		jsr	bump_blks_used		ldy	#msdos_fcr.key_blk		lda	[msdos_fcr_ptr],y		ldy	#msdos_fcr.index_blk_num		sta	[msdos_fcr_ptr],y	;now the index is new		ldx	#sapling_type		jsr	update_new_type		rtsout_of_room		lda	#volume_full		sec		rtssapling_to_tree		jsr	calc_free_blks		;see how many blocks we have		tax		beq	out_of_room		;sorry bud not today		lda	#$0001			;go get me a new block		ldx	#$0000			;start looking at block zero		jsr	find_free_blks		bcs	end_to_tree		txa				;new key block		pha		ldy	#msdos_fcr.master_blk_num		sta	[msdos_fcr_ptr],y	;save the master index blk num		jsr	bump_blks_used		lda	master_ptr		sta	temp4_ptr		lda	master_ptr+2		sta	temp4_ptr+2		ldy	#msdos_fcr.key_blk	;current data block		lda	[msdos_fcr_ptr],y		ldy	#$0000			;store as first entry in index block		jsr	add_index		lda	#master_active+master_dirty+file_dirty		jsr	set_fcr_status		;mark index block active		pla				;restore key block		ldx	#tree_type		jsr	update_new_typeend_to_tree		rtstree_to_tree		jsr	calc_free_blks		;see how many blocks we have		tax		beq	out_of_room		;sorry bud not today		lda	#$0001			;go get me a new block		ldx	#$0000			;start looking at block zero		jsr	find_free_blks		bcs	end_to_tree		phx				;save the block number		lda	master_ptr		sta	temp4_ptr		lda	master_ptr+2		sta	temp4_ptr+2		jsr	bump_blks_used		;must not use X register		lda	curr_mark+2		lsr	a		tay				;index into master block		txa				;new index block		jsr	add_index		lda	#master_dirty+file_dirty		jsr	set_fcr_status		;indicate master index block is dirty		ldy	#msdos_fcr.status	;see if current index block is dirty		lda	[msdos_fcr_ptr],y		and	#index_dirty		beq	mister_clean		jsr	flush_index		bcc	mister_clean		plx				;fix the stack		rtsmister_clean		ldy	#msdos_fcr.index_blk_num ;the current index block		pla				;restore new index block number		sta	[msdos_fcr_ptr],y		lda	#index_dirty+file_dirty		jsr	set_fcr_status		;indicate that this block is dirty		ldx	index_ptr		ldy	index_ptr+2		;clear the current index		jsr	clear_index		clc		rts		Entry	clear_indexclear_index		stx	temp4_ptr		;zero out the buffer pointed to by		sty	temp4_ptr+2		;X and Y		ldy	#$01FE		lda	#$0000clr_index	sta	[temp4_ptr],y		dey		dey		bpl	clr_index		rts;==========================================================================;update_new_type:;               This routine will update the FCR to reflect the new storage;               type, and key block for a file;;Input:         A = new key block;               X = new storage type;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_fcr_ptr           ;points to file control record;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;uses:          all registers;==========================================================================update_new_type		pha				;save new key block		ldy	#msdos_fcr.key_blk		sta	[msdos_fcr_ptr],y		ldy	#msdos_fcr.entry_type		lda	[msdos_fcr_ptr],y	;is this a resource type?		cmp	#resource_type		beq	is_resource		txa				;save the new storage type		sta	[msdos_fcr_ptr],y		lda	1,s			;save the new key block		ldy	#msdos_fcr.file_id		sta	[msdos_fcr_ptr],yis_resource		pla				;fix the stack		ldy	#msdos_fcr.storage	;store the new storage type		txa		sta	[msdos_fcr_ptr],y		jsr	flush_file		;force directory update.		rts		ENDP	endif	if NOT read_only_fst then		Eject;==========================================================================;chk_allocation:;               This routine will return the block number of a data block;               if the file contains a data block;;Input:         A = undefined;               X = undefin;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_fcr_ptr       ;points to file control record;;Output:        A = block number if 'z' = 0;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error and 'z' flag valid;                         1  = no block allocated;                         0  = A = block number;               b = k;;;uses:          all registers;==========================================================================;==========================================================================;IF (curr_mark = tree) AND (storage <> tree) THEN;   no_block allocated;;==========================================================================chk_allocation	PROC		with	my_dp		lda	curr_mark+2		;see if we need the master index block		lsr	a		ldx	master_ptr		;get the block number from index block		ldy	master_ptr+2		jsr	get_index_blk		;A = block number		tax		bne	cont01			;there is an index block;;IF (type = tree) AND (index = sparse) THEN block_not_allocated;chk_tree		ldy	#msdos_fcr.storage		lda	[msdos_fcr_ptr],y		cmp	#tree_type		;does this puppy even have a master blk?>		bne	chk_sapling		;there is no master index block		clc		rts;;IF (type <> tree) AND (curr_mark = tree) THEN block_not_allocated;chk_sapling		lda	curr_mark+2		;is the mark in tree range		lsr	a		beq	index_loaded		;mark not in tree range		bra	no_blockcont01		ldy	#msdos_fcr.index_blk_num		cmp	[msdos_fcr_ptr],y	;is the block already loaded?		beq	index_loaded		pha				;save the block number		ldy	#msdos_fcr.status		lda	[msdos_fcr_ptr],y		and	#index_dirty		;is the current index dirty?		beq	index1_clean		jsr	flush_index		bcc	index1_clean		plx		rtsindex1_clean		pla				;retore block number		ldy	#msdos_fcr.index_blk_num		sta	[msdos_fcr_ptr],y	;save the new block please		jsr	load_index		bcc	index_loaded		rtsindex_loaded		lda	curr_mark+1		lsr	a		and	#$00FF		ldx	index_ptr		;get the block number from index block		ldy	index_ptr+2		jsr	get_index_blk		;A = block number		tax		bne	exit_chk_alloc;;IF (type = sapling) AND (data = sparse) THEN block_not_allocated;		ldy	#msdos_fcr.storage		lda	[msdos_fcr_ptr],y		cmp	#sapling_type		;does this puppy even have an index blk		bcc	chk_seedling		;there is no index block		txa				;reset the flag pleaseexit_chk_alloc		clc		rtschk_seedling		lda	curr_mark+1		lsr	a		and	#$00FF		beq	get_key_blk		;mark < 512no_block		ldx	#$0000		sep	#$02			;set the 'Z' flag		clc		rtsget_key_blk		ldy	#msdos_fcr.key_blk		lda	[msdos_fcr_ptr],y		tax				;setup the x register with the block number		clc		rts		Entry	load_indexload_index						;enter with A = block number						;next 3 lines added 8/6/90 by Monte Benaresh		pha				;save block # for a moment		jsr	standard_req		;set drvr_req_cnt to $200		pla				;restore block number		sta	drvr_blk_num		lda	index_ptr		sta	drvr_buf_ptr		lda	index_ptr+2		sta	drvr_buf_ptr+2		jsr	read_with_cache		rts		ENDP	endif		Eject;==========================================================================;Clr_to_boundary        This routine will clear data from the current EOF;                       to the end of the block.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               curr_mark               ;current file marker;               curr_eof                ;current end of file;               msdos_fcr_ptr           ;points to file control record;               data_ptr                ;points to data block in I/O buffer.;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;;               b = k;;; IF (eof >= (curr_mark AND $FE00 + 512)) THEN;    EXIT(clr_to_boundary); IF eof > curr_mark THEN;    clear_index := eof; ELSE;    clear_index := curr_mark; clear_block;==========================================================================		longa	on		longi	onclr_to_boundary	PROC		with	my_dp		lda	curr_eof		pha		lda	curr_eof+2		;save the current end of file		pha		lda	curr_mark		pha				;save the current mark		lda	curr_mark+2		pha		lda	curr_mark		;if block aligned then exit		and	#$01FF		bne	not_aligned		brl	exit_clr		;we do not have to clear anythingnot_aligned;;curr_mark := ((curr_mark and $FE00) + 512);		clc		lda	curr_mark		;move to a block boundary		and	#$FE00		adc	#blk_size		;add in 512 bytes		sta	curr_mark		lda	curr_mark+2		adc	#$0000		sta	curr_mark+2;; IF (eof >= (curr_mark AND $FE00 + 512)) THEN;    EXIT(clr_to_boundary);		lda	curr_eof+2		cmp	curr_mark+2		beq	chk_low		bcs	exit_clr		;EOF not in this block		bcc	second_if		;continue processchk_low		lda	curr_eof		cmp	curr_mark		bcs	exit_clr		;EOF not in this block;; IF EOF < curr_mark AND $FE00 THEN;    clear_index := curr_mark;second_if		lda	3,s			;get the low word of the mark		and	#$FE00		sta	curr_mark		lda	curr_eof+2		cmp	1,s			;check high word		beq	second_low		bcs	third_if		;EOF is in this block		bcc	use_mark		;EOF not in this blocksecond_low		lda	curr_eof		cmp	curr_mark		bcs	third_if		;EOF is in the block		bcc	use_mark		;EOF not in this block;; IF eof > curr_mark THEN;    clear_index := eof;third_if		lda	curr_eof+2		;is eof > curr_mark		cmp	1,s			;high word of curr_mark		beq	third_low		bcs	use_eof			;clear from EOF		bcc	use_mark		;clear from current markthird_low		lda	curr_eof		cmp	3,s		bcs	use_eof			;use the eof as the valueuse_mark		lda	3,s			;get the low word of current mark		and	#$01FF			;clear garbage		beq	exit_clr		;do not clear the buffer		bra	do_clearuse_eof		lda	curr_eof		and	#$01FF		beq	exit_clr		;do not clear the bufferdo_clear		tay				;make an index into block		iny		cpy	#blk_size		beq	exit_clr		tya				;can we clear the block fast		lsr	a		bcc	clear_it_fast		lda	#$0000			;clear value		longa	off		sep	#$20			;8 bit mode		bra	enter			;start the loopclear_it		sta	[data_ptr],y		inyenter		cpy	#blk_size		;are we done		bcc	clear_it		longa	on		rep	#$20		bra	exit_clrclear_it_fast		lda	#$0000		bra	enter_fastfast_loop		sta	[data_ptr],y		iny		inyenter_fast		cpy	#$0200			;are we done		bcc	fast_loopexit_clr		pla				;restore the curr_mark		sta	curr_mark+2		pla		sta	curr_mark		pla		sta	curr_eof+2		;restore the current end of file		pla		sta	curr_eof		lda	#data_dirty+file_dirty		jsr	set_fcr_status		rts		ENDP		Eject;==========================================================================;Close:         This routine will close a file.;;Created:       aug 04, 1987;Modified:      aug 04, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;;Call Format:;;Class 0        Reference Number        (2 Bytes);;Class 1        PCount                  (2 Bytes);               Reference Number        (2 Bytes);;==========================================================================		longa	on		longi	onclose		PROC	Export;==========================================================================;First preprocess the call to setup the needed parameters.;==========================================================================		jsr	setup_params		dec	close_flag		;call slug ripple please	if NOT read_only_fst then		jsr	flush_file		;force data to the disk		bcc	flushed		brl	main_exit	endifflushed		jsr	remove_fcr		brl	main_exit		ENDP		Eject;==========================================================================;flush:         This routine will flush a file.;;Created:       aug 04, 1987;Modified:      aug 04, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;;Call Format:;;Class 0        Reference Number        (2 Bytes);;Class 1        PCount                  (2 Bytes);               Reference Number        (2 Bytes);;==========================================================================		longa	on		longi	onflush		PROC	Export;==========================================================================;First preprocess the call to setup the needed parameters.;==========================================================================		jsr	setup_params		dec	close_flag		;call slug_ripple please;       New code added March 27, 1990 to support fast/slow flush,;       by Monte Benaresh, based on Andy Stadler's proposed;       changes.		lda	pcount			;check number of params given by caller		cmp	#2			;did he specify type of flush?		bcc	slow_flush		;too few, default to full flushchoose_flush					;caller specified type of flush;               valid flush types are:;                       $0000 = full flush, data and directory blocks;                       $8000 = fast flush, data blocks only		ldy	#4			;offset to flush type in param block		lda	[param_blk_ptr],y	;get flush type		asl	a			;get high bit		beq	flush_type_ok		;low bits must be 0!bad_flush_type					;invalid value for flush type		lda	#parm_range_err		sec		bra	flush_done		;return with errorflush_type_ok					;get here with high bit of flush type in carry		bcc	slow_flush		;flush type was $0000fast_flush					;flush type was $8000		jsr	do_fast_flush		;write out all dirty data blocks, dirty;                                        bitmap blocks, and the directory entry;                                        only if it's been changed (mod date doesn't count!)		bra	flush_done		;handle error elsewhereslow_flush		jsr	flush_file		;force data to the diskflush_done		brl	main_exit		ENDP		Eject;==========================================================================;calc_curr_mark This routine will calculate the current mark for a file;               given BASE and DISPLACEMENT as input.;;Created:       may 23, 1987;Modified:      may 23, 1987;Author:        Rob Turner;;;Enter:         jsr;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               BASE                    (base from param block);                       $00 = Absolute;                       $01 = Backward From EOF;                       $02 = Forward From Current Mark;                       $03 = Backward From Current Mark;;               DISPLACEMENT            (displacement from param block);               msdos_fcr_ptr           (pointer to my data in FCR;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   .<<000..1 = error if out of range;                    |     0 = no error;                    |;                    |__   1 = error out of range any cases;                          0 = result greater then current EOF;;               b = k;;               curr_mark               (contains correct position for mark);;Uses:          All registers;;==========================================================================		longa	on		longi	oncalc_curr_mark	PROC;==========================================================================;Setup the current EOF;==========================================================================		jsr	setup_curr_eof;==========================================================================;Setup the current file marker.;==========================================================================		jsr	setup_curr_mark;==========================================================================;Now we need to decide which way we need to move the mark.;==========================================================================		lda	base		beq	absolute		dec	a		beq	back_from_eof		dec	a		beq	forward_mark;==========================================================================;If we fall thru to here then we need to set the mark backward from the;current mark.;==========================================================================backward_mark		sec		lda	curr_mark		sbc	displacement		sta	curr_mark		lda	curr_mark+2		sbc	displacement+2		sta	curr_mark+2		bcs	mark_okbad_range		sep	#carry+overflow		;set both carry and overflow flags		rts				;exit with carry set to indicate error;==========================================================================;User wants to set the mark backward from the current end of file;==========================================================================back_from_eof		sec		lda	curr_eof		sbc	displacement		sta	curr_mark		lda	curr_eof+2		sbc	displacement+2		sta	curr_mark+2		bcc	bad_rangemark_ok		clc		rts;==========================================================================;Set the mark forward from the current mark.;==========================================================================forward_mark		clc		lda	curr_mark		adc	displacement		sta	curr_mark		lda	curr_mark+2		adc	displacement+2		sta	curr_mark+2		bcc	check_rangegreater_EOF		clv				;mark greater then current EOF!		rts				;bad mark bud!;==========================================================================;Set the file marker to an absolute position.;==========================================================================absolute		lda	displacement		sta	curr_mark		lda	displacement+2		sta	curr_mark+2check_range;==========================================================================;Make sure the curr_mark =< EOF.;==========================================================================		lda	curr_mark+2		cmp	curr_eof+2		beq	check_low_word		;more checking to do		bcs	greater_eof		;value is greater then EOF		rts				;carry clear no problemcheck_low_word		lda	curr_mark		cmp	curr_eof		beq	good_mark		bcs	greater_eof		;value is greater then EOFgood_mark		clc		rts		ENDP		Eject;==========================================================================;Set_mark:      This routine will set a file position marker.;;Created:       may 23, 1987;Modified:      may 23, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               fill_io_buf;;Call Format:;;Class 0        Reference Number        (2 Bytes);               File Position           (4 Bytes);;Class 1        PCount                  (2 Bytes);               Reference Number        (2 Bytes);               Base                    (2 Bytes);                       00 = Absolute;                       01 = Backward From EOF;                       02 = Forward From Current Mark;                       03 = Backward From Current Mark;               Displacement            (4 Bytes);;==========================================================================		longa	on		longi	onset_mark	PROC	Export		with	my_dp;==========================================================================;First preprocess the call to setup the needed parameters.;==========================================================================		stz	base		jsr	setup_params		beq	class0;==========================================================================;Fall thru if this is a class1 call;==========================================================================		ldy	#pblk_16_base		jsr	check_base		ldy	#pblk_16_disp		bra	main_entryclass0;==========================================================================;If this is a class zero call then setup an index to the file position;and continue on.;==========================================================================		ldy	#$0002			;index to displacementmain_entry;==========================================================================;Save the user's requested displacement;==========================================================================		lda	[my_pblk_ptr],y		sta	displacement		iny		iny		lda	[my_pblk_ptr],y		sta	displacement+2;==========================================================================;Setup 'curr_eof' and 'curr_mark';;               IF (curr_mark < 00) or (curr_mark > EOF) THEN;                  BEGIN;                     Error:= position_out_of_range_error;                     EXIT(Set_Mark);                  END;==========================================================================		jsr	calc_curr_mark		bcc	set_the_mark		lda	#out_of_rangeset_mark_exit		brl	main_exitset_the_mark;==========================================================================;refill I/O buffer with the new data blocks needed.;==========================================================================		jsr	fill_io_buf		bcs	set_mark_exit;==========================================================================;go and update the FCR with the new curr_mark.;==========================================================================		jsr	save_curr_mark		clc;==========================================================================;Exit all happy since the call was successful;==========================================================================		bra	set_mark_exit		ENDP		Eject;==========================================================================;Get_mark:      This routine will return the file position marker.;;Created:       may 23, 1987;Modified:      may 23, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          All registers;;Call Format:;;Class 0        Reference Number        (2 Bytes);               File Position           (4 Bytes);;Class 1        PCount                  (2 Bytes);               Reference Number        (2 Bytes);               File Position           (4 Bytes);;==========================================================================		longa	on		longi	onget_mark	PROC	Export		with	my_dp		;==========================================================================;Call standard setup routine.;==========================================================================		jsr	setup_params;==========================================================================;Get the current file marker out of the FCR data area;==========================================================================		ldy	#msdos_fcr.curr_mark		lda	[msdos_fcr_ptr],y		tax				;save low word		iny		iny		lda	[msdos_fcr_ptr],y;==========================================================================;Store the current file position into the user's parameter block.;==========================================================================		ldy	#pblk_17_pos+2		;file position		sta	[my_pblk_ptr],y		dey		dey		txa		sta	[my_pblk_ptr],y		clc		brl	main_exit		ENDP	if NOT read_only_fst then		Eject;==========================================================================;Set_eof:       This routine will set the EOF of a file.;;Created:       jun 15, 1987;Modified:      jun 15, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          All registers;;Call Format:;;Class 0        Reference Number        (2 Bytes);               File Position           (4 Bytes);;Class 1        PCount                  (2 Bytes);               Reference Number        (2 Bytes);               Base                    (2 Bytes);                       00 = Absolute;                       01 = Backward From EOF;                       02 = Forward From Current Mark;                       03 = Backward From Current Mark;               Displacement            (4 Bytes);;==========================================================================		longa	on		longi	onset_eof		PROC	Export		with	my_dp		stz	base			;set default to absolute		stz	key_blk_changed;==========================================================================;Call standard setup routine.;==========================================================================		jsr	setup_params		beq	class0			;this is an old style call;==========================================================================;Now lets go and setup the base parameter please;==========================================================================		ldy	#pblk_18_base		jsr	check_base		ldy	#pblk_18_disp		bra	main_entryClass0		ldy	#pblk_18_odispmain_entry		lda	[my_pblk_ptr],y		sta	displacement		iny		iny		lda	[my_pblk_ptr],y		sta	displacement+2;==========================================================================;make sure the file is write enabled.;==========================================================================		ldy	#fcr.access		lda	[my_fcr_ptr],y		and	#ClrAllButAccess		cmp	#write_access		bcs	set_eof_ok		lda	#invalid_access		bra	set_eof_errorset_eof_ok		jsr	chk_disk_protect;==========================================================================;Get the current end of file out of the FCR data area and call routine;that will calculate the new eof.  The new value for the EOF is returned;in 'curr_mark';==========================================================================						;brk $B2		jsr	calc_curr_mark		php				;save results		lda	curr_mark		sta	displacement		lda	curr_mark+2		sta	displacement+2		plp						;Following code changed 7/21/90 by Monte Benaresh						;Since setup_real_eof finds the last physically allocated EOF of						;the file, and since that number can be greater than the logical						;EOF (when pre-allocated blocks exist beyond the logical EOF) or						;less (when a trailing portion of the file is entirely sparse),						;we need to call setup_real_eof before deciding whether we need						;to cut blocks.						;bcc    less_or_equal   ;new EOF is =< current EOF						;bvc    eof_greater     ;new EOF is > current EOF		bcc	calc_ok			;new EOF is =< current EOF		bvc	calc_ok			;new EOF is > current EOF						;The following error code was changed from "parm_range_err"						;to "out_of_range".  1/22/91 CAEbad_eof		lda	#out_of_range		;position out of rangeset_eof_error		secset_eof_exit		brl	main_exitcalc_ok						;next call added 8/6/90 by Monte Benaresh to fix bug						;introduced by change of 7/21/90		jsr	flush_file		;force any dirty blocks to disk		bcs	set_eof_error		;Major problems bud.		jsr	setup_real_eof		;generate EOF based on allocation not logical		bcs	set_eof_error		;Major problems bud.						;code added 7/21/90 by Monte Benaresh (see note above)		lda	curr_eof+2		;this points to last physical allocation		cmp	displacement+2		;determine whether we need to cut blocks		bcc	eof_greater		bne	less_or_equal		;this line added 8/8/90 by Monte Benaresh		lda	curr_eof		cmp	displacement		bcs	less_or_equaleof_greater		lda	displacement+2		and	#$FF00		bne	bad_eofsave_eof		jsr	update_fcr_eof		lda	key_blk_changed		;Did the Key Block for the file change?		beq	@no_key_changed		jsr	flush_file		;update both the Bitmap and Directory please		bra	set_eof_exit@no_key_changed		jsr	flush_io_buffer		;update the disk please		bra	set_eof_exit		;we are out of here;If we get here we know that the new EOF is equal to (easy) or less then;(hard) the current ("real") EOF.  If the EOF is less then the current eof then;we must release blocks from the disk.less_or_equal		jsr	flush_file		;force any dirty blocks to disk		bcs	set_eof_error		;Major problems bud.						;jsr    setup_real_eof  ;generate EOF based on allocation not logical						;bcs    set_eof_error   ;Major problems bud.						;last 2 lines not needed now -- Monte Benaresh, 7/21/90		lda	displacement+2		cmp	curr_eof+2		bne	must_be_less		;the new eof is less then old eof		lda	displacement		cmp	curr_eof						;bne    must_be_less		beq	save_eof		;same as what caller wants, but save this EOF						;since it was calculated by setup_real_eof						;Monte Benaresh -- 7/21/90						;next 2 removed 7/21/90						;clc						;bra    set_eof_exit    ;nothing to domust_be_less;If we get here we know the new EOF is less then the old EOF so we must;do the cut back.;convert current eof into relative block number;last_block := ((current_eof-1) DIV 512);last_block = $0000 to $7FFF		lda	curr_eof		ora	curr_eof+2		;if zero DO NOT subtract one		beq	no_sub1		lda	curr_eof		bne	ar1		dec	curr_eof+2ar1		dec	curr_eofno_sub1		lda	curr_eof+1		;convert EOF to blocks		lsr	a		sta	last_blk		;save block number of last block		beq	save_eof		;file is already a seedling;convert new_eof into relative block number;new_last := ((displacement-1) DIV 512);new_last = $0000 to $7FFF		lda	displacement		sta	tran_cnt		lda	displacement+2		sta	tran_cnt+2		lda	tran_cnt		ora	tran_cnt+2		;if zero DO NOT subtract one		beq	no_sub		lda	tran_cnt		bne	ar2		dec	tran_cnt+2ar2		dec	tran_cntno_sub		lda	tran_cnt+1		;convert EOF to blocks		lsr	a		sta	new_last		;save block number of last block;WHILE last_blk <> new_last DOwhile_loop		lda	last_blk		cmp	new_last		beq	save_eof		;just exit with new EOF;We now need to remove the last block in the file		jsr	cut_block		;reduce blocks by one		bcs	update_and_exit		;error occured		dec	last_blk		bra	while_loopupdate_and_exit		pha		jsr	update_fcr_eof		pla		sec		brl	set_eof_error;Update the FCR with the new EOF value.  Also mark the FCR dirtyupdate_fcr_eof		ldy	#msdos_fcr.eof		lda	displacement		;store the NEW eof in the FCR		tax		sta	curr_eof		sta	[msdos_fcr_ptr],y		iny		lda	displacement+1		sta	[msdos_fcr_ptr],y		sta	curr_eof+1		ldy	#msdos_fcr.curr_eof	;update working EOF as well		txa		sta	[msdos_fcr_ptr],y		iny		lda	displacement+1		sta	[msdos_fcr_ptr],y		ldy	#msdos_fcr.status		lda	[msdos_fcr_ptr],y	;update file status word		ora	#file_dirty		;we need to write to disk on close		sta	[msdos_fcr_ptr],y;IF the new EOF is =< curr_mark THEN;   curr_mark := EOF		jsr	setup_curr_mark		jsr	fill_io_buf		;added 1/23/90 to fix "Bredon" sparse file shrink bug		bcc	@filledUp		rts@filledUp		lda	curr_mark+2		cmp	displacement+2		beq	check_lower		bcs	adjust_mark		bra	adjust_buffer		;current_mark < new EOFcheck_lower		lda	curr_mark		cmp	displacement		beq	no_adjust		bcs	adjust_markno_adjust		bra	adjust_bufferadjust_mark		lda	displacement		sta	curr_mark		lda	displacement+2		sta	curr_mark+2		jsr	save_curr_mark		;update the FCRadjust_buffer		jsr	clr_to_boundary		clc		rts;==========================================================================;Cut_block:     This routine will remove the last block from the file.;;Input:         last_blk (contains relative block number to delete. 0 thur n);;output:        A = error code if carry set.;;               WARNING: last_blk must not point beyond the current;               structure of the file, even though that block num may be within;               the file's EOF. This could happen if a file has a trailing;               portion which is all sparse from a position <128K to a;               position >128K. In this case the file is stored as a;               sapling, not a tree, but owns a sparse area that is;               logically within the "tree" range. In such a case, last_blk;               must never be in that range when entering this routine.;cut_block;The first thing we do is to convert last_blk into a mark value.		stz	curr_mark		stz	curr_mark+2		lda	last_blk		asl	a		sta	curr_mark+1		jsr	load_indexes		;load the I/O buffer correctly		bcc	@no_error		rts@no_error;After we call data_blk_num we know that drvr_blk_num contains the data;block that is to be removed from the file.		jsr	get_data_num		;setup drvr_blk_num		ldx	drvr_blk_num		beq	gone			;sparse block		jsr	dealloc_block		;remove the block please		bcc	dec_gone		rts				;return errordec_gone		jsr	dec_blk_count		;blks_used := blks_used-1gone;IF (index_block = true) AND (deleted_entry > 1) THEN;   BEGIN						;if this is anything but a seedling, we must check whether it's time toÉ						;Érelease an index block and possibly change storage type		ldy	#msdos_fcr.storage	;IF (index_block = true)		lda	[msdos_fcr_ptr],y		cmp	#sapling_type		bcs	index_true		;index_block = TRUE		rts				;we MUST be doneindex_true		lda	curr_mark+1		;AND (deleted_entry > 1) THEN		lsr	a		and	#$00FF		cmp	#$0002		bcc	first_ELSE		;deleting first or second entry;     zero_index(deleted_blk) ;          ;clear the entry from index block;     index_dirty := true ;              ;and mark index dirty						;fall through if not on 1st or 2nd entrynot_sapling		jsr	zero_one_index		;zero an entry in index blkupdate_eof		clc		rts;     END;ELSE; IF (index_block = true) and (one_entry  = true) and (storage = sapling) THEN;    BEGIN;      convert_sapling_to_seedling;    ENDfirst_else					;we know index_block = true		cmp	#$0001			;did we just delete entry #0?		bcc	second_else		;check tree case		ldy	#msdos_fcr.storage		lda	[msdos_fcr_ptr],y		cmp	#sapling_type		;(stoarge = sapling)?		bne	not_sapling		jsr	zero_one_index		jsr	sapling_seed		;convert the sapling file to seedling		bcc	update_eof		rts;  ELSE;   IF (index_block = true) and (one_entry = true) and (storage = tree) THEN;      BEGINsecond_else					;we are deleting the 1st entry in index blk		jsr	remove_index		;remove the index and update master		bcc	cont01		rtscont01						;did we just eliminate 2nd index block?		lda	curr_mark+2		lsr	a		and	#$007F			;see if we are going to be a sapling		cmp	#$0001			;see if there is only one entry left		bne	update_eof		;no conversion yet		jsr	tree_sapling		bcc	update_eof		rts;===============END of CUT_BLOCK;==========================================================================;This routine will setup curr_eof with the EOF based on blocks allocated;to the file instead of logical EOF.  For example, an file can have an;EOF of 0, but have hundreds of blocks allocated to it.  This happens;when a file is created with a request to pre-allocate space.;Diagram:                  (A)            (B)            (C);;     |               | $00 to $7F  | $00  to  $FF  | $000  to  $1FF  |;     |               |             |               |                 |;     | MUST BE ZERO  |<- master  ->|<-   index   ->|<- Byte index  ->|;     |_______________|_____________|_______________|_________________|;     | | | | | | | | | | | | | | | | | | | | | | | | | | | | | | | | |;     |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|;     |               |               |               |               |;    3 2             2 4             1 6             0 8             0 0;;       WARNING: Index blocks must be clean because they will be;       overwritten!;;==========================================================================setup_real_eof		stz	new_eof		stz	new_eof+2		;init new eof		ldy	#msdos_fcr.storage		lda	[msdos_fcr_ptr],y		cmp	#tree_type		;(storage = tree)?		beq	@calc_tree		cmp	#sapling_type		beq	@calc_sapling		clc		rts				;seedling works OK@calc_tree		ldx	master_ptr		;setup pointer to master index block		ldy	master_ptr+2		jsr	get_last_index		;get the lndex to the last index block out of master index		clc				;A=index $00 thru $7F, X = block number.		asl	A			;double index		sta	new_eof+2		txa				;load block if needed		ldy	#msdos_fcr.index_blk_num		cmp	[msdos_fcr_ptr],y	;is the block already loaded?		beq	@calc_sapling		jsr	load_index		;load in the index block						;bcc    @calc_sapling		bcc	@index_ok		;changed 8/7/90 by Monte Benaresh		rts				;sorry friend no EOF change today!@index_ok					;next lines added 8/7/90 by Monte Benaresh		ldy	#msdos_fcr.index_blk_num		lda	drvr_blk_num		;save the block num of the index block		sta	[msdos_fcr_ptr],y@calc_sapling		ldx	index_ptr		;get address of the index block in memory		ldy	index_ptr+2		jsr	get_last_index		;get the lndex to the last data block out of index block		clc				;A=index $00 thru $FF, X is not used!		asl	A			;double index		ora	new_eof+1		;set the new value		sta	new_eof+1		clc		lda	new_eof		adc	#blk_size		sta	curr_eof		lda	new_eof+2		adc	#$0000		sta	curr_eof+2		;update the global EOF that is used by SET_EOF		clc		rts;==========================================================================;Get_Last_index will walk an index block looking for the last valid entry.;;input:         X&Y =   pointer to index buffer;;output:        A =     index offset 0 thru $FF;               X =     block numberget_last_index		stx	temp2_ptr		;setup pointer to lower half of the buffer		sty	temp2_ptr+2		clc		txa		adc	#$0100			;point to high half of the index block		sta	temp3_ptr		tya		adc	#$0000		sta	temp3_ptr+2		ldy	#$00FF			;start from end of index block@loop		longa	off		sep	#$20		lda	[temp3_ptr],y		;grab the high block number		xba				;put high block number in upper byte		lda	[temp2_ptr],y		;get the low block number               		longa	on		rep	#$20		tax				;check for zero		bne	@done			;we have the block number		dey		bpl	@loop			;try the next location		sec		rts@done		tya		clc				;A=Index, X = block number		rts;==========================================================================;This routine will zero out one entry in the master index block. It will;also mark the index block as being dirty and decrement the block countremove_index		ldy	#msdos_fcr.index_blk_num ;is the index block sparse?		lda	[msdos_fcr_ptr],y		bne	@not_sparse		;there is an index block		rts@not_sparse	jsr	dec_blk_count		lda	curr_mark+2		lsr	a		and	#$007F		tay		ora	#$0100		tax		longa	off		sep	#$20		lda	[master_ptr],y		sta	drvr_blk_num		;save the one we are deleting		lda	#$00		sta	[master_ptr],y		;zero the deleted entry please		txy		lda	[master_ptr],y		sta	drvr_blk_num+1		;high byte of one to delete		lda	#$00		sta	[master_ptr],y		longa	on		rep	#$20		ldy	#msdos_fcr.status		lda	[msdos_fcr_ptr],y		ora	#master_dirty+file_dirty		sta	[msdos_fcr_ptr],y		ldx	drvr_blk_num		;remove the index block please		jsr	dealloc_block		rts;==========================================================================;This routine will zero out one entry in the current index block. It will;also mark the index block as being dirty;==========================================================================zero_one_index		ldy	#msdos_fcr.index_blk_num ;is the index block sparse?		lda	[msdos_fcr_ptr],y		bne	@not_sparse		;there is an index block		rts@not_sparse	lda	curr_mark+1		lsr	a		and	#$00FF		tay		ora	#$0100		tax		longa	off		sep	#$20		lda	#$00		sta	[index_ptr],y		;zero the deleted entry please		txy		sta	[index_ptr],y		longa	on		rep	#$20		ldy	#msdos_fcr.status		lda	[msdos_fcr_ptr],y		ora	#index_dirty+file_dirty		sta	[msdos_fcr_ptr],y		rts		Entry	dec_blk_countdec_blk_count					; reduce number of blocks used by a file by one		ldy	#msdos_fcr.blks_used		lda	[msdos_fcr_ptr],y		dec	a		sta	[msdos_fcr_ptr],y		lda	#dirEntry_dirty		;the directory entry needs updating when flushed		jsr	set_fcr_statusbad_news		rts		ENDP	endif	if NOT read_only_fst then		Eject;==========================================================================;sapling_seed:  This routine will convert a sapling file into a seedling;               file. (I hope)  Of course in the long run it will do the;               conversion.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_fcr_ptr           (points to VCR local data);               index_ptr               (MUST point to the index block);;Output:        A = error code if carry set otherwise undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          All registers;               msdos_fcr_ptr;;;==========================================================================		longa	on		longi	onsapling_seed	PROC		with	my_dp;==========================================================================;Grab the first entry out of the index block.  This is to become the new;key pointer for the file.;==========================================================================		lda	[index_ptr]		sta	drvr_blk_num		ldy	#blk_size-$0100		lda	[index_ptr],y		sta	drvr_blk_num+1		lda	#$0000			;now delete the block from the index		sta	[index_ptr]		sta	[index_ptr],y		;get the high byte		ldx	drvr_blk_num		jsr	update_key_blk		ldy	#msdos_fcr.storage		lda	#seedling_type		tax		sta	[msdos_fcr_ptr],y	;change storage type to seedling		ldy	#msdos_fcr.entry_type		lda	[msdos_fcr_ptr],y		cmp	#resource_type		beq	is_res_type1		txa		sta	[msdos_fcr_ptr],yis_res_type1		jsr	dec_blk_count		;reduce count by one		lda	#index_clean		jsr	clr_fcr_status		;do not write a index block		ldy	#msdos_fcr.index_blk_num		lda	[msdos_fcr_ptr],y	;block number for index block		tax				;used by deallocate		beq	exit		lda	#$0000		sta	[msdos_fcr_ptr],y	;zero the block number		jsr	dealloc_block		;remove the block please		bcc	exit		rtsexit		stz	curr_mark		;reload the correct blocks		stz	curr_mark+2		jsr	fill_io_buf		rts;==========================================================================;We need to see if this is a resource file.  IF it not then we need to;update both the key block and file id fields.  Otherwise we only adjust;the key block field.;;input:         X = new key block;==========================================================================		Entry	update_key_blkupdate_key_blk		ldy	#msdos_fcr.file_id		lda	[msdos_fcr_ptr],y		ldy	#msdos_fcr.key_blk	;update the key block pointer		cmp	[msdos_fcr_ptr],y		bne	only_key_blk		;update only the key block		txa		ldy	#msdos_fcr.file_id		sta	[msdos_fcr_ptr],yonly_key_blk		txa		ldy	#msdos_fcr.key_blk		sta	[msdos_fcr_ptr],y		inc	key_blk_changed		;indicate that the key block has changed		rts		ENDP	endif	if NOT read_only_fst then		Eject;==========================================================================;tree_sapling:  This routine will convert a tree file into a sapling;               file. (I hope)  Of course in the long run it will do the;               conversion.;;Input:         A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;               msdos_fcr_ptr           (points to VCR local data);               master_ptr              (MUST point to the master block);;Output:        A = error code if carry set otherwise undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          All registers;               msdos_fcr_ptr;;;==========================================================================		longa	on		longi	ontree_sapling	PROC		with	my_dp;==========================================================================;Grab the first entry out of the master index block.  This is to become the;new key pointer for the file.;==========================================================================		stz	curr_mark		;force mark to zero for correct		stz	curr_mark+2		;loading of index blocks		jsr	fill_io_buf		;make sure the I/O buffer looks Ok		bcc	have_index		rtshave_index		lda	[master_ptr]		sta	drvr_blk_num		ldy	#blk_size-$0100		lda	[master_ptr],y		and	#$00FF			;clear any garbage left		sta	drvr_blk_num+1		lda	#$0000		sta	[master_ptr]		;clear the last entry please		sta	[master_ptr],y		jsr	dec_blk_count		ldx	drvr_blk_num		jsr	update_key_blk		ldy	#msdos_fcr.storage		lda	#sapling_type		tax		sta	[msdos_fcr_ptr],y	;change storage type to sapling		ldy	#msdos_fcr.entry_type		lda	[msdos_fcr_ptr],y		cmp	#resource_type		beq	is_res_type2		txa		sta	[msdos_fcr_ptr],yis_res_type2		lda	#master_clean		jsr	clr_fcr_status		;do not write a index block		ldy	#msdos_fcr.master_blk_num		lda	[msdos_fcr_ptr],y	;block number for master index block		tax				;used by deallocate		beq	exit		lda	#$0000		sta	[msdos_fcr_ptr],y	;zero the block number		jsr	dealloc_block		;remove the block please		rtsexit		clc		rts		ENDP	endif		Eject;==========================================================================;Get_eof:       This routine will return the current EOF for an open file.;;Created:       may 23, 1987;Modified:      may 23, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;Uses:          All registers;;Call Format:;;Class 0        Reference Number        (2 Bytes);               EOF                     (4 Bytes);;Class 1        PCount                  (2 Bytes);               Reference Number        (2 Bytes);               EOF                     (4 Bytes);==========================================================================		longa	on		longi	onget_eof		PROC	Export		with	my_dp;==========================================================================;Call standard setup routine.;==========================================================================		jsr	setup_params;==========================================================================;Get the current end of file out of the FCR data area;==========================================================================		ldy	#msdos_fcr.eof		lda	[msdos_fcr_ptr],y		tax				;save low word		iny		iny		lda	[msdos_fcr_ptr],y		ldy	#pblk_19_eof+2		sta	[my_pblk_ptr],y		dey		dey		txa		sta	[my_pblk_ptr],y		clc		brl	main_exit		ENDP		Eject;==========================================================================;Get_dir_entry: This routine will return a single entry from a directory.;;;Created:       Nov 10, 1987;Modified:      Nov 10, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               find_file;;Call Format:;;Class 0        Reference number        (2 Bytes);               RESERVED                (2 Bytes);               Base                    (2 Bytes);                       $0000 = Absolute;                       $0001 = Forward releative;                       $0002 = Backward relative;               Displacement            (2 Bytes);               Pointer to name buffer  (4 Bytes);               Entry Number            (2 Bytes) Absolute entry read;               File Type               (2 Bytes);               EOF                     (4 Bytes);               Blocks Used             (4 Bytes);               Create Date/Time        (8 Bytes: Misc. Tools Format);               Mod Date/Time           (8 Bytes: Misc. Tools Format);               Access                  (2 Bytes);               Aux Type                (4 Bytes);               File System Id          (2 Bytes);;Class 1        PCount                  (2 Bytes: Minimum = 5);               Reference Number        (2 Bytes);               RESERVED                (2 Bytes);               Base                    (2 Bytes);                       $0000 = Absolute;                       $0001 = Forward releative;                       $0002 = Backward relative;               Displacement            (2 Bytes);               Pointer to name buffer  (4 Bytes);               Entry Number            (2 Bytes) Absolute entry read;               File Type               (2 Bytes);               EOF                     (4 Bytes);               Blocks Used             (4 Bytes);               Create Date/Time        (8 Bytes: Misc. Tools Format);               Mod Date/Time           (8 Bytes: Misc. Tools Format);               Access                  (2 Bytes);               Aux Type                (4 Bytes);               File System Id          (2 Bytes);               Option List Pointer     (4 Bytes);;==========================================================================		longa	on		longi	onget_dir_entry	PROC	Export		with	my_dp		jsr	setup_params		;general setup routine		php				;save status		lda	my_pblk_ptr+2		sta	temp2_ptr+2		clc		lda	my_pblk_ptr		sta	temp2_ptr		;save a pointer for extended bit		adc	#$0004			;pass ref # and Reserved fields		sta	my_pblk_ptr		bcc	not_high		inc	my_pblk_ptr+2not_high		plp		bne	class1			;this is a new call		lda	#$000E			;make PCount = to class 0 normal		sta	pcountclass1		ldy	#msdos_fcr.storage	;make sure this is a directory		lda	[msdos_fcr_ptr],y		cmp	#subdir_type		bcs	type_ok		sec		lda	#bad_file_format		brl	main_exittype_ok		ldy	#pblk_1c_flags		;clear the flags word		lda	#$0000			;(assume not an extended file)		sta	[temp2_ptr],y		jsr	standard_req		;make sure we read only 1 block at a time		lda	data_ptr		;make index pointer point to attributes field		clc		adc	#dir_entry.attributes		sta	index_ptr		lda	data_ptr+2		adc	#0		sta	index_ptr+2		lda	[my_pblk_ptr]		;load the base field		sta	base			;save user's base value		cmp	#gde_max_base+1		bcc	base_good		lda	#parm_range_errgde_exit		brl	main_exitbase_good		ldy	#pblk_1c_name		lda	[my_pblk_ptr],y		sta	temp_ptr		;save the pointer		iny		iny		lda	[my_pblk_ptr],y		and	#$00FF			;clear the garbage		sta	temp_ptr+2		ldy	#pblk_1c_disp		;offset to displacement		lda	[my_pblk_ptr],y		sta	displacement		ora	base			;is base and displacement zero?		bne	nothing_special		;no normal call; both base and displacement were set to 0.  This means that the caller wants; the number of active directory entries returned.  Since MSDOS doesn't maintain; a count of the currently active entries, we must count 'em manually.  We do this; by resetting the directory back to the first entry, then searching for entry; number 65535.  Once found (or end of directory is reached), we use the current; entry number as the count.  We then reset the directory back to the beginning; for subsequent GetDirEntry calls.		jsr	reset_gde		;reset the call please		bcs	gde_exit		;bad news bud				ldy	#msdos_fcr.gde_offset		lda	[msdos_fcr_ptr],y	;setup the current offset		sta	entry_offset		jsr	send_tot_files		jsr	reset_gde		brl	main_exit		;exit back to caller; This is where we handle a normal GetDirEntry callnothing_special		ldy	#msdos_fcr.gde_offset		lda	[msdos_fcr_ptr],y	;setup the current offset		sta	entry_offset		ldy	#msdos_fcr.gde_entry_num		lda	[msdos_fcr_ptr],y		tay				;remember logical entry #		beq	@inited			;if 0, we're reading first entry		dec	a			;else adjust for 0-based array@inited		sta	math_temp		;current absolute entry number		lda	base			;restore base		beq	absolute		;do absolute entry please		dec	a		beq	forward			;do forward relative pleasebackward		sec		tya				;get the last entry we looked at		sbc	displacement		;entry that we want		bcs	do_find_entry		;go find the entry pleaseend_dir_err		sec		lda	#end_of_dirbad_news		brl	main_exitabsolute		lda	displacement		;get this entry please		bra	do_find_entryforward		clc		tya				;get the current entry please		adc	displacement		bcs	end_dir_err		;overflowdo_find_entry		tax				;logical entry 0?		beq	end_dir_err		;ain't no such thang!		dec	a			;adjust for 0-based array		jsr	find_entry		bcs	bad_newssend_entry		ldy	#msdos_fcr.gde_entry_num		lda	math_temp		inc	a			;adjust for 0-based array		sta	[msdos_fcr_ptr],y	;save the current entry number		ldy	#msdos_fcr.gde_offset		lda	entry_offset		sta	[msdos_fcr_ptr],y	;save the entry offset		clc		adc	data_ptr		sta	drvr_buf_ptr		;set up for move_dir_entry		lda	data_ptr+2		adc	#0		sta	drvr_buf_ptr+2				jsr	move_dir_entry		;move the entry into local storage;;Now move the entry into the user's data area;		lda	#buff_too_small		;assume user screwed up		sta	math_temp		lda	[temp_ptr]		cmp	#$0004		bcc	no_name			;sorry no name avail		ldy	#$0002			;store the name length		lda	filename.length		sta	[temp_ptr],y		clc		adc	#$0004		cmp	[temp_ptr]		;load the buffer size		beq	len_ok			;length is ok		bcc	len_ok;;(BufferSize - 4);               sec		lda	[temp_ptr]		;use the user's buf length		sbc	#$0004		beq	no_name			;a buffer size of 4 was used so store length only.		bcc	no_name			;do not send any of the name		bra	do_name			;use the user's length as count to send.len_ok		stz	math_temp		;no error		lda	filename.length		;number of bytes to move;;Code added to fix a bug cataloging a bad disk.;		bne	do_name		lda	#dir_error		;the directory entry is bad		sec		brl	main_exit		;exit with the error please             do_name		tay				;number of bytes to send		clc				;make pointer to ascii string		lda	temp_ptr		adc	#$0003		sta	temp_ptr		bcc	@1		inc	temp_ptr+2@1		sty	gde_temp		;save the count please		ldy	#$0000			;start at the front		longa	off		sep	#$20looper		lda	filename.text,y		iny		sta	[temp_ptr],y		cpy	gde_temp		bne	looper			;move the name to the user's buffer		longa	on		rep	#$20		lda	math_temp		cmp	#buff_too_small		;if the error was buffer too small then leave it.		beq	no_name		stz	math_temp		;reset the error code pleaseno_name;; We now do some magic to determine if the file has a resource fork, which; is stored as a file of the same name in a subdirectory named RESOURCE.FRK; at the same level as the main (data fork) file.  If the resource fork; exists, we have to set the FLAGS parameter.;		stz	temp4_ptr		;assume no resource fork		stz	temp4_ptr+2		lda	one_entry.attributes	;first, check the attributes		and	#subdirectory+vol_label+sys_file		beq	@maybe			;it might have a resource forkÉ		brl	non_extended		;if any of the three, can't be extended@maybe		ldy	#fcr.path_name		;get VP to this directory's pathname		lda	[my_fcr_ptr],y		tax		iny		iny		lda	[my_fcr_ptr],y		tay		jsl	deref			;deref into a real pointer		stx	temp4_ptr		sty	temp4_ptr+2		lda	[temp4_ptr]		;get the length of the pathname		clc		adc	ResForkName		;add length of subdirectory name		clc		adc	filename.length		;add the length of the filename		clc		adc	#1+1			;add separator + null terminator		jsl	alloc_seg		bcc	@got_buffer		lda	#out_of_mem		;ran out of room!		brl	main_exit@got_buffer		stx	namebuf_vp		sty	namebuf_vp+2		jsl	deref			;dereference VP		stx	namebuf_ptr		sty	namebuf_ptr+2		sep	#$20			;8-bit accumulator		longa	off		ldy	#2			;skip past volume name		ldx	#0			;set up for copy later@strip		iny		lda	[temp4_ptr],y		;get a character		beq	@volname_only		;null terminator found		cmp	#':'			;colon separator?		bne	@strip			;not yet@copy		iny				;skip past colon		lda	[temp4_ptr],y		;get a character		beq	@end_of_name		;null terminator found		phy				;save index		txy				;destination index		sta	[namebuf_ptr],y		ply				;retrieve source index		inx				;bump indexes		bra	@copy			;go back for more@end_of_name		txy				;store colon separator		lda	#':'		sta	[namebuf_ptr],y		inx@volname_only		txy				;y indexes destination		ldx	#0			;x indexes source@copy2		lda	ResForkName+2,x		;copy in subdirectory name		sta	[namebuf_ptr],y		inx		iny		cpx	ResForkName		;done whole name yet?		bcc	@copy2			;no...		ldx	#0			;now copy in the filename@copy3		lda	filename.text,x		sta	[namebuf_ptr],y		iny		inx		cpx	filename.length		bcc	@copy3		lda	#0			;null terminator		sta	[namebuf_ptr],y		rep	#$20			;16-bit accumulator		longa	on; we now have a partial pathname in namebuf		lda	drvr_dev_num		;get device number		ldx	namebuf_ptr		ldy	namebuf_ptr+2		;and pointer to pathname		pei	temp_ptr+2		;save this		pei	temp_ptr		jsr	find_file		;go find the file		pla		sta	temp_ptr		pla		sta	temp_ptr+2		stz	temp4_ptr		;assume no resource fork		stz	temp4_ptr+2		bcs	@no_resource_fork	;no resource fork here		stx	temp4_ptr		;save pointer to directory entry		sty	temp4_ptr+2		ldy	#pblk_1c_flags		;set the flags word		lda	#$8000		sta	[temp2_ptr],y@no_resource_fork		ldx	namebuf_vp		;deallocate the name buffer		ldy	namebuf_vp+2		jsl	release_seg		; Now we can return any optional parameters requestednon_extended		sec				;adjust the pcount please		lda	pcount		sbc	#$0005		sta	pcount		beq	end_gde		jsr	send_gde_stuff		;send the info that the user wantsend_gde		lda	math_temp		;was there an error?		cmp	#$0001		brl	main_exitsend_gde_stuff		lda	my_pblk_ptr		sta	temp_ptr		lda	my_pblk_ptr+2		sta	temp_ptr+2		ldy	#pblk_1c_entry		;return the absolute entry		lda	find_this_entry		inc	a			;adjust for 0-based array		sta	[temp_ptr],y		dec	pcount		beq	@to_end_send_gde2		ldy	#pblk_1c_ftype		ldx	#$000f			;assume subdirectory		lda	storage_type		;is it a directory?		cmp	#subdir_type		bcs	@is_dir			;yes		jsr	get_file_type		;else go translate the filename extension@is_dir		txa		sta	[temp_ptr],y		dec	pcount@to_end_send_gde2;;;		beq	to_end_send_gde		bne @around		brl	to_end_send_gde@around		jsr	send_data_eof		;send the eof for data fork		dec	pcount		beq	to_end_send_gde		jsr	send_data_blks		;send the blks_used for data fork		dec	pcount		beq	to_end_send_gde		ldx	#0			;no create date supported		txy		jsr	unpack_time		ldy	#pblk_1c_create		jsr	send_time		dec	pcount		beq	to_end_send_gde		ldx	one_entry.date		ldy	one_entry.time		jsr	unpack_time		ldy	#pblk_1c_mod		jsr	send_time		dec	pcount		beq	to_end_send_gde		ldx	#$00E3			;assume full access		lda	one_entry.attributes	;get the attributes		bit	#read_only		;read-only file?		beq	@not_read_only		;no...		ldx	#$0001@not_read_only		bit	#archive		;backup bit set?		beq	@no_backup		;no...		pha				;save attributes		txa				;set backup bit		ora	#backup_enabled		tax		pla@no_backup		bit	#hidden_file		;invisible?		beq	@visible		;no...		txa				;else set invisible bit		ora	#invis_bit		tax@visible		txa				;retrieve final attributes		ldy	#pblk_1c_access		sta	[temp_ptr],y		dec	pcount		beq	to_end_send_gde		lda	#0			;no aux type supported		ldy	#pblk_1c_aux		sta	[temp_ptr],y		iny		iny		sta	[temp_ptr],y*** added 11-Aug-92 DAL		lda	storage_type		cmp	#subdir_type		bcs	@its_directory		jsr	get_file_type		dey		dey		sta	[temp_ptr],y		;store low word of auxtype		iny		iny@its_directory*** end 11-Aug-92		dec	pcount			;does the user want FST ID?to_end_send_gde		beq	end_send_gde		;No		lda	#fst_id		ldy	#pblk_1c_id		sta	[temp_ptr],y		dec	pcount			;Skip the option list please		beq	end_send_gde;==========================================================================; We now store the MSDOS FST ID in the 5th byte of the option list buffer;==========================================================================		ldy	#pblk_1c_opt		;index to option list pointer		lda	[temp_ptr],y		;get the address of the option list buffer		tax		iny		iny		lda	[temp_ptr],y		tay		bne	@save_fst_id		txa		beq	@skip_save@save_fst_id		pei	temp_ptr		;save the working temp_ptr since I am going to use it		pei	temp_ptr+2		;to handle the option list pointer		stx	temp_ptr		sty	temp_ptr+2;;Now I need to verify the option list length.  I need at least 6 bytes.;		lda	[temp_ptr]		;get the length of the option list		cmp	#$0004			;is the minimum count OK		bcs	@min_ok			;the user has the min		lda	#parm_range_err		;store the error		bra	option_list_err@min_ok		tax				;save the count for data area check             		lda	#$0002			;length of the MSDOS FST ID.		tay		sta	[temp_ptr],y		;save the number of bytes stored		txa		cmp	#$0006		bcs	@size_fine		lda	#buff_too_small		;store the error		bra	option_list_err@size_fine		iny		iny		lda	#fst_id		sta	[temp_ptr],y		pla		sta	temp_ptr+2		;restore		pla		sta	temp_ptr@skip_save		dec	pcount			;does the user want resource eof?		beq	end_send_gde		;no		jsr	send_res_eof		;send the resource EOF please		dec	pcount			;does the user want resource blocks?		beq	end_send_gde		;no		jsr	send_res_blksend_send_gde		rtsoption_list_err		sta	math_temp		pla		sta	temp_ptr+2		;restore		pla		sta	temp_ptr		rtssend_data_eof		ldy	#pblk_1c_eof		lda	one_entry.file_size		sta	[temp_ptr],y		iny		iny		lda	one_entry.file_size+2		sta	[temp_ptr],y		rtssend_data_blks		ldx	#0			;assume no blocks used		lda	one_entry.start_cluster		beq	@no_blks_used		jsr	count_blks_used		;walk the FAT counting blocks@no_blks_used		ldy	#pblk_1c_blks		sta	[temp_ptr],y		iny		iny		txa		sta	[temp_ptr],y		rtssend_res_eof		lda	temp4_ptr		;was a resource file found?		ora	temp4_ptr+2		tax				;(zero out X too)		beq	@no_res_fork		;no, just return 0		ldy	#dir_entry.file_size+2	;retrieve file size from entry		lda	[temp4_ptr],y		;temp4_ptr points to entry		tax		dey		dey		lda	[temp4_ptr],y@no_res_fork		ldy	#pblk_1c_res_eof	;offset within parm block		sta	[temp_ptr],y		iny		iny		txa		sta	[temp_ptr],y		;save upper word please		rtssend_res_blks		lda	temp4_ptr		;was a resource fork found?		ora	temp4_ptr+2		tax				;(zero out X if none)		beq	@no_res_fork		;no, just return 0		ldy	#dir_entry.start_cluster		lda	[temp4_ptr],y		;retrieve from directory entry		jsr	count_blks_used		;walk the FAT counting blocks@no_res_fork		ldy	#pblk_1c_res_blks		sta	[temp_ptr],y		iny		iny		txa		sta	[temp_ptr],y		;save upper word please		rtsadd_entry_len		tya		clc		adc	#entry_length		tay		rtssub_entry_len		tya		sec		sbc	#entry_length		tay		rtssend_tot_files		lda	pcount			;is there room		cmp	#$0006		bcc	@end_tot		lda	#1		sta	math_temp		;init counter		lda	#$FFFF			;search for entry #65535 (should hit EOD)		jsr	find_entry		;search till end of directory		lda	math_temp		;get count		ldy	#pblk_1c_entry		;store entry count into parm block		sta	[my_pblk_ptr],y@end_tot		rtsreset_gde		ldy	#msdos_fcr.start_cluster		lda	[msdos_fcr_ptr],y	;get start cluster number		ldy	#msdos_fcr.curr_cluster		cmp	[msdos_fcr_ptr],y	;already at start cluster?		bne	@read_cluster		;no, must read new block		tax				;save start cluster # in X		ldy	#msdos_fcr.cluster_blk_num		lda	[msdos_fcr_ptr],y	;at first block of cluster already?		beq	@is_first_block		;yes, no need to go to disk		txa				;retrieve start cluster number@read_cluster		ldy	#msdos_fcr.curr_cluster		sta	[msdos_fcr_ptr],y	;set the current cluster number		ldy	#msdos_fcr.cluster_blk_num		lda	#$0000			;reset to first block of cluster		sta	[msdos_fcr_ptr],y		jsr	read_gde_blk		;go read the directory block		bcs	@abort			;punt on any error		lda	#$0000@is_first_block		ldy	#msdos_fcr.gde_offset		sta	[msdos_fcr_ptr],y		ldy	#msdos_fcr.gde_entry_num		sta	[msdos_fcr_ptr],y		ldy	#msdos_fcr.start_cluster		lda	[msdos_fcr_ptr],y	;get the starting cluster of the file		beq	@dir_loaded		;we're reading root directory		lda	[data_ptr]		;make sure this is a directory		and	#$00FF		cmp	#'.'			;subdirectories start with this		bne	directory_err		ldy	#entry_length		;look at second entry		lda	[data_ptr],y		cmp	#'..'			;second entry must match this		bne	directory_err		lda	#entry_length*2		;save gde_offset (starting with third entry)		ldy	#msdos_fcr.gde_offset		sta	[msdos_fcr_ptr],y@dir_loaded		clc				;no errors!@abort		rtsdirectory_err		sec		lda	#dir_error		;report error to user		brl	main_exitread_gde_blk		ldy	#msdos_fcr.curr_cluster	;calculate absolute block number		lda	[msdos_fcr_ptr],y		jsr	cluster2block		;convert to absolute block #		clc		ldy	#msdos_fcr.cluster_blk_num		adc	[msdos_fcr_ptr],y	;add in the block offset		sta	drvr_blk_num		;set new block number		lda	my_fcr_ptr		adc	#fcr.io_start		sta	drvr_buf_ptr		lda	my_fcr_ptr+2		adc	#$0000		sta	drvr_buf_ptr+2		jsr	read_with_cache		;read in directory block		rtsload_ext_blk		jsr	set_default_buf		;use the standard buffer please		jsr	standard_req		lda	one_entry+key_blk_index		sta	drvr_blk_num		jsr	read_with_cache		bcc	no_problemabort		brl	main_exit		;abort pleaseno_problem		rtsfind_entry		ldy	entry_offset		;pre-load the entry offset		sta	find_this_entry		;save entry number to find		cmp	math_temp		;compare to current entry		beq	chk_this_entry		;we have the correct entry (maybe)		bcc	search_backward		;do a backward searchsearch_forward		cpy	#blk_size-entry_length	;reached the end of the block yet?		bcs	get_forward_blk		;go read the next block please		jsr	add_entry_lenforward_loop		lda	[data_ptr],y		;load the entry please		and	#$00FF			;is this entry active?		beq	end_dir			;never used, must be end of directory		cmp	#$00E5			;$E5 represents a deleted entry		beq	search_forward		;look at the next entry please		cmp	#'.'			;alias entry?		beq	search_forward		;yes, skip it		lda	[index_ptr],y		;look at attributes byte		bit	#vol_label		;is this a volume label?		bne	search_forward		;yes, skip it (not a true entry)		jsr	chkResName		;RESOURCE.FRK entry?		bcs	search_forward		;yup, skip it		sty	entry_offset		;save the offset		inc	math_temp		;bump the current entry by one		lda	math_temp		cmp	find_this_entry		;is this the correct entry		bne	search_forwardfound_it	clc		rtschk_this_entry		dec	math_temp		;gets incremented when active entry found		bra	forward_loop		;make sure the current entry is activeget_forward_blk		ldy	#msdos_fcr.cluster_blk_num		lda	[msdos_fcr_ptr],y	;get the current block # within cluster		inc	a			;bump to next block		sta	[msdos_fcr_ptr],y	;store it back again		ldy	#msdos_fcr.cluster_size		cmp	[msdos_fcr_ptr],y	;still within current cluster?		bcc	@within_cluster		;yes, just get the next sequential block		ldy	#msdos_fcr.curr_cluster		lda	[msdos_fcr_ptr],y	;get the current cluster #		beq	end_dir			;there's no next cluster for root directory		jsr	get_fat_entry		;get next cluster number		bcs	end_dir			;sorry no more directory blocks		ldy	#msdos_fcr.curr_cluster		sta	[msdos_fcr_ptr],y	;save the new cluster #		lda	#$0000			;reset to first block of cluster		ldy	#msdos_fcr.cluster_blk_num		sta	[msdos_fcr_ptr],y@within_cluster		jsr	read_gde_blk		;load the block please		ldy	#$0000			;index to first entry		bcc	forward_loop		brl	main_exit		;tell user about the errorend_dir		sec		lda	#end_of_dir		rtssearch_backward		tya				;at beginning of block?		beq	@get_back_blk		;yes, go read the prev block please		jsr	sub_entry_len@backward_loop		lda	[data_ptr],y		;load the entry please		and	#$00FF			;is this entry active?		beq	end_dir			;no...		cmp	#$00E5			;deleted entry?		beq	search_backward		;look at the next entry please		cmp	#'.'			;alias entry?		beq	search_backward		;yes, skip it		jsr	chkResName		;RESOURCE.FRK entry?		bcs	search_backward		;yup, skip it		sty	entry_offset		;save the offset		dec	math_temp		;bump the current entry by one		lda	math_temp		cmp	find_this_entry		;is this the correct entry		bne	search_backward		bra	found_it@get_back_blk		ldy	#msdos_fcr.cluster_blk_num		lda	[msdos_fcr_ptr],y	;is current block at beginning of cluster?		bne	@prev_block		;no, we can read it directly		jsr	reset_gde		;otherwise we have to start over at the beginning		ldy	#msdos_fcr.gde_entry_num		lda	[msdos_fcr_ptr],y		sta	math_temp		ldy	#msdos_fcr.gde_offset		lda	[msdos_fcr_ptr],y		sta	entry_offset		tay		brl	forward_loop@prev_block		dec	a			;adjust to previous block within cluster		sta	[msdos_fcr_ptr],y		jsr	read_gde_blk		ldy	#blk_size-entry_length	;index to last entry in block		bcc	@backward_loop		brl	main_exit		;tell user about the error;; chkResName - compares filename at current entry against the name; "RESOURCE.FRK".  If it matches, we skip this entry.  (In other words,; the system will never see the Resource.Frk subdirectory, since that's only; for our use.);; On entry:	Y = offset to first byte of directory entry;		data_ptr = pointer to first byte of directory buffer;; On exit:	Carry clear = no match;		Carry set = skip this entry, it's the RESOURCE.FRK entry;; Preserves:	YchkResName		phy		tya				;offset to end of name		clc		adc	#10		tay		ldx	#10		sep	#$20		longa	off@compare		lda	ResName,x		;get a character		cmp	[data_ptr],y		;same as entry?		bne	@not_equal		;nope!		dey		dex		bpl	@compare		;loop through entire name		sec				;all equal, skip this entry		dc.b	$90			;BCC opcode, hides CLC instruction@not_equal		clc		rep	#$20		longa	on		ply		rtsResName		dc.b	'RESOURCEFRK'		ENDP		Eject;==========================================================================;get_dev_num    This file contains code that will find a volume and return;               a device number.;;Created:       aug 17, 1987;Modified:      aug 17, 1987;Author:        Rob Turner;;Enter:         jml;;Input:         A = undefined;               X = call number times 2;               Y = class times 2;               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               Device Dispatcher  (subroutine);               General I/O Buffer (1K buffer, I read 512 bytes);               and lots of other stuff to.;;Call Format:;;Class 0        Dev/Vol Name Pointer    (4 Bytes);               Device Number           (2 Bytes);;Class 1        PCount                  (2 Bytes);               Dev/Vol Name Pointer    (4 Bytes);               Device Number           (2 Bytes);;==========================================================================		longa	on		longi	onget_dev_num	PROC	Export		with	my_dp		jsr	setup_params		;go ahead do your thing		lda	dev_num			;did the shell find a device?		bne	have_device		lda	#no_dup			;allow me to handle file not found		sta	search_flag		jsr	process_path		;do ahead and find the volume		bcc	no_err			;no problem		cmp	#file_not_found		;was the error file not found?		bne	@dev_err_exit		lda	dev_num		bne	no_err			;give him the device number		lda	#bad_path_syntax@dev_err_exit		sec		brl	main_exitno_err		lda	drvr_dev_numhave_device		ldy	#$0004			;return the device number		sta	[my_pblk_ptr],y		clc		brl	main_exit		ENDP	if NOT read_only_fst then		Eject;======================================================================;format/Erase   This file will format or erase of volume;;Created:       dec 05, 1987;Modified:      mar 15, 1988;Author:        Rob Turner;;Enter:         From GS/OS jmp table;;Input:         A = undefined;               X = (call number * 2);               Y = (class number * 2);               P = nvmxdizc;                   ..000...;               b = k;;Output:        A = error code if carry set (exit via system exit routine);               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000..1 = error;                          0 = no error;               b = k;;Uses:          All registers;               Device Dispatcher       (subroutine);               General I/O Buffer      (1K buffer, I read 512 bytes);;Call Format:;;Class 0        Device Name Pointer     (4 Bytes);               Volume Name Pointer     (4 Bytes);               FST ID                  (2 Bytes);;Class 1        PCount                  (2 Bytes);               Device Name Pointer     (4 Bytes);               Volume Name Pointer     (4 Bytes);               FST ID                  (2 Bytes);;======================================================================		longa	on		longi	onformat_disk	PROC	Export		with	my_dp		import	boot_size		jsr	setup_params		;standard setup routine** 2/28/92 GAB		jsr	check_spans		;make sure the volume name isn't too long**		lda	dev_num			;move device number from SCM to		sta	drvr_dev_num		;driver area on direct page		jsr	clear_any_vcrs		;keep VCRs in order		jsr	setup_vol_name		;move the volume name please		jsr	hard_format		;issue a hard format please		bcs	init_exit		bra	continue		EXPORT	erase_diskerase_disk		jsr	setup_params		;standard setup routine** 2/28/92 GAB		jsr	check_spans		;make sure the volume name isn't too long**		lda	dev_num			;move device number from SCM to		sta	drvr_dev_num		;driver area on direct page		jsr	clear_any_vcrs		;keep VCRs in order		jsr	setup_vol_name		;move the volume name pleasecontinue		jsr	set_partition		;assign the partion map name;;Start of code that will write to disk;		if	prodos			then		jsr	write_boot_code		;write the boot code out to disk		endif		bcs	init_exit		jsr	build_directory		;build the directory please		bcs	init_exit		jsr	build_bitmap		;build the correct bitmap pleaseinit_exit		brl	main_exit;======================================================================;setup_vol_name This routine will verify the volume name is ok, and;               move the name into the format header.;======================================================================setup_vol_name		clc		lda	path2_ptr		adc	#$0003		sta	temp_ptr		;setup pointer to the name		lda	path2_ptr+2		adc	#$0000		sta	temp_ptr+2		jsr	set_case_bits		;setup the case please (Temp_Ptr is Input)		lda	temp_ptr		;subtract one from the pointer.		bne	@do_low		dec	temp_ptr+2@do_low		dec	temp_ptr		lda	#$0001		sta	chars_checked		;parameter for setup_name		jsr	setup_name		ldy	#15			;first clear the format header		lda	#$0000clr_loop		sta	new_vol_name,y		dey		bpl	clr_loop		lda	search_length		;length of the volume name		and	#$000F		tay		ora	#volume_header		sta	new_vol_name		;the length is now stored		longa	off		sep	#$20			;8 bit Accummove_vol		lda	search_name-1,y		sta	new_vol_name,y		dey		bne	move_vol		longa	on		rep	#$20			;16 bit Accum;;Save the case please;		stz	new_vol_date-2		;zap any old data that might be around		lda	case_bits		;get the user's case		beq	@skip_save		ora	#$8000		sta	new_vol_date-2@skip_save		jsr	pack_time		;set the create date		stx	new_vol_date		stx	new_vol_mod		sty	new_vol_date+2		sty	new_vol_mod+2		;set the mod time to the create time		rts;======================================================================;hard_format:   This routine will issue the hard format call to the;               device driver.;======================================================================hard_format		lda	#drvr_control		;issue hard format call to device		sta	drvr_call_num		lda	#drvr_format		;issue the format call		sta	drvr_ctrl_code		lda	#^format_ctrl		sta	drvr_clist_ptr+2		lda	#format_ctrl		sta	drvr_clist_ptr		lda	#$0002			;length of control list		sta	drvr_req_cnt		stz	drvr_req_cnt+2		jsr	device_call		;issue the format call to the device		bcc	formatted		cmp	#drvr_disk_sw		;is it a disk switched problem?		beq	hard_format		;try again		secformatted		rts				;return with the error code.;======================================================================;indicate_erase This routine will tell the driver what name to store;               in the device partion map.;======================================================================set_partition		lda	#drvr_control		;setup for a control call		sta	drvr_call_num		lda	#$0006			;setup control code		sta	drvr_ctrl_code		lda	#^control_list		;setup pointer to the parameter list		sta	drvr_clist_ptr+2		lda	#control_list		sta	drvr_clist_ptr		stz	drvr_req_cnt		stz	drvr_req_cnt+2		;no request count		jsr	device_call		rts		if	prodos			then  ;no need to write ProDOS boot code to an MSDOS disk;======================================================================;write_boot_code This routine will write out to disk the ProDOS;               boot code.  Note that the SOS boot code has;               been removed from the boot blocks.  This means that;               a disk formatted with the ProDOS FST cannot be booted;               on the Apple ///.;======================================================================write_boot_code		jsr	set_default_buf		;use general work buffer		jsr	standard_req		;512 byte write		jsr	clear_gbuf_low		;clear the working buffer with zeros.		lda	#drvr_write		sta	drvr_call_num		stz	drvr_blk_num		stz	drvr_blk_num+2		ldy	#boot_size-2		;move the boot code to pleaseboot_loop		lda	boot_code_start,y		sta	[drvr_buf_ptr],y		dey		bpl	boot_loopre_boot		jsr	device_call		;issue the device call please		bcc	boot_done		cmp	#drvr_disk_sw		beq	re_boot			;try again		secboot_done		rts		endif;======================================================================;Build_directory This routine will build the first four blocks of the;               directory.;======================================================================build_directory		jsr	get_dev_blks		;get the number of blocks on the device.		bcs	exit_dir		;sorry we are out of here.		sta	new_tot_blks		;number of blocks on the volume		jsr	set_default_buf		;use general work buffer		jsr	standard_req		;512 byte write		jsr	clear_gbuf_low		;clear the working buffer with zeros.		lda	#drvr_write		;setup for write calls		sta	drvr_call_num		lda	#vol_dir_start		sta	drvr_blk_num		stz	drvr_blk_num+2		ldy	#entry_length+2		;now move the entry to work bufferheader_loop		lda	format_header,y		sta	[drvr_buf_ptr],y		dey		bpl	header_loop;;Write Block Two To Disk;		jsr	device_call		;issue the device call please		bcs	exit_dir;;Write Block Three To Disk;		jsr	clear_gbuf_low		;clear the block again		ldx	#vol_dir_start		;backward link to block 2		ldy	#vol_dir_start+2	;forward link to block  3		jsr	do_dir_blk		;write directory block to disk		bcs	exit_dir;;Write Block Four To Disk;		ldx	#vol_dir_start+1	;Backward link to block 3		ldy	#vol_dir_start+3	;Forward link to block  5		jsr	do_dir_blk		bcs	exit_dir;;Write Block Five To Disk;		ldx	#vol_dir_start+2	;Backward link to block 4		ldy	#$0000			;Forward link NIL		jsr	do_dir_blkexit_dir		rtsdo_dir_blk		txa				;previous link		sta	[drvr_buf_ptr]		tya		ldy	#$0002			;index to forward link		sta	[drvr_buf_ptr],y		inc	drvr_blk_num		;move to the next block please		jsr	device_call		;issue write call		rts;======================================================================;build_bitmap   This routine will build a bitmap for the device;               being formatted.;======================================================================build_bitmap		lda	#bitmap_strt_blk	;starting block number of bitmap		sta	drvr_blk_num;;Calculate the number of bitmap blocks needed for this volume;		ldx	#$0001			;default = one bitmap block		lda	new_tot_blks		;number of blocks on volumecount_blks		sec		sbc	#4096			;one bitmap block		beq	end_count		bcc	end_count		inx				;add one to the block count		bra	count_blksend_count		stx	bitmap_blks		;total number of bitmap blocks		txa		clc		adc	#$0005			;add in boot blks and directory		sta	last_bitmap		;blk number of last bitmap blk		jsr	fill_gbuf_low		;allocate 4096 blocks please		ldx	last_bitmap		;block number of last bitmap blockdir_build		jsr	alloc_bit_blk		;allocate a bitmap block please		dex				;allocate the next block please		bpl	dir_build		bra	chk_last		;see if we are donefull_loop		jsr	fill_gbuf_low		;allocate 4096 blockschk_last		lda	drvr_blk_num		;our we done?		cmp	last_bitmap		beq	clear_to_end		;yes we are		jsr	device_call		;issue write call		bcs	end1_bitmap		inc	drvr_blk_num		;move to the next block please		bra	full_loopclear_to_end					; ;clear from last bit to the end		lda	new_tot_blks		tax		and	#$0FFF			;do we need to clear anything?		beq	just_write		txa				;we must clear some bits		and	#$0007			;are we byte aligned?		beq	fast_clr		;yes we are		jsr	alloc_bit_blk		;allocate the odd block		inx		stx	new_tot_blks		bra	clear_to_endfast_clr		jsr	calc_bit		;get the index please		lda	#$0000fast_loop	sta	[drvr_buf_ptr],y		iny		iny				;WARNING! we might overwrite a byte		cpy	#$0200			;past $200 this is OK with a 1K buffer		bcc	fast_loop		;since we are using 512 bytes onlyjust_write		jsr	device_call		;issue write callend1_bitmap		rtsalloc_bit_blk		phx				;save the block number		jsr	calc_bit		;convert block number to bit pattern		eor	#$FFFF			;clear the correct bit please		and	[drvr_buf_ptr],y		sta	[drvr_buf_ptr],y		plx				;restore block number		rts;======================================================================;get_dev_blks   This routine will return the number of blocks on;               the volume.;;Output:        A = number of blocks;======================================================================get_dev_blks		lda	#drvr_status		;issue a status call to the device		sta	drvr_call_num		lda	#^status_list		;setup a pointer to the status list		sta	drvr_slist_ptr+2		lda	#status_list		sta	drvr_slist_ptr		lda	#$0006			;a six byte request count		sta	drvr_req_cnt		stz	drvr_req_cnt+2		lda	#blk_size		sta	drvr_blk_size		stz	drvr_stat_code		;issue a 'driver status' call.		jsr	device_call		;blast off!!		bcs	holy_cow_batman		;An error?		ldx	#$FFFF			;a 32 meg volume		lda	return_blks+2		;return the blocks please		bne	big_boy		ldx	return_blks		cpx	#$0007		bcc	range_problem		;sorry this device is too smallbig_boy		txa				;number of blocks on volume		clcholy_cow_batman		rtsrange_problem		lda	#drvr_bad_block		;we will not do it.		sec		rts;======================================================================;This routine will mark any VCR's that are logged on this device as;being swapped.  This will allow any FST to rebuild the VCR after the;media has been erased or formatted.;======================================================================clear_any_vcrs		lda	dev_num			;device number we are going to erase		jsl	swap_out		;mark volumes offline		rts		ENDP	endif;---------------------------------------------------------------------------------------------------		eject********************************************************************************	 Name:	map_enable** Description:	This routine enables or	disables file type mapping.**     Created:	Dec 16,	1987*    Modified:	Dec 16,	1987*      Author:	Bryan Atsatt**	Entry:	jsr**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		my_pblk			;points	to parameter block.**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Exit:	rts**	 Uses:	all registers*		my_pblk*		map_enable_flag*		temp1*******************************************************************************map_enable	proc		with	my_dp** Set map_enable_flag and exit with carry clear...*		ldy	#map_enable_off		;Get offset to map_enable.		lda	[param_blk_ptr],y	;Get flag.		cmp	map_enable_flag		;added 25-Aug-92 DAL		sta	map_enable_flag		;Save it.*** added 25-Aug-92 DAL		beq	@skip_changed		jsr	post_volume_changed@skip_changed*** end 25-Aug-92		clc				;No error.		rts		ENDP		eject********************************************************************************	 Name:	get_map_size** Description:	This routine returns the size of the current file type map in*		the callers parameter block.**     Created:	Dec 4, 1987*    Modified:	Dec 4, 1987*      Author:	Bryan Atsatt**	Entry:	jsr**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		my_pblk			;points	to parameter block.**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Exit:	rts**	 Uses:	all registers*		my_pblk*		temp1*******************************************************************************get_map_size	proc		with	my_dp** Setup	pointer	to current map...*		jsr	deref_map** Get length, stuff it into the	parameter block, and exit with carry clear...*		lda	[map_ptr]		;Get length.		ldy	#map_size		;Get offset to map_size.		sta	[param_blk_ptr],y	;Send length.		clc				;No error.		rts		ENDP		eject********************************************************************************	 Name:	get_map_table** Description:	This routine copies the	current	file type map into the buffer*		pointed	to by the map_buffer parameter in the parameter	list.**		NOTE: No checking is done on the size of the caller's buffer!**     Created:	Dec 4, 1987*    Modified:	Dec 4, 1987*      Author:	Bryan Atsatt**	Entry:	jsr**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		my_pblk			;points	to parameter block.**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Exit:	rts**	 Uses:	all registers*		my_pblk*		temp1*		data_buffer*******************************************************************************get_map_table	proc		with	my_dp** Setup	pointer	to current map...*		jsr	deref_map** Get buffer pointer out of parameter list...*		ldy	#map_buffer		;Get offset to pointer.		lda	[param_blk_ptr],y	;Get low word of pointer.		sta	temp_ptr		;Save it.		iny				;Bump offset.		iny		lda	[param_blk_ptr],y	;Get high word of pointer.		sta	temp_ptr+2		;Save it.** Copy map to data_buffer and exit with	carry clear...*		lda	[map_ptr]		;Get length of table.		tay				;Use as	offset.		longa	off			;Set 8 bit A.		sep	#$20copy_loop	dey				;Done all?		bmi	restore_a		;Yep.		lda	[map_ptr],y		;Nope, get byte.		sta	[temp_ptr],y		;Put it	in buffer.		bra	copy_loop		;And loop.		longa	on			;Restore 16 bit	A.restore_a	rep	#$20		clc				;No error.		rts		ENDP		eject********************************************************************************	 Name:	set_map_table** Description:	This routine replaces the current file type map	with one*		provided by the	caller.**     Created:	Dec 4, 1987*    Modified:	Dec 4, 1987*      Author:	Bryan Atsatt**	Entry:	jsr**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		my_pblk			;points	to parameter block.**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Exit:	rts**	 Uses:	all registers*		my_pblk*		temp1*		temp_ptr*******************************************************************************set_map_table	proc		with	my_dpold_vp		equ	index_ptr** Save the current map_buffer_vp so we can release it after we successfully* allocate a new one...*		lda	map_buffer_vp		;Get vp.		ldx	map_buffer_vp+2		sta	old_vp			;Save it.		stx	old_vp+2** Get buffer pointer out of parameter list...*		ldy	#map_buffer		;Get offset to pointer.		lda	[param_blk_ptr],y	;Get low word of pointer.		sta	temp_ptr		;Save it.		iny				;Bump offset.		iny		lda	[param_blk_ptr],y	;Get high word of pointer.		sta	temp_ptr+2		;Save it.** Get size of map and allocate memory for it.  Exit with out_of_mem error* if we	couldn't allocate enough memory...*		lda	[temp_ptr]		;Get size of map		jsl	alloc_seg		;Get a hunk that size.		lda	#out_of_mem		;Get error code	in case	full.		bcs	exit			;Error,	so exit	with carry set.		stx	map_buffer_vp		;Save new vp.		sty	map_buffer_vp+2		jsl	deref			;Dereference vp.		stx	map_ptr			;Save pointer.		sty	map_ptr+2** Copy map into	map buffer...*		lda	[temp_ptr]		;Get length of table.		tay				;Use as	offset.		longa	off			;Set 8 bit A.		sep	#$20copy_loop	dey				;Done all?		bmi	restore_a		;Yep.		lda	[temp_ptr],y		;Nope, get byte.		sta	[map_ptr],y		;Put it	in buffer.		bra	copy_loop		;And loop.		longa	on			;Restore 16 bit	A.restore_a	rep	#$20** Now let's deallocate the old map and exit with carry clear...*		ldx	old_vp			;Get old vp.		ldy	old_vp+2		jsl	release_seg		;Release it.		jsr	post_volume_changed	;added 25-Aug-92 DAL		clc				;No error.exit		rts		ENDP		eject********************************************************************************	 Name:	post_volume_changed** Description:	This routine calls the GS/OS notification queue with a volume-*		changed event for every MS-DOS VCR that's swapped in.**     Created:	25-Aug-92*    Modified:	25-Aug-92*      Author:	Dave Lyons**	Entry:	jsr**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**	 Exit:	rts**	 Uses:	all registers*******************************************************************************post_volume_changed proc Export		with my_dp		lda	#$0001			;Start with the first FSTmore		jsl	get_vcr			;Ask for the VCR		bcs	done			;Past the last VCR		jsl	deref			;Deref VP into temp_ptr		stx	<temp_ptr		sty	<temp_ptr+2		ldy	#vcr_fst_id		lda	[<temp_ptr],y		cmp	#fst_id			;is it our volume?		bne	next_vcr		ldy	#vcr_status		lda	[<temp_ptr],y		and	#vcr_swapped		; bit set if VCR swapped out		bne	next_vcr		pea	$2033			; call number (for A) = FSTSpecific		ldy	#vcr_dev		; get device number		lda	[<temp_ptr],y		pha				; to be passed in X		pha				; undefined: passed in Y		lda	#<volume_change		; get event code in A,X		ldx	#^volume_change		jsl	post_os_event		; signal the eventnext_vcr	lda	#$0000			;Value for get next vcr		bra	moredone		rts		EndP		eject********************************************************************************	 Name:	fst_specific** Description:	This routine is	a dispatcher for the fst_specific calls.  It*		uses command_num to dispatch to	the correct routine.**		NOTE:  These routines do not use send_output to	return*		       parameters, but do it themselves.**     Created:	Dec 4, 1987*    Modified:	Dec 4, 1987*      Author:	Bryan Atsatt**	Entry:	jsr**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		command_num		;command_num**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**	 Exit:	rts**	 Uses:	all registers*******************************************************************************fst_specific	proc	Export*** added 25-Aug-92 DAL -- make sure pcount is 3		lda	[<param_blk_ptr]	;get parameter count		cmp	#3		beq	@pcount_ok		lda	#invalid_pcount		sec		brl	main_exit@pcount_ok*** end 25-Aug-92** Dispatch to the selected routine...*		ldy	#4		lda	[<param_blk_ptr],y	;Get command number.		cmp	#4			;in range?		bcs	@bad_opnum		;no, error out		asl	a			;Multiply by 2.		tax				;Use as	index.		jsr	(specific_cmds,x)	;Jump to it.		brl	main_exit@bad_opnum		lda	#invalid_fst_operror_out 		secexit 		brl	main_exit** Dispatch table for fst_specific commands...*specific_cmds	DC.W	map_enable		;Map_enable.		DC.W	get_map_size		;Get_map_size.		DC.W	get_map_table		;Get_map_table.		DC.W	set_map_table		;Set_map_table.		ENDP		end