****************************************************************************************************** MSDos.Data.aii - contains data definitions for the MS-DOS FST*****************************************************************************************************		include 'MSDos.equ';; 22-Jan-92 MSD: Moved all non-zero items in the data to the start of; the proc so that all of the zero bytes would be contiguous.  This; should help the FST sparsify itself (and reduce disk space).;dummy_name	Record	Export		dc.b	'cant.find.me'		;used to calculate the latest mod date		dc.w	00time_stamp_opt	Record	Export		DC.W	02			;0 = files;						;1 = files + subdirs;						;2 = files + subdirs + subdirs to root;dir_offset_tbl	Record	Export		DC.W	$0004			;offsets to directory entries within		DC.W	$002b			;a directory block		DC.W	$0052		DC.W	$0079		DC.W	$00A0		DC.W	$00C7		DC.W	$00EE		DC.W	$0115		DC.W	$013C		DC.W	$0163		DC.W	$018A		DC.W	$01B1		DC.W	$01D8fake_name_str	Record	Export		DC.W	3			;fake name string for VCR		DC.B	$C		DC.B	$A		DC.B	$E		DC.B	$00syntax_str	Record	Export		DC.B	end_text-start_textstart_text	DC.B	'MSDOS filenames may be up to 12 characters long, with '		DC.B	'an 8 character name, a single "." separator,  and 3 '		dc.b	'character extension.  '		dc.b	'Volume names may be up to 11 characers long with '		dc.b	'no extension.  '		DC.B	'Names may contain letters and digits.'end_text;======================================================================;Data used by Format and Erase disk callsformat_header	Record	Export		Export	new_vol_name,new_vol_mod,new_vol_date,new_tot_blks		DC.W	$0000			;backword link is nill		DC.W	$0003			;forward link to block threenew_vol_name	DC.B	00			;length plus storage type		DS.B	15			;fifteen bytes for the name		DS.B	2			;eight bytes reservednew_vol_mod	ds.b	4			;four byte for the Mod time		ds.b	2			;2 bytes for the case bitsnew_vol_date	DS.B	4			;create date for the volume		DC.B	prodos_version		DC.B	00			;minimum version (back to SOS 1.0)		DC.B	$C3			;access		DC.B	$27			;entry length  (39)		DC.B	$0D			;entries per block (13)		DC.W	$0000			;file count is nill		DC.W	$0006			;bitmap pointernew_tot_blks	DC.W	$0000			;total number of blocks on the volumecontrol_list	Record	Export			;partition string		DC.W	$0E			;length increased by 2 7/26/90, see below		DC.B	'Apple_PRODOS'		dc.b	0,0			;terminator nulls added 7/26/90 for compatibility with						;Macintosh-side FSM, by Matt Gulick, Monte Benaresh;======================================================================;below is the startup tables for each call. The table contains the;following data:;;               1) Max PCount for the call;               2) Max Class for the call;               3) Pathnames used by call;               4) volume control record used;               5) file control record used.;               6) io buffer used (data_ptr,Index_ptr,master_ptr);               7) flush file before call;               8) damaged disk protect;               9) Check Dirty Flag.;;            |9|8|7|6|5|4|3|  2  |    1    |;           _|_|_|_|_|_|_|_|_____|_________|;          | | | | | | | | | | | | | | | | |;          |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|;          |               |               |;         1 6             0 8             0 0start_tbl	Record	Export		DC.W	max_pcnt7+max_class1+path_used+damage ;Create		DC.W	max_pcnt1+max_class1+path_used+damage ;Destroy		DC.W	0000		DC.W	max_pcnt3+max_class1+path_used+damage 	;ChangePath								; set max pCount=3 (5-Dec-91 MSD)		DC.W	max_pcnt12+max_class1+path_used+damage ;SetFileInfo		DC.W	max_pcnt12+max_class1+path_used	;GetFileInfo		DC.W	max_pcnt6+max_class1	;JudgeName		DC.W	max_pcnt6+max_class1	;Volume		DC.W	0000		DC.W	0000		DC.W	max_pcnt1+max_class1+path_used+damage ;ClearBackup		DC.W	0000		DC.W	0000		DC.W	0000		DC.W	0000		DC.W	max_pcnt15+max_class1+path_used	;Open		DC.W	0000		DC.W	max_pcnt5+max_class1+vcr_used+fcr_used+io_used ;Read		DC.W	max_pcnt5+max_class1+vcr_used+fcr_used+io_used+damage+do_dirty ;Write		DC.W	max_pcnt1+max_class1+vcr_used+fcr_used+io_used ;Close		DC.W	max_pcnt2+max_class1+vcr_used+fcr_used+io_used+damage ;Flush		DC.W	max_pcnt4+max_class1+vcr_used+fcr_used+io_used ;SetMark		DC.W	max_pcnt2+max_class1+fcr_used ;GetMark		DC.W	max_pcnt3+max_class1+vcr_used+fcr_used+flush_1st+io_used+damage+do_dirty ;SetEof		DC.W	max_pcnt2+max_class1+fcr_used ;GetEof		DC.W	0000		DC.W	0000		DC.W	max_pcnt17+max_class1+vcr_used+fcr_used+io_used	;GetDirEntry		DC.W	0000		DC.W	0000		DC.W	0000		DC.W	max_pcnt2+max_class1+path_used ;GetDevNum		DC.W	0000		DC.W	0000			;ReadBlock		DC.W	0000			;WriteBlock		DC.W	max_pcnt6+max_class1+path_used ;Format		DC.W	max_pcnt6+max_class1+path_used ;Erasekey_blk_changed	Record	Export		dc.w	00			;used by set EOF to indicate that the file changed structuregbuf_addr	Record	Export		DC.L	0			;pointer to general I/O buffervirtual		Record	Export		DC.L	0			;pointer to virtual memory after						;a call to 'Get_Segment';======================================================================;data storage usedhours		Record	Export		DC.W	00minutes		Record	Export		DC.W	00seconds		Record	Export		dc.w	00year		Record	Export		DC.W	00month		Record	Export		DC.W	00day		Record	Export		DC.W	00day_of_week	Record	Export		DC.W	00pro_time	Record	Export		DC.L	00write_occurred	Record	Export		dc.w	00			;IF non-zero on exit then a write occurredwrite_dev_num	Record	Export			;device number that was written too		dc.w	00curr_mod_date	Record	Export		dc.l	00case_bits	Record	Export			;case bits for the last pathname		dc.w	00case_bit_pattern Record	Export		dc.w	00src_dev_num	Record	Export		DC.W	00			;used by change pathsrc_start_blk	Record	Export		DC.W	00			;''src_dir_blk	Record	Export		DC.W	00			;''src_offset	Record	Export		DC.W	00slug_block	Record	Export		DC.W	00			;for slug ripple 'to root time stamp'slug_offset	Record	Export		DC.W	00close_flag	Record	Export		DC.W	00			;used to determine if we should call;						;slug_ripple from flush_file;src_slug_blk	Record	Export		DC.W	00			;used by change_pathsrc_slug_offset	Record	Export		DC.W	00dest_slug_blk	Record	Export		DC.W	00dest_slug_offset Record	Export		DC.W	00dest_dev_num	Record	Export		DC.W	00			;used by change pathdest_start_blk	Record	Export		DC.W	00			;''dest_dir_blk	Record	Export		DC.W	00			;''dest_offset	Record	Export		DC.W	00vol_rename_flag	Record	Export		DC.W	00			;''direct_page	Record	Export		DS.B	$4C			;used when we must mount a volumemy_direct	Record	Export		DS.B	$78			;''world_flag	Record	Export		DC.W	00			;detect re-entrent codedef_dir_page	Record	Export		DS.B	$4C			;used when we flush deferred blocksdef_my_direct	Record	Export		DS.B	$78			;''def_vol_name	Record	Export		DS.B	20alloc_chk_flag	Record	Export		DC.W	00			;used by write routineseq_write_start	Record	Export		DC.L	00			;pointer used by write routineseq_write_cnt	Record	Export		DC.W	00			;sequential block counterseq_write_blk	Record	Export		DC.W	00			;starting block for sequential writepath_searched	Record	Export		DC.W	00			;set by find file.last_blk	Record	Export		DC.W	0			;used by find_file to verify;						;directory structuresearch_flag	Record	Export		DC.W	00			;flag used by process path;						; bit 15 = volume name not allowed;						; bit 14 = search for new entry;						; bit 13 = volume only alloweddir_start_blk	Record	Export		DC.W	00			;starting block of a directorydir_last_blk	Record	Export		DC.W	00			;last block read by find filefree_dir_blk	Record	Export		DC.W	00			;1st dir block with a free entryfree_dir_offset	Record	Export		DC.W	00			;offset to free entry in dir blocksearching_free	Record	Export		DC.W	00			;flag that is used by Find_Fileblks_used1	Record	Export		DC.W	00			;blks needed for data fork. (create)blks_used2	Record	Export		DC.W	00			;blks needed for res. fork. (create)blocks_needed	Record	Export		DC.W	00			;total blocks needed for files. (create)data_storage	Record	Export		DC.W	00			;storage type for data forkres_storage	Record	Export		DC.W	00			;storage type for resource forksome_free	Record	Export		DC.W	00			;used by find_free_blksvolume_name	Record	Export		DS.B	20			;holds the volume name of an input strgstring		Record	Export		DS.B	20			;holds gstringssearch_length	Record	Export		DC.W	00			;used by 'find_file' routinesearch_name	Record	Export		DS.B	11fcr_wanted	Record	Export		DC.W	00			;used by check_dup routinekey_block	Record	Export		DC.W	00			;used by check_dup routinefind_this_entry	Record	Export		DC.W	00			;used by get dir entryentry_sto_type	Record	Export		DC.W	00storage_type	Record	Export		DC.W	00			;used by openresource_num	Record	Export		dc.w	00one_entry_1	Record	Export		Export	one_entryone_entry	DS	dir_entry		;holds one directory entry		Export	rfork_entryrfork_entry	ds	dir_entry		;holds entry for resource fork filefiles_key_block	Record	Export		DC.W	00			;used by openhold_path_ptr	Record	Export		DC.W	00data_eof	Record	Export		DC.L	00			;used by createres_eof		Record	Export		DC.L	00			;used by createtree_key_blk	Record	Export		DC.W	00			;used by createtree_blks	Record	Export		DC.W	00			;used by createparent_blk	Record	Export		DC.W	00			;used by the open routineentry_offset	Record	Export		DC.W	00			;used by the open routinenewline_len	Record	Export		DC.W	00newline_mask	Record	Export		DC.W	00newline_char	Record	Export		DC.W	00base		Record	Export		DC.W	00			;used with calls that have base paramdisplacement	Record	Export		DC.L	00			;used with calls that have displacementnew_last	Record	Export		DC.W	00			;used to cut back eof (SET_EOF)bitmap_blks	Record	Export		DC.W	00			;used to calc_free_blkslast_bitmap	Record	Export		DC.W	00			;''                  ''first_free	Record	Export		DC.W	00			;''                  ''bits		Record	Export		DC.W	00			;used to count bits in calc_free_blksalloc_count	Record	Export		DC.W	00			;used by find_free_blksalloc_start	Record	Export		DC.W	00			;''byte_offset	Record	Export		DC.W	00			;''mark_changed	Record	Export		DC.W	00			;used by fill_io_buf (setmark=EOF case)user_cache	Record	Export		DC.W	00			;default cache value for file readscreate_time	Record	Export		DC.L	00			;used by set_file_infomod_time	Record	Export		DC.L	00			;used by set_file_infoindex_blks	Record	Export		DC.W	00			;number of indexes needed for tree filesdata_indexes	Record	Export		DC.W	00			;used by createres_indexes	Record	Export		DC.W	00			;used by create.entries_blk_num	Record	Export		DC.W	00pcount		Record	Export		DC.W	00access		Record	Export		DC.W	00and_mask	Record	Export		DC.W	00curr_mark	Record	Export		DC.L	00curr_eof	Record	Export		DC.L	00tran_cnt	Record	Export		DC.L	00user_req_cnt	Record	Export		DC.L	00entries_checked	Record	Export		DC.W	00chars_checked	Record	Export		DC.W	00length		Record	Export		DC.W	00flush_entry	Record	Export		dc.w	00			;allows us to flush only the I/O bufferusers_access	Record	Export		dc.w	00			;used during the open calldirty_flags	Record	Export			;flags at the beginning of the call		dc.w	00flush_flags	Record	Export		dc.w	00			;used by the flush routineschk_dirty_flag	Record	Export			;flag used to indicate that the call can cause dirty blocks		dc.w	00dirty_cnt_changed Record Export		dc.w	00			;indicates that we have changed the dirty_cnt oncenew_eof		Record	Export		dc.l	00			;used by set EOFcp_device_flag	Record	Export		DC.W	00			;1 = ChangePath using device name, else 0cp_flags	Record	Export			;Added 5-Dec-91 MSD		DC.W	00			;$8000 = assume source is duplicate volumeerror_priority	Record	Export		DC.W	00			;storage for error priorityformat_ctrl	Record	Export		DC.W	00			;length of control liststatus_list	Record	Export		Export	return_blks		DC.W	00			;status codereturn_blks	DC.L	00000			;number of blocks on deviceentries_offset	Record	Export		dc.w	00			;offset to directory entrygde_temp	Record	Export		dc.w	00			; temp used by GetDirEntry;driver save areadrvr_save	Record	Export		DS.B	$1b			;save room for direct page;equates used by 'setup_params'class		Record	Export		DC.W	00max_pcount	Record	Export		DC.W	00flags		Record	Export		DC.W	00filename	Record	Exportlength		ds.w	1text		ds.b	12			;up to 12 characters (including '.')expand_record	Record	Exportexpand_flag	dc.w	00expand_file	dc.w	00			;used to indicate we are extending a fileexpand_storage	dc.w	00			;storage type of the data fork on extensionexpand_key_blk	dc.w	00expand_blks_used dc.w	00expand_eof	dc.l	00*** added 28-Feb-92 DAL;; Used by chk_disk_protect to save the first 512 bytes of GBUF;chk_protect_gbuf Record	Export		ds.b 512*** end 28-Feb-92 DAL** File type map	data and map_enable_flag...*map_buffer_vp	Record	Export		DS.B	4			;Storage for vp.; following entries are from Appendix J of "The MS-DOS Encyclopedia", page 1485; The entries are searched sequentially, so the most common translations should; be placed at the beginning of the table.default_map	record	Export		DC.W	map_end-default_map	;Size of default map.;		DC.B	'.TXT',$00,$04		;text file;		DC.B	'.BAT',$00,$04		;batch file;		dc.b	'.BIN',$00,$06		;binary file;		dc.b	'.ASC',$00,$04		;ASCII text file;		dc.b	'.C',$00,$04		;C language source code;		dc.b	'.H',$00,$04		;C header file;		dc.b	'.PAS',$00,$04		;Pascal language source code;		dc.b	'.ASM',$00,$04		;assembly language source code;		dc.b	'.LST',$00,$04		;listing file;		dc.b	'.COB',$00,$04		;COBOL language source code;		dc.b	'.FOR',$00,$04		;FORTRAN language source code*** 11-Aug-92 DAL -- new map table has an auxtype word in addition to the old stuff		macro&lab		Translate &suffix,&filetype,&auxtype&lab		dc.b &suffix,0		dc.b &filetype		dc.w &auxtype		mend		Translate '.TXT',$04,$0000	;text file		Translate '.BAT',$04,$0000	;batch file		Translate '.BIN',$06,$0000	;binary file		Translate '.ASC',$04,$0000	;ASCII text file		Translate '.C',$04,$0000	;C language source code		Translate '.H',$04,$0000	;C header file		Translate '.PAS',$04,$0000	;Pascal language source code		Translate '.ASM',$04,$0000	;assembly language source code		Translate '.LST',$04,$0000	;listing file		Translate '.COB',$04,$0000	;COBOL language source code		Translate '.FOR',$04,$0000	;FORTRAN language source code*** new translations, 11-Aug-92 DAL		Translate '.DOC',$04,$0000	;documentation file		Translate '.SRC',$04,$0000	;source code file		Translate '.GIF',$C0,$8006	;GIF file*** end 11-Aug-92*** added 24-Mar-93 DAL (suggested by Peter Watson)		Translate '.DOX',$04,$0000	;documentation file		Translate '.ME',$04,$0000	;READ.ME file*** end 24-Mar-93 DAL		DC.B	$00			;Map terminator.map_end		EndRResForkName	Record	Export			;subdirectory name used to fake up		String	AsIs			; resource forks		dc.w	end_rec-ResForkName-2	;length word		dc.b	'RESOURCE.FRK:'end_rec		EndRmap_enable_flag	Record	Export		DC.W	0001			;Default is enabled.msdos_data	Record	Export		Export	root_dir_blockroot_dir_block	ds.w	1			;first block of root directory		Export	root_dir_sizeroot_dir_size	ds.w	1			;# of blocks used by root directory		Export	FAT_byte_countFAT_byte_count	ds.w	1		Export	default_namedefault_name	dc.b	'MSDOS#     '		;default entry to be used when there's no label		dc.b	%00001000		;attributes		dcb.b	10,0			;reserved		dc.w	0			;time		dc.w	0			;date		dc.w	0			;starting cluster		dc.l	0			;file sizebios_parm_block	Record	Exportsector_size	ds.w	1cluster_size	ds.b	1reserved_sectors ds.w	1FAT_count	ds.b	1root_dir_count	ds.w	1total_sectors	ds.w	1media_desc	ds.b	1FAT_size	ds.w	1track_size	ds.w	1head_count	ds.w	1hidden_sectors	ds.w	1bpb_size	equ	*-bios_parm_block		End