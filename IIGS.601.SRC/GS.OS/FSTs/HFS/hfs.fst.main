		print	nohdr********************************************************************************* GS/OS	HFS File System	Translator** Version 01.00* Written by Cheryl Ewy and Cary Farrier** Some code stolen from -* GS/OS	High Sierra FST written by Bryan Atsatt* GS/OS ProDOS FST written by Rob Turner** Copyright 1987-92 Apple Computer, Inc.  All Rights Reserved.********************************************************************************		string	asis		blanks	off		pagesize 86				eject*********************************************************************************  REVISION HISTORY:**  Date	    By	 Description*	*  5/25/90  CAE	 Alpha 01 release.*  6/06/90  CAE	 Bug fix (CMW314SMW) - Changed the 'flags' in the FST Header so  *		   that SCM will no longer clear the hi bits of pathname characters.*		 Added support for 'standard' files (ie fil_rsrc_peof = 0).*		   Procs affected - get_storage_type, create, open.*  6/07/90  CAE  Added ability to extend a standard file via the Create call.*		   Procs affected - ih_storage_type, create, get_cat_info.*  6/12/90  CAE  Bug fix - When initializing a disk, the bitmap was built *		   incorrectly whenever there was more than 1 'remainder' bit.		*		   Procs affected - hfs_init.*  6/19/90  CAE  Removed data storage for the 'request_fst' parameter since it's*		   not used.  Removed the ih_request_fst input handler.  Shortened*		   the call_24_class1/call_25_class1 parameter list.*  7/26/90  CAE  Bug fix - Changed the SCSI partition owner name to end with a NUL.*		 Changed the 'ProDOS filetype/auxtype -> HFS filetype' translation*		   so that filetype $FF is always translated to "PSYS" regardless*		   of the auxtype value.  Procs affected - set_file_aux.*  8/03/90  CAE  Bug fix (BK002) - Changed 'max_dt_values' and fixed errors in the *		   date/time verification routines.  *		   Procs affected - ih_create_date_time, ih_create_date, ih_create_time.*  8/09/90  CAE  Bug fix - If we get a 'disk switched' error when attempting to *		   ID a disk, we now retry the call instead of returning the error.*		   Procs affected - do_rw_call, scan_devices. *  8/29/90  CAE  Bug fix (BK011) - Control characters are now allowed in pathnames.*		   Procs affected - parse_path.*  8/30/90  CAE  Bug fix (CW003) - Pcounts greater than the maximum did not cause*		   an error.  Procs affected - ih_pcount.*  9/06/90  CAE  Bug fix - An error was not reported when a Read call was done on*		   a file which was opened with 'write only' access.*		   Procs affected - read.*  9/11/90  CAE  Bug fix (BK014) - Attempting to 'move and rename' a locked file*		   will now return an error.  Procs affected - change_path.*  9/14/90  CAE  Bug fix - The fcrs for the CTree and ETree are now forced to be*		   at 'system level' so they won't be closed by a 'CLOSE all' call.*		   Procs affected - build_vcr.*		 Bug fix (BK017) - Reading in newline node wasn't working correctly.*		   Procs affected - transfer_r_data.*  9/27/90  CAE  Bug fix (BK018) - GetDirEntry now updates the valence in the fcr*		   and clamps the offspring index to the new valence at the start*		   of the call.  Procs affected - get_dir_entry.* 10/01/90  CAE	 Bug fix (BK025) - When opening the resource fork of a file, the*		   resource fork's eof was returned in the "eof" field as well as *		   in the "resource_eof" field.  Procs affected - open.* 10/02/90  CAE  Bug fix (BK026) - If both forks of a file were open, and one or*		   both of the fcrs were dirty, the correct eofs were not always*		   returned by GetFileInfo.  Procs affected - get_cat_info, *		   is_file_closed.  New proc added - look_for_fcr.* 10/04/90  CAE  Enhancement - SetFileInfo will now handle option lists with*		   AppleShare's ID.  Procs affected - read_option_list.* 10/12/90  CAE  Bug fix (CW005) and code cleanup.*		 Rewrote ensure_vol_online and is_vol_locked. *		 Removed data storage for 'type_flag', 'filename' and 'command_num'.*		 Removed code which saves the filename since it's not needed.*		 Reordered some error checking at the start of the call handlers.*		 Procs affected - id_disk, process_path, setup_call, app_entry,*		   i_request_count, destroy,  set_eof, set_mark, read, write.*		 Procs removed - activate_vcr.  New proc added - update_status.* 10/18/90  CAE	 Added code to mask off the hi byte of BTree error codes. *		   Procs affected - app_entry.* 10/19/90  CAE	 Bug fix - Renaming a volume to an existing volume name resulted*		   in both volumes being damaged.  Procs affected - change_path.* 10/19/90  CAE	 Beta 01 release.* 11/01/90  CAE  Enhancement - Added filetype/auxtype conversion support for *		   "MIDI", "AIFF" and "AIFC" files.  *		   Procs affected - set_file_aux, get_file_aux.* 11/02/90  CAE  Bug fix (CW012) - If an error was returned from et_extend_file *		   when attempting to extend a fork during a Create call, the disk*		   was not cleaned up properly.  Procs affected - create.* 11/07/90  CAE  Renamed 'fst_error' proc to 'fst_op_error' because of conflict*		   with new error equate in common.equ.* 11/12/90  CAE  Bug fix (BK013) - Attempting to rename a volume to a null name*		   will result in a bad_path_syntax error.  *		   Procs affected - parse_path.* 11/14/90  CAE  SetFileInfo will now return an error if the user tries to*		   lock a directory.  Procs affected - set_file_info.* 11/19/90  CAE  Bug fix (BK033) - If an invalid option list param is supplied *		   to an Open call, the file is not opened but the vcr_open_count *		   is incremented.  Procs affected - write_option_list.* 11/20/90  CAE  Bug fix (BK032) - Added a fourth node buffer so that when a*		   Create call is done with a specified eof and/or resource eof*		   on a fragmented disk we won't run out of node buffers if we*		   need to split an ETree node while extending a fork.*		   Procs affected - setup_call.* 11/21/90  CAE  Bug fix (BK036) - Build_fcr had a 'cmp cat_fil_type' instead*		   of 'cmp #cat_fil_type' which caused an fcr to be built *		   incorrectly when doing a Create call with both eofs non-zero.  *		   The data fork fcr was built correctly but the resource fork *		   fcr had a bad 'file ID' which resulted in incorrect extent*		   records being stored in the ETree (if more than 3 extents*		   were needed for the resource fork).* 12/03/90  CAE  The Finder Info in the option list is now kept in 68000 format *		   in order to be consistent with the AppleShare FST.*		   Procs affected - get_finder_info, set_finder_info.* 12/04/90  CAE	 Enhancement - The Volume call will now setup the "volname" *		   output parameter if a "dup_volume" error is being returned.*		   Procs affected - volume.* 12/07/90  CAE  Enhancement - The ChangePath call will now allow a duplicate volume*		   to be renamed if a device name is used as the source pathname.*		   Procs affected - change_path, id_disk, build_vcr.*  1/14/91  CAE	 Minor change to the FCR names for the CTree and ETree.*  1/16/91  CAE  The walk_path routine will now only translate 'bt_not_found'*		   errors and will return all other errors as is.*  1/18/91  CAE	 Enhancement - Added support for the JudgeName call.  *		   Procs affected - input_handlers, output_handlers.  *		   New proc added - judge_name.*  1/21/91  CAE  Bug fix - If we're doing a GetDirEntry call and the output buffer *		   is not big enough to hold the entire name string, we will now*		   store as much of the string as will fit before reporting error.*		   Procs affected - store_string (in output_handlers).*		 Bug fix - GetDirEntry will now return all requested output *		   parameters even if an error occurs during output of the*		   name string. Procs affected - setup_call, app_entry, oh_name.*  1/25/91  CAE  Minor changes to JudgeName.*  1/28/91  CAE  Added word_multiply proc.  Changed some routines to call*		   word_multiply instead of long_multiply.  Procs affected -*		   get_vol_info, hfs_init, ablk2pblk.*		 Changed long_multiply to call word_multiply if the hi words*		   of the multiplier and multiplicand are both 0.*  1/29/91  CAE  Added word_divide proc.  Changed hfs_init to call word_divide *		   instead of long_divide when possible. *		 Changed long_divide to call word_divide if the hi words of*		   the dividend and divisor are both 0.*  1/30/91  CAE	 Rewrote long_multiply to make it faster.*  1/31/91  CAE  Enhancement - Added filetype/auxtype conversion support for *		   DiskCopy disk images. Rewrote get_file_aux and set_file_aux*		   to use one huge conversion table instead of inline code.*  2/01/91  CAE	 Commented out the valence verification code in get_dir_entry *	   	   in order to speed up the code.  *  2/06/91  CAE	 Bug fix (BK052) - JudgeName was not returning error $4F if*		   the size of the name buffer was < 4.*		 Bug fix (BK054) - GetDirEntry crashed if name buffer size = 4.*		   Procs affected - store_string (in output_handlers).*		 Put back the valence verification code in get_dir_entry but the*		   code is now only executed if vcr_cur_dir <> fcr_id.*  2/11/91  CAE	 Bug fix (BK049) - Doing a SetFileInfo call on a volume dir will*		   now result in error $40 instead of $4B in order to be*		   consistent with the ProDOS FST. Procs affected - set_file_info.*		 Bug fix (BK053) - Doing a GetDirEntry call on a file will now*		   result in error $4A instead of $4B in order to be consistent*		   with the ProDOS FST.  Procs affected - get_dir_entry.*  2/12/91  CAE  Bug fix (BK059) - If an Open call was done on a device, the fcr*		   name didn't begin with a colon. A subsequent GetDirEntry call*		   would result in error $6A due to the new valence verification*		   code added on 2/6/91. A leading separator is now added to*		   'disk_name' when allocating an fcr. Procs affected - build_fcr.*  2/18/91  CAE	 Catalog hint is now supplied as input to ct_delete_rec and *		   et_delete_file.  Procs affected - destroy.*		 SetFileInfo will now accept an option_list with a ProDOS ID.*		   Procs affected - read_option_list.*		 Source file catalog hint is now supplied as input to*		   ct_move_rec.  Procs affected - change_path.*  2/26/91  CAE	 Set bit 1 of the FST attributes word in the FST Header. This*		   indicates that HFS is not a valid format for 5.25" disks.*		 Changed the min and max pcounts allowed for Format and Erase_disk.*		 Added error priority handling.  Procs affected - app_entry,*		   setup_call, process_path.*		 Modified Create to call process_path before checking name_count*		   so that error_priority will be set up correctly.*  3/01/91  CAE  Bug fix (BGK072) - Redefined the second field of the option_list*		   to contain the actual data size when doing a SetFileInfo call.*		   Procs affected - read_option_list.*  3/05/91  CAE  Modified error priority handling.  Procs affected - process_path.*  3/13/91  CAE  Bug fix - GetFileInfo didn't return correct eof info if both forks*		   of a file were open and one fork was opened many times read_only*		   and the other fork was opened writable and the eof was changed.*		   Procs affected - get_cat_info.*  3/20/91  CAE  Modified ChangePath to call process_path before checking*		   path2_bit so that error_priority will be set up correctly.*		 Bug fix (BGK060) - ChangePath was comparing the vcr ids to*		   determine if the source and dest were on the same volume instead*		   of comparing the device numbers.  This resulted in duplicate*	 	   volumes being handled incorrectly in certain cases.*  4/03/91  CAE  Bug fix - Class 0 Volume call wasn't allowing 16 char 'volname'.*		   Procs affected - oh_volname.*  6/04/91  CAE  Modified Read to zero out the transfer_count parameter before*		   doing any other checking so that HyperCard 1.0 will be happy*		   if we report an EOF error.  Procs affected - Read.*  9/4/91   JEV  Fixed bug associated with disks over 32MB.  Changed HFS Init.*  10/2/91  GAB	 Set bit 0 and clear bit 1 of the FST attributes word in the FST Header.*		   This indicates that HFS is not a valid format for 5.25" disks.* 10/29/91  MSD  ¥ A file is now locked only if the Rename, Destroy, and Write enable*		   bits are ALL clear (a file used to be locked if ANY of those bits*		   were clear).  This lets an application try to turn off the Destroy*		   bit but still write to the file.*                ¥ Get_Dev_Num sets a flag that tells process_path not to walk the*		   catalog tree.  This helps the Finder if a disk-to-disk copy is*		   aborted and the destination disk's catalog tree was overwritten.* 11/07/91  MSD	 ¥ The build_vcr routine will now return error $5A (damaged_bitmap)*		   when it detects the CTree or ETree to be damaged.  Volume will*		   now return the volume name for this error (like it does with*		   duplicate volume error).* 11/13/91  MSD	 ¥ The above fix wasn't working because it loaded dup_volume*		   back into A after returning the volume name.  It now saves*		   and restores the error around calling oh_volname.* 12/02/91  MSD	 ¥ In walk_path, if we get a not_found error from the CTree routines*		   and we were looking for the volume directory's record (i.e.*		   parent_id = vol_parent_id), then return error $5A instead of*		   file/folder not found.  I wish we had a better way of determining*		   when the disk was damaged in general.* 12/05/91  MSD  ¥ Change_path now accepts a third parameter: flags.  If bit 15 is set*		   and the source was a device name only, then it forces a fake VCR to*		   be built and the volume renamed without chaning any VCR's or the*		   name of the boot volume.  This lets Finder, HandleDiskInsert, etc.*		   rename a duplicate disk without making the OS think the original*		   volume was renamed.  It acts as if there was already a VCR by the*		   same name, with open files on it.  Procs affected: change_path,*		   id_disk.  Added proc ih_cp_flags.* 12/17/91  MSD	 ¥ The FST now tries to find a volume before checking path syntax*		   so it will properly set the error priority bit.  Parse_path no*		   longer tests the span.  Process_path now checks the span (in x_span)*		   after finding the disk.  Note that parse_path can still check*		   for span=0 and that the volume name length is OK (since these are*		   both required for the disk name to be a valid HFS disk name).*		 ¥ Changed version number to 01.00 (final) for final candidate build.* 02/05/92  MSD	 ¥ When doing a Change_Path with bit 15 of the flags set (the "trust*		   me" bit), it first does a swap_out for the given device to prevent*		   multiple online VCR's for a given device.* 02/06/92  MSD	 ¥ If you use a pCount of 3 or 4 for the Create call and supply a*		   file_type of $0F (i.e. a folder), the FST was defaulting the*		   storage type to $05 (extended file).  Now, whenever the file_type*		   is $0F, if forces the storage_type to $0D internally (ignoring*		   anything the caller supplies).** 02/09/92  GAB  ¥  Backed out part of Mark's changes made in the last revision.*		    Neither the ProDOS FST nor the AppleShare FST (or, for that*		    matter, P8) enforces a storage type of $0D when the filetype*		    is $0F.  To make all FSTs consistent, I'm removing the*		    portion of logic that forces the storage type to $0D here*		    too.  I didn't touch the part that decides the proper*		    storage type when the parameter is not supplied, though.************************************************************************************ Begin 6.0.1** 03/23/92 Monte Benaresh*		 ¥  Changed the pseudo stack for the B-tree routines to reside in*		    bank $00 so that the register push and pop routines could be*		    sped up significantly, resulting in an overall improvement of*		    7.7% in Finder file copying speed.  Thus, the memory is now*		    allocated as a Memory Manager block, and stack_vp is now a*		    handle.** 03/25/92 Monte Benaresh*		¥   Changed JUDGENAME syntax string from "Volume namesÉ" to*		    "Disk namesÉ" in conformance with the changes being made*		    to all other strings in the System with similar reference.** 03/26/92 Monte Benaresh*		¥   Further optimized the register push/pop routines by adding a *		    stack_end datum on direct page for checking against the end*		    address of the pseudo stack.** 03/30/92 Monte Benaresh*		¥   Special-cased the long_divide routine for a divisor of $00000200,*		    since this value is extremely common.  This sped up the average*		    long divide by over 5X and imporved Finder file copying by over 3%.** 04/01/92 Monte Benaresh*		¥   Special-cased divisors > $01FF in the word_divide routine,*		    increasing its average speed by over 40% and speeding up*		    file copying in the Finder by about 1.5%.** 04/02/92 Monte Benaresh*		¥   Special-cased multiplier values 0-6 in the word_multiply routine,*		    increasing its average speed by 7X and speeding up file*		    copying in the Finder by another 2.7%.  We are now at 18.4% faster*		    than the version on 6.0.** 7-Apr-92 Dave Lyons*		¥   Monte's stack thang didn't work with P8.  Changed to dispose*		    stack block any any FST shutdown, even warm, and to reallocate*		    it any time we need it & don't already have it.  (GS/OS does*		    not make warm startup calls to FSTs!  Need to fix this!)** 18-Jul-92 Dave Lyons*		¥   Added a STZ newline_flag at do_update in write (search for*		    18-Jul-92), to fix bug where Write stops prematurely after*		    transferring 512 bytes, if the most recent Read call stopped*		    because it hit a newline character.** 2-Apr-93 Steve Stephenson*		¥   Changed version to $0101 for 6.0.1 (final)********************************************************************************		eject********************************************************************************* Imported addresses********************************************************************************		import	ct_create_rec		import	ct_delete_rec		import	ct_get_rec		import	ct_get_dir_kid		import	ct_move_rec		import	ct_rename_rec		import	ct_update		import	ct_compare_key		import	et_delete_file		import	et_extend_file		import	et_trunc_file		import	et_log_2_phys		import	et_compare_key		import	bt_get_node		import	bt_mark_node		import	strcmp				********************************************************************************* Exported addresses********************************************************************************		export	ablk2pblk		export	word_multiply		export	long_multiply		export	word_divide		export	long_divide		export	long_divide_up		export	node_buf_read		export	node_buf_write		export	bitmap_buf_read		export	bitmap_buf_write		export	update_vib		export	update_alt_vib		export	update_bth						eject********************************************************************************* Forward addresses ********************************************************************************		entry	init_fst		entry	kill_fst		entry	kill_vcr		entry	flush_def		entry	cmd_error		entry	fst_op_error				entry	create		entry	destroy		entry	change_path		entry	set_file_info		entry	get_file_info		entry	judge_name		entry	volume		entry	clear_backup		entry	open		entry	read		entry	write		entry	close		entry	flush		entry	set_mark		entry	get_mark		entry	set_eof		entry	get_eof		entry	get_dir_entry		entry	get_dev_num		entry	format		entry	erase_disk;		entry	fst_specific				entry	ih_ref_num				entry	ih_access		 		entry	ih_storage_type				entry	ih_file_type				entry	ih_aux_type				entry	ih_eof			 		entry	ih_resource_eof				entry	ih_create_date				entry	ih_create_time				entry	ih_mod_date				entry	ih_mod_time				entry	ih_create_date_time			entry	ih_mod_date_time			entry	ih_volname				entry	ih_option_list				entry	ih_pcount				entry	ih_command_num				entry	ih_resource_num				entry	ih_cache_priority			entry	ih_request_access			entry	ih_request_count			entry	ih_base					entry	ih_displacement				entry	ih_pathname				entry	ih_new_pathname				entry	ih_devname				entry	ih_data_buffer				entry	ih_null				entry	ih_flush_type				entry	ih_file_sys_id				entry	ih_name_type				entry	ih_name		entry	ih_cp_flags	; Added 5-Dec-91 MSD		entry	oh_ref_num				entry	oh_access		 		entry	oh_storage_type				entry	oh_file_type				entry	oh_aux_type				entry	oh_eof			 		entry	oh_resource_eof				entry	oh_create_date				entry	oh_create_time				entry	oh_mod_date				entry	oh_mod_time				entry	oh_create_date_time			entry	oh_mod_date_time			entry	oh_volname				entry	oh_option_list		entry	oh_transfer_count			entry	oh_position				entry	oh_entry_num		  		entry	oh_dev_number				entry	oh_file_sys_id		 		entry	oh_block_size		  		entry	oh_extended_flag		  		entry	oh_total_blocks		  		entry	oh_blocks_used				entry	oh_free_blocks				entry	oh_resource_blocks			entry	oh_name					entry	oh_syntax					entry	oh_max_len					entry	oh_name_flags							eject		include	'common.equ.src'		include	'hw.equ.src'		include 'hfs.fst.equ'		include 'm16.debug'				eject********************************************************************************* FST HEADER* Used by GS/OS	at boot	time.********************************************************************************fst_header	PROCcode_start						        		DC.B	'FST '			;Load identification (4	bytes)		DC.L	app_entry		;Entry point for application calls		DC.L	sys_entry		;Entry point for system	calls		DC.W	hfs_id			;HFS FST ID		DC.W	$2001			;Flags 		DC.W	$0101			;Version 1.01 final		DC.W	$200			;Normal	block size  (512 bytes)		DC.L	$ffffffff		;Maximum blocks/volume		DC.L	min_vol_size		;Minimum blocks/volume		DC.L	$ffffffff		;Maximum file size (in bytes)		DC.L	$00000000		;Reserved		DC.B	3			;Length	of FST name		DC.B	'HFS'			;Text of FST name		DC.B	end_comment-start_commentstart_comment	DC.B	'HFS FST               v01.01'end_comment		DC.W	0000			;reserved field		DC.B	end_credit-start_creditstart_credit	DC.B	'Copyright 1987-1992 Apple Computer, Inc. '		DC.B	'Written by Cheryl Ewy and Cary Farrier.'end_credit		ENDP				eject********************************************************************************* DATA STORAGE AREA********************************************************************************data		RECORD	export;------------------------------------------------------------------------------; Storage for input and output parameters;------------------------------------------------------------------------------start_params					;start of parameter storage; input parameterspcount		DS.B	2			;parameter countresource_num	DS.B	2			;resource numbercache_priority	DS.B	2			;cache priority	flagrequest_access	DS.B	2			;request access	permissionsrequest_count	DS.B	4			;request countbase		DS.B	2			;basedisplacement	DS.B	4			;displacementflush_type	DS.B	2			;flush typename_type	DS.B	2			;name typename_ptr	DS.B	4			;name ptr;command_num	DS.B	2			;fst_specific command number cp_flags	DS.B	2			;flags for change_path (5-Dec-91 MSD); input/output parametersref_num		DS.B	2			;file reference	numberaccess		DS.B	2			;access informationstorage_type	DS.B	2			;storage typefile_type	DS.B	2			;file typeaux_type	DS.B	4			;aux typeeof		DS.B	4			;data fork end of fileresource_eof	DS.B	4			;resource fork end of filecreate_date_time DS.B	8			;create date/time (class 1)create_date	equ	create_date_time	;create date (class 0)create_time	equ	create_date+2		;create time (class 0)mod_date_time	DS.B	8			;modification date/time (class 1)mod_date	equ	mod_date_time		;modification date (class 0)mod_time	equ	mod_date+2		;modification time (class 0)finder_info	DS.B	32			;option list - finder info; output parameterstransfer_count	DS.B	4			;transfer countfile_mark	DS.B	4			;file markentry_num	DS.B	2			;entry numberdev_number	DS.B	2			;device	numberextended_flag	DS.B	2			;extended flagtotal_blocks	DS.B	4			;total blocksblocks_used	DS.B	4			;blocks	usedfree_blocks	DS.B	4			;free blocksresource_blocks	DS.B	4			;resource blocks usedmax_len		DS.B	2			;maximum name lengthname_flags	DS.B	2			;name flagsend_params					;end of parameter storagelen_params	equ	end_params-start_params	;length of parameter storage;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;	GS/OS class 1 format 'date/time' structure (8 bytes);;		byte 0   	second	(0-59)		;		byte 1   	minute	(0-59);		byte 2   	hour	(0-23);		byte 3   	year	(year-1900);		byte 4   	day	(0-30);		byte 5   	month	(0-11);		byte 6   	null;		byte 7   	weekday (1-7, 1 = Sunday)	;;	ProDOS class 0 format 'date' structure (2 bytes);;		bits 0-4	day	(1-31);		bits 5-8	month	(1-12);		bits 9-15	year	(year-1900);;	ProDOS class 0 format 'time' structure (2 bytes);;		bits 0-7	minute	(0-59);		bits 8-15	hour	(0-23);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;------------------------------------------------------------------------------; Storage used by the tree routines;------------------------------------------------------------------------------; data register equivalents		EXPORT	d0		EXPORT	d1		EXPORT	d2		EXPORT	d3		EXPORT	d4		EXPORT	d5		EXPORT	d6		EXPORT	d7		d0		DS.B	4d1		DS.B	4d2		DS.B	4d3		DS.B	4d4		DS.B	4d5		DS.B	4d6		DS.B	4d7		DS.B	4; data storage used for the Catalog Tree		EXPORT	cky_buffer		EXPORT	cat_buffercky_buffer	DS.B	max_cky_len		;buffer for CTree Key Recordcat_buffer	DS.B	max_cat_len		;buffer for CTree Catalog Recordctree_idx_rec	DS.B	max_cky_len+len_ptr	;Index Record (Key + Ptr) for CTreectree_tpt	DS.B	len_tpt			;Tree Path Table for CTree; data storage used for the Extents Tree		EXPORT	eky_buffer		EXPORT	ext_buffereky_buffer	DS.B	len_eky			;buffer for ETree Key Recordext_buffer	DS.B	len_ext			;buffer for ETree Extents Recordetree_idx_rec	DS.B	len_eky+len_ptr		;Index Record (Key + Ptr) for ETreeetree_tpt	DS.B	len_tpt			;Tree Path Table for ETree; node buffers   		EXPORT	node_buf1		EXPORT	node_buf2		EXPORT	node_buf3		EXPORT	node_buf4node_buf1	DS.B	len_node_buf		;first node buffernode_buf2	DS.B	len_node_buf		;second node buffernode_buf3	DS.B	len_node_buf		;third node buffernode_buf4	DS.B	len_node_buf		;fourth node buffer;------------------------------------------------------------------------------; Miscellaneous	storage;------------------------------------------------------------------------------; call informationclass		DS.B	2			;current class #call		DS.B	2			;current call #trans_call	DS.B	2			;translated call # times 2call_flags	DS.B	2			;call flags wordmin_pcount	DS.B	2			;minimum pcount for callmax_pcount	DS.B	2			;maximum pcount for callparam_count	DS.B	2			;parameter countparam_index	DS.B	2			;parameter list indexparam_flags	DS.B	2			;flags word for	parameterinput_error	DS.B	2			;storage for input errorerror_priority	DS.B	2			;storage for error priority; pathname informationx_path_flag	DS.B	2			;non-zero if pathname specified, else 0x_dev_num	DS.B	2			;device number if specified, else 0x_span		DS.B	2			;maximum span of pathnamevolname		DS.B	30			;volume	name in	gstring	formatname_count	DS.B	2			;count of names	in pathname first_offset	DS.B	2			;offset to first name in pathnamelast_offset	DS.B	2			;offset to last name in pathnamecurrent_offset	DS.B	2			;offset to current name in pathname; vcr information 		EXPORT	ablk_size		EXPORT	ctree_fcr_ptr		EXPORT	etree_fcr_ptr		ablk_size	DS.B	4			;allocation block size (in bytes)ablk_start	DS.B	2			;loc of first alloc block (P blk #)pblks_per_ablk	DS.B	2			;# of physical blocks per alloc blockctree_fcr_ptr	DS.B	4			;ptr to fcr for CTreeetree_fcr_ptr	DS.B	4			;ptr to fcr for ETree; fcr informationtype		DS.B	2			;fcr typeblock_mark	DS.B	2			;block buffer markblock_num	DS.B	4			;# of physical block in block bufferblock_count	DS.B	4			;# physical blocks until end of extent; Catalog Record informationcatalog_hint	DS.B	4			;catalog hintparent_id	DS.B	4			;parent dir IDid		DS.B	4			;file/dir IDrecord_type	DS.B	2			;Catalog Record typerecord_name	DS.B	32			;Catalog Record name (class 0 string); newline informationnewline_mask	DS.B	2			;mask for newlinenewline_ptr	DS.B	4			;pointer to newline listnewline_length	DS.B	2			;length	of newline listnewline_char	DS.B	2			;first byte of newline listnewline_flag	DS.B	2			;1 if newline char found, else 0; read/write informationbytes_left	DS.B	4			;# bytes until request is satisfiedxfer_count	DS.B	4			;# bytes transferedwrite_occurred	DS.B	2			;non-zero if write occurred during app callwrite_dev_num	DS.B	2			;device # written to; Change_Path local data storagesrc_vcr_id	DS.B	2			;vcr ID src_dev_num	DS.B	2			;device numbersrc_cat_hint	DS.B	4			;catalog hintsrc_parent_id	DS.B	4			;parent dir ID src_id		DS.B	4			;file/dir IDsrc_record_name	DS.B	32			;Catalog Record name (class 0 string)src_locked	DS.B	2			;error code from 'is_file_unlocked'src_is_vol	DS.B	2			;1 if source is volume dir, else 0; Scan_devices local data storagecurrent_device	DS.B	2			;current device #start_device	DS.B	2			;starting device #; Data_buf_read/data_buf_write local data storagenum_blocks	DS.B	4			;number of blocks to read/write; Create local data storagerequested_stype	DS.B	2			;requested storage type ; Look_for_fcr local data storagefcr_index	DS.B	2			;index into FCR list ; Get_Dev_Num flag (if set, process_path doesn't call walk_path)Doing_GDN	ds.b	2			; non-zero if Get_Dev_Num is the active call; miscellaneous information		EXPORT	time		EXPORT	save_gbuf_ptr2		time		DS.B	4			;date/time at start of call (in seconds)save_gbuf_ptr1	DS.B	4			;ptr to 512 byte general purpose buffersave_gbuf_ptr2	DS.B	4			;ptr to 512 byte general purpose bufferstack_vp	DS.B	4			;(VP) to psuedo stack for tree routines						; changed to MM handle 3/23/92 by						; Monte Benareshsave_drvr_cache	DS.B	2			;value of <drvr_cache at call startoption_flag	DS.B	2			;1 = option list valid, else 0id_disk_flag	DS.B	2			;1 = id_disk routine active, else 0cp_device_flag	DS.B	2			;1 = ChangePath using device name, else 0io_flag		DS.B	2			;I/O flag for process_paramswp_status_flag 	DS.B	2			;1 = disk is write-protectedgde_buf_err	DS.B	2			;0 = no buffer error from GetDirEntrystatus_list	DS.B	6			;space for status listdisk_name0	DS.B	1			;MUST PRECEED disk_name !!!disk_name	DS.B	31			;disk name in gstring format; Space to save driver direct page during do_rw_callsaved_drvr_dp	DS.B	len_drvr_dp		;space to save driver direct page;------------------------------------------------------------------------------; Strings and Constants;------------------------------------------------------------------------------ctree_str	DC.W	7			;filename string for CTree FCR		DC.B	' CTree '		DC.B	$00		etree_str	DC.W	7			;filename string for ETree FCR		DC.B	' ETree '		DC.B	$00		fake_name_str	DC.W	6			;fake name string for VCR		DC.B	$C		DC.B	$A		DC.B	$E		DC.B	$C		DC.B	$A		DC.B	$F		DC.B	$00		control_list	DC.W	10			;partition owner name for FORMAT and ERASE		DC.B	'Apple_HFS'				DC.B	$00			;must end with a NUL		syntax_str	DC.B	end_text-start_text			start_text	DC.B	'HFS names may contain any character except a colon (:). '		DC.B	'Disk names may be up to 27 characters long. '		DC.B	'File and folder names may be up to 31 characters long.'end_textmax_dt_values					;maximum date/time values 		DC.B	59			;max second value 		DC.B	59			;max minute value 		DC.B	23			;max hour value 		DC.B	255			;max year value 		DC.B	30			;max day value 		DC.B	11			;max month value 		DC.B	0			;max null value 		DC.B	7			;max weekday value ;------------------------------------------------------------------------------; Constant data for CTree and ETree BCRs;------------------------------------------------------------------------------ctree_bcr_data					;start of default data for ctree bcr		DC.L	ct_compare_key		;ptr to ctree's key compare routine		DC.L	ctree_idx_rec		'ptr to ctree's index record buffer		DC.L	ctree_tpt		;ptr to ctree's Tree Path Tableetree_bcr_data					;start of default data for etree bcr		DC.L	et_compare_key		;ptr to etree's key compare routine		DC.L	etree_idx_rec		'ptr to etree's index record buffer		DC.L	etree_tpt		;ptr to etree's Tree Path Tablelen_bcr_data	equ	etree_bcr_data-ctree_bcr_data;------------------------------------------------------------------------------; HFS creator/filetype <-> ProDOS filetype/auxtype conversion table;------------------------------------------------------------------------------conversion_table 		DC.B	'pdos'			;HFS creator		DC.B	'PS16'			;HFS filetype		DC.B	$B3			;ProDOS filetype		DC.B	$00			;ProDOS auxtype				DC.B	'pdos'			;HFS creator		DC.B	'PSYS'			;HFS filetype		DC.B	$FF			;ProDOS filetype		DC.B	$00			;ProDOS auxtype		DC.L	$FFFFFFFF		;matches any HFS creator		DC.B	'BINA'			;HFS filetype		DC.B	$00			;ProDOS filetype		DC.B	$00			;ProDOS auxtype				DC.L	$FFFFFFFF		;matches any HFS creator		DC.B	'TEXT'			;HFS filetype		DC.B	$04			;ProDOS filetype		DC.B	$00			;ProDOS auxtype				DC.L	$FFFFFFFF		;matches any HFS creator		DC.B	'MIDI'			;HFS filetype		DC.B	$D7			;ProDOS filetype		DC.B	$00			;ProDOS auxtype				DC.L	$FFFFFFFF		;matches any HFS creator		DC.B	'AIFF'			;HFS filetype		DC.B	$D8			;ProDOS filetype		DC.B	$00			;ProDOS auxtype				DC.L	$FFFFFFFF		;matches any HFS creator		DC.B	'AIFC'			;HFS filetype		DC.B	$D8			;ProDOS filetype		DC.B	$01			;ProDOS auxtype				DC.B	'dCpy'			;HFS creator		DC.B	'dImg'			;HFS filetype		DC.B	$E0			;ProDOS filetype		DC.B	$05			;ProDOS auxtypeend_table		entry_size	equ	10			;size of a table entry in bytestable_size	equ	end_table-conversion_table	;size of the table in bytes;------------------------------------------------------------------------------; Bouncing errors list;------------------------------------------------------------------------------bounce_list	dc.w	bad_system_call		dc.w	invalid_pcount		dc.w	bad_path_syntax		dc.w	vol_not_found		dc.w	unknown_vol		dc.w	not_block_devend_bounce_list					;end of bounce list		eject;------------------------------------------------------------------------------; Dispatch table for application commands;------------------------------------------------------------------------------app_tbl		DC.W	create			;($01) create		DC.W	destroy			;($02) destroy		DC.W	cmd_error		;($03) unimplemented		DC.W	change_path		;($04) change_path		DC.W	set_file_info		;($05) set_file_info		DC.W	get_file_info		;($06) get_file_info		DC.W	judge_name		;($07) judge_name		DC.W	volume			;($08) volume		DC.W	cmd_error		;($09) set_prefix		DC.W	cmd_error		;($0A) get_prefix		DC.W	clear_backup		;($0B) clear_backup		DC.W	cmd_error		;($0C) unimplemented		DC.W	cmd_error		;($0D) unimplemented		DC.W	cmd_error		;($0E) unimplemented		DC.W	cmd_error		;($0F) unimplemented		DC.W	open			;($10) open		DC.W	cmd_error		;($11) newline		DC.W	read			;($12) read		DC.W	write			;($13) write		DC.W	close			;($14) close		DC.W	flush			;($15) flush		DC.W	set_mark		;($16) set_mark		DC.W	get_mark		;($17) get_mark		DC.W	set_eof			;($18) set_eof		DC.W	get_eof			;($19) get_eof		DC.W	cmd_error		;($1A) set_level		DC.W	cmd_error		;($1B) get_level		DC.W	get_dir_entry		;($1C) get_dir_entry		DC.W	cmd_error		;($1D) unimplemented		DC.W	cmd_error		;($1E) unimplemented		DC.W	cmd_error		;($1F) unimplemented		DC.W	get_dev_num		;($20) get_dev_num		DC.W	cmd_error		;($21) get_last_dev		DC.W	cmd_error		;($22) read_block		DC.W	cmd_error		;($23) write_block		DC.W	format			;($24) format		DC.W	erase_disk		;($25) erase_disk		DC.W	cmd_error		;($26) get_pathname		DC.W	cmd_error		;($27) get_name		DC.W	cmd_error		;($28) get_boot_vol		DC.W	cmd_error		;($29) quit		DC.W	cmd_error		;($2A) get_version		DC.W	cmd_error		;($2B) get_fst_info		DC.W	cmd_error		;($2C) d_info		DC.W	cmd_error		;($2D) d_status		DC.W	cmd_error		;($2E) d_control		DC.W	cmd_error		;($2F) d_read		DC.W	cmd_error		;($30) d_write		DC.W	cmd_error		;($31) alloc_interrupt		DC.W	cmd_error		;($32) dealloc_interrupt		DC.W	fst_op_error		;($33) fst_specific;------------------------------------------------------------------------------; Dispatch table for system commands;------------------------------------------------------------------------------sys_tbl		DC.W	init_fst		;startup fst		DC.W	kill_fst		;shutdown fst		DC.W	kill_vcr		;releasing a VCR		DC.W	flush_def		;flush deferred blocks;------------------------------------------------------------------------------; Dispatch table for fst_specific commands;------------------------------------------------------------------------------;fst_tbl	DC.W	0000			;(no FST specific calls yet)		eject;------------------------------------------------------------------------------; Call List;------------------------------------------------------------------------------; The following	list is used to translate GS/OS application calls, which this ; FST handles, into sequential values. call_list	DC.B	$01			;create		DC.B	$02			;destroy		DC.B	$04			;change path		DC.B	$05			;set file info		DC.B	$06			;get file info		DC.B	$07			;judge name		DC.B	$08			;volume		DC.B	$0B			;clear backup bit		DC.B	$10			;open		DC.B	$12			;read		DC.B	$13			;write		DC.B	$14			;close		DC.B	$15			;flush		DC.B	$16			;set mark		DC.B	$17			;get mark		DC.B	$18			;set eof		DC.B	$19			;get eof		DC.B	$1C			;get dir entry		DC.B	$20			;get dev num		DC.B	$24			;format		DC.B	$25			;erase;		DC.B	$33			;fst specificend_call_list					;end of call list;------------------------------------------------------------------------------; Call Flags Table;------------------------------------------------------------------------------; The following	table is used to setup and verify some parameters.; Each call has	a one word entry in the	table with the following format:;;     1	- Max pcount for the call;     2	- Min pcount for the call;     3	- Pathnames used by call;     4	- Volume control record	used;     5	- File control record used;;	        |5|4|3|	 2  |	 1    |;      _________|_|_|_|_____|_________|;     |	| | | |	| | | |	| | | |	| | | |;     |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|;     |		      |		      |;      f	     8 7	     0call_flags_tbl	DC.W	max_pcnt7+min_pcnt1+path_used 		;Create		DC.W	max_pcnt1+min_pcnt1+path_used 		;Destroy		DC.W	max_pcnt3+min_pcnt2+path_used 		;Change_path (maxpcnt3 5-Dec-91 MSD)		DC.W	max_pcnt12+min_pcnt2+path_used 		;Set_file_info		DC.W	max_pcnt12+min_pcnt2+path_used 		;Get_file_Info		DC.W	max_pcnt6+min_pcnt3	 		;Judge_name		DC.W	max_pcnt6+min_pcnt2			;Volume		DC.W	max_pcnt1+min_pcnt1+path_used 		;Clear_backup		DC.W	max_pcnt15+min_pcnt2+path_used 		;Open		DC.W	max_pcnt5+min_pcnt4+vcr_used+fcr_used 	;Read		DC.W	max_pcnt5+min_pcnt4+vcr_used+fcr_used	;Write		DC.W	max_pcnt1+min_pcnt1+vcr_used+fcr_used 	;Close		DC.W	max_pcnt2+min_pcnt1+vcr_used+fcr_used	;Flush		DC.W	max_pcnt3+min_pcnt3+vcr_used+fcr_used 	;Set_mark		DC.W	max_pcnt2+min_pcnt2+fcr_used 		;Get_mark		DC.W	max_pcnt3+min_pcnt3+vcr_used+fcr_used 	;Set_eof		DC.W	max_pcnt2+min_pcnt2+fcr_used 		;Get_eof		DC.W	max_pcnt17+min_pcnt5+vcr_used+fcr_used 	;Get_dir_entry		DC.W	max_pcnt2+min_pcnt2+path_used 		;Get_dev_num		DC.W	max_pcnt6+min_pcnt1+path_used		;Format		DC.W	max_pcnt6+min_pcnt1+path_used		;Erase;		DC.W	max_pcnt2+min_pcnt2			;Fst_specific		eject;------------------------------------------------------------------------------; Parameter List Tables;------------------------------------------------------------------------------; The following	tables point to	the parameter lists for class 0 and 1 app calls. param_list_tbl_0		DC.W	call_01_class0		;Create		DC.W	call_02_class0		;Destroy		DC.W	call_04_class0		;Change_path		DC.W	call_05_class0		;Set_file_info		DC.W	call_06_class0		;Get_file_info		DC.W	0			;Judge_name (class 1 call only)		DC.W	call_08_class0		;Volume		DC.W	call_0B_class0		;Clear_backup		DC.W	call_10_class0		;Open		DC.W	call_12_class0		;Read		DC.W	call_13_class0		;Write		DC.W	call_14_class0		;Close		DC.W	call_15_class0		;Flush		DC.W	call_16_class0		;Set_mark		DC.W	call_17_class0		;Get_mark		DC.W	call_18_class0		;Set_eof		DC.W	call_19_class0		;Get_eof		DC.W	call_1c_class0		;Get_dir_entry		DC.W	call_20_class0		;Get_dev_num		DC.W	call_24_class0		;Format		DC.W	call_25_class0		;Erase_diskparam_list_tbl_1		DC.W	call_01_class1		;Create		DC.W	call_02_class1		;Destroy		DC.W	call_04_class1		;Change_path		DC.W	call_05_class1		;Set_file_info		DC.W	call_06_class1		;Get_file_info		DC.W	call_07_class1		;Judge_name (class 1 call only)		DC.W	call_08_class1		;Volume		DC.W	call_0B_class1		;Clear_backup		DC.W	call_10_class1		;Open		DC.W	call_12_class1		;Read		DC.W	call_13_class1		;Write		DC.W	call_14_class1		;Close		DC.W	call_15_class1		;Flush		DC.W	call_16_class1		;Set_mark		DC.W	call_17_class1		;Get_mark		DC.W	call_18_class1		;Set_eof		DC.W	call_19_class1		;Get_eof		DC.W	call_1c_class1		;Get_dir_entry		DC.W	call_20_class1		;Get_dev_num		DC.W	call_24_class1		;Format		DC.W	call_25_class1		;Erase_disk;		DC.W	call_33_class1		;Fst_specific (class 1 call only);------------------------------------------------------------------------------; Parameter Lists;------------------------------------------------------------------------------; Each call has	a list of one word entries with	the following format:;;     1	- parameter number ;     2	- I/O flag: 0 =	input, 1 = output;     3	- parameter offset;     4	- Terminator: 1	= last entry in	list;;     |4|      3      |2|      1      |;     |_|_____________|_|_____________|;     |	| | | |	| | | |	| | | |	| | | |;     |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|;     |		      |		      |;      f	     8 7	     0  ** Create parameter lists.*call_01_class0	DC.W	i_pathname+offset0		DC.W	i_access+offset4		DC.W	i_file_type+offset6		DC.W	i_aux_type+offset8		DC.W	i_storage_type+offsetC		DC.W	i_create_date+offsetE		DC.W	i_create_time+offset10+terminate_flagcall_01_class1	DC.W	i_pcount+offset0		DC.W	i_pathname+offset2		DC.W	i_access+offset6		DC.W	i_file_type+offset8		DC.W	i_aux_type+offsetA		DC.W	i_storage_type+offsetE		DC.W	i_eof+offset10		DC.W	i_resource_eof+offset14+terminate_flag** Destroy parameter lists.*call_02_class0	DC.W	i_pathname+offset0+terminate_flagcall_02_class1	DC.W	i_pcount+offset0		DC.W	i_pathname+offset2+terminate_flag** Change_path parameter lists.*call_04_class0	DC.W	i_pathname+offset0		DC.W	i_new_pathname+offset4+terminate_flagcall_04_class1	DC.W	i_pcount+offset0		DC.W	i_pathname+offset2		DC.W	i_new_pathname+offset6		DC.W	i_cp_flags+offsetA+terminate_flag	; Added 5-Dec-91 MSD** Set_file_info	parameter lists.*call_05_class0	DC.W	i_pathname+offset0		DC.W	i_access+offset4		DC.W	i_file_type+offset6		DC.W	i_aux_type+offset8		DC.W	i_create_date+offsetE		DC.W	i_create_time+offset10		DC.W	i_mod_date+offset12		DC.W	i_mod_time+offset14+terminate_flagcall_05_class1	DC.W	i_pcount+offset0		DC.W	i_pathname+offset2		DC.W	i_access+offset6		DC.W	i_file_type+offset8		DC.W	i_aux_type+offsetA		DC.W	i_null+offsetE		DC.W	i_create_date_time+offset10		DC.W	i_mod_date_time+offset18		DC.W	i_option_list+offset20+terminate_flag** Get_file_info	parameter lists.*call_06_class0	DC.W	i_pathname+offset0		DC.W	o_access+offset4		DC.W	o_file_type+offset6		DC.W	o_aux_type+offset8		DC.W	o_storage_type+offsetC		DC.W	o_create_date+offsetE		DC.W	o_create_time+offset10		DC.W	o_mod_date+offset12		DC.W	o_mod_time+offset14		DC.W	o_blocks_used+offset16+terminate_flagcall_06_class1	DC.W	i_pcount+offset0		DC.W	i_pathname+offset2		DC.W	o_access+offset6		DC.W	o_file_type+offset8		DC.W	o_aux_type+offsetA		DC.W	o_storage_type+offsetE		DC.W	o_create_date_time+offset10		DC.W	o_mod_date_time+offset18		DC.W	o_option_list+offset20		DC.W	o_eof+offset24		DC.W	o_blocks_used+offset28		DC.W	o_resource_eof+offset2C		DC.W	o_resource_blocks+offset30+terminate_flag** Judge_name parameter list (this is a class 1 call only).* call_07_class1	DC.W	i_pcount+offset0		DC.W	i_file_sys_id+offset2		DC.W	i_name_type+offset4		DC.W	o_syntax+offset6		DC.W	o_max_len+offsetA		DC.W	i_name+offsetC		DC.W	o_name_flags+offset10+terminate_flag** Volume parameter lists.*call_08_class0	DC.W	i_devname+offset0		DC.W	o_volname+offset4		DC.W	o_total_blocks+offset8		DC.W	o_free_blocks+offsetC		DC.W	o_file_sys_id+offset10+terminate_flagcall_08_class1	DC.W	i_pcount+offset0		DC.W	i_devname+offset2		DC.W	o_volname+offset6		DC.W	o_total_blocks+offsetA		DC.W	o_free_blocks+offsetE		DC.W	o_file_sys_id+offset12		DC.W	o_block_size+offset14+terminate_flag** Clear_backup parameter lists.*call_0B_class0	DC.W	i_pathname+offset0+terminate_flagcall_0B_class1	DC.W	i_pcount+offset0		DC.W	i_pathname+offset2+terminate_flag** Open parameter lists.*call_10_class0	DC.W	o_ref_num+offset0		DC.W	i_pathname+offset2+terminate_flagcall_10_class1	DC.W	i_pcount+offset0		DC.W	o_ref_num+offset2		DC.W	i_pathname+offset4		DC.W	i_request_access+offset8		DC.W	i_resource_num+offsetA		DC.W	o_access+offsetC		DC.W	o_file_type+offsetE		DC.W	o_aux_type+offset10		DC.W	o_storage_type+offset14		DC.W	o_create_date_time+offset16		DC.W	o_mod_date_time+offset1E		DC.W	o_option_list+offset26		DC.W	o_eof+offset2A		DC.W	o_blocks_used+offset2E		DC.W	o_resource_eof+offset32		DC.W	o_resource_blocks+offset36+terminate_flag** Read and Write parameter lists.*call_12_class0	call_13_class0	DC.W	i_ref_num+offset0		DC.W	i_data_buffer+offset2		DC.W	i_request_count+offset6		DC.W	o_transfer_count+offsetA+terminate_flagcall_12_class1	call_13_class1	DC.W	i_pcount+offset0		DC.W	i_ref_num+offset2		DC.W	i_data_buffer+offset4		DC.W	i_request_count+offset8		DC.W	o_transfer_count+offsetC		DC.W	i_cache_priority+offset10+terminate_flag** Close	parameter list.*call_14_class0	DC.W	i_ref_num+offset0+terminate_flagcall_14_class1	DC.W	i_pcount+offset0		DC.W	i_ref_num+offset2+terminate_flag** Flush parameter list.*call_15_class0	DC.W	i_ref_num+offset0+terminate_flag		call_15_class1	DC.W	i_pcount+offset0		DC.W	i_ref_num+offset2		DC.W	i_flush_type+offset4+terminate_flag** Set_mark and Set_eof parameter lists.*call_16_class0	call_18_class0	DC.W	i_ref_num+offset0		DC.W	i_displacement+offset2+terminate_flagcall_16_class1	call_18_class1	DC.W	i_pcount+offset0		DC.W	i_ref_num+offset2		DC.W	i_base+offset4		DC.W	i_displacement+offset6+terminate_flag** Get_mark parameter lists.*call_17_class0	DC.W	i_ref_num+offset0		DC.W	o_position+offset2+terminate_flagcall_17_class1	DC.W	i_pcount+offset0		DC.W	i_ref_num+offset2		DC.W	o_position+offset4+terminate_flag** Get_eof parameter lists.*call_19_class0	DC.W	i_ref_num+offset0		DC.W	o_eof+offset2+terminate_flagcall_19_class1	DC.W	i_pcount+offset0		DC.W	i_ref_num+offset2		DC.W	o_eof+offset4+terminate_flag** Get_dir_entry	parameter lists.*call_1c_class0	DC.W	i_ref_num+offset0		DC.W	o_extended_flag+offset2		DC.W	i_base+offset4		DC.W	i_displacement+offset6		DC.W	o_name+offset8		DC.W	o_entry_num+offsetC		DC.W	o_file_type+offsetE		DC.W	o_eof+offset10		DC.W	o_blocks_used+offset14		DC.W	o_create_date_time+offset18		DC.W	o_mod_date_time+offset20		DC.W	o_access+offset28		DC.W	o_aux_type+offset2A		DC.W	o_file_sys_id+offset2E+terminate_flagcall_1c_class1	DC.W	i_pcount+offset0		DC.W	i_ref_num+offset2		DC.W	o_extended_flag+offset4		DC.W	i_base+offset6		DC.W	i_displacement+offset8		DC.W	o_name+offsetA		DC.W	o_entry_num+offsetE		DC.W	o_file_type+offset10		DC.W	o_eof+offset12		DC.W	o_blocks_used+offset16		DC.W	o_create_date_time+offset1A		DC.W	o_mod_date_time+offset22		DC.W	o_access+offset2A		DC.W	o_aux_type+offset2C		DC.W	o_file_sys_id+offset30		DC.W	o_option_list+offset32		DC.W	o_resource_eof+offset36		DC.W	o_resource_blocks+offset3A+terminate_flag** Get_dev_num parameter lists.*call_20_class0	DC.W	i_devname+offset0		DC.W	o_dev_number+offset4+terminate_flagcall_20_class1	DC.W	i_pcount+offset0		DC.W	i_devname+offset2		DC.W	o_dev_number+offset6+terminate_flag** Format and Erase_disk parameter lists.*call_24_class0call_25_class0	DC.W	i_devname+offset0+terminate_flagcall_24_class1call_25_class1	DC.W	i_pcount+offset0		DC.W	i_devname+offset2+terminate_flag** Fst_specific parameter list (this is always a class 1 call).* @@@ no fst_specific commands supported yet*;call_33_class1	DC.W	i_pcount+offset0;		DC.W	i_command_num+offset4+terminate_flag;------------------------------------------------------------------------------; Parameter Handlers Table;------------------------------------------------------------------------------; The following	table is a list	of the parameter handler addresses.; Note - this table is indexed using the parameter number * 2handlers_tbl			DC.W	ih_ref_num				DC.W	ih_access		 		DC.W	ih_storage_type				DC.W	ih_file_type				DC.W	ih_aux_type				DC.W	ih_eof			 		DC.W	ih_resource_eof				DC.W	ih_create_date				DC.W	ih_create_time				DC.W	ih_mod_date				DC.W	ih_mod_time				DC.W	ih_create_date_time			DC.W	ih_mod_date_time			DC.W	ih_volname				DC.W	ih_option_list				DC.W	ih_pcount				DC.W	ih_command_num				DC.W	ih_resource_num				DC.W	ih_cache_priority			DC.W	ih_request_access			DC.W	ih_request_count			DC.W	ih_base					DC.W	ih_displacement				DC.W	ih_pathname				DC.W	ih_new_pathname				DC.W	ih_devname				DC.W	ih_data_buffer		DC.W	ih_null				DC.W	ih_flush_type		DC.W	ih_file_sys_id				DC.W	ih_name_type				DC.W	ih_name				DC.W	oh_ref_num				DC.W	oh_access		 		DC.W	oh_storage_type				DC.W	oh_file_type				DC.W	oh_aux_type				DC.W	oh_eof			 		DC.W	oh_resource_eof				DC.W	oh_create_date				DC.W	oh_create_time				DC.W	oh_mod_date				DC.W	oh_mod_time				DC.W	oh_create_date_time			DC.W	oh_mod_date_time			DC.W	oh_volname				DC.W	oh_option_list		DC.W	oh_transfer_count			DC.W	oh_position				DC.W	oh_entry_num		  		DC.W	oh_dev_number				DC.W	oh_file_sys_id		 		DC.W	oh_block_size		  		DC.W	oh_extended_flag		  		DC.W	oh_total_blocks		  		DC.W	oh_blocks_used				DC.W	oh_free_blocks				DC.W	oh_resource_blocks			DC.W	oh_name					DC.W	oh_syntax					DC.W	oh_max_len					DC.W	oh_name_flags					DC.W	ih_cp_flags		; 5-Dec-91 MSD******************************************************************************		ENDR				eject********************************************************************************	 Name:	sys_entry** Description:	Entry point for	all FST	system calls.  Called by GS/OS only.**	Entry:	jsl**	 Exit:	rtl**	Input:	A = undefined*		X = call number	times 2*		Y = undefined*		P = nvmxdizc*		    ..000...**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	**   Called by:	SCM**	Calls:	all system call handlers** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************sys_entry	PROC		with	data** Setup	environment.*		phk				;setup our data bank register		plb** Call # valid?*		cpx	#max_sys_cmd+1		;command # in range?		bcc	valid			;yes		lda	#bad_system_call	;no - so get error code		rtl				;and exit with carry set** Jump to call handler.*valid		jmp	(sys_tbl-2,x)		;do it		ENDP				eject********************************************************************************	 Name:	init_fst** Description:	This routine is called by SCM to startup the HFS FST.**	Entry:	jmp**	 Exit:	rtl**	Input:	A = undefined*		X = call number	times 2*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		>warm_cold_flag - 0 if cold startup, non-zero if warm startup**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		save_gbuf_ptr1 - ptr to 512 byte general purpose buffer*		save_gbuf_ptr2 - ptr to 512 byte general purpose buffer*		stack_vp - (vp) handle for psuedo stack**	 Uses:	all registers**   Called by:	sys_entry**	Calls:	get_sys_gbuf	(system service)*		alloc_seg	(system service)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************init_fst	PROC		with	data** Get the pointer to GS/OS's 1K general purpose buffer.* We'll use the space as two 512 byte buffers, so we'll save two pointers.*		jsl	get_sys_gbuf		;get ptr to GS/OS's general purpose buffer 		stx	save_gbuf_ptr1		;and save as ptr to first 512 byte buffer		sty	save_gbuf_ptr1+2				clc				;calculate ptr to the second 512 bytes		txa		adc	#512		sta	save_gbuf_ptr2		;and save		tya		adc	#0		sta	save_gbuf_ptr2+2;;; 7-Apr-92 DAL -- Allocate bank 0 block on every startup;;;                 (But GS/OS never calls us warm!  Will fix this.);*;* Are we doing a warm startup?  Don't re-allocate psuedo stack if so.;*;		lda	>warm_cold_flag		;are we doing a warm startup?;		bne	done			;yes - so we're done** Get memory for psuedo stack and save vp.*;	memory allocation changed from Info Manager segment to a Memory Manager;	block in bank 0 so we can use stack relative instructions in the;	push/pop routines for speed -- Monte Benaresh 3/23/92		;lda	#stack_size		;get default stack size		;jsl	alloc_seg		;allocate memory		;bcs	mem_err					;stx	stack_vp		;save the VP		;sty	stack_vp+2		pha		pha				;space for result		pea stack_size>>16		pea <stack_size			;size requested, should be an						;even # of pages so that we don't						;screw up bank $00 memory		; now we get our MM ID and leave it on the stack for NewHandle		pha				;space for result		ldx #$0202			;MMStartUp		jsl $E10000			;leave ID on stack		; continue building stack frame for NewHandle		pea $8015			;locked, can't cross bank or page,						;fixed bank		pea $0000			;address in bank $00		pea $0000		ldx #$0902			;NewHandle		jsl $E10000		plx		stx stack_vp			;this is really a handle		plx		stx stack_vp+2		bcs mem_err			;check error now;	end Monte 3/23/92** Indicate no error and exit.*done		clc				;indicate no error		rtl				;exit		** Report an out of memory error.*mem_err		lda	#out_of_mem		;get error code 		rtl				;exit with carry set		ENDP				eject********************************************************************************	 Name:	kill_fst** Description:	This routine is called by SCM to shutdown the HFS FST.**	Entry:	jmp**	Input:	A = undefined*		X = call number	times 2*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		stack_vp - VP for psuedo stack*		>warm_cold_flag - 0 if cold shutdown, non-zero if warm shutdown**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Exit:	rtl**	 Uses:	all registers**   Called by:	sys_entry**	Calls:	release_seg	(system service)** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************kill_fst	PROC		with	data;;; 7-Apr-92 DAL -- Always release our bank 0 segment on a shutdown.;*;* Are we doing a warm shutdown?  Do nothing if so.;*;		clc				;precondition to no error;		lda	>warm_cold_flag		;are we doing a warm shutdown?;		bne	exit			;yes - so exit** Release psuedo stack memory.*;	next code changed because the pseudo stack in now allocated;	directly from the Memory Manager, and stack_vp actually;	contains a handle		;ldx	stack_vp		;get the VP		;ldy	stack_vp+2		;jsl	release_seg		;release the memory		lda stack_vp+2		pha		lda stack_vp		pha		ldx #$1002			;DisposeHandle		jsl $E10000		stz stack_vp+2			;7-Apr-92 DAL		stz stack_vp			;7-Apr-92 DAL;	end Monte 3/23/92exit		rtl				;pass any errors back to SCM		ENDP				eject********************************************************************************	 Name:	kill_vcr** Description:	This routine is called by SCM when a VCR is being released.**	Entry:	jmp**	Input:	A = undefined*		X = call number	times 2*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<vcr_ptr - ptr to vcr**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Exit:	rtl**	 Uses:	all registers**   Called by:	sys_entry**	Calls:	release_fcr	(system service)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************kill_vcr	PROC		with	data** Release the CTree FCR.* 		ldy	#vcr_ct_ref_num		;get offset to ctree refnum		lda	[vcr_ptr],y		;get refnum for ctree fcr		jsl	release_fcr		;release the fcr		bcs	exit** Release the ETree FCR.* 		ldy	#vcr_et_ref_num		;get offset to etree refnum		lda	[vcr_ptr],y		;get refnum for etree fcr		jsl	release_fcr		;release the fcrexit		rtl				;return any errors to SCM					ENDP				eject********************************************************************************	 Name:	flush_def** Description:	This routine is called by SCM when the EndSession call is*		issued.  **	Notes:	It's the application's responsibility to guarantee that the disk *		will not be ejected while sessions are active.  If the disk is *		ejected, the device dispatcher will tell the cache manager*		to purge the volume's blocks from the cache.  As a result,*		we don't need to make sure the volume is online before*		calling cache_flsh_def.*		*	Entry:	jmp**	Input:	A = undefined*		X = call number	times 2*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<vcr_ptr - ptr to vcr **      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Exit:	rtl**	 Uses:	all registers*		<drvr_vol_id*		<drvr_dev_num*		<drvr_fst_num*		<drvr_blk_size*		<drvr_req_cnt**   Called by:	sys_entry**	Calls:	cache_flsh_def		(system service)** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************flush_def	PROC		with	data** Setup information needed by cache_flsh_def.*		lda	[vcr_ptr]				sta	<drvr_vol_id		;set volume id		ldy	#vcr_dev				lda	[vcr_ptr],y				sta	<drvr_dev_num		;set device num				lda	#hfs_id					sta	<drvr_fst_num		;set fst id 		lda	#phys_blk_size				sta	<drvr_blk_size		;set block size		sta	<drvr_req_cnt				stz	<drvr_req_cnt+2		;set request count** Flush the volume's deferred blocks to disk.*		jsl	cache_flsh_def		;flush deferred blocks to disk 		rtl				;return any errors to SCM					ENDP				eject********************************************************************************	 Name:	cmd_error*******************************************************************************cmd_error	PROC						        		lda	#bad_system_call	;get error code		sec				;indicate error		rts				;exit		ENDP********************************************************************************	 Name:	fst_op_error*******************************************************************************fst_op_error	PROC						        		lda	#invalid_fst_op		;get error code		sec				;indicate error		rts				;exit		ENDP		eject********************************************************************************	 Name:	app_entry** Description:	Entry point for	all application	calls.	Called by GS/OS	only.*		Validates call before passing control to call handler.**	Entry:	jml**	 Exit:	jml sys_exit**	Input:	A = undefined*		X = call number	times 2*		Y = class number times 2*		P = nvmxdizc*		    ..000...**		<param_blk_ptr - ptr to parameter block*		<vcr_ptr - VP to vcr (if used)*		<fcr_ptr - VP to fcr (if used)*		<path_flag - indicates if path1_ptr and/or path2_ptr are valid*		<path1_ptr - pointer to pathname1 in gstring format*			     if <dev1_num = 0, then pathname1 begins with a volume name*			     if <dev1_num <> 0, then pathname1 has no volume name*		<path2_ptr - pointer to pathname2 in gstring format*			     if <dev2_num = 0, then pathname2 begins with a volume name*			     if <dev2_num <> 0, then pathname2 has no volume name*		<dev1_num (<dev_num) - device number if specified, else 0*		<dev2_num - device number if specified, else 0*		<span1 - maximum span of pathname1*		<span2 - maximum span of pathname2**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		save_drvr_cache*		<drvr_cache**   Called by:	SCM**	Calls:	setup_call*		send_output*		all application call handlers*		post_os_event		(system service)** Copyright Apple Computer, Inc. 1987-91  All rights reserved.******************************************************************************app_entry	PROC		with	data** Setup	environment.*		phk				;Setup our bank	register.		plb		rep	#$30			;Make sure in 16 bit mode.** Call # valid?  Error if not.*		cpx	#max_app_cmd+1		;in range?		bcc	command_ok		;yes		jmp	cmd_error		;no	command_ok** Validate call, get input parameters, set up required information.*		phx				;Save (call number * 2)		jsr	setup_call				plx				;Recover (call number * 2)		bcs	exit			;bad call** Save the current value of <drvr_cache.	*		lda	<drvr_cache				sta	save_drvr_cache		** Execute the call handler.*		jsr	(app_tbl-2,x)		;do the call		bcs	clean_up** Send output parameters.*		jsr	send_output** Save the error code (if any) and processor status.*clean_up	pha				;save error code		php				;save status** Set <drvr_cache back to its original value.*		lda	save_drvr_cache		;get old cache value		sta	<drvr_cache		;set cache value** If an FCR was used by the call then we need to update the global_clean_bit* in the fcr_access word.* If the file is dirty, then clear the global_clean_bit.* Otherwise, set the global_clean_bit.* Note - the file_dirty_bit is set by the Write and SetEof routines.*		lda	call_flags			and	#fcr_used		;was an fcr used by the call?		beq	no_fcr			;no				ldx	#global_clean_bit		ldy	#fcr_flags		lda	[my_fcr_ptr],y		;get the fcr flags		and	#file_dirty_bit		;is the file dirty?		beq	its_clean		;no		ldx	#0			;yesits_clean		stx	<temp0		ldy	#fcr_access		lda	[my_fcr_ptr],y		;get the fcr_access word		and	#global_clean_mask	;clear the global_clean_bit		ora	<temp0			;set the global_clean_bit if the		sta	[my_fcr_ptr],y		;file is cleanno_fcr** If a volume was modified during the call then post a 'volume change' event.*		lda	write_occurred		;did a device write occur during this call?		beq	no_write		;no		lda	call			;yes - so push the call #		pha		lda	write_dev_num		;push the device #		pha		pha				;push a word of garbage		lda	#volume_change		;get lo word of event code		ldx	#^volume_change		;get hi word of event code		jsl	post_os_event		;post the eventno_write** Restore the error code (if any) and processor status and exit.*		plp				;restore status		pla				;restore error code		bcs	error_exit		;branch if error		lda	gde_buf_err		;output buffer error from GetDirEntry?		bne	error_exit		;yes - so branch		lda	#no_error		;indicate no errorexit		jml	sys_exit		;exit to SCM** We're reporting an error.* Check to see if it's a BTree error. If so, mask off the hi byte of the error code.* Before exiting to SCM, put the error priority in the hi byte of the error code.*error_exit	tax				;save error code		and	#$C000			;are we reporting a BTree error?		cmp	#$C000		bne	@0			;no		txa				;yes - so retrieve error code		and	#$00ff			;mask off hi byte		tax				;store new error code in X@0		txa				;get error code		ora	error_priority		;put error priority in hi byte		sec				;indicate error		jml	sys_exit		;exit to SCM					ENDP				eject********************************************************************************	 Name:	setup_call** Description:	This routine is	called at the start of each application call*		to setup parameters and check the validity of the call.  **	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = two	times the call #.*		Y = two	times the class	#.*		P = nvmxdizc*		    ..000...*		B = K**		<param_blk_ptr - ptr to parameter block*		<vcr_ptr - VP to vcr (if used)*		<fcr_ptr - VP to fcr (if used)*		<path_flag - indicates if path1_ptr and/or path2_ptr are valid*		<path1_ptr - pointer to pathname1 in gstring format*			     if <dev1_num = 0, then pathname1 begins with a volume name*			     if <dev1_num <> 0, then pathname1 has no volume name*		<path2_ptr - pointer to pathname2 in gstring format*			     if <dev2_num = 0, then pathname2 begins with a volume name*			     if <dev2_num <> 0, then pathname2 has no volume name*		<dev1_num - <dev_num - device number if specified, else 0*		<dev2_num - device number if specified, else 0*		<span1 - maximum span of pathname1*		<span2 - maximum span of pathname2**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 if	no error*			   1 if	error*		B = K**		call - call number*		class - call class*		trans_call - translated call # times 2*		call_flags - call flags*		max_pcount - maximum pcount for call*		min_pcount - minimum pcount for call*		input_error - error code from get_input*		time - current date/time in seconds**		<my_pblk_ptr - pointer to parameter block*		<gbuf_ptr - ptr to 512 byte general purpose buffer*		<stack_ptr - pointer to psuedo stack -1 for tree routines*		<stack_index - index into psuedo stack -- now an actual address*							  - Monte 3/26/92**		<my_vcr_ptr - pointer to vcr (if used) *		ablk_size - allocation block size in bytes (if vcr used)*		ablk_start - location of first alloc block (if vcr used)*		pblks_per_ablk - # of physical blocks per alloc block (if vcr used)*		ctree_fcr_ptr - ptr to fcr for CTree (if vcr used)*		etree_fcr_ptr - ptr to fcr for ETree (if vcr used)**		<my_fcr_ptr - pointer to fcr (if used)*		type - fcr type (if fcr used)*		eof - logical eof (if fcr used) *		file_mark - file mark (if fcr used) *		block_mark - block buffer mark (if fcr used)*		block_num - # of physical block in block buffer (if fcr used)*		block_count - # physical blocks until end of extent (if fcr used)*		<block_buf_ptr - ptr to block buffer in fcr (if fcr used)**		<my_path_ptr - pointer to pathname (if used)*		x_dev_num - device number if specified, else 0 (if pathname used)*		x_span - maximum span of pathname (if pathname used)*		name_count - # of names in pathname (if pathname used)*		first_offset - offset to first name in pathname (if pathname used)*		last_offset - offset to last name in pathname (if pathname used)*		volname	- holds volume name (if pathname used)**		pcount - parameter count *		resource_num - resource number (if supplied)*		cache_priority - cache priority	flag (if supplied)*		request_access - request access	permissions (if supplied)*		request_count - request count (if supplied)*		base - base (if supplied)*		displacement - displacement (if supplied)*		ref_num - file reference number (if supplied)*		access - access information (if supplied)*		storage_type - storage type (if supplied)*		file_type - file type (if supplied)*		aux_type - aux type (if supplied)*		eof - data fork end of file (if supplied)*		resource_eof - resource fork end of file (if supplied)*		create_date - create date (if supplied)*		create_time - create time (if supplied)*		mod_date - modification date (if supplied)*		mod_time - modification time (if supplied)*		create_date_time - create date/time (if supplied) *		mod_date_time - modification date/time (if supplied)*		finder_info - option list finder info (if supplied)*		parent_id - option list parent dir id (if supplied)*		<data_buf_ptr - ptr to data buffer (if supplied)**	 Uses:	all registers**   Called by:	app_entry**	Calls:	get_input*		setup_vcr_info*		setup_fcr_info*		parse_path1*		handle_conv_err*		deref			(system service)*		ConvSeconds		(Misc. Tools)** Copyright Apple Computer, Inc. 1987-91 All rights reserved.*------------------------------------------------------------------------------* Each call has	a one word entry in the	table with the following* format:**     1	- Max PCount for the call*     2	- Min PCount for the call*     3	- Pathnames used by call*     4	- Volume control record	used*     5	- File control record used**		|5|4|3|	 2  |	 1    |*      _________|_|_|_|_____|_________|*     |	| | | |	| | | |	| | | |	| | | |*     |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|*     |		      |		      |*    1 6	     0 8	     0 0*******************************************************************************setup_call	PROC		with	data** Init some variables and flags.*		stz	id_disk_flag		;id_disk routine not active		stz	option_flag		;option list invalid		stz	cp_device_flag		;normal changepath		stz	wp_status_flag		;write-protect status unknown			stz	write_occurred		;no write has occurred		stz	input_error		;no input error	found			stz	gde_buf_err		;no GetDirEntry buffer error found		stz	name_count		;name count is 0		stz	error_priority		;error priority is 0		stz	doing_gdn		;not doing get_dev_num (29-Oct-91 MSD)** Set call and	class.*		txa				;Divide	call # by 2.		lsr	a		sta	call			;Set current call.		tya				;Divide	class #	by 2.		lsr	a		sta	class			;Set current class.** Make sure that class is valid.  Report error if not.*		cmp	#max_class+1		;Valid?		bcc	class_ok		;Yep.		lda	#invalid_class		;Nope, so get error code.		brl	errorclass_ok** Get translated call #.  Exit with carry clear if this is not a call we handle.*		ldy	#end_call_list-call_list-1 ;get size of call list - 1call_loop	lda	call_list,y		;Get call #.		and	#$00ff			;Clear high byte.		cmp	call			;Is this the call?		beq	valid_call		;Yep.		dey				;Nope, checked all?		bpl	call_loop		;No, so	loop.		brl	exit			;yes - so exit with carry clearvalid_call	tya				;Get translated call #.		asl	a			;Multiply by 2.		sta	trans_call		;Save it.		tax				;Put in	X.** Get entry from call_flags_tbl and save it in call_flags.*		lda	call_flags_tbl,x	;Get flags word.		sta	call_flags		;Save it.** Set max_pcount and min_pcount.*		and	#max_mask		;Isolate max_pcount.		sta	max_pcount		;Save it.		lda	call_flags		;Get flags.		and	#min_mask		;Isolate min_pcount.		asl	a			;Get it	in low byte.		asl	a		asl	a		xba		sta	min_pcount		;Save it.** Set my_pblk_ptr = param_blk_ptr.*		lda	<param_blk_ptr			sta	<my_pblk_ptr		lda	<param_blk_ptr+2		sta	<my_pblk_ptr+2** Get input parameters.	Any errors?*		jsr	get_input		;Get input. Any	errors?		bcc	input_ok		;no** Yes. If this call does not use a pathname, then exit with the	error.* If it	does, check to see if it is a bouncing error and if so,	exit with* the error.  If not, save error in input_error	and continue.*		tax				;save error code		lda	call_flags		;is a pathname used by the call?		and	#path_used		bne	got_path		;yes 		txa				;no - so recover error codebrl_error	brl	error			;and return itgot_path	txa				;retrieve error code		ldy	#end_bounce_list-bounce_list-2 bounce_loop	cmp	bounce_list,y		;is it a bouncing error?		beq	brl_error		;yes - so return it		dey		dey		bpl	bounce_loop		stx	input_error		;not a bouncing error so save it** Setup gbuf_ptr to point to the first 512 byte general purpose buffer.*input_ok	lda	save_gbuf_ptr1				sta	<gbuf_ptr				lda	save_gbuf_ptr1+2		sta	<gbuf_ptr+2** Get pointer to psuedo stack and initialize stack index to 0.*;	next code changed because the pseudo stack in now allocated;	directly from the Memory Manager, and stack_vp actually;	contains a handle		;ldx	stack_vp		;get the vp		;ldy	stack_vp+2		;jsl	deref			;dereference it		;stx	<stack_ptr		;save the pointer		;sty	<stack_ptr+2*** added 7-Apr-92 DAL -- If we have no bank 0 block, allocate it.*** @@@ This is a kludge.  Remove later!		lda stack_vp+1		bne @have_stack		jsl init_fst@have_stack*** end 7-Apr-92		lda stack_vp		sta <temp0			;use this to deref the handle		lda stack_vp+2		sta <temp0+2		lda [temp0]		dec a				;save work for compare in push_regs						;added 4/1/92 by Monte		sta <stack_ptr			;only need low word for bank $00;;	added stack_end and made stack_index a real address to speed;	up push/pop routines -- Monte 3/26/92		clc		adc #stack_size			;get end of stack		sta <stack_end		dec a				;start index 1 below end;	end Monte 3/26/92		sta <stack_index;	end Monte 3/23/92** Mark the node buffers as unused.*		ldx	#node_flags		;get offset to flags word 		stz	node_buf1,x		;mark first node buffer as unused 		stz	node_buf2,x		;mark second node buffer as unused 		stz	node_buf3,x		;mark third node buffer as unused 		stz	node_buf4,x		;mark fourth node buffer as unused** Get current date/time (in seconds).*		pea	0			;space for result (init to 0)		pea	0		pea	6			;get current data/time in seconds		pha				;number of seconds (unused)		pha		pha				;ptr to date/time record (unused)		pha		ldx	#ConvSeconds 		;call ConvSeconds routine in Misc Tools		jsl	tool_locator		bcc	conv_ok		jsr	handle_conv_err		conv_ok		pla				;get result and store		sta	time		pla		sta	time+2** If we	need a VCR, then get pointer to vcr and call setup_vcr_info.*		stz	<my_vcr_ptr		;init my_vcr_ptr to 0 in case a		stz	<my_vcr_ptr+2		;vcr ptr isn't supplied				lda	call_flags		;get call flags		and	#vcr_used		;do we need a vcr?		beq	no_vcr			;no		ldx	<vcr_ptr		;yes - so get VP from direct page		ldy	<vcr_ptr+2		jsl	deref			;dereference it		stx	<my_vcr_ptr		;save pointer		sty	<my_vcr_ptr+2		jsr	setup_vcr_info		;setup some vcr info no_vcr** If we	need an FCR, then get pointer to fcr and call setup_fcr_info.*		stz	<my_fcr_ptr		;init my_fcr_ptr to 0 in case an		stz	<my_fcr_ptr+2		;fcr ptr isn't supplied				lda	call_flags		;get call flags		and	#fcr_used		;do we need an fcr?		beq	no_fcr			;no		ldx	<fcr_ptr		;yes - so get VP from direct page		ldy	<fcr_ptr+2		jsl	deref			;dereference it		stx	<my_fcr_ptr		;save pointer		sty	<my_fcr_ptr+2				jsr	setup_fcr_info		;setup some fcr info no_fcr** If we	need a pathname, then parse pathname1.*		lda	call_flags		;get call flags		and	#path_used		;do we need a pathname?		beq	no_path			;no		jsr	parse_path1		;yes - so parse pathname1		bcs	errorno_path** Indicate no error and exit.*exit		clc						rts	** Report an error.*error		sec		rts				ENDP				eject********************************************************************************	 Name:	get_input** Description:	Initializes all input and output parameter storage to 0.*		Moves input params from caller's param list to storage area.  *		Validates the parameters whose range is known.**	Entry:	jsr**	 Exit:	jmp process_params**	Input:	A = undefined*		X = undefined*		Y = undefined.*		P = nvmxdizc*		    ..000...*		B = K**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 if	no error*			   1 if	error*		B = K**	 Uses:	all registers**   Called by:	setup_call**	Calls:	process_params** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************get_input	PROC		with	data** Clear	input and output parameter storage.*		ldy	#len_params-2 		;get size of parameter storage		lda	#0			clear_loop	sta	start_params,y		;clear parameter storage		dey						dey		bpl	clear_loop		;loop until done** Initialize pcount to maximum value in case this is a class 0 call.  *		lda	#$7fff		sta	pcount** Process input	params and exit.*		lda	#input_flag		;Select	input.		jmp	process_params		;Process params.		ENDP				eject********************************************************************************	 Name:	send_output** Description:	Sends output params to caller's parameter list.**	Entry:	jsr**	 Exit:	jmp process_params**	Input:	A = undefined*		X = undefined*		Y = undefined.*		P = nvmxdizc*		    ..000...*		B = K**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 if	no error*			   1 if	error*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	process_params** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************send_output	PROC		with	data** Process output params	and exit.*		lda	#output_flag		;Select	output.		jmp	process_params		;Process 'em.		ENDP				eject********************************************************************************	 Name:	process_params** Description:	This routine calls the parameter handler subroutines listed*		in the parameter list for the current call and class.**	Entry:	jsr**	 Exit:	rts**	Input:	A = $0000 if requesting input, $0080 if requesting output.*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		class - call class*		trans_call - translated call #*		max_pcount - maximum pcount for call*		min_pcount - minimum pcount for call*		pcount - parameter count*		<my_pblk_ptr - pointer to parameter block**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 if	no error*			   1 if	error*		B = K**	 Uses:	all registers*		io_flag*		param_count*		param_index*		param_flags**   Called by:	get_input*		send_output**	Calls:	all parameter handlers** Copyright Apple Computer, Inc. 1987-90  All rights reserved.*-----------------------------------------------------------------------------* The parameter list is a list of flag words with the following format:**     1	- parameter number *     2	- I/O flag: 0 =	input, 1 = output*     3	- parameter offset*     4	- Terminator: 1	= last entry in	list**     |4|      3      |2|     1	      |*     |_|_____________|_|_____________|*     |	| | | |	| | | |	| | | |	| | | |*     |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|*     |		      |		      |*      f	     8 7	     0  *******************************************************************************process_params	PROC		with	data** Save requested direction and set param_list_ptr to point to correct list.*		sta	io_flag			;Save direction	flag.		ldx	trans_call		;Get translated	call #.		lda	param_list_tbl_0,x	;Get address of class 0 param list.		ldy	class			;Is this a class 0 call?		beq	set_ptr			;Yep.		lda	param_list_tbl_1,x	;No, so get address of class 1 param list.set_ptr		pha				;save address on stack** Set param_count = pcount.* Pcount is initialized to $7fff by get_input in case this is a class 0 call.  * If it's a class 1 call, the pcount parameter handler will set param_count = pcount.* Param_count is used to control the number of parameters to process.*		lda	pcount		sta	param_count** Init parameter list index.* 		stz	param_index			** Get parameter flag word and save it.*input_loop	ldy	param_index		;get parameter list index		lda	(1,s),y			;get parameter flag word		sta	param_flags		;save it** Does the i/o flag match the requested	direction?*		and	#io_mask		;isolate I/O flag		cmp	io_flag			;does it match request?		bne	next_param		;no, so skip it** Yes, get parameter offset in Y and parameter number times 2 in X.* If we're doing input params then use parameter offset to load 2 words into A and Y. * This is done to save bytes in the input handlers.* Then use X to jsr to parameter handler.*		lda	param_flags		;recover flag word.		and	#param_mask		;isolate parameter number		asl	a			;multiply by 2		tax				;use as	index into handlers table		lda	param_flags		;recover flag word		and	#offset_mask		;isolate parameter offset		xba				;put in	low byte		tay				;put in	Y				lda	io_flag					cmp	#input_flag		;are we processing input params?		bne	skip_load		;no - so don't read in param words				lda	[my_pblk_ptr],y		;get word out of param block		pha				;and save temporarily		iny		iny		lda	[my_pblk_ptr],y		;get next word out of param block		tay				;put in Y		pla				;retrieve first word into Askip_load		clc				;clc here to save bytes in handlers		jsr	(handlers_tbl,x)	;execute parameter handler		bcs	exit			;error,	so exit** Bump parameter number.*next_param	inc	param_index		;bump parameter list index		inc	param_index		** Are we done with list?*		lda	param_flags		;done with list?		bmi	done			;yes** Nope,	have we	used up	all the	parameters present?*		dec	param_count		;done all parameters?		bpl	input_loop		;no, so loop** Yes, so exit with carry clear.*done		clc				;indicate no errorsexit		plx				;clean up stack		rts						ENDP				eject********************************************************************************	 Name:	input_handlers** Description:	This section is	a collection of	subroutines which handle*		each of	the input parameters in the parameter lists.  *		These routines should only be called by process_params.**	Entry:	jsr**	 Exit:	rts**	Input:	A = first word at parameter offset *		X = undefined*		Y = second word at parameter offset *		P = nvmxdizc*		    ..000..0*		B = K**		<my_pblk_ptr - pointer to parameter block*		max_pcount - maximum pcount for call*		min_pcount - minimum pcount for call*		call - call number*		param_flags - parameter flags **      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 if	no error*			   1 if	error*		B = K**	 Uses:	all registers*		<temp0**   Called by:	process_params**	Calls:	read_option_list** Copyright Apple Computer, Inc. 1987-91  All rights reserved.******************************************************************************input_handlers	PROC		with	data;------------------------------------------------------------------------------; I_PCOUNT Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_pcountih_pcount						        		cmp	min_pcount		;is pcount param < min?		bcc	bad_pcount		;yes, so bad		cmp	max_pcount		;is pcount param > max?		beq	pcount_ok		;it's = max, so ok		bcs	bad_pcount		;it's > max, so badpcount_ok	sta	pcount			;it's ok, so save it		sta	param_count		;adjust param_count for process_params		clc				;indicate no error		rts				;exitbad_pcount	lda	#invalid_pcount		;get error code		sec				;indicate error		rts				;exit;------------------------------------------------------------------------------; I_REF_NUM Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_ref_numih_ref_num						   		sta	ref_num			;save param		rts				;exit;------------------------------------------------------------------------------; I_ACCESS Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_accessih_access			sta	access			;save param 		and	#reserved_bits		;any reserved bits set?		beq	access_ok		;no - so ok		brl	bad_param		;yes - so param is bad		access_ok	clc				;indicate no error		rts				;exit;------------------------------------------------------------------------------; I_STORAGE_TYPE Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_storage_typeih_storage_type	; Note - The CREATE call uses the storage_type parameter as both an input and output.;	 This is the only case in which a parameter is used for both input and output.;	 This causes problems with the parameter handling since a parameter can only be;	 an input param or an output param, not both.  To fix this problem, the storage_type;	 input handler will validate the input param, convert it if necessary, and then ;	 store the result into the parameter block.  This is the only input handler which;	 modifies the parameter block.  This is kind of kludgy but since this input ;	 handler is only used for the CREATE call, it should be OK.		cmp	#extended_stype		;'extended file' storage type?		beq	stype_ok		;yes - so ok		cmp	#directory_stype	;'subdirectory' storage type?		beq	stype_ok		;yes - so ok		cmp	#4			;is storage type = 0,1,2 or 3?		bcc	cvt_stype		;yes - so convert to 'standard file'		cmp	#extended_stype+$8000	;is storage type = $8005?		beq	stype_ok		;yes - so ok		brl	bad_param		;no - so param is badcvt_stype	lda	#standard_stype		;convert storage type to 'standard file'		stype_ok	sta	storage_type		;save param		lda	param_flags		;get flag word		and	#offset_mask		;isolate parameter offset		xba				;put in	low byte		tay				;put in	Y		lda	storage_type		;get converted storage type		and	#$7fff			;mask off hi bit		jmp	store_word		;and store into parameter block;------------------------------------------------------------------------------; I_FILE_TYPE Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_file_typeih_file_type			sta	file_type		;save param		and	#$ff00			;is hi byte 0?		beq	file_type_ok		;yes - so ok		brl	bad_param		;no - so bad		file_type_ok	rts				;exit		;------------------------------------------------------------------------------; I_AUX_TYPE Parameter Handler: Input (lw);------------------------------------------------------------------------------		export	ih_aux_typeih_aux_type						        		sta	aux_type		;save lo word of param		sty	aux_type+2		;save hi word of param		tya	 			;is hi word 0?		beq	aux_type_ok		;yes - so ok		brl	bad_param		;no - so bad				aux_type_ok	rts				;exit;------------------------------------------------------------------------------; I_EOF Parameter Handler: Input (lw);------------------------------------------------------------------------------		export	ih_eofih_eof							        		sta	eof			;save lo word of param		sty	eof+2			;save hi word of param		rts				;exit;------------------------------------------------------------------------------; I_RESOURCE_EOF Parameter Handler: Input (lw);------------------------------------------------------------------------------		export	ih_resource_eofih_resource_eof						        		sta	resource_eof		;save lo word of param		sty	resource_eof+2		;save hi word of param		rts				;exit;------------------------------------------------------------------------------; I_CREATE_DATE Parameter Handler: Input (w);------------------------------------------------------------------------------ 		export	ih_create_dateih_create_date						        		sta	create_date		;save param		verify_date	beq	date_ok			;if param = 0 then it's ok		tax				;save date in X		and	#$001f			;isolate 'day'		beq	bad_date		;error if 'day' = 0		cmp	#32			;is 'day' > 31?		bcs	bad_date		;yes - so bad param		txa				;retrieve date		lsr	a			;move 'month' into bits 0-3		lsr	a		lsr	a		lsr	a		lsr	a		and	#$000f			;isolate 'month'		beq	bad_date		;error if 'month' = 0		cmp	#13			;is 'month' > 12?		bcs	bad_date		;yes - so bad paramdate_ok		rts				;no - so exitbad_date	brl	bad_param		;param is bad;------------------------------------------------------------------------------; I_MOD_DATE Parameter Handler: Input (w);------------------------------------------------------------------------------ 		export	ih_mod_dateih_mod_date						        		sta	mod_date		;save param		bra	verify_date		;verify param;------------------------------------------------------------------------------; I_CREATE_TIME Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_create_timeih_create_time		        		sta	create_time		;save param		verify_time	beq	time_ok			;if param = 0 then it's ok		tax				;save time in X		and	#$00ff			;isolate 'minute'		cmp	#60			;is 'minute' > 59?		bcs	bad_time		;yes - so bad param		txa				;retrieve time		xba				;move 'hour' into low byte		and	#$00ff			;isolate 'hour'		cmp	#24			;is 'hour' > 23?		bcs	bad_time		;yes - so bad paramtime_ok		rts				;no - so exitbad_time	brl	bad_param		;param is bad;------------------------------------------------------------------------------; I_MOD_TIME Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_mod_timeih_mod_time		        		sta	mod_time		;save param		bra	verify_time		;verify param;------------------------------------------------------------------------------; I_CREATE_DATE_TIME Parameter Handler: Input (4w);------------------------------------------------------------------------------		export	ih_create_date_timeih_create_date_time			lda	#create_date_time	;get address of create_date_time		sta	<temp0			;and store on direct page		get_date_time	lda	param_flags		;get flag word		and	#offset_mask		;isolate parameter offset		xba				;put in	low byte		tay				;put in	Y		ldx	#0			;init offset into date/time structure		get_dt_loop	lda	[my_pblk_ptr],y		;get word from parameter block		phy				;save param block offset		txy				;get date/time structure offset		sta	(temp0),y		;store word in date/time structure		tyx				;store date/time structure offset		ply				;retrieve param block offset		iny				;adjust offsets		iny		inx		inx		cpx	#8		bne	get_dt_loop		;loop until done				ldy	#7			;verify date/time		sep	#$20			;begin 8-bit Averify_dt	lda	max_dt_values,y		;get max allowed value		cmp	(temp0),y		;is it < value in date/time structure?		bcc	bad_dt			;yes - so param is bad		dey		bpl	verify_dt		;loop until done				rep	#$20			;restore 16-bit A		clc				;indicate no error		rts				;exitbad_dt		rep	#$20			;restore 16-bit A 		brl	bad_param		;param is bad;------------------------------------------------------------------------------; I_MOD_DATE_TIME Parameter Handler: Input (4w);------------------------------------------------------------------------------		export	ih_mod_date_timeih_mod_date_time					        		lda	#mod_date_time		;get address of mod_date_time		sta	<temp0			;and store on direct page		bra	get_date_time;------------------------------------------------------------------------------; I_VOLNAME Parameter Handler: Input (ptr);------------------------------------------------------------------------------		export	ih_volnameih_volname								rts				;exit				;------------------------------------------------------------------------------; I_OPTION_LIST Parameter Handler: Input (ptr);------------------------------------------------------------------------------		export	ih_option_listih_option_list			jsr	read_option_list	;read in option list info 		rts				;exit;------------------------------------------------------------------------------; I_COMMAND_NUM Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_command_numih_command_num;@@@ no fst_specific commands supported yet;		cmp	#max_fst_cmd+1		;Is param in range?;		bcs	bad_param		;Nope.;		sta	command_num		;Yes, save it.;		rts				;exit;------------------------------------------------------------------------------; I_RESOURCE_NUM Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_resource_numih_resource_num						        		cmp	#max_rsrcnum_val+1	;Is param in range?		bcc	@0			;yes		brl	bad_param		;no@0		sta	resource_num		;yes, save it.		rts				;exit		;------------------------------------------------------------------------------; I_CACHE_PRIORITY Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_cache_priorityih_cache_priority					        		cmp	#max_cache_val+1	;Is param in range?		bcs	bad_param		;Nope.		sta	cache_priority		;yes, save it.		rts				;exit;------------------------------------------------------------------------------; I_REQUEST_ACCESS Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_request_accessih_request_access								        		cmp	#max_raccess_val+1	;Is param in range?		bcs	bad_param		;Nope.		sta	request_access		;Save param.		rts				;exit;------------------------------------------------------------------------------; I_REQUEST_COUNT Parameter Handler: Input (lw);------------------------------------------------------------------------------		export	ih_request_countih_request_count						        		sta	request_count		;Save lo word of param		sty	request_count+2		;Save hi word of param ; If request_count is >= $01000000 (16MB) then set it to $00ffffff (16MB-1).	; 	ProDOS FST reports parm_range_err if request_count >= $01000000 ;	High Sierra FST sets it to $00ffffff and doesn't report error 		cpy	#$0100			;too big?		bcc	req_count_ok		;no		lda	#$ffff			;yes - so squash it		sta	request_count		lda	#$00ff		sta	request_count+2		clcreq_count_ok	rts				;exit;------------------------------------------------------------------------------; I_BASE Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_baseih_base				sta	base			;save param		ldx	call			;get call #		cpx	#gde_call_num		;is the call get_dir_entry?		beq	gde_base		;yes - so branch		cmp	#max_base_val+1		;is param in range?		bcs	bad_param		;no		rts				;yesgde_base	cmp	#max_base_val		;is param in range?		bcs	bad_param		;no		rts				;yes;------------------------------------------------------------------------------; I_DISPLACEMENT Parameter Handler: Input (lw);------------------------------------------------------------------------------		export	ih_displacementih_displacement						        		sta	displacement		;Save lo word of param.		sty	displacement+2		;Save hi word of param.		rts				;exit;------------------------------------------------------------------------------; I_PATHNAME Parameter Handler: Input (ptr);------------------------------------------------------------------------------		export	ih_pathnameih_pathname	        		rts				;exit;------------------------------------------------------------------------------; I_NEW_PATHNAME Parameter Handler: Input (ptr);------------------------------------------------------------------------------		export	ih_new_pathname		ih_new_pathname						        		rts				;exit;------------------------------------------------------------------------------; I_DEVNAME Parameter Handler: Input (ptr);------------------------------------------------------------------------------		export	ih_devnameih_devname	        		rts				;exit;------------------------------------------------------------------------------; I_DATA_BUFFER Parameter Handler: Input (ptr);------------------------------------------------------------------------------		export	ih_data_bufferih_data_buffer	        		sta	<data_buf_ptr		;Save lo word of param.		tya				;Get high word of param in A		and	#$00ff			;Clear high byte.		sta	<data_buf_ptr+2		;Save hi word of param.		ora	<data_buf_ptr		;is ptr 0?		beq	bad_param		;yes - so error		rts				;no - so exit;------------------------------------------------------------------------------; I_NULL Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_nullih_null	        		rts				;exit;------------------------------------------------------------------------------; I_FLUSH_TYPE Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_flush_typeih_flush_type			sta	flush_type		;save param		and	#$7fff			;any reserved bits set?		bne	bad_param		;yes - so error		rts				;exit;------------------------------------------------------------------------------; I_FILE_SYS_ID Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_file_sys_idih_file_sys_id	        		rts				;exit;------------------------------------------------------------------------------; I_NAME_TYPE Parameter Handler: Input (w);------------------------------------------------------------------------------		export	ih_name_typeih_name_type			cmp	#max_ntype_val+1	;is param in range?		bcs	bad_param		;no		sta	name_type		;yes - so save it		rts				;exit;------------------------------------------------------------------------------; I_NAME Parameter Handler: Input (ptr);------------------------------------------------------------------------------		export	ih_nameih_name	        		sta	name_ptr		;Save lo word of param.		tya				;Get high word of param in A		and	#$00ff			;Clear high byte.		sta	name_ptr+2		;Save hi word of param.		rts				;exit;------------------------------------------------------------------------------; I_CP_FLAGS Parameter Handler: Input (w); Routine added 5-Dec-91 MSD;------------------------------------------------------------------------------		export	ih_cp_flagsih_cp_flags			sta	cp_flags		;save param		and	#$7fff			;any reserved bits set?		bne	bad_param		;yes - so error		rts				;exit;------------------------------------------------------------------------------; Return a parameter range error;------------------------------------------------------------------------------bad_param	lda	#parm_range_err		;get error code		sec				;indicate error		rts				;exit		ENDP		eject********************************************************************************	 Name:	output_handlers** Description:	This section is	a collection of	subroutines which handle*		each of	the output parameters in the parameter lists.  *		These routines should only be called by process_params.** 	 Note:  The oh_volname routine is called directly from the "volume" *		procedure if id_disk has returned a dup_volume error.  This is *		done so that the "volname" output parameter will be set up even *		though an error is being returned.  This is the only case in *		which a parameter handler is called directly.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = parameter offset*		P = nvmxdizc*		    ..000..0*		B = K**		<my_pblk_ptr - pointer to parameter block*		call - call number*		class - call class**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 if	no error*			   1 if	error*		B = K**		gde_buf_err - non-zero if an error occurred in 'oh_name'**	 Uses:	all registers*		<temp0*		<source_ptr	(aka <product)*		<dest_ptr	**   Called by:	process_params**	Calls:	write_option_list** Copyright Apple Computer, Inc. 1987-91  All rights reserved.******************************************************************************output_handlers	PROC		with	data;------------------------------------------------------------------------------; O_REF_NUM Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_ref_numoh_ref_num						   		lda	ref_num			;get ref_num		brl	store_word		;store it in param block		;------------------------------------------------------------------------------; O_ACCESS Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_accessoh_access						        		lda	access			;get access		brl	store_word		;store it in param block;------------------------------------------------------------------------------; O_STORAGE_TYPE Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_storage_typeoh_storage_type						        		lda	storage_type		;get storage_type		brl	store_word		;store it in param block;------------------------------------------------------------------------------; O_FILE_TYPE Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_file_typeoh_file_type						         		lda	file_type		;get filetype		brl	store_word		;store it in param block		;------------------------------------------------------------------------------; O_AUX_TYPE Parameter Handler: Output (lw);------------------------------------------------------------------------------		export	oh_aux_typeoh_aux_type						        		lda	call			;Is this a get_file_info call?		cmp	#gfi_call_num		beq	do_gfi_call		;yessend_aux	lda	aux_type		;get lo word of auxtype		ldx	aux_type+2		;get high word of auxtype		brl	store_long		;store it in param block		do_gfi_call	lda	storage_type		;looking at volume directory?		cmp	#volume_stype		bne	send_aux		;no, so send auxtype		lda	class			;yes, is it a class zero call?		bne	send_aux		;no, so send auxtype		brl	oh_total_blocks		;yes, so send total blocks ;------------------------------------------------------------------------------; O_EOF Parameter Handler: Output (lw);------------------------------------------------------------------------------		export	oh_eofoh_eof							        		lda	eof			;get low word of eof		ldx	eof+2			;get high word of eof		brl	store_long		;store it in param block;------------------------------------------------------------------------------; O_RESOURCE_EOF Parameter Handler: Output (lw);------------------------------------------------------------------------------		export	oh_resource_eofoh_resource_eof						        		lda	resource_eof		;get low word of resource_eof		ldx	resource_eof+2		;get high word		brl	store_long		;store it in param block;------------------------------------------------------------------------------; O_CREATE_DATE Parameter Handler: Output (w);------------------------------------------------------------------------------ 		export	oh_create_dateoh_create_date						        		lda	create_date		;get create_date		brl	store_word		;store it in param block				;------------------------------------------------------------------------------; O_MOD_DATE Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_mod_dateoh_mod_date						        		lda	mod_date		;get mod_date		brl	store_word		;store it in param block;------------------------------------------------------------------------------; O_CREATE_TIME Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_create_timeoh_create_time		        		lda	create_time		;get create_time		brl	store_word		;store it in param block;------------------------------------------------------------------------------; O_MOD_TIME Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_mod_timeoh_mod_time		        		lda	mod_time		;get mod_time		brl	store_word		;store it in param block;------------------------------------------------------------------------------; O_CREATE_DATE_TIME Parameter Handler: Output (4w);------------------------------------------------------------------------------		export	oh_create_date_timeoh_create_date_time					        		ldx	#0			;init offseto_create_loop	lda	create_date_time,x	;get word		sta	[my_pblk_ptr],y		;store it in param block		iny				;bump offsets		iny		inx		inx		cpx	#8			;done all?		bne	o_create_loop		;no, so	loop		clc				;yes, so clear carry		rts				;exit;------------------------------------------------------------------------------; O_MOD_DATE_TIME Parameter Handler: Output (4w);------------------------------------------------------------------------------		export	oh_mod_date_timeoh_mod_date_time					        		ldx	#0			;init offseto_mod_loop	lda	mod_date_time,x		;get word		sta	[my_pblk_ptr],y		;store it in param block		iny				;bump offsets		iny		inx		inx		cpx	#8			;done all?		bne	o_mod_loop		;no, so	loop		clc				;yes, so clear carry		rts				;exit;------------------------------------------------------------------------------; O_VOLNAME Parameter Handler: Output (ptr);------------------------------------------------------------------------------		export	oh_volnameoh_volname					; NOTE - This routine is called directly from the "volume" procedure if id_disk;	 has returned a dup_volume error.  This is done so that the "volname" ;	 output parameter will be set up even though an error is being returned.;	 This is the only case in which a parameter handler is called directly.; Convert string from gstring format (length word) to class 0 format (length byte); and add class 0 or class 1 separator at front of string.		sep	#$20			;set 8-bit A		longa	off				lda	disk_name		;get lo byte of length word		inc	a			;add 1 for separator		sta	disk_name		;and save				lda	#separator0		;get class 0 separator		ldx	class			;is this a class 0 call?		beq	save_sep		;yes		lda	#separator1		;no - so get class 1 separatorsave_sep	sta	disk_name+1		;insert the separator at front of string		rep	#$20			;restore 16-bit A		longa	on; If we're doing a class 0 call, check the new string to make sure it's not too long.; The maximum class 0 string length is 16 (15 chars + leading separator).		lda	class			;is this a class 0 call?		bne	length_ok		;no - so ok		lda	disk_name		;yes - so get length		and	#$00ff			;only want lo byte		cmp	#max_class0_name+2	;legal length?		bcs	too_long		;no		; Store the string in the caller's output buffer.length_ok	lda	#disk_name		;get address of disk name		jsr	store_string		;store the string		rts				;exit; String was too long for class 0 call so return an error.too_long	lda	#drvr_off_line		;return offline error		rts				;exit;------------------------------------------------------------------------------; O_OPTION_LIST Parameter Handler: Output (ptr);------------------------------------------------------------------------------		export	oh_option_listoh_option_list		jsr	write_option_list	;write out option list info 		rts				;exit;------------------------------------------------------------------------------; O_TRANSFER_COUNT Parameter Handler: Output (lw);------------------------------------------------------------------------------		export	oh_transfer_countoh_transfer_count					        		lda	transfer_count		;Get low word.		ldx	transfer_count+2	;Get high word.		bra	store_long		;store it in param block;------------------------------------------------------------------------------; O_POSITION Parameter Handler: Output (lw);------------------------------------------------------------------------------		export	oh_positionoh_position						        		lda	file_mark		;Get low word.		ldx	file_mark+2		;Get high word.		bra	store_long		;store it in param block;------------------------------------------------------------------------------; O_ENTRY_NUM Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_entry_numoh_entry_num						        		lda	entry_num		;Get entry #.		bra	store_word		;store it in param block;------------------------------------------------------------------------------; O_DEV_NUMBER Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_dev_numberoh_dev_number						        		lda	dev_number		;Get number		bra	store_word		;store it in param block;------------------------------------------------------------------------------; O_FILE_SYS_ID Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_file_sys_idoh_file_sys_id						        		lda	#hfs_id			;Get HFS ID.		bra	store_word		;store it in param block				;------------------------------------------------------------------------------; O_BLOCK_SIZE Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_block_sizeoh_block_size						        		lda	#phys_blk_size		;Get block size		bra	store_word		;store it in param block				;------------------------------------------------------------------------------; O_EXTENDED Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_extended_flagoh_extended_flag						        		lda	extended_flag		;Get extended flag.		bra	store_word		;store it in param block;------------------------------------------------------------------------------; O_TOTAL_BLOCKS Parameter Handler: Output (lw);------------------------------------------------------------------------------		export	oh_total_blocksoh_total_blocks						        		lda	total_blocks		;Get low word.		ldx	total_blocks+2		;Get high word.		bra	store_long		;store in param block;------------------------------------------------------------------------------; O_BLOCKS_USED Parameter Handler: Output (lw);------------------------------------------------------------------------------		export	oh_blocks_usedoh_blocks_used						        		lda	blocks_used		;Get low word.		ldx	blocks_used+2		;Get high word.		bra	store_long		;store it in param block;------------------------------------------------------------------------------; O_FREE_BLOCKS Parameter Handler: Output (lw);------------------------------------------------------------------------------		export	oh_free_blocksoh_free_blocks						        		lda	free_blocks		;Get low word.		ldx	free_blocks+2		;Get high word.		bra	store_long		;store it in param block;------------------------------------------------------------------------------; O_RESOURCE_BLOCKS Parameter Handler: Output (lw);------------------------------------------------------------------------------		export	oh_resource_blocksoh_resource_blocks					        		lda	resource_blocks		;Get low word.		ldx	resource_blocks+2	;Get high word.		bra	store_long		;store it in param block;------------------------------------------------------------------------------; O_NAME Parameter Handler: Output (ptr);------------------------------------------------------------------------------		export	oh_nameoh_name	; NOTE - This output handler is only used for GetDirEntry.;	 The name string is always stored into a class 1 output buffer even if;	 the GetDirEntry call was a class 0 call. If the buffer is too small to;	 hold the entire string, we must store as much of the string as will fit;	 and then report a 'buff_too_small' error. GetDirEntry must set up all ;	 of the requested output parameters even if a 'buff_too_small' error ;	 is being reported. So, if we get an error from the store_string routine, ;	 we'll save the error for later and indicate no error so that the rest ;	 of the output params will be set up.		lda	class			;get call class		pha				;and save		inc	class			;force call class to 1		lda	#record_name		;get address of record name		jsr	store_string		;store the string		plx				;restore call class (don't change A)		stx	class		bcc	@done			;if no error, then we're done		sta	gde_buf_err		;save the error for later		clc				;indicate no error@done		rts				;exit;------------------------------------------------------------------------------; O_SYNTAX Parameter Handler: Output (ptr);------------------------------------------------------------------------------		export	oh_syntaxoh_syntax						        		lda	#syntax_str		;get ptr to string - lo word		ldx	#^syntax_str		;get ptr to string - hi word		bra	store_long		;store it in param block;------------------------------------------------------------------------------; O_MAX_LEN Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_max_lenoh_max_len						        		lda	max_len			;get max length		bra	store_word		;store it in param block;------------------------------------------------------------------------------; O_NAME_FLAGS Parameter Handler: Output (w);------------------------------------------------------------------------------		export	oh_name_flagsoh_name_flags						        		lda	name_flags		;get name flags		bra	store_word		;store it in param block;------------------------------------------------------------------------------; store_long and store_word routines;;  Input:	A - lo word to store ; 		X - hi word to store (store_long) ;    		    undefined (store_word); 		Y - parameter offset;; Output:	A - undefined;		X - undefined;		Y - undefined;------------------------------------------------------------------------------		export	store_word		store_long	sta	[my_pblk_ptr],y		;store low word in param block		iny				;bump offset		iny		txa				;get high wordstore_word	sta	[my_pblk_ptr],y		;store it in param block		clc				;indicate no error		rts				;exit;------------------------------------------------------------------------------; store_string routine;;  Input:	A - address of source string (class 0 string in our data bank); 		X - undefined; 		Y - parameter offset;; Output:	A - error code if carry set;		X - undefined;		Y - undefined;------------------------------------------------------------------------------store_string	; Initialize flag to 0.		stz	<temp0		; Store the address of the source string on direct page.		sta	<source_ptr		;save address of source string; Get the address of the destination from the parameter block and store on direct page.		lda	[my_pblk_ptr],y		;get lo word of dest ptr  		sta	<dest_ptr		;and save		iny						iny		lda	[my_pblk_ptr],y		;get hi word of dest ptr  		and	#$00ff			;clear high byte		sta	<dest_ptr+2		;and save; Determine whether we're doing a class 0 or class 1 call.		lda	class			;get call class		bne	class1			;it's a class 1 call		; We're doing a class 0 call.; Store the string length in the output buffer.		lda	(source_ptr)		;get string length		sta	[dest_ptr]		;and store in output buffer		bra	store_it		;store the string; We're doing a class 1 call.; First, determine if the output buffer is large enough to hold the string length.; If so, store the string length in the output buffer. Otherwise, report an error.; Next, determine if the output buffer is large enough to hold the entire string.; If not, then determine if we're doing a GetDirEntry call.; If so, then return as much of the string as will fit and then report an error.; Otherwise, just report an error and don't return the string.class1		sec		lda	[dest_ptr]		;get length of output buffer		sbc	#4			;big enough to hold string length?		bmi	buf_error		;no - so report an error		tax				;yes - so save 'buffer size-4'		lda	(source_ptr)		;get source string length		and	#$00ff			;only want lo byte		ldy	#2		sta	[dest_ptr],y		;and store in output buffer		txa				;put 'buffer size - 4' in A		beq	buf_error		;if it's 0 then report an error		cmp	[dest_ptr],y		;is it big enough to hold entire string?		bcs	@0			;yes		ldx	call			;no - so get call number		cpx	#gde_call_num		;are we doing a GetDirEntry call?		bne	buf_error		;no - so report an error		inc	<temp0			;yes - so set flag		sep	#$20			;set 8 bit A		sta	(source_ptr)		;and adjust string length to fit		rep	#$20			;set 16 bit A@0; Adjust dest ptr by 3 so we can treat it like a class 0 string. adjust		clc				;add 3 to dest ptr		lda	<dest_ptr		adc	#3		sta	<dest_ptr		lda	<dest_ptr+2		adc	#0		sta	<dest_ptr+2; Store the string in the output bufferstore_it	lda	(source_ptr)		;get source string length		and	#$00ff			;only want lo byte		tay			 	longa	off					sep	#$20			;set 8 bit Astring_loop	lda	(source_ptr),y 		;get byte 		sta	[dest_ptr],y		;store in output buffer		dey				;adjust offset		bne	string_loop		;loop until done		longa	on			;restore 16-bit A		rep	#$20; If the flag is set, then return an error.		lda	<temp0		bne	buf_error		; Indicate no error and exit.no_dest		clc				;indicate no error		rts				;exit; Return a 'buffer too small' error.buf_error	lda	#buff_too_small		;get error code		sec				;indicate error		rts				;exit		ENDP				eject********************************************************************************	 Name:	read_option_list** Description:	Reads information from the option list buffer and stores it for later.**	Entry:	jsr**	 Exit:	rts**	Input:	A = lo word of ptr to option list buffer*		X = undefined*		Y = hi word of ptr to option list buffer*		P = nvmxdizc*		    ..000...*		B = K**		option_flag - set to 0 *		option list buffer - input (word):  buffer size (inc. fields 1 and 2)*				     input (word): data size*				     input (word): fst id*				     input (32 bytes): Finder Info**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		finder_info - Finder Info*		option_flag - 1 = option list valid *			      0 = option list invalid**	 Uses:	all registers*		<temp0**   Called by:	ih_option_list	(parameter handler)	**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************read_option_list PROC		with	data** Store ptr to option list buffer on direct page.  Exit if ptr = 0.*		sta	<temp0			;save low word of ptr		tya				;get hi word of ptr		and	#$00ff			;clear hi byte		sta	<temp0+2		;and save		ora	<temp0			;is ptr zero?		beq	exit			;yes - so done** Is the buffer big enough to contain what we expect (ie. Finder Info)?*		lda	[temp0]			;get buffer size		cmp	#ol_finder_info+32	;is it big enough?		bcc	exit			;no - so done** The buffer is big enough so now check the data size to see if the data is* really there.  We expect a minimum of 34 bytes of data.* NOTE - We need to check both the buffer size and the data size because in*	 previous releases of GS/OS, the data size field was undefined.*		ldy	#ol_req_size		lda	[temp0],y		;get data size		cmp	#34			;enough data?		bcc	exit			;no - so done** Check the FST ID.  If it's not HFS, AppleShare or ProDOS then exit.  *		ldy	#ol_fst_id		;get offset to fst id field		lda	[temp0],y		;get the fst id		cmp	#hfs_id			;is it hfs?		beq	id_ok			;yes		cmp	#ashare_id		;is it appleshare?		beq	id_ok			;yes		cmp	#prodos_id		;is it prodos?		bne	exit			;no - so doneid_ok** Copy Finder Info from option list buffer into input storage area.* 		ldx	#0			;init offset into finder_info storage		ldy	#ol_finder_info		;init offset into option list bufferfinfo_loop	lda	[temp0],y		;get word of finder info 		sta	finder_info,x		;and save it in storage area		iny				;adjust offsets		iny		inx						inx		cpx	#32			bne	finfo_loop		;loop until done				inc	option_flag		;indicate that option list was valid** Indicate no error and exit.*exit		clc						rts								ENDP				eject********************************************************************************	 Name:	write_option_list** Description:	Writes information into the option list buffer.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = offset into parameter block *		P = nvmxdizc*		    ..000...*		B = K**		<my_pblk_ptr - pointer to parameter block*		finder_info - Finder Info*		parent_id - parent directory id*		call - call number*		<my_fcr_ptr - ptr to fcr (OPEN call only)**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		option list buffer - input (word):  total size (inc. fields 1 and 2)*				     output (word): required size (exc. fields 1 and 2)*				     output (word): fst id*				     output (32 bytes): Finder Info*				     output (long): parent directory id**	 Uses:	all registers*		<temp0**   Called by:	oh_option_list 	(parameter handler)	**	Calls:	release_fcr 	(system service)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************write_option_list PROC		with	data** Get ptr to option list buffer from parameter block and store on direct page*		lda	[my_pblk_ptr],y		;get lo word of ptr		sta	<temp0			;and save		iny				;bump offset		iny		lda	[my_pblk_ptr],y		;get hi word of ptr		and	#$00ff			;clear hi byte		sta	<temp0+2		;and save		ora	<temp0			;is ptr zero?		beq	exit			;yes - so done** Is the buffer big enough to hold the required size info?  Parm_range_err if not.*check_buffer	lda	[temp0]			;get total buffer size		cmp	#4			;big enough to hold required size info?		bcs	big_enough		;yes		lda	#parm_range_err		;no, so parm_range_err		brl	error_exit		** Stuff in the required size info.*big_enough	lda	#req_ol_size		;get required size 		ldy	#ol_req_size		;get offset to required size field		sta	[temp0],y		;stuff it in** Make sure buffer is big enough to hold the FST ID.  Buf_too_small error if not.*		lda	[temp0]			;get total buffer size		cmp	#6			;will the id fit?		bcc	buffer_err		;no** Stuff in the FST ID.*		lda	#hfs_id			;get fst id		ldy	#ol_fst_id		;get offset to id field		sta	[temp0],y		;stuff it in** Make sure buffer is big enough to hold the data.  Buf_too_small error if not.*		lda	[temp0]			;get total buffer size		cmp	#len_ol 		;big enough for data?		bcc	buffer_err		;no** Copy Finder Info from output parameter storage area into option list buffer.* 		ldx	#0			;init offset into finder_info storage		ldy	#ol_finder_info		;init offset into option list bufferfinfo_loop	lda	finder_info,x		;get word of finder info 		sta	[temp0],y		;stuff it into option list buffer		iny				;adjust offsets		iny		inx						inx		cpx	#32			bne	finfo_loop		;loop until done** Copy parent dir ID from output parameter storage area into option list buffer.*		ldy	#ol_parent_id		;init offset into option list buffer		lda	parent_id		;get lo word of parent id		sta	[temp0],y		;stuff it in		iny				;adjust offset		iny		lda	parent_id+2		;get hi word of parent id		sta	[temp0],y		;stuff it in** Indicate no error and exit.*exit		clc						rts						** Report a buffer too small error.  *buffer_err	lda	#buff_too_small		;get error code** Report an error.  * If we're processing an Open call, we must release the fcr and decrement vcr_open_cnt.*error_exit	ldx	call			;doing an Open call?		cpx	#open_call_num		bne	real_exit		;no				pha				;yes - so save error code		lda	[my_fcr_ptr]		;get ref_num		jsl	release_fcr		;release fcr				ldy	#vcr_open_cnt				lda	[my_vcr_ptr],y		;get open count		dec	a			;decrement it		sta	[my_vcr_ptr],y		;and store it		pla				;restore error code		real_exit	sec				;indicate error		rts				;and exit				ENDP				eject********************************************************************************	 Name:	create** Description:	Creates a new file or subdirectory on disk.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_path_ptr - pointer to pathname (if specified) in gstring format*		<dev_num - device number (if specified), else 0*		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)*		input_error - set if input error**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		requested_stype*		<source_ptr	(aka <product)*		<dest_ptr	**   Called by:	app_entry**	Calls:	process_path*		is_vol_unlocked*		set_access*		set_file_aux*		set_create_dt*		build_fcr*		ct_create_rec*		ct_get_rec*		ct_update*		et_extend_file*		bt_get_node*		bt_mark_node*		et_delete_file*		ct_delete_rec*		copy_ext*		copy_long*		release_fcr		(system service)** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************create		PROC		with	data** If the 'storage_type' input param was not supplied, use default.*		lda	storage_type		;was the storage_type param supplied?		bne	stype_ok		;yes - so ok		lda	#extended_stype		;no - so use default; Begin 6-Feb-92 MSD		ldy	file_type		cpy	#dir_ftype		; creating a folder?		bne	stype_ok		lda	#directory_stype	; yes, so force folder storage type; End 6-Feb-92 MSDstype_ok		sta	requested_stype		;save requested storage type ** See if the pathname already exists. Save results of call.* Note - we need to call process_path before we check name_count so that*	 error_priority is set correctly.* 		jsr	process_path		;look for Catalog Record   		php				;save results of call		pha** This call cannot be used to create a volume directory.* Check to see if there are 2 or more names in the pathname.  Report an error if not.*		lda	name_count		;get # of names in full pathname		cmp	#2			;is it 2 or more?		bcs	not_vol_dir		;yes - so we're ok		pla				;no - so clean up stack		plp		lda	#bad_path_syntax	;and return an error		brl	error		not_vol_dir	pla				;retrieve results from process_path call		plp						bcs	not_found		;branch if the pathname doesn't exist ** The pathname already exists.* If we're not extending a file (requested_stype = $8005) then report a duplicate path error.* Otherwise, make sure the file is not already extended and that it's a 'standard file'.*		lda	requested_stype		;are we extending a file?		bmi	@1			;yes 		lda	#dup_pathname		;no - so we have a duplicate pathname		brl	error			;return the error		@1		lda	storage_type		;get existing file's storage type		cmp	#extended_stype		;is the file already extended?		bne	@2			;no		lda	#resource_exist		;yes - so resource fork already exists		brl	error			;return the error		@2		cmp	#standard_stype		;is the file a 'standard file'?		beq	its_standard		;yes 		lda	#res_add_err		;no - so can't extend the file brl_error	brl	error			;return the errorits_standard	lda	resource_eof		;get # of bytes to allocate to rsrc fork			ora	resource_eof+2		;is it 0?		bne	check_vol		;no - so continue		brl	done			;yes - so we're done		** The pathname doesn't already exist.* Make sure that the only part of the pathname that doesn't already exist is the * last name in the path.* If we're trying to extend a file, then report a 'file not found' error.*not_found	cmp	#file_not_found		;was the error 'file not found'?		bne	brl_error		;no - so return the error		ldx	requested_stype		;are we extending a file?		bmi	brl_error		;yes - so report 'file not found' error** If input_error is non-zero then exit with input_error.*		lda	input_error		;was there an input error?		bne	brl_error		;yes - so return the error** Make sure the volume is unlocked.*check_vol	jsr	is_vol_unlocked		;is the volume unlocked?		bcs	brl_error		;no - so return error** If we're extending a file then skip the ct_create_rec and ct_get_rec calls since* the Catalog Record already exists and A1.L, D2.L and catalog_hint are already set up * correctly from the process_path routine.*		lda	requested_stype		;get requested storage type		bmi	mark_node		;branch if we're extending a file** The path is good and the file/dir doesn't exist so create a new Catalog Record.*		lda	#record_name		;A0.L <- ptr to name		sta	<a0		lda	#^record_name		sta	<a0+2				lda	parent_id		;D0.L <- parent ID		sta	d0		lda	parent_id+2		sta	d0+2				ldx	#cat_fil_type		lda	requested_stype		;get requested storage type 		cmp	#directory_stype	;are we creating a subdirectory?		bne	store_d1		;no - so branch		ldx	#cat_dir_type		;yes store_d1	stx	d1			;D1.W <- catalog record type		stx	record_type		;save for later				jsr	ct_create_rec		;create a new Catalog Record		bcs	brl_error** Get a pointer to the new Catalog Record and save the catalog hint for later.* When we get here, A0.L = ptr to name, D0.L = parent ID, D2.L = catalog hint.*		jsr	ct_get_rec		;get the new Catalog Record		bcs	brl_error		lda	d2			;save resulting catalog hint		sta	catalog_hint		lda	d2+2		sta	catalog_hint+2** When we get here, A1.L = ptr to Catalog Record, D2.L = catalog hint (ie node #).* The node buffer which A1.L is pointing into is marked unused. This causes a problem* if we need to extend either of the file's forks. The et_extend_file routine may* read in nodes from disk which would most likely write over the node buffer containing * the Catalog Record that A1.L points to. To avoid this problem, we need to mark the* node buffer as 'dirty' so it won't get re-used until we're done with it. The easiest* way to do this is to call bt_get_node to get a pointer to the node buffer and then* call bt_mark_node to mark the node buffer 'dirty'. This is sort of a kludge since * this code really shouldn't be dealing directly with the node buffers or the node* buffer routines but it works and it's easy so what the heck.* Note - this problem doesn't occur on the Mac because the Mac CREATE call doesn't * allow the user to specify an initial size for the forks.* mark_node	lda	ctree_fcr_ptr		;A4.L <- ptr to Catalog tree fcr		sta	<a4		lda	ctree_fcr_ptr+2		sta	<a4+2				lda	#1			;D1.W <- node exists in buffer		sta	d1				jsr	bt_get_node		;set up A0.L to point to node buffer		bcs	error				jsr	bt_mark_node		;mark the node buffer 'dirty'** If we're extending a file then the only input parameter we're interested in is* the resource_eof parameter so branch down to the code which deals with that.*		lda	requested_stype		;get requested storage type		bmi	do_rsrc_eof		;branch if we're extending a file** If we're handling a class 1 call and the 'access' param was not supplied, use default.*		lda	pcount			;get pcount		cmp	#2			;were 2 or more params supplied?		bcs	access_ok		;yes - so access param was supplied		lda	#full_access		;no - so set access param to default		sta	accessaccess_ok** Set access information for the file/dir.*		jsr	set_access		** Set the HFS creator and filetype for the file/dir.*		jsr	set_file_aux** Set the create date/time for the file/dir (class 0 call only).*		lda	class			;get call class		bne	skip_dt			;branch if not class 0		jsr	set_create_dtskip_dt** If requested_stype <> 'directory' then check the eof and resource_eof parameters.* If eof <> 0, allocate the requested storage to the data fork.* If resource_eof <> 0, allocate the requested storage to the resource fork.* Note - the resource_eof param is only valid if requested_stype = 'extended file'.* When a fork is extended, the peof is adjusted but the leof remains 0.*		lda	requested_stype		;get requested storage type		cmp	#directory_stype	;are we creating a directory?		beq	eofs_done		;yes - so ignore eof params				lda	eof			;D4.L <- # of bytes to allocate		sta	d4					lda	eof+2		sta	d4+2		ora	eof			;is eof = 0?		beq	@0			;yes - so branch				jsr	extend_fork		;no - so allocate the requested bytes		bcs	error			;to the data fork@0			lda	requested_stype		;get requested storage type		cmp	#extended_stype		;are we creating an extended file?		bne	eofs_done		;no - so ignore resource_eof param		do_rsrc_eof	lda	resource_eof		;D4.L <- # of bytes to allocate		sta	d4		lda	resource_eof+2		sta	d4+2		ora	resource_eof		;is resource_eof = 0?		beq	eofs_done		;yes - so branch				inc	resource_num		;indicate we're extending the rsrc fork		jsr	extend_fork		;allocate the requested bytes		bcs	error			;to the resource forkeofs_done** Write the catalog node containing the record out to disk.*		lda	catalog_hint		;D2.L <- catalog hint		sta	d2		lda	catalog_hint+2		sta	d2+2		jsr	ct_update		bcs	error** Indicate no error and exit.*done		clc 		rts		** Return an error.*error		sec						rts				;------------------------------------------------------------------------------; extend_fork routine;------------------------------------------------------------------------------extend_fork	** Build an fcr for the fork.*		lda	#read_write		;set up 'request_access' for build_fcr		sta	request_access				jsr	build_fcr		;build an fcr for the fork		bcs	extend_exit** Set the file's clump size equal to the volume's allocation block size so that * et_extend_file won't allocate more space than we want. *		ldy	#fcr_clump_size				lda	ablk_size				sta	[my_fcr_ptr],y				iny						iny		lda	ablk_size+2		sta	[my_fcr_ptr],y** Allocate the requested # of bytes to the fork.* D4.L has already been set up to contain the # of bytes to allocate.* Note - et_extend_file updates the fcr_peof field and the fcr_ext field.* 		lda	<my_fcr_ptr		;A2.L <- ptr to fcr		sta	<a2		lda	<my_fcr_ptr+2		sta	<a2+2				lda	#1			;D3.W <- allocate all requested bytes		sta	d3				jsr	et_extend_file		;extend the fork		bcs	extend_exit2		;branch if error** Copy the new peof and ext from the fcr to the Catalog Record.*		lda	<my_fcr_ptr		;setup source ptr		sta	<source_ptr		lda	<my_fcr_ptr+2		sta	<source_ptr+2				lda	<a1			;setup destination ptr		sta	<dest_ptr				lda	<a1+2		sta	<dest_ptr+2		ldy	#fcr_peof		;get starting source offset		ldx	#fil_data_peof		;get starting dest offset		lda	resource_num		;are we extending the resource fork?		beq	cont1			;no - so branch		ldx	#fil_rsrc_peof		;yes - so adjust dest offsetcont1		jsr	copy_long		;copy peof				ldy	#fcr_ext		;get starting source offset		ldx	#fil_data_ext		;get starting dest offset		lda	resource_num		;are we extending the resource fork?		beq	cont2			;no - so continue		ldx	#fil_rsrc_ext		;yes - so adjust dest offsetcont2		jsr	copy_ext		;copy ext (6 words)** Release the fcr and exit.*				lda	[my_fcr_ptr]		;get fcr refnum		jsl	release_fcr		;release the fcrextend_exit	rts		** We got an error from et_extend_file.* We need to save the error code, do a bunch of cleaning up, and then return the error.*extend_exit2	pha				;save error code** Release the fcr.*		lda	[my_fcr_ptr]		;get fcr refnum		jsl	release_fcr		;release the fcr** If we're extending a standard file (requested_stype = $8005), then we're done cleaning up.*		lda	requested_stype		;get requested storage type		bmi	cleaned_up		;branch if we're extending a file** Write the node containing the Catalog Record out to disk so that et_delete_file* will get the correct extent information.*		lda	catalog_hint		;D2.L <- catalog hint		sta	d2		lda	catalog_hint+2		sta	d2+2		jsr	ct_update** De-allocate any disk space allocated to the file* then delete the Catalog Record for the file.*		lda	#record_name		;A0.L <- ptr to name		sta	<a0		lda	#^record_name		sta	<a0+2				lda	parent_id		;D0.L <- parent ID		sta	d0		lda	parent_id+2		sta	d0+2				jsr	et_delete_file		;de-allocate space allocated to file		jsr	ct_delete_rec		;delete the Catalog Record** Retrieve original error code and exit.*cleaned_up	pla				;retrieve original error code		sec				;indicate error		rts				;exit		ENDP				eject********************************************************************************	 Name:	destroy** Description:	Deletes a file or subdirectory.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_path_ptr - pointer to pathname (if specified) in gstring format*		<dev_num - device number (if specified), else 0*		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	process_path*		is_vol_unlocked*		is_file_unlocked*		is_file_closed*		et_delete_file*		ct_delete_rec** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************destroy		PROC		with	data		** Find the Catalog Record and vcr for the requested file or directory.*		jsr	process_path		   		bcs	exit		** Return an error if trying to delete a volume directory.  *		lda	storage_type		;get storage type		cmp	#volume_stype		;trying to delete a volume directory?		bne	stype_ok		;no		lda	#invalid_access		;yes - so return an error 		sec		bra	exitstype_ok** Make sure the file/dir isn't currently open. *		jsr	is_file_closed		;is the file/dir closed?		bcs	exit			;no - so return error** Make sure the file/dir is unlocked. *		jsr	is_file_unlocked	;is the file/dir unlocked?		bcs	exit			;no - so return error** Make sure the volume is unlocked.*		jsr	is_vol_unlocked		;is the volume unlocked?		bcs	exit			;no - so return error** Setup inputs for calls to et_delete_file and ct_delete_rec.* Note - et_delete_file saves and restores the input registers so we don't*	 need to set them up again before calling ct_delete_rec.*		lda	#record_name		;A0.L <- ptr to name		sta	<a0		lda	#^record_name		sta	<a0+2				lda	parent_id		;D0.L <- parent ID		sta	d0		lda	parent_id+2		sta	d0+2				lda	catalog_hint		;D2.L <- catalog hint		sta	d2		lda	catalog_hint+2		sta	d2+2** If we're deleting a subdirectory, it must be empty.   *		lda	record_type		;get catalog record type		cmp	#cat_dir_type		;are we deleting a directory?		bne	not_dir			;no - so skip check		ldy	#dir_valence		;yes - so get # of kids in dir		lda	[a1],y			;is the dir empty?		beq	delete_rec		;yes - so delete it		lda	#invalid_access		;no - so return error		sec		bra	exitnot_dir** De-allocate all disk space currently allocated to the file.* Note - subdirectories have no space allocated to them so skip this call.*		jsr	et_delete_file		;de-allocate space allocated to file		bcs	exit** Delete the Catalog Record for the file/dir.*delete_rec	jsr	ct_delete_rec		;delete the Catalog Record		bcs	exit** Indicate no error and exit.*		clc				exit		rts		ENDP		eject********************************************************************************	 Name:	change_path** Description:	Changes a file's pathname to another pathname on the same volume,*		or renames a volume.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<path_flag - indicates if path1_ptr and/or path2_ptr are valid*		<path1_ptr - pointer to source pathname in gstring format*		<path2_ptr - pointer to dest pathname in gstring format*		<dev1_num - device number for source if specified, else 0*		<dev2_num - device number for destination if specified, else 0*		<span1 - maximum span of source pathname*		<span2 - maximum span of destination pathname**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_path_ptr - pointer to source pathname (if specified) in gstring format*		name_count - total # of names in source pathname. 0 if device # only.*		first_offset - offset to first name in source pathname*		last_offset - offset to last name in source pathname*		volname - volume name in gstring format (if dev_num = 0)**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		src_vcr_id*		src_dev_num*		src_cat_hint*		src_parent_id*		src_id*		src_record_name*		src_locked*		src_is_vol*		volname*		<temp0**   Called by:	app_entry**	Calls:	process_path*		is_vol_unlocked*		is_file_closed*		is_file_unlocked*		parse_path2*		ct_move_rec*		ct_rename_rec*		update_vib_name*		strcmp*		release_vcr		(system service)*		rename_vcr		(system service)** Copyright Apple Computer, Inc. 1989-91  All rights reserved.**-----------------------------------------------------------------------------* Examples of valid combinations of source and destination pathnames -** <volname or devname>	 	   --> <volname>		 	(rename)* <volname or devname>:oldfile 	   --> <volname or devname>:newfile 	(rename)** <volname or devname>:oldfile 	   --> <volname or devname>:dir:oldfile (move)* <volname or devname>:dir:oldfile --> <volname or devname>:oldfile	(move)** <volname or devname>:oldfile 	   --> <volname or devname>:dir:newfile	(move and rename)* <volname or devname>:dir:oldfile --> <volname or devname>:newfile	(move and rename)* * Examples of invalid combinations of source and destination pathnames -** <any pathname> 		--> <devname>* <volname or devname>		--> <volname or devname>:anything* <volname or devname>:anything --> <volname or devname>** Other rules -** An open file/dir cannot be moved or renamed.* A locked file can be moved but cannot be renamed.* An open dir can have files/dirs moved into and out of it.* Can move or rename the ancestor of an open file/dir.** Notes -** If an ancestor of an open file/dir is moved or renamed, the FCR for the open*   file/dir will still have the old pathname.  (the ProDOS FST acts the same)* If a volume is renamed, the FCRs for all open files/dirs on that volume will*   still have the old volume name.  (the ProDOS FST acts the same)* A volume, whose current name is a duplicate of another volume which has open files,*   can be renamed by using a device name as the source pathname.* If bit 15 of cp_flags is set and the source was a device name only, then assume*   if was a duplicate and use the "fake VCR" method to rename it.******************************************************************************change_path	PROC		with	data** If the source is only a device # then set cp_device_flag to 1. * This is a special case so that the Finder can rename a volume whose current name * is a duplicate of another volume which has open files.*		lda	name_count		;was a source pathname supplied?		bne	@not_dev		;yes		inc	cp_device_flag		;no - so indicate source was a device #@not_dev** If the source was _not_ just a device #, force the high bit of cp_flags to 0 (since* it only applies when the source is only a device #).  5-Dec-91 MSD*		lda	cp_device_flag		; was the source a device # only?		bne	@is_dev			; yes, so leave cp_flags alone		stz	cp_flags		; only high bit is defined, clear it@is_dev** Find the Catalog Record and vcr for the source file/dir.* Note - we need to call process_path before we check path2_bit so that*	 error_priority is set correctly.*		jsr	process_path		bcs	brl_error** The destination cannot be only a device #, so* if a destination pathname wasn't specified then report an error.*		lda	<path_flag		;get pathname flags		and	#path2_bit		;is pathname 2 defined?		bne	path2_ok		;yes - so ok		brl	bad_path		;nopath2_ok** Make sure the source file/dir is closed. *		jsr	is_file_closed		;is the file/dir closed?		bcc	file_closed		;yesbrl_error	brl	error			;no - so return errorfile_closed		** Make sure the volume is unlocked.*		jsr	is_vol_unlocked		;is the volume unlocked?		bcs	brl_error		;no - so return error** Find out if the source file/dir is unlocked in case we're doing a rename. *		stz	src_locked		jsr	is_file_unlocked	;is the file/dir unlocked?		bcc	unlocked		;yes		sta	src_locked		;no - so save error code for laterunlocked** Save the source file/dir's vcr id, device number, catalog hint, parent id, * file/dir id, and name.* 		lda	[my_vcr_ptr]		;get vcr id		sta	src_vcr_id		;and save				ldy	#vcr_dev		lda	[my_vcr_ptr],y		;get device number		sta	src_dev_num		;and save				lda	catalog_hint		;get catalog hint		sta	src_cat_hint		;and save		lda	catalog_hint+2		sta	src_cat_hint+2				lda	parent_id		;get parent id		sta	src_parent_id		;and save		lda	parent_id+2		sta	src_parent_id+2				lda	id			;get file/dir id		sta	src_id			;and save		lda	id+2		sta	src_id+2				sep	#$30			;set 8-bit A and X		longa	off		longi	off				ldx	record_name		;get name lengthsave_loop	lda	record_name,x		;save name 		sta	src_record_name,x		dex		bpl	save_loop		;loop until done				rep	#$30			;restore 16-bit A and X		longa	on		longi	on** Set a flag if the source is a volume directory.*		stz	src_is_vol		;init flag		lda	storage_type		;get storage type of source		cmp	#volume_stype		;is it a volume dir?		bne	@not_vol		;no		inc	src_is_vol		;yes - so set flag@not_vol* * Parse the destination pathname.* 		jsr	parse_path2		;parse the destination pathname		bcc	dest_ok				brl	errordest_ok** Branch if the source is not a volume directory.*		lda	src_is_vol		;is the source a volume dir?		beq	src_not_vol		;no - so branch** The source is a volume directory.* First, make sure that the destination consists of only 1 name.* Then check to see if a vcr exists for the destination name.* If we find a vcr, then check to see if the dest vcr ID matches the source vcr ID.  * If the vcr IDs match, do the rename (we might be changing the case of the name).  * If they don't match, then check to see if the destination volume has any open files.* If so, return a 'duplicate volume' error.  If not, release the vcr and do the rename.*		lda	name_count				cmp	#1			;does dest have only 1 name?		bne	brl_bad_path		;no - so report error			 	ldx	#volname		;get pointer to	destination volume name		ldy	#^volname		lda	#0000			;search	by name		jsl	find_vcr				bcs	not_dup_vol		;didn't find a vcr so do rename				jsl	deref			;dereference pointer		stx	<temp0			;save it in 'temp0' so we don't trash		sty	<temp0+2		;'my_vcr_ptr' which is needed later!				lda	[temp0]			;get vcr id of dest		cmp	src_vcr_id		;compare it to the vcr id of the source		beq	not_dup_vol		;they're the same so do rename		ldy	#vcr_open_cnt		;the source and dest are not the same volume		lda	[temp0],y		;does the dest volume have any open files?		bne	brl_dup_vol		;yes - so return 'duplicate volume' error		lda	[temp0]			;no - so release the dest vcr 		jsl	release_vcrnot_dup_vol	brl	do_rename		;and do rename				brl_dup_vol	brl	dup_vol** The source is not a volume directory.* First, make sure that the destination consists of > 1 name.* Then, try to find the Catalog Record and vcr for the destination file/dir.*src_not_vol	lda	name_count				cmp	#1			;does dest have > 1 name?		bne	cont			;yes - so continuebrl_bad_path	brl	bad_path		;no - so report errorcont		jsr	process_path		;did we find the Catalog Record and vcr?		bcs	not_found		;no - so branch** The destination file/dir exists.* Check to see if the source and dest are the same file/dir.  * If so, do a rename (we might be changing the case of the name). * Otherwise, return a 'duplicate pathname' error.*		ldy	#vcr_dev		lda	[my_vcr_ptr],y		;get device number of dest		cmp	src_dev_num		;same as device number of source?		bne	brl_dup_path		;no - so report error				lda	src_parent_id		;source and dest are on same device so		cmp	parent_id		;compare their parent ids		bne	brl_dup_path		;no match - return 'duplicate path' error		lda	src_parent_id+2		cmp	parent_id+2		bne	brl_dup_path		;no match - return 'duplicate path' error				lda	src_id			;source and dest have same parent ids		cmp	id			;so compare their own ids		bne	brl_dup_path		;no match - return 'duplicate path' error		lda	src_id+2		cmp	id+2		beq	do_rename		;they're the same so do a renamebrl_dup_path	brl	dup_path		;no match - return 'duplicate path' error		** The destination file/dir doesn't exist.* If we got a 'file not found' error then continue.* If we got any other error, then return it.*not_found	cmp	#file_not_found		;'file_not found' error?		beq	err_ok			;yes - so continuebrl_error2	brl	error			;no - so return the errorerr_ok** If we get here, we got a 'file not found' error from process_path on the destination.* Make sure that the source and destination are on the same device.*		ldy	#vcr_dev		lda	[my_vcr_ptr],y		;get device number of dest		cmp	src_dev_num		;same as device number of source?		bne	brl_bad_path		;no - so report error** If the parent_id of the source and destination are the same then do a rename.* If not, do a move.*		lda	parent_id		;get parent dir id of dest		cmp	src_parent_id		;same as parent dir id of source?		bne	do_move			;no - so do a move		lda	parent_id+2		cmp	src_parent_id+2		bne	do_move** We're doing a rename.*  do_rename	lda	src_locked		;is the source file/dir locked?		bne	brl_error2		;yes - so return error				lda	#src_record_name	;A0.L <- ptr to source record name		sta	<a0		lda	#^src_record_name		sta	<a0+2				lda	src_parent_id		;D0.L <- parent id of source		sta	d0		lda	src_parent_id+2		sta	d0+2		lda	src_cat_hint		;D2.L <- catalog hint for source		sta	d2				lda	src_cat_hint+2		sta	d2+2				lda	src_is_vol		;are we renaming a volume directory?		beq	@not_vol1		;no - so the new name is in record_name				lda	volname			;yes - so new name is in volname		xba				;convert volname from a gstring to a		sta	volname			;class 0 string					lda	#volname+1		;A1.L <- ptr to dest record name		sta	<a1		lda	#^volname		sta	<a1+2				bra	@cont			;continue		@not_vol1	lda	#record_name		;A1.L <- ptr to dest record name		sta	<a1		lda	#^record_name		sta	<a1+2		@cont		jsr	ct_rename_rec		;do the rename		bcs	error				lda	src_is_vol		;did we just rename a volume directory?		beq	@not_vol2		;no				jsr	vol_rename		;yes - so do volume specific stuff		bcs	error		@not_vol2	bra	done			;we're done		** We're doing a move.** Note - we may be moving and renaming at the same time. *	 For example - /vol/folder1/oldname --> /vol/newname*	 If the source is locked then we need to report an error*	 since renaming is not allowed on a locked file.*do_move		lda	#src_record_name	;A0.L <- ptr to source record name		sta	<a0		lda	#^src_record_name		sta	<a0+2				lda	#record_name		;A1.L <- ptr to dest record name		sta	<a1		lda	#^record_name		sta	<a1+2				lda	src_locked		;is the source file/dir locked?		beq	@cont			;no - so rename is allowed		jsr	strcmp			;do the source and dest names match? 		beq	@cont			;yes - so not doing a rename		lda	src_locked		;no - so get error code		bra	error			;and return error		@cont		lda	src_parent_id		;D0.L <- parent id of source		sta	d0		lda	src_parent_id+2		sta	d0+2				lda	parent_id		;D1.L <- dir id of destination directory		sta	d1					lda	parent_id+2		sta	d1+2				lda	src_cat_hint		;D2.L <- catalog hint for source		sta	d2				lda	src_cat_hint+2		sta	d2+2		  		jsr	ct_move_rec		;do the move (and rename)		bcs	error** Indicate no error and exit.*done		clc 		rts** Return a 'duplicate volume' error.*dup_vol		lda	#dup_volume		;get error code		bra	error		** Return a 'duplicate pathname' error.*dup_path	lda	#dup_pathname		;get error code		bra	error		** Return a 'bad path syntax' error.*bad_path	lda	#bad_path_syntax	;get error code** Return an error.*error		ldx	cp_device_flag		;did we build a vcr with a fake name?		bmi	clean_up		;yes - so need to clean up		sec				;indicate error		rts				;and exit** We were renaming a duplicate volume so we built a vcr with a fake name.  Since we * got an error at some point in the process, we need to find the vcr with the fake* name and release it (if it still exists).*clean_up 	pha				;save error code		ldx	#fake_name_str		;get pointer to	fake name string		ldy	#^fake_name_str		lda	#0000			;search	by name		jsl	find_vcr				bcs	@ok			;didn't find the vcr so we're ok		jsl	deref			;dereference vcr pointer		stx	<temp0					sty	<temp0+2				lda	[temp0]			;get vcr id 		jsl	release_vcr		;release the vcr@ok		pla				;retrieve error code		sec				;indicate error		rts				;and exit		;------------------------------------------------------------------------------; vol_rename routine;------------------------------------------------------------------------------vol_rename	; Copy the new volume name into the VIB.	; Note - 'volname+1' is currently a class 0 string.		jsr	update_vib_name		bcs	vol_exit		; Change the new volume name from a class 0 string back to a gstring. 		lda	volname			;make volname a gstring again		xba						sta	volname; Store the new volume name in the vcr.  		lda	src_vcr_id		;get vcr id		ldx	#volname		;get ptr to new volume name		ldy	#^volname		jsl	>rename_vcr		;rename the vcr		bcs	vol_exit; Get pointer to current boot prefix (class 1 string with leading separator).; Convert boot prefix to a class 0 string without a leading separator.; Compare current boot prefix with the original volume name.; Note - the original volume name is a class 0 string without a leading separator.; Restore boot prefix to a class 1 string with a leading separator.; Note - if cp_device_flag is $8001 then we're renaming a duplicate volume. In this;	 case, skip this section since the duplicate volume could have the same;	 name as the boot volume and we don't want to change the boot prefix.; @@@ this code is not needed until we support booting from an HFS volume ;;		lda	cp_device_flag		;are we renaming a duplicate volume?;		bmi	vol_done		;yes - so don't change the boot prefix;;		jsl	>get_boot_pfx		;get ptr to current boot prefix;		stx	<a0			;A0.L <- ptr to current boot prefix;		sty	<a0+2;;		lda	[a0]			;save length word;		pha;		ldy	#1;		lda	[a0],y			;save separator;		pha;		;		lda	[a0]			;convert boot prefix to class 0 string;		dec	a			;without a leading separator;		xba;		sta	[a0],y;		inc	<a0			;adjust string ptr;		inc	<a0;		;		lda	#src_record_name	;A1.L <- ptr to original volume name;		sta	<a1			;		lda	#^src_record_name;		sta	<a1+2;;		jsr	strcmp			;compare the strings;		php;		php;		plx				;save result in X;;		dec	<a0			;restore string ptr;		dec	<a0;		ldy	#1			;restore separator;		pla;		sta	[a0],y;		pla				;restore length word;		sta	[a0];		;		phx				;restore result;		plp;		plp;		bne	vol_done		;branch if strings did not match;		; The boot prefix = the original volume name so change the boot prefix to the ; new volume name.;;		ldx	#kludge			;get ptr to new volume name;		ldy	#^kludge;		jsl	>set_boot_pfx		;set the boot prefix;		bcs	vol_exit 		vol_done	clcvol_exit	rts				ENDP		eject********************************************************************************	 Name:	set_file_info** Description:	Sets information about an existing file or directory.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		pcount - parameter count*		access -  access information*		file_type - ProDOS file type*		aux_type - ProDOS aux type*		create_date - create date (class 0 call)*		create_time - create time (class 0 call)*		mod_date - modification date (class 0 call)*		mod_time - modification time (class 0 call)*		create_date_time - create date and time (class 1 call)*		mod_date_time - modification date and time (class 1 call)*		finder_info - Finder Info (class 1 call)*		option_flag - indicates whether a valid option list was provided**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_path_ptr - pointer to pathname (if specified) in gstring format*		<dev_num - device number (if specified), else 0*		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	process_path*		is_vol_unlocked*		set_access*		set_file_aux*		set_create_dt*		set_mod_dt*		set_finder_info*		ct_update** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************set_file_info	PROC		with	data		** Find the Catalog Record and vcr for the requested file or directory.*		jsr	process_path		   		bcs	exit			** Return an error if trying to do SetFileInfo on a volume directory.  *		lda	storage_type		;get storage type		cmp	#volume_stype		;trying to change a volume directory?		bne	stype_ok		;no		lda	#bad_path_syntax	;yes - so return an error		sec		brl	exitstype_ok** Make sure the volume is unlocked.*		jsr	is_vol_unlocked		;is the volume unlocked?		bcs	exit			;no - so return error** Set the access information for the file/dir.*		jsr	set_access		** Set the translated ProDOS filetype and auxtype for the file/dir (if provided).*		lda	pcount			;get pcount 		cmp	#3			;was the 'filetype' param provided?		bcc	skip_it1		;no - so don't change current values 		jsr	set_file_auxskip_it1** Set the create date/time for the file/dir (if provided).*		lda	pcount			;get pcount 		cmp	#6			;was the 'create date/time' param provided?		bcc	skip_it2		;no - so don't change current values		jsr	set_create_dt		skip_it2** Set the modified date/time for the file/dir (if provided).*		lda	pcount			;get pcount 		cmp	#7			;was the 'mod date/time' param provided?		bcc	skip_it3		;no - so don't change current values		jsr	set_mod_dt		skip_it3** Set the Finder Info for the file/dir (if provided).*		lda	option_flag		;was a valid option list provided? 		beq	skip_it4		;no - so don't change current values		jsr	set_finder_infoskip_it4** Write the catalog node containing the record out to disk.*		lda	catalog_hint		;D2.L <- catalog hint		sta	d2		lda	catalog_hint+2		sta	d2+2		jsr	ct_update		bcs	exit** Return an error if we were asked to lock a directory.*		lda	storage_type		;get storage type		cmp	#directory_stype	;directory?		bne	@ok			;no		lda	access			;get access word		ora	#read_enabled		;make sure 'read enabled' bit is set		and	#full_access		;mask off unwanted bits		cmp	#full_access		;are all the 'enabled' bits set?		beq	@ok			;yes - so ok		lda	#invalid_access		;return an error since a dir can't be locked		sec		bra	exit@ok** Indicate no error and exit.*		clc				exit		rts				ENDP		eject********************************************************************************	 Name:	get_file_info** Description:	Returns	information about an existing file or directory.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_path_ptr - pointer to pathname (if specified) in gstring format*		<dev_num - device number (if specified), else 0*		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<my_vcr_ptr - ptr to vcr**	 Uses:	all registers**   Called by:	app_entry**	Calls:	process_path*		get_cat_info** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_file_info	PROC		with	data** Find the Catalog Record and vcr for the requested file or directory.*		jsr	process_path		   		bcs	exit			** Copy information from the Catalog Record into the output parameters.*		jsr	get_cat_infoexit		rts		ENDP				eject********************************************************************************	 Name:	judge_name** Description:	Returns information about HFS filename and volume name syntax.*		Modifies name (if supplied) to conform to HFS syntax.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		name_type - type of name to judge*		name_ptr - ptr to class 1 output buffer containing name to judge *			   (0 if no name supplied)**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		max_len - maximum name length*		name_flags - results of judging**	 Uses:	all registers*		<my_path_ptr*		<temp0*		<temp1**   Called by:	app_entry**	Calls:	nothing** Copyright Apple Computer, Inc. 1991  All rights reserved.******************************************************************************judge_name	PROC		with	data** Check the name_type input parameter and set up the max_len output parameter.*		ldx	#max_filename		;get max length of filename		lda	name_type		;get name type		cmp	#1			;volume name?		bne	@0			;no		ldx	#max_volname		;get max length of volume name@0		stx	max_len			;store max length** Copy the name_ptr input parameter into <my_path_ptr.* If name_ptr = 0, then no name was supplied so we're done.*		lda	name_ptr		sta	<my_path_ptr		lda	name_ptr+2		sta	<my_path_ptr+2		ora	<my_path_ptr		beq	bra_done** Check the name buffer size to make sure the buffer is large enough to contain* the maximum size name of the specified type.  If not, return an error.*		lda	[my_path_ptr]		;get the buffer size		sec		sbc	#4			;subtract 4 for the 2 length words		bcc	@too_small		;branch if buffer size is < 4		cmp	max_len			;is the buffer big enough?		bcs	@size_ok		;yes@too_small	lda	#buff_too_small		;no - so return an error		sec		brl	exit			@size_ok		** Adjust <my_path_ptr so that it points to the length word of the name string * instead of to the buffer size word.  *		clc		lda	<my_path_ptr		;adjust ptr to point to the name length		adc	#2		sta	<my_path_ptr		lda	<my_path_ptr+2		adc	#0		sta	<my_path_ptr+2** If the name length = 0 then set the name string to "A", indicate that* there was a syntax error, and then exit.*		lda	[my_path_ptr]		;is the name length = 0?		bne	got_name		;no - so we have a name		lda	#1		sta	[my_path_ptr]		;set name length to 1		ldy	#2		lda	#'A'		sta	[my_path_ptr],y		;set name string to "A"		lda	#$2000			;set bit 13 to indicate that		tsb	name_flags		;there was a syntax errorbra_done	bra	done			;we're donegot_name** We have a name to judge.* Convert all illegal characters (colons and nuls) to periods.*		lda	[my_path_ptr]		;get length of pathname		inc	a			;adjust for extra length byte		tay		ldx	#0			;init to 0				longa	off			;set 8 bit A		sep	#$20loop1		lda	[my_path_ptr],y		;get byte		beq	@bad_char		;branch if it's a nul		cmp	#':'			;is it a colon?		bne	@ok			;no@bad_char	lda	#'.'			;it's an illegal character so		sta	[my_path_ptr],y		;replace it with a period		ldx	#$8000			;indicate illegal character found@ok		dey				;decrement offset		cpy	#1		bne	loop1			;loop until done		longa	on			;set 16 bit A		rep	#$20				txa				;set bit 15 if an illegal		tsb	name_flags		;character was found** Determine if the name is too long.* For filenames - keep the first 15 chars, insert '..', keep the last 14 chars.* For volume names - keep the first 13 chars, insert '..', keep the last 12 chars.*		lda	[my_path_ptr]		;get name length		dec	a		cmp	max_len			;is it too long?		bcc	length_ok		;no		lda	max_len			;max_len = 31 or 27		lsr	a		sta	<temp0			;temp0 <- 15 or 13		inc	a		inc	a		tay				;Y <- 17 or 15		lda	#'..'					sta	[my_path_ptr],y		;insert the '..'				iny				;adjust Y past the '..'		iny		phy				;and save		dec	<temp0			;temp0 <- 14 or 12		lda	[my_path_ptr]		;get length of name		inc	a			;add 2 because of length word		inc	a		sta	<temp1			;and save for later		sec		sbc	<temp0			;subtract 14 or 12 to get offset		tax				;to last part of name to keep				longa	off			;set 8 bit A		sep	#$20loop2		txy				;move the last 12 or 14 chars 		lda	[my_path_ptr],y		;so they are after the '..'		ply		sta	[my_path_ptr],y		iny		phy		inx		cpx	<temp1			;are we done?		bcc	loop2			;no - so loop		ply				;clean up stack				longa	on			;set 16 bit A		rep	#$20				lda	max_len			;adjust the name length		sta	[my_path_ptr]				lda	#$4000			;set bit 14 to indicate		tsb	name_flags		;name was too longlength_ok** Indicate no error and return.*done		clcexit		rts				ENDP		eject********************************************************************************	 Name:	volume** Description:	Returns information about an HFS volume.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<dev_num - device number*		<gbuf_ptr - pointer to 512 byte general purpose buffer**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		total_blocks - total number of blocks on the volume*		free_blocks - total number of free blocks on the volume*		<my_vcr_ptr - ptr to vcr**	 Uses:	all registers**   Called by:	app_entry**	Calls:	id_disk*		get_vol_info*		oh_volname** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************volume		PROC		with	data** First, ID the disk and make sure it's an HFS disk.*		lda	<dev_num		;get device # from direct page		jsr	id_disk			;ID the disk		bcs	got_error		;branch if we got an error** Setup the total_blocks and free_blocks output parameters.* 		jsr	get_vol_infoexit		rts** We got an error from id_disk.* If the error is "dup_volume" then we need to force the "volname" output parameter* to be setup even though we're returning an error.*got_error	cmp	#dup_volume		;duplicate volume error?		beq	return_volname		;yes, so return the volume name anyway		cmp	#damaged_bitmap		;was the CTree/ETree damaged?		bne	error			;no - so we're donereturn_volname		pha				; save error code (13-Nov-91 MSD)		ldy	#4			;get class 0 offset to the volname param 		lda	class			;get call class		beq	doit			;branch if doing class 0		iny				;adjust param offset for class 1		inydoit		jsr	oh_volname		;setup the volname output param		ply				; get error back, but don't change A yet						; in case there was an error (13-Nov-91 MSD)		bcs	exit			;return output buffer errors		tya				;restore the original error (13-Nov-91 MSD)error		sec				;indicate error		rts				;and exit		ENDP				eject********************************************************************************	 Name:	clear_backup** Description:	Sets information about a file/directory to indicate that the*		file/directory has been backed up.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_path_ptr - pointer to pathname (if specified) in gstring format*		<dev_num - device number (if specified), else 0*		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	process_path*		is_vol_unlocked*		ct_update** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************clear_backup	PROC		with	data		** Find the Catalog Record and vcr for the requested file or directory*		jsr	process_path		;go find the Catalog Record   		bcs	exit** If the requested file/directory is the volume directory then we're done.  *		lda	storage_type		;get storage type		cmp	#volume_stype		;is it the volume directory?		beq	done			;yes - so we're done** Make sure the volume is unlocked.*		jsr	is_vol_unlocked		;is the volume unlocked?		bcs	exit			;no - so return error** Get the modified date/time from the Catalog Record, add 1, and store in <temp0.*		ldy	#fil_mod_dt+2		;init offset for File Record		lda	record_type		;check type of Catalog Record		cmp	#cat_fil_type		;is it a File Record?		beq	cont1			;yes - so branch		ldy	#dir_mod_dt+2		;adjust offset for Directory Recordcont1				clc		lda	[a1],y			;get lo word of mod date/time		xba				;change byte sex		adc	#1			;add 1 second		sta	<temp0			;and store				dey						dey		lda	[a1],y			;get hi word of mod date/time		xba				;change byte sex		adc	#0			;add carry		sta	<temp0+2		;and store** Compare the current date/time to the modified date/time + 1.* If the current date/time is later, then store it in <temp0.*		lda	time+2			;get hi word of current date/time		cmp	<temp0+2		;compare to hi word of mod date/time		bcc	use_mod			;current date/time < mod date/time		bne	use_current		;current date/time > mod date/time		lda	time			;hi words are equal so compare lo words		cmp	<temp0					bcc	use_mod			;current date/time < mod date/timeuse_current	lda	time			;current date/time >= mod date/time		sta	<temp0			;so store current date/time in <temp0		lda	time+2		sta	<temp0+2use_mod** Set the Catalog Record's backup date/time to the value in <temp0.*		ldy	#fil_backup_dt+2	;init offset for File Record		lda	record_type		;check type of Catalog Record		cmp	#cat_fil_type		;is it a File Record?		beq	cont2			;yes - so branch		ldy	#dir_backup_dt+2	;adjust offset for Directory Recordcont2				lda	<temp0			;get lo word of new backup date/time		xba				;change byte sex		sta	[a1],y			;and store		dey						dey		lda	<temp0+2		;get hi word of new backup date/time		xba				;change byte sex		sta	[a1],y			;and store** Write the catalog node containing the record out to disk.*		lda	catalog_hint		;D2.L <- catalog hint		sta	d2		lda	catalog_hint+2		sta	d2+2		jsr	ct_update		bcs	exit** Indicate no error and exit.*done		clcexit		rts		ENDP		eject********************************************************************************	 Name:	open** Description:	Opens a file or directory.  **	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_path_ptr - pointer to pathname (if specified) in gstring format*		<dev_num - device number (if specified), else 0*		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		<temp0*		<temp1**   Called by:	app_entry**	Calls:	process_path*		get_cat_info*		build_fcr*		get_fcr			(system service)*		deref			(system service)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************open		PROC		with	data		index		equ	temp0			;local equates** Find the Catalog Record and vcr for the requested file or directory.*		jsr	process_path		  		bcc	path_ok					brl	error			path_ok** If resource_num is set, we're looking for a resource fork.* If the storage type is not 'extended file' or 'standard file', then report an error.* 		lda	resource_num		;is resource_num set?		beq	rsrc_ok			;nope - so no problem		lda	storage_type		;check the storage type		cmp	#extended_stype		;did we find an extended file?		beq	rsrc_ok			;yes - so no problem		cmp	#standard_stype		;did we find a standard file?		beq	rsrc_ok			;yes - so no problem		lda	#res_not_found		;no - so report an error		brl	errorrsrc_ok	** Are we opening a file or a directory?*		lda	record_type		;get the catalog record type		cmp	#cat_dir_type		;is it a directory?		bne	opening_file		;no - so branch** We're opening a directory. ** If 'write access' or 'read/write' is requested, then report an error.* If 'as permitted' access is requested, change it to 'read access'.*		lda	request_access		;yes - so check the requested access		and	#write_access		;is 'write' access requested?		beq	dir_ok			;no - so OK		lda	#invalid_access		;yes - so report an error		brl	error		dir_ok		lda	#read_access		;change 'as permitted' to 'read access'		sta	request_access		brl	cont		** We're opening a file.** First, loop through the existing FCRs to see if the requested fork of this file has * already been opened.   * If we find a match and it has already been opened for writing, report an error.* If we find a match and it has only been opened for reading, then check the requested* access.  If the requested access is 'write access' or 'read/write', report an error.* If the requested access is 'as permitted', change it to 'read access'.* * Next, check to see if the file is locked.  If it is and the requested access is * 'write access' or 'read/write', then report an error.* If 'as permitted' access is requested, change it to 'read/write' if the file is* unlocked or to 'read access' if the file is locked.*opening_file	stz	<index			;initialize fcr index		fcr_loop	inc	<index			;increment fcr index		lda	<index		jsl	get_fcr			;get next fcr		bcs	not_open				jsl	deref			;derefence fcr vp		stx	<my_fcr_ptr		;and store fcr ptr		sty	<my_fcr_ptr+2				ldy	#fcr_vol_id				lda	[my_fcr_ptr],y		;get volume id from fcr		cmp	[my_vcr_ptr]		;is it the correct volume?		bne	fcr_loop		;no - so loop				ldy	#fcr_type				lda	[my_fcr_ptr],y		;get fcr type		cmp	#fcr_file_type		;is the fcr for a file?		bne	fcr_loop		;no - so loop				ldy	#fcr_id		lda	[my_fcr_ptr],y		;get lo word of file ID from fcr		cmp	id			;match?		bne	fcr_loop		;no - so loop		iny		iny		lda	[my_fcr_ptr],y		;get hi word of file ID from fcr		cmp	id+2			;match?		bne	fcr_loop		;no - so loop		lda	resource_num		;are we opening the resource fork?		beq	@0			;no		lda	#rsrc_fork_bit		;yes @0		sta	<temp1			;save correct value for the compare		ldy	#fcr_access		lda	[my_fcr_ptr],y		;get access word from fcr		and	#rsrc_fork_bit		;mask off resource fork bit		cmp	<temp1			;same fork?		bne	fcr_loop		;no - so loop				ldy	#fcr_access		lda	[my_fcr_ptr],y		;get access word from fcr		and	#write_access		;is the file already opened for writing?		bne	report_busy		;yes - so report an error				lda	request_access		;get requested access		beq	open_as_perm		;branch if 'open as permitted'		and	#write_access		;is 'write' access requested?		beq	access_ok		;no - so no problemreport_busy	lda	#file_busy		;yes - so report error		bra	erroropen_as_perm	lda	#read_access		;change requested access from		sta	request_access		;'open as permitted' to 'read access'access_ok	not_open		ldy	#fil_flags		;get offset to flags field		lda	[a1],y			;get file flags byte		and	#locked_bit		;is the file locked?		tax				;save result		beq	file_ok			;no - so OK		lda	request_access		;check the requested access		and	#write_access		;is 'write' access requested?		beq	file_ok			;no - so OK		lda	#invalid_access		;yes - so report an error		bra	errorfile_ok		lda	request_access		;is the requested access 'as permitted'?		bne	cont			;no - so branch		lda	#read_write		;yes - so change request to 'read/write'		cpx	#0			;was the file locked?		beq	store_req		;no - so store new requested access		lda	#read_access		;yes - so change request to 'read access'store_req	sta	request_access		;store new requested access** If we're dealing with a class 1 call, then setup the output parameters*cont		lda	class			;get call class		beq	class0			;branch if it's a class 0 call		jsr	get_cat_info		;setup the output parametersclass0** Now build a new FCR.** Note - we need to save and restore "eof" since build_fcr may change it (if we're* opening a resource fork) causing the "eof" output parameter to be incorrect.*		lda	eof+2			;save "eof"		pha		lda	eof		pha		jsr	build_fcr		;build the fcr		plx				;restore "eof"		stx	eof		plx		stx	eof+2		bcs	error** Update the vcr's open count.*		ldy	#vcr_open_cnt		;get offset to field		lda	[my_vcr_ptr],y		;get current open count		inc	a			;increment it		sta	[my_vcr_ptr],y		;and store it** Indicate no error and exit.*		clc				  		rts				** Return an error.*error		sec				;indicate error		rts				ENDP				eject********************************************************************************	 Name:	read** Description:	Reads from an open file.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_vcr_ptr - pointer to vcr*		<my_fcr_ptr - pointer to fcr*		<data_buf_ptr - pointer to caller's data buffer*		request_count - maximum number of bytes to read**		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		<temp0*		newline_flag*		newline_mask *		newline_ptr *		newline_length *		newline_char **   Called by:	app_entry**	Calls:	ensure_file*		ensure_vol_online*		fill_block_buf*		transfer_r_data*		data_buf_read*		block_buf_read*		update_rw_info*		flush_block_buf*		calc_next_block*		update_fcr** Copyright Apple Computer, Inc. 1987-91  All rights reserved.******************************************************************************read		PROC		with	data** Zero out the transfer_count parameter so that HyperCard 1.0 will be happy if* we report an EOF error.*		ldy	#10			;get class 0 offset to transfer_count		lda	class			;get call class		beq	zeroit			;branch if doing class 0		iny				;adjust param offset for class 1		inyzeroit		lda	#0		sta	[my_pblk_ptr],y		;zero out transfer_count param		iny		iny		sta	[my_pblk_ptr],y** Make sure the fcr is for a file.*		jsr	ensure_file		;is the fcr for a file?		bcs	brl_exit		;no - so return error** Make sure the file was opened with 'read' access.*		ldy	#fcr_access				lda	[my_fcr_ptr],y		;get access word from fcr		and	#read_access		;is 'read' access allowed?		bne	access_ok		;yes - so continue		brl	access_error		;no - so return an erroraccess_ok** Exit if request count is zero.*		lda	request_count		;is request count zero?		ora	request_count+2		bne	not_zero		;no - so continuebrl_exit	brl	exit			;yes - so donenot_zero** If file_mark = eof, exit with end_of_file error.*		lda	file_mark+2		cmp	eof+2			;does file mark = eof?		bne	mark_ok			;no		lda	file_mark		cmp	eof		bne	mark_ok		brl	eof_error		;yes - so report errormark_ok** Make sure volume is online and set up <drvr_dev_num.* 		jsr	ensure_vol_online				bcs	brl_exit		;exit if vol not online** Make sure the fcr block buffer contains a block. *		jsr	fill_block_buf				bcs	brl_exit		** Clear newline_flag and get newline_mask from the fcr and save it.  * If newline is enabled, then set newline_ptr, newline_length and newline_char.*		stz	newline_flag				ldy	#fcr_mask		;get offset to mask		lda	[my_fcr_ptr],y		;get mask		sta	newline_mask		;and save it		beq	skip_newline		;branch if newline not enabled		ldy	#fcr_newline		;get offset to vp		lda	[my_fcr_ptr],y		;get lo word of vp		tax				;put in	X		iny						iny		lda	[my_fcr_ptr],y		;get hi word of vp		tay				;put in	Y		jsl	deref			;dereference the vp		stx	newline_ptr		;store the ptr		sty	newline_ptr+2		stx	<temp0			;and put ptr on direct page		sty	<temp0+2		ldy	#fcr_newline_len			lda	[my_fcr_ptr],y		;get newline length		sta	newline_length		;and save it		lda	[temp0]			;get first newline character		sta	newline_char		;and save itskip_newline** Set bytes_left = eof - file_mark.  * If bytes_left > request_count then set bytes_left = request_count.*		sec				;bytes_left = eof - file_mark			lda	eof		sbc	file_mark		sta	bytes_left		tax		lda	eof+2		sbc	file_mark+2		sta	bytes_left+2		cmp	request_count+2		;is bytes_left > request_count?		bcc	bytes_left_ok		;no		bne	set_to_request		;yes		cpx	request_count				bcc	bytes_left_ok		;noset_to_request	ldx	request_count		;set bytes_left	= request_count		lda	request_count+2		stx	bytes_left		sta	bytes_left+2bytes_left_ok** Transfer data from fcr's block buffer to caller's data buffer. * Handle newline checking.*do_transfer	jsr	transfer_r_data		;transfer data ** Update <data_buf_ptr, transfer_count, bytes_left and file_mark.* Returns with carry clear if request has been satisfied.*do_update	jsr	update_rw_info		bcc	all_done		;branch if request satisfied** We haven't satisfied the request yet.* Flush the fcr block buffer and setup the block information for the next block.*		jsr	flush_block_buf		bcs	all_done		jsr	calc_next_block** Check if newline is enabled.*		lda	newline_mask		;is newline enabled?		bne	double_buffer		;yes - so we must double buffer** Newline is disabled.  Is bytes_left >= phys_blk_size?*		lda	bytes_left+2		;bytes_left >= phys_blk_size?		bne	do_direct		;yes		lda	bytes_left		cmp	#phys_blk_size				bcc	double_buffer		;no - so we must double buffer** Newline is disabled and bytes_left >= phys_blk_size. * Read as many blocks as possible directly into caller's data buffer.* Data_buf_read marks the fcr block buffer as empty and adjusts the block information.* Branch to do_update if no error.* do_direct	jsr	data_buf_read						bcs	all_done		bra	do_update				** Either newline is enabled or bytes_left < phys_blk_size so we must double_buffer. * Read the next block into fcr's block buffer.  Branch to do_transfer if no error.* double_buffer	jsr	block_buf_read				bcc	do_transfer				** Either we've satisfied the read request or we got an error during the read.* Save the error code (if any) and the state of the carry flag.*all_done	php				;save carry flag		pha				;save error code ** Update the fcr with the current file mark and block buffer information. *		jsr	update_fcr		** Retrieve error code (if any), retrieve carry flag, and exit.*		pla				;retrieve error code		plp				;retrieve carry flag		exit 		rts				;exit** Report an end_of_file error.*eof_error	lda	#end_of_file		;get error code 		sec				;indicate error		rts				;exit** Report an invalid_access error.*access_error	lda	#invalid_access		;get error code		sec				;indicate error		rts				;exit		ENDP				eject********************************************************************************	 Name:	write** Description:	Writes to an open file.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_vcr_ptr - pointer to vcr*		<my_fcr_ptr - pointer to fcr*		<data_buf_ptr - pointer to caller's data buffer*		request_count - maximum number of bytes to read**		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		<temp0*		eof**   Called by:	app_entry**	Calls:	ensure_file*		is_vol_unlocked*		check_access*		ensure_vol_online*		grow_file*		fill_block_buf*		transfer_w_data*		update_dirty_bit*		data_buf_write*		block_buf_read*		update_rw_info*		flush_block_buf*		calc_next_block*		update_fcr** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************write		PROC		with	data** First, make sure the fcr is for a file.*		jsr	ensure_file		;is the fcr for a file?		bcs	brl_exit		;no - so return error** Make sure the file was opened with 'write' access.*		jsr	check_access		;do we have 'write' access?		bcs	brl_exit		;no - so return error** Exit if request count is zero.*		lda	request_count		;is request count zero?		ora	request_count+2		bne	not_zero		;no - so continuebrl_exit	brl	exit			;yes - so donenot_zero** Make sure volume is online and set up <drvr_dev_num.* 		jsr	ensure_vol_online				bcs	brl_exit		;exit if vol not online** Make sure the volume is unlocked.*		jsr	is_vol_unlocked		;is the volume unlocked?		bcs	brl_exit		;no - so return error** Add the request count to the current file mark and store in <temp0.* This value is what the file mark will be at the end of the write.*		clc		lda	file_mark		adc	request_count		sta	<temp0		lda	file_mark+2		adc	request_count+2		sta	<temp0+2** If the current logical eof is >= temp0 then we're OK so do the write.* Otherwise, we need to lengthen the logical eof.*		lda	eof+2			;is the logical eof big enough?		cmp	<temp0+2		bcc	leof_too_small		;no		bne	cont			;yes		lda	eof		cmp	<temp0		bcs	cont			;yesleof_too_small	lda	<temp0			;no - so lengthen the logical eof		 		sta	eof		lda	<temp0+2		sta	eof+2** Get the current physical eof and store in <temp0.*		ldy	#fcr_peof		lda	[my_fcr_ptr],y		sta	<temp0		iny		iny		lda	[my_fcr_ptr],y		sta	<temp0+2** The logical eof was lengthened so now we need to determine if the physical eof* also needs to be lengthened.* If the current physical eof is >= the new logical eof then we're OK.* Otherwise, we need to lengthen the physical eof.* When we get here, eof = new logical eof, <temp0 = current physical eof.* 		lda	<temp0+2		;is the physical eof big enough?		cmp	eof+2		bcc	peof_too_small		;no		bne	peof_ok			;yes		lda	<temp0		cmp	eof		bcs	peof_ok			;yes** If we get here, the physical eof needs to be lengthened.* We need to call et_extend_file, update the fcr_leof field, update the* fcr block buffer information, and mark the fcr dirty.* We'll just JSR into the SET_EOF routine since it does what we need.*peof_too_small	jsr	grow_file		;lengthen the file		bcs	exit		bra	cont			;and continue** If we get here, the physical eof is OK but the logical eof was lengthened.* Copy the new logical eof into the fcr and mark the fcr and file dirty.*peof_ok		ldy	#fcr_leof		lda	eof		sta	[my_fcr_ptr],y		iny		iny		lda	eof+2		sta	[my_fcr_ptr],y		ldy	#fcr_flags		lda	[my_fcr_ptr],y		ora	#fcr_dirty_bit+file_dirty_bit		sta	[my_fcr_ptr],y** Set bytes_left = request_count.*cont		ldx	request_count				lda	request_count+2		stx	bytes_left		sta	bytes_left+2** Make sure the fcr block buffer contains a block. *		jsr	fill_block_buf				bcs	exit** Transfer data from caller's data buffer to fcr's block buffer. * Mark the block buffer as dirty.*do_transfer	jsr	transfer_w_data				sec		jsr	update_dirty_bit** Update <data_buf_ptr, transfer_count, bytes_left and file_mark.* Returns with carry clear if request has been satisfied.*do_update*** added 18-Jul-92 DAL -- Fixes problem where we stopped writing after 512*** bytes if we the most recent Read call stopped by hitting a newline char.		stz	newline_flag*** end 18-Jul-92		jsr	update_rw_info		bcc	all_done		;branch if request satisfied** We haven't satisfied the request yet.* Flush the fcr block buffer and setup the block information for the next block.*		jsr	flush_block_buf		bcs	all_done		jsr	calc_next_block** Is bytes_left >= phys_blk_size?*		lda	bytes_left+2		;bytes_left >= phys_blk_size?		bne	do_direct		;yes		lda	bytes_left		cmp	#phys_blk_size				bcc	double_buffer		;no - so we must double buffer** Bytes_left >= phys_blk_size. * Write as many blocks as possible directly from caller's data buffer.* Data_buf_write marks the fcr block buffer as empty and adjusts the block information.* Branch to do_update if no error.* do_direct	jsr	data_buf_write						bcs	all_done		bra	do_update				** Bytes_left < phys_blk_size so we must double_buffer. * Read the next block into fcr's block buffer.  Branch to do_transfer if no error.* double_buffer	jsr	block_buf_read				bcc	do_transfer				** Either we've satisfied the write request or we got an error during the write.* Save the error code (if any) and the state of the carry flag.*all_done	php				;save carry flag		pha				;save error code ** Update the fcr with the current file mark and block buffer information. *		jsr	update_fcr** Mark the file dirty.*		ldy	#fcr_flags		lda	[my_fcr_ptr],y		ora	#file_dirty_bit		sta	[my_fcr_ptr],y** Retrieve error code (if any), retrieve carry flag, and exit.*		pla				;retrieve error code		plp				;retrieve carry flag		exit 		rts				;exit		ENDP		eject********************************************************************************	 Name:	close** Description:	Closes an open file or directory.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_vcr_ptr - pointer to vcr*		<my_fcr_ptr - pointer to fcr**		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	ensure_vol_online*		is_vol_unlocked*		et_trunc_file*		flush_file*		release_fcr		(system service)*		sys_death		(system service)** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************close		PROC		with	data			** Check the fcr type. * If the fcr is for a BTree then return an error.* If the fcr is for a directory then skip over the file stuff.*		lda	type			;get fcr type		cmp	#fcr_tree_type		;is this fcr for a tree?		bne	not_tree		;no 		lda	#bad_store_type		;yes - so return an error		sec		bra	exit		not_tree	cmp	#fcr_dir_type		;is this fcr for a directory?		beq	release_it		;yes - so skip file stuff** The fcr is for a file.* Check to see if we need to truncate to the physical eof.  * Note - the truncate_bit is set whenever the physical eof is changed.*		ldy	#fcr_flags		lda	[my_fcr_ptr],y		;get fcr flags		and	#truncate_bit		;do we need to truncate to peof?		beq	do_flush		;no ** Make sure volume is online and set up <drvr_dev_num.* 		jsr	ensure_vol_online				bcs	exit			;exit if vol not online** Make sure the volume is unlocked.*		jsr	is_vol_unlocked		;is the volume unlocked?		bcs	exit			;no - so return error** Truncate the file to its physical eof.* Note - et_trunc_file may update the fcr_ext field.*		ldy	#fcr_peof		;D3.L <- physical eof			lda	[my_fcr_ptr],y					sta	d3		iny		iny		lda	[my_fcr_ptr],y					sta	d3+2				stz	d2			;D2.W <- truncate to the physical eof				lda	<my_fcr_ptr		;A2.L <- ptr to fcr		sta	<a2		lda	<my_fcr_ptr+2		sta	<a2+2		jsr	et_trunc_file		;truncate the file		bcs	exit		ldy	#fcr_flags		;mark the fcr and file dirty		lda	[my_fcr_ptr],y		ora	#fcr_dirty_bit+file_dirty_bit		sta	[my_fcr_ptr],y** Flush the file.*do_flush	jsr	flush_file		bcs	exit** Release the FCR.*release_it	lda	[my_fcr_ptr]		;get reference #		jsl	release_fcr		;release fcr** Decrement VCR	open count.  Error if open count = 0 before we decrement it.*		ldy	#vcr_open_cnt		;get offset to open count		lda	[my_vcr_ptr],y		;get open count		beq	bad_vcr			;it's already 0, we're in deep trouble!		dec	a			;decrement it		sta	[my_vcr_ptr],y		;save it** Indicate no error and exit.*done 		clc								exit		rts			** Something's terribly wrong here.*bad_vcr		lda	#$000A			;get error code	for bad	VCR		jml	>sys_death		;die		ENDP				eject********************************************************************************	 Name:	flush** Description:	Flushes an open file or directory.**	 Note:	This routine contains an alternate entry point (flush_file) *		which is called by CLOSE.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_vcr_ptr - pointer to vcr*		<my_fcr_ptr - pointer to fcr*		flush_type - $0000 = slow flush, $8000 = fast flush**		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	app_entry*		close		(calls alternate entry point)**	Calls:	ensure_vol_online*		is_vol_unlocked*		flush_block_buf*		get_fcr_name*		ct_get_rec*		ct_update*		copy_long*		copy_ext** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************flush		PROC		with	data		** Check the fcr type. * If the fcr is for a BTree then return an error.* If the fcr is for a directory then return with no error since nothing to do.*		lda	type			;get fcr type		cmp	#fcr_tree_type		;is this fcr for a tree?		bne	not_tree		;no 		lda	#bad_store_type		;yes - so return an error		secbrl_exit	brl	exit		not_tree	cmp	#fcr_dir_type		;is this fcr for a directory?		bne	not_dir			;nobrl_done	brl	done			;yes - so we're donenot_dir** Alternate entry point called by CLOSE.*		EXPORT	flush_fileflush_file	** The fcr is for a file.* Check to see if the file is dirty.  If it isn't then we're done.* Note - the file_dirty_bit is set by the Write, SetEof and Close routines.*		ldy	#fcr_flags		lda	[my_fcr_ptr],y		;get fcr flags		and	#file_dirty_bit		;is the file dirty?		beq	brl_done		;no - so we're done** Make sure volume is online and set up <drvr_dev_num.* 		jsr	ensure_vol_online				bcs	brl_exit		;exit if vol not online** Make sure the volume is unlocked.*		jsr	is_vol_unlocked		;is the volume unlocked?		bcs	brl_exit		;no - so return error** If the fcr block buffer is dirty, flush it and mark it clean.*		jsr	flush_block_buf		;flush the fcr block buffer		bcs	brl_exit** Check to see if the fcr is dirty.  * If it is, then we have to update the file's Catalog Record.*		ldy	#fcr_flags		lda	[my_fcr_ptr],y		;get fcr flags		and	#fcr_dirty_bit		;is the fcr dirty?		bne	fcr_dirty		;yes ** The fcr is clean so check to see if we're doing a fast or slow flush.* If the user has requested a fast flush then we're done.* If we're doing a slow flush then we need to update the modified date/time in the* file's Catalog Record.*		lda	flush_type		;get the flush type		bne	brl_done		;fast flush requested so we're done** If we get here, either the fcr is dirty or the fcr is clean but we're doing a slow flush.* Update the modified date/time in the fcr.*fcr_dirty	ldy	#fcr_mod_dt		lda	time		sta	[my_fcr_ptr],y		iny		iny		lda	time+2		sta	[my_fcr_ptr],y** Find the Catalog Record for the file.*		jsr	get_fcr_name		;get the filename out of the fcr		 		lda	#record_name		;A0.L <- ptr to name		sta	<a0		lda	#^record_name		sta	<a0+2				ldy	#fcr_parent_id		lda	[my_fcr_ptr],y		;D0.L <- parent ID		sta	d0		iny		iny		lda	[my_fcr_ptr],y		sta	d0+2				ldy	#fcr_cat_hint		lda	[my_fcr_ptr],y		;D2.L <- catalog hint 		sta	d2		iny		iny		lda	[my_fcr_ptr],y				sta	d2+2		 		jsr	ct_get_rec		;get the Catalog Record		bcs	exit** Copy the new modified date/time from the fcr to the Catalog Record.*		lda	<my_fcr_ptr		;setup source ptr		sta	<source_ptr		lda	<my_fcr_ptr+2		sta	<source_ptr+2				lda	<a1			;setup destination ptr		sta	<dest_ptr		lda	<a1+2		sta	<dest_ptr+2				ldy	#fcr_mod_dt		;get starting source offset		ldx	#fil_mod_dt		;get starting dest offset		jsr	copy_long		;copy mod_dt** If the fcr is dirty then copy the leof, peof and ext from the fcr to the Catalog Record.*		ldy	#fcr_flags		lda	[my_fcr_ptr],y		;get fcr flags		and	#fcr_dirty_bit		;is the fcr dirty?		beq	not_dirty		;no - so no need to copy this stuff  		ldy	#fcr_access		lda	[my_fcr_ptr],y		;get access word from fcr		and	#rsrc_fork_bit		;we only want the rsrc fork bit 		pha				;save it				ldy	#fcr_leof		;get starting source offset		ldx	#fil_data_leof		;get starting dest offset		lda	1,s			;is the fcr for a resource fork?		beq	@cont1			;no - so branch		ldx	#fil_rsrc_leof		;yes - so adjust dest offset@cont1		jsr	copy_long		;copy leof		jsr	copy_long		;copy peof				ldy	#fcr_ext		;get starting source offset		ldx	#fil_data_ext		;get starting dest offset		lda	1,s			;is the fcr for a resource fork?		beq	@cont2			;no - so continue		ldx	#fil_rsrc_ext		;yes - so adjust dest offset@cont2		jsr	copy_ext		;copy ext (6 words)				pla				;clean up stacknot_dirty** Write the catalog node containing the record out to disk.* Note - D2.L contains the catalog hint from the ct_get_rec call.*		jsr	ct_update		bcs	exit** Mark the fcr and file clean.*		ldy	#fcr_flags		lda	[my_fcr_ptr],y		and	#fcr_dirty_mask		and	#file_dirty_mask		sta	[my_fcr_ptr],y** Indicate no error and exit.*done 		clc								exit		rts					ENDP		eject*********************************************************************************	 Name:	set_mark** Description:	Sets the current file mark for an open file.	 *		Marks the fcr block buffer as empty if the block # changes. **	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_vcr_ptr - pointer to vcr*		<my_fcr_ptr - pointer to fcr*		base - 	0: mark = displacement*			1: mark = eof - displacement*			2: mark = mark + displacement*			3: mark = mark - displacement*		displacement - offset or absolute value**		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 =	error*			   0 =	no error*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	ensure_file*		ensure_vol_online*		do_displacement*		update_block_buf*		update_fcr** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************set_mark	PROC		with	data** First, make sure the fcr is for a file.*		jsr	ensure_file		;is the fcr for a file?		bcs	exit			;no - so return error** Calculate the new file mark according to the 'base' and 'displacement' inputs.* Return the new file mark in X (lo word) and Y (hi word).*		jsr	do_displacement		bcs	exit** If the new file mark matches the current file mark then we're done.*		cpy	file_mark+2		;does hi word match current mark?		bne	no_match		;no		cpx	file_mark		;yes - does lo word match current mark?		beq	done			;yes, so we're doneno_match** If the new mark is past the current eof then report an out of range error.*		cpy	eof+2			;is new mark past eof?		bcc	in_range		;no		bne	bad_range		;yes		cpx	eof		beq	in_range		;no		bcs	bad_range		;yesin_range** New mark is ok so save it.* 		stx	file_mark		sty	file_mark+2** Make sure volume is online and set up <drvr_dev_num.* 		jsr	ensure_vol_online				bcs	exit			;exit if vol not online** Update the fcr block buffer since the file mark has changed.* 		jsr	update_block_buf		bcs	exit** Copy the new file mark and block information into the fcr.*		jsr	update_fcr		** Indicate no error and exit.*done		clc				exit 		rts				** Report an out of range error.*bad_range	lda	#out_of_range		;get error code 		sec				 		rts						ENDP				eject********************************************************************************	 Name:	get_mark** Description:	Gets the current file mark for an open file.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_fcr_ptr - pointer to fcr**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	ensure_file** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_mark	PROC		with	data** Make sure the fcr is for a file.*		jsr	ensure_file		;is the fcr for a file? 		rts		ENDP				eject********************************************************************************	 Name:	set_eof** Description:	Sets the logical eof for an open file.**	 Note:	This routine contains an alternate entry point (grow_file) *		which is called by WRITE.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_vcr_ptr - pointer to vcr*		<my_fcr_ptr - pointer to fcr*		base - 	0: eof = displacement*			1: eof = eof - displacement*			2: eof = mark + displacement*			3: eof = mark - displacement*		displacement - offset**		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		<temp0*		<source_ptr	(aka <product)*		<dest_ptr	*		eof**   Called by:	app_entry*		write		(calls alternate entry point)**	Calls:	ensure_file*		ensure_vol_online*		is_vol_unlocked*		check_access*		do_displacement*		et_extend_file*		et_trunc_file*		flush_block_buf*		update_block_buf*		update_fcr** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************set_eof		PROC		with	data		** First, make sure the fcr is for a file.*		jsr	ensure_file		;is the fcr for a file?		bcs	brl_exit		;no - so return error** Make sure the file was opened with 'write' access.*		jsr	check_access		;do we have 'write' access?		bcs	brl_exit		;no - so return error** Calculate the new logical eof according to the 'base' and 'displacement' inputs.* Return the new eof in X (lo word) and Y (hi word).*		jsr	do_displacement		bcs	brl_exit** If the new logical eof = current logical eof then we're done.*		cpy	eof+2			;does hi word match current eof?		bne	no_match		;no		cpx	eof			;yes - does lo word match current eof?		bne	no_match		;no		brl	done			;yes - so we're doneno_match** Save new logical eof.*		stx	eof		sty	eof+2** Make sure volume is online and set up <drvr_dev_num.* 		jsr	ensure_vol_online				bcs	brl_exit		;exit if vol not online** Make sure the volume is unlocked.*		jsr	is_vol_unlocked		;is the volume unlocked?		bcs	brl_exit		;no - so return error** Get current physical eof.*		ldy	#fcr_peof		lda	[my_fcr_ptr],y		sta	<temp0		iny		iny		lda	[my_fcr_ptr],y		sta	<temp0+2** If new logical eof is > current physical eof then we need to extend the file.* If new logical eof is < current physical eof then we may be able to truncate the file.* If new logical eof = current physical eof then we don't need to change the file length.*		lda	eof+2		cmp	<temp0+2		bcc	shrink_file		;new logical eof is < current physical eof		bne	grow_file		;new logical eof is > current physical eof		lda	eof		cmp	<temp0		bcc	shrink_file		;new logical eof is < current physical eof		bne	grow_file		;new logical eof is > current physical eof		beq	peof_ok			;new logical eof = current physical eof** The new logical eof is < current physical eof so we may be able to truncate the file.* If the new logical eof is < the current file mark then the file mark is adjusted.* Note - et_trunc_file updates the fcr_peof field and possibly the fcr_ext field.*shrink_file	jsr	flush_block_buf		;first, flush the block buffer 		bcs	brl_exit				lda	eof			;D3.L <- new physical eof		sta	d3		lda	eof+2		sta	d3+2				lda	#1			;D2.W <- truncate to the end of the extent  		sta	d2			;containing the new physical eof				lda	<my_fcr_ptr		;A2.L <- ptr to fcr		sta	<a2		lda	<my_fcr_ptr+2		sta	<a2+2		jsr	et_trunc_file		;attempt to truncate the file		bcc	truncate_okbrl_exit	brl	exittruncate_ok		lda	file_mark+2		;is current file mark < new logical eof?		cmp	eof+2		bcc	mark_ok			;yes - so ok		lda	file_mark		cmp	eof		bcc	mark_ok			;yes - so ok		lda	eof			;no - so file mark <- new logical eof		sta	file_mark		lda	eof+2		sta	file_mark+2mark_ok				bra	set_bit** The new logical eof is > current physical eof so we need to extend the file.* Note - et_extend_file updates the fcr_peof field and possibly the fcr_ext field.** Alternate entry point called by WRITE.*		EXPORT	grow_file		grow_file	sec				;D4.L <- # of additional bytes needed		lda	eof		sbc	<temp0		sta	d4		lda	eof+2		sbc	<temp0+2		sta	d4+2				lda	#1			;D3.W <- allocate all requested bytes		sta	d3				lda	<my_fcr_ptr		;A2.L <- ptr to fcr		sta	<a2		lda	<my_fcr_ptr+2		sta	<a2+2		jsr	et_extend_file		;attempt to extend the file		bcs	exit** The fcr_peof field has been modified so set the truncate_bit to indicate that* the CLOSE call should truncate the file to the new physical eof.*set_bit		ldy	#fcr_flags		lda	[my_fcr_ptr],y		;get the flags word		ora	#truncate_bit		;set the bit		sta	[my_fcr_ptr],y		;and store** Copy the new logical eof into the fcr.*peof_ok		ldy	#fcr_leof		lda	eof		sta	[my_fcr_ptr],y		iny		iny		lda	eof+2		sta	[my_fcr_ptr],y** Mark the fcr and file dirty.*		ldy	#fcr_flags		lda	[my_fcr_ptr],y		ora	#fcr_dirty_bit+file_dirty_bit		sta	[my_fcr_ptr],y** Update the fcr block buffer since the file mark and/or block count may have changed.*		jsr	update_block_buf		bcs	exit** Copy the new file mark and block information into the fcr.*		jsr	update_fcr** Indicate no error and exit.*done		clcexit		rts		ENDP		eject********************************************************************************	 Name:	get_eof** Description:	Gets the logical eof of an open file.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_fcr_ptr - pointer to fcr**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	ensure_file** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_eof		PROC		with	data** Make sure the fcr is for a file.*		jsr	ensure_file		;is the fcr for a file? 		rts		ENDP				eject********************************************************************************	 Name:	get_dir_entry** Description:	Returns information about a directory entry.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_vcr_ptr - ptr to vcr*		<my_fcr_ptr - ptr to fcr*		base - 	0: entry_num = displacement*			1: entry_num = entry_num+displacement*			2: entry_num = entry_num-displacement*		displacement - absolute entry number or offset**		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		entry_num - entry number returned**	 Uses:	all registers**   Called by:	app_entry**	Calls:	ensure_vol_online*		ct_get_rec*		ct_get_dir_kid*		get_cat_info*		get_record_name*		get_storage_type*		get_fcr_name** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************get_dir_entry	PROC		with	data** First, check the fcr type and return an error if the fcr isn't for a directory.*		lda	type			;get fcr type		cmp	#fcr_dir_type		;is this fcr for a directory?		beq	ok			;yes - so ok		lda	#version_error		;no - so return an error		secbrl_exit	brl	exitok** Make sure volume is online and set up <drvr_dev_num.* 		jsr	ensure_vol_online				bcs	brl_exit		;exit if vol not online** If the 'current dir ID' in the vcr is not the same as the 'dir ID' this call is for, * then we need to update fcr_valence. Since offspring can be created and destroyed * while the parent directory is open, fcr_valence may no longer match the valence in* the directory's Catalog Record. * NOTE - vcr_cur_dir is only set by ct_get_dir_kid. It's cleared by ct_create_rec,* ct_delete_rec, ct_move_rec, ct_rename_rec and ct_get_rec. So, if it doesn't match* the dir ID we're dealing with, then it's a clue that something may have changed in* the directory. * IMPORTANT - We don't want to automatically update fcr_valence every time through* this call because the 'jsr ct_get_rec' causes vcr_cur_dir to be cleared which then* causes ct_get_dir_kid to have to re-find the directory's thread record. As a* result, this call ends up being extremely slow.*	 	ldy	#fcr_id			;temp0 <- dir ID		lda	[my_fcr_ptr],y				sta	<temp0		iny		iny		lda	[my_fcr_ptr],y				sta	<temp0+2				ldy	#vcr_cur_dir				lda	[my_vcr_ptr],y		;does the current dir ID 		cmp	<temp0			;match the dir ID this call is for?		bne	@get_valence		;no - so need to update fcr_valence		iny		iny		lda	[my_vcr_ptr],y		cmp	<temp0+2		beq	@valence_ok		;yes - so fcr_valence is OK		@get_valence	jsr	get_fcr_name		;get the filename out of the fcr		 		lda	#record_name		;A0.L <- ptr to name		sta	<a0		lda	#^record_name		sta	<a0+2				ldy	#fcr_parent_id		lda	[my_fcr_ptr],y		;D0.L <- parent ID		sta	d0		iny		iny		lda	[my_fcr_ptr],y		sta	d0+2				ldy	#fcr_cat_hint		;D2.L <- catalog hint		lda	[my_fcr_ptr],y				sta	d2		iny		iny		lda	[my_fcr_ptr],y				sta	d2+2				jsr	ct_get_rec		;get the Catalog Record for the dir		bcs	brl_exit				ldy	#dir_valence		;get the current valence from the Cat rec		lda	[a1],y		xba		ldy	#fcr_valence		sta	[my_fcr_ptr],y		;and store in the fcr@valence_ok** Get current offspring index.*		ldy	#fcr_cur_kid		lda	[my_fcr_ptr],y		;get current offspring index		sta	entry_num		;save it** If the current offspring index is greater than the valence then clamp it to the valence.*		ldy	#fcr_valence		lda	[my_fcr_ptr],y		;get current valence		cmp	entry_num		;is the offspring index > valence?		bcs	index_ok		;no		ldy	#fcr_cur_kid		;yes - so clamp the offspring index		sta	[my_fcr_ptr],y		;to the valence		sta	entry_numindex_ok		** Branch to correct calculation	routine.*		ldx	base			;Get base. Is it 0?		beq	base_0			;yes		dex				;no - is it 1?		beq	base_1			;yes** Set entry_num	= entry_num - displacement.*base_2		sec						lda	entry_num		;get current offspring index		sbc	displacement		;subtract the displacement		bcs	save_it			;continue		brl	dir_end			;oops, went too far back** Set entry_num	= entry_num + displacement.*base_1		clc						lda	entry_num		;get current offspring index		adc	displacement		;add the displacement		bcc	save_it			;continue		bra	dir_end			;oops, overflow** Set entry_num	= displacement.	 * If displacement = 0 then it's a special call.*base_0		lda	displacement		;get displacement		bne	save_it			;continue if displacement <> 0** Both base and	displacement are 0. * Set entry_num to the number of offspring in the directory.* Then reset the current offspring index (in the fcr) to 0.*		ldy	#fcr_valence		lda	[my_fcr_ptr],y		;get # of offspring in the directory		sta	entry_num		;and store in entry_num				ldy	#fcr_cur_kid		lda	#0		sta	[my_fcr_ptr],y		;reset current offspring index to 0				bra	done			;we're done		** We're doing a normal call. Store the new offspring index in entry_num.* If the offspring index = 0 then return an error.* If the offspring index > the dir valence then return an error.* If offspring index is OK, then get the Catalog Record for the requested offspring.* Also, setup parent_id since it's needed later.*save_it		beq	dir_end			;if offspring index = 0 then return error		sta	entry_num		;save new offspring index		sta	d1			;D1.W <- offspring index		ldy	#fcr_valence		lda	[my_fcr_ptr],y		;get # of offspring in the directory		cmp	entry_num		;is the offspring index too big?		bcc	dir_end			;yes - so return an error				ldy	#fcr_id			;D0.L <- dir ID		lda	[my_fcr_ptr],y				sta	d0		sta	parent_id		;setup parent_id for later		iny		iny		lda	[my_fcr_ptr],y				sta	d0+2		sta	parent_id+2				jsr	ct_get_dir_kid		;get Catalog Record		bcs	exit	** Update the current offspring index in the fcr.*		ldy	#fcr_cur_kid		 		lda	entry_num		;get current offspring index		sta	[my_fcr_ptr],y		;and store in fcr** Get the Catalog Record type and save*		ldy	#cat_type		;get offset to Catalog Record type		lda	[a1],y			;get record type		sta	record_type		;and save** Get the storage type of the Catalog Record and save*		jsr	get_storage_type** Setup the extended_flag output parameter*		lda	storage_type		;get storage type		cmp	#extended_stype		;is it 'extended'?		bne	skip_ext_flag		;no - so branch		lda	#extended_bit		;yes - so set the 'extended bit'		sta	extended_flag		;in the extended_flag output parameterskip_ext_flag** Copy offspring's name from the Catalog Key Record into record_name	*		jsr	get_record_name** Setup the rest of the output parameters. * Note - call class must be forced to 1 so that create_date_time, mod_date_time, eof and* blocks_used are setup correctly.*		lda	class			;get current call class		pha				;and save it		lda	#1			;force call class to 1		sta	class		jsr	get_cat_info		;setup the output params				pla				;restore call class		sta	classdone		clc				;indicate no errorexit		rts** Return an 'end of directory' error.*dir_end		lda	#end_of_dir		;get error code 		sec				;indicate error 		rts							ENDP				eject********************************************************************************	 Name:	get_dev_num** Description:	Returns the device number of a specified device or volume.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<my_path_ptr - pointer to pathname (if specified) in gstring format*		<dev_num - device number (if specified), else 0*		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		dev_number - device number**	 Uses:	all registers**   Called by:	app_entry**	Calls:	process_path** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************get_dev_num	PROC		with	data** Did we get passed a device number?*		lda	<dev_num		;do we have a device #?		bne	got_it			;yes** No, so use the volume	name to	find it.*		inc	doing_gdn		;tell process_path not to walk catalog (29-Oct-91 MSD)		jsr	process_path		;Look for the volume. Did we find it?		bcs	exit			;no		lda	<drvr_dev_num		;yes, so get device number** Save device number and exit.*got_it		sta	dev_number		;store device number in output parameter		clc				;indicate no errorexit 		rts								ENDP				eject********************************************************************************	 Name:	format** Description:	Formats a volume.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<dev_num - device number *		input_error - error code from get_input**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	parse_path2*		hfs_init*		swap_out		(system service)*		dev_dispatcher		(system service)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************format		PROC		with	data		** If input_error is non-zero then exit with input_error.*		lda	input_error		;was there an input error?		bne	error			;yes - so return the error** Parse the pathname.*		 		jsr	parse_path2		bcs	error		** The pathname must consist of only 1 name.*		lda	name_count				cmp	#1			;does pathname have only 1 name?		bne	bad_path		;no - so report error** Setup <drvr_dev_num and mark any VCRs for this device as offline.*		lda	<dev_num		;copy device # 		sta	<drvr_dev_num		;onto driver direct page		jsl	swap_out		;mark vcrs for this device as offline** Issue a hard format call to the device.*do_format	lda	#drvr_control		;call # = control call		sta	<drvr_call_num				lda	#drvr_format		;control code = format device		sta	<drvr_ctrl_code				stz	<drvr_clist_ptr		;control list is not used		stz	<drvr_clist_ptr+2				stz	<drvr_req_cnt		;request count is not used		stz	<drvr_req_cnt+2		jsl	dev_dispatcher		;do the call		bcc	format_ok		cmp	#drvr_disk_sw		;did we get a disk switched error?		beq	do_format		;yes - so try again		bra	error			;no - so return errorformat_ok** Tell the driver what name to store in the device partition map.*		lda	#drvr_control		;call # = control call		sta	<drvr_call_num				lda	#drvr_set_ptn		;control code = assign partition owner		sta	<drvr_ctrl_code				lda	#control_list		;setup ptr to control list		sta	<drvr_clist_ptr				lda	#^control_list		sta	<drvr_clist_ptr+2				stz	<drvr_req_cnt		;request count is not used		stz	<drvr_req_cnt+2		jsl	dev_dispatcher		;do the call** Write out an initial HFS volume structure.*		jsr	hfs_init		bcs	error** Indicate no error and exit.*		clc 		rts** Return an error.*bad_path	lda	#bad_path_syntax	;get error codeerror 		sec				;indicate error		rts		ENDP		eject********************************************************************************	 Name:	erase_disk** Description:	Erases a volume.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - pointer to 512 byte general purpose buffer*		<dev_num - device number *		input_error - error code from get_input**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	parse_path2*		hfs_init*		swap_out		(system service)*		dev_dispatcher		(system service)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************erase_disk	PROC		with	data		** If input_error is non-zero then exit with input_error.*		lda	input_error		;was there an input error?		bne	error			;yes - so return the error** Parse the pathname.*		 		jsr	parse_path2		bcs	error		** The pathname must consist of only 1 name.*		lda	name_count				cmp	#1			;does pathname have only 1 name?		bne	bad_path		;no - so report error** Setup <drvr_dev_num and mark any VCRs for this device as offline.*		lda	<dev_num		;copy device # 		sta	<drvr_dev_num		;onto driver direct page		jsl	swap_out		;mark vcrs for this device as offline** Tell the driver what name to store in the device partition map.*		lda	#drvr_control		;call # = control call		sta	<drvr_call_num				lda	#drvr_set_ptn		;control code = assign partition owner		sta	<drvr_ctrl_code				lda	#control_list		;setup ptr to control list		sta	<drvr_clist_ptr				lda	#^control_list		sta	<drvr_clist_ptr+2				stz	<drvr_req_cnt		;request count is not used		stz	<drvr_req_cnt+2		jsl	dev_dispatcher		;do the call** Write out an initial HFS volume structure.*		jsr	hfs_init		bcs	error** Indicate no error and exit.*		clcexit		rts** Return an error.*bad_path	lda	#bad_path_syntax	;get error codeerror 		sec				;indicate error		rts		ENDP		eject********************************************************************************	 Name:	fst_specific		**		@@@ this routine is currently not called since fst_specific *		    commands are not supported** Description:	This routine is	a dispatcher for the fst_specific calls.  It*		uses command_num to dispatch to	the correct routine.**	 Note:  These routines do not use send_output to return*		parameters, but do it themselves.**	Entry:	jsr**	 Exit:	jmp**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		command_num - command number**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**	 Uses:	all registers**   Called by:	app_entry**	Calls:	nothing** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************;;fst_specific	PROC;		with	data;;*;* Dispatch to the selected routine.;*;		lda	command_num		;get command number;		asl	a			;multiply by 2;		tax				;use as	index;		jmp	(fst_tbl,x)		;jump to command handler;;		ENDP				eject********************************************************************************	 Name:	parse_path1** Description:	Validates pathname1, then copies first name in path to volname*		(in gstring format). Sets name_count to # of names found. *		If there is only a device #, will exit with name_count = 0.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<path_flag - indicates if path1_ptr is valid*		<path1_ptr - pointer to pathname1 in gstring format*			     if <dev2_num = 0, then pathname1 begins with a volume name*			     if <dev2_num <> 0, then pathname1 has no volume name*		<dev1_num - device number if specified, else 0*		<span1 - maximum span of pathname1**      Output:	A = undefined or error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<my_path_ptr - pointer to pathname in gstring format*			     if x_dev_num = 0, then pathname begins with a volume name*			     if x_dev_num <> 0, then pathname has no volume name*		x_path_flag - indicates if my_path_ptr is valid*		x_dev_num - device number if specified, else 0*		x_span - contains maximum span of pathname*		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)**	 Uses:	all registers**   Called by:	setup_call**	Calls:	parse_path** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************parse_path1	PROC		with	data		lda	<path_flag		;get pathname flags		and	#path1_bit		;only want pathname 1 bit		sta	x_path_flag		;save it		lda	<path1_ptr		;get ptr to pathname1		sta	<my_path_ptr		;and save		lda	<path1_ptr+2		sta	<my_path_ptr+2				lda	<span1			;get maximum span of pathname1		sta	x_span			;and save		lda	<dev1_num		;get device #		sta	x_dev_num		;and save 				jsr	parse_path		rts				ENDP		eject********************************************************************************	 Name:	parse_path2** Description:	Validates pathname2, then copies first name in path to volname*		(in gstring format). Sets name_count to # of names found. *		If there is only a device #, will exit with name_count = 0.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<path_flag - indicates if path2_ptr is valid*		<path2_ptr - pointer to pathname2 in gstring format*			     if <dev2_num = 0, then pathname2 begins with a volume name*			     if <dev2_num <> 0, then pathname2 has no volume name*		<dev2_num - device number if specified, else 0*		<span2 - maximum span of pathname2**      Output:	A = undefined or error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<my_path_ptr - pointer to pathname in gstring format*			     if x_dev_num = 0, then pathname begins with a volume name*			     if x_dev_num <> 0, then pathname has no volume name*		x_path_flag - indicates if my_path_ptr is valid*		x_dev_num - device number if specified, else 0*		x_span - contains maximum span of pathname*		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)**	 Uses:	all registers**   Called by:	change_path*		format*		erase**	Calls:	parse_path** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************parse_path2	PROC		with	data		lda	<path_flag		;get pathname flags		and	#path2_bit		;only want pathname 2 bit		sta	x_path_flag		;save it		lda	<path2_ptr		;get ptr to pathname2		sta	<my_path_ptr		;and save		lda	<path2_ptr+2		sta	<my_path_ptr+2				lda	<span2			;get maximum span of pathname2		sta	x_span			;and save		lda	<dev2_num		;get device #		sta	x_dev_num		;and save 				jsr	parse_path		rts				ENDP		eject********************************************************************************	 Name:	parse_path** Description:	Validates pathname, then copies first name in path to volname*		(in gstring format). Sets name_count to # of names found. *		If there is only a device #, will exit with name_count = 0.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_path_ptr - pointer to pathname in gstring format*			     if x_dev_num = 0, then pathname begins with a volume name*			     if x_dev_num <> 0, then pathname has no volume name*		x_path_flag - indicates if my_path_ptr is valid*		x_dev_num - device number if specified, else 0*		x_span - contains maximum span**      Output:	A = undefined or error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		name_count - total # of names in full pathname. 0 if device # only.*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		volname - volume name in gstring format (if dev_num = 0)**	 Uses:	all registers**   Called by:	parse_path1*		parse_path2**	Calls:	nothing** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************parse_path	PROC		with	data** Initialize outputs.*		stz	name_count		;clear count		stz	volname			;init volname length to 0		stz	first_offset		;init offsets to 0		stz	last_offset** Do we have a pathname?*		lda	x_path_flag		;get pathname flags		bne	check_span		;branch if we have a pathname ** No, so check for a device #.  If we have a device # then exit with name_count = 0,* otherwise exit with a	bad path error.*check_device	lda	x_dev_num		;do we have a device #?		bne	got_dev_num		;yes - so exit		brl	bad_path		;no - so errorgot_dev_num	brl	exit** We have a pathname so make sure span is in range.  Exit with bad path error if not.*check_span	lda	x_span			;get span		beq	bad_path		;error if span = 0;; 17-Dec-91 MSD: Commented out check for maximum span since we want to let process_path; find the disk first so it can set the error priority bit.  It will then check the; span itself.;;		cmp	#max_filename+1		;is it in range?;		bcs	bad_path		;no;; Note: if the span was 0, or the length of the volume name was greater than max_volname; (checked below), it couldn't be an HFS disk anyway, so bad_path_syntax is OK to return.;** Validate pathname.*		ldy	#3			;point past length & first separator		lda	x_dev_num		;do we have a device #?		beq	no_dev_num		;nope		inc	name_count		;yes, so bump name count since partial path		dey				;and adjust for no separatorno_dev_num		longa	off			;set 8 bit A		sep	#$20		sty	first_offset		;save offset to first name		new_name	sty	last_offset		;save offset to last namecheck_loop	lda	[my_path_ptr],y		;Get byte. End of string?		beq	end_of_string		;yes, so ok		cmp	#separator1		;no, hit separator?		beq	separator		;yes		iny				;point to next character		bra	check_loop		;loopseparator	iny				;point to next character		inc	name_count		;bump name count		bra	new_name		;loopend_of_string	inc	name_count		;zero adjust** If the pathname begins with a volume name then copy it to volname.* 		lda	x_dev_num		;do we have a device #?		bne	no_volname		;yes - so pathname has no volume name		ldy	first_offset		;get offset to first name		ldx	#0			;get offset into volnamecopy_loop1	lda	[my_path_ptr],y		;Get byte. End of string?		beq	end_name_1		;yes		cmp	#separator1		;end of	name?		beq	end_name_1		;yes		sta	volname+2,x		;no, put byte in volname		inx				;bump offsets		iny		bra	copy_loop1		;loopend_name_1	lda	#0			;terminate string		sta	volname+2,x		stx	volname			;store length word				cpx	#max_volname+1		;is the volname too long?		bcs	bad_path		;yesno_volname		longa	on			;set 16	bit A 		rep	#$20** Indicate no error and exit.*exit		clc						rts				** Exit with bad path error.*		longa	on			bad_path	rep	#$20			;ensure 16 bit A		lda	#bad_path_syntax	;get error code		sec				;indicate error		rts				;exit				ENDP				eject********************************************************************************	 Name:	process_path** Description:	Processes pathname.  First makes sure that the volume is online.  *		Then finds the Catalog Record for the last name in the pathname.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		x_dev_num - device # if specified, else 0*		volname - volume name (if x_dev_num = 0)*		input_error - set if input error**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<drvr_dev_num - device number*		<my_vcr_ptr - pointer to vcr*		<a1 - ptr to Catalog Record*		record_type - Catalog Record type*		parent_id - parent dir id of file/dir*		id - id of file/dir *		storage_type - storage type of file/dir*		catalog_hint - catalog hint*		error_priority - $8000 if we found the specified volume**	 Uses:	all registers*		<drvr_dev_num**   Called by:	create*		destroy*		change_path*		set_file_info*		get_file_info*		clear_backup*		open*		get_dev_num*		format*		erase**	Calls:	id_disk*		scan_devices		*		walk_path*		update_status*		setup_vcr_info*		deref			(system service)*		find_vcr		(system service)** Copyright Apple Computer, Inc. 1987-91  All rights reserved.******************************************************************************process_path	PROC		with	data** Do we	have a device number or	a volume name?*		lda	x_dev_num		;Is there a device #?		beq	by_name			;No, so	find by	name.** We have a device number.  * ID the disk.	 Exit if it's not ours, otherwise continue on to got_vcr.*		jsr	id_disk			;Is it an HFS disk?		bcs	exit			;no - so exit		bra	got_vcr			;yes - so branch		** We have a volume name. * Look for a vcr with the correct volume name.*by_name		ldx	#volname		;get pointer to	volume name		ldy	#^volname		lda	#0000			;search	by name		jsl	find_vcr				bcs	find_vol		;didn't find a vcr so must search for volume** We found a vcr. * Is it for an HFS volume?  Exit with unknown_vol error if not.*		jsl	deref			;dereference pointer		stx	<my_vcr_ptr		;save it		sty	<my_vcr_ptr+2		ldy	#vcr_fst_id		;get offset to fst id		lda	[my_vcr_ptr],y		;get fst id		cmp	#hfs_id			;is it HFS?		beq	its_hfs			;yes		lda	#unknown_vol		;no - so get error code		sec						bra	exit			;and exit		** The vcr is for an HFS volume.  Has the vcr been marked as swapped?* If so, we must search for the volume.* its_hfs		ldy	#vcr_status				lda	[my_vcr_ptr],y		;get status word		and	#vcr_swapped		;swapped?		bne	find_vol		;yes - so must search for volume** No - so get the current status of the device where the volume was last seen. * If carry clear then the volume is still online.* If carry set then we need to search for the volume.*		jsr	update_status		;get the current device status		bcs	find_vol		;must search for volume** The volume is still online so setup the vcr information and continue on to got_vcr.*		jsr	setup_vcr_info		;setup vcr information		bra	got_vcr			;and continue		*		* Scan the devices for a volume with the correct volume name. * The scan_devices routine will build a vcr and activate it if none exists.*find_vol	jsr	scan_devices		;did we find the volume?		bcs	exit			;no - so exit** Ok, we found the volume and we have a vcr which has been marked active. * Now walk the pathname until we find the Catalog Record for the last name in the path.	*got_vcr		lda	#$8000			;indicate that we found the volume		sta	error_priority		;and it's an HFS volume;; Begin 17-Dec-91 MSD: Now that we've identified the disk, check the span.  If it is; too big, return bad_path_syntax.;		lda	x_span			; get span from last parse_path		cmp	#max_filename+1		; are all filenames short enough?		bcc	ok_span			; yes, so continue finding the file		lda	#bad_path_syntax	; no, so return the error		bra	exit			; note: carry was set if we got here!ok_span;; End 17-Dec-91 MSD;		lda	doing_gdn		;should we skip walk_path? (29-Oct-91 MSD)		bne	no_walk			;29-Oct-91 MSD		jsr	walk_path		;did we find the record?		bcs	exit			;no - so exit** If input_error is non-zero then set carry and exit with input_error.*no_walk						; 29-Oct-91 MSD		lda	input_error		;was there an input error?		beq	exit			;no - so exit with carry clear		sec				;yes - so exit with carry setexit		rts				;exit		ENDP				eject********************************************************************************	 Name:	walk_path** Description:	Walks the pathname and gets the Catalog Record for each*		successive name until it reaches the end of the pathname.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - pointer to vcr*		<my_path_ptr - pointer to pathname*		first_offset - offset to first name in pathname*		last_offset - offset to last name in pathname*		name_count - total # of names in pathname*		x_dev_num - device # if specified, else 0**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<a1 - ptr to Catalog Record for file/dir*		record_type - Catalog Record type*		parent_id - parent dir id of file/dir*		id - id of file/dir *		storage_type - storage type of file/dir*		catalog_hint - catalog hint**	 Uses:	all registers*		current_offset*		record_name*		a0,a1,d0,d2**   Called by:	process_path	**	Calls:	get_record_name*		get_next_name		*		ct_get_rec*		get_storage_type** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************walk_path	PROC		with	data		** Initialize current_offset to point to the first name in the path.*		lda	first_offset		;get offset to first name in pathname		sta	current_offset** Initialize parent_id to be the volume parent ID.*		lda	#vol_parent_id		;set parent ID to volume parent ID		sta	parent_id		lda	#^vol_parent_id		sta	parent_id+2** Now, check to see if a device # was specified.*		lda	x_dev_num		;was a device # specified?		beq	name_loop		;no** A device # was specified. * We need to find the directory record for the volume directory but we don't know the * volume name. So, we'll use the volume dir id to find the record.* If a pathname was also specified, then we'll jump into the name loop code.* If we only have a device #, then we need to copy the name from the Catalog Record* into record_name so we'll have it later.  Then finish up and exit.*		stz	<a0			;A0.L <- nil ptr (no name)		stz	<a0+2		lda	#vol_dir_id		;D0.L <- volume dir ID		sta	d0		lda	#^vol_dir_id		sta	d0+2				stz	d2			;D2.L <- no hint		stz	d2+2 		jsr	ct_get_rec		;get the Catalog Record		bcs	bcs_not_found				lda	name_count		;do we have a pathname?		bne	cont			;yes - so continue		jsr	get_record_name		;no - so copy Catalog Record name		bra	found_it		;into record_name and finish up** Get the Catalog Record for each successive name in the pathname until we* reach the end of the pathname.*name_loop	jsr	get_next_name		;copy next name into record_name				lda	#record_name		;A0.L <- ptr to name		sta	<a0		lda	#^record_name		sta	<a0+2				lda	parent_id		;D0.L <- parent ID		sta	d0		lda	parent_id+2		sta	d0+2				stz	d2			;D2.L <- no hint		stz	d2+2 		jsr	ct_get_rec		;get the Catalog Recordbcs_not_found	bcs	not_found				lda	last_offset		;was this the last name in the pathname?		cmp	current_offset		bcc	found_it		;yes - so we're done		cont		ldy	#cat_type		;get offset to Catalog Record type		lda	[a1],y			;get record type		cmp	#cat_dir_type		;is it a directory record?		bne	bad_path		;no - so error				ldy	#dir_id			;get offset to dir ID		lda	[a1],y			;get hi word of dir ID 		xba				;change byte sex		sta	parent_id+2		;store in hi word of parent_id		iny		iny		lda	[a1],y			;get lo word of dir ID		xba				;change byte sex		sta	parent_id		;store in lo word of parent_id				bra	name_loop		** We've found the record for the last name in the path. ** Get the Catalog Record type and save.*found_it	ldy	#cat_type		;get offset to Catalog Record type		lda	[a1],y			;get record type		sta	record_type		;and save** Get the file/dir id and save.*		ldy	#fil_id			;get offset to file id;		lda	record_type		;are we dealing with a file?		cmp	#cat_fil_type		beq	get_id			;yes - so branch		ldy	#dir_id			;no - so adjust offsetget_id		lda	[a1],y			;get hi word of id		xba				;change byte sex		sta	id+2			;and save		iny		iny 		lda	[a1],y			;get lo word of id		xba				;change byte sex		sta	id			;and save** Save the catalog hint which was returned from the last ct_get_rec call.*		lda	d2					sta	catalog_hint				lda	d2+2		sta	catalog_hint+2** Setup the storage type output parameter.*		jsr	get_storage_type** Indicate no error and exit* 		clc						rts		** Return an error*not_found	cmp	#bt_not_found		;was error 'not found'?		bne	error			;no - so return error as is;; Begin 2-Dec-91 MSD: Catch the peculiar case where the disk is damaged in such a way; that the volume directory's entry couldn't be found in the CTree.  The disk is obviously; damaged, so we'll return a damaged_bitmap error.  Too bad I can't detect this kind of; damage in other parts of the CTree.;; The reason that I even bother to test this case is that it's a fairly common problem; with disk-to-disk copies that don't complete successfully.  It may also be true when; other whole-disk operations (like Erase or Zero) fail and leave the disk in an inconsistent; state.;		lda	#damaged_bitmap		; assume the error		ldx	parent_id		; is parent the volume's parent		cpx	#<vol_parent_id		; (i.e. didn't find volume directory entry)?		bne	@not_damaged		; no, was something else not found		ldx	parent_id+2		cpx	#^vol_parent_id		beq	error			; was volume, so return the error@not_damaged;; End 2-Dec-91 MSD;		lda	#file_not_found		;change error to 'file not found'		ldx	last_offset		;was this the last name in the pathname?		cpx	current_offset		bcc	error			;yes - so return 'file not found' errorbad_path	lda	#path_not_found		;return 'path not found' errorerror		sec				;indicate error		rts				ENDP				eject********************************************************************************	 Name:	get_storage_type** Description:	Determines the storage type of a Catalog Record.  **	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record*		parent_id - parent dir id of Catalog Record**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		storage_type - storage type of Catalog Record**	 Uses:	all registers**   Called by:	walk_path*		get_dir_entry*		get_cat_info**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_storage_type PROC		with	data** First, determine whether the Catalog Record is for a file or a directory.*		ldy	#cat_type		;get offset to Catalog Record type		lda	[a1],y			;get record type		cmp	#cat_dir_type		;is it a directory record?		bne	file_rec		;no** The Catalog Record is for a directory.* Determine if it's a subdirectory or the volume directory.*		lda	parent_id		;get lo word of record's parent id		cmp	#vol_parent_id		;does it match the volume parent id?		bne	subdir			;no		lda	parent_id+2		;get hi word of record's parent id		cmp	#^vol_parent_id		;does it match the volume parent id?		bne	subdir			;no		lda	#volume_stype		;set storage type to 'volume directory'		bra	set_stype		subdir		lda	#directory_stype	;set storage type to 'subdirectory'		bra	set_stype		** The Catalog Record is for a file.* Determine if it's a standard file or an extended file.*file_rec	ldy	#fil_rsrc_peof		lda	[a1],y					iny		iny		ora	[a1],y			;is the resource fork peof = 0?		beq	standard		;yes - so it's a standard file		lda	#extended_stype		;set storage type to 'extended file'		bra	set_stype		standard	lda	#standard_stype		;set storage type to 'standard file'** Set the storage_type output parameter.*set_stype	sta	storage_type** Indicate no error and exit.*		clc		rts				ENDP		eject		********************************************************************************	 Name:	get_vol_info** Description:	Gets information about a volume and stores it in the output *		parameter storage area.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - ptr to vcr*		pblks_per_ablk - # of physical blocks per alloc block**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		total_blocks - total number of blocks on the volume*		free_blocks - total number of free blocks on the volume*		blocks_used - total number of blocks used on the volume**	 Uses:	all registers*		<multiplier*		<multiplicand*		<product**   Called by:	volume*		get_cat_info**	Calls:	word_multiply** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************get_vol_info	PROC		with	data** Setup the total_blocks output parameter *		ldy	#vcr_num_pblks		;get # of physical blocks on vol		lda	[my_vcr_ptr],y		sta	total_blocks		;store in total_blocks		iny		iny		lda	[my_vcr_ptr],y		sta	total_blocks+2** Setup the free_blocks output parameter * free_blocks = vcr_free_ablks * pblks_per_ablk*		lda	pblks_per_ablk		;multiplier = # of phys blks per alloc blk		sta	<multiplier				ldy	#vcr_free_ablks		;multiplicand = # of free alloc blks on vol		lda	[my_vcr_ptr],y		sta	<multiplicand				jsr	word_multiply		;product = multiplier * multiplicand				lda	<product		;store answer in free_blocks		sta	free_blocks		lda	<product+2		sta	free_blocks+2** Setup the blocks_used output parameter * blocks_used = total_blocks - free_blocks*		sec		lda	total_blocks		;get total number of blocks on volume		sbc	free_blocks		;subtract number of free blocks on volume		sta	blocks_used		;to get number of used blocks on volume		lda	total_blocks+2		sbc	free_blocks+2		sta	blocks_used+2** Indicate no error and exit*		clc				;indicate no errorexit		rts				;exit		ENDP				eject********************************************************************************	 Name:	get_cat_info** Description:	Gets information from a Catalog Record and stores it in the output*		parameter storage area.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		call - call number*		class - call class*		<my_vcr_ptr - ptr to vcr*		<a1 - ptr to Catalog Record*		record type - Catalog Record type*		storage_type - storage type**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		access - access information*		file_type - ProDOS file type*		aux_type - ProDOS aux type*		total_blocks - total number of blocks on volume (vol dir, class 0 call)*		eof - logical eof of data fork (file, class 1 call) or*		      undefined (subdir, class 1 call) or*		      undefined (vol dir, class 1 call) *		resource_eof - logical eof of resource fork (file, class 1 call) or*		      	       undefined (subdir, class 1 call) or*		      	       undefined (vol dir, class 1 call) *		blocks_used - blocks used for data fork (file, class 1 call) or*			      undefined (subdir, class 1 call) or*			      undefined (vol dir, class 1 call) or*			      total blocks used for file (file, class 0 call) or*			      estimated blocks used for subdir (subdir, class 0 call) or*			      total blocks used on volume (vol dir, class 0 call)*		resource_blocks - blocks used for resource fork (file, class 1 call) or*		      		  undefined (subdir, class 1 call) or*		      		  undefined (vol dir, class 1 call) *		create_date - create date (class 0 call)*		create_time - create time (class 0 call)*		mod_date - modification date (class 0 call)*		mod_time - modification time (class 0 call)*		create_date_time - create date and time (class 1 call)*		mod_date_time - modification date and time (class 1 call)*		finder_info - Finder Info (class 1 call)**	 Uses:	all registers*		<temp0*		<my_fcr_ptr*		<source_ptr	(aka <product)*		<dest_ptr 	**   Called by:	get_file_info*		open*		get_dir_entry**	Calls:	get_access*		get_file_aux*		get_create_mod*		look_for_fcr*		copy_long*		calc_blocks_used*		get_vol_info*		get_finder_info*		get_storage_type** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_cat_info	PROC		with	data		** Get access information for the file/dir.*		jsr	get_access		** Get a ProDOS filetype and auxtype for the file/dir.*		jsr	get_file_aux** Get the create date/time and mod date/time for the file/dir.*		jsr	get_create_mod		** Check the Catalog Record type.  Do we have a File or Directory Record?*		lda	record_type		;get Catalog Record type		cmp	#cat_fil_type		;is it a file record?		beq	do_fil_stuff		;yes 		brl	do_dir_stuff		;no** We have a File Record. * If we're doing a GetFileInfo call, we need to check if either (or both) of the* file's forks are open.  If a fork is open and the fork's fcr is dirty then* we need to copy the leof and peof from the fcr to the File Record so that the * correct information will be used when setting up the output parameters.* Note - the new leof and peof are not written to disk.* Note - after we update the File Record, we need to update the storage_type *	 output parameter since the new eofs may change the file *	 from a 'standard file' to an 'extended file' or vice-versa.*do_fil_stuff	lda	call			;get the call #		cmp	#gfi_call_num		;are we doing a GetFileInfo call?		bne	fil_rec_ok		;no - so File Record is OK				jsr	look_for_fcr		;look for an fcr for the file		bcs	fil_rec_ok		;didn't find one so File Record is OK		jsr	update_fil_rec		;update the File Record if needed		@loop		jsr	look_for_fcr2		;look for another fcr for the file		bcs	@cont			;didn't find one 		jsr	update_fil_rec		;update the File Record if needed		bra	@loop			;loop@cont			jsr	get_storage_type 	;update storage typefil_rec_ok** We have a File Record which has been updated if necessary.* Now check the class of the call.*		lda	class			;get class #		bne	fil_class1		;branch if class 1 call** We have a File Record and a class 0 call.* Get the total blocks used for the file.*		ldy	#fil_data_peof		;get offset to data fork peof				jsr	calc_blocks_used	;calculate blocks used for data fork		stx	blocks_used		;and store		sty	blocks_used+2		ldy	#fil_rsrc_peof		;get offset to rsrc fork peof				jsr	calc_blocks_used	;calculate blocks used for rsrc fork		clc				;and add to blocks used for data fork		txa				;to result in total blocks used for file		adc	blocks_used		sta	blocks_used		tya		adc	blocks_used+2		sta	blocks_used+2		brl	exit			;and we're done** We have a File Record and a class 1 call.* Get the logical eof of the data fork, the logical eof of the resource fork, * the blocks used for the data fork, the blocks used for the resource fork* and the Finder Info for the file.*fil_class1		ldy	#fil_data_leof		;get offset to data fork leof		lda	[a1],y			;get hi word of data fork leof		xba				;change byte sex		sta	eof+2			;and store		iny		iny		lda	[a1],y			;get lo word of data fork leof		xba				;change byte sex		sta	eof			;and store		ldy	#fil_rsrc_leof		;get offset to rsrc fork leof		lda	[a1],y			;get hi word of rsrc fork leof		xba				;change byte sex		sta	resource_eof+2		;and store		iny		iny		lda	[a1],y			;get lo word of rsrc fork leof		xba				;change byte sex		sta	resource_eof		;and store		ldy	#fil_data_peof		;get offset to data fork peof				jsr	calc_blocks_used	;calculate blocks used for data fork		stx	blocks_used		;and store		sty	blocks_used+2		ldy	#fil_rsrc_peof		;get offset to rsrc fork peof				jsr	calc_blocks_used	;calculate blocks used for rsrc fork		stx	resource_blocks		;and store		sty	resource_blocks+2				jsr	get_finder_info		;get Finder Info				bra	exit			;and we're done	** We have a Directory Record. Now check the class of the call.*do_dir_stuff	lda	class			;get class #		bne	dir_class1		;branch if class 1 call** We have a Directory Record and a class 0 call.  Now check storage_type.* If storage_type is 'volume' then get the total blocks on the volume and the * blocks used on the volume.* If storage_type is 'subdirectory' then estimate the blocks used for the subdirectory.*		lda	storage_type		;get the storage type of the directory		cmp	#volume_stype		;is it a volume directory?		bne	subdir			;no - so branch		jsr	get_vol_info		;setup total_blocks and blocks_used		bra	exit			;and we're done 		subdir		ldy	#dir_valence		;get offset into Directory Record		lda	[a1],y			;get # of files and dirs in this dir		xba				;change byte sex		lsr	a			;divide by 4 to estimate blocks used		lsr	a			;for catalog info		sta	blocks_used		;store result 		bra	exit			;and we're done		** We have a Directory Record and a class 1 call.* If storage_type is 'volume' then we're done since Finder Info is returned as 0 for volumes.* If storage_type is 'subdirectory' then get the Finder Info for the subdirectory.*dir_class1			lda	storage_type		;get the storage type of the directory		cmp	#volume_stype		;is it a volume directory?		beq	exit			;yes - so we're done				jsr	get_finder_info		;no - so get Finder Info** Indicate no error and exit*exit		clc		rts;------------------------------------------------------------------------------; update_fil_rec routine;------------------------------------------------------------------------------** If the fcr is dirty, then copy the leof and peof from the fcr to the File Record.*update_fil_rec	ldy	#fcr_flags				lda	[my_fcr_ptr],y		;get the fcr flags		and	#fcr_dirty_bit		;is the fcr dirty?		beq	update_done		;no - so nothing to update				lda	<my_fcr_ptr		;the fcr is dirty so		sta	<source_ptr		;setup source ptr		lda	<my_fcr_ptr+2		sta	<source_ptr+2				lda	<a1			;setup destination ptr		sta	<dest_ptr		lda	<a1+2		sta	<dest_ptr+2				ldy	#fcr_access		lda	[my_fcr_ptr],y		;get access word from fcr		and	#rsrc_fork_bit		;we only want the rsrc fork bit 		sta	<temp0			;save it				ldy	#fcr_leof		;get starting source offset		ldx	#fil_data_leof		;get starting dest offset		lda	<temp0			;is the fcr for a resource fork?		beq	@cont			;no - so branch		ldx	#fil_rsrc_leof		;yes - so adjust dest offset@cont		jsr	copy_long		;copy leof from fcr to File Record		jsr	copy_long		;copy peof from fcr to File Recordupdate_done	rts		ENDP				eject********************************************************************************	 Name:	get_access** Description:	Gets the access information for a file/dir and stores it in the*		output parameter storage area.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record*		record_type - Catalog Record type*		storage_type - storage type**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		access - access information for file/dir**	 Uses:	all registers*		<temp0**   Called by:	get_cat_info	**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_access	PROC		with	data** First, determine if we're dealing with a volume directory.*		lda	storage_type		;get storage type		cmp	#volume_stype		;are we dealing with a volume dir?		bne	not_vol			;no - so branch** We're dealing with a volume directory.* Set the access word to 'full access'.*		lda	#full_access		;set access word to		sta	access			;'full access'		brl	done			;and we're done** We're dealing with a file or subdirectory.* First, initialize the access word to 'read enabled' access.*not_vol		lda	#read_enabled		sta	access*		* Set the overflow flag if the Catalog Record is for a file.* 		clc		lda	#$7ffe		adc	record_type		** If we're dealing with a file, then check the flags byte in the Catalog Record.* If the file is unlocked then set the 'write enabled', 'rename enabled' and * 'destroy enabled' bits in the access word.* Subdirectories are always unlocked.*		bvc	unlocked		;branch if we're dealing with a dir				ldy	#fil_flags		;get offset to file flags byte		lda	[a1],y			;get file flags		and	#locked_bit		;is the file locked?		bne	locked			;yes		unlocked	lda	access			;no - so get access word		ora	#write_enabled		;enable write		ora	#rename_enabled		;enable rename		ora	#destroy_enabled	;enable destroy		sta	access			;and savelocked** Now check the Finder Flags word in the Finder Info field of the Catalog Record.* If the file/dir is invisible then set the 'invisible' bit in the access word.*		ldy	#fil_finfo1+fi_flags	;get offset to Finder Info flags		bvs	get_fi_flags		ldy	#dir_finder_info+fi_flags  ;get offset to Finder Info flagsget_fi_flags	lda	[a1],y			;get Finder Info flags		xba				;change byte sex		and	#fi_invis_bit		;is the file/dir invisible?		beq	visible			;no				lda	access			;yes - so get access word		ora	#invisible		;set 'invisible' bit		sta	access			;and savevisible	** Now compare the 'modified date/time' to the 'backup date/time' in the Catalog Record.* If the 'modified date/time' is later than the 'backup date/time' then set the* 'backup needed' bit in the access word.*		ldy	#fil_mod_dt			bvs	get_mod_dt		ldy	#dir_mod_dt	get_mod_dt	lda	[a1],y			;get hi word of mod date/time		xba				;change byte sex		sta	<temp0			;and save		iny		iny		lda	[a1],y			;get lo word of mod date/time		xba				;change byte sex		sta	<temp0+2		;and save				ldy	#fil_backup_dt				bvs	cmp_2_backup		ldy	#dir_backup_dt	cmp_2_backup	lda	[a1],y			;get hi word of backup date/time		xba				;change byte sex		cmp	<temp0			;compare to hi word of mod date/time		beq	equal			;branch if backup is same as mod		bcs	backup_ok		;branch if backup is later than mod		bcc	needs_backup		;branch if backup is earlier than modequal		iny				;adjust offset to point to lo word		iny		lda	[a1],y			;get lo word of backup date/time		xba				;change byte sex		cmp	<temp0+2		;compare to lo word of mod date/time		bcs	backup_ok		;branch if backup is >= mod		needs_backup	lda	access			;get access word		ora	#backup_needed		;set 'backup needed' bit		sta	access			;and savebackup_ok** Indicate no error and exit*		done		clc		rts				ENDP				eject********************************************************************************	 Name:	get_file_aux** Description:	Converts the HFS creator and filetype information for the file/dir*		into ProDOS filetype and auxtype information and stores it in the*		output parameter storage area.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record*		record_type - Catalog Record type**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		file_type - ProDOS filetype*		aux_type - ProDOS auxtype**	 Uses:	all registers*		<temp0*		<temp1**   Called by:	get_cat_info	**	Calls:	Hex2Int			(Integer Math routine)** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************get_file_aux 	PROC		with	data		hfs_filetype	equ	temp0			;local equate - 4 bytes longhfs_creator	equ	temp1			;local equate - 4 bytes long** First, check the record type to see if we're dealing with a directory or a file.*		lda	record_type		;get Catalog Record type		cmp	#cat_dir_type		;are we dealing with a directory?		bne	do_cvt			;branch if not** We're dealing with a directory so set the file_type output parameter to 'directory'.* The aux_type output parameter was initialized to 0 so no need to clear it again.*		lda	#dir_ftype		;set file_type to 'directory'		sta	file_type		brl	done			;and we're done** We're dealing with a file so we have to convert the HFS 'creator' and 'filetype' to* a ProDOS 'filetype' and 'auxtype'.* First, get the file's HFS filetype and creator and save them in local temps.*do_cvt		ldy	#fil_finfo1+fi_file_type ;get offset to file's type info		lda	[a1],y			;get first 2 bytes of filetype info		sta	<hfs_filetype		;and save		iny				;adjust offset		iny		lda	[a1],y			;get next 2 bytes of filetype info		sta	<hfs_filetype+2		;and save 		ldy	#fil_finfo1+fi_file_creator ;get offset to file's creator info		lda	[a1],y			;get first 2 bytes of creator info		sta	<hfs_creator		;and save		iny				;adjust offset		iny		lda	[a1],y			;get next 2 bytes of creator info		sta	<hfs_creator+2		;and save** Check the file's HFS creator to see if it's "pdos".  *		lda	<hfs_creator		;get first 2 bytes of file's creator		cmp	#'dp'			;is it "pd" ?		bne	check_table		;no - so branch		lda	<hfs_creator+2		;get next 2 bytes of file's creator		cmp	#'so'			;is it "os" ?		bne	check_table		;no - so branch** The file's HFS creator is "pdos" so we need to do some special checking on the filetype.** First, check to see if the first byte of the HFS filetype is "p".* If it is, set the ProDOS filetype to the second byte of the HFS filetype and set the * ProDOS auxtype to the third and fourth bytes of the HFS filetype.*		lda	<hfs_filetype		;get first 2 bytes of filetype		and	#$00ff			;only want first byte		cmp	#'p'			;is it "p" ?		bne	not_p			;no - so branch		lda	<hfs_filetype+1		;get second and third bytes of filetype		and	#$00ff			;only want second byte		sta	file_type		;and store in output parameter		lda	<hfs_filetype+2		;get third and fourth bytes of filetype		xba				;swap bytes		sta	aux_type		;and store in output parameter		bra	done			;we're donenot_p** If the HFS filetype consists of 2 hex digits (i.e. "0"-"9" or "A"-"F") followed by 2 * spaces then set the ProDOS filetype to the integer equivalent of the 2 hex digits.* The Hex2Int routine in the Integer Math Toolset is used to convert the hex digits* into an integer.  The routine returns an error if one of the bytes is not a hex digit.*		lda	<hfs_filetype+2		;get third and fourth bytes of filetype		cmp	#'  '			;are they spaces ?		bne	not_hex			;no - so branch				pea	0			;push space for integer result		pea	0			;push ptr to first 2 bytes of HFS filetype		clc		tdc		adc	#hfs_filetype		pha						pea	2			;push string length		ldx	#Hex2Int		;call Hex2Int routine in Integer Math		jsl	tool_locator				pla				;retrieve integer result		bcs	not_hex			;got an error 		sta	file_type		;store result in output parameter		bra	done			;we're donenot_hex		** Check the file's HFS creator and filetype against the strings listed in the * conversion table. If a match is found, set the ProDOS filetype and auxtype to * the values in the table. If there's no match, we're done since the file_type * and aux_type output parameters were already initialized to 0.*check_table	ldx	#0			;init table offsettable_loop	lda	conversion_table,x	;get 2 bytes from table		bmi	skip_creator		;negative value matches any HFS creator		cmp	<hfs_creator		;compare to first 2 bytes of HFS creator		bne	next_entry		;no match so check next table entry		lda	conversion_table+2,x	;get next 2 bytes from table		cmp	<hfs_creator+2		;compare to next 2 bytes of HFS creator		bne	next_entry		;no match so check next table entryskip_creator				lda	conversion_table+4,x	;get next 2 bytes from table		cmp	<hfs_filetype		;compare to first 2 bytes of HFS filetype		bne	next_entry		;no match so check next table entry		lda	conversion_table+6,x	;get next 2 bytes from table		cmp	<hfs_filetype+2		;compare to next 2 bytes of HFS filetype		beq	match			;got a matchnext_entry	clc				;adjust table offset by the size of 		txa				;a table entry		adc	#entry_size		tax		cmp	#table_size		;at end of table?		bcc	table_loop		;no - so loop		bra	done			;yes - so we're done		match		lda	conversion_table+8,x	;get ProDOS filetype from table		and	#$00ff			;only want 1 byte		sta	file_type		;and store in output parameter 		lda	conversion_table+9,x	;get ProDOS auxtype from table		and	#$00ff			;only want 1 byte		sta	aux_type		;and store in output parameter** Indicate no error and exit*		done		clc		rts				ENDP				eject********************************************************************************	 Name:	get_create_mod** Description:	Gets the create date/time and mod date/time information for a *		file/dir and stores it in the output parameter storage area.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - ptr to vcr*		<a1 - ptr to Catalog Record*		record_type - Catalog Record type*		storage_type - storage type*		class - call class**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		create_date - create date (class 0 call)*		create_time - create time (class 0 call)*		mod_date - modification date (class 0 call)*		mod_time - modification time (class 0 call)*		create_date_time - create date and time (class 1 call)*		mod_date_time - modification date and time (class 1 call)**	 Uses:	all registers*		<temp0*		<temp1*		<source_ptr	(aka <product)*		<dest_ptr	**   Called by:	get_cat_info	**	Calls:	copy_long*		handle_conv_err*		ConvSeconds		(Misc. Tools routine)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_create_mod 	PROC		with	data			** First, determine if we're dealing with a volume directory.*		lda	storage_type		;get storage type		cmp	#volume_stype		;are we dealing with a volume dir?		bne	not_vol			;no - so branch** We're dealing with a volume directory.* Get the 'create date/time' and 'modified date/time' information from the VCR* (not the Catalog Record) and store it for later.*		ldy	#vcr_create_dt		;get offset into vcr		ldx	#0loop		lda	[my_vcr_ptr],y		;copy create date/time into <temp0		sta	<temp0,x		;and modified date/time into <temp1		iny		iny		inx		inx		cpx	#8		bne	loop				bra	do_convert		*		* We're dealing with a file or subdirectory.* Get the 'create date/time' and 'modified date/time' information from the Catalog Record* and store it for later.*not_vol		lda	<a1			;set up source ptr		sta	<source_ptr		lda	<a1+2		sta	<source_ptr+2				clc		tdc		adc	#temp0			;set up destination ptr		sta	<dest_ptr		stz	<dest_ptr+2				ldy	#fil_create_dt 		;init source offset		lda	record_type		;get record type		cmp	#cat_fil_type		;are we dealing with a File Record?		beq	cont1			;yes - so continue		ldy	#dir_create_dt		;no - so adjust source offsetcont1		ldx	#0			;init destination offset		jsr	copy_long		;copy create date/time into <temp0		jsr	copy_long		;copy modified date/time into <temp1** Convert the 'create date/time' and 'modified date/time' information into ProDOS class 0* format or GS/OS class 1 format, and store result in the output parameter storage area.*do_convert	pha				;push space for result		pha		pea	4			;convert seconds to class0 format date/time 		lda	class			;check call class		beq	@0			;branch if class 0		lda	#0			;convert seconds to class1 format date/time		sta	1,s@0 		pei	<temp0+2		;push hi word of seconds		pei	<temp0			;push lo word of seconds		pea	create_date_time>>16	;push ptr to create date/time buffer		pea	create_date_time		ldx	#ConvSeconds 		;call ConvSeconds routine in Misc Tools		jsl	tool_locator		bcc	conv_ok1		jsr	handle_conv_err		conv_ok1	;		pla				;pull result off stack (unused);		pla		;		pha				;push space for result;		pha		pea	4			;convert seconds to class0 format date/time 		lda	class			;check call class		beq	@0			;branch if class 0		lda	#0			;convert seconds to class1 format date/time		sta	1,s@0 		pei	<temp1+2		;push hi word of seconds		pei	<temp1			;push lo word of seconds		pea	mod_date_time>>16	;push ptr to mod date/time buffer		pea	mod_date_time		ldx	#ConvSeconds 		;call ConvSeconds routine in Misc Tools		jsl	tool_locator		bcc	conv_ok2		jsr	handle_conv_err		conv_ok2	pla				;pull result off stack (unused)		pla** Indicate no error and exit*		done		clc		rts				ENDP		eject********************************************************************************	 Name:	get_finder_info** Description:	Gets the Finder Info for a file/dir and stores it in the*		output parameter storage area.**	 Note:	The Finder Info is always in 68000 format so the byte sex*		doesn't need to be reversed.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record*		record_type - Catalog Record type**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		finder_info - Finder Info **	 Uses:	all registers**   Called by:	get_cat_info	**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_finder_info PROC		with	data** Determine if the Catalog Record we're dealing with is for a file or directory.*		lda	record_type		;get Catalog Record type		cmp	#cat_dir_type		;are we dealing with a directory record?		beq	its_dir			;yes - so branch** We're dealing with a File Record.*		ldy	#fil_finfo1		;get offset to 1st 16 bytes of finder info		ldx	#0			;init offset into output param storagefil_loop	lda	[a1],y			;copy the bytes		sta	finder_info,x				iny		iny		inx						inx		cpx	#32			;done with second half?		beq	done			;yes		cpx	#16			;done with first half?		bne	fil_loop		;no - so loop		ldy	#fil_finfo2		;yes - so get offset to 2nd 16 bytes		bra	fil_loop		;and loop		** We're dealing with a Directory Record.*its_dir		ldy	#dir_finder_info	;get offset to 32 bytes of finder info		ldx	#0			;init offset into output param storagedir_loop	lda	[a1],y			;copy the bytes		sta	finder_info,x				iny		iny		inx						inx		cpx	#32			;done?		bne	dir_loop		;no - so loop** Indicate no error and exit*		done		clc		rts				ENDP				eject********************************************************************************	 Name:	set_access** Description:	Sets the access information for a file/dir.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record*		record_type - Catalog Record type*		storage_type - storage type *		access - access information for file/dir**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers**   Called by:	create*		set_file_info	**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************set_access	PROC		with	data*		* Set the overflow flag if the Catalog Record is for a file.* 		clc		lda	#$7ffe		adc	record_type		** If we're dealing with a file, then check the 'write enabled', 'rename enabled' and * 'destroy enabled' bits in the access word. If they are all clear, lock the file.  * If any of them are set, unlock the file.* If we're dealing with a subdirectory, then skip this section since dirs can't be locked.*		bvc	skip_it			;branch if the Catalog Record is for a dir				ldy	#fil_flags		;get offset to file flags byte		lda	[a1],y			;get file flags		tax				;and save in X				lda	access			;get access word; BEGIN 29-Oct-91 MSD		and	#locked_access		; are any of the enable bits set?		bne	unlock_it		; yes, so unlock the file						; otherwise, fall into locking the file; This was the old code for reading pleasure...;		ora	#read_enabled		;make sure 'read enabled' bit is set;		and	#full_access		;mask off unwanted bits;		cmp	#full_access		;are all the 'enabled' bits set?;		beq	unlock_it		;yes - so unlock the file; END 29-Oct-91 MSD		txa				;no - so lock the file		ora	#locked_bit		;set the 'locked' bit		bra	store_flags		unlock_it	txa		and	#locked_mask		;clear the 'locked' bitstore_flags	sta	[a1],y			;save new file flagsskip_it** Now copy the 'invisible' bit in the access word into the Finder Flags word in the * Finder Info field of the Catalog Record.*		ldy	#fil_finfo1+fi_flags	;get offset to Finder Info flags		bvs	get_fi_flags		ldy	#dir_finder_info+fi_flags  ;get offset to Finder Info flagsget_fi_flags	lda	[a1],y			;get Finder Info flags		xba				;change byte sex		tax				;and save in X				lda	access			;get access word		and	#invisible		;is the 'invisible' bit set?		beq	visible			;no - so make file/dir visible		txa				;yes - so make file/dir invisible		ora	#fi_invis_bit		;set the 'invisible' bit		bra	store_fi_flags		visible		txa		and	#fi_invis_mask		;clear the 'invisible' bitstore_fi_flags	xba				;change byte sex		sta	[a1],y			;save new Finder Info flags** Indicate no error and exit*				clc		rts				ENDP				eject********************************************************************************	 Name:	set_file_aux** Description:	Converts the ProDOS filetype and auxtype information from the input*		parameter storage area into HFS creator and filetype information and *		stores it in the Catalog Record for the file/dir.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record*		record_type - Catalog Record type*		storage_type - storage type *		file_type - ProDOS filetype*		aux_type - ProDOS auxtype**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers**   Called by:	create*		set_file_info	**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************set_file_aux 	PROC		with	data		** First, determine if the Catalog Record we're dealing with is for a file or directory.* If it's for a directory, then we're done since directory records don't contain * creator or filetype information.*		lda	record_type		;get Catalog Record type		cmp	#cat_dir_type		;are we dealing with a directory record?		bne	not_dir			;no		brl	done			;yes - so we're donenot_dir** The Catalog Record is for a file so we have to convert the ProDOS 'filetype' and * 'auxtype' into an HFS 'creator' and 'filetype'.** First, set the HFS creator to "pdos". *		ldy	#fil_finfo1+fi_file_creator  ;get offset into Catalog Record		lda	#'dp'		sta	[a1],y			;store first 2 bytes in Catalog Record		iny		iny		lda	#'so'		sta	[a1],y			;store next 2 bytes in Catalog Record** If filetype = $B3 and hi byte of auxtype = $DB then use the default conversion.* Otherwise, zero out the auxtype and use the conversion table.*		lda	file_type		cmp	#$00b3			;is the ProDOS filetype = $B3?		bne	@not_b3			;no		lda	aux_type		;put ProDOS auxtype in A		and	#$ff00			;only want the hi byte		cmp	#$db00			;is the hi byte of the auxtype = $DB?		beq	use_default		;yes - so use default conversion		stz	aux_type		;no - so zero auxtype and use table		bra	check_table@not_b3				** If filetype = $FF then zero out the aux_type and use the conversion table.*		lda	file_type		cmp	#$00ff			;is the ProDOS filetype = $FF?		bne	@not_ff			;no		stz	aux_type		;yes - so zero auxtype and use table		bra	check_table@not_ff** Check the ProDOS filetype and auxtype against the values listed in the conversion * table. If a match is found, set the HFS creator and filetype to the strings * specified in the table. If there's no match, then use the default conversion. *check_table	ldx	#0			;init table offsettable_loop	lda	conversion_table+8,x	;get byte from table		and	#$00ff			;only want 1 byte		cmp	file_type		;compare to ProDOS filetype		bne	next_entry		;no match so check next table entry		lda	conversion_table+9,x	;get next byte from table		and	#$00ff		cmp	aux_type 		;compare to ProDOS auxtype		beq	match			;got a matchnext_entry	clc				;adjust table offset by the size of 		txa				;a table entry		adc	#entry_size		tax		cmp	#table_size		;at end of table?		bcc	table_loop		;no - so loop		bra	use_default		;yes - so use default conversion		** We found a match in the conversion table so set the HFS filetype and creator to * the strings specified in the table.  If no string is specified for the creator,* then skip it since we already set the HFS creator to "pdos".*match		ldy	#fil_finfo1+fi_file_type  ;get offset into Catalog Record		lda	conversion_table+4,x	;get first 2 bytes of HFS filetype		sta	[a1],y			;and store into Catalog Record		iny		iny		lda	conversion_table+6,x	;get next 2 bytes of HFS filetype		sta	[a1],y			;and store into Catalog Record 		ldy	#fil_finfo1+fi_file_creator  ;get offset into Catalog Record		lda	conversion_table,x	;get first 2 bytes of HFS creator		bmi	skip_creator		;no string specified so skip it		sta	[a1],y			;and store into Catalog Record		iny		iny		lda	conversion_table+2,x	;get next 2 bytes of HFS creator		sta	[a1],y			;and store into Catalog Recordskip_creator	bra	done			;we're done** Use the default conversion.* Set first byte of HFS filetype to "p".  Set second byte of HFS filetype to the* ProDOS filetype.  Set the third and fourth bytes of HFS filetype to the ProDOS auxtype.*use_default	ldy	#fil_finfo1+fi_file_type  ;get offset into Catalog Record		lda	file_type		;get ProDOS filetype		xba				;swap filetype into hi byte		ora	#'p'			;put 'p' in lo byte		sta	[a1],y			;and store into Catalog Record		iny		iny		lda	aux_type		;get ProDOS auxtype		xba				;swap bytes		sta	[a1],y			;and store into Catalog Record** Indicate no error and exit*		done		clc		rts		ENDP				eject********************************************************************************	 Name:	set_create_dt** Description:	Sets the create date/time information for a file/dir.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record*		record_type - Catalog Record type*		storage_type - storage type *		create_date - create date (class 0 call)*		create_time - create time (class 0 call)*		create_date_time - create date and time (class 1 call)**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers*		<temp0*		d0, d1**   Called by:	create*		set_file_info	**	Calls:	handle_conv_err*		ConvSeconds		(Misc. Tools)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************set_create_dt 	PROC		with	dataoffset		equ	temp0			;local equate		** First, get the correct offset into the Catalog Record and save it for later.*		ldy	#fil_create_dt+2	;get offset into File Record		lda	record_type		;get Catalog Record type		cmp	#cat_fil_type		;are we dealing with a File Record?		beq	save_offset		;yes - so continue 		ldy	#dir_create_dt+2	;no - so get offset into Dir Recordsave_offset	sty	<offset			;save the offset** Now, determine if we're doing a class 0 or class 1 call.*		lda	class		beq	class0** We're doing a class 1 call.* If create_date_time = 0, then we're done.* Otherwise, convert create_date_time into seconds and store in the Catalog Record.*		lda	create_date_time	;is create_date_time = 0?		ora	create_date_time+2		ora	create_date_time+4		ora	create_date_time+6		bne	do_convert		;no - so do the conversion		brl	done			;yes - so we're done		** We're doing a class 0 call.* If create_date = 0 and create_time = 0, then we're done.* Otherwise, convert create_date and create_time into seconds and store in the Cat Record. * If create_date = 0, then don't change the date.* If create_time = 0, then don't change the time.*class0		lda	create_date		;are both create_date and create_time = 0?		ora	create_time		beq	done			;yes - so we're done		lda	create_date		;is create_date = 0?		beq	got_a_zero		;yes		lda	create_time		;no - is create_time = 0?		bne	do_convert		;no; Either create_date or create_time is 0.; Get create date/time from catalog record and convert into class 0 date/time. ; Store results into create_date or create_time (whichever is 0) so that when we convert; from class 0 format date/time into seconds we'll get a valid result.	got_a_zero	pha	 			;push space for result 		pha	 					pea	4			;convert seconds to class0 format date/time 		ldy	<offset			;get offset into Catalog Record		lda	[a1],y			;get lo word of seconds		xba				;change byte sex		tax				;and save		dey		dey		lda	[a1],y			;get hi word of seconds		xba				;change byte sex		pha				;and push		phx				;push lo word of seconds		pea	d0>>16			;push ptr to date/time buffer		pea	d0			;we can use d0 and d1 as a temp buffer		ldx	#ConvSeconds 		;call ConvSeconds routine in Misc Tools		jsl	tool_locator		bcc	conv_ok1		jsr	handle_conv_err		conv_ok1	pla				;pull result off stack (unused)		pla				lda	create_date		;was create_date = 0?		bne	set_time		;no 		lda	d0			;yes - so set it to the current 		sta	create_date		;create_date in the catalog record		bra	do_convert		set_time	lda	d0+2			;create_time was 0 so set it to the 		sta	create_time		;current create_time in the catalog record** Convert create date/time information into seconds and store result in the Catalog Record.*do_convert	pea	0	 		;push space for result (init to 0) 		pea	0	 					pea	5			;convert class0 format date/time to seconds 		lda	class			;check call class		beq	@0			;branch if class 0		lda	#1			;convert class1 format date/time to seconds		sta	1,s@0		pha				;push seconds (unused)		pha		pea	create_date_time>>16	;push ptr to date/time buffer		pea	create_date_time		ldx	#ConvSeconds 		;call ConvSeconds routine in Misc Tools		jsl	tool_locator		bcc	conv_ok2		jsr	handle_conv_err		conv_ok2	ldy	<offset			;get offset into Catalog Record		pla				;pull lo word of result off stack		xba				;change byte sex		sta	[a1],y			;and store in Catalog Record		dey		dey		pla				;pull hi word of result off stack		xba				;change byte sex		sta	[a1],y			;and store in Catalog Record** Indicate no error and exit*		done		clc		rts				ENDP				eject********************************************************************************	 Name:	set_mod_dt** Description:	Sets the mod date/time information for a file/dir.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record*		record_type - Catalog Record type*		storage_type - storage type *		mod_date - modification date (class 0 call)*		mod_time - modification time (class 0 call)*		mod_date_time - modification date and time (class 1 call)**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers*		<temp0*		d0, d1**   Called by:	set_file_info	**	Calls:	handle_conv_err*		ConvSeconds		(Misc. Tools)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************set_mod_dt 	PROC		with	data		offset		equ	temp0			;local equate		** First, get the correct offset into the Catalog Record and save it for later.*		ldy	#fil_mod_dt+2		;get offset into File Record		lda	record_type		;get Catalog Record type		cmp	#cat_fil_type		;are we dealing with a File Record?		beq	save_offset		;yes - so continue 		ldy	#dir_mod_dt+2		;no - so get offset into Dir Recordsave_offset	sty	<offset			;save the offset** Now, determine if we're doing a class 0 or class 1 call.*		lda	class		beq	class0** We're doing a class 1 call.* If mod_date_time = 0, then store the current date/time in the Catalog Record.* Otherwise, convert mod_date_time into seconds and store in the Catalog Record.*		lda	mod_date_time		;is mod_date_time = 0?		ora	mod_date_time+2		ora	mod_date_time+4		ora	mod_date_time+6		beq	store_current		;yes		bra	do_convert		;no - so do the conversion		** We're doing a class 0 call.* If mod_date = 0 and mod_time = 0, then store the current date/time in the Catalog Record. * Otherwise, convert mod_date and mod_time into seconds and store in the Catalog Record.* If mod_date = 0, then get the current date.* If mod_time = 0, then get the current time.*class0		lda	mod_date		;are both mod_date and mod_time = 0?		ora	mod_time		beq	store_current		;yes				lda	mod_date		;is mod_date = 0?		beq	got_a_zero		;yes		lda	mod_time		;no - is mod_time = 0?		bne	do_convert		;no; Either mod_date or mod_time is 0.; Get current date/time and convert into class 0 date/time. ; Store results into mod_date or mod_time (whichever is 0) so that when we convert; from class 0 format date/time into seconds we'll get a valid result.	got_a_zero	pha				;push space for result		pha		pea	4			;convert seconds to class0 format date/time 		lda	time+2			;get hi word of current date/time		pha				;and push		lda	time			;get lo word of current date/time		pha				;and push		pea	d0>>16			;push ptr to date/time buffer		pea	d0			;we can use d0 and d1 as a temp buffer		ldx	#ConvSeconds 		;call ConvSeconds routine in Misc Tools		jsl	tool_locator		bcc	conv_ok1		jsr	handle_conv_err		conv_ok1	pla				;pull result off stack (unused)		pla				lda	mod_date		;was mod_date 0?		bne	set_time		;no 		lda	d0			;yes - so set it to the current date		sta	mod_date				bra	do_convert		set_time	lda	d0+2			;mod_time was 0 so set it to the 		sta	mod_time		;current time ** Convert mod date/time information into seconds and store result in the Catalog Record.*do_convert	pea	0	 		;push space for result (init to 0) 		pea	0	 					pea	5			;convert class0 format date/time to seconds 		lda	class			;check call class		beq	@0			;branch if class 0		lda	#1			;convert class1 format date/time to seconds		sta	1,s@0		pha				;push seconds (unused)		pha		pea	mod_date_time>>16	;push ptr to date/time buffer		pea	mod_date_time		ldx	#ConvSeconds 		;call ConvSeconds routine in Misc Tools		jsl	tool_locator		bcc	conv_ok2		jsr	handle_conv_err		conv_ok2	ldy	<offset			;get offset into Catalog Record		pla				;pull lo word of result off stack		xba				;change byte sex		sta	[a1],y			;and store in Catalog Record		dey		dey		pla				;pull hi word of result off stack		xba				;change byte sex		sta	[a1],y			;and store in Catalog Record						bra	done		** Store the current date/time in the Catalog Record.*store_current	ldy	<offset			;get offset into Catalog Record		lda	time			;get lo word of current date/time		xba				;change byte sex		sta	[a1],y			;and store in Catalog Record		dey		dey		lda	time+2			;get hi word of current date/time		xba				;change byte sex		sta	[a1],y** Indicate no error and exit*		done		clc		rts				ENDP				eject********************************************************************************	 Name:	set_finder_info** Description:	Sets the Finder Info for a file/dir.**	 Note:	The Finder Info is always in 68000 format so the byte sex*		doesn't need to be reversed.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record*		record_type - Catalog Record type*		finder_info - Finder Info **      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers**   Called by:	set_file_info	**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************set_finder_info PROC		with	data** Determine if the Catalog Record we're dealing with is for a file or directory.*		lda	record_type		;get Catalog Record type		cmp	#cat_dir_type		;are we dealing with a directory record?		beq	its_dir			;yes - so branch** We're dealing with a File Record.*		ldy	#fil_finfo1		;get offset to 1st 16 bytes of finder info		ldx	#0			;init offset into input param storagefil_loop	lda	finder_info,x		;copy the bytes		sta	[a1],y				iny		iny		inx						inx		cpx	#32			;done with second half?		beq	done			;yes		cpx	#16			;done with first half?		bne	fil_loop		;no - so loop		ldy	#fil_finfo2		;yes - so get offset to 2nd 16 bytes		bra	fil_loop		;and loop		** We're dealing with a Directory Record.*its_dir		ldy	#dir_finder_info	;get offset to 32 bytes of finder info		ldx	#0			;init offset into input param storagedir_loop	lda	finder_info,x		;copy the bytes		sta	[a1],y				iny		iny		inx						inx		cpx	#32			;done?		bne	dir_loop		;no - so loop** Indicate no error and exit*		done 		clc		rts		ENDP				eject********************************************************************************	 Name:	word_multiply** Description:	Does 16-bit multiplication. *		multiplicand * multiplier = product**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<multiplier - 16 bit multiplier*		<multiplicand - 16 bit multiplicand**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		<product - 32 bit product**	 Uses:	all registers*		<multiplier		*		<multiplicand		*		<product		**   Called by:	get_vol_info*		ablk2pblk*		hfs_init*		bt_loc_tpr*		long_multiply**	Calls:	nothing** Copyright Apple Computer, Inc. 1991  All rights reserved.******************************************************************************word_multiply	PROC		with	data*** added special cases to optimize for the most common multipliers*** 4/2/92 Monte Benaresh		lda <multiplier		cmp #6+1			;in range 0-6?		bcs regular			;no, do it the regular waycase		asl a				;make index		tax		lda <multiplicand		;init low word of product		stz <product+2			;init high word of product		jmp (val_tbl,x)val_tbl		dc.w @0		dc.w case_done			;for times 1		dc.w @2		dc.w @3		dc.w @4		dc.w @5		dc.w @6@0		lda #$0000			;set product to $0000		bra case_done@2		asl a		rol <product+2		bra case_done@3		asl a		rol <product+2		adc <multiplicand		;c = 0		bcc case_done		inc <product+2		bra case_done@4		asl a		rol <product+2		asl a		rol <product+2		bra case_done@5		asl a		rol <product+2		asl a		rol <product+2		adc <multiplicand		;c = 0		bcc case_done		inc <product+2		bra case_done@6		asl a		rol <product+2		adc <multiplicand		;c = 0		bcc @6_no_carry		inc <product+2@6_no_carry		asl a		rol <product+2		; fall through to case_donecase_done		sta <product		rtsregular*** end Monte 4/2/92** Initialize.*		ldx	#16			;init bit count		lda	#0			;init hi word of product to 0		stz	<product 		;init lo word of product to 0** Do the multiplication.*next_bit	lsr	<multiplier		;Shift multiplier right. Bit set?		bcc	align			;no		clc				;yes - so add multiplicand		adc	<multiplicand		;to hi word of product		bcc	align			;branch if no overflow		inc	a			;add in carry bitalign		ror	a			;rotate	hi word of product right		ror	<product		;rotate lo word of product right		dex				;done all bits?		bne	next_bit		;no - so loop		sta	<product+2		;save hi word of product		rts				;and exit		ENDP				eject********************************************************************************	 Name:	long_multiply** Description:	Does 32-bit multiplication. *		multiplicand * multiplier = product**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<multiplier - 32 bit multiplier*		<multiplicand - 32 bit multiplicand**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		<product - 32 bit product**	 Uses:	all registers*		<multiplier		*		<multiplicand		*		<product		**   Called by:	build_fcr*		hfs_init*		et_extend_file*		et_trunc_file*		alloc_blocks**	Calls:	word_multiply** Copyright Apple Computer, Inc. 1987-91  All rights reserved.******************************************************************************long_multiply	PROC		with	data** If the hi words of both the multiplier and multiplicand are 0, then jump* into the word_multiply routine since it's much faster.*		lda	<multiplier+2		ora	<multiplicand+2		bne	@do_long		jmp	word_multiply@do_long** Initialize.*		ldx	#32			;init bit count		lda	#0			;init lo word of product to 0		stz	<product+2		;init hi word of product to 0** Do multiplication and	exit.*next_bit	asl	a			;shift product left		rol	<product+2		asl	<multiplier		;shift multiplier left		rol	<multiplier+2		bcc	align			;branch if bit clear		clc		adc	<multiplicand		;add multiplicand to product		tay		lda	<product+2		adc	<multiplicand+2		sta	<product+2		tyaalign		dex				;done all bits?		bne	next_bit		;no - so loop		sta	<product		;store lo word of product		rts				;and exit				ENDP				eject********************************************************************************	 Name:	word_divide** Description:	Does 16-bit division. *		dividend/divisor = quotient w/remainder**	 Note:	We must zero out the hi word of the quotient and remainder*		before returning since the actual call may have been to*		long_divide or long_divide_up and the caller may expect*		valid information in the hi bytes.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<dividend - 16 bit dividend*		<divisor - 16 bit divisor**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		<dividend - 32 bit quotient	(hi word is 0)*		<remainder - 32 bit remainder	(hi word is 0)**	 Uses:	all registers*		<dividend*		<divisor*		<remainder**   Called by:	hfs_init*		et_log_2_phys*		bt_chk_node*		long_divide**	Calls:	nothing	** Copyright Apple Computer, Inc. 1991  All rights reserved.******************************************************************************word_divide	PROC		with	data*** special case for divisor > $01FF, added 4/1/92 by Monte Benaresh		lda <divisor		cmp #$0200		bcc @regular			;divisor smaller, do normal case	; since the divisor is > $01FF, we can safely do 10 shifts of the	; dividend into the remainder before the remainder could possibly	; exceed the divisor@div_special		lda <dividend		xba				;do this instead of 8 shifts		tax				;save untouched		and #$FF00		sta <dividend		txa				;restore reversed bytes		and #$00FF			;this is remainder value		asl <dividend			;we can do one more shift		rol a		ldx #7				;this many more to go		bra div_loop			;enter standard loop@regular*** end Monte 4/1/92** Initialize.*		ldx	#16			;init bit count		lda	#0			;init remainder** Do division and exit.*div_loop		asl	<dividend		;shift dividend	& quotient left		rol	a			;shift partial dividend	left		cmp	<divisor		;is partial dividend > divisor?		bcc	next_bit		;no		sbc	<divisor		;yes - so subtract divisor		inc	<dividend		;set bit in quotientnext_bit		dex				;done all bits?		bne	div_loop		;no - so loop				sta	<remainder		;store remainder		stz	<remainder+2		;clear out hi word of remainder!		stz	<dividend+2		;clear out hi word of quotient!		rts				;and exit		ENDP				eject********************************************************************************	 Name:	long_divide** Description:	Does 32-bit division. *		dividend/divisor = quotient w/remainder**      Author:	Bryan Atsatt  (adapted from '6502 Software Design')**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<dividend - 32 bit dividend*		<divisor - 32 bit divisor**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		<dividend - 32 bit quotient*		<remainder - 32 bit remainder**	 Uses:	all registers*		<dividend*		<divisor*		<remainder**   Called by:	long_divide_up*		hfs_init*		et_extend_file*		et_log_2_phys*		et_trunc_file*		et_get_rec*		bt_ext_bt_file*		bt_chk_node**	Calls:	word_divide	** Copyright Apple Computer, Inc. 1987-91  All rights reserved.******************************************************************************long_divide	PROC		with	data*** next code added to special-case a divisor of $00000200 since it seems*** to be extremely common regardless of volume size*** -- added 3/30/92 by Monte Benaresh		lda <divisor+2			;any chance of $00000200?		bne @do_long			;no, do the hard way@maybe_200		ldx <divisor		cpx #$0200		bne @check_word			;not $200, but may be able to use						;word divide@divide_200		lda <dividend		and #$01FF		sta <remainder			;this is the remainder		stz <remainder+2		lda <dividend+3		and #$00FF			;this is /$100		lsr a				;this is /$200		tax				;high word in X		lda <dividend+1			;this is /$100		ror a				;this is /$200, with bit shifted						;in from high word		sta <dividend		stx <dividend+2		rts				;division by $200 complete*** end Monte 3/30/92** If the hi words of both the dividend and divisor are 0, then jump* into the word_divide routine since it's much faster.*@check_word					;added 3/30/92 by Monte		;lda	<divisor+2	-- not needed, 3/30/92 Monte		ora	<dividend+2		;bne	@do_long		;jmp	word_divide		beq word_divide			;changed 3/30/92 by Monte@do_long** Initialize.*		ldx	#32			;Get bit count.		stz	<remainder		;Clear remainder.		stz	<remainder+2** Do division and exit.*div_loop	asl	<dividend		;Shift dividend	& quotient left.		rol	<dividend+2		rol	<remainder		;Shift partial dividend	left.		rol	<remainder+2		sec				;Subtract low bytes.		lda	<remainder		sbc	<divisor		tay				;Save low result.		lda	<remainder+2		;Subtract high bytes.		sbc	<divisor+2		;Divisor > dividend?		bcc	next_bit		;Yes.		inc	<dividend		;No, set bit in	quotient.		sty	<remainder		;Enter result in partial dividend.		sta	<remainder+2next_bit	dex				;Done all bits?		bne	div_loop		;No, so	loop.		rts				;Yes, so exit.		ENDP				eject********************************************************************************	 Name:	long_divide_up** Description:	Does 32-bit division then rounds-up the quotient. *		dividend/divisor = quotient (rounded up)**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<dividend - 32 bit dividend*		<divisor - 32 bit divisor**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		<dividend - 32 bit quotient (rounded up)*		<remainder - 0**	 Uses:	all registers*		<dividend*		<divisor*		<remainder**   Called by:	calc_blocks_used*		alloc_blocks**	Calls:	long_divide	** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************long_divide_up	PROC		with	data** First, do a 32-bit division.*		jsr	long_divide** If the remainder is non-zero then clear it and round-up the quotient by 1.*		lda	<remainder		;is the remainder zero?		ora	<remainder+2		beq	exit			;yes - so we're done		stz	<remainder		;no - so clear it		stz	<remainder+2		inc	<dividend		;and bump quotient by 1		bne	exit		inc	<dividend+2exit		rts						ENDP				eject********************************************************************************	 Name:	calc_blocks_used** Description:	Calculates the # of physical blocks used given an eof.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = offset to eof field in Catalog File Record*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog File Record**      Output:	A = undefined*		X = low	word of	physical blocks used*		Y = high word of physical blocks used*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers*		<dividend*		<divisor*		<remainder**   Called by:	get_cat_info	**	Calls:	long_divide_up	** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************calc_blocks_used PROC		with	data		** Set dividend = eof.  If eof = 0 we're done.*		lda	[a1],y			;get hi word of eof		xba				;change byte sex		sta	<dividend+2		;and store		iny		iny		lda	[a1],y			;get lo word of eof		xba				;change byte sex		sta	<dividend		;and store		ora	<dividend+2		;is the eof 0?		beq	get_it			;yes, so no need to divide** Set divisor =	phys_blk_size and do the division.*		lda	#phys_blk_size		;get physical block size		sta	<divisor		;and store		stz	<divisor+2		jsr	long_divide_up		;convert eof to # of physical blocks used** Get # of physical blocks used and exit.*get_it 		ldx	<dividend		;get low word		ldy	<dividend+2		;get high word		clc				;indicate no error		rts				;and exit		ENDP				eject********************************************************************************	 Name:	calc_next_block** Description:	Calculates the block information for the next physical block*		in the file.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_fcr_ptr - ptr to fcr*		file_mark - current file mark*		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		block_mark - block buffer mark*		block_num - # of next physical block in file*		block_count - # physical blocks until end of extent**	 Uses:	all registers**   Called by:	read*		write**	Calls:	log2phys	** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************calc_next_block PROC		with	data** Increment block_num.* 		inc	block_num		;block_num = block_num + 1		bne	cont		inc	block_num+2cont** Decrement block_count.  * If the new block_count = 0 then we have reached the end of the extent.*		sec				;block_count = block_count - 1		lda	block_count		sbc	#1		sta	block_count		lda	block_count+2		sbc	#0		sta	block_count+2		ora	block_count		;is block_count = 0?		bne	got_block		;no** We have reached the end of the extent so there are no more contiguous blocks.* Use the file_mark to find the next physical block #.*		jsr	log2phys** Block_num is now set to the next physical block # in the file.* Block_count is now set to the # of physical blocks until the end of the extent.* Set block_mark to 0.*got_block 	stz	block_mark** Indicate no error and exit.*		clc		rts				ENDP				eject********************************************************************************	 Name:	log2phys** Description:	Converts a file mark to physical block information.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_fcr_ptr - ptr to fcr*		file_mark - current file mark**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		block_mark - block buffer mark*		block_num - physical block #*		block_count - # physical blocks until end of extent**	 Uses:	all registers**   Called by:	calc_next_block*		update_block_buf**	Calls:	et_log_2_phys	** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************log2phys 	PROC		with	data		lda	<my_fcr_ptr		;A3.L <- ptr to fcr		sta	<a3		lda	<my_fcr_ptr+2		sta	<a3+2				lda	file_mark		;D5.L <- file mark		sta	d5		lda	file_mark+2		sta	d5+2				jsr	et_log_2_phys		;convert file mark to physical block info		lda	d3			;D3.L = physical block #		sta	block_num		lda	d3+2		sta	block_num+2				lda	d6			;D6.L = # phys blocks until end of extent		sta	block_count		lda	d6+2		sta	block_count+2		lda	d7			;D7.W = block mark		sta	block_mark** Indicate no error and exit.*		clc		rts				ENDP				eject********************************************************************************	 Name:	ablk2pblk** Description:	Converts an allocation block # into a physical block #.**	Entry:	jsr**	 Exit:	rts**	Input:	A = alloc block #*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		ablk_start - loc of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block**      Output:	A = undefined*		X = lo word of physical block #*		Y = hi word of physical block #*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers*		<multiplicand*		<multiplier*		<product	(aka <source_ptr)**   Called by:	build_vcr*		update_bth*		et_log_2_phys**	Calls:	word_multiply	** Copyright Apple Computer, Inc. 1989-91  All rights reserved.******************************************************************************ablk2pblk	PROC		with	data		** physical block num = (alloc block num * pblks_per_ablk) + ablk_start*		sta	<multiplicand		;multiplicand = alloc block #				lda	pblks_per_ablk		;multiplier = # of phys blks per alloc blk		sta	<multiplier				jsr	word_multiply		;product = multiplier * multiplicand				clc				;now add ablk_start to get the		lda	<product		;physical block number		adc	ablk_start		tax				;store lo word of result in X		lda	<product+2		adc	#0		tay				;store hi word of result in Y				clc				;indicate no error		rts		ENDP		eject********************************************************************************	 Name:	do_displacement** Description:	Uses the current file mark and current eof to calculate a new *		value according to the 'base' and 'displacement' inputs.  **	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		file_mark - current file mark*		eof - current eof*		base - 	0: new value = displacement*			1: new value = eof - displacement*			2: new value = mark + displacement*			3: new value = mark - displacement*		displacement - offset or absolute value**      Output:	A = error code if carry set*		X = lo word of new value*		Y = hi word of new value*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	set_mark*		set_eof**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************do_displacement	PROC		with	data** Branch to the correct handler.*		ldx	base			;get base.  Zero?		beq	base_0			;yes		dex				;no, 1?		beq	base_1			;yes		dex				;no, 2?		beq	base_2			;yes** Base = 3.  New value = mark - displacement.*		sec						lda	file_mark		;get current file mark		sbc	displacement		;subtract the displacement		tax		lda	file_mark+2		sbc	displacement+2		tay		bcc	bad_range		;error if new value < 0		bra	exit			;exit		** Base = 2.  New value = mark + displacement.*base_2		clc						lda	file_mark		;get current file mark		adc	displacement		;add the displacement		tax		lda	file_mark+2		adc	displacement+2		tay		bra	exit			;exit		** Base = 1.  New value = eof - displacement.*base_1		sec						lda	eof			;get current eof		sbc	displacement		;subtract the displacement		tax		lda	eof+2		sbc	displacement+2		tay		bcc	bad_range		;error if new value < 0		bra	exit			;exit		** Base = 0.  New value = displacement.  *base_0		ldx	displacement		;get new absolute value		ldy	displacement+2** Indicate no error and exit.*exit		clc 		rts** Report an out of range error.*bad_range	lda	#out_of_range				sec		rts				ENDP						eject********************************************************************************	 Name:	get_disk_name** Description:	Copies name from the VIB to disk_name.  **	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - ptr to 512 byte general purpose buffer (contains the VIB)**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		disk_name - disk name (in gstring format)**	 Uses:	all registers**   Called by:	id_disk	**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_disk_name	PROC		with	data** Get name length from the VIB and store in disk_name.*		ldy	#vib_volname		;get offset to name in vib		lda	[gbuf_ptr],y		;get name length		and	#$00ff			;only want 1 byte		sta	disk_name		;and save in disk_name		beq	error			;exit if name length = 0** Now, copy the name from the VIB into disk_name.* 		longa	off			;set 8 bit A		sep	#$20		iny	 			;adjust offset to name in vib		ldx	#0			;init offset into disk_name		name_loop	lda	[gbuf_ptr],y		;get byte from vib		sta	disk_name+2,x		;store in disk_name		iny				;adjust offsets		inx		cpx	disk_name				bne	name_loop		;loop until done		lda	#0			;add null to end of string 		sta	disk_name+2,x				longa	on			;restore 16-bit A		rep	#$20** Indicate no error and exit.*		clc						rts		** Return an error.*error		sec		rts		ENDP						eject********************************************************************************	 Name:	get_record_name** Description:	Copies name from the Catalog Key Record	to record_name.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a0 - pointer to Catalog Key Record**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		record_name - name with length byte at start**	 Uses:	all registers**   Called by:	get_dir_entry*		walk_path**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************get_record_name	PROC		with	data** Copy name from Catalog Key Record to record_name.* 		sep	#$30			;set 8-bit mode		longa	off		longi	off		ldy	#cky_name		;get offset to name in Catalog Key Record		lda	[a0],y			;get name length		tax				;and store		clc		adc	#cky_name		;add to name offset		tay				;to create offset to end of name name_loop	lda	[a0],y			;get byte from Catalog Key Record		sta	record_name,x		;store in record_name		dey		dex		bpl	name_loop				rep	#$30			;restore 16-bit mode		longa	on		longi	on** Indicate no error and exit.*		clc		rts				ENDP		eject********************************************************************************	 Name:	get_next_name** Description:	Copies the next name from the pathname to record_name.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_path_ptr - pointer to pathname*		current_offset - offset to name (no validity checking is done!)**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		record_name - name with length byte at start*		current_offset - offset to next name in path**	 Uses:	all registers**   Called by:	walk_path*		get_fcr_name**	Calls:	nothing** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************get_next_name	PROC		with	data** Copy next name from pathname to record_name.*		longa	off			;set 8 bit A		sep	#$20		ldx	#0			;init offset into record_name		ldy	current_offset		;get offset to start of	name in pathmove_loop	lda	[my_path_ptr],y		;Get byte. End of string?		beq	hit_end			;yes		cmp	#separator1		;no, is	it a separator?		beq	hit_end			;yes		sta	record_name+1,x		;no - so add to buffer		iny				;bump offsets		inx		bra	move_loop		;loophit_end		txa				;put length in A (so it's 8 bit)		sta	record_name		;save length		iny				;skip over separator		sty	current_offset		;update current_offset				longa	on			;set 16	bit A		rep	#$20** Indicate no error and exit.*		clc						rts						ENDP		eject********************************************************************************	 Name:	get_fcr_name** Description:	Extracts the filename from the fcr pathname and copies it to record_name.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_fcr_ptr - pointer to fcr**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		record_name - name with length byte at start**	 Uses:	all registers*		<my_path_ptr*		current_offset**   Called by:	flush*		get_dir_entry**	Calls:	get_next_name*		deref		(system service)** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************get_fcr_name	PROC		with	data** Get the pathname vp out of the fcr, dereference it and store the ptr on direct page.* The pathname is in gstring format.*		ldy	#fcr_path_name		lda	[my_fcr_ptr],y		tax				;put lo word of vp in X		iny		iny		lda	[my_fcr_ptr],y		tay				;put hi word of vp in Y		jsl	deref			;dereference the vp		stx	<my_path_ptr		;save the pointer on direct page		sty	<my_path_ptr+2** Determine the offset of the start of the filename and store it in current_offset.* Work backwards from the end of the pathname to find the start of the filename.*		lda	[my_path_ptr]		;get length of pathname		inc	a			;adjust for extra length byte		tay				longa	off			;set 8 bit A		sep	#$20loop		lda	[my_path_ptr],y		;get byte		cmp	#separator1		;is it a separator?		beq	hit_sep			;yes		dey				;no - so decrement offset		bra	loop			;and loophit_sep		iny				;don't count separator		sty	current_offset		;store offset in current_offset		longa	on			;set 16	bit A		rep	#$20** Copy the filename from the pathname into record_name.*		jsr	get_next_name** Indicate no error and exit.*		clc						rts						ENDP		eject********************************************************************************	 Name:	id_disk** Description:	Determines whether or not the media chosen is in HFS format.*		If so and there	is no VCR for it, one is created and marked active.*		If there is an existing VCR then it is marked active.**	Entry:	jsr**	 Exit:	rts **	Input:	A = device number*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		cp_device_flag - 1 if doing a ChangePath call and source is device #**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<gbuf_ptr - ptr to 512 byte general purpose buffer (contains the VIB)*		<drvr_dev_num - device number*		<my_vcr_ptr - ptr to vcr*		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**	 Uses:	all registers*		<temp0*		<source_ptr	(aka <product)*		<dest_ptr	*		id_disk_flag**   Called by:	process_path*		scan_devices*		volume**	Calls:	gbuf_read*		get_disk_name*		build_vcr*		setup_vcr_info*		copy_long*		find_vcr		(system service)*		deref			(system service)*		release_vcr		(system service)*		swap_out		(system service)** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************id_disk		PROC		with	data** Set device number and make sure id_disk_flag is set.*		sta	<drvr_dev_num		;set device number		inc	id_disk_flag		;set id_disk_flag** Read the VIB into the general purpose buffer.*		ldx	#vib_block		;lo word of physical block to read		ldy	#0			;hi word of physical block to read		jsr	gbuf_read		;read in the block.		bcc	got_vib					cmp	#drvr_bad_block		;did we get a volume too small error?		beq	brl_not_hfs		;yes - so make into a bouncer		brl	error			;no -  some other errorgot_vib** Ok, now look at the signature word.* 		ldy	#vib_signature		;get offset to signature word		lda	[gbuf_ptr],y		;get word		xba				;change byte sex		cmp	#hfs_signature		;match?		beq	sig_ok			;yesbrl_not_hfs	brl	not_hfs			;no - so not HFSsig_ok** The signature word is OK so now verify that the allocation block size is OK.*		ldy	#vib_ablk_size+2	;get offset to allocation block size		lda	[gbuf_ptr],y		;get lo word		tax				;save		dey						dey		ora	[gbuf_ptr],y		;OR lo word with the hi word 			beq	brl_bad_vib		;error if ablk_size is 0		txa				;retrieve lo word		xba				;change byte sex		and	#$01ff			;make sure it's a multiple of 512		bne	brl_bad_vib		;error if not** We have an HFS disk.  Copy name from VIB into disk_name.*		jsr	get_disk_name		bcc	got_namebrl_bad_vib	brl	bad_vibgot_name** If change_path's duplicate volume bit is set in cp_flags, then force a fake VCR* to be built (as if we'd found a duplicate volume).  5-Dec-91 MSD*		bit	cp_flags		;renaming a duplicate volume?		bpl	@no_dup			;no, so do the usual		brl	is_open			;pretend duplicate volume with files open		@no_dup** Check to see if we already have a VCR with this name.  If not, build a new vcr.*		lda	#0000			;select	search by name		ldx	#disk_name		;get pointer to	disk name		ldy	#^disk_name		jsl	find_vcr		;is there already a vcr with this name?		bcc	found_vcr		;yes		brl	new_vcr			;no - so make a new onefound_vcr** We already have a VCR with this name.  Check to see if it's an HFS vcr.* If is isn't then we have a duplicate volume.*		jsl	deref			;dereference VP		stx	<my_vcr_ptr		;save pointer		sty	<my_vcr_ptr+2		ldy	#vcr_fst_id		;get offset to fst id		lda	[my_vcr_ptr],y		;get the id		cmp	#hfs_id			;is it an HFS vcr?		bne	check_open		;no - so check if we can toss it** It's an HFS vcr.* Check some of the fields of the VIB and VCR to see if they match.* If they don't match then we have a duplicate volume.*		ldy	#vib_create_dt+2	;first check the create date/time		ldx	#vcr_create_dt				jsr	compare_long		;match?		bne	check_open		;no				ldy	#vib_free_ablks		;check # of unused alloc blocks		ldx	#vcr_free_ablks		jsr	compare_word		;match?		bne	check_open		;no				ldy	#vib_next_id+2		;check next file/dir id		ldx	#vcr_next_id		jsr	compare_long		;match?		bne	check_open		;no		ldy	#vib_num_files+2	;check # of files		ldx	#vcr_num_files		jsr	compare_long		;match?		bne	check_open		;no				ldy	#vib_num_dirs+2		;check # of dirs		ldx	#vcr_num_dirs		jsr	compare_long		;match?		bne	check_open		;no		ldy	#vib_num_r_files	;check # of files in root dir		ldx	#vcr_num_r_files		jsr	compare_word		;match?		bne	check_open		;no		ldy	#vib_num_r_dirs		;check # of dirs in root dir		ldx	#vcr_num_r_dirs		jsr	compare_word		;match?		bne	check_open		;no** The VCR appears to be for this volume.  * Copy the mod_dt and write_cnt fields from the VIB to the VCR in case they've changed.* (If we looked at the disk on a Mac, the mod_dt and write_cnt fields we're updated.)* Update the last known device and activate the VCR.*		lda	<gbuf_ptr		;setup source ptr		sta	<source_ptr		lda	<gbuf_ptr+2		sta	<source_ptr+2				lda	<my_vcr_ptr		;setup destination ptr		sta	<dest_ptr		lda	<my_vcr_ptr+2		sta	<dest_ptr+2				ldy	#vib_mod_dt		;get starting source offset		ldx	#vcr_mod_dt		;get starting dest offset		jsr	copy_long		;copy mod_dt		ldy	#vib_write_cnt		;adjust source offset		ldx	#vcr_write_cnt		;adjust dest offset		jsr	copy_long		;copy write_cnt		ldy	#vcr_dev				lda	<drvr_dev_num		;get current device #		sta	[my_vcr_ptr],y		;and update vcr		brl	do_activate		;continue		** We have a duplicate volume.  * If there are no open files then release the VCR and build a new one, * otherwise exit with a duplicate volume error.* Note - If we get a duplicate volume error and cp_device_flag = 1 then ignore* 	 the error since we are doing a ChangePath call with a device # as the source.*check_open	ldy	#vcr_open_cnt		;get offset to open count		lda	[my_vcr_ptr],y		;any open files?		beq	not_open		;nois_open						;(added label 5-Dec-91 MSD)		lda	cp_device_flag		;are we doing a special ChangePath call?		beq	dup_vol			;no - so report a duplicate volume error		ora	#$8000			;yes - so indicate we got a dup vol error		sta	cp_device_flag		lda	<drvr_dev_num		; 5-Feb-92 MSD: force other VCR's for this device		jsl	swap_out		; 5-Feb-92 MSD: to be swapped out		bra	new_vcr			;and continue		not_open	lda	[my_vcr_ptr]		;get the volume ID		jsl	release_vcr		;release the vcr** Ok, we need to allocate a new VCR.*new_vcr		jsr	build_vcr		bcs	exit** Activate the VCR.*do_activate	ldy	#vcr_status				lda	[my_vcr_ptr],y		;get vcr status word		and	#vcr_swapped_in		;clear swapped bit		sta	[my_vcr_ptr],y		** Setup VCR information.*		jsr	setup_vcr_info** Indicate no error.*		clc				** Clear id_disk_flag and exit.*exit		stz	id_disk_flag		rts				** It's an HFS disk but the VIB is damaged so treat it as an unknown volume.*bad_vib		bra	not_hfs				** Not an HFS disk.  Exit with unknown volume error.*not_hfs		lda	#unknown_vol		;get error code		sec				;indicate error		bra	exit			;return the error** Exit with duplicate volume error.*dup_vol		lda	#dup_volume		;get error code		sec				;indicate error		bra	exit			;return the error		** Return an error.*error		sec				;indicate error		bra	exit;------------------------------------------------------------------------------; compare_word and compare_long routines;; Input:	Y - contains offset into vib;		X - contains offset into vcr;; Returns z=1 if word or long matches.; Returns z=0 if word or long doesn't match.;------------------------------------------------------------------------------compare_word 	lda	[gbuf_ptr],y		;get word from vib		xba				;change byte sex		txy		cmp	[my_vcr_ptr],y		;does it match word in vcr?		rts				;return result of comparecompare_long	sty	<temp0			;save vib offset		jsr	compare_word		;compare lo word 		bne	compare_exit		;exit if lo word doesn't match		tyx				;get vcr offset back in X		inx				;and adjust		inx		ldy	<temp0			;get vib offset back in Y		dey				;and adjust		dey		jsr	compare_word		;compare hi wordcompare_exit	rts				;return result of compare		ENDP				eject********************************************************************************	 Name:	build_vcr** Description:	Creates	a new VCR.  **	 NOTE:  Should only be called by id_disk!!**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<gbuf_ptr - ptr to 512 byte general purpose buffer (contains the VIB)*		<drvr_dev_num - device number*		disk_name - disk name*		cp_device_flag - $8001 if doing a ChangePath call with device # as source *				 and got a duplicate volume error from id_disk**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<my_vcr_ptr - ptr to vcr*		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree*		<drvr_dev_num - device number**	 Uses:	all registers*		<dev_id_ref*		<drvr_call_num*		<temp0*		<temp1*		<source_ptr	(aka <product)*		<dest_ptr	**   Called by:	id_disk	**	Calls:	ablk2pblk*		gbuf_read	*		setup_vcr_info*		release_tree_fcrs*		copy_word*		copy_long*		copy_ext*		alloc_vcr		(system service)*		alloc_fcr		(system service)*		release_vcr		(system service)*		deref			(system service)*		dev_dispatcher		(system service)** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************build_vcr	PROC		with	datatemp_flag	equ	source_ptr		;local equate** First, allocate a new VCR.* Note - If cp_device_flag = $8001 then we need to use a fake name for the VCR * 	 since id_disk got a duplicate volume error. *		ldx	#disk_name		;point to disk name		ldy	#^disk_name		lda	cp_device_flag		;do we need to use fake name for vcr?		bpl	@cont			;no		ldx	#fake_name_str		;yes - so point to fake name string		ldy	#^fake_name_str		@cont		lda	#len_vcr		;get size of vcr		jsl	alloc_vcr		;allocate new vcr		bcs	mem_error				jsl	deref			;dereference vp		stx	<my_vcr_ptr		;save vcr ptr		sty	<my_vcr_ptr+2** Now, allocate an FCR for the CTree. *		lda	<path_flag		;get current path flag		sta	<temp_flag		;and save		stz	<path_flag		;make sure SCM uses our string for the fcr				lda	#len_t_fcr		;get size of fcr		ldx	#ctree_str		;point to special name string		ldy	#^ctree_str		jsl	alloc_fcr		;allocate new fcr		bcc	ct_fcr_ok		mem_error	lda	#out_of_mem		;exit with out of memory error		rts ct_fcr_ok	phy				;save hi word of vp		phx				;save lo word of vp		jsl	deref			;dereference vp		stx	ctree_fcr_ptr		;save fcr ptr		sty	ctree_fcr_ptr+2		stx	<temp0			;also store ptr on direct page		sty	<temp0+2				ldy	#vcr_ct_fcr_vp		;retrieve the vp and store in the vcr		pla		sta	[my_vcr_ptr],y		iny		iny		pla		sta	[my_vcr_ptr],y				ldy	#vcr_ct_ref_num			lda	[temp0]			;get the refnum from the fcr		sta	[my_vcr_ptr],y		;and store in the vcr				ldy	#fcr_level		;force the fcr to be at 'system level'			lda	[temp0],y		;(hi bit clear) so it won't be closed by		and	#$7fff			;a CLOSE call with refnum=0 (close all)		sta	[temp0],y** Now, allocate an FCR for the ETree. *		lda	#len_t_fcr		;get size of fcr		ldx	#etree_str		;point to special name string		ldy	#^etree_str		jsl	alloc_fcr		;allocate new fcr		bcs	mem_error				phy				;save hi word of vp		phx				;save lo word of vp		jsl	deref			;dereference vp		stx	etree_fcr_ptr		;save fcr ptr		sty	etree_fcr_ptr+2		stx	<temp1			;also store ptr on direct page		sty	<temp1+2				ldy	#vcr_et_fcr_vp		;retrieve the vp and store in the vcr		pla		sta	[my_vcr_ptr],y		iny		iny		pla		sta	[my_vcr_ptr],y		ldy	#vcr_et_ref_num			lda	[temp1]			;get the refnum from the fcr		sta	[my_vcr_ptr],y		;and store in the vcr				ldy	#fcr_level		;force the fcr to be at 'system level'			lda	[temp1],y		;(hi bit clear) so it won't be closed by		and	#$7fff			;a CLOSE call with refnum=0 (close all)		sta	[temp1],y				lda	<temp_flag		;restore original path flag		sta	<path_flag** Initialize some of the fields in the VCR.*		ldy	#vcr_status		;get offset to status		lda	#vcr_swapped		;init to swapped and write_protected		sta	[my_vcr_ptr],y		ldy	#vcr_fst_id		;get offset to fst id		lda	#hfs_id			;get id		sta	[my_vcr_ptr],y		;save it		ldy	#vcr_dev		;get offset to device		lda	<drvr_dev_num		;get current device		sta	[my_vcr_ptr],y		;save it** Initialize some of the fields in the CTree and ETree FCRs.*		ldy	#fcr_fst_id		;get offset to fst id		lda	#hfs_id			;get id		sta	[temp0],y		;save it in the ctree fcr		sta	[temp1],y		;and the etree fcr		ldy	#fcr_vol_id		;get offset to vol id		lda	[my_vcr_ptr]		;get volume id from vcr		sta	[temp0],y		;save it in the ctree fcr		sta	[temp1],y		;and the etree fcr		ldy	#fcr_access		;get offset to access		lda	#invisible		;get 'invisible' access		ora	#global_clean_bit	;mark file clean		sta	[temp0],y		;save it in the ctree fcr		sta	[temp1],y		;and the etree fcr				ldy	#fcr_type		;get offset to fcr type		lda	#fcr_tree_type		;get 'tree' type		sta	[temp0],y		;save it in the ctree fcr		sta	[temp1],y		;and the etree fcr				ldy	#fcr_parent_id		;get offset to parent id		lda	#vol_parent_id		;get volume parent id		sta	[temp0],y		;save it in the ctree fcr		sta	[temp1],y		;and the etree fcr				ldy	#fcr_id			;get offset to file/dir id		lda	#ctree_file_id		;get ctree file id		sta	[temp0],y		;save it in the ctree fcr		lda	#etree_file_id		;get etree file id		sta	[temp1],y		;save it in the etree fcr** Initialize some of the fields in the CTree BCR and the ETree BCR (within the FCRs). *		ldx	#0			;get offset to start of bcr data		ldy	#bcr_key_cmp_ptr  	;get offset into bcrbcr_loop	lda	ctree_bcr_data,x	;get CTree data word  		sta	[temp0],y		;store word in CTree bcr		lda	etree_bcr_data,x	;get ETree data word 		sta	[temp1],y		;store word in ETree bcr		inx				;increment both offsets to next word		inx		iny		iny		cpx	#len_bcr_data		;are we done with all the data?		bne	bcr_loop		;no - so continue** Now copy information from the VIB into the appropriate fields in the VCR.*		lda	<gbuf_ptr		;setup source ptr		sta	<source_ptr		lda	<gbuf_ptr+2		sta	<source_ptr+2				lda	<my_vcr_ptr		;setup destination ptr		sta	<dest_ptr		lda	<my_vcr_ptr+2		sta	<dest_ptr+2				ldy	#vib_create_dt		;get starting source offset		ldx	#vcr_create_dt		;get starting dest offset		jsr	copy_long		;copy create_dt		jsr	copy_long		;copy mod_dt		jsr	copy_word		;copy vol_attrib 		jsr	copy_word		;copy num_r_files		jsr	copy_word		;copy vbm_start		jsr	copy_word		;copy alloc_start		jsr	copy_word		;copy num_ablks		jsr	copy_long		;copy ablk_size		jsr	copy_long		;copy fclump_size		jsr	copy_word		;copy ablk_start		jsr	copy_long		;copy next_id		jsr	copy_word		;copy free_ablks				ldy	#vib_write_cnt		;adjust source offset 		jsr	copy_long		;copy write_cnt				ldy	#vib_num_r_dirs		;adjust source offset		jsr	copy_word		;copy num_r_dirs		jsr	copy_long		;copy num_files		jsr	copy_long		;copy num_dirs** Now copy information from the VIB into the appropriate fields in the CTree FCR.* 		lda	ctree_fcr_ptr		;setup destination ptr		sta	<dest_ptr		lda	ctree_fcr_ptr+2		sta	<dest_ptr+2				ldy	#vib_cclump_size	;get starting source offset		ldx	#fcr_clump_size		;get starting dest offset 		jsr	copy_long		;copy cclump_size				ldy	#vib_ctree_peof		;adjust source offset		ldx	#fcr_peof		;adjust dest offset		jsr	copy_long		;copy ctree_peof		jsr	copy_ext		;copy ctree_ext (6 words)** Now copy information from the VIB into the appropriate fields in the ETree FCR.* 		lda	etree_fcr_ptr		;setup destination ptr		sta	<dest_ptr		lda	etree_fcr_ptr+2		sta	<dest_ptr+2				ldy	#vib_eclump_size	;get starting source offset		ldx	#fcr_clump_size		;get starting dest offset 		jsr	copy_long		;copy eclump_size				ldy	#vib_etree_peof		;adjust source offset		ldx	#fcr_peof		;adjust dest offset		jsr	copy_long		;copy etree_peof		jsr	copy_ext		;copy etree_ext (6 words)** Setup ablk_start and pblks_per_ablk since they're needed by the ablk2pblk routine.* 			jsr	setup_vcr_info** Read in the CTree header node, verify it, and copy information from the * header record into the CTree BCR.*		lda	ctree_fcr_ptr		;put ptr to ctree fcr back on direct page		sta	<temp0			;since temps are undefined at this point		lda	ctree_fcr_ptr+2		sta	<temp0+2				ldy	#fcr_ext		;get offset to 1st ext descriptor in fcr		lda	[temp0],y		;get # of ablk which contains header node		xba				;change byte sex		jsr	ablk2pblk		;convert to physical block # (in X,Y)		jsr	gbuf_read		;read in the block  		bcs	bcs_error		jsr	verify_hdr		;verify the header node		bcs	bcs_bad_hdr				lda	<gbuf_ptr		;setup source ptr		sta	<source_ptr		lda	<gbuf_ptr+2		sta	<source_ptr+2				lda	ctree_fcr_ptr		;setup destination ptr		sta	<dest_ptr		lda	ctree_fcr_ptr+2		sta	<dest_ptr+2				ldy	#len_nd			;get starting source offset		ldx	#bcr_depth		;get starting dest offset 		jsr	copy_word		;copy depth		jsr	copy_long		;copy root_node		jsr	copy_long		;copy num_leaves		jsr	copy_long		;copy first_node		jsr	copy_long		;copy last_node		jsr	copy_word		;copy node_size		jsr	copy_word		;copy max_key		jsr	copy_long		;copy num_nodes		jsr	copy_long		;copy free_nodes** Read in the ETree header node, verify it, and copy information from the * header record into the ETree BCR.*		lda	etree_fcr_ptr		;put ptr to etree fcr back on direct page		sta	<temp1			;since temps are undefined at this point		lda	etree_fcr_ptr+2		sta	<temp1+2				ldy	#fcr_ext		;get offset to 1st ext descriptor in fcr		lda	[temp1],y		;get # of ablk which contains header node		xba				;change byte sex		jsr	ablk2pblk		;convert to physical block # (in X,Y)		jsr	gbuf_read		;read in the block  bcs_error	bcs	error		jsr	verify_hdr		;verify the header nodebcs_bad_hdr	bcs	bad_hdr				lda	<gbuf_ptr		;setup source ptr		sta	<source_ptr		lda	<gbuf_ptr+2		sta	<source_ptr+2				lda	etree_fcr_ptr		;setup destination ptr		sta	<dest_ptr		lda	etree_fcr_ptr+2		sta	<dest_ptr+2				ldy	#len_nd			;get starting source offset		ldx	#bcr_depth		;get starting dest offset 		jsr	copy_word		;copy depth		jsr	copy_long		;copy root_node		jsr	copy_long		;copy num_leaves		jsr	copy_long		;copy first_node		jsr	copy_long		;copy last_node		jsr	copy_word		;copy node_size		jsr	copy_word		;copy max_key		jsr	copy_long		;copy num_nodes		jsr	copy_long		;copy free_nodes** Now, do a GET_DIB_PTR call on the current device.  This will set drvr_dib_ptr up on * direct page so that we can get the volume's block count and store it in the vcr.*		lda	<drvr_dev_num		;get current device num		pha				;save it		sta	<dev_id_ref		;and store as the device id		stz	<drvr_dev_num		;device $00 = special internal calls		lda	#1		sta	<drvr_call_num		;call $01 = GET_DIB_PTR		jsl	dev_dispatcher		pla				;retrieve current device num		sta	<drvr_dev_num				ldy	#dib_blk_cnt		;get offset to block count in the DIB		lda	[drvr_dib_ptr],y	;get lo word of block count		ldy	#vcr_num_pblks		sta	[my_vcr_ptr],y		;and store in vcr		ldy	#dib_blk_cnt+2					lda	[drvr_dib_ptr],y	;get hi word of block count		ldy	#vcr_num_pblks+2		sta	[my_vcr_ptr],y		;and store in vcr** Indicate no error and exit.*		clc		rts		** An error occured, free the VCR and FCRs before exiting.*bad_hdr		lda	#damaged_bitmap		;was unknown_vol (changed 7-Nov-91 MSD)		error		pha				;save error code		lda	[my_vcr_ptr]		;get the volume	ID		jsl	release_vcr		;release the vcr		pla				;recover the error		sec				;indicate error		rts				;exit		;------------------------------------------------------------------------------; verify_hdr routine;; Returns c=0 if header node OK, else returns c=1.;------------------------------------------------------------------------------verify_hdr	ldy	#len_nd+hdr_node_size	 		lda	[gbuf_ptr],y		;get node size from header record		xba				;change byte sex		cmp	#node_size		bne	verify_err		;error if node size not 512				ldy	#len_nd+hdr_depth 		lda	[gbuf_ptr],y		;get tree depth from header record		xba				;change byte sex		cmp	#max_btree_depth+1			bcs	verify_err		;error if > maximum allowed tree depth		ldy	#len_nd+hdr_num_nodes 		lda	[gbuf_ptr],y		;get # of nodes from header record		xba				;change byte sex		sta	<temp0			;and save for verify_it routine below		iny		iny 		lda	[gbuf_ptr],y				xba				;change byte sex		sta	<temp0+2		ldy	#len_nd+hdr_free_nodes 	;first verify the # of free nodes		jsr	verify_it		bcs	verify_err				ldy	#len_nd+hdr_root_node	;now verify the root node #		jsr	verify_it		bcs	verify_err				ldy	#len_nd+hdr_first_node  ;now verify the first leaf node #		jsr	verify_it		bcs	verify_err				ldy	#len_nd+hdr_last_node   ;now verify the last leaf node #		jsr	verify_it		bcs	verify_err		rts				;we're doneverify_err	sec				;indicate error		rts				;and return;------------------------------------------------------------------------------; verify_it routine;; Input:	Y - contains offset to value being verified;		<temp0 - contains # of nodes; Returns c=0 if value being verified is < # of nodes; Returns c=1 if value being verified is >= # of nodes;------------------------------------------------------------------------------verify_it 	lda	[gbuf_ptr],y		;get hi word of value being verified				xba				;change byte sex		cmp	<temp0			;compare it to hi word of # of nodes				bcc	verify_exit		;if it's < # of nodes then ok		beq	verify_equal		;if it's = # of nodes then check lo word		bcs	verify_exit		;if it's > # of nodes then errorverify_equal	iny						iny 		lda	[gbuf_ptr],y		;get lo word of value being verified		xba				;change byte sex		cmp	<temp0+2		;compare it to lo word of # of nodesverify_exit	rts				;return						ENDP				eject********************************************************************************	 Name:	setup_vcr_info ** Description:	Sets up ablk_size, ablk_start and pblks_per_ablk.*		Creates ptrs to CTree fcr and ETree fcr.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined.*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - pointer to current vcr**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**		ablk_size - allocation block size in bytes*		ablk_start - location of first alloc block (P blk #)*		pblks_per_ablk - # of physical blocks per alloc block*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**	 Uses:	all registers*		<temp0**   Called by:	setup_call*		process_path*		build_vcr*		id_disk**	Calls:	nothing		** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************setup_vcr_info	PROC		with	data** Setup ablk_size and ablk_start.*		ldy	#vcr_ablk_start		;Get offset to alloc block start.		lda	[my_vcr_ptr],y		;Get word		sta	ablk_start		;and save it.		ldy	#vcr_ablk_size		;Get offset to alloc block size.		lda	[my_vcr_ptr],y		;Get lo word of size		sta	ablk_size		;and save it.		sta	<temp0			;also store in <temp0 for later		iny		iny		lda	[my_vcr_ptr],y		;Get hi word of size		sta	ablk_size+2		;and save it.		sta	<temp0+2		;also store in <temp0+2 for later** Convert ablk_size from bytes to physical blocks and store in pblks_per_ablk.* 		ldx	#9			;# of bits to shift		loop		lsr	<temp0+2		;divide by 512 to convert		ror	<temp0			;from bytes to physical blocks		dex		bne	loop				lda	<temp0			;store result in pblks_per_ablk		sta	pblks_per_ablk** Get pointers to the CTree fcr and the ETree fcr.*		ldy	#vcr_ct_fcr_vp		;get offset to the vp for the CTree fcr		lda	[my_vcr_ptr],y		;get lo word of vp		tax				;store in X		iny		iny		lda	[my_vcr_ptr],y		;get hi word of vp		tay				;store in Y		jsl	deref			;dereference the vp		stx	ctree_fcr_ptr		;save pointer		sty	ctree_fcr_ptr+2		ldy	#vcr_et_fcr_vp		;get offset to the vp for the ETree fcr		lda	[my_vcr_ptr],y		;get lo word of vp		tax				;store in X		iny		iny		lda	[my_vcr_ptr],y		;get hi word of vp		tay				;store in Y		jsl	deref			;dereference the vp		stx	etree_fcr_ptr		;save pointer		sty	etree_fcr_ptr+2** Indicate no error and exit.*		clc						rts				ENDP				eject********************************************************************************	 Name:	ensure_vol_online  ** Description:	Makes sure volume is online. Calls mount_message if needed.*		Sets drvr_dev_num to the current location.  Activates vcr.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - pointer to vcr**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<drvr_dev_num - device number **	 Uses:	all registers**   Called by:	read*		write*		flush*		set_mark*		set_eof*		get_dir_entry**	Calls:	find_our_volume*		update_status** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************ensure_vol_online PROC		with	data** Has the VCR been marked as swapped?* 		ldy	#vcr_status				lda	[my_vcr_ptr],y		;get status word		and	#vcr_swapped		;swapped?		bne	find_vol		;yes - so must search for volume** No - so get the current status of the device where the volume was last seen. * If carry clear then the volume is still online.* If carry set then we need to search for the volume.*		jsr	update_status		;get the current device status		bcc	exit			;the volume is still online*	* Attempt to find the volume.  Call mount_message if needed.  * Set <drvr_dev_num to current location of volume.  Activate the vcr.*find_vol	jsr	find_our_volume		exit		rts		ENDP		eject********************************************************************************	 Name:	update_status  ** Description:	Gets the current status of the device where a volume was last seen. **	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - pointer to vcr*		wp_status_flag - set to 0**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = volume has been switched*			   0 = volume has not been switched*		B = K**		<drvr_dev_num - device number *		wp_status_flag - non-zero if we know volume is write-protected**	 Uses:	all registers*		wp_status_flag**   Called by:	ensure_vol_online*		process_path**	Calls:	do_status_call** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************update_status 	PROC		with	data** Set <drvr_dev_num to the device where the volume was last seen and do a* Status call to that device.  If the disk has been ejected, the 'switched' bit* will be set in the device status word.* Note - if the disk has been ejected, the device dispatcher will call the * swap_out routine in SCM before returning from the Status call.  The swap_out* routine will set the VCR status to 'vcr_swapped' and 'vcr_wr_unknown'.  *		ldy	#vcr_dev		lda	[my_vcr_ptr],y		;get device #		sta	<drvr_dev_num		;and set up <drvr_dev_num		jsr	do_status_call		;do a Status call to the device		bcs	exit			;got an error** If the volume has been switched then return carry set.*		sec		lda	status_list		;get status word		tax				;save in X		and	#switched_bit		;has disk been switched? 		bne	exit			;yes - so return carry set** The volume has not been switched so let's update the write_protect status.*		txa				;retrieve status word		and	#protected_bit		;is the disk write-protected?		bne	wr_protected		;yes - so branch** The volume is write enabled.* Set the 'vcr_wr_enable' bit in the vcr status word.*		ldy	#vcr_status		lda	[my_vcr_ptr],y		;get the vcr status word		ora	#vcr_wr_enable		;set the 'vcr_wr_enable' bit		sta	[my_vcr_ptr],y			bra	done				** The volume is write-protected.* Clear the 'vcr_wr_enable' bit in the vcr status word and set wp_status_flag.*wr_protected	ldy	#vcr_status		lda	[my_vcr_ptr],y		;get the vcr status word		and	#vcr_wr_unknown		;clear the 'vcr_wr_enable' bit		sta	[my_vcr_ptr],y			inc	wp_status_flag		;set flag to indicate vol is write-protected** Indicate no error and exit.*done		clc				exit		rts								ENDP				eject********************************************************************************	 Name:	find_our_volume** Description:	Looks for a volume whose name matches that in <my_vcr_ptr.*		Calls mount_message if needed.*		Updates the device number in the vcr and marks the vcr active.*		Returns an error if the volume is not found.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - pointer to vcr**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<drvr_dev_num - device number**	 Uses:	all registers*		volname*		<temp0**   Called by:	ensure_vol_online*		do_rw_call**	Calls:	scan_devices*		mount_message	(system service)*		deref		(system service)** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************find_our_volume	PROC		with	data** Get pointer to the vcr name and move it to volname.*		ldy	#vcr_name		;Point to low word of name vp.		lda	[my_vcr_ptr],y		;Get low word.		tax				;Put in	X.		iny				;Point to high word.		iny		lda	[my_vcr_ptr],y		;Get high word.		tay				;Put in	Y.		jsl	deref			;Dereference it.		stx	<temp0			;Save pointer.		sty	<temp0+2		lda	[temp0]			;Get length.		and	#$00ff			;Clear high byte.		tay				;Use as	index.		iny				;Point to last char.		longa	off			;Set 8 bit A.		sep	#$20		lda	#0			;Get zero.		sta	volname+1,y		;Delimit string.copy_loop	lda	[temp0],y		;Move byte.		sta	volname,y		dey				;Done all?		bpl	copy_loop		;Nope, so loop.		longa	on			;Set 16	bit A.		rep	#$20** Scan the devices to try to find the volume.	*mount_loop	jsr	scan_devices				bcc	done		** We didn't find the volume, so put up a mount message.  * First make volume name a class 0 name with a leading slash, put up the message,  * then restore volume name.  *		lda	volname			;Get length word.		pha				;Save it.		inc	a			;Make it one longer.		ora	#$2f00			;Add a slash (name must	be <256	chars!)		sta	volname			;Save it.		pea	volname>>16		;Push address of volume	name string.		pea	volname		lda	#0001		jsl	mount_message		;Do message.		plx				;Restore volname.		stx	volname		pha				;Save button status.		pla				;Ok button pressed?		beq	mount_loop		;Yes, so loop to re-try	scan_devices.** 'Cancel' button was pressed so exit with a vol_not_found error.* 		lda	#vol_not_found		;get error code		sec						rts				** Indicate no error and exit*done		clc		rts				ENDP				eject********************************************************************************	 Name:	scan_devices** Description:	Scans the devices looking for the specified volume.*		If the volume is found, a vcr is built if none exists.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		volname - volume name to match*		<my_vcr_ptr - pointer to vcr or 0 if no vcr**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<drvr_dev_num - device number found*		<my_vcr_ptr - pointer to vcr**	 Uses:	all registers*		current_device*		start_device**   Called by:	process_path*		find_our_volume**	Calls:	id_disk** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************scan_devices	PROC		with	data** Initialize.*		stz	start_device		;clear start device		lda	#0001			;init current device to	1		sta	current_device** First, check to see if we already have a vcr.*		lda	<my_vcr_ptr		ora	<my_vcr_ptr+2		;do we have a vcr?		beq	id_disk_loop		;no** We have a vcr so get device # and setup to check it first.* 		ldy	#vcr_dev				lda	[my_vcr_ptr],y		;get device #		sta	current_device		;set current device		sta	start_device		;set start device** Main loop.* ID the disk in 'current_device'.  * If we get a 'device not found' or 'duplicate volume' error then exit.* If we get any other error, then continue the search.*id_disk_loop	lda	current_device		;get current device #		jsr	id_disk			;id the disk		bcc	compare_names				cmp	#dup_volume		;duplicate volume error?		beq	error			;yes - so exit		cmp	#invalid_dev_num	;device not found error?		bne	no_match		;no - so continue search		lda	#vol_not_found		;yes - so change error codeerror		sec				;indicate error		rts				;exit		** No error from	id_disk.  * Compare the disk's name with volname.  If it matches we're done. * Note - we have to do a case-insensitive compare.*compare_names	sep	#$20			;set 8-bit A		longa	off		ldy	disk_name		;get length		iny				;bump it one for length	wordcompare_loop	lda	volname,y		;get byte		cmp	disk_name,y		;match?		beq	compare_cont		;yes				cmp	#'a'			;no - do we have a lower case char in A?		bcc	check_uc		;no		cmp	#'z'+1		bcs	no_match		;no		and	#$df			;yes - so convert it to upper case		cmp	disk_name,y		;match?		beq	compare_cont		;yes		bne	no_match		;no		check_uc	cmp	#'A'			;do we have an upper case char in A?		bcc	no_match		;no		cmp	#'Z'+1		bcs	no_match		;no		ora	#$20			;yes - so convert it to lower case		cmp	disk_name,y		;match?		bne	no_match		;no		compare_cont	dey				;done all?		bpl	compare_loop		;no, so	loop		longa	on			;set 16	bit A		rep	#$20 		clc				;indicate volume found		rts				;exit** We got an error from id_disk or the name didn't match.* If we just checked the start device, then reset current device to 0.* Bump current device and loop.*no_match	rep	#$20			;ensure 16 bit A		lda	current_device		;get current device		cmp	start_device		;same as start device?		bne	next_device		;no		stz	current_device		;yes, so reset current devicenext_device	inc	current_device		;bump current device		lda	start_device		;get start device		cmp	current_device		;same as current device?		beq	next_device		;yes, so skip it since we already did it		bra	id_disk_loop		;loop		ENDP				eject********************************************************************************	 Name:	is_vol_unlocked** Description:	Checks to see if the volume is unlocked and therefore modifiable.*		Returns an error if the volume is locked.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - ptr to vcr*		<drvr_dev_num - device	number *		wp_status_flag - non-zero if we know volume is write-protected**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		status_list**   Called by:	create*		destroy*		change_path*		set_file_info*		clear_backup*		write*		set_eof*		close*		flush**	Calls:	do_status_call** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************is_vol_unlocked PROC		with	data** If the vcr status word says the volume is write-enabled then we're done. *		ldy	#vcr_status		lda	[my_vcr_ptr],y		;get the vcr status word		and	#vcr_wr_enable		;is the volume write-enabled?		bne	done			;yes - so we're done** The 'vcr_wr_enable' bit in the vcr status word is 0 which means that either * the volume is write-protected or its write-protect status is unknown.  So now * we'll check wp_status_flag.  If it's non-zero then we've already done a device * status call on this volume and determined that the volume is write-protected.*		lda	wp_status_flag		;get the flag word		bne	wr_protected		;the volume is write-protected** Do a device status call.*do_call		jsr	do_status_call		;do the device status call			bcs	exit** Determine if there is a disk in the drive and if it's write-protected.*		lda	status_list		;get device status word		tax				;save in X		and	#online_bit		;is there a disk online?		beq	switched		;no - so return error		txa				;yes - so retrieve status word		and	#switched_bit		;has the disk been switched?		bne	switched		;yes - so return error		txa				;no - so retrieve status word		and	#protected_bit		;is the disk write-protected?		bne	wr_protected		;yes - so return an error** The volume is write-enabled so set the 'vcr_wr_enable' bit in the vcr status word.*		ldy	#vcr_status		lda	[my_vcr_ptr],y		;get the vcr status word		ora	#vcr_wr_enable		;mark the volume write-enabled		sta	[my_vcr_ptr],y		** Indicate no error and exit.*done		clcexit		rts** Return a 'write-protected' error.*wr_protected	lda	#drvr_wr_prot		;get error code		sec				;indicate error		rts** There is no disk in the drive or the disk has been switched so return an error.* Note - this should never happen, but just in case...*switched	lda	#drvr_disk_sw		sec		rts					ENDP				eject********************************************************************************	 Name:	do_status_call** Description:	Does a device status call.**	Entry:	jsr **	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_dev_num - device	number to access**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		status_list - contains device status**	 Uses:	all registers*		<drvr_call_num*		<drvr_stat_code*		<drvr_slist_ptr*		<drvr_req_count**   Called by:	erase*		update_status*		is_vol_unlocked**	Calls:	dev_dispatcher		(system service)** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************do_status_call	PROC		with	data		lda	#drvr_status		;call number = device status		sta	<drvr_call_num				stz	<drvr_stat_code		;status code = GetDeviceStatus				lda	#status_list		;setup pointer to status list		sta	<drvr_slist_ptr		lda	#^status_list		sta	<drvr_slist_ptr+2				lda	#6			;set request count		sta	<drvr_req_cnt		stz	<drvr_req_cnt+2				jsl	dev_dispatcher		;do the call		rts				ENDP		eject******************************************************************************** 	 Name:	update_vib_name** Description:	Updates the volume name in the VIB.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc* 		   ..000...*		B = K**		<drvr_dev_num - device # of volume being renamed*		<gbuf_ptr - ptr to 512 byte general purpose buffer*		volname+1 - new volume name (class 0 format w/o leading separator)**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc* 		   ..000..1 = error*			  0 = no error*		B = K**	 Uses:	all registers**   Called by:	change_path**	Calls:	gbuf_read*		gbuf_write** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************update_vib_name	PROC		with	data		** Read the VIB into the general purpose buffer.*		ldx	#vib_block		;lo word of physical block to read		ldy	#0			;hi word of physical block to read		jsr	gbuf_read		;read in the block		bcs	exit** Copy the new volume name into the VIB.*		sep	#$30			;begin 8-bit mode 		longa	off					longi	off					ldx	#0			;init offset into volname		ldy	#vib_volname		;init offset into vib		loop		lda	volname+1,x		;get byte from volname		sta	[gbuf_ptr],y		;and store in vib		iny				;adjust offsets		inx		cpx	volname+1				bcc	loop			;loop until done		beq	loop		rep	#$30			;restore 16-bit mode		longa	on					longi	on** Write the VIB back out to disk.*		ldx	#vib_block		;lo word of physical block to write		ldy	#0			;hi word of physical block to write		jsr	gbuf_write		;write the blockexit		rts					ENDP									eject******************************************************************************** 	 Name:	update_vib** Description:	Updates the VIB.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc* 		   ..000...*		B = K**		<gbuf_ptr - ptr to 512 byte general purpose buffer*		<my_vcr_ptr - ptr to vcr*		ctree_fcr_ptr - ptr to fcr for CTree*		etree_fcr_ptr - ptr to fcr for ETree**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc* 		   ..000..1 = error*			  0 = no error*		B = K**	 Uses:	all registers*		<drvr_dev_num*		<source_ptr	(aka <product)*		<dest_ptr	**   Called by:	ct_flush*		et_flush**	Calls:	gbuf_read*		gbuf_write*		copy_word*		copy_long*		copy_ext** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************update_vib	PROC		with	data		** Read the VIB into the general purpose buffer and exit if error.*		ldy	#vcr_dev		lda	[my_vcr_ptr],y		sta	<drvr_dev_num		ldx	#vib_block		;lo word of physical block to read		ldy	#0			;hi word of physical block to read		jsr	gbuf_read		;read in the block		bcc	read_ok		brl	exitread_ok** Copy information from the VCR into the VIB.*		lda	<my_vcr_ptr		;setup source ptr		sta	<source_ptr		lda	<my_vcr_ptr+2		sta	<source_ptr+2				lda	<gbuf_ptr		;setup destination ptr		sta	<dest_ptr		lda	<gbuf_ptr+2		sta	<dest_ptr+2				ldy	#vcr_mod_dt		;get starting source offset		ldx	#vib_mod_dt		;get starting dest offset		jsr	copy_long		;copy mod_dt		jsr	copy_word		;copy vol_attrib 		jsr	copy_word		;copy num_r_files				ldy	#vcr_alloc_start	;adjust source offset		ldx	#vib_alloc_start	;adjust dest offset		jsr	copy_word		;copy alloc_start				ldy	#vcr_next_id		;adjust source offset		ldx	#vib_next_id		;adjust dest offset		jsr	copy_long		;copy next_id		jsr	copy_word		;copy free_ablks				ldx	#vib_write_cnt		;adjust dest offset		jsr	copy_long		;copy write_cnt				ldx	#vib_num_r_dirs		;adjust dest offset		jsr	copy_word		;copy num_r_dirs		jsr	copy_long		;copy num_files		jsr	copy_long		;copy num_dirs** Copy information from the CTree FCR into the VIB.*		lda	ctree_fcr_ptr		;setup source ptr		sta	<source_ptr		lda	ctree_fcr_ptr+2		sta	<source_ptr+2				ldy	#fcr_peof		;get starting source offset		ldx	#vib_ctree_peof		;get starting dest offset		jsr	copy_long		;copy ctree_peof		jsr	copy_ext		;copy ctree_ext (6 words)** Copy information from the ETree FCR into the VIB.*		lda	etree_fcr_ptr		;setup source ptr		sta	<source_ptr		lda	etree_fcr_ptr+2		sta	<source_ptr+2				ldy	#fcr_peof		;get starting source offset		ldx	#vib_etree_peof		;get starting dest offset		jsr	copy_long		;copy etree_peof		jsr	copy_ext		;copy etree_ext (6 words)** Bump vib_write_cnt since vcr_write_cnt will be bumped when we write out the VIB.*		clc		ldy	#vib_write_cnt+2			lda	[gbuf_ptr],y		;get lo word of write count		xba				;change byte sex		adc	#1			;bump it by 1		xba				;change byte sex		sta	[gbuf_ptr],y		;and store		dey		dey		lda	[gbuf_ptr],y		;get hi word of write count		xba				;change byte sex		adc	#0			;bump if needed		xba				;change byte sex		sta	[gbuf_ptr],y		;and store** Write the VIB back out to disk.*		ldx	#vib_block		;lo word of physical block to write		ldy	#0			;hi word of physical block to write		jsr	gbuf_write		;write the blockexit		rts					ENDP									eject******************************************************************************** 	 Name:	update_alt_vib** Description:	Updates the alternate VIB.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc* 		   ..000...*		B = K**		<gbuf_ptr - ptr to 512 byte general purpose buffer*		<my_vcr_ptr - ptr to vcr*		<A4.L - ptr to tree fcr*		time - current time in seconds**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc* 		   ..000..1 = error*			  0 = no error*		B = K**	 Uses:	all registers*		<drvr_dev_num*		<source_ptr	(aka <product)*		<dest_ptr	**   Called by:	bt_ext_bt_file**	Calls:	gbuf_read*		gbuf_write*		copy_ext*		copy_long** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************update_alt_vib	PROC		with	data		** Read the alternate VIB into the general purpose buffer and exit if error.*		ldy	#vcr_dev		lda	[my_vcr_ptr],y		sta	<drvr_dev_num				sec		ldy  	#vcr_num_pblks		;calculate the physical block # of 		lda  	[my_vcr_ptr],y		;the alternate VIB and store in X,Y		sbc  	#2			;for the read call		tax		iny		iny		lda  	[my_vcr_ptr],y		sbc  	#0		tay		phy				;save physical block # on stack		phx				;for the write call		jsr	gbuf_read				bcs	exit** Make sure the first word in the block is the HFS signature.  Exit if not.*		lda	[gbuf_ptr]		;get first word from block		xba				;change byte sex		cmp	#hfs_signature		;is it the HFS signature?		bne	done			;no - so exit** Update the modification date/time in the alternate VIB.*		ldy	#vib_mod_dt+2		lda	time		xba				;change byte sex		sta	[gbuf_ptr],y		dey		dey		lda	time+2		xba				;change byte sex		sta	[gbuf_ptr],y** Copy information from the Tree FCR into the alternate VIB.*		lda	<a4			;setup source ptr		sta	<source_ptr		lda	<a4+2		sta	<source_ptr+2				lda	<gbuf_ptr		;setup destination ptr		sta	<dest_ptr		lda	<gbuf_ptr+2		sta	<dest_ptr+2				ldx	#vib_ctree_peof		;get starting dest offset		ldy	#fcr_id		lda	[a4],y			;get the file id from the fcr		cmp	#ctree_file_id		;is this fcr for the Catalog Tree?		beq	cont			;yes		ldx	#vib_etree_peof		;no - so adjust starting dest offsetcont		ldy	#fcr_peof		;get starting source offset		jsr	copy_long		;copy peof		jsr	copy_ext		;copy ext (6 words)** Write the alternate VIB back out to disk.*		lda	1,s			;get the physical block # off the stack		tax				;and put it in X,Y		lda	3,s		tay		jsr	 gbuf_write		;write out the block		bcs	exit** Indicate no error, clean up the stack and exit.*done		clc				;indicate no errorexit		plx				;clean up stack (don't trash A)		ply						rts				ENDP							eject******************************************************************************** 	 Name:	update_bth** Description:	Updates a BTree header node.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc* 		   ..000...*		B = K**		<gbuf_ptr - ptr to 512 byte general purpose buffer*		<my_vcr_ptr - ptr to vcr*		<A4.L - ptr to tree fcr**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc* 		   ..000..1 = error*			  0 = no error*		B = K**	 Uses:	all registers*		<drvr_dev_num*		<source_ptr	(aka <product)*		<dest_ptr	**   Called by:	bt_flush**	Calls:	gbuf_read*		gbuf_write*		copy_word*		copy_long*		ablk2pblk** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************update_bth	PROC		with	data		** Read the BTree header node into the general purpose buffer and exit if error.*		ldy	#vcr_dev		lda	[my_vcr_ptr],y		sta	<drvr_dev_num				ldy	#fcr_ext		;get offset to 1st ext descriptor in fcr		lda	[a4],y			;get # of ablk which contains header node		xba				;change byte sex		jsr	ablk2pblk		;convert to physical block # (in X,Y)		phy				;save physical block # on stack		phx				;for the write call		jsr	gbuf_read		;read in the block  		bcs	exit** Copy information from the Tree BCR into the BTree header node.*		lda	<a4			;setup source ptr		sta	<source_ptr		lda	<a4+2		sta	<source_ptr+2				lda	<gbuf_ptr		;setup destination ptr		sta	<dest_ptr		lda	<gbuf_ptr+2		sta	<dest_ptr+2				ldy	#bcr_depth		;get starting source offset 		ldx	#len_nd			;get starting dest offset		jsr	copy_word		;copy depth		jsr	copy_long		;copy root_node		jsr	copy_long		;copy num_leaves		jsr	copy_long		;copy first_node		jsr	copy_long		;copy last_node		jsr	copy_word		;copy node_size		jsr	copy_word		;copy max_key		jsr	copy_long		;copy num_nodes		jsr	copy_long		;copy free_nodes** Write the BTree header node back out to disk.*		lda	1,s			;get the physical block # off the stack		tax				;and put it in X,Y		lda	3,s		tay		jsr	 gbuf_write		;write out the block** Clean up the stack and exit.*exit		plx				;don't use A since it may contain		ply				;an error code		rts		ENDP				eject********************************************************************************	 Name:	build_fcr** Description:	Creates a new FCR for a file or directory.  *		If it's a file FCR and the physical eof <> 0, the block buffer *		information is setup and the fcr block buffer is marked as empty.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - pointer to vcr*		<a1 - ptr to Catalog Record*		record_type - Catalog Record type*		parent_id - parent dir id of file/dir*		storage_type - storage type*		catalog_hint - catalog hint*		resource_num - resource number*		request_access - requested access*		disk_name - name of disk (in gstring format)**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<my_fcr_ptr - ptr to fcr*		ref_num - reference number from fcr*		type - fcr type*		eof - logical eof*		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**	 Uses:	all registers*		<temp0*		<source_ptr	(aka <product)*		<dest_ptr 	*		<multiplicand*		<multiplier*		<product**   Called by:	open*		create**	Calls:	alloc_fcr		(system service)*		deref			(system service)*		setup_fcr_info*		update_block_buf*		update_fcr*		long_multiply*		copy_word*		copy_long*		copy_ext** Copyright Apple Computer, Inc. 1987-91  All rights reserved.******************************************************************************build_fcr	PROC		with	data** Insert a leading separator into 'disk_name' since SCM may need to use * 'disk_name' to build the fcr name.*		lda	disk_name		;get length word		inc	a			;add 1 for leading separator		sta	disk_name0		;and store as length of special string		lda	#':'					xba		sta	disk_name		;insert leading separator** Determine the correct fcr size and then allocate the fcr.*		lda	#len_d_fcr		;get fcr length for directories		ldx	record_type		;get record type		cpx	#cat_dir_type		;are we dealing with a directory?		beq	do_alloc		;yes - so branch		lda	#len_f_fcr		;get fcr length for filesdo_alloc	ldx	#disk_name0	 	;get pointer to	disk name		ldy	#^disk_name0	 		jsl	alloc_fcr		;allocate the fcr		bcc	got_fcr		mem_error	lda	#out_of_mem		;exit with 'out of memory' error		rts				got_fcr** Dereference the vp and save the fcr pointer. * 		jsl	deref			;dereference vp		stx	<my_fcr_ptr		;save pointer		sty	<my_fcr_ptr+2** Remove the leading separator from 'disk_name'.*		lda	disk_name0		;get length word of special string		dec	a			;subtract 1 for leading separator		sta	disk_name		;and store** Get reference	number and store in output parameter storage area.*		lda	[my_fcr_ptr]		;get refnum		sta	ref_num			;and store** Set fcr access.* 		ldy	#fcr_access		;get offset to access		lda	request_access		;get requested access		ora	#global_clean_bit	;mark file clean		sta	[my_fcr_ptr],y		;save it** Initialize some of the fields in the FCR*		ldy	#fcr_fst_id		;get offset to fst id		lda	#hfs_id			;get id		sta	[my_fcr_ptr],y		;and save it 		ldy	#fcr_vol_id		;get offset to vol id		lda	[my_vcr_ptr]		;get volume id from vcr		sta	[my_fcr_ptr],y		;and save it 		ldy	#fcr_type		;get offset to fcr type		lda	#fcr_file_type		;get fcr type for files		ldx	record_type		;get record type		cpx	#cat_fil_type		;are we dealing with a file?		beq	store_type		;yes		lda	#fcr_dir_type		;no - so get fcr type for directoriesstore_type	sta	[my_fcr_ptr],y		;and save it 				ldy	#fcr_parent_id		;get offset to parent dir id		lda	parent_id		;get lo word of parent dir id		sta	[my_fcr_ptr],y		;and save it 		iny		iny		lda	parent_id+2		;get hi word of parent dir id		sta	[my_fcr_ptr],y		;and save it 		ldy	#fcr_cat_hint		;get offset to catalog hint		lda	catalog_hint		;get lo word of catalog hint		sta	[my_fcr_ptr],y		;and save it 		iny		iny		lda	catalog_hint+2		;get hi word of catalog hint		sta	[my_fcr_ptr],y		;and save it ** Setup the source and destination pointers for the copy routines.*		lda	<a1			;setup source ptr		sta	<source_ptr		lda	<a1+2		sta	<source_ptr+2				lda	<my_fcr_ptr		;setup destination ptr		sta	<dest_ptr		lda	<my_fcr_ptr+2		sta	<dest_ptr+2** Check the Catalog Record type. *		lda	record_type		;get the catalog record type		cmp	#cat_fil_type		;is it a File Record?		beq	do_fil_record		;yes - so branch** Copy information from the Directory Record into the FCR.*		ldy	#dir_flags		;get starting source offset		ldx	#fcr_flags		;get starting dest offset		jsr	copy_word		;copy flags				ldx	#fcr_valence		;adjust dest offset		jsr	copy_word		;copy valence				ldx	#fcr_id			;adjust dest offset		jsr	copy_long		;copy id		ldy	#dir_mod_dt		;adjust source offset		ldx	#fcr_mod_dt		;adjust dest offset		jsr	copy_long		;copy mod_dt				brl	done			;we're done		** Copy information from the File Record into the FCR.*do_fil_record	clc		lda	#$7fff		adc	resource_num		;set overflow flag if fcr is for rsrc fork				ldy	#fil_flags-1		;get starting source offset		ldx	#fcr_flags		;get starting dest offset 		jsr	copy_word		;copy flags				ldy	#fil_id			;adjust source offset		ldx	#fcr_id			;adjust dest offset 		jsr	copy_long		;copy id				ldy	#fil_mod_dt		;adjust source offset		ldx	#fcr_mod_dt		;adjust dest offset		jsr	copy_long		;copy mod_dt				ldy	#fil_data_leof		;adjust source offset		bvc	not_rsrc1		;branch if fcr is for data fork		ldy	#fil_rsrc_leof		;adjust source offsetnot_rsrc1	ldx	#fcr_leof		;adjust dest offset		jsr	copy_long		;copy leof		jsr	copy_long		;copy peof				ldy	#fil_data_ext		;adjust source offset		bvc	not_rsrc2		;branch if fcr is for data fork		ldy	#fil_rsrc_ext		;adjust source offsetnot_rsrc2	ldx	#fcr_ext		;adjust dest offset		jsr	copy_ext		;copy ext (6 words)				bvc	flags_ok		;branch if fcr is for data fork		ldy	#fcr_access		;get offset into fcr		lda	[my_fcr_ptr],y		;get access word		ora	#rsrc_fork_bit		;set rsrc fork bit		sta	[my_fcr_ptr],y		;and storeflags_ok		ldy	#fil_clump_size				lda	[a1],y			;get clump size from File Record		beq	use_vcr_clump		;if it's 0, use clump size from VCR		sta	<multiplicand		;it's non-zero so need to convert from		stz	<multiplicand+2		;'# of ablks per clump' to 		lda	ablk_size		;'# of bytes per clump' so multiply		sta	<multiplier		;by allocation block size		lda	ablk_size+2		sta	<multiplier+2		jsr	long_multiply		lda	<product+2		;push result on stack		pha		lda	<product		pha		bra	store_clump		;and branch		use_vcr_clump	ldy	#vcr_fclump_size+2			lda	[my_vcr_ptr],y		;get default clump size from VCR		pha				;and push on stack		dey		dey		lda	[my_vcr_ptr],y		pha		store_clump	ldy	#fcr_clump_size			pla				;pull clump size from stack and		sta	[my_fcr_ptr],y		;store in FCR		iny		iny		pla		sta	[my_fcr_ptr],y** Setup some fcr information.  *		jsr	setup_fcr_info** If the file's physical eof = 0 then we're done. *		ldy	#fcr_peof		lda	[my_fcr_ptr],y		iny		iny		ora	[my_fcr_ptr],y		beq	done** Setup the fcr block buffer information and mark the block buffer as empty.* 		jsr	update_block_buf		bcs	exit** Copy the block buffer information into the fcr.*		jsr	update_fcr		** Indicate no error and exit.*done		clc				exit		rts						ENDP				eject********************************************************************************	 Name:	setup_fcr_info** Description:	Setup some fcr information.  **	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_fcr_ptr - ptr to fcr**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		type - fcr type*		eof - logical eof *		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**	 Uses:	all registers**   Called by:	setup_call*		build_fcr**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************setup_fcr_info 	PROC		with	data** Get fcr type and save it.  Exit if fcr is not for a file.*		ldy	#fcr_type				lda	[my_fcr_ptr],y		;get fcr type		sta	type			;and save		cmp	#fcr_file_type		;is this fcr for a file?		bne	exit			;no - so exit** Get current leof.*		ldy	#fcr_leof		;get offset to leof		lda	[my_fcr_ptr],y		;get lo word of leof		sta	eof			;and save it		iny						iny		lda	[my_fcr_ptr],y		;get hi word of leof		sta	eof+2			;and save it** Get current file mark.*		ldy	#fcr_file_mark		;get offset to file mark		lda	[my_fcr_ptr],y		;get lo word of file mark		sta	file_mark		;and save it		iny		iny		lda	[my_fcr_ptr],y		;get hi word of file mark		sta	file_mark+2		;and save it** Setup block_mark.*		ldy	#fcr_block_mark		;get offset to block mark		lda	[my_fcr_ptr],y		;get block mark		sta	block_mark		;and save it** Setup block_num.*		ldy	#fcr_block_num		;get offset to block #		lda	[my_fcr_ptr],y		;get lo word of block #		sta	block_num		;and save it		iny		iny		lda	[my_fcr_ptr],y		;get hi word of block #		sta	block_num+2		;and save it** Setup block_count.*		ldy	#fcr_block_count	;get offset to block count		lda	[my_fcr_ptr],y		;get lo word of block count		sta	block_count		;and save it		iny		iny		lda	[my_fcr_ptr],y		;get hi word of block count		sta	block_count+2		;and save it** Create a ptr to the fcr block buffer and store it in <block_buf_ptr.*		clc						lda	<my_fcr_ptr		;get ptr to fcr		adc	#fcr_block_buf		;add offset to block buffer		sta	<block_buf_ptr		;to create ptr to block buffer		lda	<my_fcr_ptr+2		adc	#0		sta	<block_buf_ptr+2** Indicate no error and exit.*exit		clc 		rts						ENDP				eject********************************************************************************	 Name:	update_fcr** Description:	Updates fcr_file_mark, fcr_block_mark, fcr_block_num, fcr_block_count.*		*	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_fcr_ptr - ptr to fcr*		file_mark - new file mark*		block_mark - new block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0*		B = K**	 Uses:	all registers**   Called by:	read*		write*		set_mark*		set_eof*		build_fcr**	Calls:	nothing** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************update_fcr	PROC		with	data** Put new file_mark in fcr.*		ldy	#fcr_file_mark		;get offset to field		lda	file_mark		;get lo word of file_mark		sta	[my_fcr_ptr],y		;store it		iny						iny		lda	file_mark+2		;get hi word		sta	[my_fcr_ptr],y		;store it** Put new block_mark in fcr.*		ldy	#fcr_block_mark		;get offset to field		lda	block_mark		;get block_mark		sta	[my_fcr_ptr],y		;store it** Put new block_num in fcr.*		ldy	#fcr_block_num		;get offset to field		lda	block_num		;get lo word of block_num		sta	[my_fcr_ptr],y		;store lo word of block #		iny						iny		lda	block_num+2		;get hi word of block_num		sta	[my_fcr_ptr],y		;store hi word or block #** Put new block_count in fcr.*		ldy	#fcr_block_count	;get offset to field		lda	block_count		;get lo word of block_count		sta	[my_fcr_ptr],y		;store it		iny						iny		lda	block_count+2		;get hi word		sta	[my_fcr_ptr],y		;store it** Indicate no error and exit.*		clc						rts						ENDP				eject********************************************************************************	 Name:	ensure_file** Description:	Checks the fcr type and returns an error if fcr is not for a file.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		type - fcr type**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	read*		write*		set_mark*		get_mark*		set_eof*		get_eof**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************ensure_file	PROC		with	data		lda	type			;get fcr type		cmp	#fcr_file_type		;is this fcr for a file?		bne	error			;no - so return an error		clc				;yes - so indicate no error		rts				;and exit		error		lda	#bad_store_type		;return an error		sec		rts		ENDP				eject********************************************************************************	 Name:	check_access** Description:	Checks the fcr access and returns an error if 'write' access*		is not allowed.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_fcr_ptr - ptr to fcr**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	write*		set_eof**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************check_access	PROC		with	data** Check the access word in the fcr. Return an error if 'write' access is not allowed.   *		ldy	#fcr_access				lda	[my_fcr_ptr],y		;get access word from fcr		and	#write_access		;is 'write' access allowed?		beq	error			;no - so return an error		clc				;yes - so indicate no error		rts				;and exit		error		lda	#invalid_access		;return an error		sec		rts		ENDP				eject********************************************************************************	 Name:	is_file_unlocked** Description:	Determines if the file/dir is unlocked and therefore modifiable.*		Returns an error if the file is locked.*		Note - Directories are always unlocked.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<a1 - ptr to Catalog Record for file/dir*		record_type - Catalog Record type**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	destroy*		change_path**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************is_file_unlocked PROC		with	data** If we're dealing with a directory, then we're done since dirs are never locked.*		lda	record_type		;are we dealing with a dir?		cmp	#cat_dir_type		beq	done			;yes - so done** We're dealing with a file.* Get the flags field from the Catalog Record. Return an error if the locked bit is set.*		ldy	#fil_flags		;get offset to file flags byte 		lda	[a1],y			;get flags		and	#locked_bit		;is the locked bit set?		bne	error			;yes - so return an error** Indicate no error and exit*done		clc				;indicate no error					rts				;exit** Return an error.*error		lda	#invalid_access		;put error code in A		sec				;indicate error		rts				;exit				ENDP				eject********************************************************************************	 Name:	is_file_closed** Description:	Determines if the specified file/dir is currently open or closed.*		Returns an error if the file/dir is open.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - ptr to vcr*		<a1 - ptr to Catalog Record for file/dir*		record_type - Catalog Record type*		id - id of file/dir**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		<my_fcr_ptr**   Called by:	destroy*		change_path**	Calls:	look_for_fcr** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************is_file_closed 	PROC		with	data** Look for an FCR for the specified file/dir. If we find one, report an error.* 		jsr	look_for_fcr		;look for an fcr for the file/dir		bcs	not_open		;we didn't find one** We found an fcr for the file/dir so report an error.* 		lda	#file_busy		;put error code in A		sec				;indicate error		rts				;exit** We didn't find an fcr for the file/dir so indicate no error and exit.*not_open	clc								rts					ENDP				eject********************************************************************************	 Name:	look_for_fcr** Description:	Walks the FCR list looking for an FCR for the specified file/dir.   *		If an FCR for the file/dir is not found, an error is returned. **	Note:	This routine contains an alternate entry point (look_for_fcr2)*		which does not initialize the starting fcr index.  This is used*		when we need to find all fcrs for a specified file.  After look_for_fcr *		is called to find the first fcr, look_for_fcr2 can be called in a *		loop to find all other fcrs for the file.*		*	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_vcr_ptr - ptr to vcr*		<a1 - ptr to Catalog Record for file/dir*		record_type - Catalog Record type*		id - id of file/dir**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<my_fcr_ptr - ptr to last fcr checked*		fcr_index - index of last fcr checked**	 Uses:	all registers*		fcr_index*		<my_fcr_ptr**   Called by:	is_file_closed*		get_cat_info**	Calls:	get_fcr			(system service)*		deref			(system service)** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************look_for_fcr 	PROC		with	data		stz	fcr_index		;initialize starting fcr index				EXPORT	look_for_fcr2look_for_fcr2** Walk the FCR list looking for an FCR for the specified file/dir. * Return an error if an FCR for the file/dir is not found.* fcr_loop	inc	fcr_index		;increment fcr index		lda	fcr_index		jsl	get_fcr			;get next fcr		bcs	exit				jsl	deref			;derefence fcr vp		stx	<my_fcr_ptr		;and store fcr ptr		sty	<my_fcr_ptr+2				ldy	#fcr_vol_id				lda	[my_fcr_ptr],y		;get volume id from fcr		cmp	[my_vcr_ptr]		;is it the correct volume?		bne	fcr_loop		;no - so loop				ldy	#fcr_type		lda	[my_fcr_ptr],y		;get fcr type		cmp	record_type		;is it the correct type?		bne	fcr_loop		;no - so loop		ldy	#fcr_id		lda	[my_fcr_ptr],y		;get lo word of file/dir id from fcr		cmp	id			;match?		bne	fcr_loop		;no - so loop		iny		iny		lda	[my_fcr_ptr],y		;get hi word of file/dir id from fcr		cmp	id+2			;match?		bne	fcr_loop		;no - so loop** We found an fcr for the file/dir so indicate no error and exit.*		clc						exit		rts							ENDP		eject********************************************************************************	 Name:	fill_block_buf** Description:	Checks to see if the fcr block buffer is empty, and if so,*		reads a block in from disk.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_fcr_ptr - ptr to fcr*		block_num - # of physical block in block buffer*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	read*		write**	Calls:	block_buf_read** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************fill_block_buf	PROC		with	data** Check to see if the fcr block buffer is empty.  Exit if not.*		clc				;clear carry		ldy	#fcr_flags				lda	[my_fcr_ptr],y		;get flag word		and	#buf_empty_bit		;is the block buffer empty?		beq	exit			;no - so exit with carry clear** The block buffer is empty so read the block in from disk.* 		jsr	block_buf_read		exit		rts		ENDP				eject********************************************************************************	 Name:	flush_block_buf** Description:	Checks to see if the fcr block buffer is dirty, and if so,*		writes the block out to disk.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_fcr_ptr - ptr to fcr*		block_num - # of physical block in block buffer*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	flush*		read*		write*		update_block_buf**	Calls:	block_buf_write** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************flush_block_buf	PROC		with	data** Check to see if the fcr block buffer is dirty. Exit if not.*		clc				;clear carry		ldy	#fcr_flags				lda	[my_fcr_ptr],y		;get flag word		and	#buf_dirty_bit		;is the block buffer dirty?		beq	exit			;no - so exit with carry clear ** The block buffer is dirty so write the block out to disk.* 		jsr	block_buf_write		;write the block out to diskexit		rts		ENDP				eject********************************************************************************	 Name:	update_block_buf** Description:	Converts the current file mark into physical block information.*		If the block num has changed, then the fcr block buffer is flushed*		and the buffer is marked as empty.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<my_fcr_ptr - ptr to fcr*		file_mark - file mark *		block_mark - block buffer mark*		block_num - # of physical block in block buffer*		block_count - # physical blocks until end of extent*		<block_buf_ptr - ptr to block buffer in fcr**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		block_mark - block buffer mark*		block_num - physical block #*		block_count - # physical blocks until end of extent**	 Uses:	all registers**   Called by:	build_fcr*		set_mark*		set_eof**	Calls:	log2phys*		flush_block_buf*		update_empty_bit** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************update_block_buf PROC		with	data** Convert current file_mark into physical block information.* Setup new block_num, block_count and block_mark.* 		jsr	log2phys* * Compare new block_num to fcr_block_num to see if the block has changed.* 		ldy	#fcr_block_num 		;get offset to block num in fcr		lda	block_num		;get lo word of new block #		cmp	[my_fcr_ptr],y		;same as lo word of old block #?		bne	changed			;no		iny				;yes			iny		lda	block_num+2		;get hi word of new block #		cmp	[my_fcr_ptr],y		;same as hi word of old block #?		beq	done			;yes - so done** The block # has changed, so flush the block buffer and mark the buffer as empty.*changed		jsr	flush_block_buf		bcs	exit		sec						jsr	update_empty_bit	** Indicate no error and exit.*done		clcexit		rts				ENDP				eject********************************************************************************	 Name:	update_empty_bit** Description:	Sets/clears buf_empty_bit based on the carry flag.*		The A-register and the carry flag are returned unchanged.**	Entry:	jsr**	 Exit:	rts**	Input:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<my_fcr_ptr - ptr to fcr**      Output:	A = unchanged*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	block_buf_read*		data_buf_read*		update_block_buf**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************update_empty_bit PROC		with	data** Set buf_empty_bit if carry set, else clear it.*		tax				;save error code		ldy	#fcr_flags		;get offset to fcr_flags		lda	[my_fcr_ptr],y		;get the flags word		bcs	set_it					and	#buf_empty_mask		;clear the bit		bra	store_it		set_it		ora	#buf_empty_bit		;set the bitstore_it	sta	[my_fcr_ptr],y		;save new flags word		txa				;recover error code		rts				;exit		ENDP		eject********************************************************************************	 Name:	update_dirty_bit** Description:	Sets/clears buf_dirty_bit based on the carry flag.*		The A-register and the carry flag are returned unchanged.**	Entry:	jsr**	 Exit:	rts**	Input:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		<my_fcr_ptr - ptr to fcr**      Output:	A = unchanged*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers**   Called by:	write*		block_buf_write**	Calls:	nothing** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************update_dirty_bit PROC		with	data** Set buf_dirty_bit if carry set, else clear it.*		tax				;save error code		ldy	#fcr_flags		;get offset to fcr_flags		lda	[my_fcr_ptr],y		;get the flags word		bcs	set_it					and	#buf_dirty_mask		;clear the bit		bra	store_it		set_it		ora	#buf_dirty_bit		;set the bitstore_it	sta	[my_fcr_ptr],y		;save new flags word		txa				;recover error code		rts				;exit		ENDP		eject********************************************************************************	 Name:	gbuf_read*		gbuf_write** Description:	Reads one physical block from disk into the general purpose buffer.*		Writes one physical block to disk from the general purpose buffer .**	Entry:	jsr**	 Exit:	jmp do_rw_call**	Input:	A = undefined*		X = low	word of	physical block #*		Y = high word of physical block #*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_dev_num - device number to access *		<gbuf_ptr - ptr to 512 byte general purpose buffer**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_blk_num - physical block number*		<drvr_req_cnt - # of bytes to read/write*		<drvr_buf_ptr - points to general purpose buffer**	 Uses:	all registers*		<drvr_cache**   Called by:	id_disk		(read)*		build_vcr	(read)*		update_vib	(read, write)*		update_alt_vib	(read, write)*		update_bth	(read, write)**	Calls:	setup_call_num*		do_rw_call** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************gbuf_read	PROC		with	data		clc		bra	common			EXPORT	gbuf_writegbuf_write		seccommon		jsr	setup_call_num		;setup call number** Turn on caching.*		lda	#cache_on				sta	<drvr_cache		** Set the driver block #.*		stx	<drvr_blk_num				sty	<drvr_blk_num+2		** Set the request count.*		lda	#phys_blk_size		sta	<drvr_req_cnt				stz	<drvr_req_cnt+2** Set the buffer ptr.*		lda	<gbuf_ptr				sta	<drvr_buf_ptr				lda	<gbuf_ptr+2				sta	<drvr_buf_ptr+2		** Do the read/write.*		jmp	do_rw_call				ENDP				eject********************************************************************************	 Name:	block_buf_read** Description:	Reads one physical block from disk into the fcr's block buffer.*		Sets/clears buf_empty_bit depending on results of read call.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_dev_num - device number to access *		block_num - physical block # to read*		<block_buf_ptr - ptr to block buffer in fcr*		cache_priority - cache priority flag**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		<drvr_cache**   Called by:	read		*		write		*		fill_block_buf	**	Calls:	setup_call_num*		do_rw_call*		update_empty_bit** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************block_buf_read	PROC		with	data		clc 		jsr	setup_call_num		;setup call number** Turn caching on/off using the cache_priority input parameter.* Default = off.*		lda	cache_priority				sta	<drvr_cache		** Set the driver block #.* 		lda	block_num		sta	<drvr_blk_num				lda	block_num+2		sta	<drvr_blk_num+2		** Set the request count.*		lda	#phys_blk_size		sta	<drvr_req_cnt				stz	<drvr_req_cnt+2** Set the buffer ptr.*		lda	<block_buf_ptr				sta	<drvr_buf_ptr				lda	<block_buf_ptr+2				sta	<drvr_buf_ptr+2		** Do the read.*		jsr	do_rw_call** Set/clear buf_empty_bit depending on the results of the read call.*				jsr	update_empty_bit		 		rts		ENDP				eject********************************************************************************	 Name:	block_buf_write** Description:	Writes one physical block to disk from the fcr's block buffer.*		Sets/clears buf_dirty_bit depending on results of write call.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_dev_num - device number to access *		<my_fcr_ptr - ptr to fcr*		<block_buf_ptr - ptr to block buffer in fcr*		cache_priority - cache priority flag**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		<drvr_cache**   Called by:	flush_block_buf	**	Calls:	setup_call_num*		do_rw_call*		update_dirty_bit** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************block_buf_write	PROC		with	data		sec 		jsr	setup_call_num		;setup call number** Turn caching on/off using the cache_priority input parameter.* Default = off.*		lda	cache_priority				sta	<drvr_cache		** Set the driver block #.*		ldy	#fcr_block_num 		lda	[my_fcr_ptr],y		sta	<drvr_blk_num		iny		iny 		lda	[my_fcr_ptr],y		sta	<drvr_blk_num+2		** Set the request count.*		lda	#phys_blk_size		sta	<drvr_req_cnt				stz	<drvr_req_cnt+2** Set the buffer ptr.*		lda	<block_buf_ptr				sta	<drvr_buf_ptr				lda	<block_buf_ptr+2				sta	<drvr_buf_ptr+2		** Do the write.*		jsr	do_rw_call** Set/clear buf_dirty_bit depending on the results of the write call.*				jsr	update_dirty_bit		 		rts		ENDP				eject********************************************************************************	 Name:	data_buf_read*		data_buf_write** Description:	Reads as many physical blocks as possible in one driver call   *		directly into the caller's data buffer from disk.* 		Writes as many blocks as possible in one driver call directly  *		to disk from the caller's data buffer.*		Sets buf_empty_bit to indicate that the fcr block buffer is empty.*		Updates block_num, block_count and block_mark to the correct values.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_dev_num - device number to access *		<data_buf_ptr - points to caller's data buffer*		bytes_left - # bytes until request satisfied*		file_mark - current file mark*		block_mark - block buffer mark*		block_num - # of next physical block in file*		block_count - # physical blocks until end of extent*		cache_priority - cache priority flag**      Output:	A = error code if error*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		xfer_count - # bytes read/written*		block_mark - set to 512*		block_num - # of last physical block read/written*		block_count - # physical blocks until end of extent**	 Uses:	all registers*		<drvr_cache*		num_blocks**   Called by:	read*		write**	Calls:	setup_call_num*		do_rw_call*		update_empty_bit		** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************data_buf_read	PROC		with	data		clc		bra	common				EXPORT	data_buf_writedata_buf_write			seccommon		jsr	setup_call_num		;setup call number** Turn caching on/off using the cache_priority input parameter.* Default = off.*		lda	cache_priority				sta	<drvr_cache		** Set buf_empty_bit to indicate that the fcr block buffer is empty.*		sec		jsr	update_empty_bit		** Convert bytes_left from bytes to physical blocks and store in num_blocks.* 		lda	bytes_left		sta	num_blocks				lda	bytes_left+2		sta	num_blocks+2		ldx	#9			;# of bits to shift		loop1		lsr	num_blocks+2		;divide by 512 to convert		ror	num_blocks		;from bytes to physical blocks		dex		bne	loop1*		* If num_blocks > block_count, set num_blocks = block_count.*		lda	num_blocks+2		cmp	block_count+2		;is num_blocks > block_count?		bcc	num_ok			;no		bne	too_big			;yes		lda	num_blocks		cmp	block_count				bcc	num_ok			;notoo_big		lda	block_count		;yes - so set num_blocks = block_count		sta	num_blocks		lda	block_count+2		sta	num_blocks+2num_ok** Set xfer_count = num_blocks * phys_blk_size.* 		lda	num_blocks		sta	xfer_count				lda	num_blocks+2		sta	xfer_count+2		ldx	#9			;# of bits to shift		loop2		asl	xfer_count 		;multiply by 512 to convert		rol	xfer_count+2		;from physical blocks to bytes		dex		bne	loop2** Set the driver block #.* 		lda	block_num		sta	<drvr_blk_num				lda	block_num+2		sta	<drvr_blk_num+2		** Set the request count.* 		lda	xfer_count				sta	<drvr_req_cnt				lda	xfer_count+2		sta	<drvr_req_cnt+2** Set the buffer ptr.*		lda	<data_buf_ptr				sta	<drvr_buf_ptr				lda	<data_buf_ptr+2				sta	<drvr_buf_ptr+2		** Do the read/write.*		jsr	do_rw_call		bcs	exit** Update block_num, block_count and block_mark to the correct values.*		lda	#phys_blk_size		sta	block_mark		;block_mark = 512				sec				;zero adjust num_blocks 		lda	num_blocks		sbc	#1		sta	num_blocks		lda	num_blocks+2		sbc	#0		sta	num_blocks+2		clc				;block_num = block_num + num_blocks		lda	block_num		adc	num_blocks		sta	block_num		lda	block_num+2		adc	num_blocks+2		sta	block_num+2		sec				;block_count = block_count - num_blocks		lda	block_count		sbc	num_blocks		sta	block_count		lda	block_count+2		sbc	num_blocks+2		sta	block_count+2** Indicate no error and exit.*		clc						exit		rts						ENDP				eject********************************************************************************	 Name:	node_buf_read*		node_buf_write** Description:	Reads a node from disk into the node buffer pointed to by <A0.*		Writes a node to disk from the node buffer pointed to by <A0.**	Entry:	jsr**	 Exit:	jmp do_rw_call**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_dev_num - device number to access *		<a0 - ptr to node buffer**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_blk_num - physical block number*		<drvr_req_cnt - # of bytes to read/write*		<drvr_buf_ptr - points to node buffer**	 Uses:	all registers*		<drvr_cache**   Called by:	bt_get_node	(read)*		bt_rel_node	(write)**	Calls:	setup_call_num*		do_rw_call** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************node_buf_read	PROC		with	data		clc		bra	common				EXPORT	node_buf_writenode_buf_write			seccommon		jsr	setup_call_num		;setup call number** Turn on caching.*		lda	#cache_on				sta	<drvr_cache		** Set the driver block #.*		ldy	#node_loc				lda	[a0],y			;get the node's location on disk		sta	<drvr_blk_num		;and set the driver block #		iny		iny		lda	[a0],y		sta	<drvr_blk_num+2		** Set the request count.*		lda	#node_size		sta	<drvr_req_cnt						stz	<drvr_req_cnt+2** Set the buffer ptr.*		lda	<a0					sta	<drvr_buf_ptr				lda	<a0+2				sta	<drvr_buf_ptr+2		** Do the read/write.*		jmp	do_rw_call				ENDP				eject********************************************************************************	 Name:	bitmap_buf_read	*		bitmap_buf_write** Description:	Reads a bitmap block from disk into the bitmap buffer pointed to by <A0.* 		Writes a bitmap block to disk from the bitmap buffer pointed to by <A0.**	Entry:	jsr**	 Exit:	jmp do_rw_call**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_dev_num - device number to access*		<my_vcr_ptr - ptr to vcr*		<a0 - ptr to bitmap buffer*		d5 - bitmap block #**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_blk_num - physical block number*		<drvr_req_cnt - # of bytes to read/write*		<drvr_buf_ptr - points to bitmap buffer**	 Uses:	all registers*		<drvr_cache**   Called by:	get_bitmap_bit	(read)*		get_next_word	(read, write)*		update_bitmap	(write)**	Calls:	setup_call_num*		do_rw_call** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************bitmap_buf_read	PROC		with	data		clc		bra	common				EXPORT	bitmap_buf_writebitmap_buf_write 		seccommon		jsr	setup_call_num		;setup call number** Turn on caching.*		lda	#cache_on				sta	<drvr_cache		** Set the driver block #.*		clc		ldy	#vcr_vbm_start		lda	[my_vcr_ptr],y		;get the phys block # of start of bitmap		adc	d5			;add to the bitmap block #		sta	<drvr_blk_num		;and store		stz	<drvr_blk_num+2		** Set the request count.*		lda	#phys_blk_size		sta	<drvr_req_cnt				stz	<drvr_req_cnt+2** Set the buffer ptr.*		lda	<a0				sta	<drvr_buf_ptr				lda	<a0+2				sta	<drvr_buf_ptr+2		** Do the read/write.*		jmp	do_rw_call				ENDP				eject********************************************************************************	 Name:	setup_call_num** Description:	Sets up	<drvr_call_num for a read or write call based on *		the carry flag.  **	Entry:	jsr **	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined  *		P = nvmxdizc*		    ..000..0 - read call*			   1 - write call*		B = K**      Output:	A = undefined*		X = undefined*		Y = undefined  *		P = nvmxdizc*		    ..000..0*		B = K**		<drvr_call_num - command number**	 Uses:	all registers**   Called by:	gbuf_read*		block_buf_read*		data_buf_read*		node_buf_read*		bitmap_buf_read*   		gbuf_write*		block_buf_write*		data_buf_write*		node_buf_write*		bitmap_buf_write**	Calls:	nothing** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************setup_call_num 	PROC		with	data		bcs	its_write		lda	#drvr_read		bra	store_it		its_write	lda	#drvr_write		store_it	sta	<drvr_call_num		clc		rts				ENDP				eject********************************************************************************	 Name:	do_rw_call** Description:	Calls the device dispatcher to do a read or write call. *		Handles disk switched and offline errors.	**	Entry:	jsr or jmp**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		id_disk_flag - 1 if id_disk routine active, else 0*		<my_vcr_ptr - ptr to vcr*		<drvr_dev_num - device	number to access*		<drvr_call_num - call number*		<drvr_buf_ptr - buffer	pointer*		<drvr_req_cnt - request count *		<drvr_blk_num - block number *		<drvr_cache - cache priority**      Output:	A = error code if carry	set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**		write_occurred - set to non-zero value if we did a write call*		write_dev_num - device number written to if we did a write call**	 Uses:	all registers*		<drvr_cache*		<drvr_fst_num*		<drvr_blk_size*		<drvr_vol_id**   Called by:	gbuf_read*		block_buf_read*		data_buf_read*		node_buf_read*		bitmap_buf_read*   		gbuf_write*		block_buf_write*		data_buf_write*		node_buf_write*		bitmap_buf_write**	Calls:	find_our_volume*		dev_dispatcher		(system service)** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************do_rw_call	PROC		with	data** Set the fst id.*		lda	#hfs_id			;get id for HFS FST		sta	<drvr_fst_num		;set fst id** Set the block size.*		lda	#phys_blk_size				sta	<drvr_blk_size		;set block size** If we're doing a Write then indicate that a Write has occurred during the current* application call, save the device # we're writing to, turn on deferred writing,* set drvr_vol_id, and bump the write count in the vcr.* Note - deferred writing will only take effect if Sessions are enabled.*		lda	<drvr_call_num		;get call #		cmp	#drvr_write		;are we doing a write call?		bne	not_write		;no				sta	write_occurred		;indicate that a write occurred		lda	<drvr_dev_num		;get device # we're writing to		sta	write_dev_num		;and save it				lda	<my_vcr_ptr		;do we have a vcr?		ora	<my_vcr_ptr+2		beq	no_vcr			;no				lda	<drvr_cache		;get cache priority		ora	#deferred_on		;turn on deferred writing		sta	<drvr_cache		;and store new cache priority		lda	[my_vcr_ptr]		;set volume id 		sta	<drvr_vol_id		;(needed for deferred writing)				ldy	#vcr_write_cnt		;bump write count in vcr		clc		lda	[my_vcr_ptr],y		adc	#1		sta	[my_vcr_ptr],y		iny		iny		lda	[my_vcr_ptr],y		adc	#0		sta	[my_vcr_ptr],yno_vcrnot_write** Call the device dispatcher.  * Exit if no error, or if error is not 'disk switched' or 'driver offline'. * If we got a 'disk switched' error and we were called from id_disk then retry.* If we got a 'driver offline' error and we were called from id_disk then exit.* If we got a 'disk switched' or 'driver offline' error and we were not called from* id_disk and we have a non-zero vcr ptr, then try to recover.*re_try		jsl	dev_dispatcher		;do the call		bcc	exit							pha				;save error		cmp	#drvr_disk_sw		;disk switched error?		bne	not_disk_sw		;no		lda	id_disk_flag		;yes, is id_disk_flag set?		beq	check_vcr		;no - so continue		pla				;yes - so clean up stack		bra	re_try			;and try again		not_disk_sw	cmp	#drvr_off_line		;offline error?		bne	error			;no - so return the error		lda	id_disk_flag		;Yes, is id_disk_flag set?		bne	error			;Yep, so exit with error.check_vcr	lda	<my_vcr_ptr		;do we have a non-zero vcr ptr?		ora	<my_vcr_ptr+2		bne	save_state		;yes - so let's see if we can recovererror		pla				;Get error code.		sec				;Make sure carry set.exit		rts				;Exit.** We got a 'disk switched' or 'driver offline' error, so let's try to recover. * Save the driver direct page space since it may be modified by find_our_volume.*save_state	pla				;fix stack		ldx	#len_drvr_dp-2		drvr_dp_loop	lda	<start_drvr_dp,x		sta	saved_drvr_dp,x		dex		dex		bpl	drvr_dp_loop** Call find_our_volume and save	error code and status.*		jsr	find_our_volume		;Go look for it.		php				;Save status.		pha				;Save error code.** Restore the driver direct page space.*		ldx	#len_drvr_dp-2		drvr_dp_loop2	lda	saved_drvr_dp,x		sta	<start_drvr_dp,x		dex		dex		bpl	drvr_dp_loop2** Recover call status and error	code.  Re-try call if no error,	else exit.*		pla				;Recover error code.		plp				;Recover status.		bcs	exit			;Exit if error.		jmp	re_try			;No error, so re-try call.		ENDP				eject********************************************************************************	 Name:	transfer_r_data** Description:	Transfers data from fcr's block buffer to caller's data buffer.*		Handles newline checking.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<block_buf_ptr - ptr to fcr's block buffer*		<data_buf_ptr - ptr to caller's data buffer*		newline_flag - 0*		newline_mask - mask for newline character*		newline_ptr - pointer to newline table (if newline enabled)*		newline_length - length	of newline table (if newline enabled)*		newline_char - first byte of newline table (if newline enabled)*		eof - end of file*		file_mark - current file mark*		block_mark - current block buffer mark*		bytes_left - # bytes till satisfy request*		transfer_count - # bytes already transfered**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		xfer_count - # of bytes transfered*		newline_flag - 1 if we hit a newline character, else 0*		block_mark - new block buffer mark**	 Uses:	all registers*		<temp0*		<temp1**   Called by:	read	**	Calls:	move_info		(system service)** Copyright Apple Computer, Inc. 1987-90  All rights reserved.******************************************************************************transfer_r_data	PROC		with	datasrc_ptr		equ	temp0			;local equateslist_ptr	equ	temp1** Init xfer_count to 0.*		stz	xfer_count		stz	xfer_count+2** If block_mark = phys_blk_size then there is nothing left in buffer to transfer so exit.*		lda	block_mark		;get block_mark		cmp	#phys_blk_size		;are we at the end of the block?		bne	mark_ok			;no - so continue		brl	exit			;yes - so exitmark_ok** Set src_ptr = <block_buf_ptr + block_mark.*		clc						adc	<block_buf_ptr		sta	<src_ptr		lda	#0		adc	<block_buf_ptr+2		sta	<src_ptr+2** Set xfer_count = phys_blk_size - block_mark.*		sec						lda	#phys_blk_size				sbc	block_mark				sta	xfer_count		** If bytes_left	<= xfer_count then set xfer_count = bytes_left.*		ldx	bytes_left+2		;is bytes_left <= xfer_count?		bne	count_ok		;no 		cmp	bytes_left				bcc	count_ok		;no 		lda	bytes_left		;yes - so set xfer_count = bytes_left		sta	xfer_countcount_ok** Check if newline is enabled.*		lda	newline_mask		;is newline enabled?		beq	fast_xfer		;no - so go fast** We have to watch for newline.* Set 8-bit A.  Decrement newline_length.  Branch if only 1 newline character.*		lda	newline_ptr		;copy newline_ptr to direct page		sta	<list_ptr		lda	newline_ptr+2		sta	<list_ptr+2				longa	off			;set 8 bit A		sep	#$20		dec	newline_length		;point to last byte of newline table		beq	medium_xfer		;branch if only 1 newline char** We have more then 1 newline character so we'll slow to a crawl and check each byte * against the entire newline list after we transfer it.*		ldy	#0			;init offsetslow_loop	lda	[src_ptr],y		;get byte		sta	[data_buf_ptr],y	;store byte		and	newline_mask		;mask it		tyx				;save offset		ldy	newline_length		;point to end of newline listnewline_loop	cmp	[list_ptr],y		;match byte?		beq	hit_newline1		;yes		dey				;no - checked whole list?		bpl	newline_loop		;no - so loop		txy				;yes - so recover offset		iny				;bump it		cpy	xfer_count		;done all?		bne	slow_loop		;no - so loop		bra	restore_a		;yes - so continue		** We only have to look at one newline character. Do the transfer.*medium_xfer	ldy	#0			;init offsetmedium_loop	lda	[src_ptr],y		;get byte		sta	[data_buf_ptr],y	;store byte		and	newline_mask		;mask it		cmp	newline_char		;match newline?		beq	hit_newline2		;yes		iny				;no, bump offset		cpy	xfer_count		;done all?		bne	medium_loop		;no - so loop		bra	restore_a		;yes - so continue		** We hit a newline character. * Set xfer_count to current offset + 1 and set newline_flag.*hit_newline1	txy				;retrieve offsethit_newline2	iny				;bump offset by 1		sty	xfer_count		;set xfer_count		inc	newline_flag		;set newline_flag** Restore 16-bit A.  Restore newline_length.  Branch to finish_up.*		longa	on			restore_a	rep	#$20			;set 16	bit A		inc	newline_length		;restore length		bra	finish_up		;branch		** We don't have to check for newline so use move_info to move data into data_buffer.*fast_xfer	pei	<src_ptr+2		;push source pointer		pei	<src_ptr		pei	<data_buf_ptr+2		;push destination pointer		pei	<data_buf_ptr		pea	0			;push transfer request count		lda	xfer_count		pha		pea	move_sinc_dinc		jsl	move_info		;do the move** Ok, we've moved the data, now set block_mark = block_mark + xfer_count. *finish_up	clc				;block_mark = block_mark + xfer_count					lda	block_mark		adc	xfer_count		sta	block_mark** Indicate no error and exit.*exit		clc 		rts				ENDP				eject********************************************************************************	 Name:	transfer_w_data** Description:	Transfers data from caller's data buffer to fcr's block buffer.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<block_buf_ptr - ptr to fcr's block buffer*		<data_buf_ptr - ptr to caller's data buffer*		eof - end of file*		file_mark - current file mark*		block_mark - current block buffer mark*		bytes_left - # bytes till satisfy request*		transfer_count - # bytes already transfered**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**		xfer_count - # of bytes transfered*		block_mark - new block buffer mark**	 Uses:	all registers**   Called by:	write	**	Calls:	move_info		(system service)** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************transfer_w_data	PROC		with	data** Init xfer_count to 0.*		stz	xfer_count		stz	xfer_count+2** If block_mark = phys_blk_size then buffer is full so exit.*		lda	block_mark		;get block_mark		cmp	#phys_blk_size		;are we at the end of the block?		beq	exit			;yes - so exit** Set xfer_count = phys_blk_size - block_mark.*		sec						lda	#phys_blk_size				sbc	block_mark				sta	xfer_count		** If bytes_left	<= xfer_count then set xfer_count = bytes_left.*		ldx	bytes_left+2		;is bytes_left <= xfer_count?		bne	count_ok		;no 		cmp	bytes_left				bcc	count_ok		;no 		lda	bytes_left		;yes - so set xfer_count = bytes_left		sta	xfer_countcount_ok** Use move_info to move data from data_buffer into block_buffer.*		pei	<data_buf_ptr+2		;push source pointer		pei	<data_buf_ptr				clc				;dest ptr = block_buf_ptr + block_mark			lda	<block_buf_ptr				adc	block_mark		tax			lda	<block_buf_ptr+2		adc	#0		pha				;push destination ptr		phx		pea	0			;push transfer request count		lda	xfer_count		pha		pea	move_sinc_dinc		jsl	move_info		;do the move** Ok, we've moved the data, now set block_mark = block_mark + xfer_count. *		clc				;block_mark = block_mark + xfer_count					lda	block_mark		adc	xfer_count		sta	block_mark** Indicate no error and exit.*exit		clc 		rts				ENDP				eject********************************************************************************	 Name:	update_rw_info** Description:	Updates <data_buf_ptr, file_mark, bytes_left and transfer_count.*		Returns carry clear if request has been satisfied.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		xfer_count - # of bytes just transfered*		<data_buf_ptr - ptr to caller's data buffer*		file_mark - file mark*		bytes_left - # bytes till satisfy request*		transfer_count - total # bytes transfered*		newline_flag - 1 if newline character was found, else 0**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = request has not been satisfied*			   0 = request has been satisfied*		B = K**		<data_buf_ptr - new ptr to caller's data buffer*		file_mark - new file mark*		bytes_left - new # bytes till satisfy request*		transfer_count - new total # bytes transfered**	 Uses:	all registers**   Called by:	read*		write**	Calls:	nothing** Copyright Apple Computer, Inc. 1989-90  All rights reserved.******************************************************************************update_rw_info	PROC		with	data** Set <data_buf_ptr = <data_buf_ptr + xfer_count.  *		clc						lda	xfer_count		tax		adc	<data_buf_ptr		sta	<data_buf_ptr		lda	xfer_count+2		tay		adc	<data_buf_ptr+2		sta	<data_buf_ptr+2** Set transfer_count = transfer_count +	xfer_count.*		clc						txa		adc	transfer_count		sta	transfer_count		tya		adc	transfer_count+2		sta	transfer_count+2** Set file_mark = file_mark + xfer_count.*		clc						txa		adc	file_mark		sta	file_mark		tya		adc	file_mark+2		sta	file_mark+2** Set bytes_left = bytes_left -	xfer_count.*		sec						lda	bytes_left		sbc	xfer_count		sta	bytes_left		lda	bytes_left+2		sbc	xfer_count+2		sta	bytes_left+2** Return with carry clear if bytes_left = 0 or newline_flag <> 0.* Otherwise, return with carry set.*		clc				;clear carry		lda	newline_flag		;did we hit a newline char?		bne	exit			;yes - so return with carry clear		lda	bytes_left			ora	bytes_left+2		;bytes_left = 0?		beq	exit			;yes - so return with carry clear		sec				;no - so return with carry setexit		rts		ENDP		eject		********************************************************************************	 Name:	hfs_init** Description:	This routine writes an initial HFS volume structure on a*		selected volume.  It is assumed that the disk has already*		been formatted.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**		<drvr_dev_num - device number to init *		<gbuf_ptr - ptr to 512 byte general purpose buffer*		volname - volume name in gstring format**      Output:	A = error code if carry set*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..1 = error*			   0 = no error*		B = K**	 Uses:	all registers*		<temp0*		<temp1*		<a1 - <a5*		d0, d1, d2**   Called by:	erase*		format**	Calls:	do_status_call*		gbuf_write*		word_multiply*		long_multiply*		word_divide*		long_divide*		long_divide_up** Copyright Apple Computer, Inc. 1984-91  All rights reserved.******************************************************************************hfs_init	PROC		with	data					;local equates					num_ablks	equ	a2		;word - # of alloc blocks on volumetree_ablks	equ	a3		;word - tree clump size in alloc blockstree_pblks	equ	a4		;word - tree clump size in physical blockstree_bytes	equ	a5		;long - tree clump size in bytes** Do a device status call to determine the # of physical blocks on the device.*		jsr	do_status_call		bcs	brl_exit** Make sure volume is big enough.*		lda	status_list+4		bne	big_enough		lda	status_list+2		cmp	#min_vol_size		bcs	big_enough		lda	#drvr_bad_block		;volume is too small so return error		secbrl_exit	brl	exitbig_enough** Zero out blocks 0 and 1 (the boot blocks) on disk.*		jsr	clear_gbuf		;zero out the buffer		write_block_0	ldx	#0			;lo word of physical block # to write		ldy	#0			;hi word of physical block # to write		jsr	gbuf_write		;write the block		bcc	@write_ok		cmp	#drvr_disk_sw		;did we get a disk switched error?		beq	write_block_0		;yes - so try again		sec				;no - so return error		brl	exit@write_ok				ldx	#1			;lo word of physical block # to write		ldy	#0			;hi word of physical block # to write		jsr	gbuf_write		;write the block		bcs	brl_exit** Calculate the allocation block size in bytes.* (# of physical blocks on vol/64K) + 1 = # of physical blocks per alloc block* # of physical blocks per alloc block * 512 = alloc block size in bytes*		sec						lda	status_list+2		;get # of physical blocks on volume		sbc	#1			;subtract 1 in case it's an exact		sta	<temp0			;multiple of 64K		lda	status_list+4		sbc	#0		sta	<temp0+2				lda	<temp0+2		;get # of 64K pieces on volume 		inc	a			;zero adjust		sta	pblks_per_ablk		;to get # of physical blocks per alloc blk		sta	<multiplier				lda	#phys_blk_size		;multiply by physical block size in bytes		sta	<multiplicand				jsr	word_multiply		;to get alloc block size in bytes				lda	<product		;save result		sta	ablk_size		lda	<product+2		sta	ablk_size+2** Calculate the location of the first allocation block.* volume size in physical blocks / pblks_per_ablk = volume size in alloc blocks* volume size in alloc blocks / 4096 = # of bitmap blocks needed * # of bitmap blocks needed + vbm_start = location of first alloc block*		lda	status_list+2		;get # of physical blocks on volume		sta	<dividend		lda	status_list+4				sta	<dividend+2				lda	pblks_per_ablk		;divide by # of physical blocks per 		sta	<divisor		;alloc block		stz	<divisor+2				jsr	long_divide		;to get volume size in alloc blocks		lda	#4096			;then divide by 4096		sta	<divisor		;		jsr	word_divide		;to get # of bitmap blocks needed		jsr	long_divide		;to get # of bitmap blocks needed  09/04/91 JEV				lda	<remainder		beq	@no_rem		inc	<dividend		;adjust for non-zero remainder@no_rem				clc		lda	<dividend		;then add the # of bitmap blocks needed		adc	#vbm_start		;to vbm_start to get		sta	ablk_start		;the location of the first alloc block** Calculate # of allocation blocks on volume.* ((volume size in physical blocks - ablk_start) / pblks_per_ablk) - 2  = # of alloc blocks*		sec				;get # of physical blocks on volume		lda	status_list+2		sbc	ablk_start		;and adjust for 'lost' space		sta	<dividend		lda	status_list+4		sbc	#0		sta	<dividend+2				lda	pblks_per_ablk		;divide by # of physical blocks per ablk		sta	<divisor		stz	<divisor+2				jsr	long_divide		;to get # of alloc blocks on volume				sec		lda	<dividend		;get result		sbc	#2			;subtract 2 for alternate VIB		sta	<num_ablks		;and save** Calculate tree clump size in bytes.* (volume size in physical blocks / 128) * 512 = tree clump size in bytes* (minimum tree clump size = 2 physical blocks)* (maximum tree clump size = 1MB - ablk_size)*		lda	status_list+2		;get # of physical blocks on volume		sta	<dividend		lda	status_list+4				sta	<dividend+2				lda	#128			;divide by 128 		sta	<divisor				stz	<divisor+2				jsr	long_divide		;to get tree clump size in physical blocks			lda	<dividend		cmp	#2		bcs	@ok					lda	#2			;minimum clump size = 2 physical blocks@ok		sta	<multiplicand		lda	#phys_blk_size		;multiply by physical block size in bytes		sta	<multiplier				jsr	word_multiply		;to get clump size in bytes				lda	<product		;save result		sta	<tree_bytes		lda	<product+2		sta	<tree_bytes+2		stz	<temp0			;temp0 <- (1MB - ablk_size)		lda	#$0010		sta	<temp0+2		sec		lda	<temp0		sbc	ablk_size		sta	<temp0		lda	<temp0+2		sbc	ablk_size+2		sta	<temp0+2				lda	<tree_bytes+2		;if tree_bytes > temp0 then		cmp	<temp0+2		bcc	clump_ok		bne	clump_bad		lda	<temp0		cmp	<tree_bytes		bcs	clump_okclump_bad	lda	<temp0			;tree_bytes <- temp0		sta	<tree_bytes		lda	<temp0+2		sta	<tree_bytes+2clump_ok** Calculate tree clump size in alloc blocks.* tree clump size in bytes / alloc block size = tree clump size in alloc blocks*		lda	<tree_bytes		;get tree clump size in bytes		sta	<dividend		lda	<tree_bytes+2		sta	<dividend+2				lda	ablk_size		;divide by alloc block size		sta	<divisor		lda	ablk_size+2		sta	<divisor+2				jsr	long_divide_up		;to get tree clump size in alloc blocks				lda	<dividend		;store result		sta	<tree_ablks** Re-calculate tree_bytes so it's a multiple of ablk_size.* tree clump size in alloc blocks * alloc block size = tree clump size in bytes*		lda	<tree_ablks		;get tree clump size in alloc blocks		sta	<multiplicand		stz	<multiplicand+2				lda	ablk_size		;multiply by alloc block size		sta	<multiplier		lda	ablk_size+2		sta	<multiplier+2				jsr	long_multiply		;to get tree clump size in bytes		lda	<product		;store result		sta	<tree_bytes		lda	<product+2		sta	<tree_bytes+2** Calculate tree clump size in physical blocks.* tree clump size in alloc blocks * pblks_per_ablk = tree clump size in physical blocks*		lda	<tree_ablks		;get tree clump size in alloc blocks		sta	<multiplicand				lda	pblks_per_ablk		;multiply by pblks_per_ablk		sta	<multiplier				jsr	word_multiply		;to get tree clump size in physical blocks				lda	<product		;store result		sta	<tree_pblks		** Create the Volume Information Block.*		lda	<gbuf_ptr		;setup A1.L to point to start of buffer		sta	<a1		lda	<gbuf_ptr+2		sta	<a1+2						lda	#hfs_signature		ldy	#vib_signature		jsr	store_word		;set vib_signature				lda	time		ldx	time+2		jsr	store_long		;set vib_create_dt		jsr	store_long		;set vib_mod_dt				lda	#vbm_start		ldy	#vib_vbm_start		jsr	store_word		;set vib_vbm_start				lda	<num_ablks		ldy	#vib_num_ablks		jsr	store_word		;set vib_num_ablks				lda	ablk_size		ldx	ablk_size+2		jsr	store_long		;set vib_ablk_size				lda	ablk_size		;file clump size = (4 * ablk_size)		sta	<temp0		lda	ablk_size+2		sta	<temp0+2		asl	<temp0		rol	<temp0+2		asl	<temp0		rol	<temp0+2				lda	<temp0		ldx	<temp0+2		jsr	store_long		;set vib_fclump_size				lda	ablk_start		jsr	store_word		;set vib_ablk_start				lda	#next_file_id		ldx	#^next_file_id		jsr	store_long		;set vib_next_id				sec				;# of free ablks on volume =		lda	<num_ablks		;# of ablks on volume -		sbc	<tree_ablks		;# of ablks used for the 2 trees		sbc	<tree_ablks		jsr	store_word		;set vib_free_ablks		jsr	store_name		;copy volume name into vib		lda	#2			;init write count to 2		ldx	#0		ldy	#vib_write_cnt		jsr	store_long		;set vib_write_cnt				lda	<tree_bytes		ldx	<tree_bytes+2		jsr	store_long		;set vib_eclump_size		jsr	store_long		;set vib_cclump_size		ldy	#vib_etree_peof		jsr	store_long		;set vib_etree_peof		ldy	#vib_ctree_peof		jsr	store_long		;set vib_ctree_peof				lda	<tree_ablks		ldy	#vib_etree_ext+2		jsr	store_word		;set ETree extent length		ldy	#vib_ctree_ext		jsr	store_word		;set CTree extent start		jsr	store_word		;set CTree extent length** Write the VIB out to disk.*		ldx	#vib_block		;lo word of physical block # to write		ldy	#0			;hi word of physical block # to write		jsr	gbuf_write		;write the block		bcs	brl_exit2** Put a spare copy of the VIB at the end of the volume.*		sec		lda  	status_list+2		;calculate the physical block # of 		sbc  	#2			;the alternate VIB and store in X,Y		tax		lda  	status_list+4		sbc  	#0		tay		jsr	gbuf_write		;write the block		bcs	brl_exit2** Set up the volume bitmap.*		jsr	clear_gbuf		;zero out the buffer				lda	<tree_ablks		;get tree size in alloc blocks		asl	a			;multiply by 2 since we have 2 trees		sta	<dividend		;to get # of used alloc blocks				lda	#8			;divide by 8		sta	<divisor				jsr	word_divide		;to determine # of $FF bytes in bitmap				ldy	#0			;init offset into bitmap				lda	<dividend		;any whole bytes to set?		beq	no_bytes		;no				lda	#$00ff			;yes - so init byte to $FFbyte_loop	sta	[gbuf_ptr],y		;store byte into the buffer		iny				;bump offset by 1		dec	<dividend				bne	byte_loop		;loop until doneno_bytes		lda	<remainder		;any remaining bits to set?		beq	no_bits			;no				lda	#$8000			;yes - so init byte with 1 bit setbit_loop	dec	<remainder		;any more bits to set?		beq	store_bits		;no		sec				;yes - so set another bit		ror	a			;and shift bits right by 1		bra	bit_loop		;loop		store_bits	xba				;change byte sex		sta	[gbuf_ptr],y		;store the byte into the bufferno_bits** Write out the first bitmap block.*		ldx	#vbm_start		;lo word of physical block # to write		ldy	#0			;hi word of physical block # to write		jsr	gbuf_write		;write the block		bcc	vbm_okbrl_exit2	brl	exitvbm_ok** Zero out the rest of the bitmap blocks (if any).*		jsr	clear_gbuf		;zero out the buffer				ldx	#vbm_start		;lo word of physical block # to writevbm_loop	inx		cpx	ablk_start		;are we done?;		beq	vbm_done		;yes		bcs	vbm_done		;yes   09/03/91  JEV				phx				;save block #		ldy	#0			;hi word of physical block # to write		jsr	gbuf_write		;write the block		plx				;retrieve block #		bcs	brl_exit2		bra	vbm_loop		;loopvbm_done** Create and write out the Extents BTree Header Node.*		lda	ablk_start		sta	d0			;D0.W <- physical block #				stz	d1			;D1.W <- # of records in tree				lda	#7		sta	d2			;D2.W <- max key length				jsr	create_hdr_node		;create and write out a BTree Header Node		bcs	brl_exit2** Create and write out the Catalog BTree Header Node.*		clc		lda	ablk_start		adc	<tree_pblks		sta	d0			;D0.W <- physical block #				lda	#2		sta	d1			;D1.W <- # of records in tree				lda	#37		sta	d2			;D2.W <- max key length				jsr	create_hdr_node		;create and write out a BTree Header Node		bcs	brl_exit2** Set up the Node Descriptor for the first leaf node in the Catalog Tree.*		jsr	clear_gbuf		;zero out the buffer				lda	#$ff01			;node type = $ff, node level = 1		ldy	#nd_type		jsr	store_word		;set nd_type and nd_level				lda	#2			;there will be 2 records in the node		jsr	store_word		;set nd_num_recs** Set up the first Key Record in the leaf node.*		clc				;bump buffer ptr past Node Descriptor		lda	<a1					adc	#len_nd		sta	<a1		lda	<a1+2		adc	#0		sta	<a1+2				ldy	#node_size-2		;get the offset to the record's offset		jsr	store_offset		;store the record's offset		lda	#vol_parent_id		ldx	#^vol_parent_id		ldy	#cky_parent_id		jsr	store_long		;set cky_parent_id				jsr	store_name		;copy volume name into key				ldy	#cky_name		lda	[a1],y			;get name length		and	#$00ff			;only want lo byte		inc	a			;add 1 for length byte itself		inc	a			;round up to even # of bytes		lsr	a		asl	a		clc		adc	#5			;calculate length of key record		xba				;change byte sex since length is a byte		ldy	#cky_key_len		jsr	store_word		;and store** Set up the first Data Record (a directory record for the root dir) in the leaf node.*		ldy	#cky_key_len		lda	[a1],y			;get length of key record		inc	a			;add 1 for key length itself				clc		adc	<a1			;bump buffer ptr past Key Record		sta	<a1		lda	<a1+2		adc	#0		sta	<a1+2		lda	#$0100			;record type = 1 (directory record)		ldy	#cat_type		jsr	store_word		lda	#vol_dir_id		ldx	#^vol_dir_id		ldy	#dir_id		jsr	store_long		;set dir_id				lda	time		ldx	time+2		jsr	store_long		;set dir_create_dt		jsr	store_long		;set dir_mod_dt** Set up the second Key Record in the leaf node.*		clc				;bump buffer ptr past Data Record		lda	<a1		adc	#len_dir		sta	<a1		lda	<a1+2		adc	#0		sta	<a1+2		ldy	#node_size-4		;get the offset to the record's offset		jsr	store_offset		;store the record's offset		lda	#$0700			;key length = 7		ldy	#cky_key_len		jsr	store_word		;set cky_key_len						lda	#vol_dir_id		ldx	#^vol_dir_id		ldy	#cky_parent_id		jsr	store_long** Set up the second Data Record (a thread record for the root dir) in the leaf node.*		clc				;bump buffer ptr past Key Record		lda	<a1		adc	#8		sta	<a1		lda	<a1+2		adc	#0		sta	<a1+2		lda	#$0300			;record type = 3 (thread record)		ldy	#cat_type		jsr	store_word				lda	#vol_parent_id		ldx	#^vol_parent_id		ldy	#thd_parent_id		jsr	store_long		;set thd_parent_id			jsr	store_name		;copy volume name into thread record** Set up the free space offset in the leaf node.*		clc				;bump buffer ptr past Data Record		lda	<a1		adc	#len_thd		sta	<a1		lda	<a1+2		adc	#0		sta	<a1+2				ldy	#node_size-6		;get the offset to the free space offset		jsr	store_offset		;store the free space offset** Write out the leaf node.*		clc		lda	ablk_start		adc	<tree_pblks		;get starting block # of CTree		inc	a			;advance beyond header node		tax				;lo word of physical block # to write		ldy	#0			;hi word of physical block # to write		jsr	gbuf_write		;write the block		bcs	exit** Indicate no error and exit.*		clcexit		rts;------------------------------------------------------------------------------; store_word routine;; Input:	A = word to store into buffer;		X = undefined;		Y = offset into buffer;;		<A1.L - ptr to buffer;; Output:	A = unchanged;		X = undefined;		Y = original value + 2;		P = nvmxdizc;		    ..000... ;;------------------------------------------------------------------------------store_word	xba				;change byte sex		sta	[a1],y			;store word in buffer		iny				;bump offset by 2		iny		xba				;restore original value of A		rts				;and return;------------------------------------------------------------------------------; store_long routine;; Input:	A = lo word to store into buffer;		X = hi word to store into buffer;		Y = offset into buffer;;		<A1.L - ptr to buffer;; Output:	A = unchanged;		X = unchanged;		Y = original value + 4;		P = nvmxdizc;		    ..000... ;;------------------------------------------------------------------------------store_long	pha				;save lo word		txa				;get hi word 		xba				;change byte sex		sta	[a1],y			;store word in buffer		iny				;bump offset by 2		iny		pla				;retrieve lo word		xba				;change byte sex		sta	[a1],y			;store word in buffer		iny				;bump offset by 2		iny		xba				;restore original value of A		rts				;and return		;------------------------------------------------------------------------------; store_name routine;; Input:	A = undefined;		X = undefined;		Y = offset into buffer;;		<A1.L - ptr to buffer;		volname - volume name in gstring format;; Output:	A = undefined;		X = undefined;		Y = undefined;		P = nvmxdizc;		    ..000... ;;------------------------------------------------------------------------------store_name	ldx	#0			;init offset into volname				lda	volname			;get length word		sta	[a1],y			;and store in buffer		iny				;bump buffer offset				sep	#$30			;begin 8-bit mode 		longa	off					longi	off			name_loop	lda	volname+2,x		;get byte from volname		sta	[a1],y			;and store in buffer		iny				;bump offsets		inx		cpx	volname				bcc	name_loop		;loop until done		rep	#$30			;restore 16-bit mode		longa	on					longi	on				rts				;and return		;------------------------------------------------------------------------------; store_offset routine;; Input:	A = undefined;		X = undefined;		Y = offset to offset;			   ;		<A1.L - ptr to start of record;		<gbuf_ptr - ptr to start of buffer;; Output:	A = undefined;		X = undefined;		Y = undefined;		P = nvmxdizc;		    ..000... ;;------------------------------------------------------------------------------store_offset	sec				;calculate offset to record		lda	<a1			;from start of buffer		sbc	<gbuf_ptr		xba				;change byte sex		sta	[gbuf_ptr],y		;and store at end of buffer				rts		;------------------------------------------------------------------------------; clear_gbuf routine;------------------------------------------------------------------------------clear_gbuf	lda	#0		ldy	#$01FEclear_loop	sta	[gbuf_ptr],y		dey		dey		bpl	clear_loop				rts;------------------------------------------------------------------------------; create_hdr_node routine;; Input:	A = undefined;		X = undefined;		Y = undefined;;		<A1.L - ptr to start of buffer;		D0.W - physical block #;		D1.W - # of records in tree;		D2.W - max key length;; Output:	A = error code if carry set;		X = undefined;		Y = undefined;		P = nvmxdizc;		    ..000..1 = error;			   0 = no error;;------------------------------------------------------------------------------create_hdr_node; Setup the Node Descriptor for the BTree Header Node		ldy	#nd_type		lda	#nd_hdr_type		sta	[a1],y			;set nd_type				ldy	#nd_num_recs		lda	#3		jsr	store_word		;set nd_num_recs		; Setup the Header Record		lda	#$8000			;mark first node used in bitmap		sta	<temp0				lda	<tree_pblks		;temp1 <- # of free nodes in tree		sta	<temp1				lda	d1			;are there any records in the tree?		beq	@no_recs		;no				lda	#$c000			;yes - so mark second node used  		sta	<temp0					dec	<temp1			;and decrement the # of free nodes				ldy	#len_nd+hdr_depth		lda	#1		ldx	#0		jsr	store_word		;set hdr_depth		jsr	store_long		;set hdr_root_node				lda	d1			;get # of records in tree		jsr	store_long		;and set hdr_num_recs				lda	#1		jsr	store_long		;set hdr_first_node		jsr	store_long		;set hdr_last_node@no_recs		ldy	#len_nd+hdr_node_size		lda	#node_size		jsr	store_word		;set hdr_node_size				lda	d2			;get max key length		jsr	store_word		;and set hdr_max_key				lda	<tree_pblks		;get # of nodes in tree		ldx	#0		jsr	store_long		;set hdr_num_nodes				lda	<temp1			;get # of free nodes in tree		dec	a			;and dec since 1 node used for header		jsr	store_long		;set hdr_free_nodes		; Setup the Bitmap Record		ldy	#len_nd+len_hdr+128	;get offset to Bitmap Record		lda	<temp0			;get first bitmap word		jsr	store_word		;and store		; Store the offsets to the records at the end of the node		ldy	#node_size-8				lda	#len_nd+len_hdr+128+256	;get offset to free space		jsr	store_word		;and store				lda	#len_nd+len_hdr+128	;get offset to Bitmap Record		jsr	store_word		;and store				lda	#len_nd+len_hdr		;get offset to Reserved Record		jsr	store_word		;and store				lda	#len_nd			;get offset to Header Record		jsr	store_word		;and store; Write out the BTree Header Node		ldx	d0			;lo word of physical block # to write		ldy	#0			;hi word of physical block # to write		jsr	gbuf_write		;write the block		rts				ENDP						eject********************************************************************************	 Name:	copy_word** Description:	Copies 1 word from source to destination.*		The byte sex of the word is reversed.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = destination offset*		Y = source offset*		P = nvmxdizc*		    ..000...*		B = K**		<source_ptr - ptr to source	(aka <product) *		<dest_ptr - ptr to destination	 **      Output:	A = undefined*		X = original value + 2*		Y = original value + 2*		P = nvmxdizc*		    ..000..0 *		B = K**	 Uses:	all registers**   Called by:	build_vcr*		build_fcr*		update_vib*		update_bth**	Calls:	nothing** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************copy_word	PROC		with	data 		lda	[source_ptr],y		;get word from source		xba				;change byte sex		phy				;save source offset		txy				;get dest offset		sta	[dest_ptr],y		;store word in dest		tyx				;put dest offset back in X		ply				;recover source offset into Y		inx				;increment both offsets to next word		inx		iny						iny				clc				;indicate no error		rts				;and exit				ENDP				eject********************************************************************************	 Name:	copy_long** Description:	Copies 1 longword from source to destination.*		The byte sex of the longword is reversed.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = destination offset*		Y = source offset*		P = nvmxdizc*		    ..000...*		B = K**		<source_ptr - ptr to source	(aka <product) *		<dest_ptr - ptr to destination	 **      Output:	A = undefined*		X = original value + 4*		Y = original value + 4*		P = nvmxdizc*		    ..000..0 *		B = K**	 Uses:	all registers**   Called by:	create*		get_cat_info*		build_vcr*		build_fcr*		update_vib*		update_alt_vib*		update_bth**	Calls:	nothing** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************copy_long	PROC		with	data		phy				;save source offset 		lda	[source_ptr],y		;get word from source		xba				;change byte sex		pha				;and save on stack		iny		iny		lda	[source_ptr],y		;get next word from source		xba				;change byte sex		pha				;and save on stack				txy				;get dest offset		pla				;retrieve word from stack		sta	[dest_ptr],y		;store word in dest		iny		iny		pla				;retreive next word from stack		sta	[dest_ptr],y		;store word in dest				tyx				;put dest offset back in X		inx				;adjust dest offset		inx				ply				;recover source offset into Y		iny				;adjust dest offset		iny		iny						iny				clc				;indicate no error		rts				;and exit				ENDP				eject********************************************************************************	 Name:	copy_ext** Description:	Copies an extents record (6 words) from source to destination.*		The byte sex of the words is NOT reversed.**	Entry:	jsr**	 Exit:	rts**	Input:	A = undefined*		X = destination offset*		Y = source offset*		P = nvmxdizc*		    ..000...*		B = K**		<source_ptr - ptr to source	(aka <product) *		<dest_ptr - ptr to destination	 **      Output:	A = undefined*		X = original value + 12*		Y = original value + 12*		P = nvmxdizc*		    ..000..0 *		B = K**	 Uses:	all registers**   Called by:	create*		set_eof*		build_vcr*		build_fcr*		update_vib*		update_alt_vib**	Calls:	nothing** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************copy_ext	PROC		with	data		lda	#6			;initialize count 		loop 		pha				;save count		lda	[source_ptr],y		;get word from source		phy				;save source offset		txy				;get dest offset		sta	[dest_ptr],y		;store word in dest		tyx				;put dest offset back in X		ply				;recover source offset into Y		inx				;increment both offsets to next word		inx		iny						iny		pla				;retrieve count		dec	a			;decrement count		bne	loop			;loop until done				clc				;indicate no error		rts				;and exit				ENDP				eject********************************************************************************	 Name:	handle_conv_err** Description:	Checks the error code returned from a call to ConvSeconds.*		If the error code is $2, the ConvSeconds routine is not installed  *		so the input parameters must be pulled off the stack.**	Entry:	jsr**	 Exit:	rts**	Input:	A = error code*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000...*		B = K**      Output:	A = undefined*		X = undefined*		Y = undefined*		P = nvmxdizc*		    ..000..0 *		B = K**	 Uses:	all registers**   Called by:	setup_call*		get_create_mod*		set_create_dt*		set_mod_dt**	Calls:	nothing** Copyright Apple Computer, Inc. 1990  All rights reserved.******************************************************************************handle_conv_err	PROC		with	data		cmp	#2			;ConvSeconds routine not installed?		bne	done			;no - we got a real error		plx				;pull return address off stack		pla				;pull input params off stack		pla		pla		pla		pla		phx				;push return address back on stackdone		rts				ENDP						eject********************************************************************************* END OF CODE********************************************************************************end_segment	PROCend_code							ENDP		eject		END