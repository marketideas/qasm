		eject********************************************************************************* GS/OS HFS FST Equates** Copyright 1987-91 Apple Computer, Inc.  All Rights Reserved.****************************************************************************************************************************************************************  REVISION HISTORY:**  Date	    By	 Description*	*  5/25/90  CAE	 Alpha 01 release.*  6/19/90  CAE  Adjusted the input/output parameter equates since i_request_fst*		   was removed.* 10/04/90  CAE  Added equate for "ashare_id".* 10/19/90  CAE  Removed some unused equates.  Moved equates from hfs.fst.btree*		   into this file.* 10/19/90  CAE  Beta 01 release.*  1/18/91  CAE	 Added input and output parameter equates for the JudgeName call.*  1/30/91  CAE  "product" is now 4 bytes long instead of 8.*  2/01/91  CAE  Removed some unused equates.*  2/18/91  CAE  Added equate for "prodos_id".* 10/29/91  MSD  Added locked_access equate.* 12/05/91  MSD  Added i_cp_flags.*  3/26/92 Monte Benaresh*		Added a stack_end variable on direct page and shortened the*		stack_ptr to a word since it now resides in bank $00.********************************************************************************;------------------------------------------------------------------------------; Direct page equates	(FSTs may use up to 84 bytes on GS/OS direct page);------------------------------------------------------------------------------; Main direct page equatesmy_pblk_ptr	equ	fst_start		;pointer to parameter blockmy_vcr_ptr	equ	my_pblk_ptr+4		;pointer to volume control recordmy_fcr_ptr	equ	my_vcr_ptr+4		;pointer to file control recordmy_path_ptr	equ	my_fcr_ptr+4		;pointer to pathnamegbuf_ptr	equ	my_path_ptr+4		;pointer to 512B general purpose buffer block_buf_ptr	equ	gbuf_ptr+4		;pointer to fcr's 512B block bufferdata_buf_ptr	equ	block_buf_ptr+4		;pointer to caller's data buffer; Direct page equates for the BTree routinesstack_ptr	equ	data_buf_ptr+4		;pointer to stack-1 for BTree routines*** stack_ptr changed to a word b/c pseudo stack is in bank $00*** -- Monte Benaresh 3/26/92stack_index	equ	stack_ptr+2		;index into BTree routine stackstack_end	equ stack_index+2		;added 3/26/92 by Montea0		equ	stack_end+2a1		equ	a0+4a2		equ	a1+4a3		equ	a2+4a4		equ	a3+4a5		equ	a4+4; Direct page temporaries (used by main code and BTree routines)temp0 		equ	a5+4			;4 byte temptemp1		equ	temp0+4			;4 byte temp - must follow temp0; Direct page equates for word_multiply, long_multiply, word_divide and long_dividemultiplicand	equ	temp1+4			;32 bit	multiplicandmultiplier	equ	multiplicand+4		;32 bit	multiplierproduct		equ	multiplier+4		;32 bit multiplication productdividend	equ	multiplicand		;32 bit	dividend/quotientdivisor		equ	multiplier		;32 bit	divisorremainder	equ	product			;32 bit	remainder; Direct page equates for copy_word, copy_long and copy_extsource_ptr	equ	product			;pointer to sourcedest_ptr	equ	source_ptr+4		;pointer to destination;------------------------------------------------------------------------------; Miscellaneous equates;------------------------------------------------------------------------------hfs_signature	equ	$4244			;signature word for an HFS volumevib_block	equ	2			;physical block # where VIB residesvbm_start	equ	3			;physical block # where bitmap startsvol_parent_id	equ	1			;volume parent IDvol_dir_id	equ	2			;volume directory IDctree_file_id	equ	4			;file ID for CTreeetree_file_id	equ	5			;file ID for ETreenext_file_id	equ	16			;next free file/dir ID min_vol_size	equ	10			;min volume size (in physical blocks)phys_blk_size	equ	512			;physical block size (in bytes)node_size	equ	512			;BTree node size (in bytes)stack_size	equ	1024			;BTree psuedo stack size (in bytes)max_btree_depth	equ	8			;max BTree depthmax_volname	equ	27			;max HFS volname lengthmax_filename	equ	31			;max HFS filename lengthmax_class0_name	equ	15			;max class 0 name lengthseparator0	equ	$2f			;class 0 separator ('/')separator1	equ	$3a			;class 1 separator (':')path1_bit	equ	$4000			;indicates if path1 is validpath2_bit	equ	$0040			;indicates if path2 is validdib_blk_cnt	equ	$000a			;offset to block count in DIB; FST ID equateshfs_id		equ	$0006			;HFS file system IDashare_id	equ	$000d			;AppleShare file system IDprodos_id	equ	$0001			;ProDOS file system ID; Cache equatescache_on	equ	$0002			;put blocks in cachedeferred_on	equ	$8000			;do deferred writes; Device status flag bit equatesswitched_bit	equ	$0001			;disk has been switchedprotected_bit	equ	$0004			;device is write-protectedonline_bit	equ	$0010			;disk is in drive; GS/OS command equatesmax_app_cmd	equ	$0066			;max valid application command * 2max_sys_cmd	equ	$0008			;max valid system command * 2max_fst_cmd	equ	$0000			;max valid fst specific command  max_class	equ	$0001			;max valid class #max_base_val	equ	$0003			;max valid value for base parametermax_cache_val	equ	$0001			;max valid value for cache parametermax_raccess_val	equ	$0003			;max valid value for request_access parametermax_rsrcnum_val	equ	$0001			;max valid value for resource_num parametermax_ntype_val	equ	$0003			;max valid value for name_type parametergfi_call_num	equ	$06			;call number for get_file_infoopen_call_num	equ	$10			;call number for opengde_call_num	equ	$1c			;call number for get_dir_entryextended_bit	equ	$8000			;extended flag for get_dir_entry; GS/OS access equatesread_enabled	equ	$0001write_enabled	equ	$0002invisible	equ	$0004backup_needed	equ	$0020rename_enabled	equ	$0040destroy_enabled	equ	$0080full_access	equ	$00c3locked_access	equ	$00c2			; file locked if none of these bits setreserved_bits	equ	$ff18; GS/OS request_access equatesas_permitted	equ	$0000read_access	equ	$0001write_access	equ	$0002read_write	equ	$0003; GS/OS storage type equatesstandard_stype	equ	$0001			;Standard fileextended_stype	equ	$0005			;Extended filedirectory_stype	equ	$000d			;Subdirectoryvolume_stype	equ	$000f			;Volume directory; GS/OS file type equatesdir_ftype	equ	$0f			;directory file type; Tool Call equatestool_locator	equ	$e10000Hex2Int		equ	$240b			;Hex2Int routine in Integer MathConvSeconds	equ	$3703			;ConvSeconds routine in Misc. Tools; Driver direct page locations to save within do_rw_call to support 1 level ; of recursion.start_drvr_dp	equ	drvr_call_num		;start of saved driver direct page spaceend_drvr_dp	equ	drvr_cache+2		;end of saved driver direct page spacelen_drvr_dp	equ	end_drvr_dp-start_drvr_dp  ;Length of driver dp area to save;------------------------------------------------------------------------------; Error codes used by the BTree routines;------------------------------------------------------------------------------; The following errors are returned if there is a problem with the disk structure.; The high byte of the error code is masked off before the error is reported to SCM.bt_bad_node		equ	$C151				  bt_not_map_node		equ	$C251				bt_depth_err		equ	$C351				; The following errors are generated and handled internally by the BTree routines.  ; These errors are only returned to the main routines if the FST is very confused.; The high byte of the error code is masked off before the error is reported to SCM.bt_key_exists		equ	$C46A				bt_not_found		equ	$C56A				bt_wont_fit		equ	$C66A				; The following errors should hopefully never occur.; The high byte of the error code is masked off before the error is reported to SCM.bt_no_node_buffers	equ	$C76A				bt_lost_node		equ	$C86A				bt_bad_node_buf		equ	$C96A				bt_range_err		equ	$CA6A				bt_unknown_type		equ	$CB6A				; The following errors are fatal and are reported through the 'sys_death' routine.bt_bad_rotate		equ	$006A			bt_stack_underflow	equ	$006A			bt_stack_overflow	equ	$006A			;------------------------------------------------------------------------------; Node Buffer equates;------------------------------------------------------------------------------; Node Buffer offsetsnode_storage	equ	$0000			;storage for one BTree nodenode_flags	equ	node_storage+node_size	;flags word for node buffernode_num	equ	node_flags+2		;# of node in node buffernode_loc	equ	node_num+4		;node's location on disk (phys block #)node_ref	equ	node_loc+4		;fcr ref_num from node's treelen_node_buf	equ	node_ref+2		;length of a node buffer; Node Buffer Flag bit definitions (in node_flags field)node_used_bit	equ	$0001			;bit 0 - node buffer is in usenode_dirty_bit	equ	$8000			;bit 15 - node buffer is dirty ;------------------------------------------------------------------------------; Tree Path Table (TBT) and Tree Path Record (TPR) equates;------------------------------------------------------------------------------tpr_node_num	equ	$0000			;node numbertpr_rec_index	equ	tpr_node_num+4		;record indexlen_tpr		equ	tpr_rec_index+2		;length of a Tree Path Recordlen_tpt		equ	max_btree_depth*len_tpr	;length of a Tree Path Table;------------------------------------------------------------------------------; Volume Control Record	(VCR) equates;------------------------------------------------------------------------------;vcr_id         equ    	$0000           	;volume ID;vcr_name       equ    	vcr_id+2        	;ptr to volume name;vcr_status     equ    	vcr_name+4      	;volume status;vcr_open_cnt   equ   	vcr_status+2    	;number of open files on volume;vcr_fst_id     equ    	vcr_open_cnt+2  	;owner ID number;vcr_dev        equ    	vcr_fst_id+2    	;where volume was last seenvcr_create_dt	equ	vcr_dev+2		;date/time initializedvcr_mod_dt	equ	vcr_create_dt+4		;date/time last modifiedvcr_vol_attrib	equ	vcr_mod_dt+4		;volume attributesvcr_num_r_files	equ	vcr_vol_attrib+2	;number of files in root dirvcr_vbm_start	equ	vcr_num_r_files+2	;first block of volume bitmap (P blk #)vcr_alloc_start	equ	vcr_vbm_start+2		;start of next allocation searchvcr_num_ablks	equ	vcr_alloc_start+2	;number of allocation blocks on volvcr_ablk_size	equ	vcr_num_ablks+2		;allocation block size (in bytes)vcr_fclump_size	equ	vcr_ablk_size+4		;default clump size for files (in bytes)vcr_ablk_start	equ	vcr_fclump_size+4	;loc of first alloc block (P blk #)vcr_next_id	equ	vcr_ablk_start+2	;next dir/file IDvcr_free_ablks	equ	vcr_next_id+4		;number of unused allocation blocksvcr_write_cnt	equ	vcr_free_ablks+2	;volume write count vcr_num_r_dirs	equ	vcr_write_cnt+4		;number of dirs in root dirvcr_num_files	equ	vcr_num_r_dirs+2	;number of files on volumevcr_num_dirs	equ	vcr_num_files+4		;number of dirs on volumevcr_num_pblks	equ	vcr_num_dirs+4		;number of physical blocks on volvcr_cur_dir	equ	vcr_num_pblks+4		;current dir ID (last searched)vcr_cur_kid	equ	vcr_cur_dir+4		;current offspring index (at last search)vcr_ct_fcr_vp	equ	vcr_cur_kid+2		;vp to fcr for Catalog Treevcr_et_fcr_vp	equ	vcr_ct_fcr_vp+4		;vp to fcr for Extents Treevcr_ct_ref_num	equ	vcr_et_fcr_vp+4		;refnum from Catalog Tree FCRvcr_et_ref_num	equ	vcr_ct_ref_num+2	;refnum from Extents Tree FCRlen_vcr		equ	vcr_et_ref_num+2	;length of a VCR;------------------------------------------------------------------------------; File Control Record (FCR) equates;------------------------------------------------------------------------------; common FCR fields;fcr_ref_num    equ    	$0000			;reference number;fcr_path_name  equ    	fcr_ref_num+2		;vp to pathname;fcr_fst_id     equ    	fcr_path_name+4		;owner ID number;fcr_vol_id     equ    	fcr_fst_id+2		;volume ID;fcr_level      equ    	fcr_vol_id+2;fcr_newline    equ    	fcr_level+2;fcr_newline_len equ    fcr_newline+4;fcr_mask       equ    	fcr_newline_len+2;fcr_access     equ    	fcr_mask+2fcr_type	equ	fcr_access+2		;fcr typefcr_flags	equ	fcr_type+2		;flagsfcr_parent_id	equ	fcr_flags+2		;parent dir ID fcr_id		equ	fcr_parent_id+4		;dir/file IDfcr_cat_hint	equ	fcr_id+4		;catalog hint for CLOSE and FLUSHfcr_mod_dt	equ	fcr_cat_hint+4		;date/time last modified; FCR extensions for directoriesfcr_valence	equ	fcr_mod_dt+4		;number of files and dirs in this dirfcr_cur_kid	equ	fcr_valence+2		;current offspring indexlen_d_fcr	equ	fcr_cur_kid+2		;length of an FCR for directories; FCR extensions for filesfcr_clump_size	equ	fcr_mod_dt+4		;clump size (in bytes)fcr_leof	equ	fcr_clump_size+4	;logical EOF fcr_peof	equ	fcr_leof+4		;physical EOF fcr_ext		equ	fcr_peof+4		;first extents recordfcr_file_mark	equ	fcr_ext+12		;file markfcr_block_mark	equ	fcr_file_mark+4		;block buffer markfcr_block_num	equ	fcr_block_mark+2	;# of physical block in block bufferfcr_block_count	equ	fcr_block_num+4		;# physical blocks until end of extentfcr_block_buf	equ	fcr_block_count+4	;block buffer len_f_fcr	equ	fcr_block_buf+512	;length of an FCR for files; FCR extensions for trees;fcr_clump_size	equ	fcr_mod_dt+4		;clump size (in bytes);fcr_leof	equ	fcr_clump_size+4	;logical EOF ;fcr_peof	equ	fcr_leof+4		;physical EOF ;fcr_ext	equ	fcr_peof+4		;first extents recordfcr_bcr		equ	fcr_ext+12		;BTree Control Recordbcr_flags	equ	fcr_bcr			;flags (1 byte)bcr_reserved	equ	bcr_flags+1		;reserved (1 byte)bcr_key_cmp_ptr	equ	bcr_reserved+1		;ptr to BTree's key compare routinebcr_idx_rec_ptr	equ	bcr_key_cmp_ptr+4	;ptr to BTree's index record bufferbcr_tpt_ptr	equ	bcr_idx_rec_ptr+4	;ptr to BTree's Tree Path Tablebcr_level	equ	bcr_tpt_ptr+4		;current levelbcr_node_mark	equ	bcr_level+2		;current node markbcr_index_mark	equ	bcr_node_mark+4		;current index markbcr_depth	equ	bcr_index_mark+2	;current depth of treebcr_root_node	equ	bcr_depth+2		;node # of root nodebcr_num_recs	equ	bcr_root_node+4		;number of leaf records in treebcr_first_node	equ	bcr_num_recs+4		;node # of first leaf nodebcr_last_node	equ	bcr_first_node+4	;node # of last leaf nodebcr_node_size	equ	bcr_last_node+4		;size of node (in bytes)bcr_max_key	equ	bcr_node_size+2		;max key lengthbcr_num_nodes	equ	bcr_max_key+2		;total number of nodesbcr_free_nodes	equ	bcr_num_nodes+4		;number of free nodeslen_t_fcr	equ	bcr_free_nodes+4	;length of an FCR for trees; FCR types (in fcr_type field)fcr_tree_type	equ	0			;FCR is for a tree (CTree or ETree)fcr_dir_type	equ	1			;FCR is for a directoryfcr_file_type	equ	2			;FCR is for a file; FCR Flag bit definitions (in high byte of fcr_access field)global_clean_bit equ	$8000			;bit 15 - file is clean rsrc_fork_bit	equ	$4000			;bit 14 - FCR is for resource forkglobal_clean_mask equ	$7fff			;clears bit 15; FCR Flag bit definitions (in high byte of fcr_flags field)buf_empty_bit	equ	$8000			;bit 15 - FCR block buffer is emptybuf_dirty_bit	equ	$4000			;bit 14 - FCR block buffer is dirtyfcr_dirty_bit	equ	$2000			;bit 13 - FCR is dirtyfile_dirty_bit	equ	$1000			;bit 12 - file is dirtytruncate_bit	equ	$0800			;bit 11 - truncate to peof on Closebuf_empty_mask	equ	$7fff			;clears bit 15buf_dirty_mask	equ	$bfff			;clears bit 14fcr_dirty_mask	equ	$dfff			;clears bit 13file_dirty_mask	equ	$efff			;clears bit 12truncate_mask	equ	$f7ff			;clears bit 11 ; BCR Flag bit definitions (in bcr_flags field)bcr_delptr_bit	equ	$10			;bit 4 - pointer record delete requiredbcr_newptr_bit	equ	$20			;bit 5 - new pointer record requiredbcr_keyupd_bit	equ	$40			;bit 6 - key record update requiredbcr_dirty_bit	equ	$80			;bit 7 - dirty flagnot_delptr_bit	equ	Åbcr_delptr_bit		not_keyupd_bit	equ	Åbcr_keyupd_bit		not_bcr_dirty_bit equ	Åbcr_dirty_bit		;------------------------------------------------------------------------------; HFS Volume Information Block (VIB) offsets;------------------------------------------------------------------------------vib_signature	equ	0			;signature wordvib_create_dt	equ	2			;date/time initializedvib_mod_dt	equ	6			;date/time of last modificationvib_vol_attrib	equ	10			;volume attributesvib_num_r_files	equ	12			;number of files in root dirvib_vbm_start	equ	14			;first block of volume bitmap (P blk #)vib_alloc_start	equ	16			;start of next allocation searchvib_num_ablks	equ	18			;number of allocation blocks on volvib_ablk_size	equ	20			;allocation block size (in bytes)vib_fclump_size	equ	24			;default clump size for files (in bytes)vib_ablk_start	equ	28			;loc of first alloc block (P blk #)vib_next_id	equ	30			;next dir ID or file IDvib_free_ablks	equ	34			;number of unused allocation blocksvib_volname	equ	36			;volume name (max 27 chars)vib_backup_dt	equ	64			;date/time of last backupvib_backup_num	equ	68			;index of volume in backup setvib_write_cnt	equ	70			;volume write countvib_eclump_size	equ	74			;clump size of Extents tree (in bytes)vib_cclump_size	equ	78			;clump size of Catalog tree (in bytes)vib_num_r_dirs	equ	82			;number of dirs in root dirvib_num_files	equ	84			;number of files on volumevib_num_dirs	equ	88			;number of dirs on volumevib_finder_info	equ	92			;Finder Info (32 bytes)vib_vcache_size	equ	124			;volume cache size (in blocks)vib_bcache_size	equ	126			;bitmap cache size (in blocks)vib_tcache_size	equ	128			;ETree/CTree cache size (in blocks)vib_etree_peof	equ	130			;physical EOF of Extents tree (in bytes)vib_etree_ext	equ	134			;first extents record for Extents treevib_ctree_peof	equ	146			;physical EOF of Catalog tree (in bytes)vib_ctree_ext	equ	150			;first extents record for Catalog treelen_vib		equ	162			;length of a VIB;------------------------------------------------------------------------------; HFS BTree equates (used with both the Catalog and Extents trees);------------------------------------------------------------------------------; Node Descriptor offsetsnd_flink	equ	0			;forward linknd_blink	equ	4			;backward linknd_type		equ	8			;node type (1 byte)nd_level	equ	9			;node level (1 byte)nd_num_recs	equ	10			;# of records in nodend_reserved	equ	12			;reserved (2 bytes)len_nd		equ	14			;length of a Node Descriptor; Node types (in nd_type field)nd_indx_type	equ	0			;index node typend_hdr_type	equ	1			;header node typend_map_type	equ	2			;map node typend_leaf_type	equ	$ff			;leaf node type; Header Record offsets hdr_depth	equ	0			;current depth of treehdr_root_node	equ	2			;node # of root nodehdr_num_recs	equ	6			;number of leaf records in treehdr_first_node	equ	10			;node # of first leaf nodehdr_last_node	equ	14			;node # of last leaf nodehdr_node_size	equ	18			;size of node (in bytes)hdr_max_key	equ	20			;max key lengthhdr_num_nodes	equ	22			;total number of nodeshdr_free_nodes	equ	26			;number of free nodeshdr_reserved	equ	30			;reserved (76 bytes)len_hdr		equ	106			;length of a Header Record; Pointer Record offsetsptr_node_num	equ	0			;node # of childlen_ptr		equ	4			;length of a Pointer Record;------------------------------------------------------------------------------; HFS Catalog Tree (CTree) equates;------------------------------------------------------------------------------; Key Record offsetscky_key_len	equ	0			;key length (1 byte)cky_reserved	equ	1			;reserved (1 byte)cky_parent_id	equ	2			;parent dir IDcky_name	equ	6			;name (max 31 chars)max_cky_len	equ	38			;max length of a CTree Key Record; Catalog Record offsetscat_type	equ	0			;catalog record type (1 byte)cat_reserved	equ	1			;reserved (1 byte)cat_data	equ	2			;start of catalog record data; Catalog Record types (in cat_type field)cat_dir_type	equ	1			;directory record typecat_fil_type	equ	2			;file record typecat_thd_type	equ	3			;thread record type; Directory Record offsetsdir_flags	equ	2			;flags (only lo byte used)dir_valence	equ	4			;number of files and dirs in this dirdir_id		equ	6			;ID of this directorydir_create_dt	equ	10			;date/time createddir_mod_dt	equ	14			;date/time last modifieddir_backup_dt	equ	18			;date/time last backed updir_finder_info	equ	22			;Finder Info (32 bytes)dir_reserved	equ	54			;reserved (16 bytes)len_dir		equ	70			;length of a Directory Record; File Record offsetsfil_flags	equ	2			;flags (1 byte)fil_type	equ	3			;file type (1 byte - always 0 for HFS)fil_finfo1	equ	4			;Finder Info (16 bytes)fil_id		equ	20			;ID of this filefil_data_ablk	equ	24			;first alloc block of data forkfil_data_leof	equ	26			;logical EOF of data forkfil_data_peof	equ	30			;physical EOF of data forkfil_rsrc_ablk	equ	34			;first alloc block of resource forkfil_rsrc_leof	equ	36			;logical EOF of resource forkfil_rsrc_peof	equ	40			;physical EOF of resource forkfil_create_dt	equ	44			;date/time createdfil_mod_dt	equ	48			;date/time last modifiedfil_backup_dt	equ	52			;date/time last backed upfil_finfo2	equ	56			;Finder Info (16 bytes)fil_clump_size	equ	72		 	;clump size of file (in ablks)fil_data_ext	equ	74			;first extents record for data forkfil_rsrc_ext	equ	86			;first extents record for resource forkfil_reserved	equ	98			;reserved (4 bytes)len_fil		equ	102			;length of a File Recordmax_cat_len	equ	len_fil			;max length of a Catalog Record; Thread Record offsetsthd_reserved	equ	2			;reserved (8 bytes)thd_parent_id	equ	10			;ID of parent of associated dirthd_dirname	equ	14			;name of associated dir (max 31 chars)len_thd		equ	46			;length of a Thread Record;------------------------------------------------------------------------------; HFS Extents Tree (ETree) equates;------------------------------------------------------------------------------; Key Record offsetseky_key_len	equ	0			;key length (1 byte)eky_fork_type	equ	1			;fork type (1 byte) $00=data, $ff=rsrceky_file_id	equ	2			;file ID this extents record is foreky_ablk_num	equ	6			;ablk # within file this ext rec starts atlen_eky		equ	8			;length of an ETree Key Record; Extents Record offsetsext_start_ablk	equ	0			;starting alloc block number on volumeext_num_ablks	equ	2			;number of alloc blockslen_ext_desc	equ	4			;length of an Extent Descriptorlen_ext		equ	12			;length of an Extents Recordnum_ext_desc	equ	3			;# of Extent Descriptors per Extents Recordmax_desc_off	equ	8			;maximum Extent Desciptor offset;------------------------------------------------------------------------------; HFS Finder Info offsets ;------------------------------------------------------------------------------fi_file_type	equ	0			;file's type  (file records only)fi_file_creator	equ	4			;file's creator  (file records only)fi_flags	equ	8			;Finder flags  (file and dir records);------------------------------------------------------------------------------; HFS bit definitions;------------------------------------------------------------------------------; File/Directory Flag Bits (in low byte of fcr_flags, dir_flags and fil_flags fields)locked_bit	equ	$01			;bit 0 - file is lockedrsrc_open_bit	equ	$04			;bit 2 - resource fork is opendata_open_bit	equ	$08			;bit 3 - data fork is opendirectory_bit	equ	$10			;bit 4 - indicates a directoryfile_open_bit	equ	$80			;bit 7 - file (either fork) is openlocked_mask	equ	$fffe			;clears bit 0; Finder Flag Bits (in fi_flags field within dir_finder_info and fil_finfo1 fields)fi_invis_bit	equ	$4000			;bit 14 - file/dir is invisiblefi_invis_mask	equ	$bfff			;clears bit 14;------------------------------------------------------------------------------; Option List equates;------------------------------------------------------------------------------ol_total_size	equ	$0000			;total size of option listol_req_size	equ	ol_total_size+2		;required size of data bufferol_fst_id	equ	ol_req_size+2		;fst idol_finder_info	equ	ol_fst_id+2		;finder infool_parent_id	equ	ol_finder_info+32	;parent directory idlen_ol		equ	ol_parent_id+4		;length of option listreq_ol_size	equ	len_ol-4		;required size for option list data buffer ;------------------------------------------------------------------------------; Equates for the Call Flags Table;------------------------------------------------------------------------------; Flag bit definitionspath_used	equ	$0100			;bit 8 - pathname is used by callvcr_used	equ	$0200			;bit 9 - VCR is used by callfcr_used	equ	$0400			;bit 10 - FCR is used by call; Mask equatesmax_mask	equ	$001f			;Isolate max pcount.min_mask	equ	$00e0			;Isolate min pcount.; Max pcount equatesmax_pcnt1	equ	1max_pcnt2	equ	2max_pcnt3	equ	3max_pcnt4	equ	4max_pcnt5	equ	5max_pcnt6	equ	6max_pcnt7	equ	7max_pcnt8	equ	8max_pcnt9	equ	9max_pcnt10	equ	10max_pcnt11	equ	11max_pcnt12	equ	12max_pcnt13	equ	13max_pcnt14	equ	14max_pcnt15	equ	15max_pcnt16	equ	16max_pcnt17	equ	17; Min pcount equatesmin_pcnt1	equ	$0020min_pcnt2	equ	$0040min_pcnt3	equ	$0060min_pcnt4	equ	$0080min_pcnt5	equ	$00A0;------------------------------------------------------------------------------; Equates for the Parameter Lists;------------------------------------------------------------------------------; Flag bit definitionsinput_flag	equ	$0000			;bit 7 - 0 indicates inputoutput_flag	equ	$0080			;bit 7 - 1 indicates outputterminate_flag	equ	$8000			;bit 15 - 1 indicates end of list; Mask equatesparam_mask	equ	$007f			;Isolate parameter numberoffset_mask	equ	$7f00			;Isolate parameter offsetio_mask		equ	$0080			;Isolate i/o flag; Input parameter equatesi_ref_num	equ	$0000			;(w)   i_access	equ	$0001			;(w)   i_storage_type	equ	$0002			;(w)   i_file_type	equ	$0003			;(w)   i_aux_type	equ	$0004			;(lw)  i_eof		equ	$0005			;(lw)  i_resource_eof	equ	$0006			;(lw) i_create_date	equ	$0007			;(w)   i_create_time	equ	$0008			;(w)   i_mod_date	equ	$0009			;(w)   i_mod_time	equ	$000a			;(w)   i_create_date_time equ	$000b			;(4w)  i_mod_date_time	equ	$000c			;(4w)  i_volname	equ	$000d			;(ptr) i_option_list	equ	$000e			;(ptr) i_pcount	equ	$000f			;(w)   i_command_num	equ	$0010			;(w)   i_resource_num	equ	$0011			;(w)   i_cache_priority equ	$0012			;(w)   i_request_access equ	$0013			;(w)   i_request_count	equ	$0014			;(lw) i_base		equ	$0015			;(w) i_displacement	equ	$0016			;(lw)  i_pathname	equ	$0017			;(ptr) i_new_pathname	equ	$0018			;(ptr) i_devname	equ	$0019			;(ptr) i_data_buffer	equ	$001a			;(ptr) i_null		equ	$001b			;(w) i_flush_type	equ	$001c			;(w) i_file_sys_id	equ	$001d			;(w) 	  i_name_type	equ	$001e			;(w) 	i_name		equ	$001f			;(ptr) 	i_cp_flags	equ	$003e			;(w); Output parameter equateso_ref_num	equ	$0020+output_flag	;(w)   o_access	equ	$0021+output_flag	;(w)   o_storage_type	equ	$0022+output_flag	;(w)   o_file_type	equ	$0023+output_flag	;(w)   o_aux_type	equ	$0024+output_flag	;(lw)o_eof		equ	$0025+output_flag	;(lw)  o_resource_eof	equ	$0026+output_flag	;(lw) o_create_date	equ	$0027+output_flag	;(w)   o_create_time	equ	$0028+output_flag	;(w)   o_mod_date	equ	$0029+output_flag	;(w)   o_mod_time	equ	$002a+output_flag	;(w)  o_create_date_time equ	$002b+output_flag	;(4w) o_mod_date_time	equ	$002c+output_flag	;(4w)  o_volname	equ	$002d+output_flag	;(ptr) o_option_list	equ	$002e+output_flag	;(ptr) o_transfer_count equ	$002f+output_flag	;(lw)  o_position	equ	$0030+output_flag	;(lw)  o_entry_num	equ	$0031+output_flag	;(w)   o_dev_number	equ	$0032+output_flag	;(w)   o_file_sys_id	equ	$0033+output_flag	;(w)   o_block_size	equ	$0034+output_flag	;(w)  o_extended_flag	equ	$0035+output_flag	;(w)  o_total_blocks	equ	$0036+output_flag	;(lw)  o_blocks_used	equ	$0037+output_flag	;(lw)  o_free_blocks	equ	$0038+output_flag	;(lw)  o_resource_blocks equ	$0039+output_flag	;(lw)  o_name		equ	$003a+output_flag	;(ptr) o_syntax	equ	$003b+output_flag	;(ptr) o_max_len	equ	$003c+output_flag	;(w) 	o_name_flags	equ	$003d+output_flag	;(w) 	; Parameter offset equatesoffset0		equ	$0000offset2		equ	$0200offset4		equ	$0400offset6		equ	$0600offset8		equ	$0800offsetA		equ	$0A00offsetC		equ	$0C00offsetE		equ	$0E00offset10	equ	$1000offset12	equ	$1200offset14	equ	$1400offset16	equ	$1600offset18	equ	$1800offset1A	equ	$1A00offset1C	equ	$1C00offset1E	equ	$1E00offset20	equ	$2000offset22	equ	$2200offset24	equ	$2400offset26	equ	$2600offset28	equ	$2800offset2A	equ	$2A00offset2C	equ	$2C00offset2E	equ	$2E00offset30	equ	$3000offset32	equ	$3200offset34	equ	$3400offset36	equ	$3600offset3A	equ	$3A00;------------------------------------------------------------------------------; Equates used only by the BTree routines;------------------------------------------------------------------------------; Register push/pop flag bit definitionsf_d0		equ	$0001f_d1		equ	$0002f_d2		equ	$0004f_d3		equ	$0008f_d4		equ	$0010f_d5		equ	$0020f_d6		equ	$0040f_d7		equ	$0080f_a0		equ	$0100f_a1		equ	$0200f_a2		equ	$0400f_a3		equ	$0800f_a4		equ	$1000f_a5		equ	$2000f_dRegs		equ	f_d0+f_d1+f_d2+f_d3+f_d4+f_d5+f_d6+f_d7f_aRegs		equ	f_a0+f_a1+f_a2+f_a3+f_a4+f_a5f_allRegs	equ	f_dRegs+f_aRegs; Constantsalloc_contig	equ	$0001