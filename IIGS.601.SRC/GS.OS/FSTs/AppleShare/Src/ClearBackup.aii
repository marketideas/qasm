;------------------------------------------------------------;; clear_backup;; This call takes a pathname and clears its backup bit.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 11-Jul-88	MSD	Started coding.;;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit,CheckParent):code		import	proc_path1:code		import	(StartPacket,SendPacket):code		import	(PutWord,PutLong,PutByte):code		import	(PutIDs,PutPath):code		import	mydata:tdatacb_bitmap	equ	$0100			; attributes onlycb_attr		equ	$4000			; clear backup bitclear_backup	proc	export		with	dp,mydata		ProcName clear_backup				jsr	PreProcess		; validate parameters				jsr	proc_path1		; parse pathname		bcs	exit				lda	#afpSetFlDrParms	; ready to send FPSetFileDirParms		jsr	StartPacket		jsr	PutIDs			; put VolID and DirID in		lda	#cb_bitmap		; bitmap: attributes only		jsr	PutWord				sec				; alignment after path		jsr	PutPath			; put partial path in packet		lda	#cb_attr		; clear backup bit		jsr	PutWord		jsr	SendPacket		; shoot it out the door		jsr	CheckParent		; check for path not foundexit		jmp	main_exit		; return to caller		endwith		endp		end