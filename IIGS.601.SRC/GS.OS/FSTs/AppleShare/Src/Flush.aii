;------------------------------------------------------------; Flush;; This call takes a file reference number and writes any; unwritten data to the server.  It also sends an FPFlush; command to the server to force a write to disk.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 21-Jul-88	MSD	Started coding.; 18-Oct-88	MSD	FPFlush moved out of do_flush and;			into Flush call.; 27-Mar-90	MSD	Allow a second parameter in class 1;			flush (the "fast flush" flag).  It is;			a word, and only the high bit may be set.;;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit):code		import	(StartPacket,SendPacket):code		import	(StartWrite,SendWrite):code		import	(PutWord,PutLong):code		import	mydata:tdata		entry	do_flush:codeSPWrite		record	import		ds.w	1		; sync, call numberResult		ds.w	1		; result code		ds.l	1		; completion routineSRef		ds.b	1		; session reference #ComLen		ds.w	1		; command block lengthComAddr		ds.l	1		; command block addressWrtBufLen	ds.w	1		; amount to be writtenWrtAddr		ds.l	1		; address to write fromRepBufLen	ds.w	1		; reply buffer lengthRepAddr		ds.l	1		; reply buffer addressComRes		ds.l	1		; result (from server)WrtLen		ds.w	1		; actual amount writtenRepLen		ds.w	1		; actual reply length		endrp		record	0refnum		ds.w	1		; file refnumflags		ds.w	1		; $8000 = "fast flush"		endrflush		proc	export		with	dp,mydata		ProcName flush				jsr	PreProcess		; validate the call;###############;# This code added to allow the presence of the new "fast flush";# flag in the Flush call.  It is only checked for a valid value,;# but otherwise ignored.;#;# Note: If you set one of the reserved bits, you'll get an;# invalid parameter error, and no flush will happen.  Beware.;###############		lda	pcount			; (class 0 => pcount = 0)		cmp	#2			; new flag present?		blt	old_flush		; no, so do it the old way						; Here, pCount = 2		ldy	#p.flags		; offset to flags word		lda	[my_pb_ptr],y		; get flags		bit	#$7FFF			; any reserved bits set?		beq	old_flush		; no, so do it the old way				lda	#invalid_parm		; a reserved bit was set,		sec				; so return invalid parameter		bra	exit			; return the error;###############;# End of new code;###############old_flush				clc				; assume no error		ldy	#fcr.flags		lda	[my_fcr_ptr],y		; get flags		and	#buffer_dirty		; only dirty bit		beq	exit			; clean => exit no error		;------------------------------------------------------------; Cause a dirty buffer to be written to the server.;------------------------------------------------------------		jsr	do_flush		; do the real work		bcs	exit			; return any error we got;------------------------------------------------------------; Do an FPFlush to force the server to flush the file.;------------------------------------------------------------		lda	#afpForkFlush		; flush a file		jsr	StartPacket		ldy	#fcr.forkrefnum		lda	[my_fcr_ptr],y		; get file's AFP refnum		jsr	PutWord			; goes into packet		jsr	SendPacketexit		jmp	main_exit		; return from call		endwith				; with dp		endp;------------------------------------------------------------; do_flush;; This routine makes sure that any buffered data for a file; is written to the server.;; On entry:;	Full native mode.;	my_fcr_ptr = address of FCR for file to flush;; On exit:;	Full native mode.;;------------------------------------------------------------do_flush	proc	export		with	dp,mydata		ProcName do_flush		;------------------------------------------------------------; Do nothing if the FCR's dirty bit is clear.;------------------------------------------------------------		ldy	#fcr.flags		lda	[my_fcr_ptr],y		; get dirty bit, etc.		bit	#buffer_dirty		; is the file dirty?		beq	ok_exit			; not dirty, just exit		and	#Åbuffer_dirty		; clear buffer_dirty		sta	[my_fcr_ptr],y		; save cleared dirty bit;------------------------------------------------------------; Write out all of the data in the buffer.;------------------------------------------------------------		lda	#afpWrite		; write relative to start of fork		jsr	StartWrite		; start up a write packet				ldy	#fcr.forkrefnum		lda	[my_fcr_ptr],y		; get AFP OForkRefnum		jsr	PutWord			; into packet				ldy	#fcr.buf_start		lda	[my_fcr_ptr],y		; offset, low word		and	#$FE00			; (start of block)		xba				; high-low byte order		tax				; second word in X		iny		iny		lda	[my_fcr_ptr],y		; offset, high word		xba				; high-low byte order		jsr	PutLong			; put offset into packet		;------------------------------------------------------------; Now, figure out how much data goes in this transaction.;------------------------------------------------------------		ldy	#fcr.buf_size		lda	[my_fcr_ptr],y		; get valid buffer size		sta	SPWrite.WrtBufLen	; save as SPWrite data length		xba				; high-low order		tax				; low word in X		lda	#0			; high word is 0		jsr	PutLong			; put request count in packet;------------------------------------------------------------; Now, make write data buffer point to FCR's buffer;------------------------------------------------------------		clc		lda	my_fcr_ptr		; start with FCR		adc	#fcr.buffer		; plus offset to buffer		sta	SPWrite.WrtAddr		lda	my_fcr_ptr+2		; carry to high word		adc	#0		sta	SPWrite.WrtAddr+2;------------------------------------------------------------; Send the write packet out the door...;------------------------------------------------------------		jsr	SendWrite		bcs	exitok_exit		clc				; no error		lda	#0			; no error code (for Flush)exit		rts				; return to caller		endwith				; with dp		endp		end