;------------------------------------------------------------; Write;; This call will write bytes from a buffer to an open fork.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 29-Jul-88	MSD	Started coding.; 15-Aug-88	MSD	Changed definition of SPWrite; 25-Oct-88	MSD	Added buffering.;;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit):code		import	(StartWrite,SendWrite):code		import	(PutWord,PutLong):code		import	(update_vars,fill_buffer):code		import	(do_flush):code		import	mydata:tdata		entry	(write_buff,write_unbuff):code		entry	(to_server,to_buffer):codeSPWrite		record	import		ds.w	1		; sync, call numberResult		ds.w	1		; result code		ds.l	1		; completion routineSRef		ds.b	1		; session reference #ComLen		ds.w	1		; command block lengthComAddr		ds.l	1		; command block addressWrtBufLen	ds.w	1		; amount to be writtenWrtAddr		ds.l	1		; address to write fromRepBufLen	ds.w	1		; reply buffer lengthRepAddr		ds.l	1		; reply buffer addressComRes		ds.l	1		; result (from server)WrtLen		ds.w	1		; actual amount writtenRepLen		ds.w	1		; actual reply length		endr;------------------------------------------------------------; This is the structure of the parameter list for the; Write call (note: I ignore the cache_priority of the; class 1 call since I never cache blocks).;------------------------------------------------------------p		record	0		ds.w	1			; file refnumbuffer		ds.l	1			; address of user's data bufferreq_count	ds.l	1			; number of bytes requestedtrans_count	ds.l	1			; number of bytes actually transferred		endrwrite		proc	export		with	dp,mydata		ProcName write				jsr	PreProcess		; validate the call;------------------------------------------------------------; Initialize transfer count and mark in file since these are; updated when the call completes (error or not).;------------------------------------------------------------		stz	trans_count		; reset transfer count since		stz	trans_count+2		; nothing transfered yet		ldy	#fcr.mark		lda	[my_fcr_ptr],y		; get current mark in file		sta	cur_mark		; save for now		iny		iny		lda	[my_fcr_ptr],y		sta	cur_mark+2;------------------------------------------------------------; Check to see if we have write access to this file.;------------------------------------------------------------		ldy	#fcr.access		lda	[my_fcr_ptr],y		; get access from open		and	#$0002			; can we write to the file?		bne	@write			; if so, complete the call		sec				; got an error!		lda	#access_error		; don't have write access to file		brl	done			; return the error@write;------------------------------------------------------------; Initialize the rest of the local variables for write.;------------------------------------------------------------		ldy	#p.buffer		lda	[my_pb_ptr],y		; get buffer address low		sta	data_buffer		; save locally		iny		iny		lda	[my_pb_ptr],y		; buffer address high		sta	data_buffer+2				iny		iny				; Y = p.req_count		lda	[my_pb_ptr],y		sta	req_count		; copy request count		iny		iny		lda	[my_pb_ptr],y		sta	req_count+2		clc				; get ready for no error		ora	req_count		; anything to write?		beq	done			; no, so just exit		;------------------------------------------------------------; Do buffered or unbuffered write as specified in FCR.;------------------------------------------------------------		ldy	#fcr.flags		lda	[my_fcr_ptr],y		; get buffering flag (high bit)		bpl	no_buff				jsr	write_buff		; do a buffered write		bra	done			; return everythingno_buff		jsr	write_unbuff		; do an unbuffered write;------------------------------------------------------------; The write is done.  Update the FCR's current mark and the; actual transfer count in the user's parameter list.;------------------------------------------------------------done		php				; save error status		pha				; save error code		ldy	#p.trans_count		lda	trans_count		; return transfer count		sta	[my_pb_ptr],y		iny		iny		lda	trans_count+2		sta	[my_pb_ptr],y				ldy	#fcr.mark		lda	cur_mark		; update current mark		sta	[my_fcr_ptr],y		iny		iny		lda	cur_mark+2		sta	[my_fcr_ptr],y		pla				; restore error code		plp				; restore error status		jmp	main_exit		; return from call		endwith				; with dp		endp;------------------------------------------------------------; Write_Unbuff;; This routine writes directly from the user's data buffer; to the server.  It assumes that the main vars (cur_mark,; req_count, data_buffer) have been set up.;------------------------------------------------------------write_unbuff	proc		with	dp,mydata				ProcName write_unbuff		;------------------------------------------------------------; Copy main vars into local copies for to_server.;------------------------------------------------------------		lda	cur_mark		sta	this_mark		lda	cur_mark+2		sta	this_mark+2				lda	req_count		sta	this_req		lda	req_count+2		sta	this_req+2				lda	data_buffer		sta	this_buffer		lda	data_buffer+2		sta	this_buffer+2		;------------------------------------------------------------; Send the write to the server.;------------------------------------------------------------		jsr	to_server		pha;------------------------------------------------------------; Update cur_mark, data_buffer, req_count, trans_count.;------------------------------------------------------------		jsr	update_vars		pla		bne	error_exit		; return any errors;------------------------------------------------------------; See if there is more to write;------------------------------------------------------------		lda	req_count		ora	req_count+2		bne	write_unbuff;------------------------------------------------------------; Write worked just fine.  Return with no errors.;------------------------------------------------------------		clc		lda	#0		rts;------------------------------------------------------------; Write got an error.  Return it.;------------------------------------------------------------error_exit		sec		rts				endwith				; with dp		endp;------------------------------------------------------------; Write_Buff;; This routine handles writes that should be buffered.  It; assumes that the main vars (cur_mark, req_count, etc.); have been set up.;------------------------------------------------------------write_buff	proc		with	dp,mydata				ProcName write_buff		;------------------------------------------------------------; If write is <= $200 bytes, then do write a block at a time; through a block buffer.  Otherwise, do the write in one; fell swoop with write_unbuff.;------------------------------------------------------------		lda	req_count+2		; more than a bank?		bne	long		lda	req_count		cmp	#$200			; more than a block?		blt	shortlong		jsr	do_flush		; flush unwritten data		bcs	exit				ldy	#fcr.flags		lda	[my_fcr_ptr],y		and	#Åbuffer_valid		; buffered data no longer valid		sta	[my_fcr_ptr],y				bra	write_unbuff		; do unbuffered write		short		jsr	fill_buffer		; make sure buffer is full of data		bcs	exit				jsr	to_buffer		; try putting some data in buffer				lda	req_count		ora	req_count+2		; more to read?		bne	short			; if so, go to next block		clc				; all done, no errorsexit		rts		endwith				; with dp		endp;------------------------------------------------------------; To_Buffer;; This routine writes from the user's data buffer into the; FCR's buffer.  Note: the amount of valid data in the; buffer may grow.;; On entry:;	data_buffer	= address to write from;	cur_mark	= mark in file to write to;	req_count	= amount to try to write;	trans_count	= amount transfered so far;; On exit:;	data_buffer	= next address to write from;	cur_mark	= next mark in file to write to;	req_count	= amount left to try to write;	trans_count	= amount transfered so far;;	(no errors possible);------------------------------------------------------------to_buffer	proc		with	dp,mydata		ProcName to_buffer				lda	cur_mark		and	#$1FF				; get offset in block		sta	this_mark		clc		adc	#fcr.buffer			; offset in FCR		clc		adc	my_fcr_ptr			; address in FCR		sta	dest_ptr		lda	my_fcr_ptr+2		adc	#0		sta	dest_ptr+2				sec		lda	#$200				; maximum buffer size		sbc	this_mark			; get # bytes left in buffer		sta	this_req;------------------------------------------------------------; If request was less than room left in buffer, cut down; the write size.;------------------------------------------------------------		lda	req_count+2			; want a whole bank?		bne	more		lda	req_count		cmp	this_req			; more than room left?		bge	more				; yep, so only do room left		sta	this_req			; doesn't fill up buffermore;------------------------------------------------------------; See if this write grows the buffer.;------------------------------------------------------------		clc		lda	this_mark		adc	this_req			; got new mark		ldy	#fcr.buf_size		cmp	[my_fcr_ptr],y			; more than old size?		blt	copy				; no, so skip update		sta	[my_fcr_ptr],y			; update buffer size;------------------------------------------------------------; Now copy this_req bytes from (data_buffer) to (dest_ptr).;------------------------------------------------------------copy		sep	#$20				; short A for chars		longa	off		ldy	#0				; start with first char		ldx	this_req			; get byte count@loop		lda	[data_buffer],y		sta	[dest_ptr],y			; write a byte		iny		dex					; more bytes to go?		bne	@loop				rep	#$20				; back to full native		longa	on				ldy	#fcr.flags		lda	[my_fcr_ptr],y		ora	#buffer_dirty			; we have unwritten data		sta	[my_fcr_ptr],y		;------------------------------------------------------------; Update the main vars.;------------------------------------------------------------		lda	this_req		sta	this_trans		stz	this_trans+2			; always <64K!		jsr	update_vars				rts		endwith					; with dp		endp;------------------------------------------------------------; To_Server;; This routine does the unbuffered writing directly to; the server from the user's data buffer.;; On entry:;	this_buffer	= address to write from;	this_mark	= mark in file to write to;	this_req	= amount to try to write;; On exit:;	c = 1 if error (A = error code);;	this_trans	= amount written;;------------------------------------------------------------to_server	proc		with	dp,mydata		ProcName to_server				lda	#afpWrite		; write relative to start of fork		jsr	StartWrite		; start up a write packet				ldy	#fcr.forkrefnum		lda	[my_fcr_ptr],y		; get AFP OForkRefnum		jsr	PutWord			; into packet				lda	this_mark		; offset, low word		xba				; high-low byte order		tax				; second word in X		lda	this_mark+2		; offset, high word		xba				; high-low byte order		jsr	PutLong			; put offset into packet		;------------------------------------------------------------; Now, figure out how much data goes in this transaction.;------------------------------------------------------------		lda	this_req+2		; more than 64K?		bne	write_max		; if so, write maximum		lda	this_req		; get requested amount		cmp	#MaxSPData		; can ASP handle it all?		bge	write_max		; maybe not, do max ASP size		bra	got_write_size		; here, asking for less than maxwrite_max		lda	#MaxSPData		; ask for maximum ASP data sizegot_write_size		sta	SPWrite.WrtBufLen	; save as SPWrite data length				lda	this_req		xba				; high-low order		tax				; low word in X		lda	this_req+2		; high word		xba		jsr	PutLong			; put request count in packet;------------------------------------------------------------; Now, make write data buffer point to user's data buffer;------------------------------------------------------------		lda	this_buffer		sta	SPWrite.WrtAddr		lda	this_buffer+2		sta	SPWrite.WrtAddr+2;------------------------------------------------------------; Send the write packet out the door...;------------------------------------------------------------		jsr	SendWrite;------------------------------------------------------------; Update current transfer count, request count, current mark,; and data buffer address;------------------------------------------------------------		ldx	SPWrite.WrtLen		; get actual transfer amount		stx	this_trans		stz	this_trans+2				bcs	return			; return any errordone		clc				; no error		lda	#0return		rts		endwith				; with dp		endp		end