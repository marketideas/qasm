;------------------------------------------------------------;; Destroy;; This call takes a pathname and removes that file.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 11-Jul-88	MSD	Started coding.  Only parses pathname.; 12-Jul-88	MSD	It works (32 byte directory names;			seem to return a parameter error).;  1-Sep-88	MSD	Destroy of volume only should return;			an access error.;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit,CheckParent):code		import	proc_path1:code		import	(StartPacket,SendPacket):code		import	(PutWord,PutLong,PutByte):code		import	(PutIDs,PutPath):code		import	mydata:tdatadestroy		proc	export		with	dp,mydata		ProcName destroy				jsr	PreProcess		; validate parameters				jsr	proc_path1		; parse pathname		bcs	exit;------------------------------------------------------------; Return access error if they try to destroy a volume.;------------------------------------------------------------		lda	volume_sep		; volume only given?		bne	not_volume		; if not, continue		sec		lda	#access_error		; volume only is invalid		bcs	exitnot_volume		lda	#afpDelete		; ready to send FPDelete		jsr	StartPacket		jsr	PutIDs			; put VolID and DirID in				clc				; no alignment after path		jsr	PutPath			; put partial path in packet				jsr	SendPacket		; shoot it out the door		jsr	CheckParent		; check for path not foundexit		jmp	main_exit		; return to caller		endwith				; with dp,mydata		endp		end