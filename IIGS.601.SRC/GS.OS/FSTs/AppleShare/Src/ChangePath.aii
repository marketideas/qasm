;------------------------------------------------------------;; Change_path;; This call will move and/or rename a file or directory.; Volume renames are not allowed, and a directory may not; be moved into one of its descendants (AFP will flag that).;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 15-Jul-88	MSD	Started coding.;  5-Dec-91	MSD	Now checks the unused bits in the flags;			word (third parameter).;; Known bug: If the source file exists and the parent of the; destination does not, then you will get a file not found; error instead of a path not found error.  Can be fixed by; trying to find the parent of destination as well.;;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit,CheckParent):code		import	(proc_path1,proc_path2):code		import	(StartPacket,SendPacket):code		import	(PutWord,PutLong,PutByte):code		import	(PutPath,PutIDs,PutPString):code		import	PutPartPath:code		import	(StartReply,GetWord,GetLong):code		import	(GetPlace,GetPString):code		import	mydata:tdatap		record	0		; class 1 parameter blocksource_path	ds.l	1dest_path	ds.l	1flags		ds.w	1		; $8000 = assume source is duplicate volume		endr				change_path	proc	export		with	dp,mydata		ProcName change_path		jsr	PreProcess		; validate parameters;------------------------------------------------------------; If the pcount was 3, make sure the flags word doesn't have; the extra bits set (only bit 15 is defined).	(5-Dec-91 MSD);------------------------------------------------------------		lda	pcount		cmp	#3			; did they supply flags?		blt	no_flags				ldy	#p.flags		lda	[my_pb_ptr],y		; get the flags		bit	#$7FFF			; any reserved bits set?		beq	no_flags		; no, so it's OK				lda	#invalid_parm		sec		brl	exitno_flags;------------------------------------------------------------; Process the source path.  Volume only gets access denied.;------------------------------------------------------------		jsr	proc_path1		; parse source pathname		bcs	go_exit_1				lda	volume_sep		; root only?		bne	@ok		brl	no_access		; can't do it to root@ok		lda	#afpMove		; move and rename		sta	my_call_num		; save as call to issue				lda	#$FFFF			; volume must match		sta	same_vol_flag		;------------------------------------------------------------; Common processing code for two pathname calls.;------------------------------------------------------------		export	two_file_calltwo_file_call;------------------------------------------------------------; See if source object actually exists.  If it does, save; its parent DirID and the child name.;------------------------------------------------------------		lda	#afpGetFlDrParms		jsr	StartPacket				jsr	PutIDs				lda	#$4200			; files: long name, parent DirID		ldx	#$4200			; dirs: long name, parent DirID		jsr	PutLong			; put bitmaps in				jsr	PutPath				jsr	SendPacket		jsr	CheckParent		bcs	go_exit_1				jsr	StartReply		jsr	GetLong			; ignore bitmaps		jsr	GetWord			; ignore object flag		jsr	GetPlace		; mark start of parms				jsr	GetLong			; get parent DirID		sta	src_dirid		stx	src_dirid+2				ldx	#<src_name		ldy	#^src_name		jsr	GetPString		; get source child name				lda	SessRefnum		; remember source session and		sta	src_srefnum		lda	VolID			; VolID for later compare for		sta	src_volid		; same volume		;------------------------------------------------------------; Process the destination path;------------------------------------------------------------		jsr	proc_path2		; parse destination pathnamego_exit_1		bcc	@ok		brl	exit@ok		lda	volume_sep		; volume only?		beq	go_bad_path		; not valid as destination file		;------------------------------------------------------------; Make sure the two volumes are on the same server (and; same volume if needed);------------------------------------------------------------		lda	SessRefnum		cmp	src_srefnum		bne	go_bad_path		; not same, can't do it		lda	same_vol_flag		; need to be on same volume?		bpl	ok_vol			; no, so don't check		lda	VolID		cmp	src_volid		; same volume?		beq	ok_vol			; yes, so continuego_bad_path	brl	bad_path		; no, can't do itok_vol;------------------------------------------------------------; Find the parent of the destination (get its DirID).  If it; does not exist or is not a directory, return path_not_found.; Leave destination child as the partial path (my_path_len; and my_path_ptr set).;------------------------------------------------------------		ldy	my_path_len		sep	#$20			; 8 bit A for chars		longa	off@loop		dey		beq	child_only		; only a child name!		lda	[my_path_ptr],y		; get char		cmp	#':'			; is it a separator?		bne	@loop			; no, so check next char		rep	#$20			; back to full native		longa	on		sty	partial_len		; save partial path length				lda	#afpGetFlDrParms	; do a GetFileDirParms		jsr	StartPacket				jsr	PutIDs			; copy VolID, DirID in				lda	#$0000			; files: get nothing		ldx	#$0001			; folders: get DirID		jsr	PutLong				jsr	PutPartPath		; put partial path in packet				jsr	SendPacket		bcc	@ok		brl	err_parent		; convert file not found error@ok		jsr	StartReply		; begin processing result		jsr	GetLong			; ignore bitmaps		jsr	GetWord			; get file/dir flag		and	#$0080			; is dir bit set?		bne	@ok2		brl	no_parent		; wasn't a directory!@ok2		jsr	GetLong			; get DirID		sta	DirID			; save current DirID		stx	DirID+2				sec				; (add 1 for trailing separator)		lda	my_path_ptr		; bump path pointer past parent		adc	partial_len		sta	my_path_ptr		lda	my_path_ptr+2		adc	#0		sta	my_path_ptr+2				clc				; (minus 1 for separator)		lda	my_path_len		; path length becomes		sbc	partial_len		; child only		sta	my_path_lenchild_only		rep	#$20			; in case we branched from loop		lda	my_path_len		sta	partial_len		; partial path is child only		;------------------------------------------------------------; If this is a Move, and the source and destination parents; are the same, do a Rename instead (so that a file can; be renamed to itself, useful for changing capitalization).;------------------------------------------------------------		lda	my_call_num		cmp	#afpMove		; was it originally a Move?		bne	not_rename		; no, so can't be a rename				lda	src_dirid		cmp	DirID			; do DirIDs match?		bne	not_rename		; no, so really is a move		lda	src_dirid+2		cmp	DirID+2		bne	not_rename		bra	is_rename		; it really is a rename!not_rename		;------------------------------------------------------------; Build up the Move/CopyFile command packet;------------------------------------------------------------		lda	my_call_num		; get AFP command number		jsr	StartPacket				lda	src_volid		jsr	PutWord				lda	src_dirid		ldx	src_dirid+2		jsr	PutLong				lda	same_vol_flag		; is a different dest vol ok?		bmi	no_dest_vol		; no, so don't put one in		lda	VolID		jsr	PutWordno_dest_vol		lda	DirID			; parent of destination		ldx	DirID+2		jsr	PutLong				lda	#afp_long		jsr	PutByte		ldx	#<src_name		; source child name		ldy	#^src_name		jsr	PutPString				lda	#afp_long		; path type and null string		jsr	PutWord			; for dest parent path				jsr	PutPartPath		; put destination child in				jsr	SendPacket		; try to do the callexit		jmp	main_exit		; return to callererr_parent		cmp	#file_not_found		; parent not found?		bne	err_exitno_parent		lda	#path_not_found		; yes, then path not founderr_exit		sec		bcs	exit		bad_path		sec		lda	#invalid_path		; invalid paths for rename		bcs	exitno_access		sec		lda	#access_error		; can't rename root		bcs	exitis_rename		lda	#afpRename		; build an FPRename call		jsr	StartPacket				jsr	PutIDs				lda	#afp_long		jsr	PutByte		ldx	#<src_name		; source child name		ldy	#^src_name		jsr	PutPString				jsr	PutPartPath		; put destination child in				jsr	SendPacket		; try to do the call		bra	exit			; return from call				endwith				; with dp,mydata		endp				end