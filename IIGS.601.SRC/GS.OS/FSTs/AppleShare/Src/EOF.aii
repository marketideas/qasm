;------------------------------------------------------------; File: eof.aii;; This file contains the code for the Set_EOF and Get_EOF; calls.  It also contains the code for the get_disp routine; which converts a base/displacement to an absolute offset; for class 1 Set_Mark and Set_EOF.;;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit):code		import	(StartPacket,SendPacket):code		import	PutWord:code		import	(StartReply,GetWord):code		import	do_flush:code		import	mydata:tdata				entry	(get_the_eof,get_disp):code;------------------------------------------------------------; Structure of parameter lists;------------------------------------------------------------p		record	0		ds.w	1		; file reference numberposition	ds.l	1		; EOF for Get_EOF and Set_EOF(0)		org	positionbase		ds.w	1		; base for Set_EOF(1)disp		ds.l	1		; displacement for Set_EOF(1)		endr;------------------------------------------------------------; Get_EOF;; This call takes a file reference number and returns the; current end of file (EOF).  This value is obtained directly; from the server, and not the workstation's idea of the EOF.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 25-Jul-88	MSD	Started coding.;;------------------------------------------------------------get_eof		proc	export		with	dp		ProcName get_eof				jsr	PreProcess		; validate the call		jsr	do_flush		; write data, update EOF		bcs	exit		jsr	get_the_eof		; do the real work		bcs	exit			; return any error		ldy	#p.position+2		sta	[my_pb_ptr],y		; return high word		txa				; get low word		dey		dey		sta	[my_pb_ptr],y		; return low word		clc				; no errors		lda	#0exit		jmp	main_exit		; done with call		endwith				; with dp		endp;------------------------------------------------------------; Set_EOF;; This call takes a file reference number and an end of file.; The fork's length is set to the given EOF.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 25-Jul-88	MSD	Started coding.;  8-Sep-88	MSD	Don't allow an EOF < mark.; 16-Sep-88	MSD	Return any errors from get_disp.; 13-Feb-89	MSD	It is legal to set the mark less than;			the current EOF.  In this case, the;			mark is also set to the new EOF.;;------------------------------------------------------------set_eof		proc	export		with	dp,mydata		ProcName set_eof				jsr	PreProcess		; validate the call		jsr	do_flush		; write data, update EOF		bcs	exit		jsr	get_disp		; base/displacement => mark		bcs	exit			; return any errors		sta	math_temp+2		; save EOF for packet		stx	math_temp		jsr	do_flush		; make sure unwritten data goes out		bcs	exit		ldy	#fcr.mark		; compare against low word first		lda	math_temp		; get low word first		cmp	[my_fcr_ptr],y		; fake a subtract		iny		iny		lda	math_temp+2		; now compare high word		sbc	[my_fcr_ptr],y		bge	ok_mark			; continue if mark <= EOF		lda	math_temp+2		sta	[my_fcr_ptr],y		; update mark (high)		dey		dey		lda	math_temp		sta	[my_fcr_ptr],y		; update mark (low)ok_mark		ldy	#fcr.flags		lda	[my_fcr_ptr],y		and	#Åbuffer_valid		; don't use buffered data anymore		sta	[my_fcr_ptr],y		lda	#afpSetForkParms		jsr	StartPacket		; start up the packet		ldy	#fcr.forkrefnum		lda	[my_fcr_ptr],y		; get AFP's refnum for file		jsr	PutWord				lda	my_fork_bitmap		; tell which fork this is for		jsr	PutWord				lda	math_temp+2		; get high word		xba				; high-low byte order		jsr	PutWord			; put high word in packet		lda	math_temp		; get low word		xba				; high-low byte order		jsr	PutWord			; put low word in packet		jsr	SendPacketexit		jmp	main_exit		; return any errorsdo_bad_pos		sec		lda	#bad_pos		; position out of range		bcs	exit			; return the error		endwith				; with dp		endp;------------------------------------------------------------; Get_The_EOF;; This routine does the real work of finding an open file's; current EOF.;; On entry:;	Full native mode.;	(assumes PreProcess has been called to set up FCR);; On exit:;	Full native mode.;	X = EOF (low word);	A = EOF (high word);	c = 1 => error (A = error code);; Modification history:; 25-Jul-88	MSD	Started coding.;;------------------------------------------------------------get_the_eof	proc	export		with	dp,mydata		ProcName get_the_eof				lda	#afpGetForkParms		jsr	StartPacket		; start up the packet		ldy	#fcr.forkrefnum		lda	[my_fcr_ptr],y		; get AFP's refnum for file		jsr	PutWord				lda	my_fork_bitmap		; tell which fork this is for		jsr	PutWord		jsr	SendPacket		; send it off		bcs	exit			; return any error		jsr	StartReply		; prepare to process reply packet		jsr	GetWord			; ignore bitmap returned				jsr	GetWord			; get EOF high word		xba				; low-high byte order		pha				; save for later		jsr	GetWord			; get EOF low word		xba				; low-high byte order		sta	cur_eof			; save EOF on direct page		tax				; returned in X		pla				; high word returned in A		sta	cur_eof+2		; save high word of EOF		clc				; no errorsexit		rts				; return any errors to caller		endwith				; with dp		endp;------------------------------------------------------------; Get_Disp;; This routine takes a base/displacement pair and turns it; into an absolute offset into the file for use by class 1; Set_EOF and Set_Mark calls.  It is included in this file; because it may need to determine the EOF from the server; if the base is $0001 (EOF-displacement).;; On entry:;	Full native mode.;; On exit:;	Full native mode.;	X = offset (low word);	A = offset (high word);	c = 1 => error (A = error code);; Modification history:; 25-Jul-88	MSD	Started coding.;  8-Sep-88	MSD	Now includes class 0 positions.  The;			EOF is always determined and saved in;			the FCR.; 16-Sep-88	MSD	Check for underflow or overflow on all;			relative displacement modes.;;------------------------------------------------------------get_disp	proc	export		with	dp,mydata		ProcName get_disp		;------------------------------------------------------------; Get the file's current EOF and save it off.;------------------------------------------------------------		jsr	get_the_eof		; find file's EOF		bcc	got_eof		brl	exit			; return any errorgot_eof;------------------------------------------------------------; If class 0, new position is given in p.position field.; If class 1, we need to calculate the base/displacement.;------------------------------------------------------------		lda	class			; class 0?		bne	class1		ldy	#p.position		lda	[my_pb_ptr],y		; get low word of position		tax				; save in X		iny		iny		lda	[my_pb_ptr],y		; get high word		bra	return_disp		; go return itclass1		ldy	#p.base		lda	[my_pb_ptr],y		; get base field		bne	not_base_0		; is it base=0?		ldy	#p.disp			; base = 0 =>		lda	[my_pb_ptr],y		; offset := displacement		tax		iny		iny		lda	[my_pb_ptr],y		bra	return_disp		; return A,Xnot_base_0		dea				; is it base=1?		bne	not_base_1;------------------------------------------------------------; Base = 1.  Offset := EOF - displacement.  This requires; a network call to get the actual EOF.;------------------------------------------------------------		ldy	#p.disp			; point to displacement field		sec				; prepare to subtract		lda	cur_eof			; get low word		sbc	[my_pb_ptr],y		; subtract displacement		tax				; save low word		lda	cur_eof+2		; get high word		iny		iny				; point to disp (high word)		sbc	[my_pb_ptr],y		bcc	do_bad_pos		; borrow => error		bcs	return_dispnot_base_1		dea				; base=2?		bne	not_base_2;------------------------------------------------------------; Base = 2.  Offset := Mark + displacement.;------------------------------------------------------------		ldy	#fcr.mark		lda	[my_fcr_ptr],y		; copy mark to math_temp		sta	math_temp		iny		iny		lda	[my_fcr_ptr],y		sta	math_temp+2				ldy	#p.disp		clc		lda	[my_pb_ptr],y		; get displacement		adc	math_temp		; plus mark		tax				; save low word		iny		iny		lda	[my_pb_ptr],y		adc	math_temp+2		; add high word		bcs	do_bad_pos		; error if overflow		bra	return_disp		; return OK		not_base_2		dea				; base=3?		bne	invalid_base		; >3 is not valid!;------------------------------------------------------------; Base = 3.  Offset := Mark - displacement.;------------------------------------------------------------		ldy	#fcr.mark		lda	[my_fcr_ptr],y		; copy mark to math_temp		sta	math_temp		iny		iny		lda	[my_fcr_ptr],y		sta	math_temp+2				ldy	#p.disp		sec				; base=3 => mark-displacement		lda	math_temp		;   mark		sbc	[my_pb_ptr],y		;   - displacement		tax				; save low word		iny		iny		lda	math_temp+2		sbc	[my_pb_ptr],y		bcc	do_bad_pos		; error if underflow (borrow)return_disp		clc				; no error hereexit		rtsinvalid_base		lda	#invalid_parm		; base is invalid parameter		sec		bcs	exitdo_bad_pos		lda	#bad_pos		; position out of range		sec		bcs	exit		endwith				; with dp		endp		end