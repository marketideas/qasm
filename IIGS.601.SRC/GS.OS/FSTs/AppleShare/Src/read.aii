;------------------------------------------------------------; Read;; This call will read bytes from an open fork to a buffer.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 28-Jul-88	MSD	Started coding.; 15-Aug-88	MSD	Changed definition of SPCommand; 14-Oct-88	MSD	Reorganized from_server routine.;			Adding support for buffered reads.;			Added check for request_count = 0.;;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit):code		import	(StartPacket,SendPacket):code		import	(PutWord,PutLong):code		import	(do_flush):code		import	SPCommand:tSPCommand		import	mydata:tdata				entry	(from_server,from_buffer):code		entry	(read_buffered,read_unbuffered):code;------------------------------------------------------------; This is the structure of the parameter list for the; Read call (note: I ignore the cache_priority of the; class 1 call since I never cache blocks).;------------------------------------------------------------p		record	0		ds.w	1			; file refnumbuffer		ds.l	1			; address of user's data bufferreq_count	ds.l	1			; number of bytes requestedtrans_count	ds.l	1			; number of bytes actually transferred		endrread		proc	export		with	dp,mydata		ProcName read				jsr	PreProcess		; validate the call;------------------------------------------------------------; Initialize transfer count and file mark since these will; be updated when the call completes (error or not).;------------------------------------------------------------		stz	trans_count		; reset transfer count since		stz	trans_count+2		; nothing transfered yet		ldy	#fcr.mark		lda	[my_fcr_ptr],y		; get current mark in file		sta	cur_mark		; save for now		iny		iny		lda	[my_fcr_ptr],y		sta	cur_mark+2;------------------------------------------------------------; Check to see if we have read access to this file.;------------------------------------------------------------		ldy	#fcr.access		lda	[my_fcr_ptr],y		and	#$0001			; is read bit set?		bne	@read			; if so, continue the call		lda	#access_error		; file wasn't opened for read		brl	done			; return the error@read;------------------------------------------------------------; We can read, so set up the rest of the local variables.;------------------------------------------------------------		ldy	#p.buffer		lda	[my_pb_ptr],y		; get buffer address low		sta	data_buffer		; save locally		iny		iny		lda	[my_pb_ptr],y		; buffer address high		sta	data_buffer+2				iny		iny				; Y = p.req_count		lda	[my_pb_ptr],y		sta	req_count		; copy request count		iny		iny		lda	[my_pb_ptr],y		sta	req_count+2		ora	req_count		; anything requested?		beq	done			; if not, exit with no error		stz	newline_mask		; assume no newline mode		stz	newline_word		; no newline mode				ldy	#fcr.newline_len	; Y = fcr.newline_len		lda	[my_fcr_ptr],y		; get newline list length		sta	newline_len		; save for later		beq	got_nl_info		; if no newline, skip this		ldy	#fcr.newline		lda	[my_fcr_ptr],y		; get VP to newline list		tax				; low word in X		iny		iny		lda	[my_fcr_ptr],y		tay				; high word in Y		jsl	deref			; turn VP into pointer		stx	newline_ptr		sty	newline_ptr+2				ldx	newline_len		; get newline len		ldy	#fcr.mask		lda	[my_fcr_ptr],y		; get newline mask		sta	newline_mask		dex				; was newline_len = 1?		bne	got_nl_info		; if not, don't use server newline		lda	[newline_ptr]		; get newline char		and	#$00FF			; just 1 char, please		xba				; char to high byte		ora	newline_mask		; mask in low byte		sta	newline_word		; and save for AFP's usegot_nl_info;------------------------------------------------------------; Check for buffering.  Then do the right kind of read.;------------------------------------------------------------		ldy	#fcr.flags		lda	[my_fcr_ptr],y		; get buffering flag (high bit)		bpl	no_buff				jsr	read_buffered		; do a buffered read		bra	done			; return everythingno_buff		jsr	read_unbuffered		; do an unbuffered readdone		pha				; save error code		ldy	#p.trans_count		lda	trans_count		; return transfer count		sta	[my_pb_ptr],y		iny		iny		lda	trans_count+2		sta	[my_pb_ptr],y				ldy	#fcr.mark		lda	cur_mark		; update current mark		sta	[my_fcr_ptr],y		iny		iny		lda	cur_mark+2		sta	[my_fcr_ptr],y		pla				; restore error code		beq	no_error		; return if no error		cmp	#eof_error		; was it an EOF error?		bne	yes_error		; if so, return as error;------------------------------------------------------------; Don't return an EOF error if the transfer count is <>0.;------------------------------------------------------------		lda	trans_count		ora	trans_count+1		; trans_count=0?		bne	no_error		; no, so no error		lda	#eof_error		; trans_count=0 => EOF erroryes_error		sec				; yes, it was an error		bcs	exitno_error		clc				; no error		lda	#0			; force no error resultexit				jmp	main_exit		; return from call		endwith				; with dp		endp;------------------------------------------------------------; Update_Vars;; This routine adjusts the values of cur_mark, data_buffer,; req_count, trans_count by the amount of data transfered; (in this_trans).;;------------------------------------------------------------update_vars	proc	export		with	dp,mydata		ProcName update_vars				clc		lda	cur_mark		adc	this_trans		sta	cur_mark		lda	cur_mark+2		adc	this_trans+2		sta	cur_mark+2				clc		lda	data_buffer		adc	this_trans		sta	data_buffer		lda	data_buffer+2		adc	this_trans+2		sta	data_buffer+2				clc		lda	trans_count		adc	this_trans		sta	trans_count		lda	trans_count+2		adc	this_trans+2		sta	trans_count+2				sec		lda	req_count		sbc	this_trans		sta	req_count		lda	req_count+2		sbc	this_trans+2		sta	req_count+2		rts				endwith				; with dp		endp;------------------------------------------------------------; From_Server;; This routine does a read directly from the server to a; buffer somewhere in memory.  The newline_word is used in; case one newline char is used (no check for multiple newline; chars).;; On entry:;	A		= newline word;	this_buffer	= address to read into;	this_mark	= mark in file to read from;	this_req	= amount to try to read;; On exit:;	c = 1 if error (A = error code);;	this_trans	= amount transfered this request;;------------------------------------------------------------from_server	proc		with	dp,mydata		ProcName from_server		;------------------------------------------------------------; Start FPRead packet to server;------------------------------------------------------------		pha				; save newline word		lda	#afpRead		jsr	StartPacket		ldy	#fcr.forkrefnum		lda	[my_fcr_ptr],y		; get AFP OForkRefnum		jsr	PutWord		lda	this_mark		; get mark, low word		xba				; high-low order		tax				; low word in X		lda	this_mark+2		; get mark, high word		xba				; high-low order		jsr	PutLong			; put offset into packet;------------------------------------------------------------; The request amount in the packet will be the actual amount; requested so that the server can try to optimize.;------------------------------------------------------------		lda	this_req		; get low word		xba				; in 68000 order		tax				; low word in X		lda	this_req+2		; get high word		xba				; in 68000 order		jsr	PutLong			; put request count in packet		pla				; get newline mask & char if any		jsr	PutWord;------------------------------------------------------------; Adjust reply buffer to point directly at this buffer;------------------------------------------------------------		lda	this_buffer		sta	SPCommand.RepAddr	; update reply address		lda	this_buffer+2		sta	SPCommand.RepAddr+2	; and high word		lda	#MaxSPData		; allow maximum reply		sta	SPCommand.RepBufLen	; buffer length (won't						; overflow request);------------------------------------------------------------; Make the read call;------------------------------------------------------------		jsr	SendPacket		; off it goes;------------------------------------------------------------; Save off the actual transfer count;------------------------------------------------------------		ldx	SPCommand.RepLen	; get actual transfer amount		stx	this_trans		; return as transfer count		stz	this_trans+2		rts				; return with error in c/A		endwith				; with dp		endp;------------------------------------------------------------; From_Buffer;; This routine reads bytes from the FCR buffer to another; buffer.  It handles newline character checking.  Hitting a; newline character returns an EOF error.;; On entry:;	req_count	= amount to try to read;	data_buffer	= address to read into;	cur_mark	= mark in file to read from;	trans_count	= amount already transfered;; On exit:;	c = 1 if error (A = error code);		EOF is returned if the end of a partially;		filled buffer or a newline character is;		encountered.;;	req_count	= amount left to read;	data_buffer	= next address to read into;	cur_mark	= next mark in file to read from;	trans_count	= amount transfered to this point;;------------------------------------------------------------from_buffer	proc		with	dp,mydata		ProcName from_buffer				lda	cur_mark		and	#$1FF				; get offset in block		sta	this_mark		clc		adc	#fcr.buffer			; offset in FCR		clc		adc	my_fcr_ptr			; address in FCR		sta	src_ptr		lda	my_fcr_ptr+2		adc	#0		sta	src_ptr+2				ldy	#fcr.buf_size		lda	[my_fcr_ptr],y			; get size of buffer		sta	math_temp			; temporarily save buffer size		sec		sbc	this_mark			; get # bytes left in buffer		sta	this_req		;------------------------------------------------------------; Now determine whether we should return an EOF error.  If; they requested more than we have and the block is not a; full $200 bytes, then we return EOF error.;------------------------------------------------------------		stz	my_error			; assume no error				lda	req_count+2			; want more than a bank?		bne	more		lda	req_count		cmp	this_req			; want as much as we have?		bge	more				; yes, so give 'em what we have.less		sta	this_req		bra	startmore		lda	math_temp			; how big was the buffer?		cmp	#$200				; a full block?		beq	start				; yep, so do the read		lda	#eof_error			; we will run into EOF!		sta	my_errorstart		stz	this_trans			; start with nothing transfered		stz	this_trans+2		lda	this_req			; do they get nothing?		beq	done				; if so, go home				lda	newline_len			; how many newline chars?		beq	speedy				; none -- it be fast!				dea					; minus 1 as index to list		beq	single				; only one char -- not badslug		sep	#$20		longa	off@loop		ldy	this_trans			; index to source, data buffer		inc	this_trans			; we will transfer this byte		lda	[src_ptr],y			; copy a byte		sta	[data_buffer],y		and	newline_mask			; apply mask byte		ldy	newline_len@newline_loop		dey					; as index to list		cmp	[newline_ptr],y			; was it a newline char?		beq	@was_newline		cpy	#0				; checked 'em all?		bne	@newline_loop		dec	this_req			; more to read?		bne	@loop		beq	@done@was_newline		lda	#eof_error			; newline is like EOF		sta	my_error@done		rep	#$20				; back to full native		longa	on		bra	donesingle		lda	[newline_ptr]			; get newline char		sta	math_temp			; save for compares				sep	#$20				; short A for chars		longa	off				ldy	#0				; start with first byte@loop		lda	[src_ptr],y			; get first byte		sta	[data_buffer],y		iny		and	newline_mask		cmp	math_temp			; is it the newline char?		beq	@end		cpy	this_req			; transfered all the bytes?		bne	@loop		beq	@done@end		lda	#eof_error			; newline is like EOF		sta	my_error@done		rep	#$20				; back to full native		longa	on		sty	this_trans			; update amount transfered		bra	done				; finish upspeedy		sep	#$20		longa	off		ldy	#0				; start with first char		ldx	this_req			; get count		stx	this_trans			; save as amount transfered@loop		lda	[src_ptr],y		sta	[data_buffer],y		iny		dex		bne	@loop				rep	#$20		longa	ondone		jsr	update_vars			; update all the pointers, etc.				lda	my_error		cmp	#1				; set carry if error		rts		endwith					; with dp		endp;------------------------------------------------------------; Fill_Buffer;; This routine makes sure that the FCR's buffer has data; corresponding to the current mark (cur_mark) in the file.; If the buffer contains unwritten data from another block,; it will be written before the new block is read in.;;------------------------------------------------------------fill_buffer	proc	export		with	dp,mydata				ProcName fill_buffer				lda	cur_mark		and	#$FE00			; get mark of start of block		sta	this_mark		iny		iny		lda	cur_mark+2		sta	this_mark+2				ldy	#fcr.flags		lda	[my_fcr_ptr],y		and	#buffer_valid		; is the buffer data valid?		beq	fill_it			; if not, fill the buffer				ldy	#fcr.buf_start		lda	[my_fcr_ptr],y		cmp	this_mark		; already have the right block?		bne	fill_it		iny		iny		lda	[my_fcr_ptr],y		cmp	this_mark+2		bne	fill_it				clc				; buffer was already filled!		lda	#0		rtsfill_it		jsr	do_flush		; flush any unwritten data		bcs	exit		ldy	#fcr.buf_start		lda	this_mark		sta	[my_fcr_ptr],y		; update buffer's starting mark		iny		iny		lda	this_mark+2		sta	[my_fcr_ptr],y				ldy	#fcr.flags		lda	[my_fcr_ptr],y		and	#Åbuffer_valid		; for now, buffer is invalid		sta	[my_fcr_ptr],y				clc		lda	my_fcr_ptr		adc	#fcr.buffer		; set up address of FCR's buffer		sta	this_buffer		lda	my_fcr_ptr+2		adc	#0		sta	this_buffer+2				lda	#$200			; want a block		sta	this_req		stz	this_req+2				lda	#0			; don't use newline stuff		jsr	from_server		; go get the data		bcc	set_size		; no error, we have full buffer		cmp	#eof_error		; EOF error is not bad		beq	set_size		; EOF implies partially full buffer		cmp	#access_error		; no access is also OK (kind of)		beq	set_size		; access error implies empty buffererror_exit		secexit		rtsset_size		ldy	#fcr.buf_size		lda	this_trans		sta	[my_fcr_ptr],y		; save number of valid bytes		ldy	#fcr.flags		lda	[my_fcr_ptr],y		ora	#buffer_valid		; buffer contains valid data		sta	[my_fcr_ptr],y				clc				; call is all done		lda	#0		rts		endwith				; with dp		endp;------------------------------------------------------------; Read_Unbuffered;; This handles file reads when buffering for the file is off.; The main vars (mark, buffer, request, transfer) have been; set up and must be maintained.;; Each time I read some, I have to see if it was terminated; by a newline char.  If it was, the read call is done.;------------------------------------------------------------read_unbuffered	proc		with	dp,mydata		ProcName read_unbuffered		;------------------------------------------------------------; Copy mark and buffer address to local vars used by; routine that reads from server.;------------------------------------------------------------		lda	cur_mark		sta	this_mark		lda	cur_mark+2		sta	this_mark+2				lda	data_buffer		sta	this_buffer		lda	data_buffer+2		sta	this_buffer+2		;------------------------------------------------------------; If newline mode with more than 1 newline char, then this; request becomes 1 byte.;------------------------------------------------------------		ldx	req_count		ldy	req_count+2		lda	newline_len		cmp	#2			; 2 or more newline chars?		blt	@full		ldx	#1			; yep, so only request 1 byte		ldy	#0@full		stx	this_req		sty	this_req+2;------------------------------------------------------------; Get the data from the server.;------------------------------------------------------------		lda	newline_word		; indicate newline char if one		jsr	from_server		pha				; save error code		;------------------------------------------------------------; Update mark, buffer, request, transfered.;------------------------------------------------------------		jsr	update_vars		pla				; was there an error?		bne	err_exit		; if so, exit with the error;------------------------------------------------------------; No error on read, so see if read terminated by hitting; a newline character.;------------------------------------------------------------		ldy	newline_len		; any newline chars?		beq	check_more		; if not, see if there is more to read				sec		lda	data_buffer		; get address of last byte transfered		sbc	#1		sta	src_ptr		lda	data_buffer+2		sbc	#0		sta	src_ptr+2				sep	#$20			; short A for chars		longa	off		lda	[src_ptr]		; get last char transfered		and	newline_mask		; mask that puppycheck_newline		dey				; offset to next newline char		cmp	[newline_ptr],y		; is it a newline		beq	was_newline		cpy	#0			; any more to check?		bne	check_newline				rep	#$20			; back to full native		longa	oncheck_more		lda	req_count		ora	req_count+2		; any more bytes to read?		bne	read_unbufferedok_exit		clc				; return no error (A = 0)		lda	#0		rtswas_newline		rep	#$20			; back to full native		longa	on		lda	#eof_error		; pretend we got newlineerr_exit		sec		rts				endwith				; with dp		endp;------------------------------------------------------------; Read_Buffered;; This handles file reads when buffering for the file is on.; The main vars (mark, buffer, request, transfer) have been; set up and must be maintained.;------------------------------------------------------------read_buffered	proc		with	dp,mydata		ProcName read_buffered		;------------------------------------------------------------; If the read is <= $200 bytes, or there are any newline; characters, then do read a block at a time through the; buffer.;------------------------------------------------------------		lda	newline_len		bne	short			; newlines, so use buffer				lda	req_count+2		; really big read?		bne	long			; yes, do direct from server		lda	req_count		cmp	#$200			; big enough for server read?		bge	longshort		jsr	fill_buffer		; make sure buffer is full of data		bcs	exit				jsr	from_buffer		; try getting some data from buffer		bcs	exit				lda	req_count		ora	req_count+2		; more to read?		bne	short			; if so, go to next block		clc		bra	exitlong		jsr	do_flush		; flush unwritten data		bcs	exit				ldy	#fcr.flags		lda	[my_fcr_ptr],y		and	#Åbuffer_valid		; buffered data no longer valid		sta	[my_fcr_ptr],y		long2		lda	cur_mark		; copy mark for server		sta	this_mark		lda	cur_mark+2		sta	this_mark+2				lda	data_buffer		; buffer is user's buffer		sta	this_buffer		lda	data_buffer+2		sta	this_buffer+2				lda	req_count		; copy amount requested		sta	this_req		lda	req_count+2		sta	this_req+2		lda	#0			; no newline stuff		jsr	from_server		pha				; save error if any				jsr	update_vars		; update mark, buffer, etc.				pla				; recover error code		bne	error_exit		lda	req_count		ora	req_count+2		; any more to transfer?		bne	long2			; yes, so transfer big chunksok_exit		clc		lda	#0exit		rtserror_exit		sec		rts		endwith				; with dp		endp		end