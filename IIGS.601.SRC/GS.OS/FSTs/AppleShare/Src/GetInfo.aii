;------------------------------------------------------------;; get_file_info;; This call takes a pathname and returns various pieces of; information about it.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 18-Jul-88	MSD	Started coding.;  9-Sep-88	MSD	Folder's read bit cleared if neither;			see files nor see folders.; 28-Jan-91	MSD	Now converts some HFS filetypes to;			Apple II filetypes (see the list in;			SetFileInfo).  The conversion only;			happens if Apple II type and auxtype;			are both zero.; 12-Apr-91	MSD	Changed com_get_info to clear the high;			byte of the filetype and high word of;			the auxtype since some servers (like;			one of the Unix-based ones, and FileShare;			under System 7.0) return bogus values that;			prevent the GS Finder from copying them.;			There is also a special case for the;			auxtype returned as $FFFFFFFF which gets;			converted to zero (which is what it is;			usually supposed to be).;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit,CheckParent):code		import	proc_path1:code		import	(StartPacket,SendPacket):code		import	(PutWord,PutLong,PutByte):code		import	(PutIDs,PutPath):code		import	(StartReply,GetWord,GetLong):code		import	(GetBlock,GetPlace,GetPString):code		import	(get_cr_date,get_mod_date):code		import	bytes_to_blks:code		import	convert_attr:code		import	mydata:tdata		entry	com_get_info,send_info,get_vol_info;; Format of class 0 parameter list;p0_parmlist	record	0		ds.l	1			; pathname pointerp0_access	ds.w	1p0_filetype	ds.w	1p0_auxtype	ds.l	1p0_storage	ds.w	1p0_create	ds.l	1p0_mod		ds.l	1p0_blocks	ds.l	1		endr;; Format of class 1 parameter list (relative to start of info);p1_parmlist	record	0p1_access	ds.w	1p1_filetype	ds.w	1p1_auxtype	ds.l	1p1_storage	ds.w	1p1_create	ds.l	2			; create date/time in ToolBox formatp1_mod		ds.l	2			; mod date/time in ToolBox formatp1_option	ds.l	1			; pointer to option listp1_data_eof	ds.l	1			; data fork EOFp1_data_blks	ds.l	1			; data fork blocks usedp1_res_eof	ds.l	1			; resource fork EOFp1_res_blks	ds.l	1			; resource fork blocks used		endrget_vol_bits	equ	$C000			; get bytes free/totalget_file_info	proc	export		with	dp,mydata		ProcName get_file_info				jsr	PreProcess		; validate the call				jsr	proc_path1		; go find the file		bcs	exit			; return any errors		jsr	com_get_info		; go get file info		bcs	exit			; return any errors		lda	class			; class 0?		beq	class0			; if so, do it special;; Class 1 Get_File_Info and Open use the same common routine to; return file info to the caller;		clc		lda	my_pb_ptr		; point to where in param		adc	#4			; block to start filling in		sta	my_pb_ptr		; the info		lda	my_pb_ptr+2		adc	#0		sta	my_pb_ptr+2		dec	pcount			; adjust # of params to return		jsr	send_info		; put in user's PB.exit		jmp	main_exit		; return to caller with any errros;; Here, the call was class 0, so we do some things special;class0;; If a volume directory, auxtype becomes total_blocks, and; data blocks used becomes blocks_used on volume.;		lda	volume_sep		; anything past volume name		bne	not_vol			; OK if not a volume only		jsr	get_vol_info		; get volume information		bcs	exitnot_vol		with	p0_parmlist		; use class 0 offsets		ldy	#p0_access		; index to save access byte		lda	my_access		sta	[my_pb_ptr],y		; return access word				iny		iny				; Y = p0_filetype		lda	my_filetype		sta	[my_pb_ptr],y		; return filetype				iny		iny				; Y = p0_auxtype		lda	my_auxtype		sta	[my_pb_ptr],y		; return auxtype (low word)		iny		iny		lda	my_auxtype+2		sta	[my_pb_ptr],y		; return auxtype (high word)				iny		iny				; Y = p0_storage		lda	my_store_type		sta	[my_pb_ptr],y		; return storage type				ldy	#p0_create		lda	my_cr_date		; return create date/time		sta	[my_pb_ptr],y		iny		iny		lda	my_cr_date+2		sta	[my_pb_ptr],y				ldy	#p0_mod		lda	my_mod_date		; return mod date/time		sta	[my_pb_ptr],y		iny		iny		lda	my_mod_date+2		sta	[my_pb_ptr],y				iny		iny				; Y = p0_blocks		clc		lda	my_data_blks		; compute total blocks used		adc	my_res_blks		sta	[my_pb_ptr],y		; return blocks used (low)		iny		iny		lda	my_data_blks+2		adc	my_res_blks+2		sta	[my_pb_ptr],y		; return blocks used (high)		endwith				; dp,mydata		clc				; no errors		lda	#0		bra	exit			; return with no errors		endwith				; with dp		endp;------------------------------------------------------------; get_vol_info;; This routine gets the total blocks and used blocks for a; volume and returns them in my_auxtype, and my_data_blks.; My_res_blks is set to 0 so that used blocks is right.;; On entry:;	Full native;; On exit:;	Full native mode;;------------------------------------------------------------get_vol_info	proc		with	dp,mydata		ProcName get_vol_info				lda	#afpGetVolParms		; do FPGetVolParms		jsr	StartPacket				lda	VolID		jsr	PutWord			; Vol ID in packet		lda	#get_vol_bits		; bytes free/total		jsr	PutWord				jsr	SendPacket		; make the call		bcs	exit				jsr	StartReply		; process the results		jsr	GetWord			; ignore bitmap				jsr	GetLong			; get bytes free		xba				; high word in 65xxx order		pha		txa				; get low word		xba				; in 65xxx order		plx				; get high word		jsr	bytes_to_blks		; convert to block count		sta	my_data_blks		; save temporarily		stx	my_data_blks+2				jsr	GetLong			; get bytes total		xba				; high word in 65xxx order		pha		txa		xba				; low word in 65xxx order		plx		jsr	bytes_to_blks		sta	my_auxtype		; auxtype becomes total blocks		stx	my_auxtype+2				sec				; compute blocks used		lda	my_auxtype		sbc	my_data_blks		sta	my_data_blks		; save in my_data_blks		lda	my_auxtype+2		sbc	my_data_blks+2		sta	my_data_blks+2		clc				; no errorsexit		rts		endwith				; with dp,mydata		endp;------------------------------------------------------------; send_info;; This routine will return the saved file info to a class 1; parameter list (such as Get_File_Info or Open).  It assumes; that common_info was called to save the file info.;; On entry:;	Full native;	my_pb_ptr = address of "access" field of parameter list;	pcount = number of parameters to return;; On exit:;	Full native mode;	(parameters returned in user's parameter list);	c,A indicate error status;;------------------------------------------------------------send_info	proc	export		with	dp,p1_parmlist,mydata				import	send_option		ProcName send_info				ldy	#p1_access		lda	my_access		sta	[my_pb_ptr],y		; return access word		dec	pcount		bne	@more1		brl	done@more1				iny		iny				; Y = p1_filetype		lda	my_filetype		sta	[my_pb_ptr],y		; return filetype		dec	pcount		bne	@more2		brl	done@more2				iny		iny				; Y = p1_auxtype		lda	my_auxtype		sta	[my_pb_ptr],y		; return auxtype (low)		iny		iny		lda	my_auxtype+2		sta	[my_pb_ptr],y		; return auxtype (high)		dec	pcount		bne	@more3		brl	done@more3				iny		iny				; Y = p1_storage		lda	my_store_type		sta	[my_pb_ptr],y		; return storage type		dec	pcount		bne	@more4		brl	done@more4		iny		iny				; Y = p1_create		lda	my_cr_date		sta	[my_pb_ptr],y		iny		iny		lda	my_cr_date+2		sta	[my_pb_ptr],y		iny		iny		lda	my_cr_date+4		sta	[my_pb_ptr],y		iny		iny		lda	my_cr_date+6		sta	[my_pb_ptr],y		dec	pcount		bne	@more5		brl	done@more5				iny		iny				; Y = p1_mod		lda	my_mod_date		sta	[my_pb_ptr],y		iny		iny		lda	my_mod_date+2		sta	[my_pb_ptr],y		iny		iny		lda	my_mod_date+4		sta	[my_pb_ptr],y		iny		iny		lda	my_mod_date+6		sta	[my_pb_ptr],y		dec	pcount		bne	@more6		brl	done@more6;; Here is where the option list is returned;;		bra	opt_ok			; ignore option_list for now		iny		iny				; Y = p1_option		lda	[my_pb_ptr],y		; get option list address		sta	src_ptr			; save a pointer to it		iny		iny		lda	[my_pb_ptr],y		sta	src_ptr+2		jsr	send_option		bcs	exit			; return errors if any				dec	pcount			; account for option_list		beq	done		ldy	#p1_data_eof		lda	my_data_eof		sta	[my_pb_ptr],y		; return data fork size (low)		iny		iny		lda	my_data_eof+2		sta	[my_pb_ptr],y		; return data fork size (high)		dec	pcount		beq	done				iny		iny				; Y = p1_data_blks		lda	my_data_blks		sta	[my_pb_ptr],y		; return data blocks (low)		iny		iny		lda	my_data_blks+2		sta	[my_pb_ptr],y		; return data blocks (high)		dec	pcount		beq	done				iny		iny				; Y = p1_res_eof		lda	my_res_eof		sta	[my_pb_ptr],y		; return resource fork size		iny		iny		lda	my_res_eof+2		sta	[my_pb_ptr],y		; return high word		dec	pcount		beq	done				iny		iny				; Y = p1_res_blks		lda	my_res_blks		sta	[my_pb_ptr],y		; return resource blocks		iny		iny		lda	my_res_blks+2		sta	[my_pb_ptr],y		; return high worddone		clc		lda	#0exit		rts		endwith				; with dp,p1_parmlist,mydata		endp;------------------------------------------------------------; send_option;; This routine returns the option_list data for GetFileInfo,; Open, and GetDirEntry.;; On entry:;	my_error	any error so far;	src_ptr		pointer to option_list;; On exit:;	my_error	set to $4F if option_list buffer too;			small (otherwise unchanged);;------------------------------------------------------------send_option	proc	export		with	dp,mydata				ProcName send_option				lda	src_ptr		ora	src_ptr	+2		; was pointer = 0?		beq	ok			; if so, skip this				lda	[src_ptr]		; get size of buffer		cmp	#4			; big enough for length words?		blt	way_small		; if not, give up				lda	#tOpt.size-tOpt.data	; size of option_list data		ldy	#tOpt.opt_size		; offset of output length word		sta	[src_ptr],y		; save length word				lda	[src_ptr]		; get buffer size again		cmp	#tOpt.size		; will data fit?		blt	too_small		; if not, do error		ldy	#tOpt.data		; offset to start of data		lda	#my_fst_id		; get my file_sys_id		sta	[src_ptr],y		; put in option_list		iny		iny				; Y = opt_list.f_infoloop		lda	my_f_info-tOpt.f_info,y	; get a word		sta	[src_ptr],y		; put in buffer		iny		iny				; point to next word		cpy	#tOpt.size		; all done?		bne	loop		clc				; say no error		bra	ok			; done, no errorsway_small		lda	#invalid_parm		; buffer < 4 bytes		bra	errtoo_small		lda	#buffer_small		; buffer too small!err		secok		rts		endwith				; with dp,mydata		endp;------------------------------------------------------------; com_get_info;; This routine will send an FPGetFileDirParms packet out for; the current file and build its file information in local; variables.;; On entry:;	Full native;	Assumes PreProcess and proc_path have been called.;; On exit:;	Full native mode;	Updates variables:;		my_access;		my_store_type;		my_filetype;		my_auxtype;		my_data_eof;		my_data_blks;		my_res_eof;		my_res_blks;		my_f_info;;------------------------------------------------------------com_get_info	proc	export		with	dp,mydata		import	hfs2pdos				ProcName com_get_info				lda	#afpGetFlDrParms	; FPGetFileDirParms		jsr	StartPacket				jsr	PutIDs			; put VolID, DirID in packet		lda	#$6F26		jsr	PutWord			; put file bitmap in				lda	#$6F33		jsr	PutWord			; put directory bitmap in		clc				; don't have to align		jsr	PutPath			; add pathname to packet				jsr	SendPacket		jsr	CheckParent		; check for path not found		bcc	save_info		; fall through on errorexit		rts				; return errorsave_info		jsr	StartReply		; start processing reply packet				jsr	GetLong			; ignore bitmaps				jsr	GetWord			; get file/dir flag		sta	filedir_flag		; save for later use;------------------------------------------------------------; Note: first 8 parameters are the same for files and folders,; so use some common code for both.;------------------------------------------------------------		jsr	GetPlace		; mark start of parameters		jsr	GetWord			; get attributes word		jsr	convert_attr		; convert to ProDOS access word		lda	volume_sep		; is it a volume?		bne	@novol			; no, leave rename bit alone		lda	#$0040			; rename bit		trb	my_access		; clear it (no rename)@novol				jsr	GetLong			; get parent DirID		sta	my_parent		; save locally		stx	my_parent+2		jsr	get_cr_date		; get and convert create date		jsr	get_mod_date		; get and convert mod date		lda	#32			; get 32 bytes from packet		ldx	#<my_f_info		; to "my_f_info" buffer		ldy	#^my_f_info		jsr	GetBlock		ldx	#<long_name		; put into "long_name" buffer		ldy	#^long_name		jsr	GetPString		; get string from packet;------------------------------------------------------------; The following parameters are different depending on whether; the object was a file or a directory.;------------------------------------------------------------		lda	filedir_flag		bit	#$0080			; check file/directory bit		bne	is_dir			; set => directory		bra	is_file			; clear => file;------------------------------------------------------------; The object was a directory, so pull out directory-specific; parameters.;------------------------------------------------------------is_dir		jsr	GetLong			; get Dir ID		sta	my_dirid		; save in info		stx	my_dirid+2		jsr	GetWord			; get offspring count		xba				; in 65xxx order		sta	my_offspring		lda	#$D			; storage type = directory		sta	my_store_type				lda	#$F		sta	my_filetype				stz	my_auxtype		stz	my_auxtype+2		;------------------------------------------------------------; Pretend that 4 file entries fit in a block.;------------------------------------------------------------		clc		lda	my_offspring		; get number of directory entries		adc	#3			; round up to multiple of 4		lsr	a		lsr	a			; divide by 4 to get blocks		sta	my_data_blks		stz	my_data_blks+2		stz	my_data_eof		; zero out EOF, resource EOF		stz	my_data_eof+2		; and resource blocks used.		stz	my_res_eof		stz	my_res_eof+2		stz	my_res_blks		stz	my_res_blks+2		;------------------------------------------------------------; Clear read bit in access word if no see files and no; see folders.;------------------------------------------------------------		jsr	GetLong			; get access rights		sta	my_rights		; save for option_list		stx	my_rights+2		and	#$0003			; see files or see folders?		bne	@read		lda	#$0001			; read bit in access word		trb	my_access		; clear the bit@read		lda	my_rights		; get access rights back		and	#$0004			; is make changes set?		bne	@write			; yes, leave write bit set		lda	#$0002			; write bit in access word		trb	my_access		; clear access bit@write		brl	got_pdos_info		; exit, ProDOS info has been set;------------------------------------------------------------; The object was a file, so pull out file-specific info.;------------------------------------------------------------is_file		stz	my_rights		; clear out access rights		stz	my_rights+2				jsr	GetLong			; get data fork length		xba				; high word in 65xxx order		sta	my_data_eof+2		txa				; get low word		xba				; in 65xxx order		sta	my_data_eof		ldx	my_data_eof+2		; get high word in X		jsr	bytes_to_blks		; get block count in A,X		sta	my_data_blks		; save data fork block count		stx	my_data_blks+2		jsr	GetLong			; get resource fork length		xba				; high word in 65xxx order		sta	my_res_eof+2		txa				; get low word		xba				; in 65xxx order		sta	my_res_eof		ldx	my_res_eof+2		; high word in X		jsr	bytes_to_blks		; get block count in A,X		sta	my_res_blks		; save resource block count		stx	my_res_blks+2;------------------------------------------------------------; Compute storage type based on the EOFs.;------------------------------------------------------------		lda	my_res_eof		ora	my_res_eof+2		; any resource bytes?		beq	not_res_file		ldy	#5			; must be storage type 5		bra	got_store_typenot_res_file		ldy	#1			; try seedling first		lda	my_data_eof		cmp	#513			; less than 513 bytes?		lda	my_data_eof+2		sbc	#0		blt	got_store_type		; if so, must be seedling				iny				; try sapling		lda	my_data_eof		cmp	#1			; less than 128K+1 bytes?		lda	my_data_eof+2		sbc	#2		blt	got_store_type		; if so, must be sapling				iny				; only choice left is treegot_store_type		sty	my_store_type;------------------------------------------------------------; Finally, the ProDOS Info field common to files and folders.;------------------------------------------------------------		export	save_pdos_info		;5-May-93 JCMsave_pdos_info		jsr	GetWord			; get filetype		and	#$00FF			; high byte must be zero (4/12/91)		sta	my_filetype		jsr	GetLong			; get auxtype		sta	my_auxtype;; Begin 4/12/91 fix;		txa				; high word now in A		stz	my_auxtype+2		; force high word to zero		and	my_auxtype		cmp	#$FFFF			; was auxtype = $FFFFFFFF?		bne	@ok		stz	my_auxtype		; yes, so make it zero@ok;; End 4/12/91 fix;		jsr	hfs2pdos		; do Mac->ProDOS conversions		got_pdos_info		clc				; no errors		rts		endwith				; with dp,mydata		endp;------------------------------------------------------------; hfs2pdos;; This routine performs HFS -> ProDOS filetype conversions; that were defined after AppleShare 2.0.  Conversions are; done only on files with filetype and auxtype both zeros.;; File Type conversions:;	creator: any,  type: 'MIDI' ->  $D7 $0000;	creator: any,  type: 'AIFF' ->  $D8 $0000;	creator: any,  type: 'AIFC' ->  $D8 $0001;	creator:'dCpy' type: 'dImg' ->	$E0 $0005;	;;; On entry:;	Full native mode.;	my_filetype	= ProDOS filetype;	my_auxtype	= ProDOS auxtype;	my_f_info	= HFS Finder Info (only creator & type used);; On exit:;	Full native mode.;	my_filetype	= ProDOS filetype (derived);	my_auxtype	= ProDOS auxtype (derived);;------------------------------------------------------------hfs2pdos	proc	export		with	dp,mydata		import	FileTypes:data		import	NumFileTypes:equ				ProcName hfs2pdos				lda	my_filetype	; is ProDOS type unknown?		ora	my_auxtype	; and unknown auxtype?		bne	exit		; something set, don't change it				ldx	#NumFileTypes	; loop counter		ldy	#0		; index into filetype tableloop		lda	my_f_info	; first two bytes of type		cmp	FileTypes+4,y	; match type in table?		bne	next		lda	my_f_info+2	; last two bytes of type		cmp	FileTypes+6,y	; match table?		bne	next		; no, try another				lda	FileTypes+8,y		ora	FileTypes+10,y	; is it wildcard $FFFFFFFF?		ina			; was A=$FFFF?		beq	match		; yes, so creator matches				lda	my_f_info+4	; compare creators		cmp	FileTypes+8,y		bne	next		lda	my_f_info+6		cmp	FileTypes+10,y		beq	match		; even creator matches!next		tya		clc		adc	#12		; point to next table entry		tay		dex		bne	loop		bra	exitmatch					; found type match in table		lda	FileTypes,y	; get ProDOS type in table		sta	my_filetype		lda	FileTypes+2,y	; get ProDOS auxtype in table		sta	my_auxtypeexit		rts		endwith		endp				end