;------------------------------------------------------------; Open;; This call takes a pathname and opens the fork/directory.; An FCR is created (hence a refnum is assigned).; Directories are handled much differently than files.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 25-Jul-88	MSD	Started coding.; 26-Aug-88	MSD	Class 0 calls used the fork number;			and requested access of the previous;			call.  Fixed by moving setting of;			default values before PreProcess.;  9-Sep-88	MSD	Do not allow open of folders with no;			see files and no see folders.  Mode;			file was opened in is stored in FCR.; 19-Sep-88	MSD	Class 0 deny modes made same as for;			Toucan (class 1 is still "safer").; 17-Dec-88	MSD	Adding volume modified events.; 06-Feb-91	MSD	Removed "Bozo" alert.;;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit,CheckParent):code		import	proc_path1:code		import	(StartPacket,SendPacket):code		import	(PutIDs,PutByte,PutWord,PutPath):code		import	(StartReply,GetWord):code		import	remove_fcr:code		import	(com_get_info,send_info):code		import	addclient:code		import	set_eject:code		import	mydata:tdata;------------------------------------------------------------; Bitmaps for GS/OS and AFP request/deny access bits;------------------------------------------------------------req_read	equ	$0001			; request read accessreq_write	equ	$0002			; request write accessdeny_read	equ	$0010			; deny read access to othersdeny_write	equ	$0020			; deny write access to others;------------------------------------------------------------; Definition of parameter list for Open call;------------------------------------------------------------p		record	0refnum		ds.w	1			; returned reference numberpathname	ds.l	1			; pathname pointerreserved0					; reserved long (class 0)req_accs	ds.w	1			; requested accessfork_num	ds.w	1			; fork number to open; returned file info starts hereaccess		ds.w	1			; returned access word		ds.w	1			; returned file type		ds.l	1			; returned aux type		ds.w	1			; returned storage type		ds.b	8			; returned create date/time		ds.b	8			; returned mod date/time		ds.l	1			; pointer to option list		ds.l	1			; returned data fork EOF		ds.l	1			; returned data blocks used		ds.l	1			; returned resource EOF		ds.l	1			; returned resource blocks used		endropen		proc	export		with	dp,mydata		ProcName open				stz	request_access		; default: as permitted		stz	fork_number		; default: data fork		jsr	PreProcess		; validate the call		bne	class1			; skip class 0 stuff if class 1		lda	#2			; only refnum and path		sta	pcount				class1		dec	pcount			; skip refnum		dec	pcount			; skip pathname		beq	find_it			; end of parameters?		ldy	#p.req_accs		lda	[my_pb_ptr],y		; get requested access		bit	#$FFFC			; make sure reserved bits are 0		bne	do_invalid		; reserved<>0 => error		sta	request_access				dec	pcount			; skip over access		beq	find_it		iny		iny				; Y = p.fork_num		lda	[my_pb_ptr],y		; get fork number		bit	#$FFFE			; is it valid (0,1)?		beq	ok_forknum		; yes, so use itdo_invalid		sec		lda	#invalid_parm		; fork number was invalid		brl	exitok_forknum		lsr	a			; shift fork # into carry		ror	fork_number		; shift into fork flag		dec	pcount			; skip over fork numberfind_it		jsr	proc_path1		; go find the file		bcc	found_file		; found, continue		brl	exit			; return the errorfound_file		jsr	com_get_info		; go get file info		bcc	got_info		; OK, continue		cmp	#access_error		; in a drop box?		bne	@err			; no, return other error		ldx	pcount			; did they want file info?		bne	@err			; if so, return access error		stz	filedir_flag		; assume it's a file		bra	got_info		; and continue with open@err		sec				; force carry set for error		brl	exit			; return the errorgot_info;------------------------------------------------------------; If this is a folder, and it does not have its read bit set,; don't even bother to allow the open.;------------------------------------------------------------		lda	filedir_flag		and	#$0080			; is it a folder?		beq	@file			; no, skip read bit check		lda	my_access		; get access word		and	#$0001			; is read bit set?		beq	@noaccess		; if not, return error		lda	request_access		; how did they want to open it?		and	#$0002			; want write to folder?		beq	@access			; if not, it's ok to open@noaccess		sec				; do access denied error		lda	#access_error		brl	exit			; return the error@access		lda	fork_number		; did they want a resource fork?		beq	@file			; data fork is OK				sec		lda	#res_not_found		; folders don't have resources!		brl	exit@file		IF 0 THEN;; Note: This code is no longer used since a pointer to the; volume name is now passed to Alloc_FCR;;------------------------------------------------------------; Set up the FCR now, including common fields.;; First, strip off the filename to put in the FCR.;------------------------------------------------------------		ldx	gstring			; in case partial path is null		sep	#$30			; 8 bits for strings		longa	off		longi	off		ldy	partial_path		; get length, is it zero?		beq	got_name		; zero, volume name already in gstring		iny				; fix Y for loopfind_sep		dey				; check next character		lda	partial_path,y		beq	found_sep		; branch if separator		cpy	#0			; scanned whole name?		bne	find_sep		; if not, loop again;------------------------------------------------------------; Here, Y points to the separator before the filename (or; to the length byte if there was no separator).  Copy the; rest of the partial path into gstring.;; Y = index into partial_path; X = index into gstring;------------------------------------------------------------found_sep		ldx	#0			; start with first charcopy_name		inx		iny		lda	partial_path,y		sta	gstring+1,x		; remember, length WORD		cpy	partial_path		; copied it all?		bne	copy_name		; no, do some more;------------------------------------------------------------; X = length of filename;------------------------------------------------------------got_name		rep	#$30			; back to full native		longa	on		longi	on		stx	gstring			; save length word		ENDIFdo_fcr;------------------------------------------------------------; If folder, buffer is 2K.  If file, buffer is 512 bytes.;------------------------------------------------------------		ldx	#fcr.buffer+512		; assume a file		lda	filedir_flag		and	#$0080			; is it a folder?		beq	@file			; no, skip read bit check		ldx	#fcr.buffer+2048	; size for folders@file		txa				; size goes in A		ldx	gstring			; get volume length		inx				; plus 1 for colon		ldy	#'::'			; just need one colon...		sty	gstring			; put colon in gstring+1		stx	gstring-1		; save word length in gstring-1				ldx	#<gstring-1		; point to ":"volname		ldy	#^gstring-1		sec				; please zero the buffer		jsr	Alloc_FCR		; build an FCR for me		bcc	got_fcr			; return any errors		brl	exit		;------------------------------------------------------------; The FCR is built.  Save the pointer to it.;------------------------------------------------------------got_fcr		lda	gstring-1		; get modified length		dea		sta	gstring			; save original length				jsl	Deref			; get a real address		stx	my_fcr_ptr		; save for filling in		sty	my_fcr_ptr+2		ldy	#vcr.open_cnt		lda	[my_vcr_ptr],y		; get volume's open file count		ina				; plus 1 for this file		sta	[my_vcr_ptr],y		; and update open count		lda	#$8000			; don't allow eject		jsr	set_eject		; set eject status of volume				lda	#my_fst_id		ldy	#fcr.fst_id		sta	[my_fcr_ptr],y		; set FST ID = mine				lda	[my_vcr_ptr]		; get VCR ID		iny		iny				; Y = fcr.vcr_id		sta	[my_fcr_ptr],y		; save FCR's VCR ID		lda	#buffer_active		; turn on buffering		ldy	#fcr.flags		sta	[my_fcr_ptr],y		; save buffer flag.;------------------------------------------------------------; Now find out if this is a file or directory.;------------------------------------------------------------		lda	filedir_flag		and	#$0080			; is it a directory?		beq	is_file			; no, go do file open;------------------------------------------------------------; They want to open a directory.  Save off info;------------------------------------------------------------		ldy	#fcr.dirflag		lda	#fcr_is_dir		; indicate this is directory		sta	[my_fcr_ptr],y		ldy	#fcr.dirindex		lda	#0			; enumerations start with first		sta	[my_fcr_ptr],y		ldy	#fcr.dirid		lda	my_dirid		; copy DirID to FCR		sta	[my_fcr_ptr],y		iny		iny		lda	my_dirid+2		sta	[my_fcr_ptr],y		ldy	#fcr.access		lda	#fcr_clean		; file is clean		sta	[my_fcr_ptr],y				lda	volume_sep		; just a volume name?		bne	open_done				jsr	addclient		; yes, so start volume modified events		ldy	#fcr.dirflag		lda	#fcr_is_dir+fcr_is_root	; say it is a root directory		sta	[my_fcr_ptr],y		; update dirflagopen_done		lda	[my_fcr_ptr]		; get FCR # (file refnum);		ldy	#p.refnum		; Y = 0		sta	[my_pb_ptr]		; return to user (was [],y);------------------------------------------------------------; Now check to see if they want any file information back.;------------------------------------------------------------		lda	pcount			; anything to return?		beq	ok_exit		clc		lda	my_pb_ptr		; point my_pb_ptr to		adc	#p.access		; access field for		sta	my_pb_ptr		; send_info routine		lda	my_pb_ptr+2		adc	#0		sta	my_pb_ptr+2				jsr	send_info		; copy file info to parm list		bcc	exit			; if no error, just return		pha				; save error (buffer too small)		jsr	remove_fcr		; get rid of the FCR		pla				; restore error code		sec				; force error conditionexit		jmp	main_exit		; return error if anyok_exit		clc				; no errors		lda	#0		bra	exit			; return to application;------------------------------------------------------------; Here, they want to open a file.  Depending on the access; they requested, I may have to try several access modes.;------------------------------------------------------------is_file		lda	request_access		; what access do they want?		beq	as_permitted		; as permitted is special		jsr	try_open		; try with what they gave us		bcc	open_worked		; do the rest if Open went OK;------------------------------------------------------------; If we get here, the FPOpenFork failed.  Now we must remove; the FCR and return error to the user.;------------------------------------------------------------open_failed		pha				; save error code		jsr	remove_fcr		; get rid of the FCR		pla		sec		bcs	exit			; return with erroras_permitted				lda	#req_read+req_write	; first try read/write		jsr	try_open		bcc	open_worked		; if it worked, it's open				lda	#req_read		; next try read-only		jsr	try_open		bcc	open_worked				lda	#req_write		; lastly, try write-only		jsr	try_open		bcs	open_failed		; error if this failed;------------------------------------------------------------; The FPOpen finally worked.  Copy file-specific info into; the FCR (dirflag, fork refnum, mark).;------------------------------------------------------------open_worked		ldy	#fcr.forkrefnum		sta	[my_fcr_ptr],y		; save fork refnum in FCR		lda	fork_number		; get data/resource flag		lsr	a			; shift to $4000 bit		ldy	#fcr.dirflag		sta	[my_fcr_ptr],y		; save data/resource flag		ldy	#fcr.access		; get access word		ora	[my_fcr_ptr],y		; add data/res flag to access		ora	#fcr_clean		; and the file is clean		sta	[my_fcr_ptr],y		; save new access word w/flags				and	#req_read+req_write	; get the requested mode		cmp	#req_write		; want write-only?		bne	@ok_buf			; no, so leave buffering on		ldy	#fcr.flags		lda	#$0000			; no buffering		sta	[my_fcr_ptr],y@ok_buf		ldy	#fcr.mark		lda	#0			; start mark at 0		sta	[my_fcr_ptr],y		iny		iny		sta	[my_fcr_ptr],y		brl	open_done		; return from Open call;------------------------------------------------------------; Try_Open;; Try to do an FPOpenFork with the requested access.  Save; access mode in FCR.;; On entry:;	Full native mode;	A = access desired (GS/OS style, low two bits only);; On error exit:;	c = 1;	A = error code;; On OK exit:;	c = 0;	A = AFP fork refnum;;------------------------------------------------------------try_open		bit	#req_write		; requesting write?		beq	no_write		; no, so skip this		ora	#deny_write		; don't allow multiple writersno_write		ldy	class			; class 0?		beq	got_open_mode		; yes, be easy like Toucan		bit	#req_read		; want read access?		beq	no_read		ora	#deny_write		; if so, deny writeno_read		bit	#req_write		; want write access?		beq	got_open_mode		ora	#deny_read		; if so, also deny readgot_open_mode		ldy	#fcr.access		sta	[my_fcr_ptr],y		; save opened access		xba				; put in AFP byte order		pha				; save access mode word				lda	#afpOpenFork		ora	fork_number		; add in data/res flag		jsr	StartPacket		; start an OpenFork packet		jsr	PutIDs			; copy VolID, DirID				lda	#0			; don't want file parameters		jsr	PutWord			; so put null bitmap				pla				; get access mode		jsr	PutWord				clc				; don't align after path		jsr	PutPath			; put pathname in packet				jsr	SendPacket		; try the open		jsr	CheckParent		; check for path not found		bcs	try_open_err		; return with error				jsr	StartReply		; get ready to look at reply		jsr	GetWord			; ignore bitmap word				jsr	GetWord			; get AFP fork refnum		clc				; no errortry_open_x		rts				; return to callertry_open_err		cmp	#bad_store_type		; bad storage type error?		bne	@err			; if so, was folder in drop box		lda	#access_error		; so return access denied@err		sec		bra	try_open_x				endwith				; with dp,mydata		endp		end