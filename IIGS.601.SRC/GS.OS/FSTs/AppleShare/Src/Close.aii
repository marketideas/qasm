;------------------------------------------------------------; Close;; This call takes a file reference number and closes the; associated file or directory.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 21-Jul-88	MSD	Started coding.; 17-Aug-88	MSD	Always removes FCR, even on error;			(I can't recover from an error!);;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit):code		import	(StartPacket,SendPacket):code		import	PutWord:code		import	do_flush:code		import	delclient:code		import	mydata:tdata		entry	remove_fcr:code		entry	set_eject:codeclose		proc	export		with	dp,mydata		ProcName close				jsr	PreProcess		; setup for call		stz	my_error		; assume no errors;------------------------------------------------------------; First thing to do is make sure data files are flushed.;------------------------------------------------------------		jsr	do_flush		; flush any data		bcc	do_close		; continue if no error		sta	my_error		; save any errordo_close;------------------------------------------------------------; If this is a file, issue an FPClose command;------------------------------------------------------------		ldy	#fcr.dirflag		lda	[my_fcr_ptr],y		; is this a file?		bmi	not_file		; skip for directories		lda	#afpForkClose		; FPCloseFork command		jsr	StartPacket				ldy	#fcr.forkrefnum		lda	[my_fcr_ptr],y		; get AFP's fork refnum		jsr	PutWord			; and put it in packet				jsr	SendPacket		bcc	closed			; continue if no error		sta	my_error		; save any error		bra	closed			; skip directory stuffnot_file		bit	#fcr_is_root		; should we turn off vol mod events?		beq	closed			; no, since this isn't a root		jsr	delclient		; one less event clientclosed		jsr	remove_fcr		; get rid of the FCR		bcc	exit			; continue if no error		sta	my_error		; save any errorexit		lda	my_error		; get any saved error		cmp	#1			; set carry if error		jmp	main_exit		endwith				; with dp		endp;------------------------------------------------------------; Remove_FCR;; This routine does the work of removing an open FCR.  It; decrements the volume's open file count and calls the; Release_FCR system service routine.;; On entry:;	Full native mode.;	(Assumes my_fcr_ptr and my_vcr_ptr have been set up);; On exit:;	c = 0 (no error possible);;------------------------------------------------------------remove_fcr	proc	export		with	dp,mydata		ProcName remove_fcr				ldy	#vcr.open_cnt		lda	[my_vcr_ptr],y		; get volume's open count		dea				; minus 1		bmi	very_sick		; if negative, we're dead!		sta	[my_vcr_ptr],y		; update open count		bne	@continue		; files still open, continue;------------------------------------------------------------; Here, we closed the last file on the volume.  Mark the; volume as ejectable.;------------------------------------------------------------		lda	#0			; ejectable		jsr	set_eject		; set it for driver@continue		lda	[my_fcr_ptr]		; get file refnum		jsl	Release_FCR		; be free and happy		rts		;------------------------------------------------------------; If we get here, a VCR's open count went negative.  If this; happens, the system must be very sick, so do system death.;------------------------------------------------------------very_sick		lda	#vcr_unusable		; the VCR is messed up		jml	Sys_Death		; bury 'em		endwith				; with dp		endp;------------------------------------------------------------; Set_Eject;; Sets the eject status of the current volume to the value; passed as input.;; On entry:;	my_vcr_ptr	points to VCR for volume whose status;			is to be modified;	A		new eject flag;;------------------------------------------------------------set_eject	proc	export		with	dp,mydata		ProcName set_eject				sta	[gbuf_ptr]		; save eject flag		ldy	#vcr.dev		lda	[my_vcr_ptr],y		; get device number		sta	dev_num		lda	#6			; Control call		sta	dev_callnum		lda	gbuf_ptr		; low word of address		sta	dev_buff		stz	dev_buff+2		; always in bank 0!		lda	#2			; only setting 2 bytes		sta	dev_req_cnt		lda	#$8002			; set eject status		sta	dev_ctl_code		jsl	Dev_Dispatcher		; go make the call		rts				endwith		endp				end