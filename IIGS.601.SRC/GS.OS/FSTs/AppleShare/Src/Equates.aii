;------------------------------------------------------------; File: Equates.aii;; Copyright Apple Computer, Inc 1988-93; All Rights Reserved;; This file creates an equate dump file; containing all the equates.;; Modification history:;  8-Sep-88	MSD	Added EOF field for files in FCR.;  9-Sep-88	MSD	DebugCode set to 1 if not defined;			on command line at assemble time.; 30-Sep-88	MSD	Changed the FCR structure to support;			buffering of files.;; 12-Nov-90	MSD	Added new fields to support default;			privileges for folders.;; 28-Jan-91	MSD	Turned debugging back on by default;			and add a macro to generate Nifty;			List compatible procedure headers.;; 15-Mar-91	MSD	Added a variable other_fst which will;			be set by FindVol if there was a VCR;			for the same volume name owned by;			another FST.; 17-Jun-91	MSD	For debugging, moved the device number;			to the end of the VolRec.; 18-Dec-91	MSD	Added equates max_filename and;			max_volname.  Added variable my_span.; 21-Jan-93	DAL	Added dib_slotnum.;------------------------------------------------------------;------------------------------------------------------------; DebugCode: This flag controls the assembly of debugging; code and data structures.  It can be controlled in 3 ways.; The highest priority is a define on the command line.  The; next is the value of the shell variable "MSDDebugFlag".; Last is the value assigned below.;------------------------------------------------------------		if &trim(&type('DebugCode')) = 'UNDEFINED' then		if &trim(&getenv('MSDDebugFlag')) = '' thenDebugCode	equ	0		elseDebugCode	equ	&eval(&getenv('MSDDebugFlag'))		endif		endif;------------------------------------------------------------; The following flag controlls the conditional assembly of; AFP++ code and data structures.;------------------------------------------------------------		if &trim(&type('AFPnew')) = 'UNDEFINED' thenAFPnew		equ	1		endif;; GS/OS error codes:;bad_call_num	equ	$01			; call number out of rangebad_pcount	equ	$04			; bad parameter count (class>0)prodos_busy	equ	$07			; ProDOS is busydev_not_found	equ	$10			; device not foundinval_dev_num	equ	$11			; invalid device numberint_vec_full	equ	$25			; interrupt vector table fullio_error	equ	$27			; general I/O errorno_dev_err	equ	$28			; no device connectedwrite_protected	equ	$2B			; disk write protecteddisk_switched	equ	$2E			; media was switchedoffline_error	equ	$2F			; media not on lineinvalid_path	equ	$40			; invalid pathname syntaxinval_refnum	equ	$43			; invalid reference numberpath_not_found	equ	$44			; a directory component not foundvol_not_found	equ	$45			; volume component not foundfile_not_found	equ	$46			; filename component not founddup_path	equ	$47			; duplicate pathnamevol_full	equ	$48			; volume full (no free blocks)vol_dir_full	equ	$49			; volume directory fullversion_error	equ	$4A			; incompatible versionbad_store_type	equ	$4B			; bad storage typeeof_error	equ	$4C			; End Of File encounteredbad_pos		equ	$4D			; position out of rangeaccess_error	equ	$4E			; access deniedbuffer_small	equ	$4F			; buffer too smallfile_open	equ	$50			; file is open errorbad_vol_type	equ	$52			; bad volume type (not recognized)invalid_parm	equ	$53			; invalid parameterdup_vol		equ	$57			; duplicate volumenot_block_dev	equ	$58			; not a block devicebad_level	equ	$59			; bad file levelbad_block_num	equ	$5A			; bad block numberbad_file_sys	equ	$5D			; bad file_sys_id (Format)data_unavail	equ	$60			; data unavailable (GetLastDev)end_of_dir	equ	$61			; end of directory (GetDirEntry)bad_class	equ	$62			; invalid call classres_not_found	equ	$63			; required resource not foundresource_exist	equ	$70			; resource fork already exists		res_add_err	equ	$71			; can't add res. fork to this type fileuser_not_found	equ	$7E			; user name not recognizedgroup_not_found	equ	$7F			; group name not recognized;; System Death error codes;;unclaimed_int	equ	$0001			; unclaimed interruptvcr_unusable	equ	$000A			; VCR is unusable/inconsistentfcr_unusable	equ	$000B			; FCR is unusable/inconsistent;blk_0_alloc	equ	$000C			; block 0 allocated illegally;unshadow_int	equ	$000D			; interrupt with I/O shadowing off;; Misc. addresses;QtrVector	equ	$E1104A			; what 1/4 sec handler callswarm_cold_flag	equ	$e101d0			;word:	0=cold startup/shutdown,						;	1=warm startup/shutdown;; Equates for System Service calls;Dev_Dispatcher	equ	$01FC00Alloc_Seg	equ	$01FC1CRelease_Seg	equ	$01FC20Alloc_VCR	equ	$01FC24Release_VCR	equ	$01FC28Alloc_FCR	equ	$01FC2CRelease_FCR	equ	$01FC30Deref		equ	$01FC38Get_Sys_GBuf	equ	$01FC3CSys_Exit	equ	$01FC40Sys_Death	equ	$01FC44Find_VCR	equ	$01FC48Find_FCR	equ	$01FC4CRename_VCR	equ	$01FC58Rename_FCR	equ	$01FC5CGet_VCR		equ	$01FC60Get_FCR		equ	$01FC64Lock_Mem	equ	$01FC68Unlock_Mem	equ	$01FC6CMove_Info	equ	$01FC70cvt_0_to_1	equ	$01FC74cvt_1_to_0	equ	$01FC78report_error	equ	$01FC94get_boot_pfx	equ	$01FCAC		; get boot (*) prefixset_boot_pfx	equ	$01FCB0		; set boot (*) prefixparse_path	equ	$01FCC0os_event	equ	$01FCC4init_parse_path	equ	$01FCD4		;initialize for parse_path.;; Event codes for os_event;volmod_event	equ	$0040		; event code for volume modifieddisk_in_event	equ	$0008		; disk inserted event;; Driver command codes;drvr_startup	equ	0drvr_open	equ	1drvr_read	equ	2drvr_write	equ	3drvr_close	equ	4drvr_status	equ	5drvr_control	equ	6drvr_flush	equ	7drvr_shutdown	equ	8drvr_get_dib	equ	1;; Driver control and status call codes;stat_status	equ	0stat_config	equ	1;; Offsets of fields in a DIB;dib_slotnum	equ	$2E			;46 (21-Jan-93 DAL)dib_dev_id	equ	$34;; Equates for AFP command codes;afpByteRangeLock equ	1			; Byte Range LockafpVolClose	equ	2			; Close volumeafpDirClose	equ	3			; Close directoryafpForkClose	equ	4			; Close forkafpCopyFile	equ	5			; Copy fileafpDirCreate	equ	6			; Create directory afpFileCreate	equ	7			; Create file (soft)afpDelete	equ	8			; Delete file/folderafpEnumerate	equ	9			; Enumerate directoryafpFlush	equ	10			; Flush volumeafpForkFlush	equ	11			; Flush forkafpGetDirParms	equ	12			; Get directory parametersafpGetFileParms	equ	13			; Get file parametersafpGetForkParms	equ	14			; Get fork parametersafpGetSInfo	equ	15			; Get server infoafpGetSParms	equ	16			; Get server parametersafpGetVolParms	equ	17			; Get volume parametersafpLogin	equ	18			; LoginafpContLogin	equ	19			; Login continueafpLogout	equ	20			; LogoutafpMapID	equ	21			; Map IDafpMapUserID	equ	afpMapID+$100		; Map ID, function = map user IDafpMapGroupID	equ	afpMapID+$200		; Map ID, function = map group IDafpMapName	equ	22			; Map nameafpMapUserName	equ	afpMapName+$300		; MapName, function = map user nameafpMapGroupName	equ	afpMapName+$400		; MapName, function = map group nameafpMove		equ	23			; MoveafpOpenVol	equ	24			; Open volumeafpOpenDir	equ	25			; Open directoryafpOpenFork	equ	26			; Open fork (file)afpRead		equ	27			; ReadafpRename	equ	28			; RenameafpSetDirParms	equ	29			; Set directory parametersafpSetFileParms	equ	30			; Set file parametersafpSetForkParms	equ	31			; Set fork parametersafpSetVolParms	equ	32			; Set volume parametersafpWrite	equ	33			; WriteafpGetFlDrParms	equ	34			; Get file/directory parametersafpSetFlDrParms	equ	35			; Set file/directory parametersafpGetUserInfo	equ	37			; Get user and primary group numbersafpDTOpen	equ	48			; Open desktopafpDTClose	equ	49			; Close desktopafpGetIcon	equ	51			; Get iconafpGtIcnInfo	equ	52			; Get icon infoafpAddAPPL	equ	53			; Add APPL mappingafpRmvAPPL	equ	54			; Remove APPL mappingafpGetAPPL	equ	55			; Get APPL mappingafpAddCmt	equ	56			; Add commentafpRmvCmt	equ	57			; Remove commentafpGetCmt	equ	58			; Get commentafpAddIcon	equ	192			; Add iconafp_long	equ	2			; AFP PathType = long names;; Equates for ASP command codes;aspCloseSess	equ	1			; Close sessionaspCommand	equ	2			; User command (used by AFP)aspGetStat	equ	3			; Get statusaspOpenSess	equ	4			; Open sessionaspTickle	equ	5			; TickleaspWrite	equ	6			; WriteaspWriteData	equ	7			; Write data (from server)aspAttention	equ	8			; Attention (from server);--------------------------------------------------; tConfig;; Describes the data structure returned by the; drivers' GetConfigurationParameters status call.;--------------------------------------------------tConfig		record	0length		ds.w	1			; length of returned parametersdevnum		ds.w	1			; device number (0..13)session		ds.w	1			; SessRefnumvolname		ds.b	28			; volume name (pstring)volid		ds.w	1			; VolIDstatus		ds.w	1			; driver statusminsize						; minimum to identify volumeserver		ds.b	32			; server name (pstring)zone		ds.b	33			; zone name (pstring)size		endr;; Definitions of data structures used by this FST.;;--------------------------------------------------; tOpt;; Defines the fields in the option_list as returned; by Open, GetFileInfo, and GetDirEntry.;--------------------------------------------------tOpt		record	0buf_size	ds.w	1			; size of bufferopt_size	ds.w	1			; size of actual datadatafile_sys_id	ds.w	1			; file system IDf_info		ds.b	32			; Finder Infoparent_dirid	ds.l	1			; parent's DirIDaccess		ds.b	4			; access rightssize		endr;--------------------------------------------------; vcr;; Defines the fields in a Volume Control Record; as used by this FST.;--------------------------------------------------vcr		record	0; Common fieldsid		ds.w	1			; unique VCR numbername		ds.l	1			; pointer to volume namestatus		ds.w	1			; volume status (???)open_cnt	ds.w	1			; number of open filesfst_id		ds.w	1			; ID of owning FSTdev		ds.w	1			; device number of volume; FST specific fieldssessrefnum	ds.w	1			; SessRefnum for volumevolid		ds.w	1			; VolID for volumesignature	ds.w	1			; AFP's volume signaturecrdate		ds.l	1			; AFP create date of volumemodptr		ds.l	1			; ptr. to vol. modification record		IF AFPnew THENversion		ds.w	1			; AFP version number		ENDIFsize		endr;--------------------------------------------------; fcr;; Defines the fields in a File Control Record; as used by this FST.;--------------------------------------------------fcr		record	0; common FCR fieldsref_num		ds.w	1			; open file refnumpath_name	ds.l	1			; pointer to pathnamefst_id		ds.w	1			; owning FSTvcr_id		ds.w	1			; owning VCRlevel		ds.w	1			; file levelnewline		ds.l	1			; pointer to newline infonewline_len	ds.w	1			; length of newline infomask		ds.w	1			; newline maskaccess		ds.w	1			; access word;; FST specific fields;dirflag		ds.w	1			; $8000 = directory (not file)						; $4000 = file's resource fork						; $4000 = directory is root (and						;         generating vol mod events)flags		ds.w	1			; $8000 = buffering active						; $4000 = buffered data is valid						; $2000 = data needs to be flushed						; $1000 = buffer partially full;; Better yet: assume data is always valid and use the buf_size field; to see if the buffer is partially or completely full.;; Then turning buffering from off to on makes buf_size = 0;shared						; start of variant part of record;; Fields for files only;forkrefnum	ds.w	1			; AFP OForkRefnummark		ds.l	1			; current mark in the filebuf_start	ds.l	1			; mark of first byte in bufferbuf_size	ds.w	1			; # of valid bytes in buffer;; Fields for directories only;		org	shareddirindex	ds.w	1			; Enumerate: current indexdirid		ds.l	1			; DirID of directorydir_first	ds.w	1			; first dir index in bufferdir_last	ds.w	1			; last dir index in bufferlastmod		ds.l	1			; last mod date of volume;; End of share fields.  Add a block buffer to end and compute size.;		org				; force realignmentbuffer		endr;; Bitmaps used for fcr.dirflag;fcr_is_dir	equ	$8000			; this is a directoryfcr_is_res	equ	$4000			; this is a resource forkfcr_is_root	equ	$4000			; directory is root directorydata_fork_bit	equ	$0002			; set/get data fork lengthres_fork_bit	equ	$0004			; set/get resource fork len;; Bitmaps used for fcr.access;fcr_clean	equ	$8000			; this file is clean (for SCM only);fcr_is_res	equ	$4000			; this is a resource fork;; Bitmaps used for fcr.flags;buffer_active	equ	$8000buffer_valid	equ	$4000buffer_dirty	equ	$2000buffer_partial	equ	$1000;; Flags used in vcr.status;vcr_offline	equ	$4000			; volume went offline with files openvcr_wr_enabled	equ	$2000			; volume seen write enabled ?????MaxSPCommand	equ	$242		; maximum size of command packetMaxSPData	equ	$1210		; maximum size of data to read/writeNormSPData	equ	512		; normal size of command reply;--------------------------------------------------; DP;; Defines the direct-page area used by device; drivers, GS/OS, and my FST.;--------------------------------------------------dp		record	0;--------------------------------------------------; Here are the device driver fields;--------------------------------------------------dev_num		ds.w	1		; device number being calleddev_callnum	ds.w	1		; call numberdev_dev_id	ds.w	1		; device ID (get_dib_ptr)		org	dev_dev_id	;	- or -dev_buff	ds.l	1		; I/O buffer addressdev_req_cnt	ds.l	1		; request countdev_xfer_cnt	ds.l	1		; transfer countdev_blk_num	ds.l	1		; block numberdev_blk_size	ds.w	1		; block sizedev_fst_num	ds.w	1		; FST number		org	dev_fst_num	;  - or -dev_stat_code	ds.w	1		;   status code		org	dev_fst_num	;  - or -dev_ctl_code	ds.w	1		;   control codedev_vol_id	ds.w	1		; volume ID (???)dev_cache_pr	ds.w	1		; cache prioritydev_cache_ptr	ds.l	1		; cache pointerdev_dib_ptr	ds.l	1		; pointer to DIB;--------------------------------------------------; Here are the GS/OS fields;--------------------------------------------------		org	$30call_number	ds.w	1			; current call numberp_b_addr	ds.l	1			; pointer to user's param blocksrc_dev_num	ds.w	1			; source device numberdest_dev_num	ds.w	1			; destination device numberpath_1_addr	ds.l	1			; pointer to first pathname		org	*-4			; 	- or -fcr_addr	ds.l	1			; pointer to FCRpath_2_addr	ds.l	1			; pointer to second pathname		org	*-4			; 	- or -vcr_addr	ds.l	1			; pointer to VCRpath_flags	ds.w	1			; pathname flagsspan1		ds.w	1			; max span of pathname 1span2		ds.w	1			; max span of pathname 2;--------------------------------------------------; Here are the FST fields;--------------------------------------------------		org	$80gbuf_ptr	ds.l	1			; pointer to Global Bufferpcount		ds.w	1class		ds.w	1my_error	ds.w	1reply_buf	ds.l	1			; pointer to ASP reply packetnewline_ptr					; newline pointer for Readmy_path_ptr	ds.l	1			;   or pointer into pathnamenewline_len					; newline length for Readmy_path_len	ds.w	1			;   or length of rest of pathnamemy_pb_ptr	ds.l	1			; my pointer to param blockmy_fcr_ptr	ds.l	1			; my pointer to the FCRmy_vcr_ptr	ds.l	1			; my pointer to the VCRsrc_ptr		ds.l	1			; temporary pointer (source)dest_ptr	ds.l	1			; temporary pointer (dest)math_temp					; temporary long (numeric)quotient					;   or quotient for divisionfact1		ds.l	1			;   or first factor in multdivisor						; divisor in divisionfact2		ds.l	1			;   or second factor in multremainder					; remainder in divisionproduct		ds.l	1			;   or product in multcur_mark	ds.l	1			; used in EOF, Mark, and Read callsdata_buffer	ds.l	1			; address of user's data bufferreq_count	ds.l	1			; bytes left to transfertrans_count	ds.l	1			; bytes already transferedthis_buffer	ds.l	1			; buffer addr for this read/writethis_mark	ds.l	1			; offset in file for this r/wthis_req	ds.l	1			; request size for this r/wthis_trans	ds.l	1			; transfer count for this r/w		if	*>$D4 then		aerror	&concat('Direct page overflow of ',&i2s(*-$D4),' bytes')		endif		endr;--------------------------------------------------; This is the parameter list for the SPWrite call; which is used by the Write call.;--------------------------------------------------tSPWrite	record	0		ds.b	2		; sync, call numberResult		ds.w	1		; result code		ds.l	1		; completion routineSRef		ds.b	1		; session reference #ComLen		ds.w	1		; command block lengthComAddr		ds.l	1		; command block addressWrtBufLen	ds.w	1		; amount to be writtenWrtAddr		ds.l	1		; address to write fromRepBufLen	ds.w	1		; reply buffer lengthRepAddr		ds.l	1		; reply buffer addressComRes		ds.l	1		; result (from server)WrtLen		ds.w	1		; actual amount writtenRepLen		ds.w	1		; actual reply length		endr;--------------------------------------------------; This is the parameter list for the SPCommand call; which is used to send out an AFP command.;--------------------------------------------------tSPCommand	record	0cmd		ds.b	2		; async flag, call numberResult		ds.w	1Completion	ds.l	1		; completion routineSRef		ds.b	1		; session reference #ComLen		ds.w	1		; command block lengthComAddr		ds.l	1		; command block addressRepBufLen	ds.w	1		; reply buffer lengthRepAddr		ds.l	1		; reply buffer addressComRes		ds.l	1		; result (from server)RepLen		ds.w	1		; actual reply length		endr;--------------------------------------------------; This is the parameter list for the GetSVersion; call which is used to determine the version of; AFP being used for a given session.;--------------------------------------------------tGetVersion	record	0		ds.b	2		; sync, call numberResult		ds.w	1Session		ds.b	1		; session reference numberAFPVersion	ds.w	1		; AFP version being used		endr		tdata		record	0fst_active	ds.w	1my_mem_id	ds.w	1		; Memory manager ID for this FSTerr_priority	ds.w	1		; see main_exit routine for detailsother_fst	ds.w	1		; see FindVolgbuf_addr	ds.l	1gsos_dp_addr	ds.w	1		; contents of D on startupSessRefnum	ds.w	1		; ASP session for this callVolID		ds.w	1		; VolID used in current callDirID		ds.l	1		; DirID used in current callVolSignature	ds.w	1		; Volume's signatureVolCRDate	ds.l	1		; Volume's create dateVolModDate	ds.l	1		; Volume's modification datedir_index	ds.w	1		; current entry for GetDirEntrycommand_ndx	ds.w	1		; index to command packetreply_ndx	ds.w	1		; index to reply packetattributes	ds.w	1		; attributes to clearattributes_hi	ds.w	1		; attributes to setmy_span		ds.w	1		; span of this pathnamemy_store_type	ds.w	1		; storage type $D = dirmy_filetype	ds.w	1		; ProDOS filetypemy_auxtype	ds.l	1		; ProDOS auxtype (long)my_access	ds.w	1		; ProDOS access wordmy_data_eof	ds.l	1		; data fork size (bytes)my_data_blks	ds.l	1		; data fork size (blocks)my_res_eof	ds.l	1		; resource fork size (bytes)my_res_blks	ds.l	1		; resource fork size (blocks)my_cr_date	ds.b	8		; create date/timemy_mod_date	ds.b	8		; modified date/timemy_date_tool	ds.b	8		; general date/time in toolbox formatmy_date_pro	ds.l	1		; general date/time in ProDOS formatmy_date_afp	ds.l	1		; general date/time in AFP formatmy_f_info	ds.b	32		; Finder infomy_parent	ds.l	1		; parent DirID from infomy_rights	ds.l	1		; access rightsmy_dirid	ds.l	1		; Dir ID from infomy_offspring	ds.w	1		; offspring count for directory (65xxx order)my_user_id	ds.l	1		; UserID from GetUserInfomy_group_id	ds.l	1		; Primary group ID from GetUserInforequest_access	ds.w	1		; request access for Openfork_number	ds.w	1		; fork number for Openmy_fork_bitmap	ds.w	1		; bitmap indicating which fork					; for SetForkParms call.cur_eof		ds.l	1		; used in Mark and EOF callsflags		ds.w	1		; call pre-processing flagsmax_pcount	ds.w	1		; used in pre-processingmy_dev_num	ds.w	1		; device number for scanningfiledir_flag	ds.w	1		; file/directory flagmy_bitmap	ds.w	1		; used to set/get file infopartial_len				; partial pathname lengthnewline_mask	ds.w	1		;   or newline mask for Readnewline_word	ds.w	1		; newline mask and char (AFP format)saved_ndx	ds.w	1		; index to start of file/dir parmslong_name	ds.b	32		; holds AFP Long name of file		ds.b	1		; for prepending ":" to GStringgstring		ds.b	36		; room for general G-Stringvolume_name	ds.b	36		; holds volume name G-Stringvolume_sep	ds.w	1		; separator after volume namepartial_path	ds.b	256		; holds partial pathname;; The following data is used for GetDefPrivileges and SetDefPrivileges (and in; Create when creating a directory).;; def_flags:;	bit 0 = setting access rights;	bit 1 = setting owner name;	bit 2 = setting group namefSetRights	equ	1fSetOwner	equ	2fSetGroup	equ	4fSetMask	equ	7		; all flags setdef_access	ds.l	1		; default access rightsdef_flags	ds.l	1def_owner	ds.b	32		; default owner name (PString)def_group	ds.b	32		; default group name (PString);; The following data is used for Change_Path and Copy_File;my_call_num	ds.w	1		; which call to makesame_vol_flag	ds.w	1		; high bit set if must be same volumesrc_srefnum	ds.w	1		; SessRefnum of source pathsrc_volid	ds.w	1		; VolID of source pathsrc_dirid	ds.l	1		; DirID of source path (parent)src_name	ds.b	32		; child name of source file;; These are the buffers for outgoing AFP commands and their replies;command_pkt	ds.b	$242		; maximum SPCommand sizereply_pkt	ds.b	$200		; enough for normal commands		endr;------------------------------------------------------------; Timer; This is the parameter list for an InstallTimer call;------------------------------------------------------------Timer		record	0cmd		ds.w	1		; async flag and commandresult		ds.w	1		; result codecompletion	ds.l	1		; completion routine address		ds.w	1		; running tick countticks		ds.w	1		; ticks to completion		ds.l	1		; reserved		endr		if 0 then;------------------------------------------------------------; SPCmd; This is the parameter list for the SPCommand call;------------------------------------------------------------SPCmd		record	0cmd		ds.w	1		; async flag and command #result		ds.w	1		; result codecompletion	ds.l	1		; completion routine addresssessrefnum	ds.b	1		; session reference numbercmdlen		ds.w	1		; command block lengthcmdaddr		ds.l	1		; command block addressrepbuflen	ds.w	1		; reply buffer lengthrepbufaddr	ds.l	1		; reply buffer addresscmdres		ds.l	1		; command resultreplen		ds.w	1		; reply length		endr		endif;------------------------------------------------------------; GetModDate; This is the AFP GetFileDirParms command block;------------------------------------------------------------GetModDate	record	0cmd		ds.w	1		; GetFileDirParms commandvolid		ds.w	1		; VolIDbitmap		ds.w	1		; bitmapsize					; size of command block		endr		;------------------------------------------------------------; Reply; This is the AFP GetFileDirParms reply;------------------------------------------------------------Reply		record	0		ds.w	1		; bitmapdate		ds.l	1		; mod date/timesize					; size of reply		endr;------------------------------------------------------------; Event; This is the parameter list returned by the volume modified; event.;------------------------------------------------------------Event		record	0devnum		ds.w	1		; device number		endr;------------------------------------------------------------; VolRec; This is the record used to detect and issue volume modified; events.  It includes the parameter list to the event proc; and some AppleTalk parameter lists.;------------------------------------------------------------volrec		record	0polltimer	ds	Timer		; polling timerlastmod		ds.l	1		; last modified date/timemodcount	ds.w	1		; number of event clientsspcmd		ds	tSPCommand	; SPCommand parameter listgetmod		ds	GetModDate	; GetFileDirParms command blockreply		ds	Reply		; GetFileDirParms replypanictimer	ds	Timer		; about to go offline timerpanicflag	ds.w	1		; high bit set if we were in panic modeevent		ds	Event		; the event parameter listsize					; size of record		endr;------------------------------------------------------------; Other equates and bitmaps used by GS/OS,; particularly on the direct page;------------------------------------------------------------max_filename	equ	31		; max length of a filenamemax_volname	equ	27		; max length of a volume namepath1_mask	equ	$4000		; indicates path1 presentpath2_mask	equ	$0040		; indicates path2 presentmy_fst_id	equ	$000D		; ID of AppleShare FSThfs_fst_id	equ	$0006		; ID of HFS FSTpro_fst_id	equ	$0001		; ID of ProDOS FSTfst_blk_size	equ	$0200		; block size (meaningless);------------------------------------------------------------; Now come a few utility macros that are used in only a few; files.  They used to reside in the file Macros.aii which; created the dump file Macros.dump.;------------------------------------------------------------;------------------------------------------------------------;; STR;; Allocates a Pascal string (length byte followed; by the characters).;; Example:;	STR	'Hello'; generates: 05 48 45 4C 4C 4F;; Note: this macro preserves the state of the; STRING pseudo-op's setting.;;------------------------------------------------------------		macro&lab		str	&parm		lclc	&strs&strs		setc	&setting('string')		string	pascal&lab		dc.b	&parm		string	&strs		endm;------------------------------------------------------------;; ATCall;; Calls AppleTalk through the RamDispatch entry point with; the parameter list given as first argument.;; Note: Destroys X,Y registers.  Error returned in A.;;------------------------------------------------------------RamDispatch	equ	$E11014RamForbid	equ	$E11018RamPermit	equ	$E1101C		macro&lab		ATCall	&addr&lab		ldx	#<&addr		ldy	#^&addr		jsl	RamDispatch		endm;............................................................;;        Push long (4 bytes) onto stack;;    pushlong address             - push contents of address;    pushlong address,x           - push contents of address,x;    pushlong const,s             - push contents of stack+const    ;    pushlong #address/const      - push address or constant;    pushlong [zeropage],offset   - push using indirect address;...............................................................		MACRO		pushlong &addr,&offset		IF &addr[1:1]='#' THEN		pea	&addr[2:255]>>16		pea	|&addr[2:255]		ELSEIF &addr[1:1]='[' THEN		ldy	#&offset+2		pushword &addr,y		ldy		#&offset		pushword &addr,y		ELSEIF &offset='s' THEN		pushword &addr+2,s		pushword &addr,s		ELSEIF &offset='' THEN		pushword  &addr+2		pushword  &addr		ELSE		pushword &addr+2,&offset		pushword &addr,&offset		ENDIF		MEND		MACRO &lab		_MMStartUp &lab		ldx	#$0202 		jsl	$E10000 		MEND 		MACRO &lab		_MMShutDown &lab		ldx	#$0302 		jsl	$E10000 		MEND 		MACRO &lab		_NewHandle &lab		ldx	#$0902 		jsl	$E10000 		MEND 		macro&lab		_FindHandle&lab		ldx	#$1A02		jsl	$E10000		mend				MACRO &lab		_DisposeHandle &lab		ldx	#$1002 		jsl	$E10000 		MEND 		macro&lab		ProcName &name		IF DebugCode THEN&lab		brl	over&sysndx		dc.w	$7771	; unique value for NiftyList		dc.b	&len(&name),'&name'over&sysndx		ENDIF		mend;------------------------------------------------------------;; Now, dump the equates and macros so that other files can; use them more easily.;;------------------------------------------------------------		dump	':obj:equates.dump'		end