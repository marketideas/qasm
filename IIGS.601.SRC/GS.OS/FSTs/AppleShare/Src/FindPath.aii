;------------------------------------------------------------;; File: FindPath.aii;; This file contains routines used to process pathnames.; FindVol will strip the volume name off and find which; device corresponds to that volume.  FindPath then creates; a DirID and partial pathname corresponding to the rest; of the pathname.  Process_path is a utility routine that; calls FindVol and then FindPath for you.;; 06-Jul-88	MSD	Volume/device identification now;			done by the id_vol.; 07-Jul-88	MSD	FindVol incorrectly determined the;			length of the volume name given.; 24-Aug-88	MSD	Added support for paths > 255 chars.; 31-Aug-88	MSD	Added code to differentiate between;			path not found and file not found.; 14-Sep-88	MSD	Removed parent finding code.  This;			will be done only on file not found;			errors.; 19-Nov-90	MSD	Fixed a bug in id_vol where it didn't;			check the fst_id field after finding;			a VCR with the same name.; 15-Mar-91	MSD	Made some more changes to FindVolume when;			supplied a pathname.  If there is a VCR;			from another FST, with open files, then;			return $52 (unknown volume type -- it's;			some other file system's).  If there were;			no open files, then scan as usual; if I;			don't find an AppleShare volume of the;			same name, then just return $52 because;			I there will still be a VCR owned by;			another FST for that volume name.; 18-Dec-91	MSD	Moved checking of the span into process_path;			after the call to FindVol, so that the error;			priority will be set correctly.  FindVol;			was modified to check the length of the volume;			name.; 21-Jan-92	MSD	The length check added 18-Dec-91 had an off-by-;			one error; it was rejecting volume names that;			were 27 characters long.  It now accepts them.;;------------------------------------------------------------		load	'equates.dump'		import	upcase:code		import	main_exit:code		import	(StartPacket,SendPacket,StartReply):code		import	(PutWord,PutPartPath,PutIDs):code		import	(GetLong,GetWord):code		import	(reopenvol,openvol):code		import	mydata:tdata		import	GetSVersion:tGetVersion				entry	get_sig:code		;; Offsets for drvr_status buffer;vol_name	equ	6		; vol name ptrdevice_status	equ	$24stat_session	equ	4		; session numberstat_vol_id	equ	$22		; volume IDstat_len	equ	$26		; size of config parametersafpn_id		equ	$001E		; device ID of .AFPn driverson_line_bit	equ	$0010		; vol on line status bitcolon		equ	$003A		; filename separator (':');------------------------------------------------------------; ID_Vol;; This routine will determine if the given device number; refers to an AppleShare volume.  If so, the SessRefnum and; VolID are set up.  Also, a VCR will be allocated for the; volume.;; On entry:;	A = device number to look at;; On exit:;	SessRefnum = session reference number;	VolID = volume ID;	my_vcr_ptr = address of new VCR;	gstring = volume name found (as a G-String);	A = error (if carry set);;------------------------------------------------------------id_vol		proc	export		with	dp,mydata		ProcName id_vol		;------------------------------------------------------------; First, get the DIB pointer so I can see if this is a; .AFPn driver I'm talking to.;------------------------------------------------------------		sta	dev_dev_id	; save this device #		stz	dev_num		; to dispatcher itself		lda	#drvr_get_dib	; I want my DIB!		sta	dev_callnum				jsl	Dev_Dispatcher	; make the call....		bcs	exit		; return any error		ldy	#dib_dev_id	; point to device ID		lda	[dev_dib_ptr],y		cmp	#afpn_id	; is it .AFPn?		bne	unknown;------------------------------------------------------------; Now that I know it is a .AFPn driver, I can do a status; call to find out what volume (if any) is mounted.;------------------------------------------------------------		lda	dev_dev_id	; get device number		sta	dev_num		; prepare to call it				lda	#drvr_status	; do a status call		sta	dev_callnum				lda	gbuf_ptr	; buffer is GBUF		sta	dev_buff		lda	gbuf_ptr+2		sta	dev_buff+2				lda	#stat_len	; get everything		sta	dev_req_cnt		stz	dev_req_cnt+2				lda	#stat_config	; get configuration		sta	dev_stat_code				jsl	Dev_Dispatcher	; go make the call		bcs	exit;------------------------------------------------------------; Make sure there is a volume mounted here.;------------------------------------------------------------		ldy	#device_status		lda	[gbuf_ptr],y	; get status word		bit	#on_line_bit	; only want online bit		bne	online		; if set, find out which vol		sec			; not there => error		lda	#offline_error		bra	exitunknown		lda	#bad_vol_type	; signal unknown volumeerror_exit		secexit		rts;------------------------------------------------------------; Copy the pertinent information to local variables;------------------------------------------------------------online		jsr	fake_read	; clears disk switched status of driver				ldy	#stat_session		lda	[gbuf_ptr],y	; get SessRefnum		and	#$00FF		; only 1 byte		sta	SessRefnum		ldy	#stat_vol_id		lda	[gbuf_ptr],y	; get VolID		sta	VolID		;------------------------------------------------------------; Turn the volume name into a Class 1 string;------------------------------------------------------------		clc		lda	gbuf_ptr	; source is at		adc	#vol_name	; GBUF + vol_name		tax			; save low word		lda	gbuf_ptr+2		adc	#0		pha			; push src address		phx				pushlong #gstring	; push dest address		jsl	cvt_0_to_1	; convert that puppy;------------------------------------------------------------; Is there a VCR for this volume?;------------------------------------------------------------		ldx	#gstring	; pointer to the volume name		ldy	#^gstring		lda	#0		; 0=search for vcr by name		jsl	find_vcr	; go find it		bcc	got_vcr		brl	no_vcr;------------------------------------------------------------; A VCR exists for this volume name.;; If (it belongs to me) and (signature and create date match);	update Sessrefnum and VolID;	exit(no error); else { it belongs to another FST or isn't the same volume };       { CheckActive };	If there are open files;		exit(duplicate volume);	else;		release VCR;		fall into no VCR case;------------------------------------------------------------got_vcr		jsl	deref		; get VCR address		stx	my_vcr_ptr	; save for later		sty	my_vcr_ptr+2;------------------------------------------------------------; See if I own this VCR.  If not, I need to check for open; files (by falling into CheckActive).;------------------------------------------------------------		ldy	#vcr.fst_id		lda	[my_vcr_ptr],y	; get owning FST ID		cmp	#my_fst_id	; is it mine?		bne	CheckActive	; no, so see if I can kill it		;------------------------------------------------------------; Do the VCR update only if the disk has been switched.;------------------------------------------------------------		ldy	#vcr.status		lda	[my_vcr_ptr],y	; get VCR's status		and	#vcr_offline	; did it go offline?		beq	go_ok_exit	; no, so don't update the VCR				jsr	get_sig		; get signature, etc.		bcs	error_exit	; return error if any				ldy	#vcr.signature		lda	[my_vcr_ptr],y		cmp	VolSignature	; same signature		bne	CheckActive	; no, not the same volume				ldy	#vcr.crdate		lda	[my_vcr_ptr],y		cmp	VolCRDate	; create date match?		bne	CheckActive	; no, not same volume		iny		iny		lda	[my_vcr_ptr],y		cmp	VolCRDate+2		bne	CheckActive;------------------------------------------------------------; It was really the same volume, so update the VCR with its; current device number and mark it online.;------------------------------------------------------------		ldy	#vcr.sessrefnum		lda	SessRefnum		sta	[my_vcr_ptr],y	; update session for VCR		sta	GetSVersion.Session				ldy	#vcr.volid		lda	VolID		sta	[my_vcr_ptr],y	; update VolID for VCR				ldy	#vcr.dev		lda	dev_num		; update last device number seen		sta	[my_vcr_ptr],y				ldy	#vcr.status		lda	[my_vcr_ptr],y		and	#Åvcr_offline	; mark VCR as online		sta	[my_vcr_ptr],y				ATCall	GetSVersion		lda	GetSVersion.AFPVersion		ldy	#vcr.version		sta	[my_vcr_ptr],y		jsr	reopenvol	; update for vol modified structurego_ok_exit	brl	ok_exitCheckActive		ldy	#vcr.open_cnt		lda	[my_vcr_ptr],y	; any open files on volume?		beq	kill_it		; no, so replace VCR with my new one				lda	#dup_vol	; duplicate volume error		sec		rtskill_it		lda	[my_vcr_ptr]	; get VCR's ID		jsl	release_vcr	; and kill it;------------------------------------------------------------; At this point, no VCR exists for the volume, so time to; create one.;------------------------------------------------------------no_vcr		jsr	get_sig		; get volume's signature, etc.		bcs	@err		; return if error				ldx	#gstring	; point to vol name		ldy	#^gstring		lda	#vcr.size	; size of my VCR		jsl	alloc_vcr	; go get me one!		bcc	did_alloc	; continue if no error@err		rts			; return errorsdid_alloc		jsl	deref		; get actual address		stx	my_vcr_ptr		sty	my_vcr_ptr+2;------------------------------------------------------------; Now, fill in all the important fields of the VCR;------------------------------------------------------------		ldy	#vcr.fst_id		lda	#my_fst_id	; I own this VCR		sta	[my_vcr_ptr],y		ldy	#vcr.dev		lda	dev_num		; remember which device		sta	[my_vcr_ptr],y		lda	#0		; zero the status		ldy	#vcr.status		sta	[my_vcr_ptr],y		ldy	#vcr.open_cnt	; and open file count		sta	[my_vcr_ptr],y				ldy	#vcr.sessrefnum		lda	SessRefnum	; update session refnum		sta	[my_vcr_ptr],y		sta	GetSVersion.Session				ldy	#vcr.volid		lda	VolID		; save volume ID		sta	[my_vcr_ptr],y		ldy	#vcr.signature		lda	VolSignature	; save volume signature		sta	[my_vcr_ptr],y				ldy	#vcr.crdate		lda	VolCRDate	; save volume create date		sta	[my_vcr_ptr],y		iny		iny		lda	VolCRDate+2		sta	[my_vcr_ptr],y				ATCall	GetSVersion		lda	GetSVersion.AFPVersion		ldy	#vcr.version		sta	[my_vcr_ptr],y	; save AFP version				jsr	openvol		; turn on volume checkingok_exit		clc			; whew, it's done!		rts;------------------------------------------------------------; Force a read of 0 bytes, on block 0, to force the device; dispatcher to clear the disk switched status.;------------------------------------------------------------fake_read		lda	#2		; driver read		sta	dev_callnum		lda	gbuf_ptr	; buffer is GBUF		sta	dev_buff		lda	gbuf_ptr+2		sta	dev_buff+2		stz	dev_req_cnt	; request count = 0		stz	dev_req_cnt+2		lda	#$200		; block size = 512		sta	dev_blk_size		stz	dev_blk_size+2		stz	dev_blk_num	; block #0		stz	dev_blk_num+2		lda	#my_fst_id		sta	dev_fst_num		stz	dev_cache_pr	; don't cache		lda	[my_vcr_ptr]	; get volume ID		sta	dev_vol_id		jsl	Dev_Dispatcher	; go make the call				and	#$00FF		; get low byte of error code		cmp	#$002E		; disk switched?		beq	fake_read	; yes, try again				rts				endwith		endp;------------------------------------------------------------; Get_Sig;; Get the volume's signature and create date so that it can; be uniquely identified (in case it goes offline with files; open and then comes back online).;------------------------------------------------------------Get_Sig		proc		with	mydata				ProcName get_sig		;------------------------------------------------------------; Determine the volume's signature, create date so I can; uniquely identify the volume.  Get its modified date, too,; for use in the volume modification scanning.;------------------------------------------------------------		lda	#afpGetVolParms		jsr	StartPacket		lda	VolID		jsr	PutWord		lda	#$0E00		; bitmap: signature, mod/cr dates		jsr	PutWord		jsr	SendPacket		bcs	exit		; return any error		jsr	StartReply		jsr	GetWord		; ignore bitmap		jsr	GetWord		; volume signature		sta	VolSignature		jsr	GetLong		; create date		sta	VolCRDate		stx	VolCRDate+2		jsr	GetLong		; mod date		sta	VolModDate		stx	VolModDate+2		clc			; no errorexit		rts				endwith		endp		;------------------------------------------------------------; MatchVol;; Given a device number in A, determine if it is an; AppleShare volume and if its name matches the name stored; in volume_name.  Uses id_vol.  Note: assumes volume_name; is uppercased.;; Exit:;	carry clear if volume found, name matches;	carry set on error;		inval_dev_num	=> unknown device number;		bad_vol_type	=> not an AppleShare device;		vol_not_found	=> AppleShare, but no name match;;------------------------------------------------------------MatchVol	proc		with	mydata				ProcName MatchVol				jsr	id_vol		; is this an AppleShare device?		bcs	exit		; no, so return the error		lda	volume_name		cmp	gstring		; are lengths equal?		bne	no_match	; no, so can't match				tay			; length in Y as index		sep	#$20		; short A for characters		longa	offloop		lda	gstring+1,y	; get a char		jsr	upcase		; turn it into upper case		cmp	volume_name+1,y	; does it match name?		bne	no_match_s	; no, so exit without a match		dey		bne	loop				rep	#$21		; clear carry, 16-bit A		longa	on		bcc	exit		; return to callerno_match_s		rep	#$20		longa	onno_match		sec			; name didn't match		lda	#vol_not_foundexit		rts				endwith			; with mydata		endp;------------------------------------------------------------; FindVol;; This routine strips the volume name off of a pathname and; sets up for FindPath to track down the file.;; On entry:;	my_dev_num = device number (if device name used);	my_path_ptr = address of pathname;	(typically:	my_dev_num  = src_dev_num;			my_path_ptr = path_1_ptr;; On exit:;	SessRefnum,VolID are set for volume given;	DirID = 2  (for volume directory);	my_path_ptr = address of pathname past volume name;	my_path_len = length of pathname past volume name;	my_dev_num = device where volume was found;	volume_sep = 0 if volume only, ":" if more path;	A = error (if carry set);; Modification History:; 17-Aug-88	MSD	Now handles device name only (when;			pathname pointer is null).;  1-Sep-88	MSD	volume_sep set to 0 if no path given.;------------------------------------------------------------FindVol		proc	export		with	dp,mydata		ProcName FindVol				stz	other_fst		; no VCR found yet		stz	volume_sep		; assume volume name only		lda	my_path_ptr		; if path pointer is null		ora	my_path_ptr+2		; then pretend path length		beq	got_path_len		; is zero		lda	[my_path_ptr]		; get real path lengthgot_path_len		sta	my_path_len		; save path length		ora	my_dev_num		; null path and no device?		beq	do_bad_path		; yep, so invalid path syntax				stz	DirID			; DirID = 2 (68000 order)		lda	#$0200		sta	DirID+2		;------------------------------------------------------------; If a device name (number) was given, then check only that; device for an AppleShare volume.;------------------------------------------------------------		lda	my_dev_num		; device given?		beq	by_name			; no, find by name				jsr	id_vol			; see if volume is ours		bcs	error;------------------------------------------------------------; A device name/number of an AppleShare volume was given so; set up the path pointer (the path length was set on entry; to FindVol).;------------------------------------------------------------		lda	#$8000			; I identified the volume		sta	err_priority		; save for OR'ing into errors				clc		lda	my_path_ptr		adc	#2			; point past length word		sta	my_path_ptr		lda	my_path_ptr+2		adc	#0		sta	my_path_ptr+2				lda	my_path_len		; volume only?		beq	ok_exit			; if volume only, exit now				lda	#colon			; separator past device name		sta	volume_sep		; means more than device givenok_exit		clcerror		rtsdo_bad_path		sec				; error exit with		lda	#invalid_path		; invalid path syntax		bcs	error			; (name was null)		;------------------------------------------------------------; If we get here, there was no device given, so we must find; the volume by name.  First try to find one of my VCRs for; the volume, else scan the devices.;------------------------------------------------------------by_name		clc		lda	my_path_ptr		; point past leading length		adc	#3			; word and colon		sta	my_path_ptr		lda	my_path_ptr+2		adc	#0		sta	my_path_ptr+2				sep	#$20			; short A for chars		longa	off				ldy	#0copy_loop		lda	[my_path_ptr],y		; get next byte		beq	save_len		; if 0, that's end of pathname		cmp	#colon			; separator after volume name?		beq	save_len		; yes, end of volume name		jsr	upcase			; convert to upper case		sta	volume_name+2,y		; store in buffer		iny; Begin 18-Dec-91 MSD		cpy	#max_volname+1		; is volume name too long?						; 21-Jan-92 MSD: Added +1 above		blt	copy_loop		; not yet, do some more		rep	#$20			; back to full native mode		bra	do_bad_path; End 18-Dec-91 MSD;		bra	copy_loop		; removed 18-Dec-91 MSDsave_len		sty	volume_name		; save length of volume name		rep	#$20			; back to full native		longa	on		and	#$00FF			; get byte only		sta	volume_sep		; save volume separator char		;------------------------------------------------------------; Here, we have an upper case version of the volume name; so try to find a VCR for it.;------------------------------------------------------------		ldx	#volume_name		ldy	#^volume_name		lda	#0			; find VCR by name		jsl	find_vcr		; call SCM to find it		bcs	scan_devs		; not found, try devices;------------------------------------------------------------; A VCR was found.  Check to see if it is a valid one for me.;------------------------------------------------------------		jsl	deref			; turn VP into pointer		stx	my_vcr_ptr		; save pointer		sty	my_vcr_ptr+2				ldy	#vcr.fst_id		lda	[my_vcr_ptr],y		; get FST's number		cmp	#my_fst_id		; is it my VCR?		beq	found_my_vcr		; yes, go update it				ldy	#vcr.open_cnt		lda	[my_vcr_ptr],y		; any open files?		bne	not_mine		; yes, so can't be mine				inc	other_fst		; I've seen a VCR		bra	scan_devs		; try to find my own volume		;------------------------------------------------------------; I created this VCR.  Copy the SessRefnum and VolID from; the VCR to my local copies.  If the volume is still online,; use this VCR.  If offline (files open), return offline error.;------------------------------------------------------------found_my_vcr		ldy	#vcr.sessrefnum		; get SessRefnum of this volume		lda	[my_vcr_ptr],y		; get VCR's copy		sta	SessRefnum		; save for use in this call				ldy	#vcr.volid		lda	[my_vcr_ptr],y		; get VolID from VCR		sta	VolID				ldy	#vcr.status		lda	[my_vcr_ptr],y		; get status of VCR		and	#vcr_offline		; is it offline?		beq	found_vol		; no, so I've got the VCR;------------------------------------------------------------; If we get here, one of the following has happened:; 1. No VCR was found; 2. A VCR was found for another FST, but with no open files; 3. A VCR was found for my FST, but there were open files and;    the disk switch bit was set.;; Try to find an AppleShare volume of the same name.  In case; 3, make sure it has the same create date and signature.;------------------------------------------------------------scan_devs		lda	#1			; start with boot devicescan_dev_loop		sta	my_dev_num		; save current dev num		jsr	matchvol		; does the name match?		bcc	found_vol		; yes, so take it and run		cmp	#inval_dev_num		; run out of volumes?		bne	scan_dev_next		; no, try another		lda	other_fst		; was there an existing VCR?		bne	not_mine		; yes, so unknown file system		lda	#vol_not_found		; return as volume not found error		sec				; force the error		brl	error			; return the errornot_mine		sec		lda	#bad_vol_type		; unknown file system		brl	error		scan_dev_next		lda	my_dev_num		ina				; go to next device number		bra	scan_dev_loop;------------------------------------------------------------; Here, the volume is found and a VCR has been created for; it.  Update the path pointer and length, set SessRefnum; and VolID.;------------------------------------------------------------found_vol		lda	#$8000			; I identified the volume		sta	err_priority		; save for OR'ing into errors				lda	volume_name		; length of volume name		ldx	volume_sep		; anything past volume name?		beq	vol_only		; no, so that's all		ina				; add 1 for trailing colonvol_only		clc		adc	my_path_ptr		; bump pointer by vol name length		sta	my_path_ptr		lda	my_path_ptr+2		adc	#0		sta	my_path_ptr+2				lda	volume_sep		; volume name only?		beq	store_len		; yes, save 0 as path length		lda	my_path_len		; get old path length		dea				; minus 1 for leading colon		dea				; minus 1 for trailing colon		sec		sbc	volume_name		; minus volume name lengthstore_len		sta	my_path_len		; is length of rest of path		brl	ok_exit			; exit with success				endwith		endp;------------------------------------------------------------; FindPath;; Finds a DirID and partial pathname for input pathnames.; If the path is too long for a P-String, then I take as; much of the name as I can, find its DirID, and repeat; (essentially traversing the pathname several directories; at a time).;; On entry:;	my_path_ptr	points to the rest of the pathname;	my_path_len	length of the rest of the pathname;	DirID		parent DirID of the rest of the path;; On exit:;	DirID		parent DirID of partial path;	my_path_ptr	points to partial path;	my_path_len	length of partial path (<256);; Note: This routine will NOT strip off the volume name.; It is generally called with DirID = 2, and my_path_ptr; pointing past the volume name or device name.;------------------------------------------------------------FindPath	proc	export		with	dp,mydata		ProcName FindPath				lda	my_path_len		and	#$FF00			; greater than 255?		beq	ok_exit			; if not, we're done.		ldy	#$FF			; look for longest possible name		sep	#$20			; 8 bit A for chars		longa	offloop		lda	[my_path_ptr],y		; get char		cmp	#colon			; is it a separator?		beq	found_it		dey				; back up one and try again		bne	loop			; always taken (since span<32)found_it		rep	#$20			; back to full native		longa	on		sty	partial_len		; save partial path length		;------------------------------------------------------------; Use GetFileDirParms to determine the DirID of the directory; given by the partial path.;------------------------------------------------------------		lda	#afpGetFlDrParms	; do a GetFileDirParms		jsr	StartPacket				jsr	PutIDs			; copy VolID, DirID in				lda	#$0001			; files: get file number		jsr	PutWord		lda	#$0001			; folders: get DirID		jsr	PutWord				jsr	PutPartPath		; put partial path in packet				jsr	SendPacket		bcs	err_exit		; return any error				jsr	StartReply		; begin processing result		jsr	GetLong			; ignore bitmaps		jsr	GetWord			; get file/dir flag		and	#$0080			; is dir bit set?		beq	not_found		; wasn't a directory!		jsr	GetLong			; get DirID		sta	DirID			; save current DirID		stx	DirID+2		;------------------------------------------------------------; Update path pointer and length to point past partial path; and trailing separator (so change by length+1).;------------------------------------------------------------		sec				; account for separator		lda	my_path_ptr		adc	partial_len		; bump path pointer		sta	my_path_ptr		lda	my_path_ptr+2		adc	#0		sta	my_path_ptr+2				clc				; account for separator		lda	my_path_len		sbc	partial_len		sta	my_path_len		;------------------------------------------------------------; Continue finding the path from where we are now.;------------------------------------------------------------		bra	FindPathok_exit		clcexit		rtsnot_found		sec		lda	#path_not_found		; expected a directory, got file		bcs	exiterr_exit		cmp	#file_not_found		; object not found?		bne	@other		lda	#path_not_found		; becomes path_not_found error@other		sec		bcs	exit		endwith				; with dp		endp;------------------------------------------------------------; Process_path;; This routine will take the given device number and pathname; and construct the SessRefnum, VolID, DirID, and partial; pathname.  It does this by calling FindVol, FindPath, and; putting the partial path into partial_path (the buffer); as a P-String.;; Alternate entry points:;; proc_path1	points to path_1 and calls process_path; proc_path2	points to path_2 and calls process_path;------------------------------------------------------------process_path	proc	export		with	dp,mydata		ProcName process_path				jsr	FindVol		bcs	exit; Begin 18-Dec-91 MSD		lda	my_span		; get max span of this path		cmp	#max_filename+1	; is it too much?		bcc	ok_span		; no, it's ok so continue		lda	#invalid_path	; bad path syntax		bra	exit		; return error (note: carry is set!)ok_span; End 18-Dec-91 MSD		jsr	FindPath		bcs	exit;------------------------------------------------------------; Now copy the partial pathname over;------------------------------------------------------------		lda	my_path_len	; get length		sta	partial_path	; save it locally		beq	ok_exit		; done if length=0				sep	#$20		; 8 bits for chars		longa	off				ldy	#0		; start copying from beginningcopy_loop		lda	[my_path_ptr],y	; copy 1 char		cmp	#colon		; is it a separator?		bne	store_char	; if not, store it away		lda	#0		; separator => nullstore_char		sta	partial_path+1,y		iny			; Y = # chars copied		cpy	my_path_len	; done yet?		bne	copy_loop				rep	#$20		; back to full native		longa	onok_exit		clc			; signal no errorsexit		rts			; go back to caller		export	proc_path1,proc_path2proc_path1; Begin 18-Dec-91 MSD		lda	span1		sta	my_span		; remember span so we can check it; End 18-Dec-91 MSD		lda	src_dev_num		sta	my_dev_num		lda	path_1_addr		sta	my_path_ptr		lda	path_1_addr+2		sta	my_path_ptr+2		bra	process_pathproc_path2; Begin 18-Dec-91 MSD		lda	span2		sta	my_span		; remember span so we can check it; End 18-Dec-91 MSD		lda	dest_dev_num		sta	my_dev_num		lda	path_2_addr		sta	my_path_ptr		lda	path_2_addr+2		sta	my_path_ptr+2		bra	process_path		endwith				; with dp		endp		end