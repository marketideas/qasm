		load	'equates.dump'		import	(out_pstr,PreProcess):code		import	(StartPacket,SendPacket):code		import	(PutWord,PutLong):code		import	id_vol:code		import	main_exit:code		import	bytes_to_blks:code		import	mydata:tdata;; Offsets for drvr_status buffer;vol_name	equ	4		; vol name ptrdevice_status	equ	$22stat_session	equ	2		; session numberstat_vol_id	equ	$20		; volume ID;; Offsets into user's parameter list;pb_volname	equ	4		; output buffer addresstotal_blocks	equ	8free_blocks	equ	12file_sys_id	equ	16		; file system IDblock_size	equ	18;; Offsets into GetVolParms packet;gv_volid	equ	2gv_bitmap	equ	4;; Offsets in reply packet;free_bytes	equ	2total_bytes	equ	6;; Other bitmaps;on_line_bits	equ	$C010		; vol on line statusget_vol_bits	equ	$C000		; get bytes free/total; Note: get_vol_bits has its bytes swapped since AFP has its; bytes in high-low order when IIGS has them in low-high order.;------------------------------------------------------------;; Volume;; This call takes a device name (number) and returns the; name of the volume in that device.  It also returns some; volume-level statistics (blocks used, blocks free, etc.);; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 27-Jun-88	MSD	Started coding.; 19-Nov-90	MSD	Fixed Volume to return the volume name when;			it returns a dup_vol error.; 26-Nov-90	MSD	Forced carry set on any non-duplicate volume;			error.;------------------------------------------------------------volume		proc	export		with	dp,mydata		ProcName volume		;------------------------------------------------------------; Process and validate call parameters.;------------------------------------------------------------		jsr	PreProcess;------------------------------------------------------------; Class 0 => pcount = 5;------------------------------------------------------------		lda	class		bne	class1pcnt				lda	#5		sta	pcountclass1pcnt		dec	pcount		; acknowledge device name;------------------------------------------------------------; Find out from driver which volume this is.;------------------------------------------------------------		lda	src_dev_num	; copy device number		jsr	id_vol		; go find the sucker		sta	my_error	; 11/19/90: remember error code		bcc	found_it		cmp	#dup_vol	; 11/19/90: duplicate volume		beq	found_it	; 11/19/90: should return volume name		sec			; 11/26/90: make sure carry is set for error!		brl	exitfound_it;------------------------------------------------------------; My_vcr_ptr now points to the VCR for this volume, and the; buffer "gstring" contains a class 1 representation of the; volume name.  SessRefnum and VolID are also properly; set up.  Time now to return the volume name to the; user's buffer.;-----------------------------------------------------------		lda	gstring		; add 1 to length for		ina			; slash or colon		ldx	class		; class 0?		beq	class0		ora	#$3A00		; colon for class 1		bra	store_lenclass0		ora	#$2F00		; slash for class 0store_len		sta	gstring		; now we have a pstring;-----------------------------------------------------------; Now set up to call Out_Pstr to send out name;-----------------------------------------------------------		lda	#gstring	; source is gstring		sta	src_ptr		lda	#^gstring		sta	src_ptr+2		ldy	#pb_volname		lda	[my_pb_ptr],y	; get buffer address		sta	dest_ptr		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2				jsr	Out_Pstr	; copy name to buffer		bcs	exit				sec			; 11/19/90: assume error		lda	my_error	; 11/19/90: duplicate volume?		bne	exit		; 11/19/90: yes, return the error now				dec	pcount		beq	done;------------------------------------------------------------; If we get here, then the user wants total_blocks.  Since I; have to make a network call anyway, I'll also find out; how many free blocks there are.;------------------------------------------------------------;------------------------------------------------------------; Start filling out GetVolParms packet;------------------------------------------------------------		lda	#afpGetVolParms	; the command number		jsr	StartPacket	; put it in packet		lda	VolID		; VolID is first		jsr	PutWord		; put in packet		lda	#get_vol_bits	; request bitmap		jsr	PutWord		; put in packet				jsr	SendPacket	; go send it		bcs	exit		; exit on any error;------------------------------------------------------------; Note: SendPacket filled in the pointer reply_buf.;; Also, the bytes free/total are in high-low order (reversed; for a 65xxx).;------------------------------------------------------------;------------------------------------------------------------; Fill in total_blocks field;------------------------------------------------------------		ldy	#total_bytes		lda	[reply_buf],y	; get high word		xba			; in X		tax		iny		iny		lda	[reply_buf],y	; low word in A		xba		jsr	bytes_to_blks	; convert value		ldy	#total_blocks	; ready to return param		sta	[my_pb_ptr],y	; save low word		iny		iny		txa			; get high word		sta	[my_pb_ptr],y	; save high word		dec	pcount		beq	done;------------------------------------------------------------; Fill in free_blocks field;------------------------------------------------------------		ldy	#free_bytes		lda	[reply_buf],y	; get high word		xba			; in X		tax		iny		iny		lda	[reply_buf],y	; low word in A		xba		jsr	bytes_to_blks	; convert value		ldy	#free_blocks	; ready to return param		sta	[my_pb_ptr],y	; save low word		iny		iny		txa			; get high word		sta	[my_pb_ptr],y	; save high word		dec	pcount		beq	done;------------------------------------------------------------; Fill in file_sys_id field;------------------------------------------------------------		lda	#my_fst_id	; get FST ID		ldy	#file_sys_id	; offset in param list		sta	[my_pb_ptr],y	; store it away		dec	pcount		; acknowledge it		beq	done;------------------------------------------------------------; Fill in block_size field;------------------------------------------------------------		lda	#fst_blk_size	; get size of blocks		ldy	#block_size	; offset in param list		sta	[my_pb_ptr],y	; put it in listdone		clc		lda	#0exit		jmp	main_exit		endwith			; with dp,mydata		endp		end