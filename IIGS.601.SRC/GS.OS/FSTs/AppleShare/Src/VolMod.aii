;------------------------------------------------------------; File: VolMod.aii;; This file contains routines used in detecting and issuing; volume modified events when a volume directory is opened; or closed.;; Modified; 24-Jan-89	MSD	¥Volume change event no longer passes the volume name.  Registers now;			contain the call and device numbers instead of a pointer to them.; 25-Jan-89	MSD	¥Now uses FPGetVolParms instead of FPGetFileDirParms of root directory.; 28-Mar-89	MSD	¥The vol mod data structure is now associated with the volume's VCR;			instead of an FCR.; 23-Aug-90	MSD	¥Reduced the PanicTime from 1 minute 20 seconds to 1 minute in the hope;			that this will reduce the likelyhood of being disconnected from servers;			due to interrupts being off a lot (the idea is that the panic timer;			should be called soon enough so that ASP has time to retry the FPGetVolParms;			call before its session timer completes).; 11-Feb-91	MSD	¥Changed OpenVol to try to allocate non-special memory for its volrec;			structure, and if that fails then it will allow for special memory.; 17-Jun-91	MSD	¥Added debugging code to write to $FD/88xx as various routines are called.; 25-Aug-92	DAL	Fixed device number parameter to the volume-changed os_event call in;			SPComplete was using a structure offset as a storage location instead of;			as an offset into the structure.; 1-Sep-92	DAL	¥Now we send volume-changed notifications even if there are no folders open;			on a volume.;			¥When calling os_event, we bank in the language card explicitly, instead;			of assuming the language card is available during a completion routine.; 2-Sep-92	DAL	¥Removed above change--no longer bank in the language card, since DoRight;			2.0d1C now does this to be like the GS.; 2-Apr-93	JCM	¥The Panic completion routine never set the data bank, but it was incrementing;			its PanicCount global. This resulted in a word in bank $E1 being trashed.; 4-May-93	JCM	¥Fixed our 10-second timer completion code to save some GS/OS DP vals around;			the call to os_event. By calling the os_event service vector, we were mucking;			with a long ptr on the DP that could be valid if we interrupted a GS/OS call.;			Hopefully the random $4x errors during heavy file read/writes should go away.;------------------------------------------------------------		load	'equates.dump'		import	go_comp:code		import	(startpacket,sendpacket):code		import	(PutIDs,PutWord):code		import	(StartReply,GetLong,GetWord):code		import	mydata:tdata		entry	(TimerComp,SPComplete,PanicComp):codeinstalltimer	equ	$0480		; async install timerremovetimer	equ	$0500		; sync remove timerspcommand	equ	$2080		; async SPCommandPanicTime	equ	4*30		; 30 secondsplist_ptr	equ	$80		; AppleTalk parameter list pointer;my_at_ptr	equ	0		; my parameter list pointer;------------------------------------------------------------; PanicCount;; This global word contains the number of sessions in danger; of being disconnected.;------------------------------------------------------------PanicCount	dc.w	0;------------------------------------------------------------; Stop_Panic;; This routine removes the panic timer for a given volume; and forces the panic flag to be clear (decrementing the; global PanicCount if the panic flag was set).;; On entry:;	src_ptr		points to volrec;------------------------------------------------------------stop_panic	proc		with	dp,mydata				ProcName stop_panic;------------------------------------------------------------; Remove the panic timer, since we're not in trouble;------------------------------------------------------------		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD8802		; signal stop_panic(devnum)		ENDIF				ldy	#volrec.panictimer		lda	#removetimer		; change to removetimer		sta	[src_ptr],y		; save RemoveTimer command		clc		lda	src_ptr		adc	#<volrec.panictimer	; point X,Y to PanicTimer		tax		lda	src_ptr+2		adc	#^volrec.panictimer		tay		jsl	RamDispatch		; remove the timer;------------------------------------------------------------; If we were in panic mode, clear it, and decrement panic; count;------------------------------------------------------------		entry	clear_panicclear_panic		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD8800		; signal clear_panic(devnum)		ENDIF				ldy	#volrec.panicflag		lda	[src_ptr],y		; panic?		beq	no_panic		lda	#0			; no longer in panic mode		sta	[src_ptr],y		dec	PanicCount		; one less to worry about				IF DebugCode THEN		lda	PanicCount		sta	>$FD881E		ENDIFno_panic		rts				endwith		endp		;------------------------------------------------------------; StopTimers;; This routine will stop the timers associated with the; volrec pointed to by src_ptr.  It also makes sure the; SPCommand has completed.  After this, the volrec may; be freely removed.;------------------------------------------------------------StopTimers	proc	export		with	dp,mydata		ProcName StopTimers				jsl	RamForbid		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD8804		; signal StopTimers(devnum)		ENDIF				ldy	#volrec.panictimer		lda	#removetimer		sta	[src_ptr],y		; change to remove timer		clc		lda	src_ptr		adc	#<volrec.panictimer		tax		lda	src_ptr+2		adc	#^volrec.panictimer		tay		jsl	RamDisPatch				lda	#removetimer		sta	[src_ptr]		; save remove timer command		ldx	src_ptr			; get command address		ldy	src_ptr+2		jsl	RamDispatch		; remove the timer				jsl	RamPermitwait		ldy	#volrec.spcmd.result		lda	[src_ptr],y		; get ASP's result		and	#$00FF			; get low byte		cmp	#$00FF			; still pending?		beq	wait			; if so, wait 'til it's done				jsr	clear_panic		; reset panic flag for volume				rts				endp		;------------------------------------------------------------; StartTimers;; This routine will start the timers associated with the; volrec pointed to by src_ptr.  Note: the timers must; already be stopped (or not yet started).  It is suitable; for use in OpenVol and ReOpenVol.;------------------------------------------------------------StartTimers	proc	export		with	dp,mydata		ProcName StartTimers				jsl	RamForbid		; don't want these to complete yet		;------------------------------------------------------------; start the polling timer going;------------------------------------------------------------		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD8806		; signal StartTimers(devnum)		ENDIF				lda	#4*10			; 10 seconds		ldy	#volrec.polltimer.ticks	; is polling interval		sta	[src_ptr],y				lda	#installtimer		; async install timer		sta	[src_ptr]		; put command in				ldx	src_ptr			; timer parameter list, low		ldy	src_ptr+2		; timer parameter list, high		jsl	RamDispatch		;------------------------------------------------------------; start the panic timer going;------------------------------------------------------------		lda	#PanicTime		; time until panic		ldy	#volrec.panictimer.ticks		sta	[src_ptr],y				lda	#installtimer		; async install timer		ldy	#volrec.panictimer		sta	[src_ptr],y		; put command in				clc		lda	src_ptr		adc	#<volrec.panictimer		tax				; low address of panic timer		lda	src_ptr+2		adc	#^volrec.panictimer		tay				; high address of panic timer		jsl	RamDispatch				jsl	RamPermit		; let 'em rip!		rts				endp		;------------------------------------------------------------; OpenVol;; This routine sets up the data structures to detect volume; modified events, and then to issue them.  It is assumed to; be called after a VCR has been allocated, and called only; once per volume.;; On entry:;	my_vcr_ptr	points to VCR for volume to set up;	VolModDate	last modified date of volume;	SessRefnum	Session reference number for volume;	VolID		Volume identifier for volume;------------------------------------------------------------openvol		proc	export		with	dp,mydata		ProcName openvol				pha		pha				; long space for result		pea	volrec.size>>16		; size of block to create		pea	volrec.size		lda	my_mem_id		pha		pea	$C008			; locked, fixed, no special memory		pea	0			; don't care where it starts		pea	0		_NewHandle		plx		stx	src_ptr			; save handle		plx		stx	src_ptr+2		bcc	got_handle		; if we got it, set it up								; Now lets try special memory		pha		pha				; long space for result		pea	volrec.size>>16		; size of block to create		pea	volrec.size		lda	my_mem_id		pha		pea	$C000			; locked, fixed		pea	0			; don't care where it starts		pea	0		_NewHandle		plx		stx	src_ptr			; save handle		plx		stx	src_ptr+2		bcc	got_handle		brl	abort			; don't do it if errorgot_handle		ldy	#2		lda	[src_ptr],y		; deref handle		tax				; high word in X		lda	[src_ptr]		; low word in A		ldy	#vcr.modptr		sta	src_ptr			; save in src_ptr		sta	[my_vcr_ptr],y		; and in VCR		iny		iny		txa				; get high word		sta	[my_vcr_ptr],y		sta	src_ptr+2		lda	#0		ldy	#volrec.modcount		sta	[src_ptr],y		; no clients so far		ldy	#volrec.panicflag		sta	[src_ptr],y		; no volumes in trouble		;------------------------------------------------------------; Copy sessrefnum, dirid, volid, last mod date, etc. to record;------------------------------------------------------------		ldy	#volrec.lastmod		lda	VolModDate		; get volume's last mod date		sta	[src_ptr],y		; save off mod date/time		iny		iny		lda	VolModDate+2		; get second word		sta	[src_ptr],y				ldy	#volrec.spcmd.sref		lda	SessRefnum		sta	[src_ptr],y		; save session refnum		ldy	#volrec.getmod.volid		lda	VolID		sta	[src_ptr],y		; save VolID				ldy	#volrec.spcmd.cmd		lda	#SPCommand		sta	[src_ptr],y		; set up async SPCommand				iny		iny				; Y = volrec.spcmd.result		lda	#0			; zero result word		sta	[src_ptr],y		; zero SPCommand's result				ldy	#volrec.spcmd.comlen		lda	#GetModDate.size		sta	[src_ptr],y		; save command block length		iny		iny				; Y = volrec.spcmd.cmdaddr		clc		lda	src_ptr		adc	#volrec.getmod		; create address of command block		sta	[src_ptr],y		iny		iny		lda	src_ptr+2		adc	#0		sta	[src_ptr],y		iny		iny				; Y = volrec.spcmd.repbuflen		lda	#Reply.size		sta	[src_ptr],y		; save reply size		iny		iny				; Y = volrec.spcmd.repbufaddr		clc		lda	src_ptr		adc	#volrec.reply		; get address of reply buffer		sta	[src_ptr],y		iny		iny		lda	src_ptr+2		adc	#0		sta	[src_ptr],y				ldy	#volrec.getmod.cmd		lda	#afpGetVolParms		sta	[src_ptr],y		; put GetVolParms in packet				ldy	#volrec.getmod.bitmap		lda	#$0800			; mod date only		sta	[src_ptr],y		; is file bitmap		;------------------------------------------------------------; copy event parameter list to record;------------------------------------------------------------		ldy	#vcr.dev		lda	[my_vcr_ptr],y		; get device number		ldy	#volrec.event.devnum		sta	[src_ptr],y		; save device number				IF DebugCode THEN		sta	>$FD8808		; signal OpenVol(devnum)		ENDIF		;------------------------------------------------------------; copy completion routine addresses to record;------------------------------------------------------------		ldy	#volrec.polltimer.completion		lda	#<TimerComp		sta	[src_ptr],y		iny		iny		lda	#^TimerComp		sta	[src_ptr],y				ldy	#volrec.panictimer.completion		lda	#<PanicComp		sta	[src_ptr],y		iny		iny		lda	#^PanicComp		sta	[src_ptr],y				ldy	#volrec.spcmd.completion		lda	#<SPComplete		sta	[src_ptr],y		iny		iny		lda	#^SPComplete		sta	[src_ptr],y		;------------------------------------------------------------; Start the polling and panic timers going;------------------------------------------------------------		jsr	StartTimersabort		rts		endwith				; with dp,mydata		endp;------------------------------------------------------------; ReOpenVol;; This routine updates the SessRefnum and VolID for the given; volume's vol mod structure.;; On entry:;	my_vcr_ptr	points to VCR for volume to set up;	SessRefnum	Session reference number for volume;	VolID		Volume identifier for volume;------------------------------------------------------------reopenvol	proc	export		with	dp,mydata		ProcName reopenvol				ldy	#vcr.modptr		lda	[my_vcr_ptr],y		; get volume modified record		sta	src_ptr		iny		iny		lda	[my_vcr_ptr],y		sta	src_ptr+2		ora	src_ptr			; is it null?		beq	done			; if so, don't update		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD880A		; signal ReOpenVol(devnum)		ENDIF				jsr	StopTimers		; stop timing stuff				ldy	#volrec.spcmd.sref		lda	SessRefnum		sep	#$20			; short A to store a byte		longa	off		sta	[src_ptr],y		; save session refnum (byte)		rep	#$20		longa	on				ldy	#volrec.getmod.volid		lda	VolID		sta	[src_ptr],y		; save VolID		ldy	#vcr.dev		lda	[my_vcr_ptr],y		; get device number		ldy	#volrec.event.devnum		sta	[src_ptr],y		; update for events				jsr	StartTimersdone		rts				endp				;------------------------------------------------------------; CloseVol;; This routine removes all data structures created by OpenVol; and stops all related AppleTalk calls.;; On entry:;	vcr_addr	pointer to volume to shut down;------------------------------------------------------------closevol	proc	export		with	dp		ProcName closevol				pei	src_ptr+2		; will use src_ptr to point to		pei	src_ptr			; volmod record				ldy	#vcr.modptr		lda	[vcr_addr],y		; get volume modified record		sta	src_ptr			; save low word in src_ptr		iny		iny		lda	[vcr_addr],y		sta	src_ptr+2		ora	src_ptr			; is it null?		beq	done			; if so, don't remove		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD880C		; signal CloseVol(devnum)		ENDIF				jsr	StopTimers		; make sure timers are done				pha				; push long space for result		pha		pei	src_ptr+2		; push address of volrec		pei	src_ptr		_FindHandle			; get the handle		_DisposeHandle			; free up the memory		done		pla		sta	src_ptr			; restore src_ptr		pla		sta	src_ptr+2		rts		endwith				; with dp,mydata		endp		;------------------------------------------------------------; AddClient;; This routine increments the modcount field.  When the field; is non-zero, events will be generated.;; On entry:;	my_vcr_ptr	pointer to volume to shut down;------------------------------------------------------------addclient	proc	export		with	dp		ProcName addclient				ldy	#vcr.modptr		lda	[my_vcr_ptr],y		; create pointer to volrec		sta	src_ptr		iny		iny		lda	[my_vcr_ptr],y		sta	src_ptr+2				IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD880E		; signal AddClient(devnum)		ENDIF				ldy	#volrec.modcount		lda	[src_ptr],y		ina				; add 1 to client count		sta	[src_ptr],y		rts				; return to caller		endp		;------------------------------------------------------------; DelClient;; This routine decrements the modcount field.  When the field; is non-zero, events will be generated.;; On entry:;	my_vcr_ptr	pointer to volume to shut down;------------------------------------------------------------delclient	proc	export		with	dp		ProcName delclient				ldy	#vcr.modptr		lda	[my_vcr_ptr],y		; create pointer to volrec		sta	src_ptr		iny		iny		lda	[my_vcr_ptr],y		sta	src_ptr+2				IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD8810		; signal DelClient(devnum)		ENDIF				ldy	#volrec.modcount		lda	[src_ptr],y		dea				; subtract 1 from client count		sta	[src_ptr],y				rts				; return to caller		endp		;------------------------------------------------------------; TimerComp;; This is the completion routine for the timers;------------------------------------------------------------TimerComp	proc	export		with	dp,mydata		ProcName TimerComp				ldy	#timer.result		lda	[plist_ptr],y		; was there an error (cancelled)?		bne	done			; yes, so just exit				IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[plist_ptr],y		; get device number		sta	>$FD8812		; signal TimerComp(devnum), no error		ENDIF				clc		lda	<plist_ptr		adc	#volrec.spcmd		; get address of SPCommand		tax				; parameter list in X,Y		lda	<plist_ptr+2		adc	#0		tay		jsl	RamDisPatch		; queue up the SPCommanddone		jmp	go_comp			; go to completion routine exit				endwith				; with dp,mydata		endp		;------------------------------------------------------------; PanicComp;; The panic timer completed.  Set the panic flag for this; volume and increment the global panic count.;------------------------------------------------------------PanicComp	proc	export		with	dp,mydata		ProcName PanicComp		*** Whoops! - 2-Apr-93 JCM - When we get control, the data bank will be set to $E1.***			     INCing a global that's in our bank is kinda' difficult if***			     you don't at least set the data bank reg.		phb				phk		plb*** End - 2-Apr-93 JCM		IF DebugCode THEN		ldy	#volrec.event.devnum-volrec.panictimer		lda	[<plist_ptr],y		; get device number		sta	>$FD8814		; signal PanicComp(devnum)		ENDIF				ldy	#volrec.panicflag-volrec.panictimer		lda	#$FFFF			; we be in panic		sta	[<plist_ptr],y		; save panic flag				inc	PanicCount		; bump global panic count				IF DebugCode THEN		lda	PanicCount		sta	>$FD881E		ENDIFdone		plb				;2-Apr-93 JCM - restore bank to $E1		jmp	go_comp			; go to completion routine exit				endwith				; with dp,mydata		endp		;------------------------------------------------------------; SPComplete;; This is the completion routine for the SPCommand;------------------------------------------------------------SPComplete	proc	export		with	dp,mydata		ProcName SPComplete				phb				; save caller's bank		phk		plb				; get my bank				pei	src_ptr			; save off pointer		pei	src_ptr+2				sec		lda	<plist_ptr		sbc	#volrec.spcmd		; get address of volrec		sta	src_ptr			; into src_ptr		lda	<plist_ptr+2		sbc	#0		sta	src_ptr+2				ldy	#volrec.spcmd.result		lda	[src_ptr],y		; did the call complete OK?		beq	ok			; yes, so process results		cmp	#$0702			; too many ASP calls?		bne	dont_install		; no, so stop checking		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD8818		; signal SPComplete(devnum), too many ASP calls		ENDIF				lda	#1			; try again 1/4 second later		brl	re_install		; and re-install timerdont_install		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD881A		; signal SPComplete(devnum), other error		ENDIF				jsr	stop_panic		; don't panic any more		brl	done			; exit completion routineok		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD8816		; signal SPComplete(devnum), no error		ENDIF				jsr	stop_panic		; don't panic now				ldx	#0			; assume no change		ldy	#volrec.reply.date		lda	[src_ptr],y		; get latest mod date/time		ldy	#volrec.lastmod		cmp	[src_ptr],y		; changed?		beq	@equal1		inx				; remember that it changed@equal1		sta	[src_ptr],y		; save new date		ldy	#volrec.reply.date+2		lda	[src_ptr],y		; check second word		ldy	#volrec.lastmod+2		cmp	[src_ptr],y		; changed?		beq	@equal2		inx@equal2		sta	[src_ptr],y		; save new date		cpx	#0			; did either word change?		beq	same			; no, so don't do event; The mod date/time has changed, so issue the eventchanged		IF DebugCode THEN		ldy	#volrec.event.devnum		lda	[src_ptr],y		; get device number		sta	>$FD881C		; signal SPComplete(devnum), mod date changed		ENDIF				phd				; save my direct page*** Removed check 1-Sep-92 DAL -- Send Volume Changed even if no folders are open	;		ldy	#volrec.modcount;		lda	[src_ptr],y		; any clients?;		beq	@skip			; no, so don't do event*** end 1-Sep-92;*** added 1-Sep-92 DAL -- force language card in, since DoRight does not set that up!;		sep #$20;		longa off;		lda >$e0c068;		pha;		lda >$e0c08b			; give us access to the $01FCxx GS/OS services;		lda >$e0c08b;		rep #$20;		longa on;*** end 1-Sep-92*** Added - 4-May-93 JCM - Since we're in an interrupt that could have happened during a GS/OS call,***			   we can't modify the GS/OS DP, but os_event does just that. We'll save off***			   the vals it modifies and restore them afterward. This should fix the random***			   $40, $44, $45, and $46 errors I've seen during file copies.link_pointer	equ	$D4			;GS/OS DP equate defined in os_event		ldx	gsos_dp_addr		lda	>link_pointer+2,x		pha		lda	>link_pointer,x		pha*** End - 4-May-93 JCM*** fixed 25-Aug-92 DAL		pea	0			; don't have a call number (to be passed in A)		ldy	#volrec.event.devnum	; get the device number		lda	[src_ptr],y*** end 25-Aug-92		pha				; to be passed in X		pha				; undefined: passed in Y				lda	gsos_dp_addr		tcd				; restore GS/OS direct page				lda	#<volmod_event		; get event code in A,X		ldx	#^volmod_event		jsl	os_event		; signal the event*** Added - 4-May-93 JCM - See above fix for details.		pla		sta	<link_pointer		pla		sta	<link_pointer+2*** End - 4-May-93 JCM;*** added 1-Sep-92 DAL -- restore language card status;		sep #$20;		pla;		sta >$e0c068;		rep #$20;*** end 1-Sep-92@skip		pld				; restore caller's dp; Re-install the timerssame		lda	[src_ptr]		; get polling timer		cmp	#installtimer		; has it been removed?		bne	done			; yes, so don't install timers		lda	#PanicTime		ldy	#volrec.panictimer.ticks		sta	[src_ptr],y		; length of panic				lda	#installtimer		ldy	#volrec.panictimer		sta	[src_ptr],y		; InstallTimer command				clc		lda	src_ptr		adc	#<volrec.panictimer	; point X,Y to PanicTimer		tax		lda	src_ptr+2		adc	#^volrec.panictimer		tay		jsl	RamDispatch		; remove the timer		lda	#4*10			; 10 secondsre_install					; pass 1/4 seconds in A		ldy	#volrec.polltimer.ticks		sta	[src_ptr],y		; save as new tick count				lda	[src_ptr]		; get command		cmp	#installtimer		; has it been removed?		bne	done			; yes, so don't install again				ldx	src_ptr			; get parameter list address		ldy	src_ptr+2		jsl	RamDispatch		; queue up timerdone		pla		sta	src_ptr+2		pla		sta	src_ptr			; restore pointer		plb				; restore bank				jmp	go_comp			; go to completion routine exit		endwith				; with dp,mydata		endp		;------------------------------------------------------------; QtrHandler;; This is the routine called by the AppleTalk 1/4 second; interrupt handler routine (on exit).  I'll check my; panic counter, and I'll wait until it is non-zero before; I allow control to return.;------------------------------------------------------------QtrHandler	proc	export		with	dp,mydataBorderColor	equ	$E1C034		ProcName QtrHandler		phb				; save bank		pha				; and save A				phk		plb				; set to my bank		;------------------------------------------------------------; Don't allow this code to be re-entered.;------------------------------------------------------------		lda	#$8000		tsb	qtractive		; am I active?		bne	busy			; yes, just exit now;------------------------------------------------------------; Wait until no volumes are in trouble;------------------------------------------------------------		lda	PanicCount		beq	exit		IF	DebugCode THEN		sep	#$20		longa	off		lda	>BorderColor		eor	#$000F		sta	>BorderColor				rep	#$20		longa	on		ENDIF		loop		lda	PanicCount		bne	loop		IF	DebugCode THEN		sep	#$20		longa	off		lda	>BorderColor		eor	#$000F		sta	>BorderColor		rep	#$20		longa	on		ENDIF		exit		lda	#$8000		trb	qtractive		; no longer activebusy				pla				; restore state on entry		plb				; and caller's bank		rtl				; return to callerqtractive	dc.w	0		endp				end