;------------------------------------------------------------;; JudgeName;; Evaluates the syntax of a filename, including correcting it; and returning a string for the user.;; Uses:;	my_path_len	Maximum length of kind of name;	my_path_ptr	Points to file name to check;	my_store_type	Kind of name (fileKind);	my_bitmap	Flags indicating kind of error;;; 06-Feb-91	MSD	Fixed check for buffer too small.  If;			the size was less than 4 bytes, it;			wasn't returning an error.;; 07-Jan-92	MSD	Now returns error $53 (invalid parm);			for fileKind > 3.  Fixed an unreported bug;			where passing a name buffer less than 4 bytes;			would return carry clear and the length-4;			as the error code.;; 25-Mar-92	DAL	for 6.1.  Changed JudgeName message to read;			"Disk names may..." instead of "Volume names;			may....";;------------------------------------------------------------		load	'equates.dump'				import	(PreProcess,main_exit):code		import	mydata:tdata;------------------------------------------------------------; Definition of parameter list for JudgeName call;------------------------------------------------------------p		record	0fileSysID	ds.w	1	; requested file system's syntaxfileKind	ds.w	1	; 0 = unknown				; 1 = volume name				; 2 = directory name				; 3 = file namesyntax		ds.l	1	; returned string of syntax rulesmaxLen		ds.w	1	; maximum length of kind of namename		ds.l	1	; result buffer where name isflags		ds.w	1	; bit 15 = contained invalid characters				; bit 14 = was too long				; bit 13 = syntax error		endrJudgeName	proc	export		with	dp,mydata		kInvalChars	equ	$8000kTooLong	equ	$4000kSyntax		equ	$2000kVolume		equ	1kDirectory	equ	2kFile		equ	3kMaxFileKind	equ	3leftLen		equ	math_temp	; how many chars on left to keeprightLen	equ	math_temp+2	; how many chars on right to keep		ProcName JudgeName		jsr	PreProcess	; make sure call is valid		dec	pcount		; skip fileSysID		dec	pcount		; skip fileKind;; Get a local copy of the requested name kind;		ldy	#p.fileKind		lda	[my_pb_ptr],y	; get kind of name		sta	my_store_type	; save for later		cmp	#kMaxFileKind+1	; bigger than anything I know about?		blt	@ok		; no, it's OK		lda	#invalid_parm		bra	go_err		; return the error@ok;; Always return a pointer to the syntax rules (PString).;		iny		iny			; y = p.kSyntax		lda	#<Syntax		sta	[my_pb_ptr],y		iny		iny		lda	#^Syntax		sta	[my_pb_ptr],y;; Any processing to do?;		dec	pcount		; was syntax string last parameter?		beq	go_done		; yes, so exit now;; Return the maximum length for requested name type;		lda	#31		; assume file or folder		dec	my_store_type	; was it 1 (volume name)		bne	got_max		; no, so use 31 as max		lda	#27		; volume max length is 27got_max		ldy	#p.maxLen		sta	[my_pb_ptr],y	; put max length in pb		sta	my_path_len	; and save for code below		dec	pcount		; is that all?		bne	check_name	; no, so scan the namego_done		brl	done;; A pathname was supplied.  Check and fix it.;check_name		stz	my_bitmap	; assume no errors				iny		iny			; Y = p.name		lda	[my_pb_ptr],y	; get pointer to name in local var		sta	my_path_ptr		iny		iny		lda	[my_pb_ptr],y		sta	my_path_ptr+2		;; First, make sure result buffer is big enough to hold maximal name;		lda	[my_path_ptr]	; get buffer size		sec		sbc	#4		; subtract two length words		blt	size_err	; not even that big -- error!		cmp	my_path_len	; room for maximum length?		bge	size_ok		; yes, no errorsize_err	lda	#buffer_small	; buffer too small errorgo_err		sec			; indicate error		brl	exit		; return from call nowsize_ok;; Change my_path_ptr to point to length word of name;		clc		lda	my_path_ptr		adc	#2		sta	my_path_ptr		lda	my_path_ptr+2		adc	#0		sta	my_path_ptr+2		;; If name was empty string, set it to "A" and indicate syntax error;		lda	[my_path_ptr]	; non-empty name?		bne	got_name	; yep, so check it				lda	#1		; length of "A"		sta	[my_path_ptr]	; update string length		ldy	#2		; point to string text		lda	#'A'		sta	[my_path_ptr],y	; name = "A"		lda	#kSyntax		tsb	my_bitmap	; indicate syntax error		bra	flag_exit	; exit and return flag;; Here, we have a real name.  Convert illegal characters (nulls and colons); to periods.;got_name		inc	a			;adjust for extra length byte		tay		ldx	#0			;init to 0				longa	off			;set 8 bit A		sep	#$20loop1		lda	[my_path_ptr],y		;get byte		beq	@bad_char		;branch if it's a nul		cmp	#':'			;is it a colon?		bne	@ok			;no@bad_char	lda	#'.'			;it's an illegal character so		sta	[my_path_ptr],y		;replace it with a period		ldx	#$8000			;indicate illegal character found@ok		dey				;decrement offset		cpy	#1		bne	loop1			;loop until done		longa	on			;set 16 bit A		rep	#$20				txa				;set bit 15 if an illegal		tsb	my_bitmap		;character was found;; Check if the name is too long; if so:; For filenames - keep the first 15 chars, insert '..', keep the last 14 chars; For volume names - keep first 13 chars, insert '..', leep last 12 chars;		lda	[my_path_ptr]		; get length		dea				; length-1 is easier to compare with		cmp	my_path_len		; is it short enough?		blt	flag_exit		; yes, so done and return flags		lda	my_path_len		;max_len = 31 or 27		lsr	a		sta	<leftLen		;leftLen <- 15 or 13		inc	a		inc	a		tay				;Y <- 17 or 15		lda	#'..'					sta	[my_path_ptr],y		;insert the '..'				iny				;adjust Y past the '..'		iny		phy				;and save		dec	<leftLen		;leftLen <- 14 or 12		lda	[my_path_ptr]		;get length of name		inc	a			;add 2 because of length word		inc	a		sta	<rightLen		;and save for later		sec		sbc	<leftLen		;subtract 14 or 12 to get offset		tax				;to last part of name to keep				longa	off			;set 8 bit A		sep	#$20loop2		txy				;move the last 12 or 14 chars 		lda	[my_path_ptr],y		;so they are after the '..'		ply		sta	[my_path_ptr],y		iny		phy		inx		cpx	<rightLen		;are we done?		bcc	loop2			;no - so loop		ply				;clean up stack				longa	on			;set 16 bit A		rep	#$20				lda	my_path_len		;adjust the name length		sta	[my_path_ptr]				lda	#kTooLong		;set bit 14 to indicate		tsb	my_bitmap		;name was too long;; Here, we're done processing the name.  If they wanted the error flags,; then return them.  Then just exit with no error.;flag_exit		dec	pcount		; did name, anything else?		beq	done		; no, so exit now				ldy	#p.flags		lda	my_bitmap	; get returned error flags		sta	[my_pb_ptr],y	; put flags back in pb		done		clc		lda	#0exit		jmp	main_exitSyntax		dc.b	synEnd-synStartsynStart	DC.B	'AppleShare names may contain any character except a colon (:). '		DC.B	'Disk names may be up to 27 characters long. '		DC.B	'File and folder names may be up to 31 characters long.'synEnd		endwith		endp		end