;------------------------------------------------------------;; File: subs.aii;; This file contains subroutines common to several; calls.;; Written 2-May-88 by Mark Day;; 06-Jul-88	MSD	Removed pathname processing from;			PreProcess.  Process_path should;			be called to do this as needed.; 07-Jul-88	MSD	Added an "active" flag for debugging;			purposes.  Some state information saved.; 11-Jul-88	MSD	PreProcess was setting pcount to the maximum;			for class 1 calls, instead of user's pcount.; 12-Jul-88	MSD	Contrary to Inside AppleTalk, the maximum;			span is 31, not 32.  Fixed PreProcess.;  1-Aug-88	MSD	Get_Dir_Entry has two more parameters:;			Resource_EOF, Resource_Blocks_Used.; 31-Aug-88	MSD	Don't require read enable bit set when;			converting ProDOS to AFP access.; 14-Sep-88	MSD	Added routine CheckParent that will;			search for a file's parent on a file;			not found error.;  3-Jan-89	MSD	CheckParent now makes sure the parent;			is a folder (if it is a file, return;			a path not found error).; 30-Nov-90	MSD	Incorporated the 5.0.4 fix to MyShield so;			that I save and restore the locations on;			QuickDraw's direct page that I use while;			shielding the cursor before drawing or;			erasing the arrows in the menu bar.; 05-Feb-91	MSD	Changed PreProcFlags for command $07;			(now JudgeName).; 21-Jan-93	DAL	Changed draw_arrows and erase_arrows to;			distinguish LocalTalk from Ethernet, and;			to undraw the arrows on SHR even if a screen;			dimmer kicked in.;------------------------------------------------------------		load	'equates.dump'		import	mydata:tdata		entry	main_exit:code;------------------------------------------------------------; Convert_access;; This routine takes a ProDOS access word and turns it into; the equivalent AFP bitmaps for clearing and setting file; and directory attributes.  The variable "attributes" has; a one word bitmap of attributes that must be cleared,; followed by a bitmap of attributes that must be set.;; The backup needed bit will automatically be set.  The; access word will be checked for validity (all unused bits; must be zero, and the read enable bit must be set).  If; not, an invalid parameter error will be returned.;; On entry:;	full native mode;	my_access = ProDOS access word;; On exit:;	full native mode;	attributes = clear bitmap for SetFileDirParms;	attributes+2 = set bitmap for SetFileDirParms;	c = 1 => error, A = error code;;; The ProDOS access word looks like this:;; 111111; 5432109876543210	<- bit position; ........DNB..IWR 	<- flag;; where D = destroy enabled;	N = rename enabled;	B = backup needed;	I = invisible;	W = write enabled;	R = read enabled  (ignored, assumed to be set);; The AFP attributes word looks like this:;; 111111; 5432109876543210	<- bit position; *....C.DNBWrdSMI	<- flag;; where * = set / clear;	C = copy protected;	D = delete inhibit;	N = rename inhibit;	B = backup needed;	W = write inhibit;	r = resource fork already open (GetFileDirParms);	d = data fork already open (GetFileDirParms);	S = system (for MS-DOS);	M = multi-user;	I = invisible;------------------------------------------------------------convert_access	proc	export		with	dp,mydata; Note: the following bitmaps are in AFP high-low byte orderingattr_d		equ	$0001		; bit mask of D attributeattr_n		equ	$8000		; bit mask of N attributeattr_b		equ	$4000		; bit mask of B attributeattr_w		equ	$2000		; bit mask of W attributeattr_i		equ	$0100		; bit mask of I attribute		ProcName convert_access		;------------------------------------------------------------; First, validate the access word.;------------------------------------------------------------		lda	my_access	; get access word		bit	#$FF18		; any reserved bits set?		beq	ok_access	; if not, then it's OKinvalid		sec			; indicate an error		lda	#invalid_parm	; access word is invalid parameter		rts			; return right nowok_access		ora	#$20		; force backup bit set		sta	my_access;------------------------------------------------------------; Next thing to do is invert the meaning of the enable; flags so that they become inhibit flags.;------------------------------------------------------------		eor	#%11000010	; remember, A = access		sta	math_temp	; save for easy manipulation		pha			; save again to restore later;------------------------------------------------------------; Now find all the flags that I have to clear;------------------------------------------------------------		lda	#0		; start with nothing to clear					; math_temp         carry		lsr	math_temp	; .........DNB..IW  R		lsr	math_temp	; ..........DNB..I  W		bcs	clr_w		ora	#attr_wclr_w		lsr	math_temp	; ...........DNB..  I		bcs	clr_i		ora	#attr_iclr_i		lsr	math_temp	; ............DNB.  .		lsr	math_temp	; .............DNB  .		lsr	math_temp	; ..............DN  B		bcs	clr_b		ora	#attr_bclr_b		lsr	math_temp	; ...............D  N		bcs	clr_n		ora	#attr_nclr_n		lsr	math_temp	; ................  D		bcs	clr_d		ora	#attr_dclr_d		sta	attributes;; Now find all the flags I have to set;		pla			; recover access word		sta	math_temp	; easy to manipulate		lda	#$0000		; start with nothing to set					; math_temp         carry		lsr	math_temp	; .........DNB..IW  R		lsr	math_temp	; ..........DNB..I  W		bcc	set_w		ora	#attr_wset_w		lsr	math_temp	; ...........DNB..  I		bcc	set_i		ora	#attr_iset_i		lsr	math_temp	; ............DNB.  .		lsr	math_temp	; .............DNB  .		lsr	math_temp	; ..............DN  B		bcc	set_b		ora	#attr_bset_b		lsr	math_temp	; ...............D  N		bcc	set_n		ora	#attr_nset_n		lsr	math_temp	; ................  D		bcc	set_d		ora	#attr_dset_d		sta	attributes+2	; save "set" attributes		clc			; signal no errors		rts		endwith		endp;------------------------------------------------------------; Convert_attr;; This routine takes an AFP attributes word and turns it; into the equivalent ProDOS access word.  Bits will be; shifted into my_access as they are determined.;; On entry:;	A = AFP attributes word;; On exit:;	my_access = ProDOS access word;	attributes = AFP attributes word;; See convert_access for description of bitmaps.;------------------------------------------------------------convert_attr	proc	export		with	mydataattr_d		equ	$0001		; bit mask of D attributeattr_n		equ	$8000		; bit mask of N attributeattr_b		equ	$4000		; bit mask of B attributeattr_w		equ	$2000		; bit mask of W attributeattr_i		equ	$0100		; bit mask of I attribute		ProcName convert_attr				sta	attributes	; save attribute parameter		stz	my_access	; assume no access		clc		lda	#attr_d		bit	attributes	; is delete inhibit set?		bne	set_d		sec			; no, so delete enableset_d		rol	my_access	; shift D bit in					; Note: carry is clear!		lda	#attr_n		bit	attributes	; rename inhibit?		bne	set_n		sec			; no, enable renameset_n		rol	my_access				lda	#attr_b		bit	attributes	; backup needed?		beq	set_b		sec			; yes, so needed for ProDOSset_b		rol	my_access				asl	my_access	; next two bits are unused		asl	my_access	; and set to 0		lda	#attr_i		bit	attributes	; file invisible?		beq	set_i		sec			; yes, so set for ProDOSset_i		rol	my_access				lda	#attr_w		bit	attributes	; write inhibit?		bne	set_w		sec			; no, so write enableset_w		rol	my_access				sec			; always read enable		rol	my_access				rts			; all done (finally!)		endwith		endp;------------------------------------------------------------; Bytes_to_blks;; This routine converts a byte count into a block count by; adding $1FF to the byte count (to round off to the next; block) and dividing by $200 (the block size).;; On entry:;	Full native mode;	A = byte count (low word);	X = byte count (high word);; On exit:;	Full native mode;	A = block count (low word);	X = block count (high word);; Uses:;	math_temp;------------------------------------------------------------bytes_to_blks	proc	export		with	dp,mydata		ProcName bytes_to_blks		;------------------------------------------------------------; Round to next block;------------------------------------------------------------		clc		adc	#$1FF		; round low word		sta	math_temp	; save low word		txa		adc	#0		; bump high word		;------------------------------------------------------------; Divide by 2;------------------------------------------------------------		lsr	a		; shift by 2		sta	math_temp+2	; save high word		ror	math_temp	; move carry in		;------------------------------------------------------------; Divide by $100 (by selecting the right bytes);------------------------------------------------------------		lda	math_temp+3	; get highest byte		and	#$00FF		; only one byte		tax			; becomes high word		lda	math_temp+1	; get low word		rts			; that's all folks.		endwith		endp;------------------------------------------------------------; UpCase;; Converts character in A to upper case.  Entry can be in; either 8 or 16 bit mode (in 16 bit mode, only the low; order byte of A is converted).;------------------------------------------------------------UpCase		proc	export		ProcName UpCase				php			; save 8/16 bit mode of A		sep	#$20		; force short A for chars		longa	off				cmp	#'a'		; before the "a"?		blt	exit		; yes, so don't change		cmp	#'z'+1		; after "z"?		bge	exit		; yes, so keep it, too				and	#$DF		; force letter to upper caseexit		plp			; restore 8/16 bit mode of A		longa	on		rts		endp		;------------------------------------------------------------; Out_PStr;; This routine will copy a P-String (string with leading; length byte) into a user's buffer.  If the current call; class is >0 then it will make sure that the string will; fit in the user's buffer (a GS/OS output buffer).; Otherwise, it just copies over the bytes.;; On entry:;	Full native mode;	class      = class number of current call;	[src_ptr]  = address of length byte of P-String;	[dest_ptr] = address of user output buffer;			(output data address for class 0);			(output buffer size for class 1);; On exit:;	Full native mode;	c = 0	if no error;	  = 1	if error (buffer too small -- class 1);	A = error code (A = 0 if c = 0);;------------------------------------------------------------Out_PStr	proc	export		with	dp,mydata		ProcName Out_PStr				lda	class		; class 0?		beq	class0		lda	[src_ptr]	; get length		and	#$00FF		; mask off byte		sta	math_temp	; save for later				sec		lda	[dest_ptr]	; get buffer size		sbc	#4		; 4 bytes overhead		bmi	way_too_small	; not even 4 bytes!?!				pha			; save actual room				lda	math_temp	; get length word		ldy	#2		; index to buffer		sta	[dest_ptr],y	; return length word		pla			; get amount of room		cmp	math_temp	; enough room?		blt	too_small		clc			; dest buffer + 4		lda	dest_ptr	; is where data goes,		adc	#3		; but index is 1..len,		sta	dest_ptr	; so base should be		lda	dest_ptr+2	; buffer + 3.		adc	#0		sta	dest_ptr+2				lda	math_temp	; get length to copy		beq	done		; don't copy if 0 bytes		bra	copy_it		; move them bytesway_too_small		sec		lda	#invalid_parm	; buffer < 4 bytes!!		bra	exittoo_small		sec			; indicate error		lda	#buffer_small	; buffer too small error		bra	exitclass0		lda	[src_ptr]	; get length		and	#$00FF		; only 1 byte valid		sta	[dest_ptr]	; save length		beq	done		; exit if null stringcopy_it		tay			; A had length to copy		sep	#$20		; 8-bit A for chars		longa	offloop		lda	[src_ptr],y	; move them bytes!		sta	[dest_ptr],y		dey			; more to copy?		bne	loop		; do it again, Sam		rep	#$20		; back to full native		longa	ondone		clc		lda	#0exit		rts		endwith		endp;------------------------------------------------------------; Convert_error;; This routine takes an AFP error code as input and produces; the equivalent GS/OS error message as output. Any unknown; error code is turned into an I/O error.;; On entry:;	A = AFP error code (possibly $0000);; On exit:;	A = GS/OS error code (possibly $0000);	c = 0 iff A = 0;;------------------------------------------------------------convert_error	proc	export		import	error_table:data		with	dp,mydata		ProcName convert_error				cmp	#0		; was there no error?		beq	got_it		sta	math_temp	; save for comparison				ldy	#0		; start with first entryloop		lda	error_table,y	; get next AFP error		beq	unknown		; 0 is end of table		cmp	math_temp	; is this the one?		bne	next		lda	error_table+2,y	; get GS/OS error		bra	got_itnext		iny			; point to next table entry		iny		iny		iny		bra	loopunknown		lda	#io_error	; unknown error => I/O Errorgot_it		cmp	#1		; foce c=1 if A<>0		rts		endwith		endp;------------------------------------------------------------; Error_table;; This is a conversion table of error codes.  It consists of; pairs of words: an AFP error (low word only) followed by; the corresponding GS/OS error.  The table is terminated; by a single word of zeroes.;; Note: the AFP error codes are in high-low byte order.;;------------------------------------------------------------error_table	record		dc.w	$78EC,access_error	; access denied		dc.w	$77EC,io_error		; auth continue		dc.w	$76EC,io_error		; bad UAM		dc.w	$75EC,io_error		; bad version number		dc.w	$74EC,invalid_parm	; bitmap error		dc.w	$73EC,invalid_path	; can't move (into descendant)		dc.w	$72EC,access_error	; deny conflict		dc.w	$71EC,access_error	; dir not empty		dc.w	$70EC,vol_full		; disk full		dc.w	$6FEC,eof_error		; EOR error		dc.w	$6EEC,file_open		; file busy		dc.w	$6DEC,io_error		; flat volume		dc.w	$6CEC,data_unavail	; item not found (in desktop DB)		dc.w	$6BEC,access_error	; lock error		dc.w	$6AEC,io_error		; misc error		dc.w	$69EC,io_error		; no more locks		dc.w	$68EC,io_error		; no server		dc.w	$67EC,dup_path		; object exists		dc.w	$66EC,file_not_found	; object (file/folder) not found		dc.w	$65EC,invalid_parm	; invalid parameter		dc.w	$64EC,bad_pos		; range not locked (not by you)		dc.w	$63EC,bad_pos		; range overlap (locked by you)		dc.w	$62EC,io_error		; session closed		dc.w	$61EC,access_error	; user not authorized		dc.w	$60EC,io_error		; call not supported (was $01)		dc.w	$5FEC,bad_store_type	; object type error		dc.w	$5EEC,$42		; too many files open		dc.w	$5DEC,io_error		; server going down		dc.w	$5CEC,access_error	; can't rename		dc.w	$5BEC,path_not_found	; directory not found		dc.w	$5AEC,io_error		; icon type error		dc.w	$59EC,access_error	; volume locked		dc.w	$58EC,access_error	; object locked		dc.w	0		endrTopLine		equ	3LeftEdge	equ	1GrafStart	equ	$E12000			; start of Super HiRes screenNewVideo	equ	$E0C029			; controls Super Hi-Res modeRead80Vid	equ	$E0C01F			; minus if 80 cols displayedTextStart	equ	$0400			; upper left char of text screentext_save	dc.b	0			; used to save text char for applestext_char	dc.b	0			; flip high bit on/off to flashQDFlag		record	export		dc.w	0			; true if QuickDraw active		endrWroteToSHRFlag	record	export			; added 21-Jan-93 DAL (means we drew arrows on SHR screen)		dc.w	0		endrQDDpage		record	export		dc.w	0			; QuickDraw's direct page		endrsave_arrows	ds.w	6			; screen under arrowsSaveRestQD_minRect dc.w		0,0,0,0		; Temporary save area for locations onSaveRestQD_imageRef dc.l	0		; QuickDraw's direct page used to shieldSaveRestQD_boundsRect dc.w	0,0,0,0		; the cursor before drawing arrows.;------------------------------------------------------------; MyShield;; Will make QuickDraw hide the cursor if it moves over the; arrows as I'm drawing or erasing them.;------------------------------------------------------------MyShield	proc	exportShieldCursor	equ	$E01E98MinRect		equ	$00ImageRef	equ	$0EBoundsRect	equ	$14DirtyFlags	equ	$EC		ProcName MyShield				phd				; save my direct page		php				; save interrupt state		sei				; disable interrupts		lda	QDDpage			; get QuickDraw's DP		tcd				; into D;save minRect		lda	<$00+0		sta	SaveRestQD_minRect+0		lda	<$00+2		sta	SaveRestQD_minRect+2		lda	<$00+4		sta	SaveRestQD_minRect+4		lda	<$00+6		sta	SaveRestQD_minRect+6;save imageRef		lda	<$0E+0		sta	SaveRestQD_imageRef+0		lda	<$0E+2		sta	SaveRestQD_imageRef+2;save boundsRect		lda	<$14+0		sta	SaveRestQD_boundsRect+0		lda	<$14+2		sta	SaveRestQD_boundsRect+2		lda	<$14+4		sta	SaveRestQD_boundsRect+4		lda	<$14+6		sta	SaveRestQD_boundsRect+6; First, set min clip rectangle (where I'll be drawing)		stz	MinRect			; top		stz	MinRect+2		; left		lda	#10			; bottom		sta	MinRect+4		lda	#12			; right		sta	MinRect+6; Next, set up bounds rect for clipping (??? don't ask me, I only work here)		stz	BoundsRect		; top		stz	BoundsRect+2		; left		lda	#199			; bottom		sta	BoundsRect+4		lda	#639			; right		sta	BoundsRect+6; Next, set image ref to point to screen (???)		lda	#$E1		sta	ImageRef+2		lda	#$2000		sta	ImageRef; Finally, tell QD that its DP has been messed with		ldx	#$200		lda	DirtyFlags,x		and	#$8000		sta	DirtyFlags,x; At last, we can call ShieldCursor		plp				; restore interrupt state		jsl	ShieldCursor							;restore minRect		lda	SaveRestQD_minRect+0		sta	<$00+0		lda	SaveRestQD_minRect+2		sta	<$00+2		lda	SaveRestQD_minRect+4		sta	<$00+4		lda	SaveRestQD_minRect+6		sta	<$00+6;restore imageRef		lda	SaveRestQD_imageRef+0		sta	<$0E+0		lda	SaveRestQD_imageRef+2		sta	<$0E+2;restore boundsRect		lda	SaveRestQD_boundsRect+0		sta	<$14+0		lda	SaveRestQD_boundsRect+2		sta	<$14+2		lda	SaveRestQD_boundsRect+4		sta	<$14+4		lda	SaveRestQD_boundsRect+6		sta	<$14+6									pld				; restore my DP		rts				endp;------------------------------------------------------------; MyUnShield;; Undo the effect of MyShield above.;------------------------------------------------------------MyUnShield	proc	exportUnShield	equ	$E01E9C		ProcName MyUnShield				phd				lda	QDDpage		tcd		jsl	UnShield		pld		rts				endp;------------------------------------------------------------; Draw_Arrows; Puts arrows up on screen during network transaction, or put; up characters in text mode.;------------------------------------------------------------draw_arrows	proc	export		import	flash_arrows:code		import	NetworkSlotNumber		ProcName draw_arrows				sep	#$20			; 8 bit mode for NewVideo register		lda	>NewVideo		rep	#$20			; return to 16 bit mode		and	#$0080			; get Super Hi-Res bit		beq	text			; do text mode draw		lda	QDFlag			; was QuickDraw active?		beq	hidden			; no, so cursor isn't a problem		jsr	MyShield		; shield the cursor from arrowshidden		inc	WroteToSHRFlag		; 21-Jan-93 DAL		lda	NetworkSlotNumber		and	#8			;external slot?		lsr	a		lsr	a			;map external to X=2, internal to X=0		tax		lda	>GrafStart+(TopLine*160)+LeftEdge		sta	save_arrows		and	ArrowPictures,x		sta	>GrafStart+(TopLine*160)+LeftEdge		lda	>GrafStart+((TopLine+1)*160)+LeftEdge		sta	save_arrows+2		and	ArrowPictures+4,x		sta	>GrafStart+((TopLine+1)*160)+LeftEdge		lda	>GrafStart+((TopLine+2)*160)+LeftEdge		sta	save_arrows+4		and	ArrowPictures+8,x		sta	>GrafStart+((TopLine+2)*160)+LeftEdge		lda	>GrafStart+((TopLine+4)*160)+LeftEdge		sta	save_arrows+6		and	ArrowPictures+12,x		sta	>GrafStart+((TopLine+4)*160)+LeftEdge		lda	>GrafStart+((TopLine+5)*160)+LeftEdge		sta	save_arrows+8		and	ArrowPictures+16,x		sta	>GrafStart+((TopLine+5)*160)+LeftEdge		lda	>GrafStart+((TopLine+6)*160)+LeftEdge		sta	save_arrows+10		and	ArrowPictures+20,x		sta	>GrafStart+((TopLine+6)*160)+LeftEdge				lda	QDFlag			; was QD active?		beq	shown			; no, cursor isn't a problem		jsr	MyUnShield		; un shield cursorshown		rtstext		stz	WroteToSHRFlag		; 21-Jan-93 DAL		phb		sep	#$20		longa	off				lda	>Read80Vid		; are we displaying 80 columns?		rol	a		rol	a			; flag now in bit 0		and	#1			; get flag only		ora	#$E0			; E1 if 80 columns		pha				; save as bank for text		plb				; get text screen bank				lda	TextStart		; get original character		sta	>text_save		; save for later		lda	>text_char		; get inverse/normal		eor	#$80			; flip it		sta	>text_char		; save for next time;;;		ora	#'*'			; make it an asterisk*** 21-Jan-93 DAL -- If Ethernet, blank a "@" instead of a "*"		ldx	#'*'			;anticipate LocalTalk ($2A/$AA for inverse/normal)		lda	>NetworkslotNumber		and	#8			;nonzero if external slot (Ethernet)		beq	@1		ldx	#$00			;Ethernet (use $00/$80 for inverse/normal)@1		txa		ora	>text_char		sta	TextStart		; put on screen*** end 21-Jan-93 DAL				rep	#$20		longa	on		plb				; return to current bank		rts** First image is for LocalTalk, 2nd is for Ethernet** Added 21-Jan-93 DAL*ArrowPictures	dc.b	$FF,$0F, $FF,$FF	;  ..*.   ....		dc.b	$00,$00, $FF,$0F	;  ****   ..*.		dc.b	$FF,$0F, $00,$00	;  ..*.   ****;                       $FF,$FF, $FF,$FF        ;  ....   ....		dc.b	$F0,$FF, $00,$00	;  .*..   ****		dc.b	$00,$00, $F0,$FF	;  ****   .*..		dc.b	$F0,$FF, $FF,$FF	;  .*..   ....				endp		;------------------------------------------------------------; Erase_Arrows; Undo any screen manipulation happened during draw_arrows;------------------------------------------------------------erase_arrows	proc	export		import	flash_arrows:code				ProcName erase_arrows		;		sep	#$20			; 8 bit mode for NewVideo register;		lda	>NewVideo;		rep	#$20			; return to 16 bit mode;		and	#$0080			; get Super Hi-Res bit;		beq	text			; do text mode draw*** 21-Jan-93 DAL -- Erase the activity indicator where we drew it, provided the SHR screen is linear		lda	WroteToSHRFlag		beq	text		sep	#$20		lda	>NewVideo		rep	#$20		and	#$00C0		beq	text			;oops, SHR screen is off and nonlinear, don't touch it*** 21-Jan-93		lda	QDFlag			; was QuickDraw active?		beq	hidden			; no, so cursor isn't a problem		jsr	MyShield		; shield the cursor from arrowshidden		lda	save_arrows		sta	>GrafStart+(TopLine*160)+LeftEdge		lda	save_arrows+2		sta	>GrafStart+((TopLine+1)*160)+LeftEdge		lda	save_arrows+4		sta	>GrafStart+((TopLine+2)*160)+LeftEdge		lda	save_arrows+6		sta	>GrafStart+((TopLine+4)*160)+LeftEdge		lda	save_arrows+8		sta	>GrafStart+((TopLine+5)*160)+LeftEdge		lda	save_arrows+10		sta	>GrafStart+((TopLine+6)*160)+LeftEdge				lda	QDFlag			; was QD active?		beq	shown			; no, cursor isn't a problem		jsr	MyUnShield		; un shield cursorshown		rtstext		phb		sep	#$20		longa	off				lda	>Read80Vid		; are we displaying 80 columns?		rol	a		rol	a			; flag now in bit 0		and	#1			; get flag only		ora	#$E0			; E1 if 80 columns		pha				; save as bank for text		plb				; get text screen bank				lda	>text_save		; get old char		sta	TextStart		; restore it				rep	#$20		longa	on		plb				; return to current bank		rts				endp				;------------------------------------------------------------; PreProcess;; This routine will check validity of some parameters in the; parameter list and then copy the appropriate GS/OS fields; into my private working space.  Note that individual calls; are responsible for calling proc_path to find files.;; On entry:;	Full native mode;	X = call number * 2;	Y = class number * 2;; On exit:;	Full native mode;	A = class;;; The call uses a table that provides the following; information about each call:;	1) Max PCount;	2) Max Class;	3) Pathname 1 required;	4) Pathname 2 required;	5) VCR used;	6) FCR used;	7) Check FCR to make sure this is a file.;	   Set up AFP fork bitmap.;;;	      |7|6|5|4|3|  2  |    1    |;	______|_|_|_|_|_|_____|_________|;	| | | | | | | | | | | | | | | | |;	|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|;	15	       8 7	       0;;; Modification History:; 17-Aug-88	MSD	Changed pathname(s) used flag to;			two pathname required flags.; 18-Dec-91	MSD	Removed code that checks the span of;			pathnames so FindVol will be called to;			find the volume (and the error priority;			bit will be set).;------------------------------------------------------------path_1_req	equ	$100			; pathname 1 requiredpath_2_req	equ	$200			; pathname 2 requiredvcr_used	equ	$400			; mask for VCR used bitfcr_used	equ	$800			; mask for FCR used bitfiles_only	equ	$1000			; check dirflagPreProcess	proc	export		with	dp,mydata		import	PreProcFlags:data		import	my_fork_bitmap		ProcName PreProcess				IF	DebugCode THEN		stz	SessRefnum		; zero out values for debugging		stz	VolID		stz	DirID		lda	fst_active		beq	not_active		brk	0			; HELP!! FST is already active!!not_active		inc	fst_active		; for debugging		ENDIF		phy				; save call class		phx				; save call number		jsl	Lock_Mem		; lock down GS/OS managed memory		plx				; restore call number		ply				; restore call class		lda	gbuf_addr		; make a local copy of		sta	gbuf_ptr		; the pointer to the		lda	gbuf_addr+2		; general I/O buffer		sta	gbuf_ptr+2				lda	PreProcFlags-2,x	; get this call's flags		sta	flags			; and save a local copy		and	#$1F			; mask off max Pcount		sta	max_pcount				stz	pcount			; signal class 0 call				tya				; A <- class * 2		lsr	a			; A <- class		sta	class			; save call class		beq	class0			; skip the rest for old calls				lda	flags		and	#$E0			; mask off max class		asl	a			; shift max class to high byte		asl	a		asl	a		xba				; max class now in low byte		cmp	class			; if max >= class then OK		bge	good_class		lda	#bad_class		; oops, class > max class		brl	error_out		; go exit with errorgood_class		lda	max_pcount		; validate pcount for new calls		cmp	[p_b_addr]		; test pcount in param list		bge	good_pcount		; if max >= pcount then OK		lda	#bad_pcount		; oops, pcount > max pcount		brl	error_outgood_pcount		lda	[p_b_addr]		; get user's pcount		sta	pcount			; save the real pcount				clc				; now set up a pointer		lda	p_b_addr		; to the user's parameter		adc	#2			; block (point after the		sta	my_pb_ptr		; pcount field for class>0)		lda	p_b_addr+2		adc	#0		sta	my_pb_ptr+2		bra	continue		; do the rest of the setupclass0		lda	p_b_addr		; for class 0 calls, just		sta	my_pb_ptr		; copy the param block address		lda	p_b_addr+2		sta	my_pb_ptr+2continue; Now determine whether a VCR or FCR are used in this call		lda	flags		and	#vcr_used		; is VCR used?		beq	check_fcr		; if not, check FCR; Dereference the VCR virtual pointer GS/OS gave me		ldx	vcr_addr		ldy	vcr_addr+2		jsl	deref			; call SCM to deref the VP		stx	my_vcr_ptr		sty	my_vcr_ptr+2;------------------------------------------------------------; Here is where I would do anything special to prepare; for using a VCR in a call.;; Copy the SessRefnum and VolID from the VCR to local variables;------------------------------------------------------------		ldy	#vcr.sessrefnum		lda	[my_vcr_ptr],y		sta	SessRefnum				iny		iny				; Y = vcr.volid		lda	[my_vcr_ptr],y		sta	VolID;------------------------------------------------------------; Now see if an FCR is used in this call.  If so, set it up.;------------------------------------------------------------check_fcr		lda	flags		and	#fcr_used		; is an FCR used in this call?		beq	check_path		; if not, process the path				ldx	fcr_addr		ldy	fcr_addr+2		jsl	deref			; Deref VP to FCR		stx	my_fcr_ptr		sty	my_fcr_ptr+2;------------------------------------------------------------; Here is where I would do anything special to prepare; for using an FCR in a call.;; Check that certain calls (Read, Write, EOF/Mark calls); act only on files, not directories.;------------------------------------------------------------		lda	flags		and	#files_only		; enforce files only?		beq	check_path		; if not, process the path		ldy	#fcr.dirflag		lda	[my_fcr_ptr],y		; get file/dir flag		bit	#fcr_is_dir		; is it a directory?		beq	is_a_file		; no, then OK		lda	#access_error		; give access denied!		bra	error_out		; return the erroris_a_file		ldx	#data_fork_bit		; assume data fork of file		bit	#fcr_is_res		; is it a resource fork?		beq	got_fork_bitmap		; if not, bitmap is in X		ldx	#res_fork_bit		; know now it is resouce forkgot_fork_bitmap		stx	my_fork_bitmap		; save for callscheck_path;------------------------------------------------------------; This code makes sure that required pathnames are present.; (Checking of spans was removed 18-Dec-91).;------------------------------------------------------------		lda	flags		and	#path_1_req		; is pathname 1 required?		beq	did_path_1		; if not, check pathname 2;------------------------------------------------------------; Make sure that a pathname or device name was given.;------------------------------------------------------------		lda	path_flags		and	#path1_mask		; is pathname 1 given?		ora	src_dev_num		; or source dev num?		bne	did_path_1		; if so, check path 2do_bad_path		lda	#invalid_path		; span too big =>		bra	error_out		;   invalid path syntaxdid_path_1		lda	flags		and	#path_2_req		; is pathname 2 required?		beq	did_path_2		; if not, skip this part				lda	path_flags		and	#path2_mask		; is pathname 2 given?		ora	dest_dev_num		; or destination dev num?		beq	do_bad_parm		; if not, error		did_path_2				lda	class			; let caller know the class		rtserror_out		sec				; indicate error		jmp	main_exit		; go shut down calldo_bad_parm		lda	#invalid_parm		; bad parameter (no path given)		bra	error_out		endwith				; with dp		endp;------------------------------------------------------------; Main_Exit;; This routine cleans up for exiting an application call.; It assumes you called PreProcess at the start of the call.;; On entry:;	c = 1 for error;	  = 0 for no error;	A = error code (0 for no error);	err_priority =	$0000	if I didn't identify the volume;			$8000	if I did identify the volume;; On exit:;	Exits directly to GS/OS.  Returns c and A on entry.;; Main functions:;	Unlock GS/OS managed memory.;; 05-Mar-91 MSD	Added new priority mechanism for error codes.;		The problem was when several FSTs return;		bouncing errors, and the error returned by;		the first FST called is used (which is usually;		ProDOS's invalid path syntax).  So, if an FST;		identifies the volume, it should set the high;		bit when it returns an error.;;------------------------------------------------------------main_exit	proc	export		with	mydata				ProcName main_exit		IF	DebugCode THEN		import	debug_dp:data		ENDIF				php			; save error status		pha		IF	DebugCode THEN		sta	dp.my_error	; remember error code		ldx	#$FEexit_loop		lda	dp,x		; make a copy of my		sta	debug_dp,x	; direct page for		dex			; debugging purposes		bpl	exit_loop				dec	fst_active	; not active any more		ENDIF		jsl	Unlock_Mem				pla			; restore error code		beq	@no_priority		ora	err_priority	; add in priority bit@no_priority		plp			; restore error status		jml	Sys_Exit	; unwind the call		endwith		endp;------------------------------------------------------------;; PreProcFlags;; This is the table of attributes used by the PreProcess; routine.  It contains one word for each call.  See the; comments for PreProcess for a description of the entries; in this table.;; Note that the table starts with call #1, so it should be; accessed by PreProcFlags-2,X where X has the call number; times 2.;; Also note that identifiers are used for each entry.  This; was done only because it seems easier to read than throwing; a comment out to the far right.  These identifiers are not; exported, so they should never conflict with other labels; of the same name.;; 27-Mar-90	MSD	Increased maximum pCount for Flush to 2.;  5-Dec-91	MSD	Increased maximum pCount for Change_Path;			to 3, so it accepts a new "flags" parameter.;------------------------------------------------------------PreProcFlags	recordMaxClass0	equ	$00MaxClass1	equ	$20; For Create: should I actually try to find the path since; it might not exist?  Depends on definition of "FindPath"Create		dc.w	7+MaxClass1+path_1_reqDestroy		dc.w	1+MaxClass1+path_1_reqReserved03	dc.w	0; For ChangePath: find the common prefix on its own,; so don't try to find the source path.ChangePath	dc.w	3+MaxClass1+path_1_req+path_2_reqSetFileInfo	dc.w	12+MaxClass1+path_1_reqGetFileInfo	dc.w	12+MaxClass1+path_1_reqJudgeName	dc.w	6+MaxClass1Volume		dc.w	6+MaxClass1; Note: SetPrefix and GetPrefix are not passed to FSTs.SetPrefix	dc.w	0GetPRefix	dc.w	0ClearBackup	dc.w	1+MaxClass1+path_1_reqSetSysPrefs	dc.w	0Null		dc.w	0Expand_Path	dc.w	0GetSysPrefs	dc.w	0Open		dc.w	15+MaxClass1+path_1_reqNewLine		dc.w	4+MaxClass1+fcr_used+files_onlyRead		dc.w	5+MaxClass1+fcr_used+vcr_used+files_onlyWrite		dc.w	5+MaxClass1+fcr_used+vcr_used+files_onlyClose		dc.w	1+MaxClass1+fcr_used+vcr_usedFlush		dc.w	2+MaxClass1+fcr_used+vcr_usedSetMark		dc.w	3+MaxClass1+fcr_used+vcr_used+files_onlyGetMark		dc.w	2+MaxClass1+fcr_used+vcr_used+files_onlySetEOF		dc.w	3+MaxClass1+fcr_used+vcr_used+files_onlyGetEOF		dc.w	2+MaxClass1+fcr_used+vcr_used+files_only; For Set-/Get- Level: should not be passed to the FSTSetLevel	dc.w	0GetLevel	dc.w	0GetDirEntry	dc.w	17+MaxClass1+fcr_used+vcr_usedBeginSession	dc.w	0EndSession	dc.w	0SessionStatus	dc.w	0GetDevNumber	dc.w	2+MaxClass1+path_1_reqGetLastDev	dc.w	0ReadBlock	dc.w	0WriteBlock	dc.w	0Format		dc.w	0EraseDisk	dc.w	0Reserved26	dc.w	0GetName		dc.w	0GetBootVol	dc.w	0Quit		dc.w	0GetVersion	dc.w	0; For GetFSTInfo: GS/OS should get this from FST headerGetFSTInfo	dc.w	0DInfo		dc.w	0DStatus		dc.w	0DControl	dc.w	0DRead		dc.w	0DWrite		dc.w	0BindInterrupt	dc.w	0UnBindInterrupt	dc.w	0; For FSTSpecific: I assume this gets passed to the FST!!!; note: it does its own PCount checking, etc.FSTSpecific	dc.w	31+MaxClass1		endr		;------------------------------------------------------------; CheckParent;; If A,c indicate a file not found error, try to get the; DirID of the parent to see if it exists.  If the parent; does not exist, turn the error into a path not found.;; On entry:;	Full native mode;	c = 1 if error;	A = error code;; On exit:;	Full native mode;	c = 1 if error;	A = error code;;------------------------------------------------------------CheckParent	proc	export		with	mydata				import	(StartPacket,SendPacket):code		import	(PutByte,PutWord,PutIDs,PutBlock):code		import	(StartReply,GetLong,GetWord):code		ProcName CheckParent				bcc	done			; don't do anything if no error		cmp	#file_not_found		; the right error?		bne	exit			; if not, return the one we have; Find length of parent's partial path		sep	#$30			; 8 bits for chars		longa	off		longi	off				ldy	partial_path		; get length of stringloop		lda	partial_path,y		; get a byte of string		beq	found_it		; done if null byte		dey				; move to previous byte		bne	loop			; continue if more string		rep	#$30			; return in full native mode		bra	do_file			; we already had parent's DirID!found_it		dey				; get length of partial path		rep	#$30			; back to full native		longa	on		longi	on				phy				; save parent length		lda	#afpGetFlDrParms	; GetFileDirParms		jsr	StartPacket				jsr	PutIDs			; put VolID and DirID in		lda	#$0000			; don't want file info		jsr	PutWord				lda	#$0000			; don't want folder info		jsr	PutWord		lda	#afp_long		; path type is long name		jsr	PutByte				pla				; get string length		pha				; save again		jsr	PutByte			; put string length in				pla				; get length of block		beq	send_it			; no more packet if null		ldx	#<partial_path+1	; get pointer to string buffer		ldy	#^partial_path+1		jsr	PutBlock		; put string text in		send_it		jsr	SendPacket		; go find parent		bcs	do_path			; error returns path_not_found		jsr	StartReply		jsr	GetLong			; ignore the bitmaps		jsr	GetWord			; get file/dir flag		and	#$0080			; is it a folder?		beq	do_path			; if not, do path_not_found		do_file		lda	#file_not_found		; got parent, so file not found		bra	exit			; return with errordo_path		lda	#path_not_found		; assume path not found errorexit		sec				; indicate errordone		rts				endwith		endp		end