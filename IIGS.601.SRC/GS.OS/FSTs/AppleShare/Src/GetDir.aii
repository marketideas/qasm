;------------------------------------------------------------; Get_Dir_Entry;; This call is used to enumerate (list the contents of) a; directory.  The file MUST be a directory.  I assume the; volume is a fixed-DirID volume (so that I don't have to; keep the directory open via an FPOpenDir call).;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 25-Jul-88	MSD	Started coding.;  9-Sep-88	MSD	Folders' read bit cleared if neither see;			files nor see folders.; 21-Sep-88	MSD	Allow up to 8 entries in buffer.; 30-Sep-88	MSD	Use new field names in FCR.;  9-Nov-90	MSD	Fixed bug where buffer size for name = 4;			caused 64K to be copied (wasn't checking;			for 0 bytes to copy).; 28-Jan-91	MSD	Added call to hfs2pdos to do filetype;			mapping like GetFileInfo does.; 20-Sep-91	MSD	Now returns error $4A (invalid storage;			type) instead of $4E (access error) when;			you try to do a GetDirEntry on an open;			file.  Don't update entry_num in parameter;			block if there is an error.; 5-May-93	JCM	We now return the filetype and auxtype just;			like we do for GetFileInfo. ;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit):code		import	(StartPacket,SendPacket):code		import	(PutWord,PutLong,PutIDs):code		import	(StartReply,GetPString):code		import	(GetByte,GetWord,GetLong):code		import	(GetPlace,GetBlock):code		import	(get_cr_date,get_mod_date):code		import	(bytes_to_blks,convert_attr):code		import	SPCommand:tSPCommand		import	mydata:tdata		import	save_pdos_info		;5-May-93 JCM				entry	(from_server,from_buffer):code		entry	(grab_parms,return_parms):code		entry	do_tot_ent:code;------------------------------------------------------------; Definition of parameter block for Get_Dir_Entry call;------------------------------------------------------------p		record	0		ds.w	1			; refnumflags		ds.w	1			; high bit if extended filebase		ds.w	1			; $0000: disp. is absolute						; $0001: add disp. to current						; $0002: sub. disp. from currentdisp		ds.w	1			; displacement of entryname		ds.l	1			; pointer to pathnameentry_num	ds.w	1			; entry number of entryfiletype	ds.w	1			; file's filetypeeof		ds.l	1			; file's EOFblks		ds.l	1			; total blocks usedcr_date		ds.b	8			; create date/time (toolbox)mod_date	ds.b	8			; mod date/time (toolbox)access		ds.w	1			; access wordauxtype		ds.l	1			; file's auxtypefile_sys	ds.w	1			; file system IDopt_list	ds.l	1			; option list pointerres_eof		ds.l	1			; resource EOFres_blks	ds.l	1			; resource blocks used		endr;; Requested file parameters bitmaps (i.e. what parts of the file info; do I want for files and directories).;file_bitmap	equ	$6F26			; long name, finder info,						; mod date, create date, parent DirID,						; attributes, ProDOS info, fork lengthsdir_bitmap	equ	$6F12			; offspring instead of fork lengths,						; access rights, no ProDOS infoget_dir_entry	proc	export		with	dp,mydata		ProcName get_dir_entry				jsr	PreProcess		; validate the call;------------------------------------------------------------; Make sure this FCR refers to a directory.;------------------------------------------------------------		ldy	#fcr.dirflag		lda	[my_fcr_ptr],y		; get the dir flag		bmi	is_a_dir		brl	not_a_dir		; flag is high bitis_a_dir;------------------------------------------------------------; Class 0 acts like class 1 with 14 parameters (all but the; option list and resource fork info).  Note: fields are; returned in a different order than for the Open or; Get_File_Info calls.  What a pain!;------------------------------------------------------------		lda	class			; what class?		bne	class1		lda	#14			; class 0 =>		sta	pcount			;   14 parametersclass1;------------------------------------------------------------; Pretend I've scanned first 5 parameters.;------------------------------------------------------------		lda	pcount		sec		sbc	#5			; first 5 are done		sta	pcount;------------------------------------------------------------; Copy DirID from FCR to direct page for PutIDs to use.;------------------------------------------------------------		ldy	#fcr.dirid		lda	[my_fcr_ptr],y		; get DirID first word		sta	DirID			; save in local data		iny		iny		lda	[my_fcr_ptr],y		; get second word		sta	DirID+2			; on direct page;------------------------------------------------------------; Which entry does the user want anyway?;------------------------------------------------------------		ldy	#p.disp		lda	[my_pb_ptr],y		; get displacement		sta	dir_index		; save for later		ldy	#fcr.dirindex		lda	[my_fcr_ptr],y		; get old entry number		tax				; save in X for relative modes		ldy	#p.base		lda	[my_pb_ptr],y		; get base		bne	not_abs			; $0000 = absolute;------------------------------------------------------------; base = absolute, entry := disp;------------------------------------------------------------		lda	dir_index		; already have displacement		bra	got_entry_num		; save entry_numnot_abs		dea				; was base=1?		bne	not_add			; no, so don't add disp.;------------------------------------------------------------; base = forward relative, entry := entry + disp;------------------------------------------------------------		txa				; get old displacement		clc		adc	dir_index		; add displacement		bcs	end_dir			; error if overflow		bra	got_entry_numnot_add		dea				; was base=2?		bne	bad_parm		; no, bad parameter;------------------------------------------------------------; base = forward relative, entry := entry + disp;------------------------------------------------------------		txa				; get old displacement		sec		sbc	dir_index		; subtract displacement		bcc	end_dir			; error if underflow		beq	end_dir			; error if =0;------------------------------------------------------------; Here, entry number is in A.  Save in FCR, and in parameter; block if user wants it (pcount>5).;------------------------------------------------------------got_entry_num		sta	dir_index		; dir_index for convenience; 20-Sep-91 MSD: Commented out the following lines:;		ldx	pcount			; pcount>5?;		beq	saved_num		; no, skip this;		ldy	#p.entry_num;		sta	[my_pb_ptr],y		; return entry_numsaved_num		lda	dir_index		; get entry_num		bne	read_one		; not zero => get an entry		jsr	do_tot_ent		; return number of entries		bra	exit			; and return any errorsread_one;------------------------------------------------------------; Read from buffer or directly from server?;------------------------------------------------------------		ldy	#fcr.flags		lda	[my_fcr_ptr],y		; buffering on?		bpl	do_server		; if not, get one entry;------------------------------------------------------------; Assume a read from the FCR's buffer.  Get enumeration data; into reply buffer.;------------------------------------------------------------		jsr	from_buffer		bcs	exit		bcc	parse			; go extract GS/OS info;------------------------------------------------------------; Assume a read directly from the server.  Get enumeration; into reply buffer.;------------------------------------------------------------do_server		jsr	from_server		bcs	exit			; exit if error;------------------------------------------------------------; Take parameters from reply buffer and put in local vars.;------------------------------------------------------------parse		jsr	grab_parms;------------------------------------------------------------; Return requested parameters to user;------------------------------------------------------------		jsr	return_parms		; return to user		bcs	exit;------------------------------------------------------------; Exit with no errors;------------------------------------------------------------ok_exit		lda	dir_index		; get current entry		ldy	#fcr.dirindex		sta	[my_fcr_ptr],y		; save in FCR for next call		clc		lda	#0		bra	exit;------------------------------------------------------------; The combined base/displacement would be before the start or; past the end of the directory, so return end_of_dir.;------------------------------------------------------------end_dir		lda	#end_of_dir		sec		bcs	exit;------------------------------------------------------------; A parameter (base or displacement) was bad.;------------------------------------------------------------bad_parm		lda	#invalid_parm		sec		bcs	exit;------------------------------------------------------------; The file was not a directory, so report a bad file format.;------------------------------------------------------------not_a_dir		lda	#version_error		; really bad file format		sec				; it done be an errorexit		jmp	main_exit		; return any errors		endwith				; with dp,mydata		endp;------------------------------------------------------------; from_buffer;; Copy one FPEnumerate structure from the FCR's buffer to; the reply buffer as if it was just returned by an; FPEnumerate.;; On entry:;	dir_index	entry number to copy;; On exit:;;------------------------------------------------------------from_buffer	proc		with	dp,mydata		ProcName from_buffer				ldy	#fcr.flags		lda	[my_fcr_ptr],y		; get buffer valid flag		and	#buffer_valid		; is there valid data in buffer?		beq	recharge		; if not, fill it up		lda	dir_index		; get requested entry number		ldy	#fcr.dir_first		cmp	[my_fcr_ptr],y		; is it before start of buffer?		blt	recharge		; if so, refill buffer		ldy	#fcr.dir_last		cmp	[my_fcr_ptr],y		; is it past end of buffer?		bge	recharge		; if so, refill buffer		ldy	#vcr.modptr		lda	[my_vcr_ptr],y		; get pointer to volrec		sta	src_ptr		iny		iny		lda	[my_vcr_ptr],y		sta	src_ptr+2		ldy	#volrec.lastmod+2		lda	[src_ptr],y		; get second word of lastmod		tax				; in X for safe keeping		dey		dey		lda	[src_ptr],y		; get first word		ldy	#fcr.lastmod		cmp	[my_fcr_ptr],y		; does it match FCR?		bne	recharge		iny		iny		txa				; get high word back		cmp	[my_fcr_ptr],y		bne	recharge		; fill if different		;------------------------------------------------------------; It's in the buffer.  Now, just find the correct entry.;------------------------------------------------------------		ldy	#fcr.dir_first		lda	[my_fcr_ptr],y		; get first entry number		tax				; current entry in X		ldy	#6+fcr.buffer		; offset of first structure@loop		cpx	dir_index		; is this the right one?		beq	@found			; if so, copy it		lda	[my_fcr_ptr],y		; get length of structure		and	#$00FF			; length byte only		sta	math_temp+2		; save for add		tya				; get current offset		clc		adc	math_temp+2		; skip past this structure		tay				; back in Y as index		inx				; bump entry number		bra	@loop@found		lda	[my_fcr_ptr],y		; get structure size		and	#$00FF			; only a byte long		sta	math_temp+2		; save size		sep	#$20			; byte wide copy		longa	off		ldx	#0			; start at beginning@copy		lda	[my_fcr_ptr],y		; get a byte		sta	reply_pkt+6,x		; save in reply		iny		inx		dec	math_temp+2		bne	@copy		rep	#$20			; back to full native		longa	on		clc				; no errors		rts				; all donerecharge		ldy	#fcr.flags		lda	[my_fcr_ptr],y		; get buffer valid flag		and	#Åbuffer_valid		; clear buffer valid flag		sta	[my_fcr_ptr],y		; update buffer valid flag		lda	dir_index		; current entry becomes start		ldy	#fcr.dir_first		; of buffer		sta	[my_fcr_ptr],y		lda	#afpEnumerate		jsr	StartPacket		; start FPEnumerate call				jsr	PutIDs			; put VolID, DirID in packet				lda	#file_bitmap		jsr	PutWord			; put file bitmap in packet				lda	#dir_bitmap		jsr	PutWord			; put directory bitmap in packet				lda	#$2000			; 32 in high-low order		jsr	PutWord			; request count of 32 entries				lda	dir_index		; recover entry number		xba				; high-low order		jsr	PutWord				lda	#2048			; size of reply buffer		xba				; high-low order		jsr	PutWord				lda	#afp_long		; AFP long naming mode		jsr	PutWord			; put path type and null string				clc		lda	my_fcr_ptr		; read directly into the		adc	#fcr.buffer		; FCR's data buffer		sta	SPCommand.RepAddr		lda	my_fcr_ptr+2		adc	#0		sta	SPCommand.RepAddr+2				lda	#2048		sta	SPCommand.RepBufLen	; let ASP return full buffer size				jsr	SendPacket		; go send it out		bcs	err			; check for errorsno_err		ldy	#fcr.buffer+4		lda	[my_fcr_ptr],y		; get actual count		xba				; in 65816 order		clc		adc	dir_index		; plus start is end		ldy	#fcr.dir_last		sta	[my_fcr_ptr],y		; save end count				ldy	#fcr.flags		lda	[my_fcr_ptr],y		ora	#buffer_valid		; buffered data is valid		sta	[my_fcr_ptr],y		ldy	#vcr.modptr		lda	[my_vcr_ptr],y		; get pointer to volrec		sta	src_ptr		iny		iny		lda	[my_vcr_ptr],y		sta	src_ptr+2		ldy	#volrec.lastmod+2		lda	[src_ptr],y		; get second word of lastmod		tax				; in X for safe keeping		dey		dey		lda	[src_ptr],y		; get first word		ldy	#fcr.lastmod		sta	[my_fcr_ptr],y		; save in FCR		iny		iny		txa				; get high word back		sta	[my_fcr_ptr],y		; put it in FCR, too		brl	from_buffer		; go get one of the entrieserr		cmp	#file_not_found		; was it object not found?		bne	exit		lda	#end_of_dir		; there are no more entries!exit		sec				; return the error		rts				endwith				; with dp		endp;------------------------------------------------------------; from_server;; Issue an FPEnumerate call to the server for a single entry.; Put results into reply buffer.;; On entry:;	dir_index	entry number to read;; On exit:;;------------------------------------------------------------from_server	proc		with	dp,mydata		ProcName from_server				lda	#afpEnumerate		jsr	StartPacket		; start FPEnumerate call				jsr	PutIDs			; put VolID, DirID in packet				lda	#file_bitmap		jsr	PutWord			; put file bitmap in packet				lda	#dir_bitmap		jsr	PutWord			; put directory bitmap in packet				lda	#$100			; 1 in high-low order		jsr	PutWord			; request count of 1 entry				lda	dir_index		; recover entry number		xba				; high-low order		jsr	PutWord				lda	#NormSPData		; size of reply buffer		xba				; high-low order		jsr	PutWord				lda	#afp_long		; AFP long naming mode		jsr	PutWord			; put path type and null string				jsr	SendPacket		; go send it out		bcc	exit			; continue if no error		cmp	#file_not_found		; object not found becomes		bne	err_exit		; end of directory error		lda	#end_of_direrr_exit		secexit		rts				; return error to caller		endp				grab_parms	proc		with	dp,mydata		import	hfs2pdos				ProcName grab_parms		;------------------------------------------------------------; Pull returned parameters from packet;------------------------------------------------------------		jsr	StartReply		; ready to get returned info				jsr	GetLong			; ignore bitmaps				jsr	GetWord			; ignore actual count				jsr	GetByte			; get structure length		jsr	GetByte			; get file/dir flag		sta	filedir_flag		; save file/dir flag		;------------------------------------------------------------; Collect all the file info common to both files and folders;------------------------------------------------------------		jsr	GetPlace		; save index to dir entry		jsr	GetWord			; get attributes		jsr	convert_attr		; turn it into my_access				jsr	GetLong			; get parent DirID		sta	my_parent		; save for return later		stx	my_parent+2;------------------------------------------------------------; For Get_Dir_Entry, date/time's returned are in Toolbox; form even for a class 0 call.  Therefore, trick the; date/time routines into thinking that this is a class 1; call regardless of the actual class.;------------------------------------------------------------		pei	class			; save class on stack		lda	#1			; force class 1		sta	class		jsr	get_cr_date		; get create date		jsr	get_mod_date		; get mod date		pla		sta	class			; restore actual class		ldx	#<my_f_info		; copy Finder Info to buffer		ldy	#^my_f_info		lda	#32			; (32 bytes to copy)		jsr	GetBlock				ldx	#<long_name		; get AFP Long name		ldy	#^long_name		jsr	GetPString		;------------------------------------------------------------; Now, do processing that depends on file vs. folder.;------------------------------------------------------------		lda	filedir_flag		; get file/dir flag		beq	is_file			; clear => file;------------------------------------------------------------; If we get here, it was a directory.  Compute storage type,; and data fork length special.;------------------------------------------------------------		stz	my_res_eof		; directories don't have		stz	my_res_eof+2		; a resource fork		stz	my_res_blks		stz	my_res_blks+2				lda	#$D			; storage type = $D		sta	my_store_type				lda	#$F			; filetype = $F		sta	my_filetype				stz	my_auxtype		; auxtype = $0000 0000		stz	my_auxtype+2;------------------------------------------------------------; Calculate blocks used for a directory by assuming that; 8 entries fit in a block (really undefined!);------------------------------------------------------------		stz	math_temp		jsr	GetWord			; get offspring count		xba				; low-high order				lsr	a			; divide by 8 and put		ror	math_temp		; extra bits in math_temp		lsr	a		ror	math_temp		lsr	a		ror	math_temp		ldx	math_temp		; remainder?		beq	@noinc			; if not, don't bump quotient		ina				; round to whole blocks@noinc		sta	my_data_blks		; save block count		stz	my_data_blks+2				stz	my_data_eof		; no data fork, though		stz	my_data_eof+2;------------------------------------------------------------; Check access rights to see if user has permission to read; the directory (i.e. has see folders or see files).;------------------------------------------------------------		jsr	GetLong			; get access rights		sta	my_rights		; save for option_list		stx	my_rights+2				and	#$0003			; see files or see folders?		bne	@read			; if so, leave read bit alone		lda	#$0001			; read bit in access word		trb	my_access		; reset only that one bit@read		bra	exit			; exit with no errors;------------------------------------------------------------; If we get here, it was a file.  Take what the server; gives me.;------------------------------------------------------------is_file		stz	my_rights		; access rights for files are zero		stz	my_rights+2				jsr	GetLong			; get data EOF		xba				; high word in low-high order		pha				; save it off		txa				; low word in A		xba				; low-high order		sta	my_data_eof		; save EOF low word		plx				; get high word in X		stx	my_data_eof+2		; save EOF high word		jsr	bytes_to_blks		; convert to block count		sta	my_data_blks		; save block count		stx	my_data_blks+2		jsr	GetLong			; get resource EOF		xba				; high word in low-high order		pha				; save it off		txa				; low word in A		xba				; low-high order		sta	my_res_eof		; save EOF low word		plx				; get high word in X		stx	my_res_eof+2		; save EOF high word		jsr	bytes_to_blks		; convert to block count		sta	my_res_blks		; save block count		stx	my_res_blks+2*** Added - 5-May-93 JCM - Make sure we return the same filetype/auxtype info as we do***			   with the GetFileInfo call.;		jsr	GetWord			; get ProDOS filetype;		sta	my_filetype		; (it was already in low-high order);		;		jsr	GetLong			; get ProDOS auxtype;		sta	my_auxtype		; (it was already in low-high order);		stx	my_auxtype+2;;		jsr	hfs2pdos		; map filetypes		jsr	save_pdos_info*** End - 5-May-93 JCM		;------------------------------------------------------------; Now construct the storage type from the EOFs.  The rules:;; data fork EOF		resource fork EOF	storage type; 0     <= x < $200	0			1; $200  <= x < $20000	0			2; $2000 <= x		0			3; (any)			0 < x			5;------------------------------------------------------------		lda	my_res_eof		ora	my_res_eof+2		; res EOF <> 0?		beq	not_extended		lda	#5			; it's an extended file		bra	got_storenot_extended		lda	my_data_eof		; AND $FFFF FE00 to see if		and	#$FE00			; EOF >= $200		ora	my_data_eof+2		; is it a seedling?		bne	not_seedling		lda	#1			; it's a seedling		bra	got_storenot_seedling		lda	my_data_eof+2		; high word AND $FE00		and	#$FE00			; to see if >= $2 0000		bne	not_sapling		lda	#2			; it's a sapling		bra	got_storenot_sapling		lda	#3			; must be a treegot_store		sta	my_store_typeexit		rts		endwith				; with dp		endp;------------------------------------------------------------; return_parms;; This routine takes the local copy of the file info and; places it in the user's Get_Dir_Entry parameter list.;; On entry:;	Full native mode;	Assumes local file info set up;	pcount = parameter count - 5 (first 5 required);; On exit;	Full native mode;	user parameter block updated;;------------------------------------------------------------return_parms	proc		with	dp,mydata				import	send_option		ProcName return_parms				lda	#0			; default: not extended		ldx	my_store_type		cpx	#5			; storage type = 5?		bne	got_flags		; if not, normal file		lda	#$8000			; was extended!got_flags		ldy	#p.flags		sta	[my_pb_ptr],y		; store flag word		lda	long_name		; get long name length		and	#$00FF			; only 1 length byte		sta	math_temp		; save length as word		ldy	#p.name		lda	[my_pb_ptr],y		sta	dest_ptr		; copy pointer to		iny				; output string		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2		lda	#buffer_small		; assume buffer is too small		sta	my_error		; save as error code				lda	[dest_ptr]		; get buffer size		cmp	#4			; must be at least 4 bytes!		bge	@min			; well, at least 4 bytes		sec		lda	#invalid_parm		; <4 => parameter error		brl	exit			; exit call now@min						; fall through => carry set		sbc	#4			; subtract 4 for length words		cmp	math_temp		; is buffer len >= name length?		blt	trunc			; buffer < namne length, so truncate		lda	math_temp		; get name length in A		stz	my_error		; no error (name fit)trunc;------------------------------------------------------------; Here, there is something to transfer.  A holds number; of characters to copy (entire name length or usable; buffer size -- whichever is smaller).;------------------------------------------------------------		tax				; save length to copy in X		ldy	#2		lda	math_temp		; get actual length		sta	[dest_ptr],y		; and return to user				clc		lda	dest_ptr		; point to byte before actual		adc	#3			; string data (where a length		sta	dest_ptr		; byte would go if it was a		lda	dest_ptr+2		; pascal string).		adc	#0		sta	dest_ptr+2				txy				; length back in Y		beq	too_small		; nothing to copy!		sep	#$20			; 8 bits for chars		longa	offloop		lda	long_name,y		; copy one char		sta	[dest_ptr],y		dey		bne	loop			; all but length byte		rep	#$20			; back to full native		longa	ontoo_small		lda	pcount			; anything else to return?		bne	more1		brl	done			; all donemore1; 20-Sep-91 MSD: Return entry_num only if the resulting entry number was valid		ldy	#p.entry_num		lda	dir_index		; get current entry number		sta	[my_pb_ptr],y		; update parameter block; End 20-Sep-91 MSD		dec	pcount			; entry_num already returned		bne	more2		brl	done			; all donemore2				ldy	#p.filetype		; note: filename copy destroys Y		lda	my_filetype		sta	[my_pb_ptr],y		; return filetype		dec	pcount		bne	more3		brl	done			; all donemore3				iny		iny				; Y = p.eof		lda	my_data_eof		sta	[my_pb_ptr],y		; return EOF low		iny		iny		lda	my_data_eof+2		sta	[my_pb_ptr],y		; return EOF high		dec	pcount		bne	more4		brl	done			; all donemore4				iny		iny				; Y = p.blks		lda	my_data_blks		sta	[my_pb_ptr],y		; return blocks used low		iny		iny		lda	my_data_blks+2		sta	[my_pb_ptr],y		; return blocks used high		dec	pcount		bne	more5		brl	donemore5		iny		iny				; Y = p.cr_date		lda	my_cr_date		; return create date/time		sta	[my_pb_ptr],y		iny		iny		lda	my_cr_date+2		sta	[my_pb_ptr],y		iny		iny		lda	my_cr_date+4		sta	[my_pb_ptr],y		iny		iny		lda	my_cr_date+6		sta	[my_pb_ptr],y		dec	pcount		bne	more6		brl	donemore6				iny		iny				; Y = p.mod_date		lda	my_mod_date		; return mod date/time		sta	[my_pb_ptr],y		iny		iny		lda	my_mod_date+2		sta	[my_pb_ptr],y		iny		iny		lda	my_mod_date+4		sta	[my_pb_ptr],y		iny		iny		lda	my_mod_date+6		sta	[my_pb_ptr],y		dec	pcount		bne	more7		brl	donemore7				iny		iny				; Y = p.access		lda	my_access		sta	[my_pb_ptr],y		; return access word		dec	pcount		bne	more8		brl	donemore8		iny		iny				; Y = p.auxtype		lda	my_auxtype		sta	[my_pb_ptr],y		; return auxtype low		iny		iny		lda	my_auxtype+2		; return auxtype high		sta	[my_pb_ptr],y		dec	pcount		beq	done				iny		iny				; Y = p.file_sys		lda	#my_fst_id		; I'm AppleShare		sta	[my_pb_ptr],y		; return file system ID		dec	pcount		beq	done;		bra	opt_ok			; ignore option_list for now		iny		iny				; Y = p.opt_list		lda	[my_pb_ptr],y		; get option list address		sta	src_ptr			; save a pointer to it		iny		iny		lda	[my_pb_ptr],y		sta	src_ptr+2				jsr	send_option		; return option_list		bcs	exit		dec	pcount			; account for option_list		beq	done		ldy	#p.res_eof		lda	my_res_eof		sta	[my_pb_ptr],y		; return resource EOF low		iny		iny		lda	my_res_eof+2		sta	[my_pb_ptr],y		; return resource EOF high		dec	pcount		beq	done				iny		iny				; Y = p.res_blks		lda	my_res_blks		sta	[my_pb_ptr],y		; return resource blocks used		iny		iny		lda	my_res_blks+2		sta	[my_pb_ptr],ydone				clc		lda	#0exit		rts		endwith				; with dp		endp;------------------------------------------------------------; do_tot_ent;; This routine simply calculates the number of directory; entries in this directory (i.e., its offspring count); and returns it in the entry_num field.;; On entry:;	Full native mode;; On exit:;	Full native mode;;------------------------------------------------------------do_tot_ent	proc		with	dp,mydata		ProcName do_tot_ent				lda	pcount		beq	ok_exit		lda	#afpGetFlDrParms	; FPGetFileDirParms		jsr	StartPacket				jsr	PutIDs			; put VolID, DirID in packet				lda	#$0001			; get file number for files		jsr	PutWord			; put file bitmap				lda	#$0002			; get offspring count for folder		jsr	PutWord			; put directory bitmap				lda	#afp_long		; AFP long names, null path		jsr	PutWord			; put path type, null path				jsr	SendPacket		bcs	exit		jsr	StartReply		; get read to read the reply				jsr	GetLong			; ignore bitmaps				jsr	GetWord			; ignore file/dir flag				jsr	GetWord			; get offspring count		xba				; low-high format				ldy	#p.entry_num		sta	[my_pb_ptr],y		; return number of entries				ldy	#fcr.dirindex		lda	#0			; start enumeration from 0		sta	[my_fcr_ptr],yok_exit		clc		lda	#0exit		rts		endwith				; with dp		endp		end