;------------------------------------------------------------; Get_Dev_Num;; This call takes a device or volume name and returns the; corresponding device number.  If a device name was given,; GS/OS has already done most of the work and all I have to; do is copy the device number into the users parameter list.; If a volume name was given, I have to scan devices to find; one with a matching volume name.;; On entry:;	Full native mode;; On exit:;	Full native mode;; Modification history:; 06-Jul-88	MSD	Started coding.;------------------------------------------------------------		load	'equates.dump'		import	PreProcess:code		import	FindVol:code		import	main_exit:code		import	mydata:tdata;------------------------------------------------------------; Structure of Get_Dev_Num parameter list;------------------------------------------------------------p		record	0		ds.l	1			; pointer to volume namedevnum		ds.w	1			; volume's device number		endrget_dev_num	proc	export		with	dp,mydata		ProcName get_dev_num				jsr	PreProcess	; set up for call;------------------------------------------------------------; The reason I don't just call FindVol is that it would; return an unknown volume error if a device name or a non-; AppleShare device was used.  For this call only, I should; handle any device name given to me with no errors.;------------------------------------------------------------		lda	src_dev_num	; device name given?		bne	have_it		; no, look for name;------------------------------------------------------------; Now I have to go find the volume.  Do it by finding the; pathname passed and then check to make sure it really; was a volume (DirID=2, partial path='').;------------------------------------------------------------		sta	my_dev_num	; tell FindVol no device given		lda	path_1_addr	; set my_path_ptr to point to		sta	my_path_ptr	; the volume name to be processed		lda	path_1_addr+2	; (this is normally done by		sta	my_path_ptr+2	;  proc_path1 and proc_path2).		jsr	FindVol		; go find the volume		bcs	exit		; report any errors; This code commented out because get_dev_num now allows full; pathnames to be given.;; Of course, it doesn't actually check whether the filename; given really exists, it just tries to find the volume.;;		lda	my_path_len	; volume name only?;		beq	good_syntax	; if so, grab dev num;		;		sec;		lda	#invalid_path	; invalid volume name syntax;		bcs	exitgood_syntax		ldy	#vcr.dev		lda	[my_vcr_ptr],y	; get device number from VCRhave_it		ldy	#p.devnum		sta	[my_pb_ptr],y	; return to user		clc		lda	#0exit		jmp	main_exit		endwith			; with dp,mydata		endp		end