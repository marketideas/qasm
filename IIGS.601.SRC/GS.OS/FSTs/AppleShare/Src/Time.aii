;------------------------------------------------------------; File: time.aii;; This file contains the routines used to convert time/date; values between several formats.  There is also a day-of-week; calculation routine used in calculating the day of the week; given the month, day of the month, and year.  Utility routines; are provided to get create and mod dates from a reply packet.;; The conversion routines and their coversions are:;; time_pro_tool		ProDOS	=> Toolbox; time_tool_pro		Toolbox	=> ProDOS;; time_afp_tool		AFP	=> Toolbox; time_tool_afp		Toolbox	=> AFP;; time_pro_afp		ProDOS	=> AFP; time_afp_pro		AFP	=> ProDOS;; dow_convert		Toolbox	=> day of week;; get_cr_date		Read AFP date from packet and save;			create date/time in my_cr_date.;; get_mod_date		Read AFP date from packet and save;			mod date/time in my_mod_date.;; GetDate		Read AFP date from packet into;			my_date_afp.;; Note: ProDOS month is in range 1..12 and day is 1..31; where the Toolbox uses ranges 0..11 and 0..30 respectively.;; 19-Sep-89	msd	Changed time_afp_tool to use discreet;			subtracts instead of a series of;			divides to convert time.;; 24-Jan-92	MSD	¥ time_afp_tool now supports dates after;			the year 2000.  All dates prior to 1933;			are pinned to Jan 1, 1933 12:00:00 AM.;			¥ time_tool_pro changes years less than;			1940 or greater than 2039 to all-zeroes;			for date/time (i.e. unknown date/time).;			¥ tim_pro_tool converts years from 1900;			through 1939 to 2000 through 2039.;			¥ time_tool_afp converts unknown dates;			or those before 1933 to the smallest;			value possible (my_date_afp set to;			$80000000).;;------------------------------------------------------------		load	'equates.dump'		import	mydata:tdata		entry	dow_convert:code;------------------------------------------------------------; Define a bunch of constants to be used by time_afp_tool.; These are the number of seconds in the indicated time period.;------------------------------------------------------------min1		equ	60			; 1 minutemin2		equ	2*min1			; 2 minutesmin4		equ	2*min2			; 4 minutesmin8		equ	2*min4min16		equ	2*min8min32		equ	2*min16hour1		equ	60*min1			; 1 hourhour2		equ	2*hour1			; 2 hourshour4		equ	2*hour2hour8		equ	2*hour4hour16		equ	2*hour8day1		equ	24*hour1			; 1 dayday2		equ	2*day1day4		equ	2*day2day8		equ	2*day4day16		equ	2*day8month1		equ	30*day1			; 1 month (30 days)month2		equ	2*month1month4		equ	2*month2month8		equ	2*month4; Note: for years, these constants are for CONSECUTIVE years so I can; include the correct number of leap days.year1		equ	365*day1		; 1 year (not a leap year)year2		equ	2*year1			; 2 years (neither a leap year)year4		equ	4*year1+day1		; 4 years (one of which is a leap year)year8		equ	2*year4			; 8 yearsyear16		equ	2*year8year32		equ	2*year16year64		equ	2*year32year128		equ	2*year64;------------------------------------------------------------; Define a macro to make life easier.  It performs one trial; subtraction, including shifting in the 0/1 bit into the; correct time field.;; Note: It assumes that my_date_afp is kept primarily in X,Y; (low order in X).  Temporary remainder is kept in; "remainder" on direct page.;; Also, if the constant is less than 32K, then the current; remainder can only be <64K, Y = 0, and #^const = 0.; In this case, the subtract of the high word is useless,; and a shorter (and faster) form of the macro is used.;; 30-Jan-92 MSD: The test for &const > 32768 wasn't doing; what I intended with the year128 constant which was being; considered negative and therefore not > 32768 and using; the wrong form of the macro.  I now test by shifting out the; low 15 bits and seeing if the remaining 17 bits are non-zero.;------------------------------------------------------------		macro&lab		trysub	&const,&field&lab		sec				; set up for SBC		IF	(&eval(&const)>>15) <> 0 THEN		txa				; low word in A		sbc	#<&const		; subtract low order		sta	remainder		; save temporary on dp		tya				; high word in A		sbc	#^&const		; subtract high order		bcc	@over			; subtract failed?		tay				; subtract worked:		ldx	remainder		; copy remainder back into X,Y		ELSE		txa		sbc	#<&const		; subtract constant		bcc	@over			; subtract failed?		tax				; no, so copy remainder back to x		ENDIF@over		rol	&field			; shift 0/1 bit into correct field		endmquotients	record		entry	yr4,yr,mo,dy,hr,min,secyr4		dc.w	0yr		dc.w	0mo		dc.w	0dy		dc.w	0hr		dc.w	0min		dc.w	0sec		dc.w	0		endrmonth_adjust	dc.w	0,1,-1,0,0,1,1,2,3,3,4,4,5month_days	record		entry	feb_days		dc.w	31feb_days	dc.w	28		dc.w	31,30,31,30,31,31,30,31,30,31		endrdc_const	record		dc.l	60*60*24*(365*4+1)		; seconds per 4 years		dc.l	60*60*24*365			; seconds per year		dc.l	60*60*24*30			; seconds per month (30 days)		dc.l	60*60*24			; seconds per day		dc.l	60*60				; seconds per hour		dc.l	60				; seconds per minute		endrafp_adjust	dc.l	2114294400			; seconds from 1933 to 2000time_pro_tool	proc	export		with	mydata				ProcName time_pro_tool				stz	my_date_tool		stz	my_date_tool+2		stz	my_date_tool+4		stz	my_date_tool+6			; assume unknown date		lda	my_date_pro		ora	my_date_pro+2		beq	done				; skip if unknown		lda	my_date_pro+2			; get minutes and hours		sta	my_date_tool+1			; save minutes and hours				lda	my_date_pro+1		and	#$FF				; get year only		lsr	a				; get rid of extra bit; Begin 24-Jan-92 MSD		cmp	#40				; years less than 40 get converted		bge	@ok				; to 2000..2039.		adc	#100				; (note: carry was clear)@ok; End 24-Jan-92 MSD		sta	my_date_tool+3		lda	my_date_pro		and	#$001F				; get day only		beq	bad				; day 0 is invalid		dea					; toolbox uses 0-30		sta	my_date_tool+4			; overwrites month				lda	my_date_pro		and	#$01E0				; get month only		asl	a				; do 3 bit shift left		asl	a				; and 8 bit shift right		asl	a				; to get 5 bit shift right		xba		beq	bad				; no month => invalid		dea					; toolbox uses 0-11		sta	my_date_tool+5			; overwrites null byte				jsr	dow_convert			; get day-of-weekdone		clc					; no error		rtsbad		sec		lda	#invalid_parm			; illegal date value		rts				endwith		endptime_tool_pro	proc	export		with	mydata				ProcName time_tool_pro				stz	my_date_pro		stz	my_date_pro+2			; assume unknown date		lda	my_date_tool		ora	my_date_tool+2		ora	my_date_tool+4		ora	my_date_tool+6		beq	done				; skip if unknown date/time; Begin 24-Jan-92 MSD: If the year is outside the range 1940..2039, leave the; date/time as unknown.  While we've got the year, convert and store it.		lda	my_date_tool+3			; get the year		and	#$00FF				; just one byte		cmp	#40				; before 1940?		blt	done				; yes, unknown		cmp	#140				; 2040 or after?		bge	done				; yes, unknown		cmp	#100				; 2000 or after?		blt	is_19xx		sbc	#100				; yes, so convert to 0..39	is_19xx		asl	a				; year is upper 7 bits of byte		sta	my_date_pro+1			; store year in ProDOS date; End 24-Jan-92 MSD		lda	my_date_tool+1			; get minutes and hours		sta	my_date_pro+2			; write minutes and hours		lda	my_date_tool+4			; get day of month		and	#$001F				; only one byte		ina					; convert to 1..31		ora	my_date_pro			; combine with year		sta	my_date_pro			; overwrites month, year		lda	my_date_tool+5			; get month		and	#$000F				; only one byte		ina					; convert to 1..12		xba					; need to shift 5 bits left		lsr	a				; by 8 bit shift left and		lsr	a				; 3 bit shift right		lsr	a		ora	my_date_pro			; add to day and year		sta	my_date_prodone		rts		endwith		endp;------------------------------------------------------------; time_afp_tool;; This routine converts from seconds since Jan 1, 2000; (AFP time) to Toolbox date/time.  AFP's range allows for; dates slightly before 1932 until slightly after 2068.  I; will allow the subset 1933-1999.;; Internally, I convert to seconds since Jan 1, 1933 before; computing the date and time.  This base year must be one; more than a multiple of 4 so that a leap year is the last; year in a four year period.;; (19-Sep-89) Instead of looping through 6 long divides,; I can do trial subtractions for each possible bit to be; set in the toolbox format (4 bits month + 5 bits date+; 7 bits year + 5 bits hour + 6 bits minute = 27 bits), which; results in less work than a single long divide!  (Note:; the 6 bits of seconds are the remainder after I've removed; all of the other, larger, time units).;; On entry:;	my_date_afp = seconds since Jan. 1, 2000;		(note: in 65816 order, NOT 68000 order);; On exit:;	my_date_tool = converted date/time;;------------------------------------------------------------time_afp_tool	proc	export		with	dp,mydata		ProcName time_afp_tool				stz	my_date_tool		stz	my_date_tool+2		stz	my_date_tool+4		stz	my_date_tool+6			; clear any garbage;------------------------------------------------------------; Convert to seconds since Jan 1, 1933.  Earlier dates are; pinned to Jan 1, 1933 (i.e. use 0 seconds).;------------------------------------------------------------; 24-Jan-92 MSD: Removed test for AFP dates after 2000 (i.e.; positive numbers in my_date_afp).		clc		lda	my_date_afp		adc	afp_adjust		sta	my_date_afp		lda	my_date_afp+2		adc	afp_adjust+2		sta	my_date_afp+2; 24-Jan-2 MSD: If the result of the add is a positive number (or negative with; overflow meaning a large positive number), keep it.  Otherwise, it was before; 1933, so pin it to the start of 1933.		bpl	ok_year		; 1933..2001+		bvs	ok_year		; 2001+..2068+ (i.e. very large positive number)		stz	my_date_afp	; negative offset from 1933, so pin to 1933		stz	my_date_afp+2ok_year; End 24-Jan-92 MSD;------------------------------------------------------------; Compute how many 4 year, 1 year, 1 month, 1 day, 1 hour,; 1 minute, 1 second periods have elapsed since 1933.; Note: a month is assumed to have 30 days; corrections will; be made to account for months with other than 30 days.;------------------------------------------------------------		jsr	trial_subs			; go do subtracts		;------------------------------------------------------------; Handle the special case of Dec 31 on a leap year which gets; calculated as Jan 1 of next year.;; The date gets set to Dec 35 because this is the date it; would have been before the adjustments for leap day and; months with other than 30 days.;------------------------------------------------------------		lda	yr		cmp	#4		bne	no_special		dec	yr				; back to current year		lda	#11				; month is December		sta	mo		lda	#35				; day is 35		sta	dyno_special;------------------------------------------------------------; Calculate year as 1933 plus years elapsed;------------------------------------------------------------		lda	yr4		asl	a				; get full 4 year periods		asl	a				; note: clears carry		adc	yr		adc	#33		sta	yr				; = years since 1900;------------------------------------------------------------; Check for leap year;------------------------------------------------------------		lda	#28				; assume 28 days in		sta	feb_days			; February		lda	yr		and	#3		bne	not_leap		inc	feb_days			; February has 29 days!		lda	mo		cmp	#2				; past Feb?		blt	not_leap		dec	dy				; adjust for leap yearnot_leap;------------------------------------------------------------; Adjust for months with other than 30 days;------------------------------------------------------------		lda	mo		asl	a				; index to month adjust		tax		sec		lda	dy		sbc	month_adjust,X		sta	dy		bpl	is_adjusted			; if day negative, back up		dec	mo				; one month		dex		dex					; index to previous month		clc					; 30-Jan-92 MSD		adc	month_days,x			; add to days in previous month		sta	dyis_adjusted;------------------------------------------------------------; Check for too many days in Feb;------------------------------------------------------------		lda	mo		cmp	#1				; Feb?		bne	not_feb		lda	dy		sec		sbc	feb_days		bcc	not_feb				; if less, OK		sta	dy		inc	mo				; month becomes Marchnot_feb;------------------------------------------------------------; Move temporary variables to Toolbox date;------------------------------------------------------------		sep	#$30		longa	off		longi	off				lda	sec		sta	my_date_tool		lda	min		sta	my_date_tool+1		lda	hr		sta	my_date_tool+2		lda	dy		sta	my_date_tool+4		lda	mo		sta	my_date_tool+5		lda	yr		sta	my_date_tool+3		rep	#$30		longa	on		longi	on				jsr	dow_convert			; find day of week		rts;------------------------------------------------------------; This is the routine that does the actual subtracts.  It; is separate to make it easier to follow the above code,; and to try to keep branches above shorter.  It takes; my_date_afp and fills in the individual time fields.;------------------------------------------------------------trial_subs		stz	yr4				; clear accumulated sums		stz	yr		stz	mo		stz	dy		stz	hr		stz	min;		stz	sec				; seconds will be stored later;------------------------------------------------------------; Starting with the longest unit of time (128 years), do a; trial subtract of that many seconds.  If it works, shift; in a 1 in the correct field, otherwise shift in a 0; (sounds a lot like division, doesn't it!!).;------------------------------------------------------------		ldx	my_date_afp			; prepare for trial subs		ldy	my_date_afp+2			; and trysub macro		; compute years		trysub	year128,yr4		trysub	year64,yr4		trysub	year32,yr4		trysub	year16,yr4		trysub	year8,yr4		trysub	year4,yr4		trysub	year2,yr		trysub	year1,yr; compute months		trysub	month8,mo		trysub	month4,mo		trysub	month2,mo		trysub	month1,mo; compute days		trysub	day16,dy		trysub	day8,dy		trysub	day4,dy		trysub	day2,dy		trysub	day1,dy; compute hours		trysub	hour16,hr		trysub	hour8,hr		trysub	hour4,hr		trysub	hour2,hr		trysub	hour1,hr; compute minutes		trysub	min32,min		trysub	min16,min		trysub	min8,min		trysub	min4,min		trysub	min2,min		trysub	min1,min				stx	sec				; seconds are left over		rts				endwith					; with dp		endp;------------------------------------------------------------;; On exit:;	carry set if the date was invalid;		overflow undefined;	carry clear if date was valid or all zeroes;		overflow clear if non-zero;		overflow set if all zeroes;;------------------------------------------------------------time_tool_afp	proc	export		with	mydata				ProcName time_tool_afp				stz	my_date_afp		lda	#$8000				; smallest time possible		sta	my_date_afp+2			; assume unknown time		sep	#$40				; set overflow in case all zeroes		lda	my_date_tool		ora	my_date_tool+2		ora	my_date_tool+4		ora	my_date_tool+6			; unknown/default?		bne	do_conv		brl	no_err_exit			; all zero, clear carry and exitdo_conv;------------------------------------------------------------; Break up date/time into individual fields;------------------------------------------------------------		lda	my_date_tool			; get seconds		and	#$00FF				; seconds only		cmp	#60				; <60 seconds?		bge	bad				; no, invalid		sta	sec		lda	my_date_tool+1			; get minutes		and	#$00FF				; minutes only		cmp	#60		bge	bad		sta	min		lda	my_date_tool+2		and	#$00FF		cmp	#24		bge	bad		sta	hr		lda	my_date_tool+4		and	#$00FF		cmp	#31		bge	bad		sta	dy		lda	my_date_tool+5		and	#$00FF		cmp	#12		bge	bad		sta	mo		lda	my_date_tool+3		and	#$00FF		cmp	#33				; before 1933 is unknown		bge	@ok		brl	done				; and remains valid, minimum date@ok		sta	yr		bra	validbad		sec		lda	#invalid_parm		rts		; here, date format is validvalid		stz	my_date_afp+2			; zero out AFP date for adds		lda	#28				; init Feb to 28 days		sta	feb_days;------------------------------------------------------------; Compute year and year/4 fields;------------------------------------------------------------		sec		lda	yr				; get year		sbc	#33				; origin to 1933		sta	yr4				; get years/4		lsr	yr4		lsr	yr4		and	#3				; get year mod 4		sta	yr;------------------------------------------------------------; Check for leap year;------------------------------------------------------------		cmp	#3				; leap year if year mod 4 = 3		bne	not_leap		lda	mo		cmp	#2				; before march?		blt	not_leap			; if so, not leap day yet		inc	dy				; add leap daynot_leap;------------------------------------------------------------; Adjust for months not = 30 days;------------------------------------------------------------		lda	mo				; get month		asl	a				; times two for index		tax		lda	month_adjust,x			; get adjustment for this month		clc		adc	dy				; added to day of month		bpl	ok_dy				; don't let day go negative		dec	mo				; March -> Feb		lda	#29				; March 1 -> "Feb 29"ok_dy		sta	dy;------------------------------------------------------------; Now multiply each value by seconds per unit time;------------------------------------------------------------		ldy	#0				; index to constants		ldx	#0				; index to date valuesmul_loop		phy					; Y will be destroyed by mult		phx					; save X, too		pha					; push room for result		pha					; (4 words -- 2 longs)		pha		pha		pea	0				; push high word of zero		lda	quotients,x			; get date value		pha					; push as low word		lda	dc_const+2,y			; get seconds per time unit		pha		lda	dc_const,y		pha		ldx	#$0C0B				; _LongMul		jsl	$E10000		clc		pla					; get low word of product		adc	my_date_afp			; add to total		sta	my_date_afp		pla		adc	my_date_afp+2		sta	my_date_afp+2		pla					; ignore high long		pla		plx					; restore X		ply					; restore Y		inx		inx					; point to next date value		iny		iny		iny		iny					; point to next constant		cpx	#12				; reached seconds yet?		bne	mul_loop			; if not, do more				clc		lda	sec				; don't forget seconds		adc	my_date_afp			; add to total		sta	my_date_afp		lda	my_date_afp+2		adc	#0				; high word of seconds = 0		sta	my_date_afp+2;------------------------------------------------------------; Adjust from 1933 base to 2000 base;------------------------------------------------------------		sec		lda	my_date_afp		sbc	afp_adjust		sta	my_date_afp		lda	my_date_afp+2		sbc	afp_adjust+2		sta	my_date_afp+2done		clv					; signal valid, non-zerono_err_exit		clc		rts		endwith		endptime_pro_afp	proc	export				ProcName time_pro_afp				jsr	time_pro_tool		bcs	exit		jsr	time_tool_afpexit		rts		endptime_afp_pro	proc	export		ProcName time_afp_pro				jsr	time_afp_tool		jsr	time_tool_pro		rts		endpdow_convert	proc		with	dp,mydata		ProcName dow_convert				stz	math_temp			; clear leap year counter		sep	#$30				; need to manipulate bytes		longa	off		longi	off		;------------------------------------------------------------; Find leap years since 1900;------------------------------------------------------------		lda	my_date_tool+3		tay					; save year for use later		lsr	a		lsr	a		sta	math_temp;------------------------------------------------------------; If it is a leap year and Jan or Feb, subtract 1 since we; haven't gotten to this year's leap day;------------------------------------------------------------		tya					; get year back		and	#3				; leap year		bne	not_leap			; no, not a leap year		lda	my_date_tool+5			; OK, what month is it?; 30-Jan-92 MSD: was CMP #3 but month is 0-based, so month 2 is March.		cmp	#2				; before March?		bge	not_leap			; if not, keep leap day		dec	math_temp			; kill this year's leap daynot_leap;------------------------------------------------------------; Add leap years, year, constant for month, and days.; Note: a non-leap year has 52 weeks plus 1 day.;------------------------------------------------------------		lda	my_date_tool+5		asl	a		tax					; index to month adjust table		rep	#$30				; back to 16 bits for add		longa	on		longi	on				clc		tya					; get years back		adc	math_temp			; plus leap years		sta	math_temp			; save for a bit		lda	my_date_tool+4		and	#$FF				; only want days		adc	math_temp			; add to total		adc	month_adjust,x			; add constant for month;------------------------------------------------------------; Take result modulo 7;------------------------------------------------------------mod_loop		cmp	#7		blt	mod_done		sbc	#7				; note: carry is set		bra	mod_loopmod_done		ina					; convert to 1..7		ora	my_date_tool+7			; assume byte was 0		sta	my_date_tool+7			; save day of week		rtsmonth_adjust		dc.w	1,4,4,0,2,5,0,3,6,1,4,6		endwith				; with dp		endp;------------------------------------------------------------; GetDate;; Read an AFP date from the current reply packet and put; it in 65816 order in my_date_afp.;;------------------------------------------------------------GetDate		proc	export		with	mydata		import	GetLong:code		ProcName GetDate				jsr	GetLong			; get date/time				xba				; high word in 65816 order		sta	my_date_afp+2		txa				; low word in A		xba		sta	my_date_afp		rts				endwith		endp;------------------------------------------------------------; Get_cr_date;; Read an AFP date from the current reply packet and convert; it to the appropriate type for the current class.  The; result is stored in my_cr_date.;;------------------------------------------------------------get_cr_date	proc	export		with	mydata		ProcName get_cr_date				jsr	GetDate			; get date into my_date_afp				jsr	time_afp_tool		; convert to toolbox form		lda	dp.class		; class 0?		beq	class0			; if so, do more		lda	my_date_tool		; copy Toolbox date and time		sta	my_cr_date		; to create date and time		lda	my_date_tool+2		sta	my_cr_date+2		lda	my_date_tool+4		sta	my_cr_date+4		lda	my_date_tool+6		sta	my_cr_date+6		rts				; return to callerclass0		jsr	time_tool_pro		; convert to ProDOS form				lda	my_date_pro		; copy ProDOS date to		sta	my_cr_date		; create date and time		lda	my_date_pro+2		sta	my_cr_date+2				rts				endwith		endp;------------------------------------------------------------; Get_mod_date;; Read an AFP date from the current reply packet and convert; it to the appropriate type for the current class.  The; result is stored in my_mod_date.;;------------------------------------------------------------get_mod_date	proc	export		with	mydata		ProcName get_mod_date				jsr	GetDate			; get date into my_date_afp				jsr	time_afp_tool		; convert to toolbox form		lda	dp.class		; class 0?		beq	class0			; if so, do more		lda	my_date_tool		; copy Toolbox date and time		sta	my_mod_date		; to create date and time		lda	my_date_tool+2		sta	my_mod_date+2		lda	my_date_tool+4		sta	my_mod_date+4		lda	my_date_tool+6		sta	my_mod_date+6		rts				; return to callerclass0		jsr	time_tool_pro		; convert to ProDOS form				lda	my_date_pro		; copy ProDOS date to		sta	my_mod_date		; create date and time		lda	my_date_pro+2		sta	my_mod_date+2				rts				endwith		endp		end