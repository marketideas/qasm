;------------------------------------------------------------;; Create;; This call creates a file or directory.  Some ProDOS info; can also be set at create time (access rights, filetype; and auxtype, for example).;; Class 1: data EOF and resource EOF are ignored (since; there is no way I can reserve the storage space and keep; the EOF's at 0).;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 12-Jul-88	MSD	Started coding.; 15-Aug-88	MSD	Com_set_info moved to setinfo.aii;			since it is not used by Create.; 29-Aug-88	MSD	If filetype = $0F and storage type;			not given, assume storage type = $0D;			(for directories).;  1-Sep-88	MSD	Create with volume name gets invalid;			pathname error.; 10-Nov-88	MSD	Storage type of $8005 means to add a;			resource fork to existing file, or;			create extended file.;  8-Feb-89	MSD	Fixed problem in converting class 0;			create date/time.  Storage type $0D;			forces filetype $0F, auxtype $0000.; 12-Nov-90	MSD	Create of a directory now sets default;			privileges, owner name, group name.; 26-Sep-91	MSD	Change to use new format for default;			privileges.; 30-Jan-92	MSD	Due to the date/time routines now supporting;			dates after the year 2000, I can no longer use;			all-zeroes for an AFP date as a "no date given";			flag.  Class 0 Create only sets the create date;			if a non-zero one was given.  Class 1 never sets;			the create date.;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit,CheckParent):code		import	proc_path1:code		import	(StartPacket,SendPacket):code		import	(PutWord,PutLong,PutByte):code		import	(PutPath,PutIDs,PutBlock):code		import	PutPString:code		import	(StartReply,GetWord,GetLong):code		import	convert_access:code		import	time_pro_afp:code		import	com_set_info:code		import	mydata:tdata;------------------------------------------------------------; Format of Create parameter list;------------------------------------------------------------p		record	0		ds.l	1			; pointer to pathnameaccess		ds.w	1filetype	ds.w	1auxtype		ds.l	1store_type	ds.w	1cr_date		ds.l	1			; class 0 only: create date/time		endr;------------------------------------------------------------; bitmaps for SetFileDirParms;------------------------------------------------------------set_pdos	equ	$0020			; set ProDOS infoset_attr	equ	$0100			; set attributesset_cr_date	equ	$0400			; set create date/timecreate_bits	equ	set_pdos+set_attr	; 30-Jan-92 MSD: removed +set_cr_datecreate		proc	export		with	dp,mydata		ProcName create		;; First off, set up the default parameters for class 1;; 30-Jan-92 MSD: Don't need to initialize date vars because they will be assigned; only if they were supplied.  Otherwise, they won't get transmitted anyway.;;		stz	my_cr_date		; default: current time;		stz	my_cr_date+2;		stz	my_mod_date		; force mod date to current;		stz	my_mod_date+2		; date and time		stz	my_store_type		; default: file		stz	my_filetype		; filetype = 0		stz	my_auxtype		; auxtype = 0		stz	my_auxtype+2		lda	#$E3			; full access		sta	my_access				lda	#create_bits		; 30-Jan-92 MSD:		sta	my_bitmap		; set default parameters to set				jsr	PreProcess		; check parameters		lda	class			; class 0?		bne	class1pcnt		lda	#5			; class 0 shares first		sta	pcount			; 5 parms with class 1;; For class 0, get create date/time supplied by user.;		ldy	#p.cr_date		lda	[my_pb_ptr],y		; get ProDOS create date/time		sta	my_date_pro		iny		iny		lda	[my_pb_ptr],y		sta	my_date_pro+2						; 30-Jan-92 MSD:		ora	my_date_pro		; was a valid date supplied?		beq	class1pcnt		; no, so don't set date		lda	#set_cr_date		; cause create date to be set		tsb	my_bitmap		; 30-Jan-92 MSD				jsr	time_pro_afp		; convert to AFP format		bcs	go_exit			; exit if error in date/time				lda	my_date_afp+2		xba		sta	my_cr_date		lda	my_date_afp		; save AFP format create date/time		xba		sta	my_cr_date+2class1pcnt		dec	pcount			; down 1 for filename		beq	doit			; if that's all, do it;; Now replace default values with user-supplied ones (if any);		ldy	#p.access		lda	[my_pb_ptr],y		; get access word		sta	my_access		; save user's access		jsr	convert_access		bcc	ok_accessgo_exit		brl	exit			; return error if anyok_access		dec	pcount			; is that all?		beq	doit				iny				; point to filetype		iny		lda	[my_pb_ptr],y		; get filetype		bit	#$FF00			; high byte must be 0		bne	go_do_parm_err		sta	my_filetype		; save user's filetype		cmp	#$0F			; directory filetype?		bne	not_dir			; no, don't bother		lda	#$0D			; gotta use directory storage type		sta	my_store_typenot_dir		dec	pcount		beq	doit		ldy	#p.auxtype+2		lda	[my_pb_ptr],y		; get auxtype high wordgo_do_parm_err	beq	@ok_aux		brl	do_parm_err@ok_aux		dey		dey				; point to auxtype		lda	[my_pb_ptr],y		sta	my_auxtype		; save user's auxtype		dec	pcount		beq	doit				ldy	#p.store_type		lda	[my_pb_ptr],y		; get storage type		cmp	#$D			; directory?		beq	ok_store		; its OK		cmp	#5			; extended?		beq	ok_store		; its OK		cmp	#$8005			; extend (add resource fork)?		beq	ok_store		cmp	#4			; 0-3 (file)?		bge	do_parm_err		lda	#1			; force a seedling		sta	[my_pb_ptr],y		; return type createdok_store		sta	my_store_type;		dec	pcount			; don't need -- this is last parm;		beq	doit			; 30-Jan-92 MSD;; Currently I don't care what the EOF and resource EOF are given; since I can't allocate space anyway (since the actual EOF must; be set to 0).;doit;; If the storage type was directory, force filetype and auxtype;		lda	my_store_type		cmp	#$D			; is it a directory?		bne	@not_dir		; no, don't change type				lda	#$F			; directory file type		sta	my_filetype		stz	my_auxtype		; force zero auxtype		stz	my_auxtype+2@not_dir		jsr	convert_access		; my_access => attributes		stz	attributes		; attributes are created clear!				jsr	proc_path1		; parse pathname		bcs	exit		;------------------------------------------------------------; Check for volume name only given.  If so, return with an; invalid pathname error.;------------------------------------------------------------		lda	volume_sep		; volume only?		bne	not_volume		sec		lda	#invalid_path		; volume only is not valid		bcs	exit			; return the error.not_volume; get appropriate create command in A		ldx	my_store_type		; get storage type		lda	#afpFileCreate		; assume file creation		cpx	#$D			; was it a directory?		bne	ok_create		dea				; change A to afpDirCreateok_create		jsr	StartPacket		jsr	PutIDs			; copy VolID, DirID to packet		sec				; force alignment		jsr	PutPath			; put partial path in packet				jsr	SendPacket		; shoot it out the door		jsr	CheckParent		; check for path not found		cmp	#dup_path		; does file already exist?		beq	extend			; if so, see if they want to extend it		cmp	#1			; set carry if error		bcs	exit			; return if error		lda	my_bitmap		; 30-Jan-92 MSD: set only what was supplied		jsr	com_set_info		; send out SetFileDirParms		bcs	exit			; return any error		;------------------------------------------------------------; If a directory was created, see if I need to set any default; access privileges.;------------------------------------------------------------		lda	my_store_type		cmp	#$D			; directory?		bne	ok_exit			; not a directory, so skip				lda	def_flags		; anything to change?		and	#fSetMask		; test just the defined bits		beq	ok_exit			; no, so just return		jsr	set_def_privs		; set default privilegesok_exit		clc		lda	#0			; no errorexit		jmp	main_exitdo_parm_err		lda	#invalid_parm		sec		bcs	exitdo_dup_path		lda	#dup_path		sec		bcs	exiterr_dir		lda	#res_add_err		; can't add resource fork to dir.		sec		bcs	exiterr_extended		lda	#resource_exist		; file is already extended		sec		bcs	exitextend		lda	my_store_type		; did they want to extend file?		bpl	do_dup_path		; if not, return duplicate path error		;------------------------------------------------------------; Now get file info to make sure it is a file, and without; a resource fork.;------------------------------------------------------------		lda	#afpGetFlDrParms		jsr	StartPacket				jsr	PutIDs				lda	#$0004			; resource fork length		jsr	PutWord				lda	#$0000			; no info for directories		jsr	PutWord				clc				; no alignment on pathname		jsr	PutPath			; tell 'em what file				jsr	SendPacket		jsr	CheckParent		; normally, file DOES exist!		bcs	exit			; file disappeared???				jsr	StartReply				jsr	GetLong			; ignore bitmaps				jsr	GetWord			; get file/dir flag		and	#$0080			; is it a directory?		bne	err_dir			; can't extend directory!				jsr	GetLong			; get resource fork length		stx	math_temp		ora	math_temp		; resource fork length = 0?		bne	err_extended		; it is already extended!				brl	ok_exit			; pretend file got extended		;--------------------------------------------------------------------------------; Here is the subroutine that actually sets the default privileges for folders.;--------------------------------------------------------------------------------set_def_privs;------------------------------------------------------------; Find group ID, then owner ID, then change rights;------------------------------------------------------------		stz	my_bitmap				lda	def_flags		and	#fSetRights		; setting rights?		beq	try_group		; no, check group name				lda	#$0010			; change access rights		tsb	my_bitmap		;------------------------------------------------------------; Change Group Name.  If I can determine the Group ID, then; save it and add its bit to the AFP bitmap.  If no match,; then ignore the error, and don't change group.;------------------------------------------------------------try_group		lda	def_flags		and	#fSetGroup		; changing group name?		beq	try_owner				lda	#afpMapGroupName		jsr	StartPacket		ldx	#<def_group		; point to group PString		ldy	#^def_group		jsr	PutPString		; put group in packet				jsr	SendPacket		; do the call		bcs	try_owner		; bad group, ignore				jsr	StartReply		jsr	GetLong			; get the Group ID		sta	my_group_id		; and save it off		stx	my_group_id+2		lda	#$0008			; group name bit		tsb	my_bitmap		; changing group;------------------------------------------------------------; Change Owner Name.  If I can determine the User ID, then; save it and add its bit to the AFP bitmap.  If no match,; then ignore the error, and don't change owner.;------------------------------------------------------------try_owner		lda	def_flags		; anything to change?		and	#fSetOwner		; changing owner name?		beq	no_owner				lda	#afpMapUserName		jsr	StartPacket		ldx	#<def_owner		; point to owner PString		ldy	#^def_owner		jsr	PutPString		; put owner in packet				jsr	SendPacket		; do the call		bcs	no_owner		; bad owner, ignore				jsr	StartReply		jsr	GetLong			; get the User ID		sta	my_user_id		; and save it off		stx	my_user_id+2		lda	#$0004			; owner name bit		tsb	my_bitmap		; changing ownerno_owner;------------------------------------------------------------; Make the FPSetDirParms call.;------------------------------------------------------------		lda	#afpSetDirParms		jsr	StartPacket				jsr	PutIDs				lda	my_bitmap		jsr	PutWord				sec				; pad after pathname		jsr	PutPath				lda	my_bitmap		and	#$0004			; setting the owner?		beq	skip_owner		; if not, don't put in packet				lda	my_user_id		ldx	my_user_id+2		jsr	PutLong			; put user ID in packetskip_owner		lda	my_bitmap		and	#$0008			; setting group?		beq	skip_group				lda	my_group_id		ldx	my_group_id+2		jsr	PutLong			; put group ID in packetskip_group		lda	my_bitmap		and	#$0010			; setting rights?		beq	skip_rights				ldx	def_access+2		; get group and owner bytes		lda	def_access		; get summary and world		jsr	PutLong			; put access bytes inskip_rights		jsr	SendPacket		; send it out		jsr	CheckParent		; check for path not found		rts				; return any error		endwith				; with dp,mydata		endp		end