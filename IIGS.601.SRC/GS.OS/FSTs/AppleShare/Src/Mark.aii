;------------------------------------------------------------; File: mark.aii;; This file contains the code for the Set_Mark and Get_Mark; calls.  Note: Get_Mark is pretty easy, but Set_Mark has; to deal with buffering and dirty I/O buffers.;;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit):code		import	(get_disp,fill_buffer):code		import	do_flush:code		import	mydata:tdata		;------------------------------------------------------------; Structure of Set_Mark and Get_Mark parameter lists;------------------------------------------------------------p		record	0		ds.w	1		; file reference numberposition	ds.l	1		; mark for Get_Mark, Set_Mark(0)		org	positionbase		ds.w	1		; base for Set_Mark(1)disp		ds.l	1		; displacement for Set_Mark(1)		endr;------------------------------------------------------------; Get_Mark;; This call takes a file reference number and returns the; current position (mark) in the file.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 25-Jul-88	MSD	Started coding.;;------------------------------------------------------------get_mark	proc	export		with	dp,mydata		ProcName get_mark				jsr	PreProcess		; validate the call		ldy	#fcr.mark+2		lda	[my_fcr_ptr],y		; get mark, high word		tax				; save in X		dey		dey		lda	[my_fcr_ptr],y		; get mark low word		ldy	#p.position		sta	[my_pb_ptr],y		; return low word		txa				; recover high word		iny		iny		sta	[my_pb_ptr],y		; return high word		clc				; no error		lda	#0		jmp	main_exit		; done with call		endwith				; with dp		endp;------------------------------------------------------------; Set_Mark;; This call takes a file reference number and position in; the file (the mark).  It will set the current position to; the value given.  This may force a flush of a dirty I/O; buffer and the reading of a new data block if buffering is on.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 25-Jul-88	MSD	Started coding.;  8-Sep-88	MSD	Check for mark>EOF (error if so); 16-Sep-88	MSD	Return any errors from get_disp.; 25-Oct-88	MSD	Added support for buffering.;;------------------------------------------------------------set_mark	proc	export		with	dp,mydata		ProcName set_mark				jsr	PreProcess		; validate the call		jsr	do_flush		; write data, update EOF		bcs	exit		jsr	get_disp		; base/displacement => mark		bcs	exit			; return any errors;------------------------------------------------------------; At this point, the current mark is in A (high), X (low).; Do a bad position error if mark > EOF (mark - EOF - 1 >= 0).;------------------------------------------------------------		sta	cur_mark+2		; save mark for fill_buffer		stx	cur_mark				sta	math_temp		; save high word		txa				; get low word in A		clc				; subtract an extra 1		sbc	cur_eof			; subtract low words		lda	math_temp		; get high word		sbc	cur_eof+2		; subtract high words		bge	do_bad_pos		; error if result >= 0		lda	math_temp		; get high word		ldy	#fcr.mark+2		sta	[my_fcr_ptr],y		; set high word		txa				; get low word		dey		dey		sta	[my_fcr_ptr],y		; set low word		clc				; no errors!		lda	#0exit		jmp	main_exit		; call donedo_bad_pos		sec		lda	#bad_pos		; position out of range		bcs	exit			; do the error		endwith				; with dp		endp		end