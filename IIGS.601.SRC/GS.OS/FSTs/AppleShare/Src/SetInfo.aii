;------------------------------------------------------------;; set_file_info;; This call takes a pathname and sets its file information; (type, auxtype, access, etc.).  The general procedure is to; get all of the file's information, change just the values; supplied in the set_file_info call, and set all of the; file's information.  The alternative method of setting; only the supplied values (by setting only some of the bits; in the bitmap) is prone to errors and doesn't save much; in actual network traffic.;; On entry:;	Full native mode.;; On exit:;	Full native mode.;; Modification history:; 19-Jul-88	MSD	Started coding.; 15-Aug-88	MSD	Com_set_info moved into this file.;  8-Feb-89	MSD	A non-zero mod date in a class 0 call;			was being converted as if it were a;			class 1 date -- fixed.; 28-Jan-91	MSD	Adding new file type conversions defined;			after AppleShare file server was built.;			Added new routine: map_file_type.;			The conversions are:;			$B3 $DBxy -> pdos $70 $B3 $DB $xy;			$D7 $0000 -> pdos 'MIDI';			$D8 $0000 -> pdos 'AIFF';			$D8 $0001 -> pdos 'AIFC';			Note: If FinderInfo is already being;			set (provided in the option_list),;			it takes precedence and these conv-;			ersions do not take place.; 30-Jan-92	MSD	Set create and mod dates only if given and;			they were non-zero.;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit,CheckParent):code		import	proc_path1:code		import	convert_access:code		import	com_get_info:code		import	(StartPacket,SendPacket):code		import	(PutIDs,PutWord,PutLong,PutPath,PutBlock):code		import	(StartReply,GetLong,GetWord,GetBlock):code		import	(time_tool_afp,time_pro_afp):code		import	mydata:tdata				entry	com_set_info:code;------------------------------------------------------------; This template defines the parameter list for Set_File_Info; (past any parameter count field).;------------------------------------------------------------p		record	0		ds.l	1			; pointer to pathnameaccess		ds.w	1filetype	ds.w	1auxtype		ds.l	1null_st		ds.w	1			; null (storage type)create0		ds.l	1			; class 0 create date/timemod0		ds.l	1			; class 0 modified date/time		org	create0			;   - or -create1		ds.b	8			; class 1 create date/timemod1		ds.b	8			; class 1 modified date/timeopt_list	ds.l	1			; pointer to option_listnull_9		ds.l	1			; nullnull_A		ds.l	1null_B		ds.l	1null_C		ds.l	1		endrcr_bit		equ	$0400			; mask of create date/time flagmod_bit		equ	$0800			; mask of mod date/time flagset_attr	equ	$0100			; mask of attributes flagf_info_bit	equ	$2000			; mask of Finder info flagpdos_bit	equ	$0020			; mask of ProDOS info flagset_file_info	proc	export		with	dp,mydata		ProcName set_file_info				jsr	PreProcess		; validate the call		bne	class1		lda	#4			; class 0 shares first 4		sta	pcount			; parameters with class 1class1		jsr	proc_path1		; find the file		bcs	exit;------------------------------------------------------------; Try to get ProDOS filetype and auxtype if the user wanted; to change only the filetype.;------------------------------------------------------------		lda	pcount		cmp	#3			; filetype but not auxtype?		bne	no_get			; if not, skip the get info		stz	my_auxtype		; assume auxtype of 0		stz	my_auxtype+2		lda	#afpGetFlDrParms	; FPGetFileDirParms		jsr	StartPacket				jsr	PutIDs			; put VolID, DirID in packet		lda	#$0020			; only get ProDOS info		jsr	PutWord			; put file bitmap in				lda	#$0020		jsr	PutWord			; put directory bitmap in		clc				; don't have to align		jsr	PutPath			; add pathname to packet				jsr	SendPacket		jsr	CheckParent		; check for path not found		bcs	no_get			; don't get auxtype if error		jsr	StartReply		; start processing reply packet				jsr	GetLong			; ignore bitmaps		jsr	GetLong			; ignore file/dir flag and filetype		jsr	GetLong			; get ProDOS auxtype		sta	my_auxtype		; save ProDOS auxtype		stx	my_auxtype+2no_get;------------------------------------------------------------; Get file info from user's parameter list and update the; bitmap to set only what the user supplied.;------------------------------------------------------------		stz	my_bitmap		; start with clean bitmap		jsr	update_info		; update with user values		bcs	exit			; return error (access word)		lda	my_bitmap		; set what was provided		jsr	com_set_info		; update on server		bcs	exit		clc				; no errors		lda	#0exit		jmp	main_exitupdate_info;------------------------------------------------------------; This subroutine takes the user supplied file info and; updates the local file info variables accordingly.;; The bits in the AFP bitmap are set when those parameters; are pulled from the user's parameter list.;------------------------------------------------------------		dec	pcount			; already used the pathname		ldy	#p.access		lda	[my_pb_ptr],y		; get access word		sta	my_access		; save it		jsr	convert_access		; turn it into AFP access words		bcc	okay_access		brl	update_exit		; propagate parameter errorsokay_access		lda	#set_attr		tsb	my_bitmap		; set attributes bit in bitmap		dec	pcount			; is that all?		bne	@more		brl	done_update		; yep, finish it up@more		ldy	#p.filetype		lda	[my_pb_ptr],y		; get filetype		sta	my_filetype		lda	#pdos_bit		tsb	my_bitmap		; set ProDOS info bit in bitmap		dec	pcount			; anything else, boss?		bne	@more2		brl	done_update@more2		iny		iny				; Y = p.auxtype		lda	[my_pb_ptr],y		; get auxtype low word		sta	my_auxtype		iny		iny		lda	[my_pb_ptr],y		; get auxtype high word		sta	my_auxtype+2		lda	volume_sep		; was it a volume directory?		bne	@okaux			; no, so set auxtype		stz	my_auxtype		; set auxtype to 0 for root		stz	my_auxtype+2@okaux		dec	pcount		bne	@more3		brl	done_update@more3		dec	pcount			; ignore null field		bne	@more4		brl	done_update@more4;------------------------------------------------------------; Do class 1 time conversion.;------------------------------------------------------------		ldy	#p.create1		; do class 1 create date		jsr	date1_to_afp		; convert to AFP format		bcs	@go_go_exit		; exit if there was an error		bvs	@done_cr		; don't set if all zeroes		sta	my_cr_date		stx	my_cr_date+2		lda	#cr_bit		tsb	my_bitmap		; set create date in bitmap@done_cr		dec	pcount			; anything else to do?		bne	@more5		brl	done_update@more5		ldy	#p.mod1			; do class 1 mod date		jsr	date1_to_afp		; convert to AFP format@go_go_exit	bcs	go_exit			; exit if there was an error		bvs	@done_mod		; don't set if all zeroes		sta	my_mod_date		stx	my_mod_date+2		lda	#mod_bit		tsb	my_bitmap		; set mod date in bitmap@done_mod		dec	pcount			; anything else to do?		bne	@more6		brl	done_update@more6;------------------------------------------------------------; Do the option_list now.;------------------------------------------------------------		ldy	#p.opt_list		lda	[my_pb_ptr],y		; get low word of pointer		sta	src_ptr		iny		iny		lda	[my_pb_ptr],y		sta	src_ptr+2		ora	src_ptr			; null pointer?		beq	skip_opt		; yes, so don't do option_list				lda	[src_ptr]		; how many bytes of data?		cmp	#38			; at least FST ID and Finder Info?		blt	skip_opt		; no, so skip it				ldy	#2		lda	[src_ptr],y		; get actual data size		cmp	#34			; at least FST ID and Finder Info?		blt	skip_opt		; no, so skip it				ldy	#4			; offset to FST ID		lda	[src_ptr],y		; get FST ID		cmp	#my_fst_id		; is this mine?		beq	do_opt			; I can use mine		cmp	#hfs_fst_id		; is it HFS?		beq	do_opt			; yes, I like HFS		cmp	#pro_fst_id		; ProDOS?		bne	skip_opt		; no, so skip itdo_opt		ldx	#30			; index to last word of Finder Info		ldy	#36			; index to last word in option_list@loop		lda	[src_ptr],y		; get a word of Finder info		sta	my_f_info,x		; save it off		dey		dey		dex		dex		bpl	@loop			; loop if more to copy				lda	#f_info_bit		; get Finder info bit		tsb	my_bitmap		; and say we're setting itskip_optdone_update		lda	class		bne	class1dates;------------------------------------------------------------; Convert class 0 dates (both create and mod).;------------------------------------------------------------		ldy	#p.create0		; do class 0 create date		jsr	date0_to_afp		; convert to AFP formatgo_exit		bcs	update_exit		; exit if there was an error		bvs	try_mod_0		; don't set if all zeroes		sta	my_cr_date		stx	my_cr_date+2		lda	#cr_bit		tsb	my_bitmap		; set create date/timetry_mod_0		ldy	#p.mod0			; do class 0 mod date		jsr	date0_to_afp		; convert to AFP format		bcs	update_exit		; exit if there was an error		bvs	class1dates		; don't set if all zeroes		sta	my_mod_date		stx	my_mod_date+2		lda	#mod_bit		tsb	my_bitmap		; set mod and create datesclass1dates;------------------------------------------------------------; At this point, the local file information is updated and; ready to be assembled into a packet for the server.;------------------------------------------------------------		clcupdate_exit		rtsparm_err		sec		lda	#invalid_parm		rts;------------------------------------------------------------; Point to a class 1 date in parameter list and turn it; into an AFP date in A,X.  On exit, carry clear if date is; valid; if valid, overflow is set if date was all zeroes.;------------------------------------------------------------date1_to_afp		lda	[my_pb_ptr],y		sta	my_date_tool		iny		iny		lda	[my_pb_ptr],y		sta	my_date_tool+2		iny		iny		lda	[my_pb_ptr],y		sta	my_date_tool+4		iny		iny		lda	[my_pb_ptr],y		sta	my_date_tool+6		jsr	time_tool_afp		; convert to AFP format		bcs	date1_exit		; exit if error		lda	my_date_afp		; get low word		xba				; high-low order		tax				; in X		lda	my_date_afp+2		; get high word		xba				; high-low order in Adate1_exit		rts;------------------------------------------------------------; Point to a class 0 date in parameter list and turn it; into an AFP date in A,X.  On exit, carry clear if date is; valid; if valid, overflow is set if date was all zeroes.;------------------------------------------------------------date0_to_afp		lda	[my_pb_ptr],y		sta	my_date_pro		iny		iny		lda	[my_pb_ptr],y		sta	my_date_pro+2		jsr	time_pro_afp		; convert to AFP format		bcs	date0_exit		lda	my_date_afp		; get low word		xba				; high-low order		tax				; in X		lda	my_date_afp+2		; get high word		xba				; high-low order in Adate0_exit		rts		endwith				; with dp,mydata		endp;------------------------------------------------------------; com_set_info;; This routine takes the values from the local file info; variables and sets them as the file's info.  Note: if; a create or mod date is to be changed and its value is 0,; that parameter is NOT set (its bit in the bitmap will be; cleared).  If the Finder Info is not already being set,; it checks for new file type conversions and will get the; old Finder Info and change the Mac filetype and creator.;; File Type conversions:;	$B3 $DBxy -> 'pdos' 'p' $B3 $DB $xy;	$D7 $0000 -> 'pdos' 'MIDI';	$D8 $0000 -> 'pdos' 'AIFF';	$D8 $0001 -> 'pdos' 'AIFC';	;;; On entry:;	Full native mode.;	A = AFP bitmap of file info to be set;; On exit:;	Full native mode.;; Note: currently assumes that the access word (attributes); are always set.;------------------------------------------------------------com_set_info	proc	export		with	dp,mydata		import	pdos2hfs				ProcName com_set_info				ora	#set_attr		; force attributes to be set		sta	my_bitmap		; save bits to set; 24-Jan-92 MSD: Removed check for my_date_afp being 0 since this is now allowed.		jsr	pdos2hfs		; do ProDOS->Mac filetype conversion				lda	#afpSetFlDrParms	; FPSetFileDirParms		jsr	StartPacket				jsr	PutIDs				lda	my_bitmap		; tell what info to change		jsr	PutWord		sec				; force alignment				jsr	PutPath			; put pathname in		lda	attributes		; get attributes to clear		bne	@clear			; if any, clear 'em		lda	attributes+2		; get attributes to set		ora	#$0080			; make them get set@clear		jsr	PutWord		lda	#cr_bit			; test bitmap for create date/time		bit	my_bitmap		; are we setting this?		beq	no_cr_date		; if not, don't put in packet		lda	my_cr_date		; get create date/time in AFP format		ldx	my_cr_date+2		jsr	PutLongno_cr_date		lda	#mod_bit		; test bitmap for mod date/time		bit	my_bitmap		; are we setting this?		beq	no_mod_date		; if not, don't put in packet		lda	my_mod_date		; get create date/time in AFP format		ldx	my_mod_date+2		jsr	PutLongno_mod_date		lda	#f_info_bit		; test bitmap for Finder info		bit	my_bitmap		beq	no_f_info		lda	#32			; Finder info is 32 bytes		ldx	#<my_f_info		; from "my_f_info" buffer		ldy	#^my_f_info		jsr	PutBlockno_f_info		lda	#pdos_bit		; test bitmap for ProDOS info		bit	my_bitmap		beq	no_pdos_info		lda	my_filetype		jsr	PutWord			; put ProDOS filetype		lda	my_auxtype		ldx	my_auxtype+2		jsr	PutLong			; put ProDOS auxtypeno_pdos_info		jsr	SendPacket		jsr	CheckParent		; check for path not found		bcs	exit			; return if error;; If any attributes need to be set, and they weren't set in the first packet,; then do another SetFileDirParms;		lda	attributes		; did I clear anything?		beq	exit			; if not, set was done above		lda	attributes+2		; anything to set?		beq	exit			; no, so done		ora	#$0080			; OR in set flag		pha				; save for later				lda	#afpSetFlDrParms		jsr	StartPacket				jsr	PutIDs				lda	#set_attr		; only set attributes		jsr	PutWord		sec				; force alignment		jsr	PutPath				pla				; recover set attributes		jsr	PutWord				jsr	SendPacket		jsr	CheckParent		; check for path not foundexit		rts				; exit from setinfo_com		endwith				; with dp,mydata		endp;------------------------------------------------------------; pdos2hfs;; This routine performs ProDOS -> HFS filetype conversions; that were defined after AppleShare 2.0.  If the Finder Info; is not already being set, it checks for new file type; conversions and will get the old Finder Info and change; the Mac filetype and creator if necessary.  Conversions; don't apply to directories.;; File Type conversions:;	$B3 $DBxy -> 'pdos' 'p' $B3 $DB $xy;	$D7 $0000 -> 'pdos' 'MIDI';	$D8 $0000 -> 'pdos' 'AIFF';	$D8 $0001 -> 'pdos' 'AIFC';	$E0 $0005 -> 'dCpy' 'dImg';	;;; On entry:;	Full native mode.;	my_bitmap = AFP bitmap of file info to be set;; On exit:;	Full native mode.;	my_bitmap = AFP bitmap of file info to be set;	my_f_info = new Finder Info to set;;------------------------------------------------------------pdos2hfs	proc	export		with	dp,mydata		import	FileTypes:data		import	NumFileTypes:equ				ProcName pdos2hfs						lda	#$2000		; Finder Info bit		bit	my_bitmap	; Finder Info being set?		bne	go_ok_exit	; yes, skip conversions					; default creator to be 'pdos'		lda	#'dp'		; reverse of 'pd'		sta	my_f_info+4		lda	#'so'		; reverse of 'os'		sta	my_f_info+6				lda	my_filetype		cmp	#$B3		; S16 file?		bne	not_s16		; no, check table		ora	#$7000		; ASCII 'p' in high byte		xba			; put in text order		sta	my_f_info	; save first word of type		lda	my_auxtype		and	#$FF00		; only test high byte		cmp	#$DB00		; is it GS/OS-aware?		beq	fix_aux		; yes, preserve aux typego_ok_exit	brl	ok_exit		; no, let server convert itfix_aux		lda	my_auxtype	; get auxtype back		xba			; put in Mac order		sta	my_f_info+2	; second word of type		bra	convert		; go get rest of Finder Info;------------------------------------------------------------; Check filetype table to see if given filetype/auxtype; combination is a match.;------------------------------------------------------------not_s16		ldx	#NumFileTypes		ldy	#0@loop		lda	my_filetype		cmp	FileTypes,y		bne	@next		lda	my_auxtype		cmp	FileTypes+2,y		beq	@match@next		tya		clc		adc	#12		tay		dex		bne	@loop		bra	ok_exit		;------------------------------------------------------------; We found a match in the table, so pull out type (and; creator if it isn't the default $FFFFFFFF).;------------------------------------------------------------@match		lda	FileTypes+4,y		sta	my_f_info	; save first word		lda	FileTypes+6,y		sta	my_f_info+2	; save second word				lda	FileTypes+8,y		ora	FileTypes+10,y	; is it all $FF's?		ina			; was A=$FFFF?		beq	convert		; yes, use creator='pdos'				lda	FileTypes+8,y	; get non-pdos creator		sta	my_f_info+4	; and replace in Finder Info		lda	FileTypes+10,y		sta	my_f_info+6convert;------------------------------------------------------------;; Get current Finder Info so I can change the Mac filetype.; Send out GetFileDirParms call....;;------------------------------------------------------------		lda	#afpGetFlDrParms	; FPGetFileDirParms		jsr	StartPacket				jsr	PutIDs			; put VolID, DirID in packet		lda	#$2000			; Finder Info only		jsr	PutWord			; put file bitmap in				lda	#$2000			; Finder info only		jsr	PutWord			; put directory bitmap in		clc				; don't have to align		jsr	PutPath			; add pathname to packet				jsr	SendPacket		jsr	CheckParent		; check for path not found		bcs	exit			; return any errors;------------------------------------------------------------;; Get the results of the GetFileDirParms;;------------------------------------------------------------		jsr	StartReply		; start processing reply packet				jsr	GetLong			; ignore bitmaps				jsr	GetWord			; get file/dir flag		bit	#$0080			; was directory bit set?		bne	ok_exit			; yes, don't do conversion!		jsr	GetLong			; ignore Mac filetype		jsr	GetLong			; ignore Mac creator				lda	#24			; get rest of Finder Info		ldx	#<my_f_info+8		; to "my_f_info" buffer		ldy	#^my_f_info+8		jsr	GetBlock;------------------------------------------------------------;; Change the Mac filetype/creator in Finder Info and set the; Finder Info bit in my_bitmap (so it will be set in the; SetFileDirParms call).;;------------------------------------------------------------		lda	#$2000		tsb	my_bitmap		; set FinderInfo in bitmap								; always set creator to 'pdos'ok_exit		clcexit		rts				endwith		endp				end