;********************************************************************************;; Copyright Apple Computer Inc 1987-93; All Rights Reserved;;********************************************************************************;; Summary:;	This is the AppleShare FST for GS/OS.  Its job is to take;	requests from GS/OS and turn them into the appropriate;	AFP calls.  Written by Mark Day.;; Credits:;	Thanks to Rob Turner for his help and explanations of GS/OS;	and how FSTs work (and his source code examples!);; Modification history:;;  5-Jan-87	MSD	Coding started.; 27-Jun-88	MSD	FST ID changed to $D ($C is used by CD-ROM); 27-Sep-88	MSD	Version is v02.01 d01;  6-Feb-89	MSD	Checks for .AppleTalk on startup;  8-Feb-89	MSD	If booting over the network, assume AppleTalk;			drivers will be present (since they aren't;			installed yet); this will avoid the check for;			the .AppleTalk driver.;  3-Aug-90	MSD	Fixed version number to 3.03 for 5.0.3 final.;			The only change was to support extra parameter;			to the Flush call (fast flush).; 12-Nov-90	MSD	On a cold startup, set default access rights to;			not set anything.  Set owner and group names to;			the empty string.; 05-Feb-91	MSD	Added JudgeName to the app entry.; 06-Feb-91	MSD	Removed "Bozo" alerts.;; 25-Mar-92	DAL	For 6.0.1, bumped version to $8401 (4.01d1).; 21-Jan-93	DAL	Shortcut the QDStatus and GetWAP.  Use new SCC;			Manager call to get the network slot number for;			LocalTalk vs. Ethernet checks (cosmetic).; 17-Mar-93	DAL	Changed code after yes_atalk to check for Ethernet;			by looking at the CmdTable (yuck) instead of looking;			at the .AppleTalk DIB slot number, because on a network;			boot the drivers don't exist yet.;;  2-Apr-93	SS	Changed version to $0401 for 6.0.1 (final);;********************************************************************************;; Include equates and macro files;		load	'equates.dump'		;; Set proper assembler modes, etc.;		longa	on		longi	on		string	asis			; strings without length byte;; Constants specific to this FST;my_fst_attr	equ	$0000			; block FST, mixed case, no formatmy_fst_vers	equ	$0401			; 04.01 finalmax_vol_size	equ	$007FFFFFmin_vol_size	equ	1			; meaningless (format use only)max_file_size	equ	$FFFFFFFF;; Define imports/exports;		entry	app_entry:code		entry	sys_entry:code		entry	go_comp:code;; This is the FST header;header		proc		dc.b	'FST '			; this is an FST		dc.l	app_entry		dc.l	sys_entry		dc.w	my_fst_id		dc.w	my_fst_attr		dc.w	my_fst_vers		dc.w	fst_blk_size		dc.l	max_vol_size		dc.l	min_vol_size		dc.l	max_file_size		dc.l	0			; reserved; String to identify during formatting		str	'AppleShare'		; type of FST; String to display during booting		str	'AppleShare FST        v04.01'		dc.w	0			; reserved		str	'AppleShare FST written by Mark Day.'		endp;------------------------------------------------------------;; cmd_tbl;; This table contains the addresses of command handlers for; each GS/OS call.  The ones I don't handle (such as device; calls) exit by returning a bad_call_num error.;;------------------------------------------------------------cmd_tbl		record	entry		import	cmd_err		import	create,destroy		import	change_path		import	set_file_info,get_file_info		import	volume		import	clear_backup		import	open,close		import	read,write,flush		import	get_mark,set_mark		import	get_eof,set_eof		import	get_dir_entry		import	get_dev_num		import	read_block,write_block		import	format,erase_disk		import	fst_specific		import	JudgeNamefirst		dc.w	create		; $01		dc.w	destroy		; $02		dc.w	cmd_err		; $03 = purge		dc.w	change_path	; $04		dc.w	set_file_info	; $05		dc.w	get_file_info	; $06		dc.w	JudgeName	; $07		dc.w	volume		; $08		dc.w	cmd_err		; $09 = set_prefix		dc.w	cmd_err		; $0A = get_prefix		dc.w	clear_backup	; $0B		dc.w	cmd_err		; $0C = destroy_purge		dc.w	cmd_err		; $0D = null		dc.w	cmd_err		; $0E = expand_path		dc.w	cmd_err		; $0F = alter_dir		dc.w	open		; $10		dc.w	cmd_err		; $11 = newline		dc.w	read		; $12		dc.w	write		; $13		dc.w	close		; $14		dc.w	flush		; $15		dc.w	set_mark	; $16		dc.w	get_mark	; $17		dc.w	set_eof		; $18		dc.w	get_eof		; $19		dc.w	cmd_err		; $1A = set_level		dc.w	cmd_err		; $1B = get_level		dc.w	get_dir_entry	; $1C		dc.w	cmd_err		; $1D = RESERVED		dc.w	cmd_err		; $1E = RESERVED		dc.w	cmd_err		; $1F = RESERVED		dc.w	get_dev_num	; $20		dc.w	cmd_err		; $21 = get_last_dev		dc.w	read_block	; $22   (returns error)		dc.w	write_block	; $23   (returns error)		dc.w	format		; $24 = format (returns error)		dc.w	erase_disk	; $25 = erase_disk (returns error)		dc.w	cmd_err		; $26 = reset_cache		dc.w	cmd_err		; $27 = get_name		dc.w	cmd_err		; $28 = get_boot_vol		dc.w	cmd_err		; $29 = quit		dc.w	cmd_err		; $2A = get_version		dc.w	cmd_err		; $2B = get_fst_info		dc.w	cmd_err		; $2C = d_info		dc.w	cmd_err		; $2D = d_status		dc.w	cmd_err		; $2E = d_control		dc.w	cmd_err		; $2F = d_read		dc.w	cmd_err		; $30 = d_write		dc.w	cmd_err		; $31 = alloc_interrupt / bind_int		dc.w	cmd_err		; $32 = dealloc_interrupt / unbind_int		dc.w	fst_specific	; $33next		export	max_cmd:equmax_cmd		equ	next-first		endr;------------------------------------------------------------;; sys_tbl;; This table contains the addresses of command handlers for; FST system calls.;;------------------------------------------------------------sys_tbl		record	entry		import	startup,shutdown		import	remove_vcr,deferred_flushfirst		dc.w	startup		dc.w	shutdown		dc.w	remove_vcr		dc.w	deferred_flushnext		export	max_sys:equmax_sys		equ	next-first		endr;------------------------------------------------------------;; app_entry;; This is the entry point for ALL standard operating system; calls made through GS/OS.;; Entry:	X = call number * 2;		Y = class number * 2;;------------------------------------------------------------		longa	on		longi	on		app_entry	proc	export		import	QDFlag,QDDpage		import	mydata:tdata	; for err_priority		export	cmd_err				ProcName app_entry				phk		plb			; lets me use short addressing		rep	#$30		; make sure we're in 16-bit mode		cpx	#max_cmd+1	; is command out of range?		bge	cmd_err		phx			; save X,Y		phy;		pha			; space for result;		ldx	#$0604		; QDStatus;		jsl	$E10000;		pla;		sta	QDFlag		; save for arrows;		beq	inactive	; QD inactive, so no WAP;		pha			; push long space for result;		pha;		pea	0		; system toolset;		pea	4		; QuickDraw;		ldx	#$0C01		; _GetWAP;		jsl	$E10000;		pla			; get direct page;		plx			; ignore high word;		sta	QDDPage		; save QuickDraw's DP address;inactive*** shortcutted 21-Jan-93 DAL		phd		lda $e103c8+2		;system WAP table pointer		pha		lda $e103c8		pha		tsc		tcd		ldy #4*4		;QuickDraw * 4		lda [1],y		sta QDDpage		sta QDFlag		plx		plx		pld		*** end 21-Jan-93		ply			; restore X,Y		plx		stz	mydata.err_priority	; clear error priority bit		jmp	(cmd_tbl-2,x)cmd_err		lda	#bad_call_num	; call number out of range		sec		jml	sys_exit				endp;------------------------------------------------------------;; sys_entry;; This is the entry point for ALL FST system calls.;; Entry:	Full native mode;		X = call number * 2;		Y = class number * 2;;------------------------------------------------------------sys_entry	proc	export				ProcName sys_entry				phk		plb				cpx	#max_sys+1	; is command number OK?		bge	@err		jmp	(sys_tbl-2,x)@err		lda	#bad_call_num		sec		rtl			; remember, return via RTL				endp;--------------------------------------------------; Startup:;; Save address of system general I/O buffer for; later calls.  Save completion return address.; Check for presence of .AppleTalk (error if not; present, causing FST to be unloaded).  If booting; over the network, the device dispatcher hasn't; been started up yet, so assume appletalk will be; loaded properly.;--------------------------------------------------startup		proc	export		import	SPCommand:tSPCommand		import	SPWrite:tSPWrite		import	GetSVersion:tGetVersion		import	mydata:tdata		import	QtrHandler:code				ProcName startup				with	dp,mydata		atalk_id	equ	$001D			; device ID of .AppleTalkpriority_vec	equ	$E1103A			; AppleTalk priority vector		lda	priority_vec		cmp	#$6B6B			; starting over AppleTalk?		bne	check_atalk		; no, look for driver		lda	priority_vec+2		; check high word for good measure		beq	yes_atalk		; starting over net, AppleTalk presentcheck_atalk		lda	#1			; start with first device		sta	dev_dev_id		; save this device #		stz	dev_num			; to dispatcher itselfloop		lda	#drvr_get_dib		; I want my DIB!		sta	dev_callnum				jsl	Dev_Dispatcher		; make the call....		bcs	no_atalk		; don't install me if error		ldy	#dib_dev_id		; point to device ID		lda	[dev_dib_ptr],y		cmp	#atalk_id		; is it .AppleTalk?		beq	yes_atalk		; yes, so get on with it				inc	dev_dev_id		; try the next device		bra	loopno_atalk		pea	47			; error 47: Install AppleShare;		pushlong #0			; no substitution strings;		pushlong #0*** opt 21-Jan-93 DAL		lda	#0		pha		pha		pha		pha*** end 21-Jan-93		jsl	report_error		; cause message to be displayed				sec				; unload me please		lda	#0			; I've already put up an error		rtlyes_atalk;*** 21-Jan-93 DAL -- fetch network slot number for future reference;		ldy	#dib_slotnum;		lda	[dev_dib_ptr],y;		sta	NetworkSlotNumber;*** end 21-Jan-93*** changed 17-Mar-93 DALCmdTable	equ	$E1D600StateReg	equ	$E1C068LCBank2		equ	$E1C083		sep	#$20		lda	>StateReg		pha			; save LC bank		lda	>LCBank2		lda	>LCBank2	; allow write to language card		rep	#$20		lda	>$ff*4+CmdTable		beq	@storeSlot		lda	#8		;flag Ethernet@storeSlot	sta	NetworkSlotNumber		sep	#$20		pla		sta	>StateReg	; restore LC bank		rep	#$20*** end 17-Mar-93		jsl	Get_Sys_GBuf		; Get buffer address		stx	gbuf_addr		; and save off in static		sty	gbuf_addr+2		; storage for later.		stx	gbuf_ptr		; and temp. copy on DP		sty	gbuf_ptr+2				tdc				; remember where GSOS DP is		sta	gsos_dp_addr				pha				; space for result		_MMStartup		plx				; get user ID		stx	my_mem_id		; save for others to use		lda	#$0200			; sync GetInfo		sta	[gbuf_ptr]		; in beginning of GBUF		ldx	gbuf_ptr		; point to parameter list		ldy	gbuf_ptr+2		jsl	RamDispatch		; make the call		ldy	#4		lda	[gbuf_ptr],y		; get completion routine return		sta	go_comp+1		; save for returns		iny		iny		lda	[gbuf_ptr],y		sta	go_comp+3		lda	#$2000			; sync SPCommand		sta	SPCommand		lda	#$2100			; sync SPWrite		sta	SPWrite		lda	#$3A00			; sync GetSVersion		sta	GetSVersion				php				; save interrupt state		sei				; stuffing an interrupt handler		lda	ToQtr			; stuff the vector		sta	QtrVector		lda	ToQtr+2		sta	QtrVector+2		plp				; restore interrupt state				lda	warm_cold_flag		; is it a warm startup?		bne	ok_exit			; yes, don't change defaults				stz	def_access		; default: don't set anything		stz	def_access+2		stz	def_owner		; null owner name (i.e. guest)		stz	def_group		; no group name		ok_exit		clc		lda	#0		rtlToQtr		jml	QtrHandler		; this goes in QtrVector		export NetworkSlotNumberNetworkSlotNumber dc.w 0			;21-Jan-93 DAL		endwith				; with dp,mydata		endpshutdown	proc	export		with	dp				ProcName shutdown				IF 0 THEN		lda	#1			; first VCR in the listloop		jsl	Get_VCR			; any more VCRs?		bcs	done		jsl	Deref			; get real address		stx	my_vcr_ptr		sty	my_vcr_ptr+2		ldy	#vcr.fst_id		lda	[my_vcr_ptr],y		; who owns this VCR?		cmp	#my_fst_id		; is it me?		bne	next			; no, so check the next one		lda	[my_vcr_ptr]		; get VCR ID number		jsl	Release_VCR		; release it!next		lda	#0		bra	loopdone		ENDIF				lda	warm_cold_flag		; warm shutdown?		bne	is_warm			; yes, so don't remove vector		php				; save interrupt state		sei				; turn off interrupts to patch vector		lda	#$006B			; RTL <NUL>		sta	QtrVector		lda	#$0000			; <NUL> <NUL>		sta	QtrVector+2		plp				; restore interrupt state		is_warm		clc		lda	#0		rtl				endwith		endpremove_vcr	proc	export		with	dp				import	closevol:code				ProcName remove_vcr		;		pei	my_vcr_ptr+2		; save vcr pointer;		pei	my_vcr_ptr;; dereference VCR vp that GS/OS gave me;		ldx	vcr_addr;		ldy	vcr_addr+2;		jsl	deref			; call SCM to deref the VP;		stx	my_vcr_ptr;		sty	my_vcr_ptr+2				jsr	closevol		; stop the timers, etc.		;		pla;		sta	my_vcr_ptr		; restore the pointer;		pla;		sta	my_vcr_ptr+2				clc		lda	#0		rtl				endwith				; with dp		endpdeferred_flush	proc	export		clc		lda	#0		rtl		endp;--------------------------------------------------; Block I/O routines;; All of these routines return a bad_call_num error.;--------------------------------------------------common_block	proc		; return an invalid device request error		export	(read_block,write_block,format,erase_disk):coderead_blockwrite_blockformaterase_disk		sec		lda	#$0088		jml	sys_exit		endp;--------------------------------------------------; Go_Comp;; This is the jump to the completion routine; return address.;--------------------------------------------------go_comp		proc	export		jml	0	; modified: will jump to completion return		dc.b	0	; for extra address byte		endp				end