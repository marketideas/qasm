YowzaAlert	equ 0		;2-Apr-93 DAL;------------------------------------------------------------; File: SendPacket.aii;; This file contains the routines used to prepare an ASP; command packet with an AFP command in it.  It also contains; routines used to read from the reply packet.;; Modification history:; 29-Jun-88	MSD	Started coding.; 20-Jul-88	MSD	Dedicated buffers are now used for;			the outgoing packet and its reply;			(instead of GBUF).;  1-Aug-88	MSD	Added routines StartWrite, SendWrite;			for sending SPWrite packets.;  4-Aug-88	MSD	Added "flashing arrows" to menu bar;			while SendPacket and SendWrite are;			executing.; 15-Aug-88	MSD	Changed definition of SPCommand and;			SPWrite.;;  1-Apr-93	JCM	Fixed SendWrite so if an error occurred,;			it now reads the code from the correct;			buffer, SPWrite, instead of SPCommand.;; 2-Apr-93	DAL	Removed the debugging Yowza dialog;			for 6.0.1 final.;;------------------------------------------------------------		load	'equates.dump' MACRO&lab _TLTextMountVolume&lab ldx #$1201     jsl $E10000 MEND MACRO&lab _HexIt&lab ldx #$2A0B     jsl $E10000 MEND				import	convert_error:code		import	(draw_arrows,erase_arrows):code		import	SPCommand:tSPCommand		import	SPWrite:tSPWrite		import	mydata:tdata;------------------------------------------------------------; StartPacket;; This routine prepares to fill in an ASP command packet.; It takes the command number as input and puts it into; the packet.  The packet pointer is initialized, etc.;; On entry:;	Full native mode;	A = AFP command number;; On exit:;	Full native mode;;------------------------------------------------------------StartPacket	proc	export		with	dp,mydata		ProcName StartPacket		;------------------------------------------------------------; Fill in AFP command number;------------------------------------------------------------		sta	command_pkt		; for command number		lda	#2			; offset past command		sta	command_ndx		; and store in index		;------------------------------------------------------------; Copy command buffer and reply buffer addresses to; parameter list;------------------------------------------------------------		lda	#<command_pkt		; low word		sta	SPCommand.ComAddr		lda	#^command_pkt		; high word		sta	SPCommand.ComAddr+2		lda	#<reply_pkt		; address of reply		sta	reply_buf		; save pointer to it		sta	SPCommand.RepAddr		lda	#^reply_pkt		sta	reply_buf+2		sta	SPCommand.RepAddr+2		lda	#NormSPData		; set up default SPCommand		sta	SPCommand.RepBufLen	; reply buffer length;------------------------------------------------------------; Copy SessRefnum to SPCommand param list;; Note: this overwrites the Command Block Length field which; will be set during the SendPacket routine.;------------------------------------------------------------		lda	SessRefnum		sta	SPCommand.SRef		rts		endwith		endp;------------------------------------------------------------; SendPacket;; This routine sends a filled-in SPCommand packet out on the; appropriate session.  It takes the current command index to; be the length of the command packet.;; On entry:;	Full native mode;	packet_ndx = length of command packet;; On exit:;	Full native mode;	c = 1 if error (A = error code);;------------------------------------------------------------SendPacket	proc	export		ProcName SendPacket				lda	mydata.command_ndx		sta	SPCommand.ComLen		php		php		pla				; get interrupt status		and	#4			; interrupts disabled?		bne	do_io_error		; yes, so can't do I/O		jsr	draw_arrows		; draw arrows in menu bar@again		ATCall	SPCommand		lda	SPCommand.Result		cmp	#$0702			; too many ASP calls error?		beq	@again			; if so, try the call again		pha				; save ASP error code		jsr	erase_arrows		; undraw arrows		pla				; restore error code		bne	offline			; assume an error means offline				lda	SPCommand.ComRes+2	; get AFP's command result		jsr	convert_error		; turn it into a GS/OS errorexit		rtsoffline		ldy	#^SPCommand		ldx	#SPCommand		jsr	DisplayError		lda	#offline_error		; assume error was volume offline		sec		bcs	exitdo_io_error		lda	#io_error		sec		bcs	exit******************************************************************************************************	if YowzaAlert then;; A = error code; YX = pointer to parm block;		export DisplayErrorDisplayError	pha		phx	;low word		pha		pha	;space for HexIt		phy	;input		_HexIt		pla	;discard high nibbles		pla		sta >String2+13		plx		pha		pha	;space for HexIt		phx	;input		_HexIt		pla		sta >String2+15		pla		sta >String2+17		lda 1,s		;added 1-Apr-93 DAL		pha		pha		;space for result		pha		;input		_HexIt		pla		sta >String2+1		pla		sta >String2+3		pha		pushlong #String1		pushlong #String2		pushlong #Button		pushlong #Button		_TLTextMountVolume		pla		pla		rtsString1		dc.b 21,'Presto!  The error is'String2		dc.b 4+14,'xxxx  ptr = xxxxxx'Button		dc.b 5,'Yowza'	else		export DisplayErrorDisplayError	rts	endif******************************************************************************************************		endp;------------------------------------------------------------; PutByte;; This routine puts a byte into the current SPCommand; packet at the current packet index.  The index is then; bumped by 1 to point to the next byte in the packet.;; Note: StartPacket must have already been called.;; On entry:;	Full native mode;	A = byte to add to packet (only low order byte is;	    significant);; On exit:;	Full native mode;;------------------------------------------------------------PutByte		proc	export		ProcName PutByte				ldy	mydata.command_ndx		sep	#$20			; store only 1 byte		sta	mydata.command_pkt,y		rep	#$20			; back to normal		iny		sty	mydata.command_ndx		rts		endp;------------------------------------------------------------; PutWord;; This routine puts a word into the current SPCommand; packet at the current packet index.  The index is then; bumped by 2 to point to the next byte in the packet.;; Note: StartPacket must have already been called.;; On entry:;	Full native mode;	A = word to add to packet;; On exit:;	Full native mode;;------------------------------------------------------------PutWord		proc	export		ProcName PutWord				ldy	mydata.command_ndx		sta	mydata.command_pkt,y		iny		iny		sty	mydata.command_ndx		rts		endp;------------------------------------------------------------; PutLong;; This routine puts 4 bytes into the current SPCommand; packet at the current packet index.  The index is then; bumped by 4 to point to the next byte in the packet.;; Note: StartPacket must have already been called.;; On entry:;	Full native mode;	A = first word to add to packet;	X = second word to add to packet;;	Remember: AFP values are in high-low format!!!;; On exit:;	Full native mode;;------------------------------------------------------------PutLong		proc	export		ProcName PutLong				ldy	mydata.command_ndx		sta	mydata.command_pkt,y		iny		iny		txa		sta	mydata.command_pkt,y		iny		iny		sty	mydata.command_ndx		rts		endp;------------------------------------------------------------; PutBlock;; This routine puts a series of bytes from a user's buffer; into the current command packet at the current command; index.  It then bumps the command index past the block; of bytes.;; On entry:;	Full native mode;	A = # of bytes to put;	X = address of buffer to get bytes (low);	Y = address of buffer to get bytes (high);; On exit:;	Full native mode;;------------------------------------------------------------PutBlock	proc	export		with	dp,mydata		ProcName PutBlock				stx	src_ptr			; set up pointer to buffer		sty	src_ptr+2		sta	math_temp		; save block length		cmp	#0			; null block size?		beq	done			; if so, skip copy		ldx	command_ndx		; index to command packet		ldy	#0			; index to user buffer		sep	#$20			; 8 bit mode to move bytes		longa	offloop		lda	[src_ptr],y		; get from user buffer		sta	command_pkt,x		; store in command packet		inx				; point to next byte		iny				; increment transfer count		cpy	math_temp		; all transfered?		bne	loop			; if not, do more		rep	#$20			; back to full native		longa	on		stx	command_ndx		; save index to command packetdone		rts				; return to caller		endwith				; with dp		endp;------------------------------------------------------------; PutPartPath;; This routine puts the partial path specified by my_path_ptr; and my_path_len into the current command packet at the; current command index.  It then bumps the command index; past the pathname.;; On entry:;	Full native mode;	partial_len	length of partial pathname;	my_path_ptr	pointer to partial pathname;; On exit:;	Full native mode;;------------------------------------------------------------PutPartPath	proc	export		with	dp,mydatacolon		equ	$003A			; filename separator (':')		ProcName PutPartPath				lda	#afp_long		; say AFP long naming mode		jsr	PutByte				lda	partial_len		jsr	PutByte			; put length of path		lda	partial_len		and	#$00FF			; is it null string?		beq	done			; if so, skip copy		ldx	command_ndx		; index to command packet		ldy	#0			; index to user buffer		sep	#$20			; 8 bit mode to move bytes		longa	offloop		lda	[my_path_ptr],y		; get from user buffer		cmp	#colon			; is it a separator?		bne	stuff_it		; if not, copy as is		lda	#0			; colon becomes a $00stuff_it		sta	command_pkt,x		; store in command packet		inx				; point to next byte		iny				; increment transfer count		cpy	partial_len		; all transfered?		bne	loop			; if not, do more		rep	#$20			; back to full native		longa	on		stx	command_ndx		; save index to command packetdone		rts				; return to caller		endwith				; with dp		endp;------------------------------------------------------------; PutPath;; This routine puts a byte signifying AFP long naming format; and the string from partial_path into the current packet; at the current packet index.  The packet index is bumped; to point past the pathname.  Optionally, word alignment; can be forced so that parameters following the pathname; will start on a word boundary.  This routine is optimized; for the partial_path buffer instead of being general.;; Note: StartPacket must have already been called.;; On entry:;	Full native mode;	c = 1  =>  Force word alignment after pathname;	c = 0  =>  Don't force any special alignment;; On exit:;	Full native mode;;------------------------------------------------------------PutPath		proc	export		with	dp,mydata		ProcName PutPath				php			; save alignment flag		lda	#afp_long	; signify AFP long name		jsr	PutByte		lda	partial_path	; get string length		and	#$00FF		; only want byte length		sta	math_temp	; save for comparisons				ldy	command_ndx	; get index to packet		ldx	#0		; get index to string		sep	#$20		; 8 bits for chars		longa	offcopy_loop		lda	partial_path,x	; get a byte		sta	command_pkt,y	; put in packet		iny			; bump pointers		inx		cpx	math_temp	; are we done yet?		blt	copy_loop	; continue if X <= length		beq	copy_loop				rep	#$20		; back to full native		longa	on				sty	command_ndx	; save index into packet				plp			; get alignment flag		bcc	exit		; return if no alignment		tya			; get packet index		ror	a		; was it even?		bcc	exit		; yep, already aligned		lda	#0		jsr	PutByte		; force word alignmentexit		rts			; all done		endwith		endp;------------------------------------------------------------; PutPString;; This routine will put the p-string pointed to by X,Y into; the current command packet.  On exit, the command packet; index will point past the string.;; On entry:;	Full native mode;	X = string address (low word);	Y = string address (high word);; On exit:;	Full native mode;; Uses:;	src_ptr		(points to string);	dest_ptr	(points to current packet location);;------------------------------------------------------------PutPString	proc	export		with	dp,mydata		ProcName PutPString				stx	src_ptr			; save pointer to string		sty	src_ptr+2		clc				; compute address where		lda	#<command_pkt		; string will be moved.		adc	command_ndx		sta	dest_ptr		lda	#^command_pkt		; don't forget high word		adc	#0		sta	dest_ptr+2		lda	[src_ptr]		; handle length byte specially		sta	[dest_ptr]		; note: writes 2 bytes		and	#$00FF			; get length byte only		tay				; and use it as index		sec				; add 1 for string length		adc	command_ndx		; and bump packet pointer		sta	command_ndx		cpy	#0			; null string?		beq	done			; if so, skip copy		sep	#$20			; 8 bits to copy chars		longa	offloop		lda	[src_ptr],y		; copy 1 char		sta	[dest_ptr],y		dey				; next		bne	loop			; continue if more to copy		rep	#$20			; back to full native		longa	ondone		rts				; all done		endwith				; with dp		endp;------------------------------------------------------------; PutIDs;; This routine copies VolID and DirID to the current packet.;; Note: StartPacket must have already been called.;; On entry:;	Full native mode;; On exit:;	Full native mode;;------------------------------------------------------------PutIDs		proc	export		with	dp,mydata				ProcName PutIDs				lda	VolID		jsr	PutWord				lda	DirID		ldx	DirID+2		jsr	PutLong				rts				endwith		endp;------------------------------------------------------------; StartReply;; This routine sets up to start processing a reply from an; ASP command packet send via StartPacket, etc.  Currently,; it only sets the reply index to 0.;; On entry:;	Full native mode;; On exit:;	Full native mode;------------------------------------------------------------StartReply	proc	export		ProcName StartReply				stz	mydata.reply_ndx		rts				endp;------------------------------------------------------------; GetByte;; This routine gets one byte from the reply packet at the; current reply index.  It then bumps the reply index by 1.;; On entry:;	Full native mode;; On exit:;	Full native mode;	A = byte from reply (high byte is 0);------------------------------------------------------------GetByte		proc	export		ProcName GetByte				ldy	mydata.reply_ndx		lda	mydata.reply_pkt,y		and	#$00FF			; mask off 1 byte		iny				; bump index by 1		sty	mydata.reply_ndx		rts				endp;------------------------------------------------------------; GetWord;; This routine gets one word from the reply packet at the; current reply index.  It then bumps the reply index by 2.;; On entry:;	Full native mode;; On exit:;	Full native mode;	A = word from reply;------------------------------------------------------------GetWord		proc	export		ProcName GetWord				ldy	mydata.reply_ndx		lda	mydata.reply_pkt,y		iny				; bump index by 2		iny		sty	mydata.reply_ndx		rts				endp;------------------------------------------------------------; GetLong;; This routine gets two words from the reply packet at the; current reply index.  It then bumps the reply index by 4.;; On entry:;	Full native mode;; On exit:;	Full native mode;	A = first word from reply;	X = second word from reply;------------------------------------------------------------GetLong		proc	export		ProcName GetLong				ldy	mydata.reply_ndx		lda	mydata.reply_pkt,y	; low word in A		ldx	mydata.reply_pkt+2,y	; high word in X		iny				; bump index by 4		iny		iny		iny		sty	mydata.reply_ndx		rts				endp;------------------------------------------------------------; GetBlock;; This routine gets a series of bytes from the reply packet; at the current reply index.  It then bumps the reply index; past the block of bytes.;; On entry:;	Full native mode;	A = # of bytes to get;	X = address of buffer to store bytes (low);	Y = address of buffer to store bytes (high);; On exit:;	Full native mode;;------------------------------------------------------------GetBlock	proc	export		with	dp,mydata		ProcName GetBlock				stx	dest_ptr		; set up pointer to buffer		sty	dest_ptr+2		sta	math_temp		; save block length		cmp	#0			; anything to get?		beq	done			; if not, skip it		ldx	reply_ndx		; index to reply packet		ldy	#0			; index to user buffer		sep	#$20			; 8 bit mode to move bytes		longa	offloop		lda	reply_pkt,x		; get next byte		sta	[dest_ptr],y		; save in user buffer		inx				; point to next byte		iny				; increment transfer count		cpy	math_temp		; all transfered?		bne	loop			; if not, do more		stx	reply_ndx		; save index to reply packet		rep	#$20			; back to full native		longa	ondone		rts				; return to caller		endwith				; with dp		endp;------------------------------------------------------------; GetPlace;; This routine saves the index to the start of file/directory; parameters being returned.  This is used when getting; variable length parameters since they are represented as; offsets from this location.;; On entry:;	Full native mode;	reply_ndx = offset to start of file/dir parameters;; On exit:;	Full native mode;	saved_ndx = reply_ndx;;------------------------------------------------------------GetPlace	proc	export		ProcName GetPlace				lda	mydata.reply_ndx	; get reply index		sta	mydata.saved_ndx	; save it for later		rts		endp;------------------------------------------------------------; GetPString;; This routine will get the p-string whose offset is next; in the reply packet into a buffer pointed to by X,Y.; On exit, the reply packet index will point past the offset.;; On entry:;	Full native mode;	X = string address (low word);	Y = string address (high word);	Assumes GetPlace was called at start of dir entry;	(just before getting the attributes word).;; On exit:;	Full native mode;; Uses:;	src_ptr		(points to packet location);	dest_ptr	(points to string buffer);;------------------------------------------------------------GetPString	proc	export		with	dp,mydata		ProcName GetPString				stx	dest_ptr		; save address of destination		sty	dest_ptr+2		ldy	reply_ndx		lda	reply_pkt,y		; get offset to string		xba				; in low-high order		iny		iny				; bump index past offset word		sty	reply_ndx		clc		adc	saved_ndx		; relative to file/dir parms		adc	#<reply_pkt		; get address in packet		sta	src_ptr			; as source pointer		lda	#^reply_pkt		adc	#0		sta	src_ptr+2		lda	[src_ptr]		; handle length byte specially		sta	[dest_ptr]		; note: writes 2 bytes		and	#$00FF			; get length byte only		tay				; and use it as index		sep	#$20			; 8 bits to copy chars		longa	offloop		lda	[src_ptr],y		; copy 1 char		sta	[dest_ptr],y		dey				; next		bne	loop			; continue if more to copy		rep	#$20			; back to full native		longa	on		rts				; all done		endwith				; with dp		endp;------------------------------------------------------------; StartWrite;; This routine prepares to fill in an ASP write packet.; It takes the command number as input and puts it into; the command packet.  The packet pointer is initialized, etc.;; Remember, SPWrite is just like SPCommand, but with an extra; buffer of data that will be "pulled" from the server.;; On entry:;	Full native mode;	A = AFP command number;; On exit:;	Full native mode;;------------------------------------------------------------StartWrite	proc	export		with	dp,mydata		ProcName StartWrite		;------------------------------------------------------------; Fill in AFP command number;------------------------------------------------------------		sta	command_pkt		; for command number		lda	#2			; offset past command		sta	command_ndx		; and store in index		;------------------------------------------------------------; Copy command buffer and reply buffer addresses to; parameter list;------------------------------------------------------------		lda	#<command_pkt		; low word		sta	SPWrite.ComAddr		lda	#^command_pkt		; high word		sta	SPWrite.ComAddr+2		lda	#<reply_pkt		; address of reply		sta	reply_buf		; save pointer to it		sta	SPWrite.RepAddr		lda	#^reply_pkt		sta	reply_buf+2		sta	SPWrite.RepAddr+2		lda	#NormSPData		; set up default SPCommand		sta	SPWrite.RepBufLen	; reply buffer length;------------------------------------------------------------; Copy SessRefnum to SPCommand param list;; Note: this overwrites the Command Block Length field which; will be set during the SendPacket routine.;------------------------------------------------------------		lda	SessRefnum		sta	SPWrite.SRef		rts		endwith		endp;------------------------------------------------------------; SendWrite;; This routine sends a filled-in SPWrite packet out on the; appropriate session.  It takes the current command index to; be the length of the command packet.;; On entry:;	Full native mode;	packet_ndx = length of command packet;; On exit:;	Full native mode;	c = 1 if error (A = error code);;------------------------------------------------------------SendWrite	proc	export		ProcName SendWrite				lda	mydata.command_ndx		sta	SPWrite.ComLen		php		php		pla		and	#4			; interrupts disabled?		bne	do_io_err		; yes, so can't do I/Otry_call		jsr	draw_arrows		; draw arrows in menu bar		ATCall	SPWrite		php				; save error status		jsr	erase_arrows		; undraw arrows		plp				; restore error status		bcs	offline			; assume error is offline				lda	SPWrite.ComRes+2	; get AFP's command result		jsr	convert_error		; turn it into a GS/OS errorexit		rtsoffline;;;		lda	SPCommand.Result	;1-Apr-93 JCM		lda	SPWrite.Result		;1-Apr-93 JCM - let's read this from the right buffer		cmp	#$0702			; too many ASP calls?		beq	try_call		; if so, try the call again	import DisplayError		ldy	#^SPWrite		ldx	#SPWrite		jsr DisplayError		lda	#offline_error		; assume error was volume offline		sec		bcs	exitdo_io_err		lda	#io_error		sec		bcs	exit				endp		end