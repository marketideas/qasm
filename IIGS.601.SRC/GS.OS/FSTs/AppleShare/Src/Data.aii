;--------------------------------------------------; File: data.aii;; This file contains global static data for use; by the FST.  Identifiers should be exported in; order to be used.;--------------------------------------------------		load	'equates.dump'		IF DebugCode THENdata_header	dc.b	'AS FST Data'		ENDIF		mydata		record	export		ds	tdata		IF DebugCode THEN		export	debug_dp:data;; The following data is for debugging only:;		dc.b	'AS FST Debug dp'debug_dp	ds.b	256		; debug copy of direct page		ENDIF		endr;--------------------------------------------------; This is the parameter list for the SPWrite call; which is used by the Write call.;--------------------------------------------------SPWrite		record	export		ds	tSPWrite		endr		;--------------------------------------------------; This is the parameter list for the SPCommand call; which is used to send out an AFP command.;--------------------------------------------------SPCommand	record	export		ds	tSPCommand		endr		;--------------------------------------------------; This is the parameter list for GetSVersion.;--------------------------------------------------GetSVersion	record	export		ds	tGetVersion		endr;--------------------------------------------------; This table specifies the filetype conversions; that supercede AppleShare 2.0.  It is a word of; ProDOS filetype, a word of ProDOS auxtype and a; long of HFS type, and a long of HFS creator.  If; the HFS creator is $FFFFFFFF, it matches anything; on hfs2pdos, and pdos2hfs will set creator to; 'pdos'.;--------------------------------------------------		macro&lab		ftype	&type,&aux,&hfs,&creator=$FFFFFFFF&lab		dc.w	&type,&aux		dc.l	&hfs,&creator		endm		FileTypes	record	export		export	NumFileTypes:equ				ftype	$D7,$0000,'MIDI'		ftype	$D8,$0000,'AIFF'		ftype	$D8,$0001,'AIFC'		ftype	$E0,$0005,'dImg','dCpy'		NumFileTypes	equ	(*-FileTypes)/12	; number of entries in table		endr				end