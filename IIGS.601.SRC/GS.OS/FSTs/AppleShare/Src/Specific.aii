;------------------------------------------------------------; File: specific.aii;; This file contains the code for the FST_Specific command; and all of its subcommands.  This command actually has its; own call dispatcher and parameter block parser so that; other common routines can be used to process this call.;; 29-Nov-88	MSD	Inserted get_user_path command as;			command #$08 (desktop calls move to;			higher command numbers).; 14-Jan-89	MSD	Added errors $7E (unknown user name);			and $7F (unknown group name).; 20-Jun-90	MSD	SetBootVol ($4D44) now calls the;			SystemLoader with a RenamePathname;			to inform it that the boot volume;			has been "renamed" (since SCM does;			this only on a ChangePath call).;; 12-Nov-90	MSD	Added GetDefPrivileges and SetDefPrivileges;			subcalls.; 16-Jan-91	MSD	Fixed SetDefPrivileges so that it properly;			updates pcount to account for the required;			parameters.  This fixes the problem where it;			looked at the owner name and group name buffers;			when the pcount was 3.  Fixed GetDefPrivileges;			to return the whole long of access rights (not;			just the first two bytes).;;  7-Jun-91	MSD	get_user_path should return the path only if;			it actually exists.  Added code to get info on;			the path and return an error if it doesn't exist;			or it is not a directory.;; 26-Sep-91	MSD	GetDefPrivileges and SetDefPrivileges now use;			a separate flags parameter so we don't use other;			bits in the access rights (which get used in;			AFP 2.1).;;  8-Nov-91	MSD	Get_User_Path now sets FIUserPrefix if the path;			exists.  GS/OS code like EasyMount and the;			AppleShare CDEV should make this call rather than;			setting FIUserPrefix themselves.  Shrunk user_path;			buffer from 128 bytes to 70 bytes (max 66 for string,;			plus 2 for trailing slash, plus 2 length bytes).;;------------------------------------------------------------		load	'equates.dump'		import	(PreProcess,main_exit):code		import	(StartPacket,SendPacket):code		import	(PutByte,PutBlock):code		import	(PutWord,PutLong,PutIDs):code		import	(PutPString,PutPath,CheckParent):code		import	(StartReply,GetWord,GetLong):code		import	(Out_PStr,proc_path1,proc_path2):code		import	(do_flush,fill_buffer,remove_fcr):code		import	set_eject:code		import	mydata:tdata				entry	find_recs:code;------------------------------------------------------------; Subcommands;; This is a table of entry points for each of the; FST_Specific commands.  The table is a word wide starting; with command number 1.  The dispatcher jumps to the code; by doing a jmp (subcmds-2,x) where X = 2 * command #.;------------------------------------------------------------		entry	buffer_control,byte_range_lock,sp_open_fork		entry	get_priv,set_priv,user_info,copy_file		entry	open_dt,close_dt,get_comment,set_comment		entry	get_user_path,getsrvrname,setbootvol		entry	getdefpriv,setdefprivsubcmds		recordfirst		dc.w	buffer_control			; $0001		dc.w	byte_range_lock			; $0002		dc.w	sp_open_fork			; $0003		dc.w	get_priv			; $0004		dc.w	set_priv			; $0005		dc.w	user_info			; $0006		dc.w	copy_file			; $0007		dc.w	get_user_path			; $0008		dc.w	open_dt				; $0009		dc.w	close_dt			; $000A		dc.w	get_comment			; $000B		dc.w	set_comment			; $000C		dc.w	getsrvrname			; $000D		dc.w	getdefpriv			; $000E		dc.w	setdefpriv			; $000Fnext		export	max_spec:equmax_spec	equ	next-first		endr;------------------------------------------------------------; Cmd_Flags;; This table contains flags used to process the FST_Specific; calls.  The table is a word wide starting with command; number 1.  The fields in each entry are as follows:;	1) Min PCount;	2) Max PCount;;;                  |   2   |   1   |;  ________________|_______|_______|;  | | | | | | | | | | | | | | | | |;  |_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|; 15                7     4 3     0;;------------------------------------------------------------cmd_flags	proc		dc.w	$43			; buffer control		dc.w	$77			; byte range lock		dc.w	$65			; special open fork		dc.w	$64			; get privileges		dc.w	$64			; set privileges		dc.w	$54			; user info		dc.w	$44			; copy file		dc.w	$33			; get user path		dc.w	$44			; open desktop		dc.w	$44			; close desktop		dc.w	$55			; get comment		dc.w	$54			; set comment		dc.w	$54			; get server name		dc.w	$63			; get default privileges		dc.w	$63			; set default privileges		endpfst_specific	proc	export		with	dp,mydata		ProcName fst_specific		;------------------------------------------------------------; preprocess (like normal calls);------------------------------------------------------------		jsr	PreProcess;------------------------------------------------------------; validate call class;------------------------------------------------------------		lda	class		cmp	#1			; must be class 1!		beq	good_class		sec		lda	#bad_class		; invalid call class		bra	exitgood_class;------------------------------------------------------------; validate subcall (command) number;------------------------------------------------------------		ldy	#2			; offset to command number		lda	[my_pb_ptr],y		; get command (subcall) number		cmp	#$4D44			; set boot volume?		bne	@ok		jmp	setbootvol		; set boot volume as user volume@ok		asl	a			; times 2 as table index		tax				; use in X		beq	bad_call		; 0 is invalid call number		cpx	#max_spec+1		; is it out of range?		blt	good_call		; if OK, keep goingbad_call		sec		lda	#invalid_parm		; command number invalid		bra	exitgood_call;------------------------------------------------------------; validate min/max pcount;------------------------------------------------------------		lda	cmd_flags-2,x		; get flag word		and	#$000F			; get min PCount		dea				; minus 1		cmp	pcount			; is PCount OK?		bge	err_pcount		; no, do an error		lda	cmd_flags-2,x		lsr	a		lsr	a		lsr	a		lsr	a		and	#$000F			; get max PCount		cmp	pcount			; is max >= ?		bge	ok_pcount		; everything is fine, continueerr_pcount		sec		lda	#bad_pcount		; parameter count is bad		bra	exit			; return the errorok_pcount;------------------------------------------------------------; init the pathname flags/pointers;------------------------------------------------------------		clc		jsl	init_parse_path;------------------------------------------------------------; dispatch to subhandler;------------------------------------------------------------		jmp	(subcmds-2,x)		; go do the command;------------------------------------------------------------; Return any errors;------------------------------------------------------------		entry	sp_exitsp_exit		php		pha		sec		jsl	init_parse_path		; free up pathnames		pla		plp				; restore error codeexit		jmp	main_exit		endwith				; with dp		endpbuffer_control	proc		with	dp,mydata		ProcName buffer_control		;------------------------------------------------------------; Take refnum, find FCR, and set/clear bufferring enabled flag;------------------------------------------------------------		stz	math_temp		; assume turn bufferring on		lda	pcount		cmp	#3			; did they supply flags?		beq	no_flags		; if not, don't get it		ldy	#6			; offset to flags		lda	[my_pb_ptr],y		; get buffer disable flag		sta	math_temp		; save for laterno_flags				ldy	#4			; offset to refnum		lda	[my_pb_ptr],y		; get refnum		jsr	find_recs		; set up FCR and VCR		bcs	exit			; return any errors		ldy	#fcr.dirflag		lda	[my_fcr_ptr],y		; is it file or folder?		bpl	file			; go do file stufffolder;------------------------------------------------------------; For folders, all I have to do is mark the buffer inactive; or active/no valid data.;------------------------------------------------------------		ldy	#fcr.flags		; get offset to flag word		lda	math_temp		; get disable flag		bpl	@active			; turn it on!		lda	#0			; buffering off, no valid data		sta	[my_fcr_ptr],y		; set flags		bra	ok_exit			; return with no errors@active		lda	[my_fcr_ptr],y		; get old flags		ora	#buffer_active		; make sure buffering is on		sta	[my_fcr_ptr],y		; (don't change data valid flag)		bra	ok_exit			; return with no errorsfile;------------------------------------------------------------; For files, I need to flush the buffer if bufferring turned; off.  If turned on, fill the buffer.;------------------------------------------------------------		lda	math_temp		; what is disable flag?		bpl	@active		jsr	do_flush		; write any unwritten data		pha				; save error code; Note: this code doe not change the carry flag!!!!		ldy	#fcr.flags		lda	#0			; buffer inactive, no valid data		sta	[my_fcr_ptr],y		; set flags				pla				; restore error code		bra	exit@active		ldy	#fcr.flags		lda	[my_fcr_ptr],y		ora	#buffer_active		; turn on buffering		sta	[my_fcr_ptr],y				clc				; no errors!		lda	#0exit		jmp	sp_exitok_exit		clc		lda	#0			; no error		bra	exit			; return it		endwith				; with dp		endpbyte_range_lock	proc		with	dp,mydata		ProcName byte_range_lock				ldy	#4			; offset to refnum		lda	[my_pb_ptr],y		; get refnum		jsr	find_recs		; set up FCR and VCR		bcs	exit			; return any errors				ldy	#fcr.dirflag		lda	[my_fcr_ptr],y		; is it a file or folder?		bmi	bad_type		; can't do this to folders!		ldy	#6			; offset to lock flag		lda	[my_pb_ptr],y		; get lock flag		sta	math_temp		; save to manipulate		lda	#0			; start with no flags		asl	math_temp		; check lock/unlock flag		bcs	@lock			; default is lock		ora	#$100			; set unlock bit@lock		asl	math_temp		; check relative to EOF flag		bcc	@bof			; default is from start of file		ora	#$8000			; set relative to EOF flag@bof		ora	#afpByteRangeLock	; add in command number		jsr	StartPacket		ldy	#fcr.forkrefnum		lda	[my_fcr_ptr],y		; get AFP fork refnum		jsr	PutWord				ldy	#8			; offset to Offset in pb		lda	[my_pb_ptr],y		; get low word		xba				; in high-low order		tax				; low word in X		iny		iny		lda	[my_pb_ptr],y		; get high word		xba				; in high-low order		jsr	PutLong			; put offset in packet		ldy	#12			; offset to Length in pb		lda	[my_pb_ptr],y		; get low word		xba				; in high-low order		tax				; low word in X		iny		iny		lda	[my_pb_ptr],y		; get high word		xba				; in high-low order		jsr	PutLong			; put Length in packet				jsr	SendPacket		; go make the call		bcs	exit			; return any error				jsr	StartReply		jsr	GetLong			; get start of range in A,X		ldy	#18			; offset to high word returned in pb		xba				; high word in low-high order		sta	[my_pb_ptr],y		dey		dey		txa		xba				; low word in low-high order		sta	[my_pb_ptr],y		clc				; no error		lda	#0exit		jmp	sp_exitbad_type		sec		lda	#bad_store_type		; can't be a folder		bra	exit		endwith				; with dp		endpsp_open_fork	proc		with	dp,mydata				ProcName sp_open_fork				lda	#8			; offset to pathname 1 pointer		ldx	#0			; my FST attributes		ldy	#0			; select path 1		jsl	parse_path		; set pointers for pathname 1		ldy	#10		lda	[my_pb_ptr],y		; get requested access		bit	#$FFCC			; make sure reserved bits are 0's		bne	do_invalid		sta	request_access		; save for later use		stz	fork_number		; assume data fork		lda	pcount		cmp	#6			; did they include fork number?		blt	data_fork		; no, so leave it as data fork		ldy	#12			; offset to fork number		lda	[my_pb_ptr],y		; get fork number		bit	#$FFFE			; make sure only low bit used		beq	valid_forkdo_invalid		sec		lda	#invalid_parm		; bad parameter given		brl	exitdo_bad_type		sec		lda	#bad_store_type		; can't open (volume) directory		brl	exitvalid_fork		lsr	a			; fork number into carry		ror	fork_number		; and into fork_number flagdata_fork		jsr	proc_path1		; parse pathname		bcc	@ok		brl	exit			; return any error@ok		lda	volume_sep		; volume name only given?		beq	do_bad_type		; yes, so return the right error		;------------------------------------------------------------; Build an FCR for the file.;------------------------------------------------------------		ldx	gstring			; get volume length		inx				; plus 1 for colon		ldy	#'::'			; just need one colon...		sty	gstring			; put colon in gstring+1		stx	gstring-1		; save word length in gstring-1		lda	#fcr.buffer+512		; size of file buffer		ldx	#<gstring		; point to filename		ldy	#^gstring		sec				; please zero the buffer		jsr	Alloc_FCR		; build an FCR for me		bcc	@got_fcr		brl	exit			; return any errors@got_fcr;------------------------------------------------------------; The FCR is built.  Save the pointer to it.;------------------------------------------------------------		lda	gstring-1		; get modified length		dea				; back to normal		sta	gstring			; save original length				jsl	Deref			; get a real address		stx	my_fcr_ptr		; save for filling in		sty	my_fcr_ptr+2		ldy	#vcr.open_cnt		lda	[my_vcr_ptr],y		; get volume's open file count		ina				; plus 1 for this file		sta	[my_vcr_ptr],y		; and update open count		lda	#$8000			; don't allow eject of volume		jsr	set_eject		; set eject status				lda	#my_fst_id		ldy	#fcr.fst_id		sta	[my_fcr_ptr],y		; set FST ID = mine				lda	[my_vcr_ptr]		; get VCR ID		iny		iny				; Y = fcr.vcr_id		sta	[my_fcr_ptr],y		; save FCR's VCR ID		lda	#0			; turn off buffering		ldy	#fcr.flags		sta	[my_fcr_ptr],y		; save buffer flag.		lda	request_access		; get access they wanted		ldy	#fcr.access		sta	[my_fcr_ptr],y		; save opened access		xba				; put in AFP byte order		pha				; save access mode word				lda	#afpOpenFork		ora	fork_number		; add in data/res flag		jsr	StartPacket		; start an OpenFork packet		jsr	PutIDs			; copy VolID, DirID				lda	#0			; don't want file parameters		jsr	PutWord			; so put null bitmap				pla				; get access mode		jsr	PutWord				clc				; don't align after path		jsr	PutPath			; put pathname in packet				jsr	SendPacket		; try the open		jsr	CheckParent		; check for path not found		bcs	abort			; remove FCR and return error				jsr	StartReply		; get ready to look at reply		jsr	GetWord			; ignore bitmap word				lda	fork_number		; get data/resource flag		lsr	a			; shift to $4000 bit		ldy	#fcr.dirflag		sta	[my_fcr_ptr],y		; save data/resource flag		jsr	GetWord			; get AFP fork refnum		ldy	#fcr.forkrefnum		sta	[my_fcr_ptr],y		; save in FCR				lda	#0			; start mark at 0		iny		iny				; Y = fcr.mark		sta	[my_fcr_ptr],y		iny		iny		sta	[my_fcr_ptr],y		lda	[my_fcr_ptr]		; get FCR # (file refnum)		ldy	#4			; offset of refnum		sta	[my_pb_ptr],y		; return to user		clc		lda	#0			; no errorexit		jmp	sp_exitabort		pha				; save error code		jsr	remove_fcr		; get rid of the FCR		pla		sec		bcs	exit			; return with error		endwith				; with dp		endpget_priv	proc		with	dp,mydata				ProcName getprivileges				lda	#6			; offset to path 1 pointer		ldx	#0			; FST attributes		ldy	#0			; select path 1		jsl	parse_path		jsr	proc_path1		; parse pathname		bcc	@ok_path		brl	exit			; return the error@ok_path;------------------------------------------------------------; Now that I have the path, do the GetFileDirParms.;------------------------------------------------------------		lda	#afpGetFlDrParms		jsr	StartPacket				jsr	PutIDs			; put VolID, DirID in				lda	#$0000			; no parameters for files		jsr	PutWord				lda	#$001C			; access, group ID, creator ID		jsr	PutWord			; requested for folders				clc				; no alignment after path		jsr	PutPath			; put partial path in packet				jsr	SendPacket		; shoot it out the door		jsr	CheckParent		; check for path not found		bcs	@go_exit		; return error if any				jsr	StartReply		; get the results				jsr	GetLong			; ignore bitmaps				jsr	GetWord			; get file/dir flag		and	#$0080			; is dir flag set?		bne	@ok_type		; if dir, continue				sec		lda	#bad_store_type		; can't do this to files!@go_exit	brl	exit@ok_type		jsr	GetLong			; get UserID		sta	my_user_id		; save for later call		stx	my_user_id+2				jsr	GetLong			; get primary group ID		sta	my_group_id		; save it for later, too.		stx	my_group_id+2				jsr	GetLong			; Get access bytes		ldy	#8			; offset to access bytes in pb		sta	[my_pb_ptr],y		; save first two bytes		iny		iny		txa				; get last two bytes		sta	[my_pb_ptr],y		; save last two bytes				lda	pcount		sec		sbc	#4			; already handled first 4 parms		sta	pcount		beq	ok_exit		;------------------------------------------------------------; Now return owner name;------------------------------------------------------------		lda	#afpMapUserID		; map user ID to user name		jsr	StartPacket				lda	my_user_id		; get user ID to map		ldx	my_user_id+2		jsr	PutLong				jsr	SendPacket		; go do it		bcs	exit			; return any errors		lda	reply_buf		; get pointer to returned string		sta	src_ptr			; save as pointer to source string		lda	reply_buf+2		sta	src_ptr+2				ldy	#12			; offset in pb of name buffer pointer		lda	[my_pb_ptr],y		sta	dest_ptr		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2				jsr	Out_PStr		; return the string to a buffer		bcs	exit			; exit on any error		dec	pcount		beq	ok_exit		;------------------------------------------------------------; Now return primary group name;------------------------------------------------------------		lda	#afpMapGroupID		; map group ID to group name		jsr	StartPacket				lda	my_group_id		; get user ID to map		ldx	my_group_id+2		jsr	PutLong				jsr	SendPacket		; go do it		bcs	exit			; return any errors		lda	reply_buf		; get pointer to returned string		sta	src_ptr			; save as pointer to source string		lda	reply_buf+2		sta	src_ptr+2				ldy	#16			; offset in pb of group buffer pointer		lda	[my_pb_ptr],y		sta	dest_ptr		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2				jsr	Out_PStr		; return the string to a buffer		bra	exit			; return error if anyok_exit		clc		lda	#0			; no errorexit		jmp	sp_exit				endwith				; with dp		endpset_priv	proc		with	dp,mydata				ProcName setprivileges				lda	#6			; offset to path 1 pointer		ldx	#0			; FST attributes		ldy	#0			; select path 1		jsl	parse_path		jsr	proc_path1		; parse pathname		bcc	@ok_path		brl	exit			; return any error@ok_path		lda	#$0010			; access only		sta	my_bitmap		; is minimum bitmap;------------------------------------------------------------; If they supplied a group name, map it to an ID.;------------------------------------------------------------		lda	pcount		cmp	#6			; did they include group?		blt	no_group		; no, so don't set group				lda	#$0008			; group		tsb	my_bitmap		; add to bitmap		lda	#afpMapGroupName		jsr	StartPacket				ldy	#16			; offset to group name pointer		lda	[my_pb_ptr],y		; get low word of pointer		sta	src_ptr		iny		iny		lda	[my_pb_ptr],y		sta	src_ptr+2				ldy	#2		lda	[src_ptr],y		; get length word of string		pha				; save for later		jsr	PutByte			; save string length				clc		lda	src_ptr			; get address of structure		adc	#4			; + 4 to point to first char		tax				; low word in X		lda	src_ptr+2		adc	#0		tay				; high word in Y		pla				; recover length		jsr	PutBlock		; copy the text into packet				jsr	SendPacket		bcc	@ok		lda	#group_not_found	; don't know this group		brl	exit			; return the error@ok		jsr	StartReply		jsr	GetLong			; get the group ID		sta	my_group_id		; and save it off		stx	my_group_id+2		no_group;------------------------------------------------------------; If they supplied an owner name, map it to an ID.;------------------------------------------------------------		lda	pcount		cmp	#5			; did they include owner?		blt	no_owner		; no, so don't set owner				lda	#$0004			; owner		tsb	my_bitmap		; set owner, too		lda	#afpMapUserName		jsr	StartPacket				ldy	#12			; offset to owner name pointer		lda	[my_pb_ptr],y		; get low word of pointer		sta	src_ptr		iny		iny		lda	[my_pb_ptr],y		sta	src_ptr+2				ldy	#2		lda	[src_ptr],y		; get length word of string		pha				; save for later		jsr	PutByte			; save string length				clc		lda	src_ptr			; get address of structure		adc	#4			; + 4 to point to first char		tax				; low word in X		lda	src_ptr+2		adc	#0		tay				; high word in Y		pla				; recover length		jsr	PutBlock		; copy the text into packet				jsr	SendPacket		bcc	@ok		lda	#user_not_found		; don't known this user		bra	exit@ok		jsr	StartReply		jsr	GetLong			; get the user ID		sta	my_user_id		; and save it off		stx	my_user_id+2no_owner;------------------------------------------------------------; Make the FPSetDirParms call.;------------------------------------------------------------		lda	#afpSetDirParms		jsr	StartPacket				jsr	PutIDs				lda	my_bitmap		jsr	PutWord				sec				; pad after pathname		jsr	PutPath				lda	my_bitmap		and	#$0004			; setting the owner?		beq	skip_owner		; if not, don't put in packet				lda	my_user_id		ldx	my_user_id+2		jsr	PutLong			; put user ID in packetskip_owner		lda	my_bitmap		and	#$0008			; setting group?		beq	skip_group				lda	my_group_id		ldx	my_group_id+2		jsr	PutLong			; put group ID in packetskip_group		ldy	#10			; offset to access (high) in pb		lda	[my_pb_ptr],y		tax				; put high word in X		dey		dey		lda	[my_pb_ptr],y		; get low word in A		and	#$FF00			; zero out user summary byte		jsr	PutLong			; put access bytes in				jsr	SendPacket		; send it out		jsr	CheckParent		; check for path not found		bcs	exit		clc		lda	#0			; no errorexit		jmp	sp_exit				endwith				; with dp		endpgetdefpriv	procpb		record	0			; parameter block format		ds.w	1			; FST#		ds.w	1			; command #flags		ds.l	1access		ds.l	1			; access rightsowner		ds.l	1			; pointer to owner buffergroup		ds.l	1			; pointer to group buffer		endr				with	dp,mydata		ProcName getdefpriv		; BEGIN 26-Sep-91 MSD;------------------------------------------------------------; Always return flags;------------------------------------------------------------		ldy	#pb.flags		lda	def_flags		sta	[my_pb_ptr],y		iny		iny		lda	def_flags+2		sta	[my_pb_ptr],y				sec		lda	pcount		sbc	#3			; done through flags		sta	pcount			; update it		beq	ok_exit			; done => return no error; END 26-Sep-91 MSD;------------------------------------------------------------; Return access rights;------------------------------------------------------------		lda	def_access		ldy	#pb.access		sta	[my_pb_ptr],y		; return access rights; BEGIN 16-Jan-91 change		iny		iny		lda	def_access+2		sta	[my_pb_ptr],y		; return upper word; END 16-Jan-91 change		dec	pcount			; 26-Sep-91 MSD		beq	ok_exit			; 26-Sep-91 MSD		;------------------------------------------------------------; Return owner name string last set (flags tell if it is actually; being changed on newly created directories).;------------------------------------------------------------		ldy	#pb.owner		lda	[my_pb_ptr],y		; copy pointer to buffer		sta	dest_ptr		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2		ora	dest_ptr		; is it NULL?		beq	did_owner		; skip copy of owner name				lda	#<def_owner		sta	src_ptr			; point to def. owner		lda	#^def_owner		sta	src_ptr+2				jsr	Out_PStr		; try to put in buffer		bcs	exit			; return errordid_owner		dec	pcount			; anything else?		beq	ok_exit			; no, so return no error;------------------------------------------------------------; Return group name string last set (flags tell if it is actually; being changed on newly created directories).;------------------------------------------------------------		ldy	#pb.group		lda	[my_pb_ptr],y		; copy pointer to buffer		sta	dest_ptr		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2		ora	dest_ptr		; is it NULL?		beq	ok_exit			; yes, so done				lda	#<def_group		sta	src_ptr			; point to def. group		lda	#^def_group		sta	src_ptr+2				jsr	Out_PStr		; try to put in buffer		bra	exit			; doneok_exit		clc		lda	#0			; no errorexit		jmp	sp_exit				endwith		endp				setdefpriv	procpb		record	0			; parameter block format		ds.w	1			; FST#		ds.w	1			; command #flags		ds.l	1access		ds.l	1			; access rightsowner		ds.l	1			; pointer to owner buffergroup		ds.l	1			; pointer to group buffer		endr				with	dp,mydata				ProcName setdefpriv;------------------------------------------------------------; Set owner and group strings to the empty string in case the; user doesn't supply them.  If they are supplied, then the; new values will be stored later.;------------------------------------------------------------		stz	def_owner		stz	def_group		;------------------------------------------------------------; Set flags;------------------------------------------------------------		ldy	#pb.flags		lda	[my_pb_ptr],y		sta	def_flags		iny		iny		lda	[my_pb_ptr],y		sta	def_flags+2				sec		lda	pcount		sbc	#3			; done through flags		sta	pcount		bne	rights			; more to do; Here, they only supplied flags.  If they're trying to set the; access rights, don't let 'em do it (it doesn't make sense).		lda	def_flags		and	#fSetRights		; access rights bit set?		beq	ok_exit			; all is well in the world				sec				; indicate error		lda	#invalid_parm		bra	exit;------------------------------------------------------------; Set Access Rights;------------------------------------------------------------rights		ldy	#pb.access		; don't copy flags		lda	[my_pb_ptr],y		; world & group access		sta	def_access		iny		iny		lda	[my_pb_ptr],y		; group & owner access		sta	def_access+2				dec	pcount			; is that all?go_ok_exit	beq	ok_exit		;------------------------------------------------------------; Set Default Owner;------------------------------------------------------------		ldy	#pb.owner		lda	[my_pb_ptr],y		sta	src_ptr			; point to owner name		iny		iny		lda	[my_pb_ptr],y		sta	src_ptr+2				ora	src_ptr			; is it NULL (i.e. guest)		beq	owner_done		; yes, so leave null owner name				lda	[src_ptr]		; get length		cmp	#32			; less than 32?		blt	owner_len		; yes, so use it				sec				; error:		lda	#user_not_found		; bad owner name		bra	exitowner_len		sta	def_owner		; set length byte		tay				; Y = index to GString		iny				; add 1 because length is word		tax				; X = index to def_owner		beq	owner_done		; NULL? skip copy@loop		lda	[src_ptr],y		; get from GString		sta	def_owner,x		; put in def_owner		dey		dex		bne	@loop			; more to copy?owner_done		dec	pcount			; anything else?		beq	ok_exit		;------------------------------------------------------------; Set Default Group;------------------------------------------------------------		ldy	#pb.group		lda	[my_pb_ptr],y		sta	src_ptr			; point to group name		iny		iny		lda	[my_pb_ptr],y		sta	src_ptr+2				ora	src_ptr			; is it NULL (i.e. no group)		beq	group_done		; yes, so leave null group name				lda	[src_ptr]		; get length		cmp	#32			; less than 32?		blt	group_len		; yes, so use it				sec				; error:		lda	#group_not_found	; bad group name		bra	exitgroup_len		sta	def_group		; set length byte		tay				; Y = index to GString		iny				; add 1 because length is word		tax				; X = index to def_group		beq	ok_exit			; NULL? skip copy@loop		lda	[src_ptr],y		; get from GString		sta	def_group,x		; put in def_group		dey		dex		bne	@loop			; more to copy?group_doneok_exit		clc		lda	#0			; no errorexit		jmp	sp_exit				endwith		endp						user_info	proc		with	dp,mydata		import	id_vol		ProcName user_info		;------------------------------------------------------------; First, make sure device is an AFP driver, or else return; an inval_dev_num error.;------------------------------------------------------------		ldy	#4			; offset to device number		lda	[my_pb_ptr],y		; get device number		jsr	id_vol			; go see if it's mine		bcc	found_vol		; it's mine!		cmp	#bad_vol_type		bne	@err			; change unsupported volume type		lda	#inval_dev_num		; to invalid device number@err		brl	err_exitfound_vol;------------------------------------------------------------; Send an FPUserInfo command out to find user and primary; group numbers.;------------------------------------------------------------		lda	#afpGetUserInfo+$100	; set "This User" bit		jsr	StartPacket				lda	#0			; UserID = 0		tax		jsr	PutLong				lda	#$300			; get UserID and Primary Group ID		jsr	PutWord				jsr	SendPacket		; go send off the packet		bcc	@ok		brl	exit			; return any errors@ok		jsr	StartReply		; process reply packet		jsr	GetWord			; ignore bitmap				jsr	GetLong			; get UserID		sta	my_user_id		; save for later call		stx	my_user_id+2				jsr	GetLong			; get primary group ID		sta	my_group_id		stx	my_group_id+2		;------------------------------------------------------------; Turn UserID into user name;------------------------------------------------------------		lda	#afpMapUserID		; map user ID to user name		jsr	StartPacket				lda	my_user_id		; get user ID to map		ldx	my_user_id+2		jsr	PutLong				jsr	SendPacket		; go do it		bcs	exit			; return any errors		lda	reply_buf		; get pointer to returned string		sta	src_ptr			; save as pointer to source string		lda	reply_buf+2		sta	src_ptr+2				ldy	#6			; offset in pb of name buffer pointer		lda	[my_pb_ptr],y		sta	dest_ptr		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2				jsr	Out_PStr		; return the string to a buffer		bcs	exit		lda	pcount		cmp	#4			; skip group name?		beq	ok_exit			; yes, exit with no errordo_group;------------------------------------------------------------; Turn primary group ID into primary group name;------------------------------------------------------------		lda	#afpMapGroupID		; map group ID to group name		jsr	StartPacket				lda	my_group_id		; get user ID to map		ldx	my_group_id+2		jsr	PutLong				jsr	SendPacket		; go do it		bcs	exit			; return any errors		lda	reply_buf		; get pointer to returned string		sta	src_ptr			; save as pointer to source string		lda	reply_buf+2		sta	src_ptr+2				ldy	#10			; offset in pb of group buffer pointer		lda	[my_pb_ptr],y		sta	dest_ptr		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2				jsr	Out_PStr		; return the string to a bufferexit		jmp	sp_exitok_exit		clc		lda	#0		bra	exiterr_exit		sec		bra	exit		endwith				; with dp		endpcopy_file	proc		with	dp,mydata				import	two_file_call:code				ProcName copy_file				lda	#6			; offset to path 1		ldx	#0			; FST attributes		ldy	#0			; select path 1		jsl	parse_path		lda	#10			; offset to path 2		ldx	#0			; FST attributes		ldy	#1			; select path 2		jsl	parse_path		;------------------------------------------------------------; Process the source path.  Volume only is bad storage type.;------------------------------------------------------------		jsr	proc_path1		; parse source pathname		bcs	exit				lda	volume_sep		; root only?		beq	bad_type		; can't do it to root		lda	#afpCopyFile		; move and rename		sta	my_call_num		; save as call to issue				stz	same_vol_flag		; don't need same volume				jmp	two_file_call		; do common code in ChangePathexit		jmp	sp_exit			; return to callerbad_type		lda	#bad_store_type		; illegal copy: volume only		sec		bcs	exit		endwith				; with dp		endp;------------------------------------------------------------; Find_recs;; Given an open file refnum in A, set up the pointer to the; FCR and VCR.  Extract SessRefnum and VolID from VCR.  Make; sure I own this FCR (return invalid refnum if not).;; On entry:;	A = refnum;; On exit:;	c = 0 => no error;	c = 1 => error (A = error code);	my_fcr_ptr = address of FCR;	my_vcr_ptr = address of VCR;	SessRefnum = session reference number for volume;	VolID      = volume ID for volume;------------------------------------------------------------find_recs	proc		with	dp,mydata				ProcName find_recs				jsl	find_fcr		bcs	bad_ref			; error is invalid refnum		jsl	deref			; get real address		stx	my_fcr_ptr		sty	my_fcr_ptr+2		ldy	#fcr.fst_id		lda	[my_fcr_ptr],y		; get owning FST		cmp	#my_fst_id		; is this FCR mine?		bne	bad_ref			; if not, do error		ldy	#fcr.vcr_id		lda	[my_fcr_ptr],y		; get corresponding VCR		jsl	find_vcr		; find my VCR		bcs	bad_ref			; should never get an error!		jsl	deref		stx	my_vcr_ptr		sty	my_vcr_ptr+2				ldy	#vcr.sessrefnum		lda	[my_vcr_ptr],y		; get SessRefnum		sta	SessRefnum				iny		iny				; Y = vcr.volid		lda	[my_vcr_ptr],y		; get VolID of volume		sta	VolID		clc				; no errorsexit		rtsbad_ref		sec		lda	#inval_refnum		; error must be invalid refnum		bra	exit		endwith				; with dp		endp;------------------------------------------------------------; Get_User_Path;; Returns a pointer to a class 1 string containing the path; to the user's folder on the user volume.  The string is of; the form:;	:VolumeName:Users:UserName; where UserName is <Any User> if logged on as a guest.;; It first builds the string with slashes (/) instead of; colons so it can be passed to FIUserPrefix.  The slashes; are then changed to colons before returning.;;------------------------------------------------------------get_user_path	procstat_userbit	equ	5		with	dp,mydata		import	(id_vol,process_path,com_get_info):code		ProcName get_user_path				lda	#1loop		sta	my_dev_num		jsr	id_vol			; see if it's mine		bcc	check_user		; see if it is a user volume				cmp	#inval_dev_num		bne	next			; other error, do next vol		brl	none			; none foundnext		lda	my_dev_num		; get last dev num		ina				; try the next one		bra	loopcheck_user		ldy	#stat_userbit		lda	[gbuf_ptr],y		and	#1			; get user volume bit		beq	next			; not set, try next volume		lda	#1			; start with colon		sta	user_path		lda	#':'		sta	user_path+2		; first char is colon				ldx	#<gstring		ldy	#^gstring		jsr	append			; add volume name				ldx	#<user_string		ldy	#^user_string		jsr	append			; add ":users:"				lda	#afpGetUserInfo+$100	; get my info		jsr	StartPacket				jsr	PutLong			; ignore user ID				lda	#$100			; my user ID only		jsr	PutWord				jsr	SendPacket		bcs	bcs_none		; on error, couldn't find it				jsr	StartReply		jsr	GetWord			; ignore bitmap		jsr	GetLong			; get my user ID		pha				; save user ID on stack		phx				lda	#afpMapUserID		; map my ID to a name		jsr	StartPacket				plx		pla				; recover my user ID		jsr	PutLong				jsr	SendPacket		bcs	bcs_none				lda	reply_pkt		and	#$00FF			; get length of user name		bne	registered		; if zero, then user "<Any User>"				ldx	#<any_user		ldy	#^any_user		bra	append_name		registered		pushlong #reply_pkt		pushlong #reply_pkt		jsr	cvt_0_to_1		; convert to class 1 string				ldx	#<reply_pkt		ldy	#^reply_pktappend_name		jsr	append		;; Begin 7-Jun-91 MSD fix.  I shouldn't return the path to the user's folder; unless the folder actually exists.  So, now I actually get info on the; path I just created (and make sure it is a folder).;		lda	#31			; assume maximum span		sta	my_span			; 18-Dec-91 MSD		stz	my_dev_num		; don't use device number		lda	#<user_path		; point to the path		sta	my_path_ptr		lda	#^user_path		sta	my_path_ptr+2		jsr	process_path		; go find the VolID, DirID, etc.bcs_none	bcs	none			; error implies it doesn't exist				jsr	com_get_info		; use existing FPGetFileDirParms code		bcs	none			; error means it doesn't exist				lda	my_filetype		; com_get_info set this		cmp	#$F			; was it a directory?		bne	none			; no, so not a valid user path;; End 7-Jun-91 MSD fix.;; By the time we get here, we've constructed the path and know that; the given path actually exists and is a folder.;;; 8-Nov-91 MSD: Add a trailing slash, convert it to a PString, and; use it to set FIUserPrefix.  Then get rid of the trailing slash and; convert the slashes to colons, and change it back to a class 1 string.;		lda	user_path		; get current length		ina				; add 1 for trailing slash		tay				; save in Y for index		xba				; convert to PString		sta	user_path		; PString at user_path+1		lda	#'/'			; trailing slash		sta	user_path+1,y		; will write 2 bytes!				ldy	gstring			; get length of volume name				sep	#$20			; short A for storing chars		longa	off				sta	user_path+2		; change leading colon to slash		sta	user_path+3,y		; slash after volume name		sta	user_path+2-us_start+us_end,y ; slash after Users				rep	#$20		longa	on				ATCall	FIUserPrefix		; set the user prefix				lda	user_path		xba				; back to class 1 string		dea				; remove trailing slash		sta	user_path				ldy	gstring			; get length of volume name				sep	#$20			; short A for storing chars		longa	off				lda	#':'			; GS/OS uses colons, not slashes		sta	user_path+2		; change leading slash		sta	user_path+3,y		; colon after volume name		sta	user_path+2-us_start+us_end,y ; colon after Users		rep	#$20		longa	on;; End 8-Nov-91 MSD fix.;		ldy	#4		lda	#<user_path		sta	[my_pb_ptr],y		; return low word of pointer		iny		iny		lda	#^user_path		sta	[my_pb_ptr],y		; return high word of pointer				clc				; it all worked out		lda	#0exit		jmp	sp_exitnone		sec		lda	#data_unavail		; return this if path couldn't be set		bcs	exit		user_path	ds.b	70			; more than enoughuser_string	dc.w	us_end-us_start		; length word for stringus_start	dc.b	':Users:'us_endany_user	dc.w	au_end-au_startau_start	dc.b	'<Any User>'au_endFIUserPrefix		dc.b	0,$2A		dc.w	0		dc.b	$AA			; SET the prefix		dc.l	user_path+1;------------------------------------------------------------; Append;; This routine appends the class 1 string pointed to by X,Y; to the class 1 string in user_path.;------------------------------------------------------------append		stx	src_ptr			; save address of string		sty	src_ptr+2				clc		lda	user_path		adc	#<user_path		sta	dest_ptr		; set up destination address		lda	#^user_path		adc	#0		sta	dest_ptr+2				lda	[src_ptr]		; get string length		tax				; in X as loop counter		ldy	#1			; remember: length WORD, not byte		sep	#$20			; short A for chars		longa	off@loop		iny				; point to next byte to move		lda	[src_ptr],y		sta	[dest_ptr],y		dex				; done yet?		bne	@loop				rep	#$20		longa	on				dey				; get real length of string		tya				; put in A for math		clc		adc	user_path		; add to old length to get new length		sta	user_path		; and update string length				rts		endwith				; with dp		endp;------------------------------------------------------------; Open_DT;; Given a pathname (volume name), the desktop database for; that volume is opened and the desktop refnum is returned.;;------------------------------------------------------------open_dt		proc		with	dp,mydata				ProcName open_dt				lda	#8			; offset to path 1		ldx	#0			; FST attributes		ldy	#0			; select path 1		jsl	parse_path		jsr	proc_path1		; parse pathname		bcs	exit			; return any error		lda	#afpDTOpen		jsr	StartPacket				lda	VolID			; only parameter is VolID!		jsr	PutWord				jsr	SendPacket		bcs	exit				jsr	StartReply				jsr	GetWord			; get DTRefnum		ldy	#4			; offset to refnum		sta	[my_pb_ptr],y		; return the refnum				clc		lda	#0			; no errorexit		jmp	sp_exit				endwith				; with dp		endp				;------------------------------------------------------------; Close_DT;; Given a desktop refnum of an open desktop database, the; desktop database is closed.;;------------------------------------------------------------close_dt	proc		with	dp,mydata				ProcName close_dt		lda	#8			; offset to path 1		ldx	#0			; FST attributes		ldy	#0			; select path 1		jsl	parse_path		jsr	proc_path1		; parse pathname		bcs	exit			; return any error		lda	#afpDTClose		jsr	StartPacket				ldy	#4			; offset to DTRefnum		lda	[my_pb_ptr],y		jsr	PutWord				jsr	SendPacketexit		jmp	sp_exit		; return error if any		endwith				; with dp		endp;------------------------------------------------------------; Get_Comment;; Given a desktop refnum and pathname, the comment for the; given path in the given database is returned.  If no; comment exists for the path, null string is returned.;;------------------------------------------------------------get_comment	proc		with	dp,mydata				ProcName get_comment				lda	#8			; offset to path 1		ldx	#0			; FST attributes		ldy	#0			; select path 1		jsl	parse_path		jsr	proc_path1		; parse pathname		bcs	exit			; return any error		lda	#afpGetCmt		; get comment		jsr	StartPacket				ldy	#4			; offset to DTRefnum		lda	[my_pb_ptr],y		jsr	PutWord				lda	DirID		ldx	DirID+2		jsr	PutLong			; put DirID in packet				clc				; no alignment after path		jsr	PutPath			; put path in				jsr	SendPacket		; go do it		jsr	CheckParent		; check for path_not_found		bcc	@got_cmt				cmp	#data_unavail		; no comment?		bne	err_exit		; other error, report it				stz	reply_pkt		; zero out comment length@got_cmt		lda	#<reply_pkt		; set up source address for		sta	src_ptr			; Out_PStr		lda	#^reply_pkt		sta	src_ptr+2				ldy	#10			; offset to buffer pointer		lda	[my_pb_ptr],y		; get output buffer address low		sta	dest_ptr		; set up for Out_PStr		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2				jsr	Out_PStr			; return comment to userexit		jmp	sp_exiterr_exit		sec				; force carry set for error		bcs	exit		endwith				; with dp		endp;------------------------------------------------------------; Set_Comment;; Given a desktop refnum, pathname, and comment string this; call sets the comment for the given pathname to the given; comment string.  If the comment string is null, the comment; for the path is removed.;;------------------------------------------------------------set_comment	proc		with	dp,mydata				ProcName set_comment				lda	#8			; offset to path 1		ldx	#0			; FST attributes		ldy	#0			; select path 1		jsl	parse_path		jsr	proc_path1		; parse pathname		bcs	exit			; return any error		lda	pcount		cmp	#4			; give a comment string?		beq	remove			; no, so remove comment		ldy	#10			; offset to comment		lda	[my_pb_ptr],y		sta	src_ptr		iny		iny		lda	[my_pb_ptr],y		sta	src_ptr+2		lda	[src_ptr]		; null string?		beq	remove			; yes, so remove comment				lda	#afpAddCmt		jsr	StartPacket				ldy	#4			; offset to DTRefnum		lda	[my_pb_ptr],y		jsr	PutWord				lda	DirID		ldx	DirID+2		jsr	PutLong			; put DirID in packet				sec				; align after path		jsr	PutPath			; put path in packet				lda	[src_ptr]		; get string length		cmp	#199			; truncate to 199 chars if more		blt	@less		lda	#199			; max length is 199@less		pha				; save length		jsr	PutByte				clc		lda	src_ptr		adc	#2			; point to start of text		tax				; in X,Y		lda	src_ptr+2		adc	#0		tay		pla				; recover length		jsr	PutBlock				jsr	SendPacket		jsr	CheckParentexit		jmp	sp_exit;------------------------------------------------------------; We were given a null string, so do an FPRemoveComment;------------------------------------------------------------remove		lda	#afpRmvCmt		jsr	StartPacket				ldy	#4			; offset to DTRefnum		lda	[my_pb_ptr],y		jsr	PutWord				lda	DirID		ldx	DirID+2		jsr	PutLong			; put DirID in packet				clc				; no alignment		jsr	PutPath				jsr	SendPacket		jsr	CheckParent		cmp	#data_unavail		; no comment to remove?		bne	@other			; no, so don't change		lda	#0			; becomes no error@other		cmp	#1			; set carry if A<>0		bra	exit				endwith				; with dp		endp;------------------------------------------------------------; GetSrvrName;; Given a pathname, this command returns the server name and; zone name for that volume.;;------------------------------------------------------------getsrvrname	proc		with	dp,mydata				ProcName getsrvrname				lda	#6			; offset to path 1		ldx	#0			; FST attributes		ldy	#0			; select path 1		jsl	parse_path		jsr	proc_path1		; parse pathname		bcc	@ok_path		brl	exit			; return the error@ok_path		ldy	#vcr.dev		lda	[my_vcr_ptr],y		; get device number		sta	dev_num			; prepare to call it				lda	#drvr_status		; do a status call		sta	dev_callnum				lda	gbuf_ptr		; buffer is GBUF		sta	dev_buff		lda	gbuf_ptr+2		sta	dev_buff+2				lda	#tConfig.size		; get everything (and names)		sta	dev_req_cnt		stz	dev_req_cnt+2				lda	#stat_config		; get configuration		sta	dev_stat_code				jsl	Dev_Dispatcher		; go make the call		bcs	exit		ldy	#8			; offset to name buffer pointer		lda	[my_pb_ptr],y		sta	dest_ptr		; is destination		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2		ora	dest_ptr		; any pointer given?		beq	skip_srvr		; if not, don't return it				clc		lda	gbuf_ptr		adc	#tConfig.server		; get pointer to server name		sta	src_ptr			; configuration data		lda	gbuf_ptr+2		adc	#0		sta	src_ptr+2				jsr	Out_PStr		bcs	exitskip_srvr		lda	pcount		cmp	#4			; did they want zone name, too?		beq	ok_exit		ldy	#$C			; offset to zone name buffer		lda	[my_pb_ptr],y		sta	dest_ptr		; is destination		iny		iny		lda	[my_pb_ptr],y		sta	dest_ptr+2				clc		lda	gbuf_ptr		adc	#tConfig.zone		; get pointer to zone name		sta	src_ptr			; configuration data		lda	gbuf_ptr+2		adc	#0		sta	src_ptr+2				jsr	Out_PStrexit		jmp	sp_exit		; return from callok_exit		clc		lda	#0		bra	exit				endp;------------------------------------------------------------; SetBootVol;; This command should never be called by a user application.; It is used only when booting over the network, when the; name of the boot volume must be set to the user volume.;;------------------------------------------------------------setbootvol	proc		with	dp,mydata		import	id_vol:code				ProcName setbootvol				lda	#1			; boot device		jsr	id_vol			; see if it's mine		bcs	exit			; return if error				ldx	gstring			; get length of volume name		inx				; plus 1 for leading ":"		lda	#'::'			; leading colon		sta	gstring		stx	gstring-1		; new length before name		; 20-Jun-90 (MSD): Do a RenamePathname call to the System Loader so it also; knows about the "rename" of the boot volume (since SCM does it only on a; ChangePath call).		jsl	get_boot_pfx		; get pointer to '*' prefix in X,Y		phy				; push pointer to original path		phx				; push low word		pea	gstring-1>>16		; push pointer to new path		pea	gstring-1		ldx	#$1311			; Loader: RenamePath		jsl	$E10000; <-- End of 20-Jun-90 change		ldx	#<gstring-1		; point to ":<volume_name>"		ldy	#^gstring-1		jsl	set_boot_pfx		; tell SCM to update "*"		bcs	exit;------------------------------------------------------------; It's done.  Return with no errors.;------------------------------------------------------------		clc		lda	#0exit		jmp	main_exit		; (init_parse_path never called)				endp				end