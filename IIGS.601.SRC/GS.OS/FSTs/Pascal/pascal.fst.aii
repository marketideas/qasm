			PRINT NOHDR******************************************************************** GS/OS Pascal File System Translator* Copyright Apple Computer, Inc. 1989-1992.  All Rights Reserved.** Written by Cary Farrier** Thanks to Bryan Atsatt and Rob Turner for providing me with the* source to both the High Sierra and ProDOS FST's, respectively,* and for answering all my questions.*******************************************************************	 EJECT******************************************************************** REVISION HISTORY:*	* Date		By		Description** 			CAF 	Initial Release* 10/13/89	CAF		Fixed bug in id_disk where I was sending calls*					to non-block devices.  I now check the device*					type before talking to the device.* 01/02/89	CAF		Now uses system 1k gbuffer.  Added eof cache*					for text files into the vcr.* 03/14/90	CAF		Changed storage type for files (in get_file)*					to a 1.  Fixed some major bugs in the ASCII*					portion of read_io_block.* 06/17/90	CAF		Fixed ASCII mode.  The PFST will now strip*					all non-ascii chars from a text file during*					reading.* 09/04/90	CAF		Fixed a bug where I was returning garbage in*					the mod_date/time field (LYP210WMP).  Fixed*					a bug where I was not setting up the create*					date for a GFI on a volume directory (LYP*					205WMP).  Fixed a bug where the total_blocks*					(aux_type) was not being set correctly on*					a GFI on a volume directory (LYP207WMP).*					Fixed a bug where the blocks_used field was*					being set the the total number of blocks*					on a volume GFI call, when it should have been*					set to the number of used blocks (LYP206WMP).* 09/05/90	CAF		Implemented the option_list parameter (LYP208WMP).* 09/06/90	CAF		Fixed a bug where I was returning a write_protect*					error when I should have been returning a *					volume_not_found error.* 09/24/90	CAF		Fixed bug LYP215LWA, setting blocks_used incorrectly*					on a c1 GFI call.  Fixed bug LYP214LWA, setting aux_type*					incorrectly on a c1 GFI call.  Changed access to*					$c3 for all files.* 09/25/90	CAF		Fixed a bug where I was putting garbage in the ref_num*					parameter.  Fixed a bug where I was incorrectly returning*					info in the blocks_used parm for a c1 open on a volume*					directory.* 09/26/90	CAF		Fixed a bug in read_io_block that was causing me to *					read every type of file as an ascii file if in ascii mode.* 09/27/90	CAF		Fixed a bug in set_mark where you couldn't set the mark*					= eof (LYP220LWA).* 11/09/90	CAF		Fixed a bug in get_dir_entry where I wasn't setting up the*					drvr_dev_num if the end_of_dir was reached, and so a*					get_last_dev call would not work right.* 12/06/90	CAF		Fixed a bug in break_down_path where I wasn't checking*					the validity of a path correctly when the path began*					with a device number (LYP240LWA).* 12/07/90	CAF		Changed volume to return the volume name on a duplicate*					volume error if a device name was used.* 12/18/90	CAF		Fixed a bug in open where I was setting the blocks_used*					parameter if a volume directory was opened (LYP253LWA).* 12/19/90	CAF		Added "support" for judge name call ($07).** 01/04/91	jev		Removed credit string from options list as requested.** 02/11/91	jev		changed error code fron $4E to $4A on a GetDirEntry call.** 03/31/91	jev		added error priority support.  Added new flags in FST header*					to indicate apple format and read-only fst.** 08/22/91  jev		fixed error priority support.  flag was getting set, but*					was never being incorporated in the final error.  all*					error reporting now goes thru main_exit which or's*					whatever error code with the error_priority flag.** 08/22/91	jev		fixed bug #88735.  Open call and Getfileinfo call were*					not IDing the disk before reporting any errors in the*					input parms.  This resulted in a no bouncing error for*					a call that had nothing to do with our file system.** 08/22/91	jev		fixed bug #86427.  Destroy call was returning the wrong*					error.** 25-Oct-91 DAL		Fixed bug #1014835, where we were ignoring FDHD disks*					on Mustang (device_id $0017).* * 11/07/91	GAB		Procedure read_block wasn't zeroing the high word of the*					  block number prior to performing a driver read.  If the*				 	  high work happened to be non-zero, the driver would*					  happily overwrite memory beyond the general buffer at*					  $9A00 (which happened to be where GS/OS resides).*					Procedure read_block was using a random value to set the*					  FST_ID direct page parameter, due to a missing '#'.** 12/05/91	GAB		Change maximum allowable pCount for ChangePath to 3.** 12/18/91	MSD		Removed checking of span1 from p_pathname and moved*					it to find_target so it will find the volume and set*					the error priority bit first.  Added code to check*					the length of g_volname and g_filename as they get*					copied.  Removed g_pathname and code that copies it*					(it never gets used later).  The p_pathname routine*					now does nothing.  Changed version number to 1.00 final.** 01/13/92	GAB		Rewrote break_down_path.  Original version was using*					the pathname length as the limit for the volume name*					and/or pathname without taking into account the *					pathname separators.  This would cause the subroutine*					to return with a BadPathSyntax error if there was*					no trailing separator on a volume name, since it*					walked past the actual end of the supplied volume*					name and fell through into Mark's new volume-name*					length checking code.** 01/18/92	GAB		- In build_fcr, we're supposed to be passing a pointer*					to the _volume_ name to alloc_fcr.  The code was*					originally passing a pointer to the _file_ name.*					This has been corrected.*					- Optimizations throughout.** 02/10/92  GAB		¥ Added logic to zero out the error_priority*					variable prior to exiting scan_devs with a vol_not_found*					error.  When a caller tried to open a file on a*					non-Pascal disk with some other Pascal disk online,*					id_disks was setting the error_priority variable when*					it successfully id'ed the disk.  Scan_devs then*					compared the volume names and discovered that*					it didn't have a match after all.  After going*					through all the devices, it would exit with a*					volume_not_found error.  But, since nothing had*					cleared the error_priority that id_disk had set,*					the priority bit was set in the error code*					returned to SCM, which caused SCM to exit from*					the call immediately.  If we're gonna exit from*					scan_devs with a vol_not_found error, obviously*					the error_priority should be clear.*					¥ Removed logic from xfer_parms that checks the*					pCount range and moved it to app_entry so that*					the pCount is validated BEFORE the FST tries to*					locate the volume to act upon.*					¥ Changed numerous JML MAIN_EXIT to BRL MAIN_EXIT,*					since all of the FST is within a single segment.** 22-Apr-93 DAL		¥ Added 2 lines to stop ignoring RAM disks.*					¥ Changed version to $0101; removed some bytes*					from the imbedded ASCII credits (cosmetic only).*******************************************************************			PRINT  OFF			INCLUDE 'hw.equ.src'			INCLUDE	'common.equ.src'			INCLUDE 'gsos.macros.src'			INCLUDE 'm16.debug'			PRINT  ON EJECT******************************************************************** Pascal FST equates*******************************************************************dle_char		equ		$10mode_ascii		equ		$0000mode_native		equ		$0001read_data		equ		$00examine_file	equ		$01setup_fcr		equ		$02c0_sep			equ		$2F			; '/'c1_sep			equ		$3A			; ':'vcr_date_stamp	equ		vcr_fst_ptr+4				; date stampvcr_num_files	equ		vcr_date_stamp+2			; # of files on volumevcr_directory	equ		vcr_num_files+2				; directory of the volumevcr_directory2	equ		vcr_directory+1024vcr_eof_cache	equ		vcr_directory2+1024			; 4bytes * 77 filesvcr_end			equ		vcr_eof_cache+308fcr_start_block	equ		fcr_access+2				; starting block of filefcr_end_block	equ		fcr_start_block+2			; ending block of file + 1fcr_ending_bytes equ	fcr_end_block+4				; # of bytes in last block of filefcr_eof			equ		fcr_ending_bytes+2			; eof of filefcr_mark		equ		fcr_eof+4					; file markfcr_file_type	equ		fcr_mark+4					; file typefcr_mode		equ		fcr_file_type+2				; file mode (ASCII or Native)fcr_pmark		equ		fcr_mode+2					; physical file markfcr_expand_cnt	equ		fcr_pmark+4					; # of spaces to send outfcr_io_index	equ		fcr_expand_cnt+2			; index into io bufferfcr_io_size		equ		fcr_io_index+2				; data size of io bufferfcr_io_buffer	equ		fcr_io_size+2				; 1024 byte i/o bufferfcr_end			equ		fcr_io_buffer+1024fcr_num_files	equ		fcr_ending_bytes			; # of files in fcr (volume directory only)io_name_len		equ		$06							; offset into io_buffer to													; volume name length byteio_date_stamp	equ		$14							; creation date of volumeio_file_count	equ		$10							; number of files on volumepascal_id		equ		$0004						; fst idbuffer_size		equ		1024						; size of 1k gbuffersend_output		equ		1get_input		equ		0** fst direct page workspace*io_buffer		equ		fst_start					; gbuffer pointermy_vcr			equ		fst_start+4					; vcr pointermy_fcr			equ		my_vcr+4					; fcr pointeroutput_ptr		equ		my_fcr+4					; pointer to user's bufferblockPtr		equ		output_ptr+4				; pointer to user's pblockpathPtr			equ		blockPtr+4					; pointer to user's pathnamestring1			equ		pathPtr+4					string2			equ		string1+4g_data_buffer	equ		string2+4g_pathptr		equ		g_data_buffer+4io_buffer_2		equ		g_pathptr+4newline_table	equ		io_buffer_2+4newline_char	equ		newline_table+4newline_mask	equ		newline_char+2op_list_ptr		equ		newline_mask+2 EJECT******************************************************************** parameter table equates.  Each parameter is assigned an ID.** NOTE: It is *VERY IMPORTANT* that the order of the parameters*		here coincides with their respective handlers in *		'parm_table'.  The equates here are shifted and used as*		indexes (indexi?).*******************************************************************start			equ		$00access			equ		start+1aux_type		equ		access+1base			equ		aux_type+1blocks_used		equ		base+1block_size		equ		blocks_used+1cache_priority	equ		block_size+1create_date		equ		cache_priority+1create_dateTime	equ		create_date+1create_time		equ		create_dateTime+1data_buffer		equ		create_time+1dev_name		equ		data_buffer+1displacement	equ		dev_name+1entry_num		equ		displacement+1eof				equ		entry_num+1file_type		equ		eof+1file_sys_id		equ		file_type+1flags			equ		file_sys_id+1free_blocks		equ		flags+1mod_date		equ		free_blocks+1mod_dateTime	equ		mod_date+1mod_time		equ		mod_dateTime+1name			equ		mod_time+1new_pathname	equ		name+1option_list		equ		new_pathname+1pathname		equ		option_list+1pcount			equ		pathname+1position		equ		pcount+1ref_num			equ		position+1req_file_sys_id	equ		ref_num+1request_access	equ		req_file_sys_id+1request_count	equ		request_access+1resource_blocks	equ		request_count+1resource_eof	equ		resource_blocks+1resource_number	equ		resource_eof+1storage_type	equ		resource_number+1transfer_count	equ		storage_type+1vol_name		equ		transfer_count+1null_field		equ		vol_name+1command_num		equ		null_field+1fst_mode		equ		command_num+1device_num		equ		fst_mode+1 EJECT******************************************************************** Forward References*******************************************************************			ENTRY	main_exit		; add error priority to error and exit			ENTRY	app_entry		; entry for application calls			ENTRY	sys_entry		; entry for system calls						ENTRY	wr_protect		; these calls return a			ENTRY	bad_call		; standard error which is			ENTRY	ignore			; returned.			ENTRY	invalid_op			ENTRY	header			ENTRY	ignore2						ENTRY	id_disk			; application call support			ENTRY	id_block			ENTRY	build_vcr			ENTRY	build_fcr			ENTRY	read_block			ENTRY	get_parm_offset			ENTRY	strcmp			ENTRY	strcpy			ENTRY	div512			ENTRY	dow_convert			ENTRY	read_io_block						ENTRY	find_target			ENTRY	find_volume			ENTRY	find_file			ENTRY	get_file			ENTRY	break_down_path			ENTRY	scan_devs						ENTRY	xfer_parms						ENTRY	p_access		; each one of the parameters in			ENTRY	p_aux_type		; a pblock has it's own handler.			ENTRY	p_base			ENTRY	p_blocks_used			ENTRY	p_block_size			ENTRY	p_cache_priority			ENTRY	p_create_date			ENTRY	p_create_dateTime			ENTRY	p_create_time			ENTRY	p_data_buffer			ENTRY	p_dev_name			ENTRY	p_displacement			ENTRY	p_entry_num			ENTRY	p_eof			ENTRY	p_file_type			ENTRY	p_file_sys_id			ENTRY	p_flags			ENTRY	p_free_blocks			ENTRY	p_mod_date			ENTRY	p_mod_dateTime			ENTRY	p_mod_time			ENTRY	p_name			ENTRY	p_new_pathname			ENTRY	p_option_list			ENTRY	p_pathname			ENTRY	p_pcount			ENTRY	p_position			ENTRY	p_ref_num			ENTRY	p_req_file_sys_id			ENTRY	p_request_access			ENTRY	p_request_count			ENTRY	p_resource_blocks			ENTRY	p_resource_eof			ENTRY	p_resource_number			ENTRY	p_storage_type			ENTRY	p_transfer_count			ENTRY	p_vol_name			ENTRY	p_null_field			ENTRY	p_command_num			ENTRY	p_fst_mode			ENTRY	p_dev_num						ENTRY	startup			; system calls			ENTRY	shutdown			ENTRY	volume			; application calls			ENTRY	get_file_info			ENTRY	open			ENTRY	read			ENTRY	close			ENTRY	set_mark			ENTRY	get_mark			ENTRY	get_eof			ENTRY	get_dir_entry			ENTRY	get_dev_num			ENTRY	fst_specific						ENTRY	dle_setup			 EJECT			******************************************************************** fst header: tells gs/os about the fst at boot time********************************************************************header		PROC			dc.b	'FST '			; load id			dc.l	app_entry		; entry point for appl calls			dc.l	sys_entry		; entry point for system calls			dc.w	pascal_id		; fst_id			dc.w	$9803			; flags: block FST, MSB off, read-only, apple			dc.w	$0101			; version 1.1 final			dc.w	$200			; block size			dc.l	$FFFFFFFF		; maximum blocks per volume			dc.l	$02				; minimum blocks per volume 			dc.l	$FFFFFFFD		; max file size			dc.l	0				; reserved			dc.b	end1-start1		; length of FST namestart1		dc.b	'Pascal'		; FST nameend1			dc.b	end2-start2		; length of commentstart2		dc.b	'Pascal FST            v01.01'	; commentend2			dc.w	0				; reserved field		;;;		EXPORT creditlen,startcredit		creditlen	dc.b	endcredit-startcredit-1startcredit	dc.b	$0D			dc.b	'Pascal File System Translator',$0D			dc.b	'Written by Cary Farrier',$0D			dc.b	'Tested by Linda Pan',$0D			dc.b	$0D			dc.b	'Copyright 1992-93  Apple Computer, Inc.',$0D			dc.b	'All Rights Reserved',$0D,$0D,$00endcredit			ENDP			 EJECT			******************************************************************** globals: 	data storage area*			jump tables********************************************************************globals		RECORDg_access			dc.w	$c3			; internal copies of parametersg_aux_type			dc.w	0g_base				dc.w	0g_blocks_used		dc.w	0g_cache_priority	dc.w	0g_create_date		dc.w	0g_create_dateTime	ds.l	2g_create_time		dc.w	0g_dev_num			dc.w	0g_displacement		dc.l	0g_entry_num			dc.w	0g_eof				dc.l	0g_file_type			dc.w	0g_mod_date			dc.w	0g_mod_dateTime		ds.l	2g_mod_time			dc.w	0g_pcount			dc.w	0g_position			dc.l	0g_ref_num			dc.w	0g_request_count		dc.l	0g_storage_type		dc.w	0g_transfer_count	dc.l	0;g_pathname			ds.b	50			; Removed 18-Dec-91 MSDg_command_num		dc.w	0g_fst_mode			dc.w	0g_curr_block		dc.w	0g_checkSum			dc.w	0g_error				dc.w	0g_status_buf		ds.b	6g_remainder			dc.l	0g_quotient			dc.l	0g_512multiple		dc.l	0the_fst_mode		dc.w	mode_asciig_volumeName		ds.b	9g_fileName			ds.b	17g_tempStr			ds.b	17f_start_block		dc.w	0f_end_block			dc.w	0f_ending_bytes		dc.w	0temp				dc.w	0tempChar			dc.b	0tempLong			dc.l	0newline_len			dc.w	0length				dc.w	0dateStamp			dc.w	0				; date stamp of current volumenumFiles			dc.w	0				; # of files on current volumesize				dc.w	0device				dc.w	0block_num			dc.w	0call_num			dc.w	0call_class			dc.w	0error_priority		dc.w	0				; for bouncing errorsminPCount			dc.w	0maxPCount			dc.w	0tempPCount			dc.w	0class				dc.w	0parm				dc.w	0io_buffer_ptr		dc.l	0** this is the table to the application call entry points*app_table	dc.w	wr_protect		; ($01) Create			dc.w	wr_protect		; ($02) Destroy			dc.w	bad_call		; ($03) OS Shutdown			dc.w	wr_protect		; ($04) Change Path			dc.w	wr_protect		; ($05) Set File Info			dc.w	get_file_info	; ($06) Get File Info			dc.w	invalid_op		; ($07) Judge Name			dc.w	volume			; ($08) Volume			dc.w	bad_call		; ($09) Set Prefix			dc.w	bad_call		; ($0A) Get Prefix			dc.w	wr_protect		; ($0B) Clear Backup Bit			dc.w	bad_call		; ($0C) Set Sys Prefs			dc.w	ignore			; ($0D) Null			dc.w	bad_call		; ($0E) Expand Path			dc.w	bad_call		; ($0F) Get Sys Prefs			dc.w	open			; ($10) Open			dc.w	bad_call		; ($11) NewLine			dc.w	read			; ($12) Read			dc.w	wr_protect		; ($13) Write			dc.w	close			; ($14) Close			dc.w	ignore			; ($15) Flush			dc.w	set_mark		; ($16) Set Mark			dc.w	get_mark		; ($17) Get Mark			dc.w	wr_protect		; ($18) Set EOF			dc.w	get_eof			; ($19) Get EOF			dc.w	bad_call		; ($1A) Set Level			dc.w	bad_call		; ($1B) Get Level			dc.w	get_dir_entry	; ($1C) Get Dir Entry			dc.w	bad_call		; ($1D) Begin Session			dc.w	bad_call		; ($1E) End Session			dc.w	bad_call		; ($1F) Session Status			dc.w	get_dev_num		; ($20) Get Dev Num			dc.w	bad_call		; ($21) Get Last Dev			dc.w	bad_call		; ($22) Read Block			dc.w	bad_call		; ($23) Write Block			dc.w	wr_protect		; ($24) Format			dc.w	wr_protect		; ($25) Erase Disk			dc.w	bad_call		; ($26) Reset Cache			dc.w	bad_call		; ($27) Get Name			dc.w	bad_call		; ($28) Get Boot Vol			dc.w	bad_call		; ($29) Quit			dc.w	bad_call		; ($2A) Get Version			dc.w	bad_call		; ($2B) Get FST Info			dc.w	bad_call		; ($2C) D_INFO			dc.w	bad_call		; ($2D) D_STATUS			dc.w	bad_call		; ($2E) D_CONTROL			dc.w	bad_call		; ($2F) D_READ			dc.w	bad_call		; ($30) D_WRITE			dc.w	bad_call		; ($31) Alloc Interrupt			dc.w	bad_call		; ($32) Dealloc Interrupt			dc.w	fst_specific	; ($33) FST Specific** This is the table to the system call entry points*sys_table	dc.w	startup			; FST Startup			dc.w	shutdown		; FST Shutdown			dc.w	ignore2			; FST Remove VCR			dc.w	ignore2			; FST Deferred Flush** This is the table to the parameter block i/o functions*parm_table	dc.w	p_access			dc.w	p_aux_type			dc.w	p_base			dc.w	p_blocks_used			dc.w	p_block_size			dc.w	p_cache_priority			dc.w	p_create_date			dc.w	p_create_dateTime			dc.w	p_create_time			dc.w	p_data_buffer			dc.w	p_dev_name			dc.w	p_displacement			dc.w	p_entry_num			dc.w	p_eof			dc.w	p_file_type			dc.w	p_file_sys_id			dc.w	p_flags			dc.w	p_free_blocks			dc.w	p_mod_date			dc.w	p_mod_dateTime			dc.w	p_mod_time			dc.w	p_name			dc.w	p_new_pathname			dc.w	p_option_list			dc.w	p_pathname			dc.w	p_pcount			dc.w	p_position			dc.w	p_ref_num			dc.w	p_req_file_sys_id			dc.w	p_request_access			dc.w	p_request_count			dc.w	p_resource_blocks			dc.w	p_resource_eof			dc.w	p_resource_number			dc.w	p_storage_type			dc.w	p_transfer_count			dc.w	p_vol_name			dc.w	p_null_field			dc.w	p_command_num			dc.w	p_fst_mode			dc.w	p_dev_num** This table contains the maximum pcount (+1) for each class 1 call.  SCM * verifies the minimum pCount prior to calling us.*c1_pcount	dc.w	8				; ($01) Create			dc.w	2				; ($02) Destroy			dc.w	0				; ($03) OS Shutdown			dc.w	4				; ($04) Change Path			dc.w	13				; ($05) Set File Info			dc.w	13				; ($06) Get File Info			dc.w	0				; ($07)			dc.w	7				; ($08) Volume			dc.w	0				; ($09) Set Prefix			dc.w	0				; ($0A) Get Prefix			dc.w	2				; ($0B) Clear Backup Bit			dc.w	0				; ($0C) Set Sys Prefs			dc.w	0				; ($0D) Null			dc.w	0				; ($0E) Expand Path			dc.w	0				; ($0F) Get Sys Prefs			dc.w	16				; ($10) Open			dc.w	0				; ($11) NewLine			dc.w	6				; ($12) Read			dc.w	6				; ($13) Write			dc.w	2				; ($14) Close			dc.w	2				; ($15) Flush			dc.w	4				; ($16) Set Mark			dc.w	3				; ($17) Get Mark			dc.w	4				; ($18) Set EOF			dc.w	3				; ($19) Get EOF			dc.w	0				; ($1A) Set Level			dc.w	0				; ($1B) Get Level			dc.w	18				; ($1C) Get Dir Entry			dc.w	0				; ($1D)			dc.w	0				; ($1E)			dc.w	0				; ($1F)			dc.w	3				; ($20) Get Dev Num			dc.w	0				; ($21) Get Last Dev			dc.w	0				; ($22) Read Block			dc.w	0				; ($23) Write Block			dc.w	5				; ($24) Format			dc.w	5				; ($25) Erase Disk			dc.w	0				; ($26)			dc.w	0				; ($27) Get Name			dc.w	0				; ($28) Get Boot Vol			dc.w	0				; ($29) Quit			dc.w	0				; ($2A) Get Version			dc.w	0				; ($2B) Get FST Info			dc.w	0				; ($2C) D_INFO			dc.w	0				; ($2D) D_STATUS			dc.w	0				; ($2E) D_CONTROL			dc.w	0				; ($2F) D_READ			dc.w	0				; ($30) D_WRITE			dc.w	0				; ($31) Alloc Interrupt			dc.w	0				; ($32) Dealloc Interrupt			dc.w	4				; ($33) FST Specific** These are the definitions of the call parameter blocks, for* classes 0 and 1.*create_0	dc.w	pathname,$00			dc.w	access,$04			dc.w	file_type,$06			dc.w	aux_type,$08			dc.w	storage_type,$0C			dc.w	create_date,$0E			dc.w	create_time,$10			dc.w	0,0			create_1	dc.w	pcount,$00			dc.w	pathname,$02			dc.w	access,$06			dc.w	file_type,$08			dc.w	aux_type,$0A			dc.w	storage_type,$0E			dc.w	eof,$10			dc.w	resource_eof,$14			dc.w	0,0			destroy_0	dc.w	pathname,$00			dc.w	0,0destroy_1	dc.w	pcount,$00			dc.w	pathname,$02			dc.w	0,0change_path_0			dc.w	pathname,$00			dc.w	new_pathname,$04			dc.w	0,0change_path_1			dc.w	pcount,$00			dc.w	pathname,$02			dc.w	new_pathname,$06			dc.w	0,0			set_file_info_0			dc.w	pathname,$00			dc.w	access,$04			dc.w	file_type,$06			dc.w	aux_type,$08			dc.w	null_field,$0C			dc.w	create_date,$0E			dc.w	create_time,$10			dc.w	mod_date,$12			dc.w	mod_time,$14			dc.w	0,0			set_file_info_1			dc.w	pcount,$00			dc.w	pathname,$02			dc.w	access,$06			dc.w	file_type,$08			dc.w	aux_type,$0A			dc.w	null_field,$0E			dc.w	create_dateTime,$10			dc.w	mod_dateTime,$18			dc.w	option_list,$20			dc.w	0,0get_file_info_0			dc.w	pathname,$00			dc.w	access,$04			dc.w	file_type,$06			dc.w	aux_type,$08			dc.w	storage_type,$0C			dc.w	create_date,$0E			dc.w	create_time,$10			dc.w	mod_date,$12			dc.w	mod_time,$14			dc.w	blocks_used,$16			dc.w	0,0			get_file_info_1			dc.w	pcount,$00			dc.w	pathname,$02			dc.w	access,$06			dc.w	file_type,$08			dc.w	aux_type,$0A			dc.w	storage_type,$0E			dc.w	create_dateTime,$10			dc.w	mod_dateTime,$18			dc.w	option_list,$20			dc.w	eof,$24			dc.w	blocks_used,$28			dc.w	resource_eof,$2C			dc.w	resource_blocks,$30			dc.w	0,0			volume_0	dc.w	dev_name,$00			dc.w	vol_name,$04			dc.w	blocks_used,$08			dc.w	free_blocks,$0C			dc.w	file_sys_id,$10			dc.w	0,0volume_1	dc.w	pcount,$00			dc.w	dev_name,$02			dc.w	vol_name,$06			dc.w	blocks_used,$0A			dc.w	free_blocks,$0E			dc.w	file_sys_id,$12			dc.w	block_size,$14			dc.w	0,0clear_backup_0			dc.w	pathname,$00			dc.w	0,0clear_backup_1			dc.w	pcount,$00			dc.w	pathname,$02			dc.w	0,0open_0		dc.w	ref_num,$00			dc.w	pathname,$02			dc.w	0,0			open_1		dc.w	pcount,$00			dc.w	ref_num,$02			dc.w	pathname,$04			dc.w	request_access,$08			dc.w	resource_number,$0A			dc.w	access,$0C			dc.w	file_type,$0E			dc.w	aux_type,$10			dc.w	storage_type,$14			dc.w	create_dateTime,$16			dc.w	mod_dateTime,$1E			dc.w	option_list,$26			dc.w	eof,$2A			dc.w	blocks_used,$2E			dc.w	resource_eof,$32			dc.w	resource_blocks,$36			dc.w	0,0			read_0		dc.w	ref_num,$00			dc.w	data_buffer,$02			dc.w	request_count,$06			dc.w	transfer_count,$0A			dc.w	0,0read_1		dc.w	pcount,$00			dc.w	ref_num,$02			dc.w	data_buffer,$04			dc.w	request_count,$08			dc.w	transfer_count,$0C			dc.w	cache_priority,$10			dc.w	0,0write_0		dc.w	ref_num,$00			dc.w	data_buffer,$02			dc.w	request_count,$06			dc.w	transfer_count,$0A			dc.w	0,0write_1		dc.w	pcount,$00			dc.w	ref_num,$02			dc.w	data_buffer,$04			dc.w	request_count,$08			dc.w	transfer_count,$0C			dc.w	cache_priority,$10			dc.w	0,0close_0		dc.w	ref_num,$00			dc.w	0,0close_1		dc.w	pcount,$00			dc.w	ref_num,$00			dc.w	0,0set_mark_0	dc.w	ref_num,$00			dc.w	position,$02			dc.w	0,0			set_mark_1	dc.w	pcount,$00			dc.w	ref_num,$02			dc.w	base,$04			dc.w	displacement,$06			dc.w	0,0get_mark_0	dc.w	ref_num,$00			dc.w	position,$02			dc.w	0,0			get_mark_1	dc.w	pcount,$00			dc.w	ref_num,$02			dc.w	position,$04			dc.w	0,0set_eof_0	dc.w	ref_num,$00			dc.w	eof,$02			dc.w	0,0set_eof_1	dc.w	pcount,$00			dc.w	ref_num,$02			dc.w	base,$04			dc.w	displacement,$06			dc.w	0,0get_eof_0	dc.w	ref_num,$00			dc.w	eof,$02			dc.w	0,0			get_eof_1	dc.w	pcount,$00			dc.w	ref_num,$02			dc.w	eof,$04			dc.w	0,0get_dir_entry_0			dc.w	ref_num,$00			dc.w	flags,$02			dc.w	base,$04			dc.w	displacement,$06			dc.w	name,$08			dc.w	entry_num,$0C			dc.w	file_type,$0E			dc.w	eof,$10			dc.w	blocks_used,$14			dc.w	create_dateTime,$18			dc.w	mod_dateTime,$20			dc.w	access,$28			dc.w	aux_type,$2A			dc.w	file_sys_id,$2E			dc.w	0,0get_dir_entry_1			dc.w	pcount,$00			dc.w	ref_num,$02			dc.w	flags,$04			dc.w	base,$06			dc.w	displacement,$08			dc.w	name,$0A			dc.w	entry_num,$0E			dc.w	file_type,$10			dc.w	eof,$12			dc.w	blocks_used,$16			dc.w	create_dateTime,$1A			dc.w	mod_dateTime,$22			dc.w	access,$2A			dc.w	aux_type,$2C			dc.w	file_sys_id,$30			dc.w	option_list,$32			dc.w	resource_eof,$36			dc.w	resource_blocks,$3A			dc.w	0,0get_dev_num_0			dc.w	pathname,$00			dc.w	device_num,$04			dc.w	0,0get_dev_num_1			dc.w	pcount,$00			dc.w	pathname,$04			dc.w	device_num,$06			dc.w	0,0			format_0	dc.w	dev_name,$00			dc.w	vol_name,$04			dc.w	file_sys_id,$08			dc.w	0,0format_1	dc.w	pcount,$00			dc.w	dev_name,$02			dc.w	vol_name,$06			dc.w	file_sys_id,$0A			dc.w	req_file_sys_id,$0C			dc.w	0,0	erase_0		dc.w	dev_name,$00			dc.w	vol_name,$04			dc.w	file_sys_id,$08			dc.w	0,0erase_1		dc.w	pcount,$00			dc.w	dev_name,$02			dc.w	vol_name,$06			dc.w	file_sys_id,$0A			dc.w	req_file_sys_id,$0C			dc.w	0,0			fst_specific_0			dc.w	0,0fst_specific_1			dc.w	pcount,$00			dc.w	file_sys_id,$02			dc.w	command_num,$04			dc.w	fst_mode,$06			dc.w	0,0parmTable	dc.w	create_0			; create			dc.w	create_1			dc.w	destroy_0			; destroy			dc.w	destroy_1			dc.w	0					; os shutdown			dc.w	0			dc.w	change_path_0		; change path			dc.w	change_path_1			dc.w	set_file_info_0		; set file info			dc.w	set_file_info_1			dc.w	get_file_info_0		; get file info			dc.w	get_file_info_1			dc.w	0					; reserved			dc.w	0			dc.w	volume_0			; volume			dc.w	volume_1			dc.w	0					; set prefix			dc.w	0			dc.w	0					; get prefix			dc.w	0			dc.w	clear_backup_0		; clear backup bit			dc.w	clear_backup_1			dc.w	0					; set sys prefs			dc.w	0			dc.w	0					; null			dc.w	0			dc.w	0					; expand path			dc.w	0			dc.w	0					; get sys prefs			dc.w	0			dc.w	open_0				; open			dc.w	open_1			dc.w	0					; newline			dc.w	0			dc.w	read_0				; read			dc.w	read_1			dc.w	write_0				; write			dc.w	write_1			dc.w	close_0				; close			dc.w	close_1			dc.w	0					; flush			dc.w	0			dc.w	set_mark_0			; set mark			dc.w	set_mark_1			dc.w	get_mark_0			; get mark			dc.w	get_mark_1			dc.w	set_eof_0			; set eof			dc.w	set_eof_1			dc.w	get_eof_0			; get eof			dc.w	get_eof_1			dc.w	0					; set level			dc.w	0			dc.w	0					; get level			dc.w	0			dc.w	get_dir_entry_0		; get dir entry			dc.w	get_dir_entry_1			dc.w	0					; begin session			dc.w	0			dc.w	0					; end session			dc.w	0			dc.w	0					; session status			dc.w	0			dc.w	get_dev_num_0		; get dev number			dc.w	get_dev_num_1			dc.w	0					; get last dev			dc.w	0			dc.w	0					; read block			dc.w	0			dc.w	0					; write block			dc.w	0			dc.w	format_0			; format			dc.w	format_1			dc.w	erase_0				; erase			dc.w	erase_1			dc.w	0					; reset cache			dc.w	0			dc.w	0					; get name			dc.w	0			dc.w	0					; get boot vol			dc.w	0			dc.w	0 					; quit			dc.w	0			dc.w	0					; get version			dc.w	0			dc.w	0					; get fst info			dc.w	0			dc.w	0					; dinfo			dc.w	0			dc.w	0					; dstatus			dc.w	0			dc.w	0					; dcontrol			dc.w	0			dc.w	0					; dread			dc.w	0			dc.w	0					; dwrite			dc.w	0			dc.w	0					; alloc int/bind int			dc.w	0			dc.w	0					; dealloc int/unbind int			dc.w	0			dc.w	fst_specific_0		; fst specific			dc.w	fst_specific_1						ENDR EJECT******************************************************************** 			Name:	main_exit**	 Description:	Or error_priority with current error code*					and then exit thru sys_exit.*					Called by everything.**		   Entry:	jml**		   Input:	A = error code*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code | error_priority*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1 = error*							   0 = no error**			Exit:	jml sys_exit**			Uses:	error_priority.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************main_exit	PROCNAME			WITH  globals						bcc  done		; no error, nothing to do.			ora  error_prioritydone		jml  sys_exit			ENDP						 EJECT******************************************************************** 			Name:	app_entry**	 Description:	Entry point for application calls. Validates*					call before passing control to handler.*					Called by GS/OS only.**		   Entry:	jml**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1 = error*							   0 = no error**			Exit:	jmp (app_table,x) OR jmp bad_call**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************app_entry	PROCNAME			WITH  globals			phk						; setup the data bank register			plb						cpx  #$67				; is the call in range?			bcs  @no_way				; nope, so exit						cpy  #$03				; is the class in range?			bcs  @no_way						stx  call_num			; save the call & class			sty  call_class			stz  error_priority		; for bouncing errors						lda  |io_buffer_ptr			sta  <io_buffer			lda  |io_buffer_ptr+2			sta  <io_buffer+2*** Check for bad pCount BEFORE we dispatch the call (GAB)			tya						; class 0 call?			beq  @do_dispatch		; yup, no pCount to validate			lda  [param_blk_ptr]	; get the pCount			cmp  c1_pcount-2,x		; make sure it's not > maximum			bcc  @do_dispatch		; so far, so good			lda  #invalid_pcount	; else we're outta here!			sec			brl  main_exit@do_dispatch***			jmp  (app_table-2,x)	; do the call@no_way		jmp  bad_call					ENDP EJECT******************************************************************** 			Name:	sys_entry**	 Description:	Entry point for system calls. Validates*					call before passing control to handler.*					Called by GS/OS only.**		   Entry:	jsl**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1 = error*							   0 = no error**			Exit:	jmp (sys_table,x) OR jmp ignore**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************sys_entry	PROCNAME			WITH  globals			phk						; set up the data bank			plb									cpx #$07				; is it within range?			bcs @no_way				; nope, see ya						jmp (sys_table-2,x)		; yep, do it@no_way		jmp ignore						ENDP			 EJECT******************************************************************** 			Name:	id_disk**	 Description:	Determines if a volume in a given device is*					an Apple II Pascal volume.**		   Entry:	jsr**		   Input:	A = device to id*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1 = error*							   0 = no error**			Exit:	rts**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************id_disk		PROCNAME			WITH  globals			sta  device			** do a SET_DIB_PTR call for the device that I am about to talk to.  This* will set the dib ptr up on direct page so that I can check the* characteristics of the device before accessing it.*			sta  <drvr_buf_ptr			; the dev_id_ref field for SET_DIB_PTR			stz  <drvr_dev_num			; device $00 = special internal calls			lda  #$0001					; call $01 = SET_DIB_PTR			sta  <drvr_call_num			jsl  dev_dispatcher			; make the call			bcs  exit					; error ->						ldy  #$08					; get the device characteristics			lda  [<drvr_dib_ptr],y			and  #$0080					; is it a block device?			beq  @bad_device			; nope ->						ldy  #$34					; get the device id			lda  [<drvr_dib_ptr],y			cmp  #$0006					; is it a disk][, profile 5MB or 10MB, or a disk3.5, generic										;  scsi, or scsi HD?			bcc  @ok					; yes ->			cmp  #$0013					; is it a generic hard disk?			beq  @ok					; yes ->			cmp  #$0014					; is it a generic floppy disk?			beq  @ok					; yes ->*** added 25-Oct-91 DAL -- FDHD on Mustang is device_id $0017 (even an 800K floppy)			cmp  #$0017					; Is it a FDHD on Mustang?			beq  @ok*** end 25-Oct-91*** added 22-Apr-93 DAL -- RAM disks are okay			cmp  #$000E			beq  @ok*** end 22-Apr-93@bad_device	lda  #unknown_vol			; the device was not the type of device			sec							; that I talk to, so exit with an			bra  exit					; unknown_vol error** the device is ok, so now attempt to id the volume*@ok			lda  device			sta  dev_num			lda  #2			sta  block_num							jsr  read_block			bcs  exit				jsr  id_block			bcs  exit			lda  #vcr_size			jsr  build_vcr			bcs	 exit			done			lda  #$8000			sta  error_priority			;any error now has priority			lda  #no_error			clcexit		rts			ENDP EJECT******************************************************************** 			Name:	id_block**	 Description:	examines the contents of io_buffer to determine*					if it is the directory block of a Pascal volume.**		   Entry:	jsr**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1 = error*							   0 = no error**			Exit:	rts**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************id_block	PROCNAME			WITH  globals			** analyze the contents to determine if this block is a directory block...**			ldy  #$00					; does the directory start at $00?*			lda  [io_buffer],y*			bne  notPascal*			*			iny*			iny*			lda  [io_buffer],y*			cmp  #$07					; does directory end before block 7?*			bcs  notPascal						ldy  #$06			lda  [io_buffer],y			and  #$FF			cmp  #$08					; is the title of the volume <= 7 chars?			bcs  notPascal			cmp  #$01					; is the title at least 1 char?			bcc  notPascal			clc							; add 7 to length so that I can			adc  #$07					; use g_volumeName as a max value for			sta  temp					; the y index registerloop		iny							; check to see that the name consists			tya							; of legal chars only			cmp  temp			bcs  chkFileCnt			lda  [io_buffer],y			and  #$FFcheckDigit	cmp  #$30					; is the char an ascii digit?			bcc  notPascal			cmp  #$3A			bcc  loopcheckUpper	cmp  #$41					; is the char upper case ascii?			bcc  notPascal			cmp  #$5b			bcc  loopcheckLower	cmp  #$61					; is the char lower case ascii?			bcc  notPascal			cmp  #$7b			bcs  notPascal			bra  loop			chkFileCnt	ldy  #io_file_count			lda  [io_buffer],y			cmp  #78					; are there <= 77 files in the directory?			bcc  isPascalnotPascal	lda  #unknown_vol			secexit		rts** ok, the volume is a Pascal volume.  Now pull all the information out of* the io_buffer and put it into my global variables*isPascal	sta  numFiles				; save file count						ldy  #io_date_stamp			; save date stamp			lda  [io_buffer],y			sta  dateStamp			ldy  #$0E					; retrieve total blocks from			lda  [io_buffer],y			; volume header			sta  g_blocks_used			sta  g_aux_type						lda  #$c3			sta  g_access						lda  #$0F			sta  g_file_type									sta  g_storage_type						stz  g_eof			stz  g_entry_num			** must do date & time also*			lda  #no_error				; go back to see if there is a volume			clc							; after this one			bra  exit						ENDP			 EJECT******************************************************************** 			Name:	build_vcr**	 Description:	Attempts to build a vcr from the data in*					[io_buffer].  It first checks to see if the *					vcr exists.  If it exists then a) if no files*					are open, then the old vcr is removed and a*					new one is inserted pertaining to the new*					volume, or b) if files are open then*					the dup_volume error is returned.  If the vcr*					does not exist then it will create the new*					vcr.**			NOTE:	Must only be called by id_disk!**		   Entry:	jsr**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1 = error*							   0 = no error**			Exit:	rts**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************build_vcr	PROCNAME			WITH  globals						ldy  #io_name_len			; copy volume name			lda  [io_buffer],y			and  #$FF			sta  g_volumeName			inc  a			inc  a			sta  size			ldx  #$02			iny			LONGA  OFF			sep  #$20loop		lda  [io_buffer],y			sta  g_volumeName,x			iny			inx			cpx  size			bcc  loop			rep  #$20			LONGA  ON						lda  #$0000					; search vcr list by name			ldx  #g_volumeName			ldy  #^g_volumeName			jsl  find_vcr				; does the vcr exist?			bcs  addVcr					; no, so add mine						jsl  deref					; yes, so investigate			stx  my_vcr			sty  my_vcr+2						ldy  #vcr_fst_id						lda  [my_vcr],y			cmp  #pascal_id				; is it mine?			ldy  #vcr_date_stamp		; Yes - is it the same disk?			lda  [my_vcr],y				; first check date stamp			cmp  dateStamp			bne  dumpVCR			ldy  #vcr_num_files			; then check the # of files			lda  [my_vcr],y			cmp  numFiles			bne  dumpVCR						ldy  #vcr_status			; check vcr_status			lda  [my_vcr],y			and  #vcr_swapped			beq  not_swapped						and  #vcr_swapped_in			sta  [my_vcr],y						lda  device					; update the device field			ldy  #vcr_dev			sta  [my_vcr],y						not_swapped	brl  done  dumpVCR		ldy  #vcr_open_cnt			; any open files?						lda  [my_vcr],y			beq  removeIt						lda  #dup_volume						sec			brl  exitremoveIt	ldy  #vcr_id			lda  [my_vcr],y				; get vcr_id			jsl  release_vcr  				addVcr		lda  #vcr_end			ldx  #g_volumeName			; allocate a VCR			ldy  #^g_volumeName			jsl  alloc_vcr			lda  #out_of_mem			bcs  exit						jsl  deref					; got the vcr, so deref it			stx  my_vcr			sty  my_vcr+2												lda  #0						; set status			ldy  #vcr_status			sta  [my_vcr],y						lda  #pascal_id				; fst id			ldy  #vcr_fst_id			sta  [my_vcr],y						lda  device					; device			ldy  #vcr_dev			sta  [my_vcr],y						lda  #0						; set open count to zero			ldy  #vcr_open_cnt			sta  [my_vcr],y						lda  dateStamp				; date stamp			ldy  #vcr_date_stamp			sta  [my_vcr],y						lda  numFiles				; file count			ldy  #vcr_num_files			sta  [my_vcr],y** copy the directory of the volume into the vcr*			lda  #2			sta  block_num			jsr  read_block			bcs  exit			ldy  #0			ldx  #vcr_directory@loop		lda  [io_buffer],y			phy			txy			sta  [my_vcr],y			ply			inx			inx			iny			iny			cpy  #buffer_size			bcc  @loop			lda  #4			sta  block_num			jsr  read_block			bcs  exit			ldy  #0			ldx  #vcr_directory2@loop2		lda  [io_buffer],y			phy			txy			sta  [my_vcr],y			ply			inx			inx			iny			iny			cpy  #buffer_size			bcc  @loop2			done		lda  #no_error			clc			exit		rts						ENDP EJECT******************************************************************** 			Name:	build_fcr**	 Description:	Builds and initializes and fcr.**		   Entry:	jsr**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1 = error*							   0 = no error**			Exit:	rts**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************build_fcr	PROCNAME			WITH  globals			ldy		#8					; copy g_volumeName into g_tempStr@copy			lda		g_volumeName,y			sta		g_tempStr+1,y		; leave space for leading separator			dey			dey			bpl		@copy			lda		g_volumeName		; get length			inc		a					; allow for leading pathname separator			sta		g_tempStr			lda		g_tempStr+2			; get the first character of the volume name			and		#$FF00				; strip off garbage character			ora		#c1_sep				; include separator			sta		g_tempStr+2			lda  #fcr_end				; A = size of fcr			;ldx  #g_fileName			;ldy  #^g_fileName			ldx  #g_tempStr				; we're supposed to be passing the _volume_ name!			ldy  #^g_tempStr			jsl  alloc_fcr			bcc  got_it						lda  #out_of_mem			brl  exit			got_it		jsl  deref			stx  my_fcr			sty  my_fcr+2						ldy  #vcr_open_cnt			; increment the open count			lda  [my_vcr],y				; on the vcr			inc  a			sta  [my_vcr],y						ldy  #fcr_ref_num			; get the ref_num for the file			lda  [my_fcr],y			sta  g_ref_num						ldy  #fcr_access			; init access			lda  #$0001			sta  [<my_fcr],y													ldy  #fcr_fst_id			; init fst id			lda  #pascal_id			sta  [my_fcr],y						ldy  #vcr_id				; init vcr id			lda  [my_vcr],y			ldy  #fcr_vol_id			sta  [my_fcr],y								lda  the_fst_mode			; save the mode the file was opened in			ldy  #fcr_mode			sta  [my_fcr],y			@start		ldy  #fcr_start_block		; init start_block			lda  f_start_block			sta  [my_fcr],y						ldy  #fcr_pmark				; init physical mark			lda  #0			sta  [my_fcr],y			iny			iny			sta  [my_fcr],y						ldy  #fcr_mark				; init logical mark			sta  [my_fcr],y			ldy  #fcr_expand_cnt		; init expansion_count			sta  [my_fcr],y						ldy  #fcr_end_block			; init end_block			lda  f_end_block			sta  [my_fcr],y						ldy  #fcr_ending_bytes		; init ending_bytes			lda  f_ending_bytes			sta  [my_fcr],y			ldy  #fcr_file_type			; init file_type			lda  g_file_type			sta  [my_fcr],y			ldy  #fcr_eof			lda  g_eof			sta  [<my_fcr],y			iny			iny			lda  g_eof+2			sta  [<my_fcr],y						done		clcexit		rts						ENDP						; end of build_fcr EJECT******************************************************************** 			Name:	wr_protect**	 Description:	ID's the volume to see if it is mine, *					and if so then loads accumulator with $2B, *					sets carry flag and exits through main_exit.**		   Entry:	jml**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code (may vary if not my disk)*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1**			Exit:	brl main_exit**			Uses:	nothing.**	8/22/91		JEV		Changed code to find target first so that *						error_priority gets set up first before we *						do any checking on the other input parms.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************wr_protect	PROCNAME			WITH  globals			jsr  find_target			; check to see if it's a pascal										; volume.			bcs	 exit					; Nope ->** get the input from the users pblock*			lda  #get_input			jsr  xfer_parms			bcs  exit** special case the erase, format, write and set_eof calls*			lda  call_num				; get the call number			and  #$00FF					; mask off the class			lsr  a						; divide it by two			cmp  #$13					; write			beq  done			cmp  #$18					; set_eof			beq  done			cmp  #$24					; format			beq  done			cmp  #$25					; erase_disk			beq  done** find target of the call.  If an error occurs, then exit.  Otherwise* return a write protected error*	generic		jsr  find_target			bcc  done			cmp  #file_not_found		; this is for the CREATE call			bne  exitdone		lda  #drvr_wr_protexit		sec			brl main_exit			ENDP			 EJECT******************************************************************** 			Name:	bad_call**	 Description:	Loads accumulator with $01, sets carry flag*					and exits through main_exit.**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = $0001*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1**			Exit:	brl main_exit**			Uses:	nothing.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************bad_call	PROCNAME			WITH  globals			lda #$0001			sec			brl main_exit			ENDP			 EJECT******************************************************************** 			Name:	invalid_op**	 Description:	Loads accumulator with invalid_fst_op, sets carry flag*					and exits through main_exit.**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = #invalid_fst_op*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..1**			Exit:	brl main_exit**			Uses:	nothing.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************invalid_op	PROCNAME			WITH  globals			lda #invalid_fst_op			sec			brl main_exit			ENDP			 EJECT******************************************************************** 			Name:	ignore,ignore2**	 Description:	Loads accumulator with $00, clears carry, and*					exits via either an rtl or a jml  main_exit.**		   Entry:	jmp**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = $0000*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0**			Exit:	rtl,jml**			Uses:	nothing.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************ignore		PROCNAME			WITH  globals			lda  #no_error			clc			brl  main_exit			ENDPignore2		PROCNAME			WITH  globals			lda #no_error			clc			rtl			ENDP			 EJECT******************************************************************** 			Name:	startup**	 Description:	startup code for fst**		   Entry:	jmp**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rtl**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************startup		PROCNAME			WITH  globals			jsl  get_sys_gbuf			; locate system i/o buffer						stx  io_buffer_ptr			sty  io_buffer_ptr+2							done		clcexit		rtl			ENDP			 EJECT******************************************************************** 			Name:	shutdown**	 Description:	shutdown code for fst**		   Entry:	jmp**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rtl**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************shutdown	PROCNAME			WITH  globals						rtl			ENDP EJECT******************************************************************** Application Calls Begin Here******************************************************************* EJECT******************************************************************** 			Name:	get_file_info**	 Description:	performs call $06, get_file_info**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.**	8/22/91		JEV		Changed code to id_disk first so that *						error_priority gets set up first before we *						do any checking on the other input parms.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************get_file_info	PROCNAME			WITH  globals			jsr  find_target				; find the requested file			bcs  exit			lda  #get_input			jsr  xfer_parms			bcs  exit		** determine if I am doing a gfi on a volume directory*			lda  g_storage_type			cmp  #$0f						; volume directory?			bne  output						; no ->			lda  call_class					; class 1 or 0?			lsr  a							; /2			bne	 is_1						; 1 ->			** we are doing a gfi on a volume directory, so return the number of used* blocks in the blocks_used field, and return the number of total_blocks* in the aux_type field.*			lda  #6							; initialize # of used blocks			sta  used_blks					; 2 boot blocks + 4 dir blocks = 6					ldy  #vcr_num_files				; get the number of files on the volume			lda  [<my_vcr],y			beq  calc_free					; no files ->			tax						clc								; calculate offset to beginning of			lda  #vcr_directory				; directory in vcr			adc  #26						; skip volume entry			tay			@loop		lda  [<my_vcr],y				; get starting block of file			sta  temp			iny			iny			lda  [<my_vcr],y				; get ending block of file			sec								; calculate blocks used by file			sbc  temp			clc			adc  used_blks					; add it to the # of used blocks on volume			sta  used_blks						tya								; move index to next file			clc			adc  #24			tay						dex								; is there another file?			bne  @loop						; yes ->			calc_free	sec								; calculate the number of free blocks on the volume			lda  g_blocks_used			sbc  used_blks			sta  free_blks					; save the result			lda  g_blocks_used				; total blocks			sta  g_aux_type						lda  used_blks					; blocks used			sta  g_blocks_used						bra  output** in class one, the aux_type and blocks_used field are zero*is_1		stz  g_aux_type			stz  g_blocks_used	** send the output*output		lda  #send_output			; output the results			jsr  xfer_parms			bcs  exit			done		lda  #no_error			clcexit		brl  main_exitfree_blks	dc.w	0used_blks	dc.w	0			ENDP						 EJECT******************************************************************** 			Name:	volume**	 Description:	performs call $08, volume**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************volume		PROCNAME			WITH  globals			lda  dev_num			jsr  id_disk			; is the disk in the device			bcc  @1					; a pascal disk?			cmp  #dup_volume		; duplicate volume?			beq  @2					; yes, output the volume name anyways ->			sec						; no, pass it on up ->			bra  exit			@2			lda  path_flag			; device name only?			and  #$4000			bne  @3					; no ->						lda  #send_output					jsr  p_vol_name			bcs  exit				; return any error ->			@3			lda  #dup_volume		; pass up the dup_volume error anyways ->			sec			bra  exit						@1			lda  #send_output		; put output in user's pblock			jsr  xfer_parms			bcs  exit									done		lda  #no_error			clcexit		brl  main_exit						ENDP EJECT******************************************************************** 			Name:	open**	 Description:	performs call $10, open**		   Entry:	jsr**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.***	8/22/91		JEV		Changed code to find_target first so that *						error_priority gets set up first before we *						do any checking on the other input parms.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************open		PROCNAME			WITH  globals			jsr  find_target			bcs  exit						lda  #get_input			jsr  xfer_parms			bcs  exit						jsr  build_fcr			bcs  exit						lda  g_file_type				; opening a directory?			cmp  #$000F			bne  @1				stz  g_blocks_used				; field undefined for a volume						bra  output						; yes, don't read in anything ->						@1			jsr  read_io_block				; read the current io block						bcs  exit						; error ->			output		lda  #send_output			jsr  xfer_parms			bcs  exit			done		lda  #no_error					; into the fcr io buffer			clcexit		brl  main_exit			ENDP EJECT******************************************************************** 			Name:	read**	 Description:	performs call $12, read**		   Entry:	jsr**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************read		PROCNAME			WITH  globals			ldx  fcr_ptr			; setup the fcr ptr			ldy  fcr_ptr+2			jsl  deref			stx  my_fcr			sty  my_fcr+2			lda  #get_input			jsr  xfer_parms			bcc  @ok			brl  exit** check to see if the user is trying to read from a directory*@ok			ldy  #fcr_file_type			lda  [my_fcr],y			cmp  #$0F			bne  check_swap			lda  #invalid_access			sec			brl  exit** check to see if the volume is still in the drive, and if it is not,* then find it.  if found, then update the vcr with the device and the* swapped status.*check_swap** the volume is online, so check to see if the request count * of the call is zero.  if it is, then return successfull.*next		lda  |g_request_count			ora  |g_request_count+2			bne  next1						stz  g_transfer_count			stz  g_transfer_count+2						brl  done			** check to see if the file_mark = eof.* if it is, then return an eof error.*next1		ldy  #fcr_mark			; retrieve the file mark			lda  [my_fcr],y			sta  tempLong			iny			iny			lda  [my_fcr],y			sta  tempLong+2					clc			lda  tempLong			adc  #1			sta  tempLong			lda  tempLong+2			adc #0			sta  tempLong+2			ldy  #fcr_eof			; retrieve the eof			lda  [my_fcr],y			sta  g_eof			iny			iny			lda  [my_fcr],y			sta  g_eof+2										lda  g_eof				; compare them			sec			sbc  tempLong			lda  g_eof+2			sbc  tempLong+2			bcs  @n2					lda  #end_of_file		; return an eof error			sec			brl  exit	** check to see if the request_count + the file_mark is > eof.* if it is, then set the transfer_count = eof-file_mark.*@n2			ldy  #fcr_mark			; retrieve the file_mark			lda  [my_fcr],y			sta  tempLong			iny			iny			lda  [my_fcr],y			sta  tempLong+2						lda  g_request_count	; add the file_mark and the request_count			clc			adc  tempLong			sta  tempLong			lda  g_request_count+2			adc  tempLong+2			sta  tempLong+2			ldy  #fcr_eof			; retrieve the eof			lda  [my_fcr],y			sta  g_eof			iny			iny			lda  [my_fcr],y			sta  g_eof+2					sec			lda  g_eof				; compare them			sbc  tempLong			sta  tempLong			lda  g_eof+2			sbc  tempLong+2			sta  tempLong+2			bcs  @n3** NOTE the the setting of transfer_count is only a maximum transfer count* possible.  If newline mode is enabled, then the transfer_count may* be less.*			ldy  #fcr_mark			; set transfer_count = eof - file_mark			lda  [my_fcr],y			sta  tempLong			iny			iny			lda  [my_fcr],y			sta  tempLong+2						sec			lda  g_eof			sbc  tempLong			sta  g_transfer_count			sta  xfer_cnt			lda  g_eof+2			sbc  tempLong+2			sta  g_transfer_count+2			sta  xfer_cnt+2			bra  @n4			@n3			lda  g_request_count	; set transfer_count = req_cnt			sta  g_transfer_count			sta  xfer_cnt			lda  g_request_count+2			sta  g_transfer_count+2			sta  xfer_cnt+2** is newline mode set?*@n4			ldy  #fcr_newline_len			lda  [my_fcr],y			bne  nline_read			brl  xfer_first						** newline mode is set*nline_read	ldy  #fcr_newline			; setup the pointer to the newline table			lda  [<my_fcr],y			tax			iny			iny			lda  [<my_fcr],y			tay			jsl  deref			stx  newline_table			sty  newline_table+2									ldy  #fcr_newline_len		; get the table len			lda  [<my_fcr],y			sta  newline_len						LONGA  OFF			sep  #$20			ldy  #fcr_mask			lda  [<my_fcr],y			sta  newline_mask						LONGA  ON			rep  #$20			** transfer the data to the user's buffer.  if there is only one character in* the newline table, then copy the char to dpage and check only that one char.  * otherwise do it the brute force way.*			lda  newline_len			; one char?			and  #$FF			dec  a			beq  one_xfer				; yes ->			brl  multi_xfer				; no ->			one_xfer	sep  #$20			LONGA  OFF						ldy  #0						; get the newline char			lda  [<newline_table],y			sta  newline_char						rep  #$20			LONGA  ON						stz  g_transfer_count			stz  g_transfer_count+2						ldy  #fcr_io_index			; get the index to begin reading from			lda  [<my_fcr],y			; the io buffer at.			sta  tempIndex				; save the io buffer index for later			tax			clc			adc  #fcr_io_buffer			; adjust to beginning of io buffer			tay									ldx  #0						LONGA  OFF			sep  #$20			@loop		lda  [<my_fcr],y			; source			sta  t_data					; save the char for later			phy			txy			sta  [<g_data_buffer],y		; destination			ply									rep  #$20			LONGA  ON						inx							; x is used to see if the io buffer is empty			iny						phx			phy						tya							; save for empty io buffer check			sec			sbc  #fcr_io_buffer			sta  temp1											clc							; increment the transfer count			lda  g_transfer_count			adc  #1			sta  g_transfer_count			lda  g_transfer_count+2			adc  #0			sta  g_transfer_count+2									clc							; increment the file mark			ldy  #fcr_mark			lda  [<my_fcr],y			adc  #1			sta  [<my_fcr],y			iny			iny			lda  [<my_fcr],y			adc  #0			sta  [<my_fcr],y									clc							; increment the io buffer index			ldy  #fcr_io_index			lda  [<my_fcr],y			adc  #1			sta  [<my_fcr],y						sep  #$20			LONGA  OFF						lda  t_data			and  newline_mask			; and data with the newline mask			cmp  newline_char			; does it match the newline char?			rep  #$20			LONGA  ON						beq  @fodone				; yes, all done ->						ldy  #fcr_io_size			; empty io buffer?			lda  [<my_fcr],y			dec  a			cmp  temp1			bcs  @1						; no ->** adjust the pointer to the user's data buffer*			inc  a									sec							; subtract the io buffer index from			sbc  tempIndex				; the io buffer size			clc			adc  <g_data_buffer			sta  <g_data_buffer			lda  <g_data_buffer+2			adc  #0			sta  <g_data_buffer+2						jsr  read_io_block						ply							; get old index values			plx						bcc  @ok			brl  exit					; error from read_io_block ->			@ok			ldy  #fcr_io_index			; new buffer index			lda  [<my_fcr],y			sta  tempIndex				; save for the adjustment of the pointer										; to the user buffer			clc			adc  #fcr_io_buffer			tay													ldx  #0						; reset x			sec							; decrement the # of bytes to transfer			lda  xfer_cnt			sbc  #1			sta  xfer_cnt			lda  xfer_cnt+2			sbc  #0			sta  xfer_cnt+2						ora  xfer_cnt				; done?			beq  @fodone2				; yes ->						bra  @2						; stack is already balanced ->			@1			sec							; decrement the # of bytes to transfer			lda  xfer_cnt			sbc  #1			sta  xfer_cnt			lda  xfer_cnt+2			sbc  #0			sta  xfer_cnt+2						ora  xfer_cnt				; done?			beq  @fodone				; yes ->			ply			plx			@2			sep  #$20					; short a						brl  @loop					; keep going ->			@fodone		ply							; balance stack			plx			@fodone2	brl  done					; done ->** transfer in newline mode with multiple newline chars*multi_xfer	stz  g_transfer_count			stz  g_transfer_count+2						ldy  #fcr_io_index			; get the index to begin reading from			lda  [<my_fcr],y			; the io buffer at.			sta  tempIndex				; save the io buffer index for later			tax			clc			adc  #fcr_io_buffer			; adjust to beginning of io buffer			tay									ldx  #0						LONGA  OFF			sep  #$20			@loop		lda  [<my_fcr],y			; source			sta  t_data					; save the char for later			phy			txy			sta  [<g_data_buffer],y		; destination			ply									rep  #$20			LONGA  ON						inx							; x is used to see if the io buffer is empty			iny						phx			phy						tya							; save for empty io buffer check			sec			sbc  #fcr_io_buffer			sta  temp1											clc							; increment the transfer count			lda  g_transfer_count			adc  #1			sta  g_transfer_count			lda  g_transfer_count+2			adc  #0			sta  g_transfer_count+2									clc							; increment the file mark			ldy  #fcr_mark			lda  [<my_fcr],y			adc  #1			sta  [<my_fcr],y			iny			iny			lda  [<my_fcr],y			adc  #0			sta  [<my_fcr],y									clc							; increment the io buffer index			ldy  #fcr_io_index			lda  [<my_fcr],y			adc  #1			sta  [<my_fcr],y						sep  #$20			LONGA  OFF						ldy  #0			lda  t_data			and  newline_mask			; and data with the newline mask@checkit	cmp  [<newline_table],y		; is this the char?			beq  @0			iny			cpy  newline_len			bcc  @checkit			lda  #1						; clear the zero flag			@0			rep  #$20			LONGA  ON						beq  @fodone				; yes, all done ->						ldy  #fcr_io_size			; empty io buffer?			lda  [<my_fcr],y			dec  a			cmp  temp1			bcs  @1						; no ->** adjust the pointer to the user's data buffer*			inc  a									sec							; subtract the io buffer index from			sbc  tempIndex				; the io buffer size			clc			adc  <g_data_buffer			sta  <g_data_buffer			lda  <g_data_buffer+2			adc  #0			sta  <g_data_buffer+2						jsr  read_io_block						ply							; get old index values			plx						bcc  @ok			brl  exit					; error from read_io_block ->			@ok			ldy  #fcr_io_index			; new buffer index			lda  [<my_fcr],y			sta  tempIndex				; save for the adjustment of the pointer										; to the user buffer			clc			adc  #fcr_io_buffer			tay													ldx  #0						; reset x			sec							; decrement the # of bytes to transfer			lda  xfer_cnt			sbc  #1			sta  xfer_cnt			lda  xfer_cnt+2			sbc  #0			sta  xfer_cnt+2						ora  xfer_cnt				; done?			beq  @fodone2				; yes ->						bra  @2						; stack is already balanced ->			@1			sec							; decrement the # of bytes to transfer			lda  xfer_cnt			sbc  #1			sta  xfer_cnt			lda  xfer_cnt+2			sbc  #0			sta  xfer_cnt+2						ora  xfer_cnt				; done?			beq  @fodone				; yes ->			ply			plx			@2			sep  #$20					; short a						brl  @loop					; keep going ->			@fodone		ply							; balance stack			plx			@fodone2	brl  done					; done ->** newline mode is not set*xfer_first	ldy  #fcr_io_index			; get the index to begin reading from			lda  [<my_fcr],y			; the io buffer at.			sta  tempIndex				; save the io buffer index for later			clc			adc  #fcr_io_buffer			; adjust to beginning of io buffer			tay									ldx  #0						LONGA  OFF			sep  #$20			@loop		lda  [<my_fcr],y			; source			phy			txy			sta  [<g_data_buffer],y		; destination			ply						rep  #$20			LONGA  ON						inx							; x is used to see if the io buffer is empty			iny						phx			phy						tya							; save for empty io buffer check			sec			sbc  #fcr_io_buffer			sta  temp1											clc							; increment the file mark			ldy  #fcr_mark			lda  [<my_fcr],y			adc  #1			sta  [<my_fcr],y			iny			iny			lda  [<my_fcr],y			adc  #0			sta  [<my_fcr],y									clc							; increment the io buffer index			ldy  #fcr_io_index			lda  [<my_fcr],y			adc  #1			sta  [<my_fcr],y									ldy  #fcr_io_size			; empty io buffer?			lda  [<my_fcr],y			dec  a			cmp  temp1			bcs  @1						; no ->** adjust the pointer to the user's data buffer*			inc  a									sec							; subtract the io buffer index from			sbc  tempIndex				; the io buffer size			clc			adc  <g_data_buffer			sta  <g_data_buffer			lda  <g_data_buffer+2			adc  #0			sta  <g_data_buffer+2						jsr  read_io_block						ply							; get old index values			plx						bcs  exit					; error from read_io_block ->						ldy  #fcr_io_index			; new buffer index			lda  [<my_fcr],y			sta  tempIndex				; save for the adjustment of the pointer										; to the user buffer			clc			adc  #fcr_io_buffer			tay													ldx  #0						; reset x			sec							; decrement the # of bytes to transfer			lda  xfer_cnt			sbc  #1			sta  xfer_cnt			lda  xfer_cnt+2			sbc  #0			sta  xfer_cnt+2						ora  xfer_cnt				; done?			beq  @fodone2				; yes ->						bra  @2						; stack is already balanced ->			@1			sec							; decrement the # of bytes to transfer			lda  xfer_cnt			sbc  #1			sta  xfer_cnt			lda  xfer_cnt+2			sbc  #0			sta  xfer_cnt+2						ora  xfer_cnt				; done?			beq  @fodone				; yes ->			ply			plx			@2			sep  #$20					; short a						brl  @loop					; keep going ->			@fodone		ply							; balance stack			plx			@fodone2	bra  done					; done ->			** ok, that's it.  send the output to the user's pblock and exit*done		lda  #send_output			jsr  xfer_parms			bcs  exit						lda  #no_error			clcexit		brl  main_exitxfer_cnt	dc.l	0temp1		dc.w	0tempIndex	dc.w	0xferred		dc.l	0t_data		dc.b	0			ENDP EJECT******************************************************************** 			Name:	read_io_block**	 Description:	read a new block into the fcr io buffer**		   Entry:	jsr**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rts**			Uses:	** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************read_io_block	PROCNAME			WITH  globals						ldy  #fcr_file_type			; get file type.  if not ascii, then			lda  [<my_fcr],y			; do a native read...			cmp  #4						; ascii file?			beq  @1						; yes ->			brl  native					; no ->** read the block*@1			ldy  #fcr_mark				; get the fcr_mark			lda  [<my_fcr],y			tax			iny			iny			lda  [<my_fcr],y			tay						jsr  div512					; find out which block it is in					ldy  #fcr_start_block		; calculate block # to read			lda  [<my_fcr],y			clc			adc  g_quotient			sta  block_num						jsr  read_block				; read it in			bcc  @ok			brl  exit					; error ->			** if we are at the last block, then only transfer the # of bytes* in the last block, not 512*@ok			lda  #512					; assume 512 byte buffer			sta  temp			tax			ldy  #fcr_end_block			lda  [<my_fcr],y			cmp  block_num			bne  @n1						ldy  #fcr_ending_bytes		; use the # of bytes in last block			lda  [<my_fcr],y			sta  temp			tax			@n1			txy			dey** copy the data*			LONGA  OFF			sep  #$20										; copy the data to the io buffer			ldx  #fcr_io_buffer+511		; dest index@loop		lda  [<io_buffer],y			phy			txy						cmp  #0						; NULL?			bne  @n2			lda  #$20			bra  @store			@n2			cmp  #$10					; DLE?			bne  @store			lda  #$20			sta  [<my_fcr],y			; store it			iny			sta  [<my_fcr],y			; mask out the dle count, too.			dey						@store		sta  [<my_fcr],y			dey							; decrement dest index			tyx			ply			dey							; decrement source index			bpl  @loop					; not done yet ->						LONGA  ON			rep  #$20			lda  g_remainder			; io index			ldy  #fcr_io_index			sta  [<my_fcr],y						ldy  #fcr_io_size			; io buffer size			lda  temp			sta  [<my_fcr],y									brl  done					; finito ->			** do a native read*native		ldy  #fcr_mark				; get the fcr_mark			lda  [<my_fcr],y			tax			iny			iny			lda  [<my_fcr],y			tay						jsr  div512					; find out which block it is in					ldy  #fcr_start_block		; calculate block # to read			lda  [<my_fcr],y			clc			adc  g_quotient			sta  block_num						jsr  read_block				; read it in			bcc  @ok			brl  exit					; error ->			** if we are at the last block, then only transfer the # of bytes* in the last block, not 512*@ok			lda  #512					; assume 512 byte buffer			sta  temp			tax			ldy  #fcr_end_block			lda  [<my_fcr],y			cmp  block_num			bne  @n1						ldy  #fcr_ending_bytes		; use the # of bytes in last block			lda  [<my_fcr],y			sta  temp						and  #1						; is it an odd value?			beq	 @n1					; no ->			inc  a						; yes, so move up to next word size			tax			@n1			txy			dey			dey** copy the data*										; copy the data to the io buffer			ldx  #fcr_io_buffer+510		; dest index@loop		lda  [<io_buffer],y			phy			txy			sta  [<my_fcr],y			dey			dey							; decrement dest index			tyx			ply			dey							; decrement source index			dey			bpl  @loop					; not done yet ->						lda  g_remainder			; io index			ldy  #fcr_io_index			sta  [<my_fcr],y						ldy  #fcr_io_size			; io buffer size			lda  temp			sta  [<my_fcr],y** done*done		clcexit		rtsspace_count		dc.w	0blk_start_mark	dc.w	0blk_end_mark	dc.w	0mark_offset		dc.w	0						ENDP EJECT******************************************************************** 			Name:	dle_setup**	 Description:	manipulates text files opened in ASCII mode.*					the exact type of manipulation depends on *					the flag passed in A.   **					if the flag is set to fcr_examine, this function*					will fill out the fcr as follows:**					/\/\/\/\/\/\/\/\/\/\*					| fcr              |*					+------------------+ fcr_end*					|  start mark      | block #0*					|     (4 bytes)    |*					|                  |*					|                  |*					+------------------+*					|  end mark        |*					|     (4 bytes)    |*					|                  |*					|                  |*					+------------------+*					|  start mark      | block #1*					|     (4 bytes)    |*					|                  |*					|                  |*					+------------------+*					|  end mark        |*					|     (4 bytes)    |*					|                  |*					|                  |*					+------------------+*					|                  | block #n*					\/\/\/\/\/\/\/\/\/\/***		   Entry:	jsr**		   Input:	A = what to do to the file:*							examine_file	= examine the file only*							setup_fcr		= examine file & setup fcr**					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rts**			Uses:	** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************dle_setup	PROCNAME			WITH  globals									cmp  #setup_fcr			bne  @t1			brl  fcr_examine			@t1			cmp  #examine_file			beq  examine						sec			brl  exit** examine the file specified by the current global variables, and * save the ASCII eof in g_eof*examine		stz  g_eof			stz  g_eof+2						lda  f_start_block			; skip past the 1k header			inc  a			inc  a			sta  block_num			@block_loop	jsr  read_block			bcc  @char_loop			brl  exit			@char_loop	lda  [io_buffer],y			and  #$FF						beq  @increment				; skip any NULL padding						cmp  #dle_char				; is it the DLE char?			bne  @add_it						iny							; add the number of compressed spaces			lda  [io_buffer],y			; to the eof			and  #$FF			sec			sbc  #32			clc			adc  g_eof			sta  g_eof			lda  g_eof+2			adc  #0			sta  g_eof+2						bra  @increment			@add_it		lda  g_eof					; increment the eof			clc			adc  #1			sta  g_eof			lda  g_eof+2			adc  #0			sta  g_eof+2			@increment	iny						lda  block_num				; if we are on the last block of the file,			cmp  f_end_block			; then check Y against f_ending_bytes instead			bcc  @check2				; if 1025						cpy  f_ending_bytes			bcc  @char_loop									bra  @finis			@check2		cpy  #1025					; have I read the whole buffer?			bcc  @char_loop@inc_blk	inc  block_num			inc  block_num						lda  f_end_block			inc  a			cmp  block_num			bcs  @block_loop						dec  block_num				; did I skip the last block # by addding 2 to block num?			cmp  block_num			bcs  @block_loop			@finis		brl  done			** examine the file.  build the logical file_mark table in the fcr and* calculate the ASCII eof.*fcr_examine	ldy  #fcr_start_block			lda  [my_fcr],y			sta  block_num						stz  g_eof			stz  g_eof+2@block_loop	jsr  read_block			bcc  @ok			brl  exit			@ok			lda  block_num				; convert physical block # into a logical block #			sec			sbc  f_start_block						lsr  a						; convert logical block # into an index into the array			asl  a						; x2 = 1 word  per block			asl  a						; x2 = 1 long  per block			asl  a						; x2 = 2 longs per block			clc			adc  #fcr_end			tay						lda  g_eof					; save the current eof as the start mark for the block			sta  [my_fcr],y			iny			iny			lda  g_eof+2			sta  [my_fcr],y			** calculate the # of chars in this block.*			ldy  #0@char_loop	lda  [io_buffer],y			; get the char			and  #$FF						beq  @increment				; skip any NULL padding						cmp  #dle_char				; is it the DLE char?			bne  @add_it						iny							; calculate the # of compressed spaces			lda  [io_buffer],y			and  #$FF			sec			sbc  #32						clc							; add the # of compressed spaces to the eof			adc  g_eof			sta  g_eof			lda  g_eof+2			adc  #0			sta  g_eof+2						bra  @increment			@add_it		lda  g_eof					; increment the eof			clc			adc  #1			sta  g_eof			lda  g_eof+2			adc  #0			sta  g_eof+2			@increment	iny						lda  block_num				; if we are on the last block of the file,			inc  a			cmp  f_end_block			; then check Y against f_ending_bytes+512 instead			bcc  @check2				; of 1024						lda  #512			clc			adc  f_ending_bytes			sta  temp			cpy  temp			bcc  @char_loop			** we have read all the data from this file, so save the ending eof for this block* and exit.*			lda  block_num							sbc  f_start_block				lsr  a						; / 2			asl  a						; x2 = 1 word  per block			asl  a						; x2 = 1 long  per block			asl  a						; x2 = 2 longs per block			clc			adc  #fcr_end+4			tay						lda  g_eof			sta  [my_fcr],y			iny			iny			lda  g_eof+2			sta  [my_fcr],y						bra  @finis					; done ->			@check2		cpy  #1024					; have I read the whole buffer?			bcc  @char_loop			lda  block_num				; save the hi mark of this block			sbc  f_start_block						lsr  a						; / 2			asl  a						; x2 = 1 word  per block			asl  a						; x2 = 1 long  per block			asl  a						; x2 = 2 longs per block			clc			adc  #fcr_end+4			tay						lda  g_eof			sta  [my_fcr],y			iny			iny			lda  g_eof+2			sta  [my_fcr],y@inc_blk	inc  block_num			inc  block_num						lda  f_end_block			; done?			inc  a			cmp  block_num			bcc  @finis					; yes ->						brl  @block_loop			@finis		ldy  #fcr_eof				; update the eof			lda  g_eof			sta  [my_fcr],y			iny			iny			lda  g_eof+2			sta  [my_fcr],y			done		clcexit		rts			ENDP EJECT******************************************************************** 			Name:	close**	 Description:	performs call $14, close**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************close		PROCNAME			WITH  globals			ldx  vcr_ptr			; setup the vcr ptr			ldy  vcr_ptr+2			jsl  deref			stx  my_vcr			sty  my_vcr+2						ldx  fcr_ptr			; setup the fcr ptr			ldy  fcr_ptr+2			jsl  deref			stx  my_fcr			sty  my_fcr+2			lda  [my_fcr]			jsl  release_fcr						ldy  #vcr_open_cnt			lda  [my_vcr],y			dec  a			cmp  #$ffff			beq  hara_kari			sta  [my_vcr],y			bra  done			** Something's terribly wrong here, and we have lost great face: we must commit* hara-kari...*hara_kari	lda  #$000A					;Get error code	for bad	VCR.			jml  sys_death				;Die.done		lda  #no_error			clcexit		brl  main_exit			ENDP EJECT******************************************************************** 			Name:	set_mark**	 Description:	performs call $16, set_mark**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************set_mark		PROCNAME			WITH  globals			ldx  fcr_ptr			; setup the fcr ptr			ldy  fcr_ptr+2			jsl  deref			stx  my_fcr			sty  my_fcr+2			** if the user is trying to set the mark on the directory, then* return invalid access.*			ldy  #fcr_file_type			lda  [my_fcr],y			cmp  #$0F			bne  ok			lda  #invalid_access			sec			brl  exit			ok			lda  #get_input			jsr  xfer_parms			bcc  ok2			brl  exit			ok2			lda  call_class			bne  is_c1			** do the class 0 version of the call.* check to see if the eof is >= to the requested position.  If it is not,* then return an error.*			ldy  #fcr_eof			lda  [my_fcr],y			sta  tempLong			iny			iny			lda  [my_fcr],y			sta  tempLong+2;			lda  tempLong				; get eof-1;			sec;			sbc  #1;			sta  tempLong;			lda  tempLong+2;			sbc  #0;			sta  tempLong+2						sec			lda  tempLong			sbc  g_position			lda  tempLong+2			sbc  g_position+2			bcs  @next			brl  range_err@next		lda  g_position				; set the new mark			ldy  #fcr_mark			sta  [my_fcr],y			iny			iny			lda  g_position+2			sta  [my_fcr],y						brl  done			** perform the class 1 version of the call.  decide how to interpret the* base parameter and act accordingly.*is_c1		lda  g_base			beq  base0						cmp  #1			beq  base1						cmp  #2			bne  @n2			brl  base2			@n2			cmp  #3			bne  @n1			brl  base3			@n1			lda  #parm_range_err			sec			brl  exit** mark = displacement* check to see if the eof is >= to the requested position.  If not,* return an error.*base0		ldy  #fcr_eof			lda  [my_fcr],y			sta  tempLong			iny			iny			lda  [my_fcr],y			sta  tempLong+2;			lda  tempLong				; get eof-1;			sec;			sbc  #1;			sta  tempLong;			lda  tempLong+2;			sbc  #0;			sta  tempLong+2						sec			lda  tempLong			sbc  g_displacement			lda  tempLong+2			sbc  g_displacement+2			bcs  @next			brl  range_err@next		lda  g_displacement			; set the new mark			ldy  #fcr_mark			sta  [my_fcr],y			iny			iny			lda  g_displacement+2			sta  [my_fcr],y									brl  done** mark = eof-displacement* first check to see that the eof is >= to the displacement.  If is, then* do the call, otherwise the result would be negative, so return an error*base1		ldy  #fcr_eof			lda  [my_fcr],y			sta  tempLong			iny			iny			lda  [my_fcr],y			sta  tempLong+2			sec			lda  tempLong			sbc  g_displacement			lda  tempLong+2			sbc  g_displacement+2			bcs  @next			brl  range_err@next		sec								; calculate the new mark			lda  tempLong			sbc  g_displacement			sta  tempLong			lda  tempLong+2			sbc  g_displacement+2			sta  tempLong+2						ldy  #fcr_mark					; save the new mark			lda  tempLong			sta  [my_fcr],y			iny			iny			lda  tempLong+2			sta  [my_fcr],y						brl  done** mark = mark+displacement* add the displacement to the current mark, then check to see if it is* past the eof.  If it is past the eof, then return an error, otherwise* complete the call.*base2		ldy  #fcr_mark					; get the mark+displacement			lda  [my_fcr],y			clc			adc  g_displacement			sta  tempLong			iny			iny			lda  [my_fcr],y			adc  g_displacement+2			sta  tempLong+2						ldy  #fcr_eof					; get the eof			lda  [my_fcr],y			sta  tempLong2			iny			iny			lda  [my_fcr],y			sta  tempLong+2			;			lda  tempLong2					; get eof-1;			sec;			sbc  #1;			sta  tempLong2;			lda  tempLong2+2;			sbc  #0;			sta  tempLong2+2			lda  tempLong2					; see if the eof > mark+displacement			sec			sbc  tempLong			lda  tempLong2+2			sbc  tempLong+2			bcc  range_err			lda  tempLong			ldy  #fcr_mark					; save the new mark			sta  [my_fcr],y			iny			iny			lda  tempLong+2			sta  [my_fcr],y						bra  done** mark = mark-displacement* check to see if the current mark is greater than the displacement.  If* it is, then complete the call, otherwise return an error*base3		ldy  #fcr_mark					; get the mark-displacement			lda  [my_fcr],y			sec			sbc  g_displacement			sta  tempLong			iny			iny			lda  [my_fcr],y			sbc  g_displacement+2			sta  tempLong+2			bcc  range_err					; was the displacement > mark?						lda  tempLong			ldy  #fcr_mark					; save the new mark			sta  [my_fcr],y			iny			iny			lda  tempLong+2			sta  [my_fcr],y						bra  done** return "parameter out of range" error code*range_err	lda  #out_of_range			sec			bra  exit			done		jsr  read_io_block				; read the current block into the			lda  #no_error					; fcr io buffer			clcexit		brl  main_exittempLong2	dc.l	0			ENDP EJECT******************************************************************** 			Name:	get_mark**	 Description:	performs call $17, get_mark**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************get_mark		PROCNAME			WITH  globals			ldx  fcr_ptr			; setup the fcr ptr			ldy  fcr_ptr+2			jsl  deref			stx  my_fcr			sty  my_fcr+2						ldy  #fcr_mark			; copy the mark value from the fcr			lda  [my_fcr],y			sta  g_position						lda  #send_output			jsr  xfer_parms			bcs  exit			done		lda  #no_error			clcexit		brl  main_exit			ENDP EJECT******************************************************************** 			Name:	get_eof**	 Description:	performs call $19, get_eof**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************get_eof		PROCNAME			WITH  globals			ldx  fcr_ptr			; setup the fcr ptr			ldy  fcr_ptr+2			jsl  deref			stx  my_fcr			sty  my_fcr+2						ldy  #fcr_eof			; retrieve the eof value from the fcr			lda  [my_fcr],y			sta  g_eof			iny			iny			lda  [my_fcr],y			sta  g_eof+2						lda  #send_output			jsr  xfer_parms			bcs  exit			done		lda  #no_error			clcexit		brl  main_exit			ENDP EJECT******************************************************************** 			Name:	get_dir_entry**	 Description:	performs call $1c, get_dir_entry**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************get_dir_entry	PROCNAME			WITH  globals			ldx  vcr_ptr			; setup the vcr ptr			ldy  vcr_ptr+2			jsl  deref			stx  my_vcr			sty  my_vcr+2						ldx  fcr_ptr			; setup the fcr ptr			ldy  fcr_ptr+2			jsl  deref			stx  my_fcr			sty  my_fcr+2						ldy  #vcr_dev			; set up device num for get_last_dev			lda  [<my_vcr],y			sta  drvr_dev_num** check to make sure that the user is trying to access a directory*			ldy  #fcr_file_type			lda  [my_fcr],y			cmp  #$0F			beq  ok				lda  #version_error			sec			brl  exit			ok			lda  #get_input			jsr  xfer_parms						ldy  #fcr_num_files			lda  [my_fcr],y			sta  temp			inc  temp						lda  g_base						; determine how to interpret			beq  base0						; the displacement						cmp  #1			beq  base1						cmp  #2			bne  @ok2			brl  base2			@ok2		lda  #parm_range_err			sec			brl  exit			base0		lda  g_displacement			beq  get_count					; does the user want the											; number of files in the dir?														cmp  temp						; the user wants a specific			bcc  @ok1						; file, so make sure it is			brl  end_dir@ok1		sta  g_entry_num			jsr  get_file					; within range and get the info			bcc  @ok			brl  exit@ok			brl  doneget_count	lda  call_class			beq  @ok						lda  g_pcount			cmp  #5			bcs  @ok				lda  #parm_range_err			sec			brl  exit			@ok			lda  #0							; set the mark to zero			ldy  #fcr_mark			sta  [my_fcr],y						lda  temp						; save the number of files			sta  g_entry_num						lda  call_class					; using class 1?			beq  @ok2						; no ->						lda  [param_blk_ptr]			; get the pcount parameter			cmp  #6							; is it 6 or greater?			bcs  @ok2						; yes ->			bra  @ok3						; no, so don't do anything ->						@ok2		lda  #entry_num					; here I output the parm			jsr  get_parm_offset			; myself so that any unrelated			lda  g_entry_num				; info will not be returned			dec  a			sta  [param_blk_ptr],y			; from calling xfer_parms			@ok3		lda  #no_error					; exit no error			clc			bra  exitbase1		ldy  #fcr_mark					; mark = mark + displacement			lda  [my_fcr],y			clc			adc  g_displacement				; is it within range?			cmp  temp			bcs  end_dir						sta  [my_fcr],y					; yes, save the new mark			sta  g_entry_num						jsr  get_file					; and get the file info			bcs  exit			bra  done			base2		ldy  #fcr_mark					; mark = mark - displacement			lda  [my_fcr],y			beq  end_dir					; if already at zero then error			sec								; is it within range?			sbc  g_displacement			cmp  #1			bcc  end_dir			cmp  #78			bcs  end_dir						sta  [my_fcr],y					; yes, save the new mark			sta  g_entry_num						jsr  get_file					; and get the file info			bcs  exit			bra  doneend_dir		lda  #end_of_dir			sec			bra  exit			done		lda  #send_output				; fill the users pblock			jsr  xfer_parms			bcs  exit			lda  #no_error			clcexit		brl  main_exittemp2		dc.w	0			ENDP EJECT******************************************************************** 			Name:	get_dev_num**	 Description:	performs call $20, get_dev_num**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.*** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************get_dev_num	PROCNAME			WITH  globals						lda  <dev_num				; was a device num specified?			beq  @1						; no ->			sta  g_dev_num				; yes, save the device number			bra  @2						; done ->			@1			lda  #get_input			jsr  xfer_parms			bcs  exit						jsr  find_target			bcs  exit@2			lda  #send_output			jsr  xfer_parms			bcs  exit			done		lda  #no_error			clcexit		brl  main_exit			ENDP EJECT******************************************************************** 			Name:	fst_specific**	 Description:	performs call $33, fst specific**		   Entry:	jmp**		   Input:	A = undefined*					X = call number times 2*					Y = class number times 2*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	brl main_exit**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************fst_specific	PROCNAME			WITH  globals			lda  call_class			bne  doit						lda  #invalid_class			sec			bra  exit			doit		lda  #get_input					; get parm from user's pblock			jsr  xfer_parms			bcs  exit					lda  g_command_num						cmp  #$0001						; set fst mode			bne  @next						lda  g_fst_mode			cmp  #2			bcs  bad_parm			cmp  #0			bmi  bad_parm			sta  the_fst_mode			bra  done			@next		cmp  #$8001						; get fst mode			bne  bad_parm			lda  the_fst_mode			sta  g_fst_mode			lda  #send_output			jsr  xfer_parms			bcs  exit			bra  done			bad_parm	lda  #parm_range_err			sec			bra  exit			done		lda  #no_error			clcexit		brl  main_exit						ENDP EJECT******************************************************************** FST Application Call Support Functions******************************************************************* EJECT******************************************************************** 			Name:	xfer_parms**	 Description:	**		   Entry:	jsr**		   Input:	A = direction to transfer parameters*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0**			Exit:	rts**			Uses:	** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************xfer_parms	PROCNAME			WITH globals						sta  xferDirection			stz  |g_error						lda  call_num			asl  a						; get call # x4			clc			adc  call_class				; make sure I am using the pblock			tax							; of the correct class						lda  parmTable-4,x			; get offset into parm table			sta  blockPtr			lda  #$FF					; assume class 0			sta  maxPCount				; to loop till the end of the pblock			lda  call_class			beq  doit					; we assumed correctly			isc1		lda  [param_blk_ptr]		; get the pcount			inc  a						; adjust for pcount itself			sta  maxPCountdoit		ldy  #0loop		lda  (blockPtr),y			; call the handler for each parm			beq  done					; in the call						sty  yIndex					; preserve the y register						asl  a						; multiply by two			tax			lda  xferDirection			; sending or receiving flag			jsr  (parm_table-2,x)			bcc  @next						cmp  #buff_too_small		; check to see if the error is a non-fatal			beq  @1			sec			bra  exit					; error			@1			sta  |g_error			@next		ldy  |yIndex				; restore the y register						iny							; increment it to the next parm			iny			iny			iny			tya							; make sure I don't go past the			lsr  a						; pcount			lsr  a			cmp  maxPCount			bcc  loopdone		lda  |g_error			cmp  #1						; condition carry appropriatelyexit		rtsxferDirection	dc.w	0yIndex			dc.w	0			ENDP					 EJECT******************************************************************** 			Name:	find_target**	 Description:	Attempts to find the target specified in*					g_pathname**		   Entry:	jsr**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rts**			Uses:	g_pathFlags** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************find_target	PROCNAME			WITH globals** break down the path*			jsr  break_down_path			bcs  exit			** does the path specify a volume name?*			lda  g_volumeName			beq  badPathErr			jsr  find_volume			bcs  exit;; Begin 18-Dec-91 MSD: Is the span OK?  If not, do bad_path_syntax.;			lda  span1			cmp  #16					; too big?			bcs  badPathErr				; yes, so return the error;; End 18-Dec-91 MSD;** does the path specify file name?*			lda  g_fileName			beq  done									jsr  find_file			bcs  not_founddone		clcexit		rts** the file was not found*not_found			lda  #file_not_found			sec			rts** the pathname was bad*badPathErr	lda  #bad_path_syntax			sec			rts						ENDP EJECT******************************************************************** 			Name:	BreakDownPath**	 Description:	Breaks down the current pathname into the*					volume and file names.**		   Entry:	jsr**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0**			Exit:	rts**			Uses:	** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************break_down_path	PROCNAME			WITH globals					stz  g_volumeName			stz  g_fileName** check to see if the path is valid.*doit		lda  path_flag			; check to see if the path is valid			and  #$4000			bne  no_device			; maybe it's valid ->			** the path is not valid, so use the device number passed to me.* the only time we get here is when there was ONLY a device name used* in the path, i.e. ".appledisk3.5a".*			lda  dev_num			; make sure I have a dev_num			bne  id_it			badPathErr	lda  #bad_path_syntax			sec			rtsid_it		lda  dev_num			jsr  id_disk			brl  exit				; return on up ->** the pathname is valid, check to see if the first char is a* separator.  if it is, then the path is a full path, otherwise it* is the beginning of the file name and I must get the volume* name by id'ing the device in dev_num.*no_device	ldy		#2			lda		[path1_ptr],y			and		#$00FF			cmp		#c1_sep				;does it start with a separator?			bne		no_vol				;no, must be filename only** there is a volume name*			iny							;skip past leading separator			ldx		#0					;init destination index			LONGA	OFF			sep		#$20@loop		lda		[path1_ptr],y		;get a character			beq  	doneVolume			;found null terminator, must be no filename			cmp		#c1_sep				;have we found the separator?			beq		doneVolume			;yup			sta		g_volumeName+2,x	;else store the character			inx			iny; Begin 18-Dec-91 MSD			cpx		#8					; is volume name too long (7 character max)?			bcc		@loop				; no, continue loop			rep		#$20				; return to full native			bra		badPathErr			; return the error;			bra		@loop; End 18-Dec-91 MSDdoneVolume	stx		g_volumeName		; save the length of the volume name			tax							; did we terminate on a null?			beq		done				; yup, guess we don't have a filename			iny							; else bump source index past separator			bra		pull_file			; then go parse filename** the path was valid, but did not contain the volume name, and* dev_num is valid, so get the volume name via id_disk, then drop* into pull_file to obtain the file name.*			LONGA	ONno_vol		lda		dev_num			jsr		id_disk			bcs		exit			ldy		#2					; init source index (no leading separator)			sep		#$20			LONGA	OFF			** copy the file name*pull_file			ldx		#0					; init destination index@loop		lda		[path1_ptr],y		; get a character			beq		donefile			; null terminator, we're done			cmp		#c1_sep				; trailing separator?			beq		donefile			; yup, we're done			sta		g_fileName+2,x		; else store it in our buffer			inx			iny			cpx		#16					; 13-Jan-92 GAB: filename too long (16 character max)?			bcc		@loopdonefile	stx		g_fileName			; store the length** all done*			LONGA	ONdone		rep		#$20			clcexit		rts			ENDP EJECT******************************************************************** 			Name:	find_volume**	 Description:	Attempts to find the volume of the specified*					name.  First it will look for a VCR of the *					same name, then will scan all the devices until*					there are no more devices, or until it finds*					the volume, which ever comes first.**		   Entry:	jmp**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rts**			Uses:	g_volumeName** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************find_volume	PROCNAME			WITH globals	** first, try to find a VCR with this name*			lda  #0						; search vcr list by name			ldx  #g_volumeName			ldy  #^g_volumeName			jsl  find_vcr				; does the vcr exist?			bcc  check_vcr			brl  find_it			* * the VCR exists, but is the VCR mine?*check_vcr	jsl  deref			stx  my_vcr			sty  my_vcr+2						ldy  #vcr_fst_id						lda  [my_vcr],y			cmp  #pascal_id				; is it mine?			bne  find_it				; nope ->** yes, the VCR is mine, now see if it is marked as swapped.* if it has been swapped, then go find the volume.*			ldy  #vcr_status			; make sure the disk hasn't			lda  [my_vcr],y				; been switched to another device			and  #vcr_swapped			bne  find_it** the vcr is mine and it has not been swapped, so check to see that it* is still in the device*			ldy  #vcr_dev				; get info on the volume			lda  [my_vcr],y			sta  device			sta  g_dev_num			lda  #g_volumeName			sta  string1			lda  #^g_volumeName			sta  string1+2						lda  #g_tempStr			sta  string2			lda  #^g_tempStr			sta  string2+2						jsr  strcpy					; copy g_volumeName to g_tempStr						lda  device			jsr  id_disk			;bcc  checkNames			bcs  notMyDisk	if 0 then	;duplicated code, why include it??? {gab}** the disk in the drive was not a pascal volume, so restore the name* of the volume I am looking for and go find it*			lda  #g_volumeName			; restore the name of the volume			sta  string2				; I am looking for			lda  #^g_volumeName			sta  string2+2						lda  #g_tempStr			sta  string1			lda  #^g_tempStr			sta  string1+2						jsr  strcpy			bra  find_it	endif			** the disk in the drive was a pascal disk, now I must check* to see if it is the same disk*checkNames	lda  #g_volumeName			; compare the two names			sta  string1			lda  #^g_volumeName			sta  string1+2			jsr  strcmp			bcc  done** the disk in the drive is not the disk I am looking for, so restore* the name of the volume and find it.*notMyDisk			lda  #g_volumeName			; restore the name of the volume			sta  string2				; I am looking for			lda  #^g_volumeName			sta  string2+2						lda  #g_tempStr			sta  string1			lda  #^g_tempStr			sta  string1+2						jsr  strcpy			;bra  find_it			bra  do_scan				; no need to copy the string back again! {gab}			** scan the devices for the volume*find_it		lda  #g_volumeName			sta  string1			lda  #^g_volumeName			sta  string1+2						lda  #g_tempStr			sta  string2			lda  #^g_tempStr			sta  string2+2						jsr  strcpy					; copy g_volumeName to g_tempStrdo_scan			jsr  scan_devs				; scan all the devices			bcs  exit						sta  device					; found the volume			sta  g_dev_num			ldy  #vcr_dev			sta  [my_vcr],y			lda  #vcr_status			; activate it			lda  [my_vcr],y			and  #vcr_swapped_in			sta  [my_vcr],y						done		;lda  #0			stz  f_start_block						ldy  #vcr_num_files			lda  [my_vcr],y			sta  f_ending_bytes			; number of files			ldy  #vcr_date_stamp		; create date/time			lda  [my_vcr],y			sta  g_create_date			stz  g_create_time						stz  g_mod_date				; mod date/time			stz  g_mod_time						lda  #$0F			sta  g_file_type						stz  g_aux_type			stz  g_eof			stz  g_eof+2			stz  blocks_used			clc			lda  #no_errorexit		rts			 EJECT******************************************************************** 			Name:	scan_devs**	 Description:	scans all the devices in the system, attempting*					to find the volume named by g_tempStr.**		   Entry:	jsr**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = device number if volume found*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = found*							   1 = not found**			Exit:	rts**			Uses:	g_volumeName** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************scan_devs	PROCNAME			WITH globals						stz  device					; scan all devices for the volumeloop		inc  device			lda  device			jsr  id_disk				; id the volume in this device			bcs  checkErr						lda  #g_volumeName			; is it the volume I want?			sta  string1			lda  #^g_volumeName			sta  string1+2						lda  #g_tempStr			sta  string2			lda  #^g_tempStr			sta  string2+2						jsr  strcmp			bcs  loop					; nope, so back to loop			done		lda  device			clc			rtscheckErr	cmp  #dup_volume			beq  exit						cmp  #invalid_dev_num		; loop until I have checked all devs			bne  loop							lda  #vol_not_found			stz  error_priority			; make sure this is clear since we 										;  didn't find the diskexit		sec			rts						ENDP			 EJECT******************************************************************** 			Name:	find_file**	 Description:	Attempts to find the file specified in*					'fileName' which resides on the current *					volume.**		   Entry:	jmp**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rts**			Uses:	** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************find_file	PROCNAME			WITH globals			lda  #g_fileName			; get_file places it's output			sta  string1				; into g_fileName, so I must			lda  #^g_fileName			; preserve it for comparison			sta  string1+2						lda  #g_tempStr			sta  string2			lda  #^g_tempStr			sta  string2+2						jsr  strcpy			** Scan all the file entries for the file of this name.  Note that* this algorithm searches the entries backwards.*			lda  numFiles					; the # of files on this volume			beq  not_found					; if zero then it is not there			sta  currFile	@loop		jsr  get_file					; attempt to find this file			bcs  exit						jsr  strcmp						; check the name, the pointers											; have not been changed from above														bcc  done						; got it ->							dec  currFile					; nope, not it			lda  currFile					; load the number of the next file			bne  @loop						; and check for itnot_found	lda  #file_not_found			; didn't get the file			sec			rts			done		clcexit		rts			currFile	dc.w	0tempMode	dc.w	0			ENDP EJECT******************************************************************** 			Name:	get_file**	 Description:	Pulls all information out of the current *					directory in io_buffer about the file number*					passed in A.  This routine does not attempt*					to verify that the file entry is actually*					there, that is left to the calling function.**		   Entry:	jsr**		   Input:	A = ordinal number of file (1-77)*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rts**			Uses:	******************************************************************** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************* REVISION HISTORY** 03/14/90	CAF	Changed storage type to a 1.*******************************************************************get_file	PROCNAME			WITH globals				sta  tempLong						tax			bne  @ok			lda  #file_not_found			sec			rts			@ok			;tax							; the file offset is 			lda  #26					; 26 times the file number			sta  temp@loop		cpx  #1			beq  next			clc			adc  temp			dex			bra  @loop						next		clc			adc  #vcr_directory			tay							; now y will contain the offset										; to the file entry													lda  [my_vcr],y				; start block			sta  f_start_block						iny			iny			lda  [my_vcr],y				; end block+1			dec  a			sta  f_end_block						iny			iny			lda  [my_vcr],y				; file type			sta  g_file_type						lda  #1			sta  g_storage_type			; storage type						iny			iny			lda  [my_vcr],y				; file name			and  #$FF					; convert len byte to len word			sta  g_fileName			iny			lda  [my_vcr],y			sta  g_fileName+2			iny			iny			lda  [my_vcr],y			sta  g_fileName+4			iny			iny			lda  [my_vcr],y			sta  g_fileName+6			iny			iny			lda  [my_vcr],y			sta  g_fileName+8			iny			iny			lda  [my_vcr],y			sta  g_fileName+10			iny			iny			lda  [my_vcr],y			sta  g_fileName+12			iny			iny			lda  [my_vcr],y			sta  g_fileName+14			iny			lda  [my_vcr],y			sta  g_fileName+15						iny			iny			lda  [my_vcr],y				; bytes in last block			sta  f_ending_bytes						iny			iny			lda  [my_vcr],y				; mod date			sta  g_mod_date						lda  #$C3					; access			sta  g_access						lda  g_file_type			; if it is a text file and I am in ascii mode,			cmp  #3						; then set the type = 4 and skip the 1k header			bne  @calc_eof				; of the file.			lda  the_fst_mode			bne  @calc_eof						inc  f_start_block			inc  f_start_block						lda  #4			sta  g_file_type@calc_eof	pea  0						; end of file			pea  0				lda  f_end_block			sec			sbc  f_start_block			inc  a			sta  g_blocks_used			; blocks used			dec  a			pha			pea  512			_Multiply			pla			clc			adc  f_ending_bytes			; add the remaining byte count						sta  g_eof			pla			adc  #0			sta  g_eof+2						stz  g_aux_type			stz  g_create_date			done		clcexit		rts			ENDP						; end of get_file			 EJECT******************************************************************** 			Name:	read_block**	 Description:	reads a block from the device in device,*					placing the data in io_buffer.  Will retry*					if either error drvr_disk_sw or drvr_busy is*					returned.**		   Entry:	jmp**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rts**			Uses:	Everything.** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************read_block	PROCNAME			WITH globals			do_read		lda  device			sta  drvr_dev_num						lda  #drvr_read			sta  drvr_call_num					lda  #$0200			sta  drvr_blk_size						lda  block_num			sta  drvr_blk_num			stz  drvr_blk_num+2						lda  #pascal_id			sta  drvr_fst_num						lda  #2			sta  drvr_cache						lda  #buffer_size			sta  drvr_req_cnt			stz  drvr_req_cnt+2						lda  <io_buffer			sta  <drvr_buf_ptr			lda  <io_buffer+2			sta  <drvr_buf_ptr+2			jsl  dev_dispatcher			bcc  exit							cmp  #drvr_disk_sw			; was the disk switched?			beq  do_read						cmp  #drvr_busy				; was the driver busy?			beq  do_read						secexit		rts			ENDP EJECT******************************************************************** 			Name:	get_parm_offset**	 Description:	Returns the offset into the users parameter*					block when given the call, class, and parameter.**		   Entry:	jmp**		   Input:	A = Parameter to retrieve*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = Offset into parameter block*					P = nvmxdizc*					    ..000..0 = no error*							   1 = error**			Exit:	rts**			Uses:	parm, call_num, call_class** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************get_parm_offset	PROCNAME			WITH globals						sta  parm						lda  call_num			asl  a						; get call # x4			clc			adc  call_class			tax						lda  parmTable-4,x			; get offset into parm table			sta  blockPtr						ldy  #0loop		lda  (blockPtr),y			cmp  parm			beq  found			iny			iny			iny			iny			bra  loop			notFound	sec			bra  exit			found		iny			iny			lda  (blockPtr),y			tay			clcexit		rts						ENDP EJECT******************************************************************** 			Name:	strcmp**	 Description:	Compares the two strings pointed to by *					string1 and string2.*					The strings must have a length word at the*					beginning.**		   Entry:	jsr**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = equal*							   1 = not equal**			Exit:	rts**			Uses:	string1 and string2** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************strcmp		PROCNAME			WITH globals						ldy  #0						; check the lengths first			lda  [string1],y			; if the length is not the			sta  length					; same, then the strings are			lda  [string2],y			; not equal.			cmp  length				bne  notEqual						LONGA  OFF					; go to 8 bit mode			LONGI  OFF			sep  #$30			inc  length					; increase the length by two			inc  length					; to adjust for the index of two			ldy  #2loop		lda  [string1],y			; ok, the strings have the			sta  tempChar				; same length, so now check all			lda  [string2],y			; the chars.			cmp  tempChar			bne  notEqual						iny							; increment the index						LONGA  ON					; make sure that I don't go			LONGI  ON					; past the end of the string			rep  #$30			cpy  length			bcs  areEqual				; if the index = length then			LONGA  OFF					; the strings are equal			LONGI  OFF			sep  #$30			bra  loop						LONGA  ON			LONGI  ONnotEqual	rep  #$30			sec							; strings not equal, return c=1			rts			areEqual	clc							; strings are equal, return c=0			rts						ENDP EJECT******************************************************************** 			Name:	strcpy**	 Description:	Copies the string pointed to by string1 into*					the buffer pointed to by string2.  String1*					must have a length word at the beginning,*					and the length word will be copied to string2.*					No error checking is done to see if the dest*					buffer is large enough.**		   Entry:	jsr**		   Input:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	string1,string2,temp** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************strcpy		PROCNAME			WITH globals						ldy  #0						; copy the length word			lda  [string1],y			sta  [string2],y						inc  a			inc  a						; inc twice to match the y index			sta  temp					; save it as a counter			iny			iny			sep  #$20					; short a			LONGA  OFFloop		cpy  temp					; finished?			bcs  done						lda  [string1],y			sta  [string2],y						iny			bra  loop						LONGA  ON			done		rep  #$20			clcexit		rts			ENDP			 EJECT******************************************************************** 			Name:	div512**	 Description:	divides the longword specifed in X (low word) *					and Y (hi word), by 512.  The quotient is*					returned in X and the remainder in A.**		   Entry:	jsr**		   Input:	A = undefined*					X = low word of value*					Y = hi word of value*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************div512		PROCNAME			WITH globals			stx  tempLong			sty  tempLong+2			stx  tempLong2			sty  tempLong2+2** divide by 512*			lda  #9						; divide by 512@loop1		clc			ror  tempLong+2			ror  tempLong			dec  a			bne  @loop1			lda  tempLong			sta  g_quotient			lda  tempLong+2			sta  g_quotient+2			** now multiply by 512, to give us the next multiple of 512* below the value*			lda  #9						; multiply by 512@loop2		clc			rol  tempLong			rol  tempLong+2			dec  a			bne  @loop2						lda  tempLong				; save the multiple of 512			sta  g_512multiple			lda  tempLong+2			sta  g_512multiple+2			lda  tempLong2				; obtain the difference			sec			sbc  tempLong			sta  tempLong			lda  tempLong2+2			sbc  tempLong+2			sta  tempLong+2						lda  tempLong			sta  g_remainder			lda  tempLong+2			sta  g_remainder+2			done		clcexit		rtstempLong2	dc.l	0			ENDP			EJECT;======================================================================;DOW_Convert:This routine convert Month,Day,Year into day of week;;Enter:         JSR;;Input:         A = Year;               X = Month;               Y = Day;               P = saved;               b = k;;Output:        A = day of week;               X = undefined;               Y = undefined;               P = restored;               b = k;;Uses:          all register;               local temps ;;======================================================================		longa	off		longi	off				EXPORT	dow_convert	dow_convert	PROCNAME		php		sep	#$30		phy		tay;==========================================================================;Figure the number of leap years since 1900;==========================================================================		lsr	a		lsr	a		sta	dow_temp;==========================================================================;If it's a leap year and it's Jan or Feb suvtract 1 from the total;==========================================================================		tya			;get the year back		and	#%00000011		bne	stim015		cpx	#03		bcs	stim015		dey;==========================================================================;add the number of leap years elapsed, the year, a constant for the;month, and the day;==========================================================================		stim015					; 		clc		tya			;get the year again		adc	dow_temp	;# of leap years since 1900		adc	wkmon-1,x		adc	1,s		ply			;clean the stack;==========================================================================;Now mod the result by seven, but exit in the range [1..7];==========================================================================		secstim016					; 		sbc	#07		cmp	#08		bcs	stim016		plp			;restore mode		rtsdow_temp	DC.B	0wkmon		DC.B	$08,$0B,$0B,$07,$09,$0C,$07,$0A,$0D,$08,$0B,$0D				LONGA  ON		LONGI  ON		ENDP EJECT******************************************************************** The parameter block i/o functions begin here******************************************************************* EJECT******************************************************************** 			Name:	p_access**	 Description:	This function places the access *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_access** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_access	PROCNAME			WITH globals						cmp  #get_input				; access is only used as			beq  done					; an output parm					lda  #access			jsr  get_parm_offset			lda  g_access			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_aux_type**	 Description:	This function places the aux_type *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_aux_type** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_aux_type	PROCNAME			WITH globals					cmp  #get_input				; aux_type is only used as			beq  done					; an output parm					lda  #aux_type			jsr  get_parm_offset			lda  g_aux_type				; aux_type is always zero			sta  [param_blk_ptr],y			iny			iny			lda  #0			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_base**	 Description:	This function copies the base *					parameter from the user's pblock.  It is an*					input parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_base** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_base		PROCNAME			WITH globals					cmp  #send_output			; base is only used as			beq  done					; an input parm					lda  #base			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_base			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_blocks_used**	 Description:	This function places the blocks_used *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_blocks_used** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_blocks_used	PROCNAME			WITH globals					cmp  #get_input				; blocks_used is only used as			beq  done					; an output parm					lda  #blocks_used			jsr  get_parm_offset			lda  g_blocks_used			sta  [param_blk_ptr],y			iny			iny			lda  #0						; zero out the hi word			sta  [param_blk_ptr],y			done		clcexit		rts						ENDP		 EJECT******************************************************************** 			Name:	p_block_size**	 Description:	This function places the block_size *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_block_size	PROCNAME			WITH globals				cmp  #get_input				; block_size is an output			beq  done					; only			lda  #block_size			jsr  get_parm_offset			lda  #$200			sta  [param_blk_ptr],ydone		clc			rts					ENDP		 EJECT******************************************************************** 			Name:	p_cache_priority**	 Description:	This function copies the cache_priority *					parameter from the user's pblock.  It is an*					input parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_cache_priority** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_cache_priority	PROCNAME			WITH globals					cmp  #send_output			; cache_priority is only			beq  done					; used as an input parm					lda  #cache_priority			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_cache_priority			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_create_date**	 Description:	This function places the create_date *					parameter into the user's pblock. It is an*					output parameter only.  Converts the date*					from the Pascal date format to the Class 0*					date format.**					Pascal Date Format:**					      Year        Day     Month*					+-------------+---------+-------+*					|F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*					+-------------+---------+-------+**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_create_date** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_create_date	PROCNAME			WITH globals					cmp  #get_input				; create_date is only used as			beq  done					; an output parm						lda  g_create_date			; year			and  #$FE00			sta  temp						lda  g_create_date			; date			and  #$01F0			lsr  a			lsr  a			lsr  a			lsr  a			ora  temp			sta  temp						lda  g_create_date			; month			and  #$000F			asl  a			asl  a			asl  a			asl  a			asl  a			ora  temp			sta  temp							lda  #create_date			jsr  get_parm_offset			lda  temp			sta  [param_blk_ptr],y			done		clcexit		rtstemp		dc.w	0					ENDP		 EJECT******************************************************************** 			Name:	p_create_dateTime**	 Description:	This function places the create_dateTime *					parameter into the user's pblock.  It is an*					output parameter only.  It converts the date*					from pascal format into the format described in*					the ReadTimeHex call in the misc toolset.**					Pascal Date Format:**					      Year        Day     Month*					+-------------+---------+-------+*					|F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*					+-------------+---------+-------+*		*		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_create_dateTime** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_create_dateTime	PROCNAME			WITH globals					cmp  #get_input				; create_dateTime is only used as			beq  done					; an output parm					stz  g_create_dateTime			stz  g_create_dateTime+2			stz  g_create_dateTime+4			stz  g_create_dateTime+6										lda  g_create_date				; year			beq  out						; empty ->			and  #$FE00			lsr  a			xba			sep  #$20			sta  g_create_dateTime+3			rep  #$20						lda  g_create_date				; date			and  #$01F0			lsr  a			lsr  a			lsr  a			lsr  a			sep  #$20			dec  a			sta  g_create_dateTime+4			rep  #$20						lda  g_create_date				; month			and  #$000F			sep  #$20			dec  a			sta  g_create_dateTime+5			rep  #$20						LONGA  OFF			LONGI  OFF			sep  #$30					; day of week			lda  g_create_dateTime+3		;  year			ldx  g_create_dateTime+5		;  month			inx			ldy  g_create_dateTime+4		;  day			iny			jsr  dow_convert			sta  g_create_dateTime+7			rep  #$30			LONGA  ON			LONGI  ON			out			lda  #create_dateTime			jsr  get_parm_offset			lda  g_create_dateTime			sta  [param_blk_ptr],y			iny			iny			lda  g_create_dateTime+2			sta  [param_blk_ptr],y			iny			iny			lda  g_create_dateTime+4			sta  [param_blk_ptr],y			iny			iny			lda  g_create_dateTime+6			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_create_time**	 Description:	This function places the create_time *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_create_time** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_create_time	PROCNAME			WITH globals					cmp  #get_input				; create_time is only used as			beq  done					; an output parm					lda  #create_time			jsr  get_parm_offset			lda  #0						; always zero			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_data_buffer**	 Description:	This function copies the data_buffer *					parameter from the user's pblock.  It is an*					input parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_data_buffer** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_data_buffer	PROCNAME			WITH globals					cmp  #send_output			; data_buffer is only used as			beq  done					; an input parm					lda  #data_buffer			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_data_buffer			iny			iny			lda  [param_blk_ptr],y			sta  g_data_buffer+2			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_dev_name**	 Description:	This function clears the carry and returns.*					It is used as a place holder.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_dev_name	PROCNAME			WITH globals					clc			rts					ENDP		 EJECT******************************************************************** 			Name:	p_displacement**	 Description:	This function copies the displacement *					parameter from the user's pblock.  It is an*					input parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_displacement** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_displacement	PROCNAME			WITH globals					cmp  #send_output			; displacement is only used as			beq  done					; an input parm					lda  #displacement			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_displacement			iny			iny			lda  [param_blk_ptr],y			sta  g_displacement+2			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_entry_num**	 Description:	This function places the entry_num *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_entry_num** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_entry_num	PROCNAME			WITH globals					cmp  #get_input				; entry_num is only used as			beq  done					; an output parm					lda  #entry_num			jsr  get_parm_offset			lda  g_entry_num			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_eof**	 Description:	This function places the eof *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_eof** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_eof		PROCNAME			WITH globals					cmp  #get_input				; eof is only used as			beq  done					; an output parm					lda  #eof			jsr  get_parm_offset			lda  g_eof			sta  [param_blk_ptr],y			iny			iny			lda  g_eof+2			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_file_type**	 Description:	This function places the file_type *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_file_type** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_file_type	PROCNAME			WITH globals					cmp  #get_input				; file_type is only used as			beq  done					; an output parm					lda  #file_type			jsr  get_parm_offset						lda  the_fst_mode			beq  ascii_mode			native_mode lda  g_file_type			sta  [param_blk_ptr],y			bra  done		ascii_mode	lda  g_file_type			cmp  #3						; is it a text file?			beq  isText						bra  doit			isText		lda  #4doit		sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_file_sys_id**	 Description:	This function places the file_sys_id *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	io_buffer, param_blk_ptr** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_file_sys_id	PROCNAME			WITH globals					cmp  #get_input			beq  done						lda  #file_sys_id			; file system id			jsr  get_parm_offset			lda  #pascal_id			sta  [param_blk_ptr],ydone		clc			rts					ENDP		 EJECT******************************************************************** 			Name:	p_flags**	 Description:	This function places the flags *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_flags		PROCNAME			WITH globals					cmp  #get_input				; flags is an output parm			beq  done					; only						lda  #flags			jsr  get_parm_offset			lda  #0			sta  [param_blk_ptr],ydone		clc			rts					ENDP		 EJECT******************************************************************** 			Name:	p_free_blocks**	 Description:	This function places the free_blocks *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_free_blocks	PROCNAME			WITH globals			cmp  #get_input			beq  done						lda  #6							; initialize # of used blocks			sta  used_blks					; 2 boot blocks + 4 dir blocks = 6					ldy  #vcr_num_files				; get the number of files on the volume			lda  [<my_vcr],y			beq  calc_free					; no files ->			tax						clc								; calculate offset to beginning of			lda  #vcr_directory				; directory in vcr			adc  #26						; skip volume entry			tay			@loop		lda  [<my_vcr],y				; get starting block of file			sta  temp			iny			iny			lda  [<my_vcr],y				; get ending block of file			sec								; calculate blocks used by file			sbc  temp			clc			adc  used_blks					; add it to the # of used blocks on volume			sta  used_blks						tya								; move index to next file			clc			adc  #24			tay						dex								; is there another file?			bne  @loop						; yes ->			calc_free	sec								; calculate the number of free blocks on the volume			lda  g_blocks_used			sbc  used_blks			sta  free_blks					; save the result						lda  #free_blocks				; get offset to parameter			jsr  get_parm_offset			lda  free_blks			sta  [param_blk_ptr],y			; send output			iny			iny			lda  #0 			sta  [param_blk_ptr],y			done		clc			rtsused_blks	dc.w	0free_blks	dc.w	0			ENDP		 EJECT******************************************************************** 			Name:	p_mod_date**	 Description:	This function places the mod_date *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_mod_date** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_mod_date	PROCNAME			WITH globals					cmp  #get_input				; mod_date is only used as			beq  done					; an output parm			lda  g_mod_date				; year			and  #$FE00			sta  temp						lda  g_mod_date				; date			and  #$01F0			lsr  a			lsr  a			lsr  a			lsr  a			ora  temp			sta  temp						lda  g_mod_date				; month			and  #$000F			asl  a			asl  a			asl  a			asl  a			asl  a			ora  temp			sta  temp							lda  #mod_date			jsr  get_parm_offset			lda  temp				sta  [param_blk_ptr],y			done		clcexit		rts			ENDP		 EJECT******************************************************************** 			Name:	p_mod_dateTime**	 Description:	This function places the mod_dateTime *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	io_buffer, param_blk_ptr** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_mod_dateTime	PROCNAME			WITH globals					cmp  #get_input				; mod_dateTime is only used as			beq  done					; an output parm					stz  g_mod_dateTime			stz  g_mod_dateTime+2			stz  g_mod_dateTime+4			stz  g_mod_dateTime+6										lda  g_mod_date				; year			beq  out					; empty ->			and  #$FE00			lsr  a			xba			sep  #$20			sta  g_mod_dateTime+3			rep  #$20						lda  g_mod_date				; date			and  #$01F0			lsr  a			lsr  a			lsr  a			lsr  a			sep  #$20			dec  a			sta  g_mod_dateTime+4			rep  #$20						lda  g_mod_date				; month			and  #$000F			sep  #$20			dec  a			sta  g_mod_dateTime+5			rep  #$20						LONGA  OFF			LONGI  OFF			sep  #$30					; day of week			lda  g_mod_dateTime+3		;  year			ldx  g_mod_dateTime+5		;  month			inx			ldy  g_mod_dateTime+4		;  day			iny			jsr  dow_convert			sta  g_mod_dateTime+7			rep  #$30			LONGA  ON			LONGI  ON			out			lda  #mod_dateTime			jsr  get_parm_offset			lda  g_mod_dateTime			sta  [param_blk_ptr],y			iny			iny			lda  g_mod_dateTime+2			sta  [param_blk_ptr],y			iny			iny			lda  g_mod_dateTime+4			sta  [param_blk_ptr],y			iny			iny			lda  g_mod_dateTime+6			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_mod_time**	 Description:	This function places the mod_time *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_mod_time** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_mod_time	PROCNAME			WITH globals					cmp  #get_input				; mod_time is only used as			beq  done					; an output parm					lda  #mod_time			jsr  get_parm_offset			lda  #0						; always unknown			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_name**	 Description:	This function places the name *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	io_buffer, param_blk_ptr** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_name		PROCNAME			WITH globals					cmp  #get_input			bne  output						brl  done** the output is a c1 string for both c0 and c1!*			;------------- Output Routines -------------output		stz  temp			lda  #name					; transfer name			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  output_ptr			iny			iny			lda  [param_blk_ptr],y			sta  output_ptr+2					ldy  #$0			lda  [output_ptr],y			; is the output buffer large			dec  a			cmp  g_fileName				; enough?			bcs  @1						inc  temp					; no, it is not			dec  a						; adjust size to fit in buffer			dec  a			dec  a			dec  a			sta  size			bra  doit			@1			lda  g_fileName				; get length word			sta  sizedoit		inc  size					; adjust length to include length			inc  size					; word which I skip			ldx  #$02					; skip the length word			ldy  #$02					; skip buffer length word			sta  [output_ptr],y			; store length			iny			iny			sep  #$20					; 8 bit a			LONGA  OFF@loop1		lda  g_fileName,x			; copy the volume name			sta  [output_ptr],y			iny			inx			cpx  size			bcc  @loop1			LONGA  ON			rep  #$20			** check to see if the flag which indicates the buffers was too* small is set, if it is, then return a buffer too small error*			lda  temp			beq  done						lda  #buff_too_small			sec			bra  exit			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_new_pathname**	 Description:	This function clears the carry and returns.  It*					is used only as a place holder.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_new_pathname	PROCNAME			WITH globals					clc			rts					ENDP		 EJECT******************************************************************** 			Name:	p_option_list**	 Description:	This function sets up the option list.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_option_list	PROCNAME			WITH globals			** save the transfer direction*			pha** get the pointer to the option list*			lda  #option_list			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  op_list_ptr			iny			iny			lda  [param_blk_ptr],y			sta  op_list_ptr+2			ora  op_list_ptr				; null?			bne  @1			pla			bra  done						; yes ->** determine the transfer direction*@1			pla			cmp  #get_input			bne  output** the transfer direction is input, so make sure the option list* buffer is large enough.*input		stz  credit_flg					; initialize the credit flag			lda  [<op_list_ptr]				; get the size of the option list			cmp  op_size					; large enough to hold the credits?			bcc  @1							; no ->						inc  credit_flg					; yes, set the flag			lda  #0							; no error			bra  done						; exit ->			@1			cmp  #4							; will it hold the minimum amount of data?			bcc  error						; nope ->			lda  #0							; no error			bra  done						; exit ->			error		lda  #buff_too_small			; buffer is too small			sec								; 			bra  exit						; exit ->** the transfer direction is output, so place the data into the* buffer.  there is no need to check the buffer size, because* that was done during the input stage.*output		lda  credit_flg					; do I get to pat myself on the back?;			beq	 boring						; nope ->			bra	 boring						; nope -> we don't include the credits											; anymore..... Too bad.						lda  op_size					; get the size of the credit data			dec  a							; - 2			dec  a			ldy  #2			sta  [<op_list_ptr],y			; = required size (data + fsys_id)			dec  a			dec  a			dec  a							; - 3 = data size			tax								; source index			ldy  op_size					; dest index			iny						LONGA  OFF			sep  #$20						; transfer the data@loop		lda  op_data,x					; load data			sta  [<op_list_ptr],y			; store data			dey								; dest--			dex								; source--			bpl  @loop						; done? no ->			rep	 #$20			LONGA  ON						bra  store_id					; ->			boring		lda  #2							; required size			ldy  #2							; dest index			sta  [<op_list_ptr],y			; store it			store_id	lda  #pascal_id					; file_sys_id			ldy  #4							; index			sta  [<op_list_ptr],y			; store it			lda  #0							; no error			** clean up and exit*done		clcexit		rtscredit_flg	dc.w	0op_size		dc.w	op_end-op_data+4op_data		dc.b	'Pascal FST Written By Cary Farrier & Tested By Linda Pan.'op_end			ENDP		 EJECT******************************************************************** 			Name:	p_pathname**	 Description:	**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_pathname	PROCNAME			WITH globals					clc			rts					ENDP		 EJECT******************************************************************** 			Name:	p_pcount**	 Description:	This function clears the carry and returns.  It*					is used only as a place holder.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_pcount	PROCNAME			WITH globals					cmp  #send_output			beq  doneinput		lda  #pcount			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_pcountdone		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_position**	 Description:	This function places the position *					parameter into the user's pblock.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_position** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_position	PROCNAME			WITH globals					cmp  #send_output			beq  outputinput		lda  #position			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_position			iny			iny			lda  [param_blk_ptr],y			sta  g_position+2			bra  doneoutput		lda  #position			jsr  get_parm_offset			lda  g_position			sta  [param_blk_ptr],y			iny			iny			lda  g_position+2			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_ref_num**	 Description:	This function places the ref_num *					parameter into the user's pblock, or gets*					the refnum from the fcr, depending on the*					direction of the xfer.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_ref_num** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_ref_num	PROCNAME			WITH globals					cmp  #get_input			bne  outputinput		ldy  #fcr_ref_num			lda  [<my_fcr],y			sta  g_ref_num			bra  done		output		lda  call_num				; open call?			lsr  a			and  #$FF			cmp  #$10			bne  done					; no ->						lda  #ref_num			jsr  get_parm_offset			lda  g_ref_num			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_req_file_sys_id**	 Description:	This function clears the carry and returns.  It*					is used only as a place holder.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_req_file_sys_id	PROCNAME			WITH globals					clc			rts					ENDP			 EJECT******************************************************************** 			Name:	p_request_access**	 Description:	This function clears the carry and returns.  It*					is used only as a place holder.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.** REVISION HISTORY :** 11/20/89	CAF		added code to make sure that request_access*					is always $00 or $01, else return an error.*******************************************************************p_request_access	PROCNAME			WITH globals						cmp  #send_output			; request_count is only			beq  done					; used as an input parm					lda  #request_access			jsr  get_parm_offset			lda  [param_blk_ptr],y						beq  done					; is it $0000? yes ->						dec  a						; is it $0001? yes ->			beq  done						lda  #invalid_access		; error			sec			bra  exit			done		clcexit		rts						ENDP			 EJECT******************************************************************** 			Name:	p_request_count**	 Description:	This function copies the request_count *					parameter from the user's pblock.  It is an*					input parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_request_count** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_request_count	PROCNAME			WITH globals						cmp  #send_output			; request_count is only			beq  done					; used as an input parm					lda  #request_count			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_request_count			iny			iny			lda  [param_blk_ptr],y			sta  g_request_count+2			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_resource_blocks**	 Description:	This function places the resource_blocks *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_resource_blocks	PROCNAME			WITH globals					cmp  #get_input				; resource_blocks is only			beq  done					; used as an output parm					lda  #resource_blocks			jsr  get_parm_offset			lda  #0						; always zero			sta  [param_blk_ptr],y			iny			iny			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_resource_eof**	 Description:	This function places the resource_eof *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_resource_eof	PROCNAME			WITH globals					cmp  #get_input				; resource_eof is only			beq  done					; used as an output parm					lda  #resource_eof			jsr  get_parm_offset			lda  #0			sta  [param_blk_ptr],y			iny			iny			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_resource_number**	 Description:	This function validates the resource_number *					parameter from the user's pblock.  The*					parameter is not used by the FST in any way*					other than the error checking done here.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_resource_number	PROCNAME			WITH globals					cmp  #send_output			; resource_number is only			beq  done					; used as an input parm					lda  #resource_number			jsr  get_parm_offset			lda  [param_blk_ptr],y			beq  done					; is the user requesting the										; data fork?													cmp  #2						; no, is the parm > 1?			bcs  resBadParm				; yes, so it is a bad parm			lda  #res_not_found			; the user wants a rsrc			sec							; fork but I don't support			bra  exit					; them.resBadParm	lda  #parm_range_err			sec			bra  exit			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_storage_type**	 Description:	This function places the storage_type *					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**		  Output:	A = undefined*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000...**			Exit:	rts**			Uses:	g_storage_type** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_storage_type	PROCNAME			WITH globals					cmp  #get_input				; storage_type is only			beq  done					; used as an output parm					lda  #storage_type			jsr  get_parm_offset			lda  g_storage_type			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP				 EJECT******************************************************************** 			Name:	p_transfer_count**	 Description:	This function places the transfer_count*					parameter into the user's pblock.  It is an*					output parameter only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = offset of parameter into pblock*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = error*							   1 = no error**			Exit:	rts**			Uses:	g_transfer_count** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_transfer_count	PROCNAME			WITH globals					cmp  #get_input				; transfer_count is only			beq  done					; used as an output parm					lda  #transfer_count			jsr  get_parm_offset			lda  g_transfer_count			sta  [param_blk_ptr],y			iny			iny			lda  g_transfer_count+2			sta  [param_blk_ptr],y			done		clcexit		rts					ENDP EJECT******************************************************************** 			Name:	p_vol_name**	 Description:	This function copies the vol_name parm into*					the user's pblock.  It is an output parm only.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = offset of parameter into pblock*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = error*							   1 = no error**			Exit:	rts**			Uses:	** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_vol_name	PROCNAME			WITH globals					cmp  #get_input			bne  output						;------------- Input Routines -------------input		lda  call_class			bne  class1inclass0inclass1in			brl  done						;------------- Output Routines -------------output		lda  call_class			bne  class1out			class0out	lda  #vol_name			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  output_ptr			iny			iny			lda  [param_blk_ptr],y			sta  output_ptr+2				lda  g_volumeName			; get length word			sta  size			inc  size					; adjust length to include length			inc  size					;  word which I skip			inc  a						; increase length for '/'			ldx  #$02					; skip the length word			ldy  #$00			sep  #$20					; 8 bit a			LONGA  OFF			lda  g_volumeName			; get length byte			inc  a						; compensate for separator			sta  [output_ptr],y			; store length byte			iny			lda  #c0_sep			sta  [output_ptr],y			; store '/'			iny@loop		lda  g_volumeName,x			; copy the volume name			sta  [output_ptr],y			iny			inx			cpx  size			bcc  @loop			LONGA  ON			rep  #$20						brl  done			class1out	stz  temp			lda  #vol_name				; transfer volume name			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  output_ptr			iny			iny			lda  [param_blk_ptr],y			sta  output_ptr+2					ldy  #$0			lda  [output_ptr],y			; is the output buffer large			dec  a			cmp  g_volumeName			; enough?			bcs  @1						inc  temp					; no, it is not			dec  a						; adjust size to fit in buffer			dec  a			dec  a			dec  a			sta  size			bra  doit			@1			lda  g_volumeName			; get length word			sta  sizedoit		inc  size					; adjust length to include length			inc  size					; word which I skip			inc  a						; increase length for ':'			ldx  #$02					; skip the length word			ldy  #$02					; skip buffer length word			sta  [output_ptr],y			; store length			iny			iny			sep  #$20					; 8 bit a			LONGA  OFF			lda  #c1_sep			sta  [output_ptr],y			; store ':'			iny@loop1		lda  g_volumeName,x			; copy the volume name			sta  [output_ptr],y			iny			inx			cpx  size			bcc  @loop1			LONGA  ON			rep  #$20			** check to see if the flag which indicates the buffers was too* small is set, if it is, then return a buffer too small error*			lda  temp			beq  done						lda  #buff_too_small			sec			bra  exit			done		clcexit		rts					ENDP		 EJECT******************************************************************** 			Name:	p_null_field**	 Description:	This function clears the carry and returns.*					It is used only as a place holder.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = offset of parameter into pblock*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = error*							   1 = no error**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_null_field PROCNAME			WITH globals						clc			rts						ENDP EJECT******************************************************************** 			Name:	p_command_num**	 Description:	This function copies the command_num*					parameter from the users pblock.**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = offset of parameter into pblock*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = error*							   1 = no error**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_command_num PROCNAME			WITH globals						cmp  #send_output			beq  done						lda  #command_num			; transfer fst mode			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_command_num			done		clcexit		rts						ENDP EJECT******************************************************************** 			Name:	p_fst_mode**	 Description:	This function copies the fst_mode parameter*					from the users pblock**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = offset of parameter into pblock*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = error*							   1 = no error**			Exit:	rts**			Uses:	nothing** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_fst_mode	PROCNAME			WITH globals						cmp  #send_output			bne  input			output		lda  #fst_mode				; transfer fst mode			jsr  get_parm_offset			lda  g_fst_mode			sta  [param_blk_ptr],y			bra  done			input		lda  #fst_mode				; transfer fst mode			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_fst_mode			done		clcexit		rts						ENDP			 EJECT******************************************************************** 			Name:	p_dev_num**	 Description:	This function copies the dev_num parameter*					from the users pblock**		   Entry:	jsr**		   Input:	A = zero     : get the input from the pblock*						non-zero : put the output into the pblock*					X = undefined*					Y = offset of parameter into pblock*					P = nvmxdizc*					    ..000...**		  Output:	A = error code if carry set*					X = undefined*					Y = undefined*					P = nvmxdizc*					    ..000..0 = error*							   1 = no error**			Exit:	rts**			Uses:	g_dev_num** Copyright Apple Computer, Inc. 1989-1992.  All rights reserved.******************************************************************p_dev_num	PROCNAME			WITH globals						cmp  #send_output			bne  input			output		lda  #device_num			; transfer dev_num			jsr  get_parm_offset			lda  g_dev_num			sta  [param_blk_ptr],y			bra  done			input		lda  #device_num			; transfer dev_num			jsr  get_parm_offset			lda  [param_blk_ptr],y			sta  g_dev_num			done		clcexit		rts						ENDP			END