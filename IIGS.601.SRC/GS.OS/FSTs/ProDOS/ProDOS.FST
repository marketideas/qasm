		print	push		print	off		string	asis		include	'common.equ.src'		;------------------------------------------;; Equates from procedure ;;------------------------------------------CallStringToText equ 1		;conditional code for JudgeName, 14-Apr-91 DALAllowLCPeriods	equ 0		;conditional code allowing blanks in names, 7-Aug-91 DAL				;(0 = no blanks allowed, 12-Aug-91 GAB)debug_on	equ	00		;00 = debug off, <>0 = debug onword		equ	02		;two bytes for a wordblk_size	equ	512		;standard size of a prodos blockdelimiter	equ	$3A		;pathname delimiter = ":"min_send_cnt	equ	$21		;If read < 33 bytes use local routinevcr_main	equ	vcr_dev+2vol_reserved	equ	$0000		;8 bytes of reserved field from diskvol_mod		equ	vol_reserved+2	;volume mod datevol_create	equ	vol_reserved+8	;create date/time from headervol_version	equ	vol_create+4	;version of OS that created filevol_min_version	equ	vol_version+1	;minimum version of OS that can accessvol_access	equ	vol_min_version+1 ;access for a filevol_entry_len	equ	vol_access+1	;entry length of each entryvol_entries	equ	vol_entry_len+1	;number of entries per blockvol_file_count	equ	vol_entries+1	;number of files in volume directoryvol_bitmap_addr	equ	vol_file_count+2 ;starting block of bitmapvol_total_blks	equ	vol_bitmap_addr+2 ;total number of blocks on disknum_bitmap_blks	equ	vol_total_blks+2 ;total number of bitmap blocksend_bitmap	equ	num_bitmap_blks+2 ;1st byte that starts all zerosavail_bitmap	equ	end_bitmap+2	;1st bitmap block(rel)  with free spacecurr_bitmap	equ	avail_bitmap+2	;current bitmap(rel) block in memorybitmap_dirty	equ	curr_bitmap+2	;0 = bitmap clean, <> 0 = bitmap dirtyfree_blocks	equ	bitmap_dirty+2	;Free blocks on volume,$FFFF = unknownvol_damaged	equ	free_blocks+2	;stops writing to bad disk if <> 00dirty_file_cnt	equ	vol_damaged+2	;number of files that are open for writing and are dirtybitmap_start	equ	dirty_file_cnt+4+vcr_mainpro_vcr_size	equ	bitmap_start+$200bitmap_mod	equ	$FFFFbitmap_unknown	equ	$FFFFvcr_entry_length equ	$000Ffcr_res_num	equ	$0000		;resource number of this filefcr_storage	equ	fcr_res_num+2	;real storage type on diskfcr_entry_type	equ	fcr_storage+2	;storage type from directory entryfcr_file_id	equ	fcr_entry_type+2 ;used to ID duplicate filesfcr_file_type	equ	fcr_file_id+2	;file typefcr_key_blk	equ	fcr_file_Type+1	;key block of the filefcr_blks_used	equ	fcr_key_blk+2	;number of blocks usedfcr_eof		equ	fcr_blks_used+2	;current end of filefcr_create	equ	fcr_eof+3	;create date/time ProDOSfcr_vers	equ	fcr_create+4	;version of o/s that made filefcr_min_vers	equ	fcr_vers+1	;min version of o/s allowedfcr_disk_acc	equ	fcr_min_vers+1	;file accessfcr_aux_type	equ	fcr_disk_acc+1	;aux type for this filefcr_modified	equ	fcr_aux_type+2	;modified date of filefcr_header_ptr	equ	fcr_modified+4	;key block of dir ownerfcr_status	equ	fcr_header_ptr+2 ;offset: current status of filegde_entry_num	equ	fcr_status+2	;current entry for Get_Dir_Entrygde_offset	equ	gde_entry_num+2	;current offset to entrygde_curr_blk	equ	gde_offset+2	;current directory block loadedgde_tot_files	equ	gde_curr_blk+2	;total files in directoryfcr_curr_mark	equ	gde_tot_files+2	;current file markfcr_blks_alloc	equ	fcr_curr_mark+4	;current number of blks allocfcr_curr_eof	equ	fcr_blks_alloc+2 ;current end of filefcr_parent	equ	fcr_curr_eof+4	;block number of directory blockfcr_entry_offs	equ	fcr_parent+2	;index to entry within parent blockdata_blk_num	equ	fcr_entry_offs+2 ;block number of current data blockindex_blk_num	equ	data_blk_num+2	;block number of current index blockmaster_blk_num	equ	index_blk_num+2	;block number of master index blockclr_global_clean equ	$7FFF		;clear the global clean bitset_global_clean equ	$8000		;set the file clean in the FCRset_access_res	equ	$4000		;set the resource fork bit in the FCRClrAllButAccess equ	$3FFF		;clear the resource bit from access word.fcr_fst_ptr	equ	fcr_access+2fcr_io_start	equ	master_blk_num+2+fcr_fst_ptrfcr_data_size	equ	fcr_io_start+$200fcr_index_size	equ	fcr_io_start+$400fcr_master_size	equ	fcr_io_start+$600my_pblk_ptr	equ	fst_startmy_vcr_ptr	equ	my_pblk_ptr+4prodos_vcr_ptr	equ	my_vcr_ptr+4my_fcr_ptr	equ	prodos_vcr_ptr+4pro_fcr_ptr	equ	my_fcr_ptr+4gbuf_ptr	equ	pro_fcr_ptr+4temp_ptr	equ	gbuf_ptr+4temp2_ptr	equ	temp_ptr+4temp3_ptr	equ	temp2_ptr+4temp4_ptr	equ	temp3_ptr+4temp5_ptr	equ	temp4_ptr+4math_temp	equ	temp5_ptr+4data_ptr	equ	math_temp+4index_ptr	equ	data_ptr+4master_ptr	equ	index_ptr+4bitmap		equ	master_ptr+4users_buf_ptr	equ	bitmap+4sparse_ptr	equ	users_buf_ptr+4newline_ptr	equ	sparse_ptr+4pro_id		equ	$0001		;identifies prodos fstprodos_version	equ	$0005		;current version of the PRODOS.path1_mask	equ	$4000		;used to determine if path1 is avail.path2_mask	equ	$0040		;used to determine if path2 is avail.carry		equ	$01		;used to set the carryoverflow	equ	$40		;used to set the overflow flagin_cache	equ	$8002user_cache_val	equ	$0001class_mask	equ	$E000disk_protect	equ	$0004		;bit to see if disk is protectedmax_base	equ	$0003pcount1		equ	1pcount2		equ	2pcount3		equ	3pcount4		equ	4pcount5		equ	5pcount6		equ	6pcount7		equ	7pcount8		equ	8pcount9		equ	9write_call	equ	$13read_enabled	equ	$0001		;1=Read Enabledwrite_enabled	equ	$0002		;1=Write Enabledbackup_enabled	equ	$0020		;1=Needs to be backed uprename_enabled	equ	$0040		;1=Rename alloweddestroy_enabled	equ	$0080		;1=Destroy is enabledread_access	equ	$01write_access	equ	$02invis_bit	equ	$04read_write_acc	equ	$03seedling_type	equ	$0010		;$0000000 < EOF < $0000201sapling_type	equ	$0020		;$0000200 < EOF < $0020001tree_type	equ	$0030		;$0020000 < EOF < $1000000pascal_area	equ	$0040		;Area set aside for Pascalresource_type	equ	$0050		;Special type for resource filespurge_dir	equ	$0060		;directory that contains pugred filessubdir_type	equ	$00D0		;Subdirectorysubdir_header	equ	$00E0		;First entry in sudbirectoryvolume_header	equ	$00F0		;First entry in the volume directoryvol_dir_start	equ	$0002		;start of the volume directorybitmap_strt_blk	equ	$0006		;start of the volume bitmapentry_length	equ	$0027entries_per_block equ	$000Dparent_index	equ	$0027par_entry_num	equ	$0029res_header	equ	08		;number of bytes in a headerres_map_size	equ	382		;size of map for info callpurge_index	equ	$0019		;index to flag indicating purge files.purgable_index	equ	$0029		;index to total blockspurge_flag	equ	$00FEpurge_verify	equ	$0004header_file_cnt	equ	$0025		;number of files in a directorybackup_on	equ	$20backup_off	equ	$DFfile_type_index	equ	$10		;look at page 168 (ProDOS 8 manual)key_blk_index	equ	$11		;index into disk entryblks_used_index	equ	$13eof_index	equ	$15create_index	equ	$18version_index	equ	$1Cmin_version	equ	$1Daccess_index	equ	$1Eaux_type_index	equ	$1Flast_mod_index	equ	$21header_ptr_index equ	$25		no_root		equ	$8000		;indicates root level name is invalidno_dup		equ	$4000		;indicates duplicates are not validroot_only	equ	$2000		;allow only the root level in pathnamevol_mod_offset	equ	$16		;offset to the volume mod date fieldvol_acc_offset	equ	$22		;offset to the volume access fielddir_file_type	equ	$0Ftool_locator	equ	$E10000misc_tools	equ	$0003read_time_hex	equ	$000D		;read the clock via misc_toolsset_time_stamp	equ	$0001get_time_stamp	equ	set_time_stamp+$8000set_upper_case	equ	$0002get_upper_case	equ	set_upper_case+$8000debugger_cmnd	equ	$0002debugger_status	equ	debugger_cmnd+$8000file_dirty	equ	$8000		;ora masks to active fielddata_active	equ	$4000index_active	equ	$2000master_active	equ	$1000file_clean	equ	$7FFF		;and masks to deactivate fielddata_inactive	equ	$BFFBindex_inactive	equ	$DFFDmaster_inactive	equ	$EFFEdirEntry_dirty	equ	$0008dirEntry_clean	equ	ÅdirEntry_dirty	;'Å' is the assembler's one's complement operatordata_dirty	equ	$0004data_clean	equ	$FFFBindex_dirty	equ	$0002index_clean	equ	$FFFDmaster_dirty	equ	$0001master_clean	equ	$FFFEhfs_id		equ	$0006		;HFS FST IDashare_id	equ	$000D		;AppleShare FST IDfinfo_type	equ	1		;HFS FInfo entry typexfinfo_type	equ	2		;HFS xFInfo entry type;------------------------------------------;; Equates from procedure data;;------------------------------------------drvr_bytes	equ	$1A		;start at byte $1A and $1Bpath_used	equ	$0100vcr_used	equ	$0200fcr_used	equ	$0400io_used		equ	$0800clr_io_used	equ	$F7FFflush_1st	equ	$1000damage		equ	$2000max_class1	equ	$0020max_class2	equ	$0040max_class3	equ	$0060max_class4	equ	$0080max_class5	equ	$00A0max_class6	equ	$00C0max_class7	equ	$00E0max_pcnt1	equ	1+1max_pcnt2	equ	2+1max_pcnt3	equ	3+1max_pcnt4	equ	4+1max_pcnt5	equ	5+1max_pcnt6	equ	6+1max_pcnt7	equ	7+1max_pcnt8	equ	8+1max_pcnt9	equ	9+1max_pcnt10	equ	10+1max_pcnt11	equ	11+1max_pcnt12	equ	12+1max_pcnt13	equ	13+1max_pcnt14	equ	14+1max_pcnt15	equ	15+1max_pcnt16	equ	16+1max_pcnt17	equ	17+1do_dirty	equ	$4000;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	abs_to_rel		ENTRY	activate_vcr		ENTRY	add_free_blk		ENTRY	add_index		ENTRY	appl_call		ENTRY	bitmap_changed		ENTRY	bitmap_corrupt		ENTRY	build_path		ENTRY	build_the_fcr		ENTRY	build_vcr		ENTRY	calc_curr_mark		ENTRY	change_path		ENTRY	check_base		ENTRY	check_dup		ENTRY	check_vcr_first		ENTRY	chk_allocation		ENTRY	chk_vol_syntax		ENTRY	clear_backup		ENTRY	clear_index		ENTRY	close		ENTRY	clr_fcr_status		ENTRY	clr_to_boundary		ENTRY	cmd_error		ENTRY	cmd_tbl		ENTRY	create		ENTRY	damaged_message			IF debug_on<>0 THEN		ENTRY	debugger	ENDIF		ENTRY	dec_blk_count		ENTRY	deferred_flush		ENTRY	destroy		ENTRY	dev_with_mount		ENTRY	device_call		ENTRY	dow_convert		ENTRY	end_read_write		ENTRY	entry_to_gstr		ENTRY	eof_to_blks		ENTRY	erase_disk		ENTRY	fast_read		ENTRY	fill_io_buf		ENTRY	find_file		ENTRY	find_resource		ENTRY	find_volume		ENTRY	flush		ENTRY	flush_blocks		ENT