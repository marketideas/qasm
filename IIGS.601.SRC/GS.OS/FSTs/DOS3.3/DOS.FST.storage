l in the table expression because it's easier…				;…to read (and to type).	EXPORT dir_cnt	dir_cnt		ds 1	EXPORT dos_type	dos_type	ds 1	EXPORT os_type	os_type		ds 1	EXPORT access	access		ds 1	EXPORT aux_type	aux_type	ds 1	EXPORT eof	eof		ds.l 1	EXPORT blks_used	blks_used	ds 1	EXPORT entry_num	entry_num	ds 1	EXPORT stor_type	stor_type	dc.w storage_type	;keep a copy in memory for fill_param	EXPORT fst_id	fst_id		dc.w my_id		;keep a copy in memory for fill_param	EXPORT null	null		dc.w 0		ENDP