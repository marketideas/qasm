_ptr		longvol_buf_ptr	longfcr_ptr		longold_fcr_ptr	longfcr_buf_ptr	longfcr_name_ptr	longstr1_ptr	longstr2_ptr	longfde_ptr		longnamegen_ptr	wordsrc_scratch	block 0		;shared with ptr1ptr1		longfile_name_ptr	worduser_ptr	longvol_name_ptr	wordnl_list_ptr	longnl_msk		wordnl_char		wordfill_tabl	wordclear_ctr	worddirect_end	block 0		;dummy end marker	if direct_end < $D5 goto .ok	aerror '### ERROR: Direct page storage overflow'.ok	anop			;structures native to the DOS 3.3 disk format		dsect 0		;fde entryfde_ts_link	wordfde_type	bytefde_name	block 30fde_sec_used	wordfde_len		block 0		dsect 0		;track/sector list sector		block 1		;not usedts_link		word		block 2		;not usedts_sec_offset	word		block 5		;not usedts_list_start	block 0		dsect 0		;vtoc		block 1		;not usedvtoc_cat_link	word		;track/sector of 1st directory sectorvtoc_dos_rel	byte		;DOS release number		block 2		;not usedvtoc_vol_num	byte		;volume number		block 32	;spares--not usedvtoc_max_ts	byte		block 8		;not used		block 2		;allocation algorithm bytes		block 2		;not usedvtoc_tracks	byte		;tracks per diskettevtoc_sectors	byte		;sectors per trackvtoc_bytes_sec	word		;number of bytes per sectorvtoc_bitmap	block 0		;start of the vtoc bitmapbase_fde	equ $B		;offset to 1st fde in a catalog sectormax_fde		equ 7		;7 fde's in a catalog sector		;constants used by the fstmy_id		equ 2		;fst idcat_strt_off	equ $100	;offset to 1st catalog sector in the general bufferalpha_len_limit	equ 15		;longest alpha part of generated disk namenamegen_mask	equ $7F		;just in case we don't like some of the bits in ROM namesnamegen_limit	equ $C0		;boundry ASCII value for terminator charactersgen_buf_size	equ $100 * 16	;buffer for 16 disk sectors;vol_buf_size	equ $100 * 2	;buffer for vtoc & 1st catalog sectorfile_buf_size	equ $100 * 2	;buffer for 2 "info" sectorsname_buf_len	equ 50max_cat_sec	equ 15		;maximum # of directory sectors to read inaccess_locked	equ $01		;equivalent GS/OS access value for a locked DOS fileaccess_unlocked	equ $C3		;equivalent GS/OS access value for an unlocked DOS filestorage_type	equ $0001	;GS/OS storage type for all DOS 3.3 filesvol_max_char	equ 20		;maximum number of characters in a volume namefn_max_char	equ 30		;maximum number of characters in a filenamemove_info_be	equ 100		;break-even point for moving bytes by hand rather than…				;…with move_info