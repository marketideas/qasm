######################################################## Rules to build the SCC.Manager driver#{SDdrivers}SCC.Manager	Ä	{SupervisoryDrivers}SCCManager:driver.aii.obj	if "{ListFlag}" || "{TGHListFlag}"		set LnkOptions "-l > {Listings}atalk.lst"	end	linkiigs 	{SupervisoryDrivers}SCCManager:driver.aii.obj ¶			-t	$BB ¶			-at	$0140 ¶			-o	{SDdrivers}SCC.Manager ¶			{LnkOptions}{SupervisoryDrivers}SCCManager:driver.aii.obj	Ä	{SupervisoryDrivers}SCCManager:driver.aii ¶													{SupervisoryDrivers}SCCManager:equates	if "{ListFlag}" || "{TGHListFlag}"		set AsmOptions "-f -l -m -lo {Listings}"	end	asmiigs		{SupervisoryDrivers}SCCManager:driver.aii ¶			-i	{SupervisoryDrivers}SCCManager: ¶			{AsmOptions}