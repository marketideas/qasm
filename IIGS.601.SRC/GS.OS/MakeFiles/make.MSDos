######################################################## Rules to build the MS-DOS FST## Main dependency rules"{SDfsts}"MSDos.FST 	Ä		"{object}"MSDos.obj "{WorkFolder}"MSDos.lib	linkiigs -t $BD						¶#		"{CIIGSLibraries}BankAlign.obj"	¶		"{object}"MSDos.obj 			¶		-lib "{WorkFolder}"MSDos.lib	¶		-o "{SDfsts}"MSDos.FST	 		¶		{LnkOptions}"{WorkFolder}"MSDos.lib	Ä	"{Object}"MSDos.Calls.obj ¶							"{Object}"MSDos.Subs.obj ¶							"{Object}"MSDos.data.obj	Delete -i "{WorkFolder}"MSDos.lib	MakeLibIIGS -l "{WorkFolder}"MSDos.lib -r ¶		"{object}"MSDos.Calls.obj ¶		"{Object}"MSDos.Subs.obj ¶		"{object}"MSDos.data.obj# default rules"{Object}"	Ä	"{MSDos}".obj		Ä	.aii	if "{AsmOptions}" != ""		set tmpAsmOptions "-l -m -lo {Listings}{Default}.lst -pagesize 70"	else		unset tmpAsmOptions	end	AsmIIGS "{MSDos}{Default}.aii" -o "{Object}{Default}.obj" -i "{Common}" {tmpAsmOptions}# include file dependencies"{object}"MSDos.Calls.obj	Ä	"{MSDos}"MSDos.equ ¶								"{MSDos}"MSDos.Data.inc ¶								"{MSDos}"MSDos.Subs.inc"{object}"MSDos.Subs.obj	Ä	"{MSDos}"MSDos.equ ¶								"{MSDos}"MSDos.Data.inc"{Object}"MSDos.obj			¶"{Object}"MSDos.data.obj	Ä	"{MSDos}"MSDos.equ"{MSDos}"MSDos.equ			Ä	"{common}"Common.equ.src "{Common}"hw.equ.src	SetFile -m . "{MSDos}"MSDos.equ