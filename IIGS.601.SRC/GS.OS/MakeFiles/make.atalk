######################################################## Rules to build the ATALK driver#Objects	=	{Drivers}ATALK:main.oii ¶			{Drivers}ATALK:rpm.oii ¶			{Drivers}ATALK:appletalk.oii ¶			{Drivers}ATALK:others.oii{SDdrivers}ATALK	Ä	{Objects}	if "{ListFlag}" || "{TGHListFlag}"		set LnkOptions "-l > {Listings}atalk.lst"	end	linkiigs 	{Objects} ¶			-t	$BB ¶			-at	$0110 ¶			-o	{SDdrivers}ATALK ¶			{LnkOptions}{Drivers}ATALK:main.oii			Ä	{Drivers}ATALK:main.aii{Drivers}ATALK:rpm.oii			Ä	{Drivers}ATALK:rpm.aii{Drivers}ATALK:appletalk.oii	Ä	{Drivers}ATALK:appletalk.aii{Drivers}ATALK:others.oii		Ä	{Drivers}ATALK:others.aii.oii		Ä	.aii	if "{ListFlag}" || "{TGHListFlag}"		set AsmOptions "-f -l -m -lo {Listings}"	end	asmiigs 	{DepDir}{Default}.aii ¶			-i {Drivers}ATALK: ¶			{AsmOptions} ¶			-o	{TargDir}{Default}.oii