## QuickConsole MakeFile## QuickConsole - a permanent init file that speeds up I/O to the .CONSOLE driver#"{SDSetupFiles}"QuickConsole	ÄÄ	"{object}"QuickConsole.obj	if "{ListFlag}"; set LnkOptions "-l > {Listings}QuickConsole.map"; end	LinkIIGS -t  $B6 "{object}"QuickConsole.obj ¶		-o "{object}"QuickConsole {LnkOptions}	Duplicate -y "{object}"QuickConsole "{SDSetupFiles}"QuickConsole"{object}"QuickConsole.obj Ä	"{SetUpFiles}"QuickConsole:QuickConsole.aii ¶								"{common}"Common.equ.src	if "{ListFlag}"; set AsmOptions "-l -m -lo "{Listings}"QuickConsole.lst"; end	ASMIIGS "{SetUpFiles}"QuickConsole:QuickConsole.aii ¶		-o "{object}"QuickConsole.obj -i "{Common}" {AsmOptions}