######################################################## Rules to build the ProDOS FST#AOPTIONS	= -D DEBUGSYMBOLS=0{SDfsts}Pro.FST 	Ä		{object}ProDOS.FST.obj					linkiigs 	{object}prodos.fst.obj 		¶			-t $BD							¶			-o {object}Pro.FST {LnkOptions}	Duplicate -y {object}Pro.FST  {SDfsts}Pro.FST{object}ProDOS.FST.obj		Ä		{ProDOS}ProDOS.FST	¶									{common}common.equ.src		Asmiigs {ProDOS}ProDOS.FST -o {object}ProDOS.FST.Obj -i {common} {AOptions} {AsmOptions}