######################################################## Rules to build the ATINIT file#{SDsetupfiles}ATINIT	Ä	{SetupFiles}ATINIT:atinit.oii	if "{ListFlag}" || "{TGHListFlag}"		set LnkOptions "-l > {Listings}atalk.lst"	end	linkiigs 	{SetupFiles}ATINIT:atinit.oii ¶			-t	$E2 ¶			-at	$0000 ¶			-o	{SDsetupfiles}ATINIT ¶			{LnkOptions}	makebiniigs {SDsetupfiles}ATINIT	setfile -t 'E2  ' -c 'pdos' {SDsetupfiles}ATINIT{SetupFiles}ATINIT:atinit.oii	Ä	{SetupFiles}ATINIT:atinit.aii	if "{ListFlag}" || "{TGHListFlag}"		set AsmOptions "-f -l -m -lo {Listings}"	end	asmiigs		{SetupFiles}ATINIT:atinit.aii ¶			-i	{SetupFiles}ATINIT: ¶			{AsmOptions} ¶			-o	{SetupFiles}ATINIT:atinit.oii