## 21-Apr-92	MSD		Removed the EtherTalk DA from the build.#ETalk			=	{Drivers}ETalk:Both.Etalk.Drivers		Ä	{SDDrivers}ETalk {ETalk}ETBoot{SDDrivers}ETalk		Ä	{ETalk}ETalk.aii.obj	if "{ListFlag}" || "{MSDListFlag}"		set LnkOptions "-l > {Listings}ETalk.map"	end	LinkIIGS {ETalk}ETalk.aii.obj ¶		-t $BB ¶		-at $0213 ¶		-o {SDDrivers}ETalk ¶		{LnkOptions}{ETalk}ETBoot			Ä	{ETalk}ETBoot.obj	if "{ListFlag}" || "{MSDListFlag}"		set LnkOptions "-l > {Listings}ETBoot.map"	end	LinkIIGS {ETalk}ETBoot.obj ¶		-o {ETalk}ETBoot ¶		{LnkOptions}{ETalk}ETalk.aii.obj	Ä	{ETalk}ETalk.aii	if "{ListFlag}" || "{MSDListFlag}"		set AsmOptions "-f -l -m -lo {Listings}"	end	AsmIIGS {ETalk}ETalk.aii ¶		-d NetBoot=0 ¶		{AsmOptions} ¶		-o {ETalk}ETalk.aii.obj{ETalk}ETBoot.obj		Ä	{ETalk}ETalk.aii	if "{ListFlag}" || "{MSDListFlag}"		set AsmOptions "-f -l -m -lo {Listings}ETBoot.lst"	end	AsmIIGS {ETalk}ETalk.aii ¶		-d NetBoot=1 ¶		{AsmOptions} ¶		-o {ETalk}ETBoot.obj