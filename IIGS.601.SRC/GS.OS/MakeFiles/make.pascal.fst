## Dependency rules for Pascal FST...#AOPTIONS	= -D DEBUGSYMBOLS=0{SDfsts}pascal.fst 	Ä {Object}pascal.fst.obj	linkiigs {Object}pascal.fst.obj -t $bd -o {object}pascal.fst {LnkOptions}		duplicate -y  {object}pascal.fst {SDfsts}pascal.fst{Object}pascal.fst.obj Ä {PascalFST}pascal.fst.aii	asmiigs {PascalFST}pascal.fst.aii -o {Object}pascal.fst.obj -i {Common} {AOptions} {AsmOptions}