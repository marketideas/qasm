## This makefile will build the DISPLAY.0 file to be put in the# :System.Tools:AppleTalk folder.  This is a patched version of# the Aristotle Menu Display program to support QuickLogoff and# network booting under GS/OS.## Written by Mark Day## 20-JUn-91 MSD	Fixed build rules for PatchTool so that it will#		build under MPW 3.2.  It will still build under#		earlier versions.AP			=	{NetBoot}AristotlePatch:{SDAppleTalk}display.0	Ä	{AP}display.0 {AP}patch {AP}PatchTool	Duplicate -y -d {AP}display.0 {SDAppleTalk}display.0	{AP}PatchTool {SDAppleTalk}display.0 {AP}patch{AP}patch		Ä	{AP}patch.aii.obj	LinkIIGS -o {AP}patch {AP}patch.aii.obj {LnkOptions}	MakeBinIIGS {AP}patch{AP}patch.aii.obj	Ä	{AP}patch.aii	AsmIIGS {AP}patch.aii {AsmOptions}{AP}PatchTool		Ä	{AP}main.c.o	if "`exists "{CLibraries}CInterface.o"`" && "`exists "{Clibraries}CRuntime.o"`"		Set MyLibs "`quote	"{Libraries}"Stubs.o ¶					"{CLibraries}"CRuntime.o ¶					"{CLibraries}"StdCLib.o ¶					"{CLibraries}"CInterface.o ¶					"{Libraries}"Interface.o`"	else		Set MyLibs "`quote	"{Libraries}"Stubs.o ¶					"{Libraries}"Runtime.o ¶					"{CLibraries}"StdCLib.o ¶					"{Libraries}"Interface.o`"	end	Link -w -t MPST -c "MPS " {AP}main.c.o ¶	{MyLibs} ¶	-o {AP}PatchTool{AP}main.c.o		Ä	{AP}main.c	C {AP}main.c