######################################################## Rules to build the ATResponder file#{SDsetupfiles}ATResponder	Ä	{SetupFiles}ATResponder:atresponder.oii	if "{ListFlag}" || "{TGHListFlag}"		set LnkOptions "-l > {Listings}atalk.lst"	end	linkiigs 	{SetupFiles}ATResponder:atresponder.oii ¶			-t	$B6 ¶			-at	$0000 ¶			-o	{SDsetupfiles}ATResponder ¶			{LnkOptions}{SetupFiles}ATResponder:atresponder.oii	Ä	{SetupFiles}ATResponder:atresponder.aii	if "{ListFlag}" || "{TGHListFlag}"		set AsmOptions "-f -l -m -lo {Listings}"	end	asmiigs		{SetupFiles}ATResponder:atresponder.aii ¶			-i	{SetupFiles}ATResponder: ¶			{AsmOptions} ¶			-o	{SetupFiles}ATResponder:ATResponder.oii