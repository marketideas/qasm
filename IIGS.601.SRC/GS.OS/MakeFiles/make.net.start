## This is the makefile for the :System.Tools:AppleTalk:Start file## It is used in network booting (both diskless and local).## Written by Mark Day## 19-Jun-91 MSD	Modified to use StartLog.aii instead of BootLog16.aii#		since BootLog16 puts its variables in "unused" areas#		of bank 0 (where it assumes it was loaded).Start			=	{NetBoot}Start:Console			=	{NetBoot}Console:Logon			=	{NetBoot}Logon:## Make an Express'ed copy in the SystemDisk folder#{SDAppleTalk}Start	Ä	{Start}Start	Duplicate -y {Start}Start {SDAppleTalk}Start	## Link the Start program from its objects#{Start}Start	Ä	{Start}Start.o ¶				{Console}console.o ¶				{Start}StartLog.o ¶				{Logon}DES.o	If "{ListFlag}" || "{MSDListFlag}"		Set LnkOptions "-l > {Start}Start.map"	End	LinkIIGS -o {Start}Start ¶		{Start}Start.o ¶		{Start}StartLog.o ¶		{Console}Console.o ¶		{Logon}DES.o ¶		{LnkOptions}{Start}Start.o		Ä	{Start}Start.aii ¶				{Start}Start.m ¶				{Console}Cons.Macros ¶				{Console}Console.Equates	If "{ListFlag}" || "{MSDListFlag}"		Set AsmOptions "-f -l -lo {Start}Start.lst"	End	AsmIIGS¶		-i {Console}¶		-o {Start}Start.o¶		{Start}Start.aii¶		{AsmOptions}{Console}Console.o	Ä	{Console}Console.aii ¶				{Console}input.aii ¶				{Console}Strings.aii ¶				{Console}Cons.Macros ¶				{Console}Console.Equates	If "{ListFlag}" || "{MSDListFlag}"		Set AsmOptions "-f -l -lo {Console}Console.lst"	End	AsmIIGS¶		-i {Console}¶		-o {Console}Console.o¶		{Console}Console.aii¶		{AsmOptions}{Start}StartLog.o	Ä	{Start}StartLog.aii ¶				{Logon}logon.main ¶				{Logon}icon.aii ¶				{Console}Cons.Macros ¶				{Console}Console.Equates	If "{ListFlag}" || "{MSDListFlag}"		Set AsmOptions "-f -l -lo {Logon}BootLog16.lst"	End	AsmIIGS¶		-i {Console}¶		-i {Logon}¶		-o {Start}StartLog.o¶		{Start}StartLog.aii¶		{AsmOptions}{Logon}DES.o		Ä	{Logon}DES.aii	If "{ListFlag}" || "{MSDListFlag}"		Set AsmOptions "-f -l -lo {Logon}DES.lst"	End	AsmIIGS¶		-o {Logon}DES.o¶		{Logon}DES.aii¶		{AsmOptions}