######################################################## Rules to build the console driver#{SDdrivers}console.driver Ä 				¶					{object}console.aii.obj			¶					{object}new.dri.patch.obj 	if "{ListFlag}"; set LnkOptions "-l > {Listings}console.sym"; end	linkiigs 			 					¶					{object}console.aii.obj 		¶					{object}new.dri.patch.obj 		¶		-t $bb									¶		-at $0101								¶		-o {object}console.driver {LnkOptions}	duplicate -y  {object}console.driver {SDdrivers}console.driver{object}console.aii.obj		Ä		{drivers}Console.driver:console.aii		¶									{Drivers}Console.Driver:Direct.Page.aii	¶									{common}common.equ.src 	if "{ListFlag}"; set AsmOptions "-l -m -lo {Listings}Console.aii.lst"; end	asmiigs {drivers}Console.driver:console.aii ¶		-d Library=0					# produce non-library version	¶		-o {object}Console.aii.obj ¶		-i {common} {AsmOptions}	{object}new.dri.patch.obj	Ä		{drivers}Console.driver:new.dri.patch	¶									{Drivers}Console.Driver:Direct.Page.aii	¶									{common}common.equ.src 	if "{ListFlag}"; set AsmOptions "-l -m -lo {Listings}New.Dri.Patch.lst"; end	asmiigs {drivers}Console.driver:new.dri.patch ¶		-o {object}new.dri.patch.obj -i {common} {AsmOptions}		