########################################################  7-Jan-91	MSD	Changed auxtype from $0201 to $0203 so this file will load#				on a ROM 03.  This makes it easy to try out some fixes to#				NBP and ATP.  Later, I'll have to come up with a way not#				to patch out all of ROM 03 (since things like LAP and DDP#				work fine).##  6-Feb-91	MSD	Changed auxtype back to $0201 for 6.0 builds.## 25-Jun-91 MSD	Changed auxtype to $0204 so it will load on all CPU's#				(so I can test out some fixes more easily).######################################################### Rules to build the ATP1.ATROM driver#Objects		=	{Drivers}ATROM:atp_includes.oii ¶				{Drivers}ATROM:lap_includes.oii ¶				{Drivers}ATROM:aptalk.oii ¶{SDdrivers}ATP1.ATROM	Ä	{Objects}		if "{ListFlag}" || "{MSDListFlag}"		set LnkOptions "-l > {Listings}atrom.map"	end	linkiigs 	{Objects} ¶			-t	$BB ¶			-at	$0204 ¶			-o	{SDdrivers}ATP1.ATROM ¶			{LnkOptions}{Drivers}ATROM:atp_includes.oii		Ä	{Drivers}ATROM:atp_includes.aii{Drivers}ATROM:lap_includes.oii		Ä	{Drivers}ATROM:lap_includes.aii{Drivers}ATROM:aptalk.oii			Ä	{Drivers}ATROM:aptalk.aii.oii		Ä	.aii	if "{ListFlag}" || "{MSDListFlag}"		set AsmOptions "-f -l -m -lo {Listings}"	end	asmiigs 	{DepDir}{Default}.aii ¶			-i {Drivers}ATROM: ¶			-w ¶			{AsmOptions} ¶			-o	{TargDir}{Default}.oii