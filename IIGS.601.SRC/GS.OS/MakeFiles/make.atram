######################################################## Rules to build the ATP2.ATRAM driver### 11-Jun-91 MSD	Changed auxtype from $0203 to $0204 so this#				file will get loaded on Mark Twain (ROM 4).#				Also made the driver dependent on the makefile.## 24-Jun-91	MSD	Added dependencies for several files included by#				sp.includes.aii and the PFI files.Objects		=	{Drivers}ATRAM:header.oii¶				{Drivers}ATRAM:atpatch:atpatch.oii¶				{Drivers}ATRAM:atpatch:pap:pap.oii¶				{Drivers}ATRAM:atpatch:rpm:rpm.oii¶				{Drivers}ATRAM:atpatch:zip:zip.oii¶				{Drivers}ATRAM:atpatch:asp:sp_includes.oii¶				{Drivers}ATRAM:atstart:atstart.oii¶				{Drivers}ATRAM:pfi:pfi.oii¶				{Drivers}ATRAM:pfi:pfi_cmds.oii¶				{Drivers}ATRAM:pfi:pfi_cmds2.oii¶				{Drivers}ATRAM:pfi:pfi_cmds3.oii¶				{Drivers}ATRAM:pfi:pfi_cmdsubs1.oii¶				{Drivers}ATRAM:pfi:pfi_cmdsubs2.oii¶				{Drivers}ATRAM:pfi:pfi_cmdsubs3.oii¶				{Drivers}ATRAM:pfi:pfi_cmdsubs4.oii¶				{Drivers}ATRAM:pfi:pfi_cmdsubs5.oii¶				{Drivers}ATRAM:pfi:pfi_cmdsubs6.oii¶				{Drivers}ATRAM:pfi:pfi_vars.oii	{SDdrivers}ATP2.ATRAM	Ä	{Objects}	{MakeFiles}make.atram	if "{ListFlag}" || "{MSDListFlag}"		set LnkOptions "-l > {Listings}atram.map"	end	linkiigs 	{Objects} ¶			-t	$BB ¶			-at	$0204 ¶			-o	{SDdrivers}ATP2.ATRAM ¶			{LnkOptions}{Objects}	Ä	{Drivers}ATRAM:atpatch:ASP:atp.equates.inc ¶				{Drivers}ATRAM:atpatch:ASP:global.equates.inc{Drivers}ATRAM:header.oii			Ä		{Drivers}ATRAM:header.aii{Drivers}ATRAM:atpatch:atpatch.oii	Ä		{Drivers}ATRAM:atpatch:atpatch.aii{Drivers}ATRAM:atpatch:pap:pap.oii	Ä		{Drivers}ATRAM:atpatch:pap:pap.aii{Drivers}ATRAM:atpatch:rpm:rpm.oii	Ä		{Drivers}ATRAM:atpatch:rpm:rpm.aii{Drivers}ATRAM:atpatch:zip:zip.oii	Ä		{Drivers}ATRAM:atpatch:zip:zip.aii{Drivers}ATRAM:atpatch:asp:sp_includes.oii Ä {Drivers}ATRAM:atpatch:asp:sp_includes.aii ¶											{Drivers}ATRAM:atpatch:asp:sp.equates.inc ¶											{Drivers}ATRAM:atpatch:asp:sp_asm.aii ¶											{Drivers}ATRA