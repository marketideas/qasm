## This MakeFile will build the AppleShare FST for GS/OS.## It is designed to be used by the GS/OS team's "build" script# for building the various GS/OS files.  It assumes that the GS/OS# variables are set.## The file AppleShare.FST will be placed in {SDfsts}.### Modification history:## 10-Jan-89	MSD	First try.# 19-Jan-89	MSD	Added support for listings.# 22-Feb-90	MSD	Moved Set for LnkOptions and AsmOptions to#			a false target so they will be set only once,#			at the beginning of the build.# 30-Apr-90	MSD	Moved the Set for LnkOptions and AsmOptions#			back to the default rules.  Since they we the#			root, they were getting executed AFTER the AsmIIGS#			and LinkIIGS (could fix that by making them depen-#			dencies for each object file).  Anyway, Mensch#			doesn't want ANY commands output if there are no#			changes (so I can't use false targets).# 05-Feb-91	MSD	Added the JudgeName.aii source file.### Define some variables for my directories#src		=	{ASFST}src:obj		=	{ASFST}obj:lst		=	{ASFST}list:## First, define all of the objects that need to be linked.#objects		=	{obj}header.o ¶			{obj}volume.o ¶			{obj}getdevnum.o ¶			{obj}create.o ¶			{obj}destroy.o ¶			{obj}clearbackup.o ¶			{obj}getinfo.o ¶			{obj}setinfo.o ¶			{obj}changepath.o ¶			{obj}open.o ¶			{obj}close.o ¶			{obj}volmod.o ¶			{obj}flush.o ¶			{obj}mark.o ¶			{obj}eof.o ¶			{obj}read.o ¶			{obj}write.o ¶			{obj}getdir.o ¶			{obj}specific.o ¶			{obj}time.o ¶			{obj}subs.o ¶			{obj}FindPath.o ¶			{obj}sendpacket.o ¶			{obj}JudgeName.o ¶			{obj}data.o## The SystemDisk copy is an expressed copy of my local build#{SDfsts}AppleShare.FST	Ä	{ASFST}AppleShare.FST	duplicate -y {ASFST}AppleShare.FST {SDfsts}AppleShare.FST## The FST depends on all of its object files....#{ASFST}AppleShare.FST	 Ä	{objects}	If "{ListFlag}" || "{MSDListFlag}"		Set LnkOptions "-l > {lst}link.lst"	End	LinkIIGS ¶		-t $BD -at 0 ¶		-o {ASFST}AppleShare.FST ¶		{objects} ¶		{LnkOptions}## Almost all of the object files include the equates.dump# file, so rebuild them all if the equates file changes.## Currently, the only object file that does NOT depend on# the equates file is data.o since equates imports some# of the data fields from data.#{objects}		Ä	{obj}equates.dump## Generic rule for assembling a file (turning xxx.aii into xxx.o)#{obj}			Ä	{src}.o			Ä	.aii	If "{ListFlag}" || "{MSDListFlag}"		Set AsmOptions "-f -l -lo {lst}"	End	AsmIIGS ¶		-i {obj} ¶		-o {TargDir}{Default}.o ¶		{DepDir}{Default}.aii ¶		{AsmOptions}## Rule for building the equates.dump file#{obj}equates.dump	Ä	{src}equates.aii	If "{ListFlag}" || "{MSDListFlag}"		Set AsmOptions "-f -l -lo {lst}"	End	Set YeOldeDirectory "`Directory`"	Directory {ASFST}	AsmIIGS ¶		-o :obj:equates.o ¶		:src:equates.aii ¶		{AsmOptions}	Delete -i :obj:equates.o	Directory "{YeOldeDirectory}"