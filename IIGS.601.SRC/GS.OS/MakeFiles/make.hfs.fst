## Dependency rules for HFS FST...#AOPTIONS	= -D DEBUGSYMBOLS=0{SDfsts}hfs.fst 	Ä {Object}hfs.fst.main.obj {Object}hfs.fst.btree.obj	linkiigs {Object}hfs.fst.main.obj {Object}hfs.fst.btree.obj -t $bd -o {object}hfs.fst {LnkOptions}		duplicate -y  {object}hfs.fst {SDfsts}hfs.fst{Object}hfs.fst.main.obj Ä {HFS}hfs.fst.main {HFS}hfs.fst.equ	asmiigs {AOptions} {HFS}hfs.fst.main -o {Object}hfs.fst.main.obj -i {Common} -unsafe -wi #-l -m -lo {Listings}hfs.fst.main.lst{Object}hfs.fst.btree.obj Ä {HFS}hfs.fst.btree {HFS}hfs.fst.equ	asmiigs {AOptions} {HFS}hfs.fst.btree -o {Object}hfs.fst.btree.obj -i {Common} -unsafe -wi #-l -m -lo {Listings}hfs.fst.btree.lst