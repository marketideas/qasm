######################################################## Rules to build the ATBOOT driver#{SDAppleTalk}Boot.Driver	Ä	{Drivers}ATBOOT:atboot.aii.obj	if "{ListFlag}" || "{TGHListFlag}"		set LnkOptions "-l > {Listings}atalk.lst"	end	linkiigs 	{Drivers}ATBOOT:atboot.aii.obj ¶			-t	$BB ¶			-at	$0181 ¶			-o	{SDAppleTalk}Boot.Driver ¶			{LnkOptions}{Drivers}ATBOOT:atboot.aii.obj	Ä	{Drivers}ATBOOT:atboot.aii ¶									{Drivers}ATBOOT:equates	if "{ListFlag}" || "{TGHListFlag}"		set AsmOptions "-f -l -m -lo {Listings}"	end	asmiigs		{Drivers}ATBOOT:atboot.aii ¶			-i	{Drivers}ATBOOT: ¶			{AsmOptions}