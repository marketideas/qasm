;==========================================================;;  file cons.lib.patch;;  This file must be linked in if we are building the;  universal library version of the console driver.;;  There is a similar file which is used for the GS/OS;  device driver.;;  Author:      Andy Stadler;  Created:     09-Feb-88;  Modified:    See modification history below.;;  Copyright Apple Computer, Inc.  1988;  All rights reserved.;;==========================================================;;  Modification history:;;  09-Feb-88    ADS     Created.;;==========================================================		EXPORT	cons_lib_patch  cons_lib_patch  PROC*               using   common_equ                longa   on                longi   on;==========================================================;;  start_patch;  shutdown_patch;;  We will be using the memory manager, so we need an ID.;;==========================================================		EXPORT	start_patchstart_patch		;		                pha                     ; result space                pea     $6000           ; type=lib, auxID=0                ldx     #$2003          ; GetNewID                jsl     $E10000                pla                sta     >patch_id                rts		EXPORT	shutdown_patchshutdown_patch		;		                lda     >patch_id                pha                ldx     #$2103          ; deleteID                jsl     $E10000                rtspatch_id	DC.W	0	; store the patch here                eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  jsr call_alloc       (replaces jsl alloc_seg);  jsr call_deref       (replaces jsl deref);  jsr call_release     (replaces jsl release_seg);;  These are glue routines to simulate GS/OS device service;  calls.  For example, a GS/OS driver gets memory by jsl alloc_seg;  and returns a VP in X and Y.  Here we'll use the memory;  manager.  And so forth for the other calls.;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -		EXPORT	call_alloccall_alloc		;		; X,Y = call_alloc(a=size, C=clear)                pha                     ; long result                pha                pea     $0000           ; size is < 64k                pha                lda     >patch_id                pha                pea     $0000           ; no restrictions                pha                     ; address ignored                pha                ldx     #$0902          ; NewHandle                jsl     $E10000                plx                     ; get handle into X and Y                ply                rts		EXPORT	call_derefcall_deref		;		; X,Y = deref (X,Y)                phd                     ; in this case just deref handle                phy                phx                tsc                tcd                lda     [<1]                tax                ldy     #2                lda     [<1],y                tay                pla                pla                pld                rts		EXPORT	call_releasecall_release		;		; release_seg(X,Y)                phy                phx                ldx     #$1002          ; DisposeHandle                jsl     $E10000                rts		ENDP		end