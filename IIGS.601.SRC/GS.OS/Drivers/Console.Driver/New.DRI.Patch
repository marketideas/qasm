hd                lda     <drvr_parm_ptr                tcd                jsl     deref                pld                rts		EXPORT	call_releasecall_release				; (preserves X and Y)                phd                lda     <drvr_parm_ptr                tcd                jsl     release_seg                pld                rts		ENDP		end		