		pagesize 70		string	asis		blanks	off* change the following equate to change the version number of the driverVersNum		equ	$3040			;version 3.4 final		print	push		print	off; - - - - - - - - - - - - - - - - - - -; Event Manager Macros; - - - - - - - - - - - - - - - - - - - 		MACRO&lab		_EMStatus&lab		LDX	#$0606		JSL	$E10000		MEND		MACRO&lab		_GetNextEvent&lab		LDX	#$0A06		JSL	$E10000		MEND; - - - - - - - - - - - - - - - - - - -; Miscellaneous Macros; - - - - - - - - - - - - - - - - - - -;----------------------------------------------------;; mode_8;; Does a sep instruction to set m and x, and does; longa off and longi off.;;----------------------------------------------------		MACRO&lab		mode_8&lab		SEP	#$30		LongA	Off		LongI	Off		MEND;----------------------------------------------------;; mode_16;; Does a rep instruction to clear m and x, and does; longa on and longi on.;;----------------------------------------------------		MACRO&lab		mode_16&lab		REP	#$30		LongA	On		LongI	On		MEND;----------------------------------------------------;; Long  --  Short;; Does a LongA and LongI ON (Long) or OFF (Short);;----------------------------------------------------		MACRO&lab		Long&lab				LongA	On		LongI	On		MEND		MACRO&lab		Short&lab				LongA	Off		LongI	Off		MEND		include	'common.equ.src' 		;------------------------------------------;; Equates from procedure hw_equ;;------------------------------------------cswl		equ	$000036		;character output hookcswh		equ	$000037		kswl		equ	$000038		;character input hook  kswh		equ	$000039		mslot		equ	$0007f8		;=$cn ;n=slot using $c800mnemstkptr	equ	$010100		;main stack pointer alemstkptr	equ	$010101		;alternate stack pointer oswmstrt	equ	$0003d0		;quitmon jumps here brkv		equ	$0003f0		;vectors here after break  softev		equ	$0003f2		;vector for warm start pwredup		equ	$0003f4		;this must = eor #$a5 of softev+1  amperv		equ	$0003f5		;applesoft & exit vector usradr		equ	$0003f8		;applesoft usr function vector  nmi		equ	$0003fb		;nmi vector  irqloc		equ	$0003fe		;maskable interrupt vector  pro8mli		equ	$00bf00		;address of prodos8 mli entry pointioadr		equ	$c000		;all i/o is at $cxxxkbd		equ	$c000		;bit 7=1 if keystroke  clr80col	equ	$c000		;disable 80 column store  set80col	equ	$c001		;enable 80 column store  rdmainram	equ	$c002		;read from main 48k ram  rdcardram	equ	$c003		;read from alt. 48k ram  wrmainram	equ	$c004		;write to main 48k ram  wrcardram	equ	$c005		;write to alt. 48k ram  setslotcxrom	equ	$c006		;use roms on cards setintcxrom	equ	$c007		;use internal rom setstdzp	equ	$c008		;use main zero page/stack  setaltzp	equ	$c009		;use alt. zero page/stack  setintc3rom	equ	$c00a		;enable internal slot 3 rom setslotc3rom	equ	$c00b		;enable external slot 3 rom clr80vid	equ	$c00c		;disable 80 column hardware  set80vid	equ	$c00d		;enable 80 column hardware  clraltchar	equ	$c00e		;normal lc, flashing uc  setaltchar	equ	$c00f		;normal inverse, lc ; no flash  kbdstrb		equ	$c010		;turn off key pressed flag  rdlcbnk2	equ	$c011		;bit 7=1 if LC bank 2 is in  rdlcram		equ	$c012		;bit 7=1 if LC ram read enabled  rdramrd		equ	$c013		;bit 7=1 if reading alt 48k rdramwrt	equ	$c014		;bit 7=1 if writing alt 48k  rdcxrom		equ	$c015		;bit 7=1 if using int romrdaltzp		equ	$c016		;bit 7=1 if slot zp enabled rdc3rom		equ	$c017		;bit 7=1 if slot c3 space enabled rd80col		equ	$c018		;bit 7=1 if 80 column store    rdvblbar	equ	$c019		;bit 7=1 if not vbl  rdtext		equ	$c01a		;bit 7=1 if text (not graphics)  rdmix		equ	$c01b		;bit 7=1 if mixed mode on rdpage2		equ	$c01c		;bit 7=1 if txtpage2 switched in  rdhires		equ	$c01d		;bit 7=1 if hires is on altcharset	equ	$c01e		;bit 7=1 if alternate char set in use rd80vid		equ	$c01f		;bit 7=1 if 80 column hardware in  vgcint		equ	$c023		;vgc interrupt register keymodreg	equ	$c025		;key modifier register datareg		equ	$c026		;data register in keyglu chip kmstatus	equ	$c027		;keyboard/mouse status register sltromsel	equ	$c02d		;slot rom select spkr		equ	$c030		;clicks the speakerdiskreg		equ	$E1C031		;used for 3.5" disk drives shadow		equ	$c035		;shadow register cyareg		equ	$c036		;speed and motor on detect inten		equ	$c041		;interrupt enable register intflag		equ	$c046		;interrupt flag registerclrvblint	equ	$c047		;clear the vbl and 3.75hz interrupt flags txtclr		equ	$c050		;switch in graphics (not text)txtset		equ	$c051		;switch in text (not graphics)  mixclr		equ	$c052		;clear mixed-mode  mixset		equ	$c053		;set mixed-mode (4 lines text)  txtpage1	equ	$c054		;switch in text page 1  txtpage2	equ	$c055		;switch in text page 2  lores		equ	$c056		;low-resolution graphics  hires		equ	$c057		;high-resolution graphics  setan0		equ	$c058		;clear annunciator 0 clran0		equ	$c059		;set annunciator 0 setan1		equ	$c05a		;clear annunciator1 clran1		equ	$c05b		;set annunciator 1 setan2		equ	$c05c		;clear annunciator 2 clran2		equ	$c05d		;set annunciator 2 setan3		equ	$c05e		;clear annunciator 3 clran3		equ	$c05f		;set annunciator 3 butn3		equ	$c060		;read switch 3 butn0		equ	$c061		;open apple key butn1		equ	$c062		;closed apple key butn2		equ	$c063		;read switch 2 statereg	equ	$c068		;state register romin		equ	$c081		;enable rom read, 2 reads write enb LC ram lcbank2		equ	$c083		;sel LC ram bank2, 2 rds wrt enb LC ram lcbank1		equ	$c08b		;sel LC ram bank1, 2 rds wrt enb LC ramclrrom		equ	$cfff		;switch out $c8 roms  mtn		equ	$03		;miscellaneous tool number rthfn		equ	$0d		;read time hex function number wthfn		equ	$0e		;write time hex function number mmn		equ	$02		;memory manager tool number initdismgr	equ	$fe0000		;init dispatch handler (tool locator)brambuffer	equ	$e102c0		;image of batteryramosvariables	equ	brambuffer+$80+$01 ;32 bytes of operating system varidispatch1	equ	$e10000		;jmp vector to tool locator1 dispatch2	equ	$e10004		;jmp vector to tool locator2 udispatch1	equ	$e10008		;jmp vector to user's tool locator1 udispatch2	equ	$e1000c		;jmp vector to user's tool locator2 intmgrv		equ	$e10010		;jmp vector to interrupt manager copmgrv		equ	$e10014		;jmp vector to cop manager abortmgrv	equ	$e10018		;jmp vector to abort manager sysdmgrv	equ	$e1001c		;jmp vector to system death manager irq_aptlk	equ	$e10020		;jmp vector to aptlk interrupt handler irq_serial	equ	$e10024		;jmp vector to serial port int handler irq_scan	equ	$e10028		;jmp vector to scan line interrupt handler irq_sound	equ	$e1002c		;jmp vector to sound interrupt handler irq_vbl		equ	$e10030		;jmp vector to vbl interrupt handler irq_mouse	equ	$e10034		;jmp vector to mouse interrupt handler irq_qtr		equ	$e10038		;jmp vector to 1/4 sec interrupt handler irq_kbd		equ	$e1003c		;jmp vector to keyboard interrupt handler irq_response	equ	$e10040		;jmp vctr to fdb response byte int handler irq_srq		equ	$e10044		;jmp vector to srq int handler irq_dskacc	equ	$e10048		;jmp vector to desk accessory int handler irq_flush	equ	$e1004c		;jmp vector to flush buffer int handler irq_micro	equ	$e10050		;jmp vector to key micro int handler irq_1sec	equ	$e10054		;jmp vector to 1 second interrupt handler irq_ext		equ	$e10058		;jmp vector to ext vgc interrupt handler irq_other	equ	$e1005c		;jmp vector to other interrupt handler cupdate		equ	$e10060		;jmp vector to cursor update handler incbusyflg	equ	$e10064		;jmp vector to increment busyflag routine decbusyflg	equ	$e10068		;jmp vector to decrement busyflag routine pro16mli	equ	$e100a8		;1st os vector is prodos16 mli entry poios_switch	equ	$e100ac		;called before application launch stkpro16mli	equ	$e100b0		;stack based entry to prodos16os_internal	equ	$e100b4		;internal calls from fst to fst manageros_reserved	equ	$e100b8		;2 bytes reserved for oszero_word	equ	$e100ba		;guaranteed 2 zeros os_kind		equ	$e100bc		;0/1-p8/p16 current os running os_boot		equ	$e100bd		;0/1-p8/p16 booted os os_flag		equ	$e100be		;word for prodos 16 flags ph0off		equ	$E1C080		; phase 0 offph0on		equ	$E1C081		; phase 0 onph1off		equ	$E1C082		; phase 1 offph1on		equ	$E1C083		; phase 1 onph2off		equ	$E1C084		; phase 2 offph2on		equ	$E1C085		; phase 2 onph3off		equ	$E1C086		; phase 3 offph3on		equ	$E1C087		; phase 3 onmotor_off	equ	$E1C088		; disk motor offmotor_on	equ	$E1C089		; disk motor ondrive0		equ	$E1C08A		; select drive 0drive1		equ	$E1C08B		; select drive 1q6l		equ	$E1C08C		; Q6 lowq6h		equ	$E1C08D		; Q6 highq7l		equ	$E1C08E		; Q7 lowq7h		equ	$E1C08F		; Q7 high;------------------------------------------;; Equates from procedure console_equ;;------------------------------------------max_commands	equ	drvr_shutdn	; max driver commandmax_stat	equ	drvr_get_format	; max normal statusmax_cont	equ	drvr_insert	; max normal controlmax_spec_stat	equ	$8007		; Largest legal call numbermax_spec_cont	equ	$8007		; Largest legal call number;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		IMPORT	call_alloc		IMPORT	call_deref		IMPORT	call_release		IMPORT	shutdown_patch		IMPORT	start_patch;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	dib_1		ENTRY	the_console		;-----------------------------------------------;Console errorsadd_trap_failed	equ	$32		print	pop		Eject;******************************************************************************;*                                                                            *;*                 Console Driver Routines for the Apple //gs                 *;*                                                                            *;*      Copyright Apple Computer Inc., 1985-1988      All Rights Reserved     *;*____________________________________________________________________________*;*                                                                            *;*      Written by Andy Stadler                                               *;*                                                                            *;*      Based on work by Neal Johnson, Lou Infeld, and Jay Schaffer           *;*                                                                            *;******************************************************************************;;  Modification history:;;  01-Feb-88    ADS     Initial release 0.01 a01;  08-Feb-88    ADS     removed clr_mixed_mode softswitch hit;                       added >set80col on status & control calls;                       second release 0.02 a01;  09-Feb-88    ADS     removed call_alloc, call_deref, etc;                       (they are now in a separately linked module);                       And added start_patch and shutdown_patch calls.;  10-Feb-88    ADS     added rmv_curs_time to shutdown call;;  03-jun-88	RT	Changed default input mode to raw read.;;  27-jun-88	RT	Fixed a bug in the read routine.  It was;			Not using the termintor list;;  29-jun-88	RT	Changed the status word to include the online bit;;  13-Jul-88	RT	Fixed a bug in Kill_Port_Chain.  The routine;			Was using a temp word as a temp long. So;			I changed dp_temp_2 (Word) to dp_temp_1 (Long);;  19-Jul-88	RT	Fixed a bug in Set_UIR_Port and Get_UIR_Port;			Several fields were left out of the save buffer;;  20-Jul-88	RT	Fixed a bug in the UIR.  The allow control ;			character flag was not working correctly;;  21-Jul-88	RT	Fixed a bug in set wait/no-wait mode.  The;			count routine would transfer upto 6 bytes;			when only two are valid.;;			Fixed a bug in the read routine.  The ;			terminators were not working.;;  01-Aug-88	RT	Fixed the 40 col. switch routine;;  08-Aug-88	RT	Fixed the read routine.  In no wait mode ;			the label "Check_immed" could be called in;			8 or 16 bit mode.  So it would fail;;  12-Jan-89	RT	Fixed a bug in the restore_port routine.;  		Bug #1	The routine did not handle a request of;			zero bytes.;;;  02-Feb-89	RT	Fixed a bug in the restore_port routine;			The routine did not check if the width;			or length was zero.;;  13-Feb-89	RT	Fixed a bug in the read routine.  The 255;			terminator was not being used.;;  20-Feb-89	RT	Added Add_trap and Remove_trap routines;			to the console driver.;;  23-Feb-89	RT	Fixed bug with save screen.  The save;			screen routine was saving data from;			bank zero and one, when it should have;			been using bank $E0 and $E1.;;  08-Mar-89	RT	Added restartable BIT to the console;			driver.;;  10-Apr-89	RT	Invalid Control Calls now return an Error;;  27-Apr-89	RT	Fixed Status Code 3 error code. (error);;  10-May-89	RT	Fixed Status Code 3 error code. (No-Error);			Note: Testing cannot make up their mind!;;  22-Jul-89	RT	Made user input routine work via a signal;			handler;;  25-Aug-89	GB	Set bit in characteristics word to prevent;			D_Rename (fixed name);;  20-Dec-89	GB	Added conditional assembly to user input routine;			so that if this is being assembled to be used;			as a library (like the Exerciser does), the;			signal handler is not called like it is;			for the OS driver.  The portion of code that;			is assembled for the library version is a;			duplicate of the code used for System Disk 5.0.;;  31-Jan-90	GB	Fixed BRC #54395.  The User Input Read routine;			was not updating the GS/OS direct page;			transfer_count field during the call.  During;			investigation, it was noticed that the raw;			read routine had the same problem.  Both;			routines have been fixed.;;  23-Feb-91	GB	Removed some dead code that I discovered in;			  scroll_copy.  It looked like it was left over;			  from a previous version of the routine.;			Since the UIR Read call is now handled via a GS/OS;			  signal, the actual read doesn't happen until;			  SCM dispatches to the signal handler during the;			  call exit process.  This precludes using the;			  UIR while a GS/OS call is currently being;			  handled (like during a Format call).  I've fixed;			  this so that the call will be handled with the;			  signal handler only if the GS/OS call number;			  on direct page is an FST read ($0010 or $2010),;			  or a DRead.  All other read requests will be;			  handled like they were prior to Rob's change.;			Raw read mode now updates the exitType, lastChar,;			  lastMod, lastTermChar, and lastTermMod fields;			  of the InputPortRec as you'd expect it to.  (The;			  remaining fields of the InputPortRec have no;			  meaning during a raw read.);;  14-May-91	GB	Fixed UIR so that if a read call is already buffered;			  up in the signal queue, any subsequent read requests;			  are handled immediately.;;  03-Jun-91	GAB	Modified entry code to use a page-aligned direct page;			  at absolute page 2 in memory ($00/0200).;			Convert direct page label definitions into a data template;			  for ease of maintenance.;			Added device-specified GetVectors status call, and single-;			  character I/O support subroutines.;			Removed code in main entry dispatcher that zeros out the;			  transfer count on direct page, since the Device Dispatcher;			  does it prior to calling the driver.;; 25-Jul-91	GAB	Altered action of UIR so that if input is happening on the;			  last line of the textport, the driver will support;			  scrolling of the field if the cons_scroll flag allows it.;			Changed input_bell to use SysBeep2 Bad Keypress code.;			Changed add_to_str to use SysBeep2 InputFieldFull code when;			  no more characters can be added to input string.;			Minor code optimizations throughout.;; 11-Sep-91	GAB	In do_delete, we now decrement the input_length AFTER;			  calling wr_part_string to allow wr_part_string to;			  overwrite the last string character with the fill;			  character.;; 18-Oct-91	GAB	Reverted direct page handling back to original style;			  (borrowing space from stack) for library version;			  of driver.;; 09-Dec-91	GAB	Added logic in call dispatcher to save the current;			  state of the HIRES softswitch and restore it after;			  handling the call.  This is done so that we can;			  explicitly turn OFF the softswitch so that when;			  the driver is flipping back and forth between main;			  and aux display memory, the hires buffer isn't;			  accidently switched back and forth as well.  This;			  could cause problems if the stack and/or direct;			  page happen to be within the bank 0 hires buffer.;; 10-Jan-92	GAB	Fix in ed_restart.  When Ctrl-Z is used during UIR input,;			  and the default string is shorter than the length of;			  the string typed in so far, the portion of the old;			  string beyond the end of the default string is not;			  cleared from the screen.  Fixed by saving the original;			  string length prior to restoring the default string;			  and using the original length for the screen update.;			  The new length is then restored.;; === for 6.1 ===;; 11-Mar-92	DAL	Fixed remove_trap to store the correct default addresses.;			Version 3.4alpha.;;  2-Apr-93 	SS	Version 3.4 ($3040) for 6.0.1 (final);;;================================================================;Revisions		eject****************************************************************************************************** Console driver direct page definition** Defined as a decrementing template so that the driver will use as* little of page 2 as possible*****************************************************************************************************my_dp		equ	$0200		; absolute page 2		include	'Direct.Page.aii'		Eject;==========================================================;;  Header area.  This is the stuff which tells the world;  that we are a driver.;;==========================================================		EXPORT	driver_data	driver_data	PROC		EXPORT	herehere		DC.W	dib_1-here	; offset to 1st (only) DIB		DC.W	1		; 1 device (the console)		DC.W	ctrl_1-here	; offset to control listctrl_1		DC.L	0default_1	DC.L	0		EXPORT	dib_1dib_1		DC.L	0		; link pointer		DC.L	the_console	; entry pointer; device characteristics word		DC.W	%0000111101100000;			 |||||||||||||||Reserved;			 ||||||||||||||Reserved;			 |||||||||||||Media removeable;			 ||||||||||||Format allowed;			 |||||||||||Reserved;			 ||||||||||Read allowed;			 |||||||||Write allowed;			 ||||||||Block device;			 |||||||Speed Group (lsb);			 ||||||Speed Group (msb);			 |||||Fixed Name;			 ||||Restarable;			 |||Device busy;			 ||Linked;			 |Generated;			 RAM or ROM disk		DC.L	0		; block ct		string	Pascal		DC.B	'CONSOLE'	; name (with a leading length byte)		string	AsIs		dcb.b	31-&len('CONSOLE'),' '		; padded to 31 chars		DC.W	$8003		; no slot rsrcs, internal 3		DC.W	1		; unit 1		DC.W	VersNum		; version number		DC.W	$000A		; console		DC.W	0		; no links		DC.W	0		DC.W	0		; reserved fields		DC.W	0		DC.W	0		; dib device #		DC.W	0		; internal device #		ENDP		Eject****************************************************************************************************** the_console - main entry point for the console driver*****************************************************************************************************the_console	PROC	Export		with	direct_pagetrap_vector	jsl	our_rtl		jmp	text_driver		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  Cons.data;;  Data areas for the GS/OS console driver.;;  Copyright (C) 1987 Apple Computer, Inc.;  All Rights Reserved.;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  Modification History:;;  10-Aug-87    Most variables renamed to GS/OS standards;  16-Sep-87    complete re-work with console re-write;  14-Jan-88    cursor positions (ch, cv) swapped;  23-Jan-88    dp storage removed.  extra status bytes added;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; GLOBALS;exit_temp	DS.B	2exit_flag	DS.B	2cons_call_number DS.B	2dle_save	DC.B	$FFlf_save		DC.B	$FF;; Output routine status block;; These values can not be set by the users.  They can only be read.;cons_stat_blk				; ; Console Status Blockch		DS.B	1		; Cursor horizontalcv		DS.B	1		; Cursor verticalwnd_left	DS.B	1		; Window leftwnd_top		DS.B	1		; Window topwnd_right	DS.B	1		; Window rightwnd_bottom	DS.B	1		; Window bottomwnd_width	DS.B	1		; Window widthwnd_length	DS.B	1		; Window lengthcons_wrap	DS.B	1		; Console wrap flagcons_advance	DS.B	1		; Console cursor advance flagcons_lf		DS.B	1		; Console linefeed flagcons_scroll	DS.B	1		; Console scroll flagcons_video	DS.B	1		; Console video flagcons_dle	DS.B	1		; Pascal text DLE expansion flagcons_mouse	DS.B	1		; mouse character fill flagcons_fill	DS.B	1		; Console fill character (space)c_stat_size	equ	*-cons_stat_blk; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; DISPATCHER - Data storage;startup_flag	DS.B	2		; hi-bit on = startup has beed receivedstatus_word	DC.W	$0010		; Bit 5-15: reserved;                                            Bit 4: 1=online, 0=offline;                                          Bit 2-3: reserved;                                            Bit 1: 1=interrupting, 0=not interrupting;                                            Bit 0: 1=open, 0=closedstatus_extra	DC.L	0		; block count = 0the_req_cnt	DS.B	4		; Our copy of request_Countthe_tra_cnt	DS.B	4		; local copy of transfer_count; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -; CONSOLE - Data storage;console_state	DS.B	1		; state machine registercol_size	DS.B	1		; $80 for 80-col, $00 for 40-colmsg_len		DS.B	4		; Console message lengthline_buffer	DS.B	80		; storage for shiftingport_chain	DS.B	4		; head vp of saved text portsbuffer_width	DS.B	1		; used for save & restore screenbuffer_length	DS.B	1restore_width	DS.B	1minus		DS.B	1		; for horiz. shiftline_num	DS.B	1num_lines	DS.B	1shift		DS.B	1rgt1_bound	DS.B	1		; Right Bounds (text page 1)rgt2_bound	DS.B	1		; Right Bounds (text page 2)lft1_bound	DS.B	1		; Left Bounds (text page 1)lft2_bound	DS.B	1		; Left Bounds (text page 2)dle_count	DS.B	1		; for counting dle spaces;  Command character jump table. Each non-zero entry in this table;  is the address of the routine to handle the function performed;  by that command character.con_table	DC.W	con_nop		; $00 (no effect)		DC.W	con_save_vp	; $01 push & reset viewport		DC.W	con_set_vp	; $02 Set viewport		DC.W	con_clr_bol	; $03 Clear beginning of line		DC.W	con_rest_vp	; $04 pop viewport		DC.W	con_h_shift	; $05 horizontal scroll		DC.W	con_v_pos	; $06 vertical position		DC.W	con_bell	; $07 Sound 'bell'		DC.W	con_left	; $08 Move cursor left		DC.W	con_nop		; $09 tab - (no effect)		DC.W	con_lf		; $0A Move cursor down		DC.W	con_clr_eov	; $0B Clear to end of viewport		DC.W	con_clr_vp	; $0C Clear viewport		DC.W	con_return	; $0D Return cursor		DC.W	con_norm	; $0E Normal video		DC.W	con_inv		; $0F Inverse video		DC.W	con_dle		; $10 Expand Pascal 'DLE'		DC.W	con_40_col	; $11 set 40 column display		DC.W	con_80_col	; $12 set 80 column display		DC.W	con_clr_bov	; $13 Clear top of viewport to cursor		DC.W	con_h_pos	; $14 Horizontal position		DC.W	con_mode	; $15 Cursor movement control		DC.W	con_scr_dn	; $16 Scroll down		DC.W	con_scr_up	; $17 Scroll up		DC.W	con_mt_off	; $18 mouseText characters off		DC.W	con_home	; $19 Home cursor		DC.W	con_clr_ln	; $1A Clear line		DC.W	con_mt_on	; $1B mouseText characters on		DC.W	con_right	; $1C Move cursor right		DC.W	con_clr_eol	; $1D Clear to end of line		DC.W	con_goto_xy	; $1E Absolute position (goto XY)		DC.W	con_up		; $1F Move cursor up;  Addresses of completion routines.  When a routine wishes the;  next byte to be interpreted specially, it sets console_state;  to the index in this table of the special handler.comp_tbl	DC.W	0		; #0 (dummy entry)		DC.W	comp_vp_left	; #1 set vp, left side		DC.W	comp_vp_top	; #2 set vp, top		DC.W	comp_vp_rt	; #3 set vp, right side		DC.W	comp_vp_bt	; #4 set vp, bottom		DC.W	comp_h_scr	; #5 horizontal scroll		DC.W	comp_vtab	; #6 set vertical pos		DC.W	comp_dle	; #7 DLE space expansion		DC.W	comp_htab	; #8 set horizontal pos		DC.W	comp_mode	; #9 cursor movement flags		DC.W	comp_goto_x	; #10 goto xy - hor. pos.		DC.W	comp_goto_y	; #11 goto xy - ver. pos.; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -; User Input Routine - Data storageinput_info				; ; input information blockfill_char	DS.B	1		; field padding chardef_cursor	DS.B	1		; default cursor modecursor_mode	DS.B	1		; working cursor modebeep_flag	DS.B	1		; beep on user errorentry_type	DS.B	1		; tells UIR what to doexit_type	DS.B	1		; term # reported herelast_char	DS.B	1		; most recent keypresslast_mod	DS.B	1		; most recent modifierlast_term	DS.B	2		; most recent terminatorcursor_pos	DS.B	1		; cursor position in stringinput_length	DS.B	1		; length of input stringinput_field	DS.B	1		; length of input fieldorigin_h	DS.B	1		; saved ch of field startorigin_x	DS.B	2		; saved X of field startorigin_v	DS.B	1		; saved cv of field startinput_info_sz	equ	*-input_info;  Internal stuffmax_length	DS.B	2		; space left in windowimmed_flag	DS.B	2		; wait / no-wait flagread_mode	DS.B	2		; UIR or raw modeflash_flag	DS.B	1		; current cursor statecurs_int_flag	DS.B	1		; interrupt semaphorecursor_rate	DS.B	1		; cursor time constantwd_state_flag	DS.B	1		; used for finding word boundsbord_char	DS.B	1		; saved overstrike if past edgeterm_vp		DS.B	4term_mask	DS.B	2term_count	DS.B	2def_str_vp	DS.B	4		; vp to default stringdef_str_len	DS.B	2		; length of default string;; Event Manager Parameter List;evt_recordevt_what	DS.B	2		; EventCodeevt_message	DS.B	4		; EventMessage (lowest byte has key)evt_when	DS.B	4		; Tick Counterevt_where	DS.B	4		; mouse locationevt_modifiers	DS.B	2		; Modifiers flags; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -call_vector	DC.W	startup		; Dispatch vectors		DC.W	open		DC.W	read		DC.W	write		DC.W	close		DC.W	status		DC.W	control		DC.W	flush		DC.W	shutdown		eject;***********************************************************************;; Main Entry Point - The call dispatcher;;  In:          A   =  Call Number;               X,Y =  undefined;               DP  =  GS/OS direct page;               DB  =  undefined;               SP  =  GS/OS stack;;  Out:         A   =  Return code;               X,Y =  undefined;               DP  =  GS/OS direct page;               DB  =  undefined;               SP  =  GS/OS stack;               P   =  C set if A != no_errortext_driver	long; Now set bank register to current bank.  NOTE: No long addressing is used to; access variables in these routines since the data segment and the routines; are all attached and will reside in the same bank.  (This will have to be; changed if these routines are to be made ROMable.)		phk		plb		sta	cons_call_number ; Save the call number;  Transfer often-used values to my memory		lda	drvr_req_cnt		sta	the_req_cnt		lda	drvr_req_cnt+2		sta	the_req_cnt+2 if 0 then;  Character drivers must zero out the direct page transfer count themselves		stz	drvr_tran_cnt		stz	drvr_tran_cnt+2 endif; Make stack space for correct number of bytes of local zero-page storage		tdc			; save gs/os direct page		tax			; (also for use as parm_ptr)	if Library=1 then		tsc			; Get stack pointer		sec			; Prepare for subtraction		sbc	#direct_page.size	; Bytes needed for zero-page storage		tcs			; Update stack pointer		inc	a		tcd			; Relocate direct page to stack	else 		lda	#my_dp		; use absolute page 2 as direct page		tcd	endif;; Now set drvr_parm_ptr to the caller's direct page, the location of his/her; parameter block;		stx	drvr_parm_ptr	; old dp now a pointer		stz	drvr_parm_ptr+2;  and build a pointer to the message buffer (if any)		ldy	#drvr_buf_ptr		lda	[drvr_parm_ptr],y		sta	msg_ptr		iny		iny		lda	[drvr_parm_ptr],y		sta	msg_ptr+2; read and save the current state of the HIRES softswitch, then make sure; it's turned OFF so that switching between text page 1 and 2 doesn't ALSO; swap the hi-res buffers.		sep	#$20		;must be done in 8-bit mode		longa	off		lda	>rdhires	;read state of hires switch		pha			;save it		sta	>lores		;make sure it's turned off		rep	#$20		longa	on; dispatch the call...		lda	cons_call_number ; Get the call number		cmp	#max_commands+1	; Range check the value		blt	dispatch	; If OK, dispatch the call		lda	#drvr_bad_req	; Oops!  No such command number		bra	dispatch_exit	; Return to caller (Carry already set)dispatch	asl	a		; Multiply by two		tax			; Now use it as an index		jsr	(call_vector,x)	;   and dispatch the call;; ...and return to caller;dispatch_exit	long			; Gotta do this stuff in 8-bit mode		sta	exit_temp	; save exit code		rol	a		; get carry flag		sta	exit_flag	; and save it too; restore the original state of the HIRES softswitch		sep	#$20		; must be done in 8-bit mode		longa	off		sta	>txtpage1	; ensure page 1 is selected on exit		pla			; retrieve state		bpl	@no_change	; was already off		sta	>hires		; else turn it back on@no_change		rep	#$20		; back to 16-bit mode		longa	on	if Library=1 then		ldx	drvr_parm_ptr	; get the old dp		tsc			; Set stack pointer back to proper value		clc			; Prepare to add		adc	#direct_page.size		tcs		txa			; restore caller's direct page		tcd	else		lda	drvr_parm_ptr	; get the old dp		tcd			; and restore it	endif		lda	exit_temp	; Restore exit status		pha			;   and hold it for a minute		ldx	exit_flag		txa			; recover the error flag		ror	a		; put it in the carry bit		pla			; and get the error number!		rtl		eject;**********************************************************;*                                                        *;*                  The Text Driver Calls                 *;*                                                        *;**********************************************************;;  Calls are dispatched in 16-bit mode.  16 bit mode will be;  considered the norm in the interface region of the code.;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; startup;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; First initialize the console routine;startup		long		stz	port_chain	; clear vp's		stz	port_chain+2		stz	term_vp		stz	term_vp+2		stz	def_str_vp		stz	def_str_vp+2		lda	#$8000		; set the input mode to ram keyboard data		sta	read_mode		jsr	start_patch	; get user ID if library version		brl	ok_exit		; no error here		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; open call;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -open		long		lda	status_word	; is driver already open?		ror	a		bcs	open_1		; yes, return error		sec			; make it open now!		rol	a		sta	status_word	; is this cute code or what?		lda	#$8000		; set the input mode to ram keyboard data		sta	read_mode		jsr	initialize	; initialize in & out ports		jsr	turn_screen_on	; activate text mode		jsr	init_curs_tim	; setup the cursor timer		bcc	open_2		lda	#drvr_no_resrc		brl	error_exitopen_1		lda	#drvr_prior_open ; Yes, it's already open		brl	error_exitopen_2		brl	ok_exit		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; read Call - Get keyboard input;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -read		long		ldy	#drvr_blk_size	; must be 0, char dev		lda	[drvr_parm_ptr],y		beq	read_0		lda	#not_block_dev		brl	error_exitread_0		lda	status_word		ror	a		; open?		bcs	read_1		lda	#drvr_not_open		brl	error_exitread_1		mode_8		stz	exit_type	; Zero the exit_type		mode_16		lda	msg_ptr		; tell uir where the string goes		sta	input_str		lda	msg_ptr+2		sta	input_str+2		lda	read_mode	; raw read or UIR		bmi	read_x1		; raw read...		brl	read_1a		; UIR read...		eject;---------------------------------------------------------------------------------------------------;; This is the entry for the 'raw' keyboard read routine; read_x1		long		stz	the_tra_cnt		stz	the_tra_cnt+2		lda	the_req_cnt		ora	the_req_cnt+2	; null request?		beq	read_exit		jsr	make_term_ptr	; setup pointer to terminator list		jsr	get_term_parms	; copy out mask & lengthread_x2		mode_8		jsr	read_key	; A=character, X=modifiers		bcc	check_immed	; If no keypress, check for immediate		phx			; remember the modifier		pha			; and the character		mode_16		clc		lda	input_str	; Calculate address for next store		adc	the_tra_cnt		sta	dp_temp_1		lda	input_str+2		adc	the_tra_cnt+2		sta	dp_temp_1+2		pla			; recovers char AND mod		sta	last_char	; update InputPortRec (last_mod field too)		mode_8		sta	[dp_temp_1]	; store char only in buffer		mode_16			inc	the_tra_cnt	; Update the transfer count		bne	@low_only		inc	the_tra_cnt+2@low_only		and	term_mask	; mask off unused bits		sta	dp_temp_2	; and hold for later use; character driver must update the direct page transfer_count after every character		ldy	#drvr_tran_cnt		lda	the_tra_cnt		sta	[drvr_parm_ptr],y		iny		iny		lda	the_tra_cnt+2		sta	[drvr_parm_ptr],y		lda	term_count	; are there any terminators?		beq	chk_transfer	; no....		dec	a		; adjust for [],y addressing		asl	a		; and x 2 since its a word count		tay			; better set up the indexchk_term_lp	lda	[term_ptr],y	; get a terminator		and	#$D7FF		; remove term-type bit		cmp	dp_temp_2	; got one?		beq	term_exit	; yes!!!!!!		dey			; so sad, not found		dey		bpl	chk_term_lpchk_transfer	lda	the_tra_cnt	; Check if drvr_req_cnt has been filled		cmp	the_req_cnt		bne	check_immed		lda	the_tra_cnt+2		cmp	the_req_cnt+2		beq	read_exit	check_immed	mode_16		bit	immed_flag	; we are in 8 bit mode here		bpl	read_x2		; Hi-bit=0 is NOT immediate mode read_exit	lda	the_tra_cnt	; report xfer ct and quit		ldx	the_tra_cnt+2		brl	report_tra_cntterm_exit		sta	last_term	; update InputPortRec		tya			; get index into terminator table		lsr	a		; turn into a terminator number		inc	a		sep	#$20		; 8-bit store here		sta	exit_type		rep	#$20		bra	read_exit		eject;---------------------------------------------------------------------------------------------------;; This is the entry for the User Input Routine; read_1a		long		lda	the_req_cnt+2	; max input length is 254		bne	read_2		lda	the_req_cnt		cmp	#255		; Can't be over 254		blt	read_3		; It's OKread_2		lda	#254		; clamp input to max of 254read_3		sta	max_length	if	Library=1 then		;conditional assembly for library version		jsr	input		; Call User input Routine		lda	input_length	; return string length		and	#$00FF		; (which is only 8 bits)		ldx	#0		brl	report_tra_cnt	else		lda	user_input_running		beq	@continue				jsr	input		; Call User input Routine		lda	input_length	; return string length		and	#$00FF		; (which is only 8 bits)		ldx	#0		brl	report_tra_cnt@continue			inc	user_input_running				lda	the_req_cnt	;save the state of the world.		sta	hold_the_req_cnt		lda	the_req_cnt+2		sta	hold_the_req_cnt+2				lda	drvr_parm_ptr		sta	hold_drvr_parm_ptr		lda	msg_ptr		sta	hold_msg_ptr		lda	msg_ptr+2		sta	hold_msg_ptr+2				lda	input_str		sta	hold_input_str		lda	input_str+2		sta	hold_input_str+2;Now get the address of the user's parameter block		ldy	#param_blk_ptr		lda	[drvr_parm_ptr],y		sta	input_str		;build pointer to user's parameter block		iny		iny		lda	[drvr_parm_ptr],y		sta	input_str+2				ldy	#call_number		;is this a file read call?		lda	[drvr_parm_ptr],y				ldy	#$000A		cmp	#$0012			;Class 0 read call.		beq	@do_XFer_cnt				cmp	#$2012			;class 1 read call		bne	@DType_Call				ldy	#$000C		lda	[input_str]		;Check the PCount for Class 1 write call		cmp	#$0004		bcc	@error			;Sorry the PCount DOES NOT include TRANSFER Count		bra	@do_XFer_cnt@DType_Call		ldy	#$0012		cmp	#$202F			;is it really DRead?		beq	@do_XFer_cnt		;yup!; it's not an FST read, nor a DRead, so handle it like before we set it up as a; signal handler		lda	hold_input_str		; restore pointer to user's buffer		sta	input_str		lda	hold_input_str+2		sta	input_str+2		jsr	input			; Call User input Routine		stz	user_input_running		lda	input_length		; return string length		and	#$00FF			; (which is only 8 bits)		ldx	#0		brl	report_tra_cnt@do_XFer_cnt		tya		clc		adc	input_str		;build a pointer to the xfer count field		sta	hold_xfer_cnt_ptr		lda	#$0000		adc	input_str+2		sta	hold_xfer_cnt_ptr+2				lda	#$FFFF		ldx	#user_input_handler		ldy	#^user_input_handler		jsl	signal			;long jump to arm procedure@error		ldx	#0		txa		brl	report_tra_cntuser_input_running	dc.w	00		hold_the_req_cnt	dc.l	00hold_drvr_parm_ptr 	dc.w	00hold_msg_ptr		dc.l	00hold_input_str		dc.l	00hold_old_dp		dc.w	00hold_xfer_cnt_ptr	dc.l	00user_input_handler		phk		plb			;force our bank!; Make stack space for correct number of bytes of local zero-page storage		tdc			; save gs/os direct page		sta	hold_old_dp	; save for later restore 		lda	#my_dp		; use absolute page 2 as direct page		tcd;; Now set drvr_parm_ptr to the caller's direct page, the location of his/her; parameter block;		lda	hold_drvr_parm_ptr		sta	drvr_parm_ptr	; points to GS/OS direct page.		stz	drvr_parm_ptr+2;  and build a pointer to the message buffer (if any)				lda	hold_msg_ptr	; points to user's buffer		sta	msg_ptr		lda	hold_msg_ptr+2		sta	msg_ptr+2		lda	hold_the_req_cnt		sta	the_req_cnt	; number of bytes wanted		lda	hold_the_req_cnt+2		sta	the_req_cnt+2		lda	hold_input_str	; pointer to user's buffer		sta	input_str		lda	hold_input_str+2		sta	input_str+2		ldy	#drvr_tran_cnt	;zero out direct page transfer count variable		lda	#0		sta	[drvr_parm_ptr],y		iny		iny		sta	[drvr_parm_ptr],y				jsr	input		; Call User input Routine; Since we're handling the input as part of a signal dispatch, we have to update the; transfer count in the caller's GS/OS parameter block.  Normally, this is done by; whoever called the driver (either the Character FST or the Device Manager).  Since; the signal dispatch doesn't happen until after the FST or Device Manager has already; exited, it's up to us to fill in the Transfer Count field.		lda	hold_xfer_cnt_ptr		sta	input_str	; setup pointer to the user's transfer count.		lda	hold_xfer_cnt_ptr+2		sta	input_str+2				lda	input_length	; return string length		and	#$00FF		; (which is only 8 bits)		sta	[input_str]	; update user's parameter block		ldy	#$0002		lda	#$0000		sta	[input_str],y 		lda	hold_old_dp		tcd		lda	#$0000		; allow use of user input routine again.		sta	>user_input_running		rtl	endif				;end of conditional section		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; write Call;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; Set up msg_len and msg_ptr to point to string to output;write		long		ldy	#drvr_blk_size	; must be 0, char dev		lda	[drvr_parm_ptr],y		beq	write_0		lda	#not_block_dev		brl	error_exitwrite_0		lda	status_word		ror	a		; Is the driver open?		bcs	write_1		; Yes, continue		lda	#drvr_not_open		brl	error_exitwrite_1		lda	the_req_cnt		sta	msg_len		; Console message length		lda	the_req_cnt+2		sta	msg_len+2			mode_8		jsr	console		; Output it!		mode_16		lda	the_req_cnt		ldx	the_req_cnt+2		brl	report_tra_cnt		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; close Call;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -close		long		lda	status_word		ror	a		; Is driver open?		bcs	close_1		; Yes, continue		lda	#drvr_not_open		brl	error_exitclose_1		clc			; flag closed		rol	a		sta	status_word		jsr	kill_term_list	; release terminators memory		jsr	kill_def_str	; and default input string		jsr	kill_port_chain	; release saved viewports		jsr	rmv_curs_time	; disable the cursor interrupt		brl	ok_exit		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; status Call;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -stat_vect	DC.W	get_driver_stat		DC.W	get_parms		DC.W	get_wait_stat		DC.W	status_error		; unsupported - char devicespec_stat_vect	DC.W	get_cons_info		DC.W	get_uir_info		DC.W	get_term_stat		DC.W	save_viewport		DC.W	get_char		DC.W	get_read_mode		DC.W	get_def_string		dc.w	get_vectorsstatus		long		ldy	#drvr_stat_code	; Get the status request code		lda	[drvr_parm_ptr],y		bmi	special_status		cmp	#max_stat+1		bge	status_error			asl	a		; Double the status code		tax			;   for use as an index		jmp	(stat_vect,X)special_status	long		cmp	#max_spec_stat+1		bge	status_error			asl	a		; Double the status code		tax			;   for use as an index		lda	status_word	; by the way, are we open?		ror	a		bcs	go_spec_stat		lda	#drvr_not_open		brl	error_exitgo_spec_stat		jmp	(spec_stat_vect,X) status_error	lda	#drvr_bad_code		brl	error_exit	; None of the above!  Error		Eject; TextDriver statusget_driver_stat	long		lda	#6		; stat word 2, blk count 4		ldx	#<status_word		ldy	#^status_word		clc			; transfer as much as possible		brl	xfer_status		Eject; Return control Parametersget_parms	long		lda	#2		; empty control parms		ldx	#<fake_ct_parms		ldy	#^fake_ct_parms		clc		brl	xfer_statusfake_ct_parms	DC.W	0000		Eject; Wait/No-Wait statusget_wait_stat	long		lda	#2		ldx	#<immed_flag		ldy	#^immed_flag		clc		brl	xfer_status		Eject; Get console Informationget_cons_info	long		lda	#c_stat_size		ldx	#<cons_stat_blk		ldy	#^cons_stat_blk		clc		brl	xfer_status		Eject; Get User input Routine Informationget_uir_info	long		lda	#input_info_sz		ldx	#<input_info		ldy	#^input_info		clc		brl	xfer_status		Eject; Terminator statusget_term_stat	long		jsr	make_term_ptr	; where did they go?		ldy	#2		; get count word		lda	[term_ptr],y		inc	a		; *2 and add 4		inc	a		asl	a		; or, add 2 and *2		ldx	term_ptr		ldy	term_ptr+2		sec			; only transfer complete lists!		brl	xfer_status		Eject;  Save Viewportsave_viewport	long		lda	wnd_length	; calculate memory needed		and	#$00FF		; by doing a cheap multiplication		tax		lda	wnd_width		and	#$00FF		sta	dp_temp_2		lda	#0sv_vp_1		clc		adc	dp_temp_2		dex		bne	sv_vp_1		clc			; add 2 for header bytes		adc	#2		sta	dp_temp_2		lda	the_req_cnt+2	; if buffer > 64k we have enough		bne	sv_vp_2		lda	the_req_cnt	; enough room (lo word) ?		cmp	dp_temp_2		bge	sv_vp_2		; yes!		lda	#drvr_bad_parm	; not enough room!		brl	error_exitsv_vp_2		lda	dp_temp_2	; remember buffer size		pha		mode_8		jsr	vp_save		mode_16		pla			; report success		ldx	#0		brl	report_tra_cnt		Eject; Get Text characterget_char	mode_8		jsr	cv_bas_calc		sta	>set80col		sta	>txtpage1	; assuming 40 or 80 odd		lda	ch		bit	col_size	; 80-col or 40-col ?		bpl	get_char_1	; 40. leave things as is.		lsr	a		; 80.  1/2 index and maybe p2		bcs	get_char_1		sta	>txtpage2get_char_1		tay		lda	[cur_base],y		sta	line_buffer		sta	>txtpage1			mode_16		lda	#1		ldx	#<line_buffer		ldy	#^line_buffer		clc		brl	xfer_status		Eject; Get read Modeget_read_mode	long		lda	#2		ldx	#<read_mode		ldy	#^read_mode		clc		brl	xfer_status		Eject;  Get Default Input Stringget_def_string	long		jsr	make_def_ptr	; dereference the vp		lda	def_str_len		ldx	def_str_ptr		ldy	def_str_ptr+2		sec		brl	xfer_status		eject;; Get single character I/O vectorsget_vectors		lda	#8		; 8 bytes to return to caller		ldx	#<sngl_io_tbl	; point to table of addresses		ldy	#^sngl_io_tbl		clc			; report error if not enough room		brl	xfer_status	; go do itsngl_io_tbl	dc.l	COut		; address of single character output routine		dc.l	KeyIn		; address of single character input routine		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; control Call;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -cont_vect	DC.W	driver_reset		DC.W	ok_exit			; (Except Format Device)		DC.W	status_error		; unsupported- char device		DC.W	ok_exit			; has no control parms		DC.W	set_wait_stat		DC.W	status_error		; unsupported- char device		DC.W	status_error		; unsupported- char device		DC.W	status_error		; unsupported- char devicespec_cont_vect	DC.W	set_uir_info		DC.W	term_control		DC.W	restore_port		DC.W	set_read_mode		DC.W	set_def_str		DC.W	cancel_input		DC.W	add_trap	; install the console trap please		DC.W	remove_trap	; Remove the console trap pleasecontrol		long		ldy	#drvr_ctrl_code	; Get the control request code		lda	[drvr_parm_ptr],y		bmi	special_control		cmp	#max_cont+1		bge	control_error		asl	a		; Double the control code		tax			;   for use as an index		jmp	(cont_vect,X)special_control	cmp	#max_spec_cont+1		bge	control_error		asl	a		; Double the control code		tax			;   for use as an index		lda	status_word	; by the way, are we open?		ror	a		bcs	go_spec_cont		lda	#drvr_not_open		brl	error_exitgo_spec_cont		jmp	(spec_cont_vect,X)control_error	lda	#drvr_bad_code		brl	error_exit	; None of the above!  Error		Eject;;Add console trap.  This routine will take a long word vector to a user routine;add_trap	long		lda	the_req_cnt+2	;make sure the request count is OK		bne	@bad_count	;sorry the count is way too large		lda	the_req_cnt		cmp	#$0004		;the only valid count		bne	@bad_count				ldy	#$0002		lda	[msg_ptr]	;get the address please		sta	users_vector+1		lda	[msg_ptr],y		sta	users_vector+3				lda	trap_vector	;see if a trap is already installed		cmp	our_vector		bne	@trap_error	;sorry you cannot install a new vector		lda	trap_vector+2		cmp	our_vector+2		bne	@trap_error						lda	users_vector	;install the users address please		sta	trap_vector		lda	users_vector+2		sta	trap_vector+2				lda	#$0004		ldx	#$0000		brl	report_tra_cnt		@bad_count		lda	#drvr_bad_parm	; when length & term_count don't match		brl	error_exit		@trap_error	lda	#add_trap_failed		brl	error_exitusers_vector		dc.b	$22		; a JSL instruction		dc.b	00,00,00,00	; users address goes hereour_vector	jsl	our_rtlour_rtl		rtl		Eject;;This routine will remove the user installed trap vector;remove_trap	long		lda	the_req_cnt		ora	the_req_cnt+2		bne	@bad_count				lda	our_vector		sta	trap_vector		lda	our_vector+2		sta	trap_vector+2; must reset the single character i/o vectors too, just in case someone changed 'em		lda	#<COut_1	;11-Mar-92 DAL		sta	COut+1		lda	#COut_1>>8	;11-Mar-92 DAL		sta	COut+2		lda	#<KeyIn_1	;11-Mar-92 DAL		sta	KeyIn+1		lda	#KeyIn_1>>8	;11-Mar-92 DAL		sta	KeyIn+2		lda	#$0000		tax		brl	report_tra_cnt		@bad_count		lda	#drvr_bad_parm	; when length & term_count don't match		brl	error_exit				Eject;; Reset Text Driverdriver_reset	long		jsr	initialize	; Re-initialize everything		brl	ok_exit		Eject; Wait/No-Wait controlset_wait_stat	long		lda	#2		ldx	#<immed_flag		ldy	#^immed_flag		clc		brl	xfer_control		Eject; Set User input Routine Informationset_uir_info	long		lda	#input_info_sz		ldx	#<input_info		ldy	#^input_info		clc		brl	xfer_control		Eject; Terminator controlterm_control	long		lda	the_req_cnt+2	; if buffer > 64k, too long!		bne	term_cnt_error		lda	the_req_cnt	; did the user give us at least 2?		tay		cmp	#$0002		bcc	term_cnt_error	; he did not provide the mask				lda	[msg_ptr]	; what is the mask		beq	kill_the_terms	; if 0, disable					; did the user give us at least 4?		cpy	#$0004		bcc	term_cnt_error	; he did not provide the mask and terminator count				ldy	#2		; examine count for correctness		lda	[msg_ptr],y		beq	kill_the_terms	; if 0, disable		cmp	#256		; max 255 terminators		bge	term_cnt_error		inc	a		; (calculating byte count)		inc	a		asl	a		cmp	the_req_cnt	; exact transfers only!		bne	term_cnt_error;  The terminators are ok.  Prepare a new list!		sta	term_count	; remember the length		jsr	kill_term_list	; kill old list		lda	term_count	; get the length again		jsr	call_alloc	; make a new one		bcc	term_cnt_1		lda	#drvr_no_resrc		brl	error_exitterm_cnt_1		stx	term_vp		; save the new terminator vp		sty	term_vp+2		jsr	call_deref		lda	term_count	; get the length (again)		sec			; transfer exact count		brl	xfer_controlterm_cnt_error		lda	#drvr_bad_parm	; when length & term_count don't match		brl	error_exitkill_the_terms		jsr	kill_term_list	; user selected disable		lda	#4		; we just looked at the header		ldx	#0		brl	ok_exit		Eject; Restore console Viewportrestore_port	long		lda	the_req_cnt+2	; if buffer >64k, too big!		bne	rest_cnt_error		lda	the_req_cnt		cmp	#$0002		; We need at least two bytes		bcc	rest_cnt_error	; sorry bud				lda	[msg_ptr]	; see if enough data was supplied;;Fixed BRC#39797 Bug #1.  I added the BEQ to handle the case of zero;		bne	do_restore				lda	#$0002		; we handled the first two bytes.		bra	skip_restore	; there is nothing to restore!;;End of bug fix;do_restore		xba		and	#$00FF		tax		lda	[msg_ptr]		and	#$00FF		sta	dp_temp_2		lda	#0rest_pt_lp		clc		adc	dp_temp_2		dex		bne	rest_pt_lp		inc	a		; add two for record header		inc	a		cmp	the_req_cnt		bne	rest_cnt_error		pha			; its ok!		mode_8		jsr	vp_restore		mode_16		pla			; report the save!skip_restore	ldx	#0		brl	report_tra_cntrest_cnt_error		lda	#drvr_bad_parm	; only perfect data allowed!		brl	error_exit		Eject;; Set read Mode;set_read_mode	long		lda	#2		; word param		ldx	#<read_mode		ldy	#^read_mode		clc		brl	xfer_control		Eject;  Set default string for uir inputset_def_str	long		lda	the_req_cnt+2	; if >64k, too long!		bne	def_str_error		lda	the_req_cnt		beq	def_str_clr	; 0.  no default string!		cmp	#255		; max length 254		bge	def_str_error		jsr	kill_def_str	; dump old string		lda	the_req_cnt		jsr	call_alloc	; get new memory		bcc	set_def_1		lda	#drvr_no_resrc	; out of memory!		brl	error_exitset_def_1		stx	def_str_vp		sty	def_str_vp+2		jsr	call_deref		lda	the_req_cnt	; always copy everything		sta	def_str_len		clc		brl	xfer_controldef_str_error	long		lda	#drvr_bad_parm		brl	error_exitdef_str_clr	long		jsr	kill_def_str	; dump old one!		lda	#0		tax		brl	report_tra_cnt	; 0 bytes xferred		Eject;  Cancel in-progress inputcancel_input	mode_8			; called in 16 bit mode		jsr	rmv_cursor		stz	entry_type		stz	exit_type		mode_16		lda	#0		; 0 bytes xferred		tax		brl	report_tra_cnt		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; flush Call;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; This call does nothing;flush		long		lda	#0		; Be sure drvr_tran_cnt is zero		tax			; (A = lo-word,  X = hi-word) 		brl	report_tra_cnt	; No error here		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; shutdown Call;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  If the driver is open, first perform close actions.;shutdown	long		lda	status_word		ror	a		; Is the driver open?		bcc	shutdown_2	; No, continue		clc			; closing- clear open flag		rol	a		sta	status_word		jsr	kill_term_list	; closing ; dump terminators		jsr	kill_def_str		jsr	kill_port_chain		jsr	rmv_curs_time	; disable the cursor interruptshutdown_2		jsr	shutdown_patch	; release ID if library version		bra	ok_exit		;  and goto ok_exit		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; console exit routines:;;  Report_tra_cnt:      A lo and X hi are the transfer count.;                       Place it in the param blk and return no error.;;  OK_exit:             Return with no error.;;  Error_Exit:          Return with error code passed in A.;;  (All exit routines entered in 16 bit mode!!!);; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -report_tra_cnt	long		ldy	#drvr_tran_cnt	; Report the transfer count		sta	[drvr_parm_ptr],y		iny		iny		txa		sta	[drvr_parm_ptr],yok_exit		long		lda	#no_error	; No error entry point		clc		rtserror_exit	long		sec			; error passed in a		rts		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;; Initialization subroutine;; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -initialize	mode_8			; called as 16 bit		jsr	init_viewport	; initialize viewport; Now initialize the User input Routineuir_init	mode_16		jsr	kill_term_list		jsr	kill_def_str		mode_8		lda	#$20		; fill char = space		sta	fill_char		stz	def_cursor	; def curs = insert, at end, no ctrls		lda	#$80		sta	beep_flag	; beeper on		stz	entry_type	; initial entry		jsr	new_curs_rate	; initialize blinker		mode_16		rts			; exit 16		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  init_viewport;;  initializes the viewport to published standards.  Its;  size is expanded to the full size for the current config.;init_viewport	short		stz	cv		stz	ch		stz	wnd_left		stz	wnd_top		lda	#23		sta	wnd_bottom		inc	a		sta	wnd_length		lda	#39		bit	col_size		bpl	init_vp_1		lda	#79init_vp_1		sta	wnd_right		inc	a		sta	wnd_width		lda	#$A0		; normal video's fill char		sta	cons_fill		lda	#$80		; use for setting flags 'true'		sta	cons_wrap		sta	cons_advance		sta	cons_lf		sta	cons_scroll		sta	cons_video	; normal video		sta	cons_dle		stz	cons_mouse	; mousetext off		rts		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  Make_Term_Ptr;;  Returns a pointer to the terminator list, at term_ptr.  If;  there is no terminator list (term_vp == 0) then set up a;  pointer to an 'empty' terminator list of 0,0,0,0.;make_term_ptr	long		lda	term_vp		; is there data?		ora	term_vp+2		beq	make_fake_ptr	; no!		ldx	term_vp		; yes, dereference it		ldy	term_vp+2		jsr	call_deref		stx	term_ptr		sty	term_ptr+2		rtsmake_fake_ptr	long		lda	#<fake_list		sta	term_ptr		lda	#^fake_list		sta	term_ptr+2		rtsfake_list	DC.W	00		; mask = 0		DC.W	00		; length = 0		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  get_term_parms;;  Called right after make_term_ptr if we are going to interpret;  the terminator info.  Copies the mask and count into term_mask;  and term_count, then modifies term_ptr to point to the actual;  list (4 bytes into the data structure).get_term_parms	long		lda	[term_ptr]	; word 0 is mask		sta	term_mask		ldy	#0002		lda	[term_ptr],y	; word 1 is length		sta	term_count		clc			; adjust pointer		lda	term_ptr		adc	#0004		sta	term_ptr		bcc	@1		inc	term_ptr+2	; propogate carry@1		rts		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  kill_term_list;;  Dump the memory, if any, used for the terminator list.;kill_term_list	long		lda	term_vp		; do we have any?		ora	term_vp+2		beq	q_kill_term	; no...		ldx	term_vp		ldy	term_vp+2		jsr	call_release		stz	term_vp		stz	term_vp+2q_kill_term	rts		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  make_def_ptr;;  Setup def_str_ptr as a pointer to the input default string;  (by dereferencing def_str_vp).;make_def_ptr	long		lda	def_str_vp		ora	def_str_vp+2		beq	no_def_str		ldx	def_str_vp		ldy	def_str_vp+2		jsr	call_deref		stx	def_str_ptr		sty	def_str_ptr+2		rtsno_def_str		stz	def_str_ptr		stz	def_str_ptr+2		rts		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  kill_def_str;;  Dump the memory, if any, used for the default input string;kill_def_str	long		lda	def_str_vp	; do we have one?		ora	def_str_vp+2		beq	q_kill_def	; no...		ldx	def_str_vp		ldy	def_str_vp+2		jsr	call_release		stz	def_str_vp		stz	def_str_vp+2		stz	def_str_len	; 0 length used as flagq_kill_def	rts		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  kill_port_chain;;  Walk the saved-textport-chain and release any ports.;kill_port_chain	long		lda	port_chain	; any more to do?		ldy	port_chain+2	; get high word@loop		tax		ora	port_chain+2		beq	q_kill_ports		jsr	call_deref		stx	dp_temp_1	; get the next one!		sty	dp_temp_1+2		lda	[dp_temp_1]	; handle to next one		pha		ldy	#2		lda	[dp_temp_1],y		pha		ldx	port_chain	; kill the current one		ldy	port_chain+2		jsr	call_release		pla			; step to next one		sta	port_chain+2		tay			; put in Y too		pla		sta	port_chain		bra	@loop		; repeatq_kill_ports		rts		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  XFER_STATUS;;  Copy driver status data to the user buffer.  Transfers only;  as much as (a) exists in the source and (b) there is room for.;  Reports the final transfer count and exits.;;  Inputs:      A            source length;               X,Y          source pointer;               msg_ptr      destination pointer;               the_req_cnt  max length of dest buffer;               C clear      transfer as much as possible;               C set        if not enough room, report drvr_bad_parm;;  Outputs:     If C was clear or C set and A <= the_req_cnt, returns;               no_error and transfer_count set to bytes transferred.;               If C was set and A > the_req_cnt, returns drvr_bad_parm.;;  Note:  By the driver specs, user buffers may be greater than 64k,;         however because the source length is passed in A, the max;         transfer count is $FFFF.;xfer_status	long		stx	dp_temp_1	; store source pointer		sty	dp_temp_1+2		sta	dp_temp_2	; store source length		ror	a		; get C into hi bit of A		ldx	the_req_cnt+2	; if dest > 64k, no size problem		bne	xfer_stat_1		ldx	the_req_cnt		cpx	dp_temp_2		bge	xfer_stat_1	; buffer big enough;  The buffer is smaller than the available data.  If there is;  a problem, report an error.		rol	a		; get the flag again		bcc	xfer_stat_2	; just return partial data		lda	#drvr_bad_parm	; report xfer error		brl	error_exit;  The buffer is big enough for the available data.  Use the;  source data size.xfer_stat_1		ldx	dp_temp_2;  Take the transfer length in X.  If it's non-zero,;  move that many bytes.xfer_stat_2		phx			; remember the xfer count		txy		longa	off		sep	#$20		; move bytesxfer_stat_lp		tyx			; test for end		beq	xfer_stat_3		dey			; decrement pointer		lda	[dp_temp_1],y	; source data		sta	[msg_ptr],y	; destination buffer		bra	xfer_stat_lpxfer_stat_3		longa	on		rep	#$20		; back to full native		pla			; restore transfer count (x=0)		brl	report_tra_cnt		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  XFER_CONTROL;;  Copy driver control data from the user buffer.  Transfers only;  as much as (a) exists in the source and (b) there is room for.;  Reports the final transfer count and exits.;;  Inputs:      A            max length of destination;               X,Y          destination pointer;               msg_ptr      source pointer;               the_req_cnt  length of source data;               C clear      transfer as much as possible;               C set        if not enough room, report drvr_bad_parm;;  Outputs:     If C was clear or C set and A <= the_req_cnt, returns;               no_error and transfer_count set to bytes transferred.;               If C was set and A > the_req_cnt, returns drvr_bad_parm.;;  Note:  By the driver specs, user buffers may be greater than 64k,;         however because the dest length is passed in A, the max;         transfer count is $FFFF.;xfer_control	long		stx	dp_temp_1	; store dest pointer		sty	dp_temp_1+2		sta	dp_temp_2	; store dest length		ror	a		; get C into hi bit of A		ldx	the_req_cnt	; Check the user's request count		cpx	dp_temp_2	; compare sizes		bge	xfer_cont_1	; destination big enough;  The buffer is bigger than the destination area.  If there is;  a problem, report an error.  User is sending less then max data.		rol	a		; get the flag again		bcc	xfer_cont_2	; just return partial data		lda	#drvr_bad_parm	; report xfer error		brl	error_exit;  The destination is big enough for the source data.  Use the;  source data size.xfer_cont_1		ldx	dp_temp_2;  Take the transfer length in X.  If it's non-zero,;  move that many bytes.xfer_cont_2		phx			; remember the xfer count		txy		longa	off		sep	#$20		; move bytesxfer_cont_lp		tyx			; test for end		beq	xfer_cont_3		dey			; decrement pointer		lda	[msg_ptr],y	; source data		sta	[dp_temp_1],y	; destination buffer		bra	xfer_cont_lpxfer_cont_3		longa	on		rep	#$20		; back to full native		pla			; restore transfer count (x=0)		brl	report_tra_cnt		eject; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  Turn_Screen_On;;  The driver has just been opened.  Initialize the screen;  to 80 column mode.  If the screen was previously 40,;  convert the data so we don't have to see garbage.turn_screen_on	mode_8			; (enter in 16 mode)		lda	>rd80vid	; already there?		bmi	already_80	; yes.  no changes		jsr	tr_4080		; convert screen data		sta	>set80vid	; 80 column hardwarealready_80		ldx	#$80		; flag for 80 col mode		stx	col_size	; save column mode flag		lda	#79		; screen right side		sta	wnd_right	; save right side		inc	a		; convert and save width		sta	wnd_width		sta	>setaltchar	; alt character set		lda	>txtset		; text mode on		sta	>clr80col	; no funny storage mode (yet)		lda	>txtpage1	; show page 1		mode_16		rts		eject;---------------------------------------------------------------------------------------------------;; COut - single character output vector;; Address is returned to a client with the GetVectors DStatus subcall.  The client can; then place a character in the accumulator and JSL to this address.  It is also allowed; for the client to modify the address to intercept single character I/O calls through; the vector (for example, Prizm).COut		jml	COut_1COut_1		pha			; save registers		phx		phy		php			; save register sizes		phb			; save caller's DBR		phd			; and direct page		pea	my_dp		; set up our direct page		pld		phk			; set DBR to our bank		plb		sep	#$30		; back to 8-bit mode		longa	off		longi	off		sta	>set80col	; allow even/odd access		jsr	char_out	; go output the character		pld			; restore direct page		plb			; restore DBR		plp			; restore register sizes		ply			; restore registers		plx		pla		rtl			; back to caller;---------------------------------------------------------------------------------------------------;; KeyIn - Single Character Input Vector;; Address is returned to a client with the GetVectors DStatus subcall.  The client can; then JSL to this address and have a single keypress returned in the accumulator.  It; is also allowed for the client to modify the address to intercept single character; I/O calls through the vector (for example, Prizm).;; Note that calling this vector will cause the program to pause until a key is pressed; (i.e. wait mode).  On exit, the ASCII value of the keypress will be in the low byte; of the accumulator, with the state of the keyboard modifiers in the high byte.KeyIn		jml	KeyIn_1KeyIn_1		phx			; save X and Y		phy		php			; save register sizes		phb			; save caller's DBR		phd			; and direct page		pea	my_dp		; set to my direct page		pld		phk			; and DBR		plb@key_loop		rep	#$30		; 16-bit mode		lda	>$4e		; increment random # seed, like the monitor does		inc	a		sta	>$4e		sep	#$30		; ensure 8-bit mode		longa	off		longi	off		jsr	read_key	; go get a keypress		bcc	@key_loop	; wait until a key is pressed		xba			; put keypress into high byte		txa			; put modifiers into low byte		xba			; then put 'em where they belong		pld			; restore caller's direct page		plb			; and DBR		plp			; restore register sizes		ply			; restore X and Y		plx		rtl			; back to caller		eject;----------------------------------------------------------;;  CONS.MAIN;;  The main routine for console output.;;  Inputs:      msg_ptr                 pointer to output data;               msg_len                 how many bytes to print;;  Author:      Andy Stadler;  Created:     Sept 15, 1987;;  Modifications:;;  15-Sep-87    Rewrite begun;  15-Oct-87    Rewrite finished.;  23-Jan-88    alloc, deref & release glue added;;  Copyright (C) 1987 Apple Computer, Inc.;  All Rights Reserved;;----------------------------------------------------------console		short		sta	>set80col	; allow even/odd access		jsr	cv_bas_calc	; pre-calculate base address		mode_16console_loop	long		lda	msg_len		; any more characters?		ora	msg_len+2		mode_8		bne	console_gotone		rts			; no.  done!console_gotone		lda	[msg_ptr]	; get the character		jsr	char_out	; print it.		mode_16		inc	msg_ptr		; increment the pointer		bne	con_next_1		inc	msg_ptr+2con_next_1		lda	msg_len		; decrement the count		bne	con_next_2		dec	msg_len+2con_next_2		dec	msg_len		bra	console_loop	; (in long mode)		eject;----------------------------------------------------------;;  Char_Out  -  display a single character.  This takes;               the characters as they come from the input;               stream and does all the mapping and interpreting;               as necessary.  Characters destined for the;               screen are finally routed to 'display_it'.;;  In:  A = Ascii character to print.;;-----------------------------------------------------------char_out	short		ldx	console_state	; part of a cmd?		bne	in_command	; yes.  finish it.;  A fresh character.  Process it.		cmp	#$20		; control command?		bge	map_char	; printable.  do it.;  Process a control character.new_command	short		asl	a		; make char -> index		tax		jmp	(con_table,X)	; (rts) do the command;  Finish a previous command.in_command	short		jmp	(comp_tbl,X)	; (rts) completion routines;  Map a character to the screen codes.  This is based on a combination;  of the 'inverse' and 'mousetext' flags.  In addition, codes $80-$FF;  are sent directly (except they are flipped by the inverse flag).map_char	short		tay			; test char range		bmi	sk_uc_map	; special inverse, send it through;  Check for uppercase characters,		cmp	#$40		; bottom of UC/MT range		blt	sk_uc_map		cmp	#$60		; top of range		bge	sk_uc_map;  If not mousetext, map uppercase $40-$5F to $00-$1F		ldx	cons_mouse	; mousetext on?		bpl	uc_map		; no, so remap UC		ldx	cons_video	; inverse mode?		bpl	sk_uc_map	; yes, mt too, so don't remap;  We are not displaying a mousetext character.  Remap the upper caseuc_map		and	#$BF		; $40->$00, $5F->$1F;  Now apply the inverse mapping.sk_uc_map		eor	cons_video	; $80 is normal;  And display the character on the screen.; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -; display_it - send a character to the screen memory;; character to send must be in the A-register.;display_it	short			tax			; remember the character!		lda	ch		bit	col_size	; 40 or 80?		bpl	display_it_1	; 40.  index and go		lsr	a		; divide column #		bcs	display_it_1	; odd.  Stay on main mem		sta	>txtpage2	; even. go to aux mem.		tay			; y = screen offset		txa			; Get the character back		sta	[cur_base],y	; Write the character on the screen		lda	cons_advance	; Should we advance the cursor?		bne	con_right	; move the cursor rightdisplay_it_2		rts			; return to the callerdisplay_it_1		tay			; y = screen offset		lda	>txtpage1	; assume even column OR 40 mode		txa			; Get the character back		sta	[cur_base],y	; Write the character on the screen		lda	cons_advance	; Should we advance the cursor?		beq	display_it_2;					; (rts) advance the cursor!;----------------------------------------------------------;;  $1C  Move cursor right;	We have the code here since we call it on each character write!;con_right	short		lda	ch		; at right yet?		cmp	wnd_right		beq	con_right_2		inc	ch		; no.  just move it.con_right_1		rtscon_right_2		lda	cons_wrap	; wrap enabled?		bpl	con_right_1	; no, stay put.		lda	wnd_left	; yes.  move over and maybe down		sta	ch		brl	con_lf		; (rts)		eject;-----------------------------------------------------------;;  CONSOLE COMMAND HANDLERS;;  Each of these routines handles a control character.;;-----------------------------------------------------------;;  $00  No Operation;con_nop		short		rts;-----------------------------------------------------------;;  $01  Push and reset view port;con_save_vp	mode_16		lda	port_chain	; save vp of old viewport		sta	dp_temp_1		lda	port_chain+2		sta	dp_temp_1+2		lda	#c_stat_size+4	; request some memory		jsr	call_alloc		bcs	sk_push		; memory error!		stx	port_chain	; save new first entry		sty	port_chain+2		jsr	call_deref		stx	dst_line	; I will be copying to it		sty	dst_line+2		lda	dp_temp_1	; save link vp		sta	[dst_line]		lda	dp_temp_1+2		ldy	#2		sta	[dst_line],y		ldx	#c_stat_size-1	; source counter		ldy	#c_stat_size+4-1		sep	#$20		; move bytespush_vp_lp		lda	cons_stat_blk,x		sta	[dst_line],y		dey		dex		bpl	push_vp_lpsk_push		mode_8		brl	init_viewport	; (rts);----------------------------------------------------------;;  $02  Set Text Port;;  (Just initializes the state machine to process 4 more bytes.)con_set_vp	short		lda	#2		; code for set vp #1		sta	console_state		rts;-----------------------------------------------------------;;  $03  Clear from left edge to cursor;con_clr_bol	short		ldx	wnd_left	; left/right bounds		ldy	ch		jsr	spc_cmp_bnds	; compute bounds for clear line		ldy	cv		brl	spc_clear_line	; (rts);-----------------------------------------------------------;;  $04  Pop or reset text port;con_rest_vp	mode_16		lda	port_chain		ora	port_chain+2		beq	sk_push		; (look above) just reset		ldx	port_chain	; get the recently saved port		ldy	port_chain+2		phx			; save it for later release		phy			; of the memory		jsr	call_deref		stx	src_line	; but first get a pointer so		sty	src_line+2	; we can suck it dry!		lda	[src_line]	; get the link to the next one		sta	port_chain		ldy	#2		lda	[src_line],y		sta	port_chain+2		ldx	#c_stat_size-1	; dest counter		ldy	#c_stat_size+4-1 ; source		sep	#$20		; move bytespop_vp_lp		lda	[src_line],y		sta	cons_stat_blk,x		dey		dex		bpl	pop_vp_lp		rep	#$20		; reset to 16 accumulator		ply			; release the memory		plx		jsr	call_release		mode_8		lda	col_size	; if restoring to 40,		bmi	q_pop_vp	; might have to move the port		brl	fix_4080q_pop_vp		brl	cv_bas_calc	; (rts);----------------------------------------------------------;;  $05  Horizontal Scroll;con_h_shift	short		lda	#10		; horizontal shift state code		sta	console_state		rts;----------------------------------------------------------;;  $06  Set Vertical Position;con_v_pos	short		lda	#12		; VTAB state code		sta	console_state		rts;----------------------------------------------------------;;  $07  Ring Bell;con_bell	mode_16		ldx	#$2C03		; Misc tools, sys beep		jsl	$E10000		mode_8		rts;----------------------------------------------------------;;  $08  Cursor left (backspace);con_left	short		lda	ch		; are we at the left edge?		cmp	wnd_left		bne	con_left_1	; no.  move left and quit.		lda	cons_wrap	; wrap mode?		beq	q_con_left	; no.  stay put.		lda	wnd_right		sta	ch		brl	con_up		; (rts) and maybe scrollcon_left_1		dec	ch		; no.q_con_left		rts;----------------------------------------------------------;;  $0A  Line feed;con_lf		short		lda	cv		; are we at the bottom?		cmp	wnd_bottom		beq	con_lf_1	; yes.  maybe scroll		inc	cv		brl	cv_bas_calc	; (rts) we moved so recalc line basecon_lf_1		lda	cons_scroll	; scrolling allowed?		bpl	con_lf_2	; no.		brl	scroll_up	; yes.  move the page.con_lf_2		rts;----------------------------------------------------------;;  $0B  Clear to end of port;con_clr_eov	short		jsr	con_clr_eol	; clear cursor's line		ldy	cv		; are we already done?		cpy	wnd_bottom		beq	con_clr_eov_1		iny			; clear from next line to end		jsr	clr_screencon_clr_eov_1		rts;----------------------------------------------------------;;  $0C  Clear screen and home.;con_clr_vp	short		ldy	wnd_left	; home cursor		sty	ch		ldy	wnd_top		sty	cv		jsr	clr_screen	; clear screen		brl	cv_bas_calc	; (rts) recalc cursor address;----------------------------------------------------------;;  $0D  Carriage Return;con_return	short		lda	wnd_left	; move to left edge		sta	ch		lda	cons_lf		; move down enabled?		bmi	con_lf		; yes.  execute line feed.		rts;----------------------------------------------------------;;  $0E  Set normal display mode;con_norm	short		lda	#$80		; set inverse mode		sta	cons_video		lda	#$A0		; fill character to normal spaces		sta	cons_fill		rts;----------------------------------------------------------;;  $0F  Set inverse display mode;con_inv		short		stz	cons_video	; video = 00		lda	#$20		; fill = inverse space		sta	cons_fill		rts;----------------------------------------------------------;;  $10  DLE space expansion;con_dle		short		lda	cons_dle	; dle enabled?		bpl	con_dle_1	; no.  print the next byte		lda	#14		; dle state code		sta	console_statecon_dle_1		rts;----------------------------------------------------------;;  $11  Set 40 column mode;con_40_col	short		lda	col_size	; are we already there?		bmi	con_40_1		rts			; yes.  no operation.con_40_1		jsr	tr_8040		; convert screen contents		sta	>clr80vid	; done.  kill 80 col hardware.		stz	col_size	; and set for 40 mode;  The following code fixes the viewport if the environment changes;  from 80 to 40 columns.  If the viewport will fit, it attempts to;  maintain the size of the viewport by completely shifting it to the;  left into the 40 column area.  If that doesn't work, the viewport;  simply shrinks to 40 columns wide.fix_4080	short		lda	wnd_width	; will the viewport fit?		cmp	#41		blt	fix_1;  No.  Just make it 40 columns wide and put the cursor;  somewhere in the main screen area.		stz	wnd_left	; text port -> full 40		lda	#39		sta	wnd_right		lda	ch		; cursor on screen?		cmp	#40		blt	fix_done	; yes.  leave it alone		stz	ch		; no.  set to left edge.;  The port will fit in 40 columns wide.  Shift if necessary.fix_1		lda	wnd_right	; is right edge on screen?		cmp	#40		blt	fix_done		sec			; compute shift vector		sbc	#39		sta	dp_temp_2				sec		lda	wnd_right		sbc	dp_temp_2	;adjust the right edge		sta	wnd_right		lda	wnd_left	; shift left edge		sec		sbc	dp_temp_2		sta	wnd_left		lda	ch		; shift cursor		sec		sbc	dp_temp_2		sta	chfix_done		sec			; and fix wnd_width		lda	wnd_right		sbc	wnd_left		inc	a		sta	wnd_width		rts;----------------------------------------------------------;;  $12  Set 80 column mode;con_80_col	short		lda	col_size	; already there?		bpl	con_80_1		rtscon_80_1		jsr	tr_4080		sta	>set80vid	; turn on 80 screen		lda	#$80		; and set 80 mode for myself		sta	col_size		rts;----------------------------------------------------------;;  $13  Clear from beginning of text port;con_clr_bov	short		jsr	con_clr_bol	; clear the front of this line		ldy	wnd_topcon_clr_bov_1		cpy	cv		beq	con_clr_bov_2		phy		jsr	clr_line	; clearing from top down		ply		iny			; move down and repeat		bra	con_clr_bov_1con_clr_bov_2		rts;----------------------------------------------------------;;  $14  Set horizontal position;con_h_pos	short		lda	#16		; HTab state code		sta	console_state		rts;----------------------------------------------------------;;  $15  Set cursor movement flags;con_mode	short		lda	#18		; cursor flags state code		sta	console_state		rts;----------------------------------------------------------;;  $16  Scroll down;con_scr_dn	short		brl	scroll_down	; (rts);----------------------------------------------------------;;  $17  Scroll up;con_scr_up	short		brl	scroll_up	; (rts);----------------------------------------------------------;;  $18  MouseText off;con_mt_off	short		stz	cons_mouse		rts;----------------------------------------------------------;;  $19  Home cursor;con_home	short		lda	wnd_left		sta	ch		lda	wnd_top		sta	cv		brl	cv_bas_calc	; (rts);----------------------------------------------------------;;  $1A  Clear line;con_clr_ln	short		ldy	cv		; clear the line		brl	clr_line	; (rts);----------------------------------------------------------;;  $1B  MouseText on;con_mt_on	short		lda	#$80		sta	cons_mouse		rts;----------------------------------------------------------;;  $1D  Clear to end of line;con_clr_eol	short		ldx	ch		; left/right bounds		ldy	wnd_right		jsr	spc_cmp_bnds	; compute bounds for clear line		ldy	cv		brl	spc_clear_line	; (rts);----------------------------------------------------------;;  $1E  Goto XY;con_goto_xy	short		lda	#20		sta	console_state		rts;----------------------------------------------------------;;  $1F  Move cursor up (reverse line feed);con_up		short		lda	cv		; at top?		cmp	wnd_top		beq	con_up_2	; yes.  maybe scroll		dec	cv		; no.  move up		brl	cv_bas_calc	; (rts) fix ptrs and quitcon_up_2		lda	cons_scroll	; hitting top.  scroll?		bmi	con_up_3	; yes.		rts			; no.  stay put.con_up_3		brl	scroll_down	; (rts)		eject;----------------------------------------------------------;;  The following are completion routines for the multi-byte;  command sequences.  Some finish the command and reset the;  state for a new command or character.  Others are midway,;  they do part of the work and set the state for yet another;  handler.;;----------------------------------------------------------;-----------------------------------------------------------;;  Completion routine #1:  Set viewport, parm= new left;comp_vp_left	short		sec			; parm is +32		sbc	#32		bpl	comp_vp_left_1	; check for left clip		lda	#0		; .lt. 0 : reset to 0		bra	comp_vp_left_3comp_vp_left_1		ldx	col_size	; what is physical right bound?		bmi	comp_vp_left_2		cmp	#40		; check 40 column screen		blt	comp_vp_left_3		lda	#39		; clip to right side		bra	comp_vp_left_3comp_vp_left_2		cmp	#80		; check 80 column screen		blt	comp_vp_left_3		lda	#79		; clip to right sidecomp_vp_left_3		sta	wnd_left	; set the new value		sta	ch		; and put the cursor there		lda	#4		; set state for next parm		sta	console_state		rts;-----------------------------------------------------------;;  Completion routine #2:  Set viewport, parm= new top;comp_vp_top	short		sec			; parm is +32		sbc	#32		bpl	comp_vp_top_1	; check for top clip		lda	#0		; .lt. 0 : reset to 0		bra	comp_vp_top_2comp_vp_top_1		cmp	#24		; check for bottom clip		blt	comp_vp_top_2		lda	#23		; clip to screen bottomcomp_vp_top_2		sta	wnd_top		; set the new value		sta	cv		; and put the cursor there		lda	#6		; set state for next parm		sta	console_state		brl	cv_bas_calc;-----------------------------------------------------------;;  Completion routine #3:  Set viewport, parm= new right;comp_vp_rt	short		ldy	#39		bit	col_size	; compute right edge		bpl	comp_vp_rt_1		ldy	#79comp_vp_rt_1		sty	dp_temp_2		sec			; parm is +32		sbc	#32		bpl	comp_vp_rt_2	; if negative #, set to edge		lda	dp_temp_2		bra	comp_vp_rt_4comp_vp_rt_2		cmp	wnd_left	; >= left edge?		bge	comp_vp_rt_3		lda	wnd_left	; no.  make 1 char wide.comp_vp_rt_3		cmp	dp_temp_2	; on screen?		blt	comp_vp_rt_4		lda	dp_temp_2	; no.  clip to right edgecomp_vp_rt_4		sta	wnd_right	; set the new value.		sec		sbc	wnd_left	; calculate new width		inc	a		sta	wnd_width		lda	#8		; store next state		sta	console_state		rts;-----------------------------------------------------------;;  Completion routine #4:  Set viewport, parm= new bottom;comp_vp_bt	short		sec			; parm is +32		sbc	#32		bpl	comp_vp_bt_1	; if negative #, set to bottom		lda	#23		bra	comp_vp_bt_3comp_vp_bt_1		cmp	wnd_top		; >= top?		bge	comp_vp_bt_2		lda	wnd_top		; no.  make 1 char tallcomp_vp_bt_2		cmp	#23		; on screen?		blt	comp_vp_bt_3		lda	#23		; no.  clip to topcomp_vp_bt_3		sta	wnd_bottom	; set the new value.		sec		sbc	wnd_top		; calculate new length		inc	a		sta	wnd_length		stz	console_state	; sequence finished		rts;-----------------------------------------------------------;;  Completion routine #5:  Horizontal Scroll;comp_h_scr	short		stz	console_state	; this will end this sequence		stz	minus		; assume right shift		tax			; test the shift value		bne	comp_h_scr_1		rts			; it was zero.  bye bye.comp_h_scr_1		bpl	comp_h_scr_2		eor	#$ff		; two's complement		inc	a		dec	minus		; 0 -> -1comp_h_scr_2		sta	shift		cmp	wnd_width	; is it >= window size?		bge	con_h_scr_3	; yes.  execute clear screen		brl	shift_it	; (rts) shift screen; ; Shift size is greater than or equal to the window size so clear it;con_h_scr_3		ldy	wnd_top		brl	clr_screen	; (rts);-----------------------------------------------------------;;  Completion routine #6:  Vertical Tab;comp_vtab	short		stz	console_state		brl	set_vtab	; (rts);-----------------------------------------------------------;;  Completion routine #7:  DLE space expansion;comp_dle	short		sec		sbc	#32		sta	dle_countcomp_dle_1		beq	comp_dle_2		lda	cons_fill		jsr	display_it		dec	dle_count		bra	comp_dle_1comp_dle_2		stz	console_state		rts;-----------------------------------------------------------;;  Completion routine #8:  Horizontal Tab;comp_htab	short		stz	console_state		brl	set_htab	; (rts);----------------------------------------------------------;;  Completion routine #9:  Cursor movement control;comp_mode	short		stz	cons_advance	; zero out the destinations		stz	cons_lf		stz	cons_wrap		stz	cons_scroll		stz	cons_dle		lsr	a		; roll out the bits		ror	cons_advance		lsr	a		ror	cons_lf		lsr	a		ror	cons_wrap		lsr	a		ror	cons_scroll		lsr	a		ror	cons_dle		stz	console_state		rts;----------------------------------------------------------;;  Completion routine #10:  Goto XY   parm = new relative ch;comp_goto_x	short		jsr	set_htab		lda	#22		; setup for second byte		sta	console_state		rts;----------------------------------------------------------;;  Completion routine #11:  Goto XY   parm = new relative cv;comp_goto_y	short		jsr	set_vtab		stz	console_state	; done.		rts;----------------------------------------------------------;;  set_vtab;  set_htab;;  These are called by the set_h, set_v, and goto_xy routines.;set_vtab	short		sec		sbc	#32		clc		adc	wnd_top		; relative coords.		bpl	set_vtab_1	; off screen?		lda	wnd_topset_vtab_1		cmp	wnd_top		; too high?		bge	set_vtab_2		lda	wnd_topset_vtab_2		cmp	wnd_bottom		blt	set_vtab_3		lda	wnd_bottomset_vtab_3		sta	cv		brl	cv_bas_calc	; (rts)set_htab	short		sec		sbc	#32		clc		adc	wnd_left	; relative coords.		bpl	set_htab_1	; off screen?		lda	wnd_leftset_htab_1		cmp	wnd_left	; too high?		bge	set_htab_2		lda	wnd_leftset_htab_2		cmp	wnd_right		blt	set_htab_3		lda	wnd_rightset_htab_3		sta	ch		rts		eject;-----------------------------------------------------------------------------;;  file cons.sub;;  Subroutines for the console driver output routines- scrolling,;  display, clear screen, etc.;;  Copyright (C) 1987 Apple Computer, Inc.;  All Rights Reserved.;;  Modification History:;;  10-Aug-87    Upgraded to GS/OS source code rules;  16-Sep-87    Many things rewritten;  01-Feb-88    Initial release;  04-Feb-88    Fixed scroller;;-----------------------------------------------------------------------------;;  Base address tables for screen lines.line_tbl		DC.W	$400,$480,$500,$580 ; Lines 0-3		DC.W	$600,$680,$700,$780 ; Lines 4-7		DC.W	$428,$4A8,$528,$5A8 ; Lines 8-11		DC.W	$628,$6A8,$728,$7A8 ; Lines 12-15		DC.W	$450,$4D0,$550,$5D0 ; Lines 16-19		DC.W	$650,$6D0,$750,$7D0 ; Lines 20-23; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  cv_bas_calc;   y_bas_calc;;  These routines calculate screen base addresses.  cv_bas_calc uses;  the current value of cv and places the base address in cur_base.;  It is called each time the console is entered, and every time;  cv might change.  y_bas_calc uses the value passed in y and returns;  line_base.;cv_bas_calc	short		lda	cv		jsr	bas_calc	; returns in LONG MODE		long		sta	cur_base		lda	#$0000		; use mega// memory directly		sta	cur_base+2		mode_8		rts			; return in SHORT modey_bas_calc	short		tya		jsr	bas_calc	; returns in LONG mode		long		sta	line_base		lda	#$0000		; use mega// memory directly		sta	line_base+2		mode_8			; return in SHORT mode		rtsbas_calc	short		asl	a		tax		mode_16		lda	line_tbl,x		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -; COMPUTE BOUNDS - this routine computes the bounds of a screen;                  line, based on wnd_left and wnd_right.;; SPC_CMP_BNDS - Similar, but uses X as the left bound and Y as;                the right bound.;cmp_bnds	short		ldx	wnd_left		ldy	wnd_rightspc_cmp_bnds	short		lda	col_size	; 40 or 80 columns		bmi	cmp_bnds_1;; 40 column routine;		stx	lft1_bound	; easy!		sty	rgt1_bound		rts;80 column version cmp_bnds_1		txa			; Set up to compute left hand bound		lsr	a		; Divide it by 2		sta	lft1_bound	; Store it away for page 1		bcc	cmp_bnds_2		inc	acmp_bnds_2	sta	lft2_bound	; Store it away for page 2		tya		lsr	a		sta	rgt2_bound		bcs	cmp_bnds_3		dec	acmp_bnds_3	sta	rgt1_bound		rts			; All done now!!; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  CLEAR_LINE - clears the line whose number is in Y-REG (0-23);  This routine clears from the right edge of the current viewport to;  the left edge.;;  SPC CLEAR LINE - similar, but I have to do the bounds calculations;                   before hand.  This allows stuff like clear to eol.;clr_line	short		phy		jsr	cmp_bnds	; calculate left & right bounds		plyspc_clear_line	short		jsr	y_bas_calc	; setup line address		lda	>txtpage1	; do page 1 stuff		ldx	lft1_bound		ldy	rgt1_bound		jsr	clear_a_line	; clear it!		lda	col_size	; 80 columns?		bpl	q_clr_line		lda	>txtpage2	; yes, clear them too		ldx	lft2_bound		ldy	rgt2_bound		jsr	clear_a_lineq_clr_line	rts;  This subroutine clears a single line.  But first it checks;  the bounds (passed in x and y) and quits if they're not legal.;  This makes us work ok in single column viewports.clear_a_line	short		stx	dp_temp_2	; save left bound		cpy	dp_temp_2	; left bound		blt	q_clr_a_line	; too far, quit now		bmi	q_clr_a_line	; special case				iny			; futz around		lda	cons_fill	; what to clear toclr_line_lp	dey		sta	[line_base],y		cpy	dp_temp_2	; at end yet?		bne	clr_line_lpq_clr_a_line	rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -; CLEAR_SCREEN - will clear the current viewport, starting at the;                absolute line # passed in Y;clr_screen	short		phy			; save current line		jsr	clr_line		ply		cpy	wnd_bottom		bge	q_clr_screen		iny		bra	clr_screenq_clr_screen	rts		; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -; SCROLL UP - this routine will scroll the contents of the viewport upwards.;scroll_up	short		jsr	cmp_bnds	; calculate left & right sides		lda	wnd_top		; start at top and work down		sta	num_linesscrl_up_lp		lda	num_lines	; are we at bottom yet?		cmp	wnd_bottom		beq	q_scrl_up		tax			; source line is cur + 1		inx		jsr	scroll_base	; calculate pointers		jsr	scroll_copy	; copy the data		inc	num_lines	; move down 1		bra	scrl_up_lpq_scrl_up		dec	origin_v	; update UIR variable		tay			; bottom line was in A		brl	clr_line	; clear it!; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -; SCROLL DOWN - this routine will scroll the contents of the viewport down.; It uses the values that define the viewport (see above);; Uses num_lines from scroll up procedure;scroll_down	short		jsr	cmp_bnds	; calculate left & right sides		lda	wnd_bottom	; start at bottom and work up		sta	num_linesscrl_down_lp		lda	num_lines	; are we at top yet?		cmp	wnd_top		beq	q_scrl_down		tax			; source line is cur - 1		dex		jsr	scroll_base	; calculate pointers		jsr	scroll_copy	; copy the data		dec	num_lines	; move down 1		bra	scrl_down_lpq_scrl_down		inc	origin_v	; update UIR variable		tay			; top line was in A		brl	clr_line	; clear it!; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;;  SCROLL BASE - Calculates the base addresses for the source line;                (passed in X) and the destination line (passed in A);                and puts them in src_line and dst_line.scroll_base	short		pha			; remember destination		txy		jsr	y_bas_calc	; of source		mode_16		lda	line_base	; copy pointer		sta	src_line		lda	line_base+2		sta	src_line+2		mode_8		ply			; get dest line		jsr	y_bas_calc		mode_16		lda	line_base	; copy pointer		sta	dst_line		lda	line_base+2		sta	dst_line+2		mode_8		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  SCROLL COPY - Copies data from src_line to dst_line, using;                bounds set up by cmp_bnds.scroll_copy	short		lda	>txtpage1	; do page 1 stuff		longa	on		rep	#$30				clc		lda	lft1_bound		and	#$00FF		pha		adc	src_line	; load in the source address		tax				clc		pla		adc	dst_line	; load in the destination count		tay				sec		sep	#$20		lda	rgt1_bound		sbc	lft1_bound	; calculate the number of bytes to move		bcc	@next_page		rep	#$20		and	#$00FF		phk		mvn	$000000,$000000		plb@next_page		longa	off		sep	#$20				lda	col_size	; 80 columns?		bpl	q_scr_copy		lda	>txtpage2	; yes, copy them too!		longa	on		rep	#$30		clc		lda	lft2_bound		and	#$00FF		pha		adc	src_line	; load in the source address		tax				clc		pla			; load in the destination count		adc	dst_line		tay				sec		sep	#$20		lda	rgt2_bound		sbc	lft2_bound	; calculate the number of bytes to move		bcc	q_scr_copy		rep	#$20		and	#$00FF		phk		mvn	$000000,$000000		plbq_scr_copy			longa	off		sep	#$30		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -; VIEWPORT SAVE - Save the viewport into the buffer starting at;                 [msg_ptr].  The format of the save is;                 wnd_width, wnd_length, screen bytes.  Therefore;                 the minimum size of the buffer must be;                 (wnd_width * wnd_length) + 2 bytes.vp_save		short		sta	>set80col	; status call, needs setup!		mode_16		lda	msg_ptr		; copy msg_ptr into dp_temp_1		sta	dp_temp_1		lda	msg_ptr+2		sta	dp_temp_1+2		mode_8		lda	wnd_width	; save width & length		sta	[dp_temp_1]		jsr	inc_dp_temp		lda	wnd_length		sta	[dp_temp_1]		jsr	inc_dp_temp		lda	wnd_top		; remember first line		sta	line_num		jsr	cmp_bnds	; compute left and right sidesvp_save_lp		ldy	line_num		jsr	y_bas_calc		lda	#$00E0		; use mega// memory directly		sta	line_base+2		jsr	save_line	; copy current line into buffer		lda	line_num		cmp	wnd_bottom	; done?		beq	q_vp_save		inc	line_num	; no.  move down a line		bra	vp_save_lpq_vp_save		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  SAVE LINE - Copy the line at [line_base] into the buffer;              at [dp_temp_1] and then increment dp_temp_1;              by wnd_width so its ready for the next line!save_line	short		ldy	lft1_bound	; assuming 40 col ...		lda	col_size	; test size		bpl	start_with_main	; 40 columns, use main mem only		cpy	lft2_bound	; 80.  Start with aux or main?		bne	start_with_main	;                (even)  (odd)save_line_lp		lda	>txtpage2	; start with aux data (even column)		lda	[line_base],y	; copy the byte		sta	[dp_temp_1]		jsr	inc_dp_temp	; move destination pointer		cpy	rgt2_bound	; done?		bne	start_with_main	; no		cpy	rgt1_bound	; maybe...		bne	q_save_line	; done!start_with_main		lda	>txtpage1	; now do the even column		lda	[line_base],y		sta	[dp_temp_1]		jsr	inc_dp_temp		iny			; move over ...		lda	col_size	; 40 or 80?		bmi	save_80_test		cpy	rgt1_bound	; 40.  Done?		blt	start_with_main		beq	start_with_main	; no		bra	q_save_linesave_80_test		cpy	rgt2_bound	; more to get from aux page?		blt	save_line_lp		beq	save_line_lp	; ah but for the lack of bleq_save_line		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -; VIEWPORT RESTORE - Copy the data from the viewport buffer at;                    [msg_ptr] into the current viewport.  This;                    is a bit tricky when the viewport is not;                    the same size as the data stored in the buffer.vp_restore	short		sta	>set80col	; status call, needs setup!		mode_16		lda	msg_ptr		; use dp_temp_1		sta	dp_temp_1		lda	msg_ptr+2		sta	dp_temp_1+2		mode_8		lda	[dp_temp_1]	; get width		sta	buffer_width		beq	vp_exit		; do not handle a zero case				cmp	wnd_width	; use smaller of two for looping		blt	save_buf_wid		lda	wnd_widthsave_buf_wid		sta	restore_width		jsr	inc_dp_temp		lda	[dp_temp_1]	; get length		beq	vp_exit		; do not handle zero case				cmp	wnd_length	; use smaller of two		blt	save_buf_len		lda	wnd_length	; buffer too big, use vp sizesave_buf_len		sta	buffer_length		jsr	inc_dp_temp		jsr	cmp_bnds	; compute left & right bounds		lda	wnd_top		; where to start restoring to		sta	line_numvp_rest_lp		ldy	line_num		jsr	y_bas_calc		jsr	restore_line		mode_16		clc		lda	buffer_width	; 8-bit qty		and	#$00FF		adc	dp_temp_1	; move to next line of buffer		sta	dp_temp_1		bcc	vp_rest_1		inc	dp_temp_1+2vp_rest_1	mode_8		inc	line_num		dec	buffer_length	; loop until 0		bne	vp_rest_lpvp_exit		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  RESTORE LINE - Restore one line from [dp_temp_1] to the screen.;                 Assumes line_base points to the screen line,;                 lft1_bound and lft2_bound are set up, and;                 restore_width is the number of bytes to restore.;restore_line	short		ldy	lft1_bound	; screen index		sty	dp_temp_2		ldx	#0		; buffer index		lda	col_size	; 40 or 80?		bpl	restore_main	; 40.  Only use page 1.		cpy	lft2_bound	; 80.  start with aux or main?		bne	restore_main	; main first.restore_line_lp		lda	>txtpage2	; start with aux (even column)		txy			; get buffer index		lda	[dp_temp_1],y	; get data		ldy	dp_temp_2	; get screen index		sta	[line_base],y	; store data		inx			; move up in buffer		cpx	restore_width	; done?		beq	q_restore_linerestore_main		lda	>txtpage1	; now do odd column (main mem)		txy			; buffer index		lda	[dp_temp_1],y		ldy	dp_temp_2	; screen index		sta	[line_base],y		inc	dp_temp_2	; move over in screen addresses		inx			; done?		cpx	restore_width		beq	q_restore_line		lda	col_size	; no.  loop now for 40 or 80		bmi	restore_line_lp	; 80.  Goto page 2		bra	restore_main	; 40.  goto page 1q_restore_line		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  inc_dp_temp - Add 1 to dp_temp_1.  Used for moving through;                a buffer.inc_dp_temp	mode_16		inc	dp_temp_1		bne	q_inc_dp_temp		inc	dp_temp_1+2q_inc_dp_temp	mode_8		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  Shifting Routines -;;  Here's how they work.  First, copy the line into line_buffer.;  Then, adjust line buffer, moving the data which 'survives' and;  filling the rest with cons_fill characters.  Finally, write;  the entire buffer back to the screen.;;  This routine is called with the absolute shift vector in A, and;  'minus' 0 for right shift and -1 for left shift.;shift_it	short		jsr	cmp_bnds	; compute left and right bounds		lda	wnd_top		; start at top		sta	line_num		lda	wnd_width	; set width of viewport		sta	restore_widthshft_it_lp	mode_16		lda	#<line_buffer	; setup work buffer pointer		sta	dp_temp_1		lda	#^line_buffer		sta	dp_temp_1+2		mode_8		ldy	line_num		jsr	y_bas_calc		jsr	save_line	; (part of vp save routines)		jsr	shift_line	; adjust data in the buffer		mode_16		lda	#<line_buffer	; reset work buffer pointer		sta	dp_temp_1		lda	#^line_buffer		sta	dp_temp_1+2		mode_8		jsr	restore_line	; write it back to the screen		inc	line_num		lda	wnd_bottom		cmp	line_num		bge	shft_it_lp		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  SHIFT LINE - Adjust the line data in line_buffer.  If minus,;               shift left by the amount in shift.  If plus,;               shift to the right.  Fill the rest of the buffer;               with cons_fill.shift_line	short		lda	minus		; which way?		bpl	sh_line_rt	; -> right;  shift to the left.  compute the # of chars to copy and the src offset		ldx	shift		; source = shift value		ldy	#0		; dest = leftmostsh_lft_lp_1		lda	line_buffer,X	; get characters		sta	line_buffer,Y		iny		inx		cpx	wnd_width		bne	sh_lft_lp_1		ldx	shift		; fill width = shift #		lda	cons_fillsh_lft_lp_2		sta	line_buffer,Y		iny		dex		bne	sh_lft_lp_2		rts; SHIFT RIGHT - move bytes from left to right.sh_line_rt		lda	wnd_width	; dst = width - 1		dec	a		tay		sec		sbc	shift		; src = width - 1 - shift		taxsh_rt_lp_1		lda	line_buffer,x		sta	line_buffer,y		dey		dex		bpl	sh_rt_lp_1		lda	cons_fill	; finish by clearing the buffersh_rt_lp_2		sta	line_buffer,y		dey		bpl	sh_rt_lp_2		rts; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  tr_8040 - translate 80 column screen onto 40 screen.;tr_8040		short		ldy	#23		; start from bottom		sty	dp_temp_2		lda	>txtpage1	; first access will be #19/maintr_8040_1		ldy	dp_temp_2	; calculate base address		jsr	y_bas_calc		ldx	#39		; start from right edgetr_8040_2		txa			; divide col by 2 for 80 index		lsr	a		tay		bcs	tr_8040_3	; (40 col save has tpage1 set)		lda	>txtpage2	; even col.  use aux memtr_8040_3		lda	[line_base],y	; get char from 80 col screen		sta	>txtpage1	; save to 40 col screen		txy			; get 40 col index		sta	[line_base],y		dex			; move to right		bpl	tr_8040_2		dec	dp_temp_2	; move up one line		bpl	tr_8040_1		rts			; done.; - - - - - - - - - - - - - - - - - - - - - - - - - - - - -;  tr_4080 - translate 40 column screen onto 80 screen.;tr_4080		short		ldy	#23		; start at bottomtr_4080_1		sty	dp_temp_2		jsr	y_bas_calc	; calculate row address		ldx	#0		; start at left edgetr_4080_2		lda	>txtpage1	; read from 40 col		txy		lda	[line_base],y		pha			; save it		txa			; compute 80 col index		lsr	a		tay		bcs	tr_4080_3		lda	>txtpage2tr_4080_3		pla		sta	[line_base],y		inx			; move over		cpx	#40		; done yet?		blt	tr_4080_2		iny			; now clear right half		lda	cons_filltr_4080_4		sta	>txtpage1		sta	[line_base],y		sta	>txtpage2		sta	[line_base],y		iny			; loop till right edge		cpy	#40		blt	tr_4080_4		ldy	dp_temp_2	; move up to previous row		dey		bpl	tr_4080_1		rts			; done.;------------------------------------------------------------------------------**********************************************************************                                                                   **  File:  CONS.INPUT                                                **                                                                   **               U S E R   I N P U T   R O U T I N E                 **                                                                   **  This is the GS/OS console user input routine.  It implements     **  the 'standard' apple // line edit routine.                       **                                                                   **  Original version written by Lou Infeld, November, 1984           **  First IIgs adaptation by Jay Schaffer, March, 1987               **  GS/OS version by Andy Stadler, October, 1987                     **                                                                   **  Copyright (c) 1987 Apple Computer, Inc.                          **  All rights reserved.                                             **                                                                   ***********************************************************************                                                                   **  Calling:     native mode, 16 bit registers                       **                                                                   **  msg_ptr:     pointer to user's input buffer                      **  max_length:  user's request count.  this is the maximum width    **               of the input field.                                 **  input_info:  input control block containing cursor mode          **               defaults, entry type, pad character, etc.           **  entry_type:  input mode byte:                                    **                 0 = initial entry.  begin a new input             **                 1 = interrupt key re-entry.  continues input      **                     after an interrupt key was pressed.           ** Feature Removed 2 = no-wait mode re-entry.  continues input       **                     after a no-wait mode exit.                    **                                                                   **  Exit:        native mode, 16 bit registers                       **                                                                   **  input_length: final length of user's input                       **  exit_type:   0 = no-wait exit                                    **               # = terminator/interrupt entry #                    **  entry_type:  setup for next call (see above)                     **                                                                   **********************************************************************input		long		jsr	make_term_ptr	; setup terminator list		jsr	get_term_parms		mode_8;  Split here.  No-wait re-entries assume no changes;  so jump right into the read loop.		lda	entry_type;;  This is either an input start or an interrupt re-start.  The;  editing field needs to be refreshed.  If new, set up the defaults.;		cmp	#1		; interrupt?		beq	input_2		; yes.;  Begin a fresh edit session.  Calculate the size of the destination;  field.  Copy the default string to the input buffer.  And set up;  the cursor.		jsr	calc_field		jsr	copy_def_str		jsr	copy_curs_mode;  Now get ready to display the current input string and begin;  editing it.input_2		jsr	fake_controls	; make $0-$1F displayable		jsr	pad_input	; add fill chars to end of field		jsr	wr_full_string		jsr	set_cursor;		bra	read_loop;	fall through into read_loop		eject;----------------------------------------------------------;;  Read loop.;;  Loops, reading the keyboard, and interpreting keystrokes;  and either executing edit commands, or inserting characters;  into the input string.;;  There are two ways to leave the loop.  If no-wait mode is;  selected, the loop quits anytime no characters are available;  from the keyboard.  Otherwise we continue until a standard;  (not interrupt) terminator is typed.;;----------------------------------------------------------read_loop	short		jsr	next_char	; sets last_char & last_mod		bcc	read_loop	; nothing to do yet	read_loop_1	short		jsr	check_special	; terminator or edit key?		bcs	read_loop_2	; a terminator was found.		cpx	#-1		; already handled?		beq	read_loop		cpx	#0		; terminator?		bne	read_loop_2		jsr	add_to_str	; X=0 : type key into string		bra	read_loopread_loop_2		lda	last_term+1	; get terminator's mod byte		and	#$20		; to find out which type.		beq	q_read_loop	; real.  exit with A=0		lda	#1		; interrupt.  restart with 1.q_read_loop		stx	exit_type	; save terminator #		sta	entry_type	; prepare for next entry		jsr	rmv_cursor	; remove cursor from screen		jsr	fix_controls	; control chars -> true values		mode_16			; exit in 16 bits		rts		eject;----------------------------------------------------------;;               Input Subroutines;;----------------------------------------------------------;----------------------------------------------------------;;  fake_controls;  fix_controls;;  Internally, I represent control characters in the input;  string by shifting them into the 'special inverse' region.;  This means I must pre-process the input string on entry;  and fix it up on exit.;;----------------------------------------------------------fake_controls	short		ldy	input_length		beq	q_fake_controlsfake_ctrl_lp		dey		lda	[input_str],y		cmp	#$20		; control?		bge	nx_fake_ctrl		ora	#$80		; $00-$1F -> $80-$9F		sta	[input_str],ynx_fake_ctrl		tyx		bne	fake_ctrl_lpq_fake_controls		rtsfix_controls	short		ldy	input_length		beq	q_fix_controlsfix_ctrl_lp		dey		lda	[input_str],y		cmp	#$9F		; control?		bge	nx_fix_ctrl		cmp	#$80		blt	nx_fix_ctrl		and	#$7F		; $80-$9F -> $00-$1F		sta	[input_str],ynx_fix_ctrl		tyx		bne	fix_ctrl_lpq_fix_controls		rts		eject;----------------------------------------------------------;;  calc_field;;  Records the maximum input field, based on the cursor;  starting position and the size of the window ;  user;  input request count ;  and the driver max of 254.;;  The formula for the amount of screen to work with is:;;  [ (wnd_width) * (wnd_bot - cv + 1) ] - origin_x;;                (proof left to reader);;  In addition, calculates origin_x and saves it for later.;;----------------------------------------------------------calc_field	short		lda	ch		; record start position		sta	origin_h		sec		sbc	wnd_left		sta	origin_x	; 16 bit quantity, always <255		stz	origin_x+1		lda	cv		sta	origin_v		lda	wnd_bottom	; setup index for cheap multiply		sec		sbc	cv		inc	a		tax		mode_16		lda	wnd_width		and	#$00FF		sta	dp_temp_1		lda	#0calc_fld_lp		clc		adc	dp_temp_1		dex		bne	calc_fld_lp		sec		sbc	origin_x;  Now calculate input_field by the following equation:;;  input_field = MIN (max_length, field_length-2, 254)		dec	a		; field_length in A		cmp	#255		blt	calc_field_1		lda	#254		; field much bigger than we needcalc_field_1	mode_8		ldx	cons_scroll	; allow scrolling?		bne	@do_scroll	; yes...		cmp	max_length	; how about user request		blt	calc_field_2	; field is too small@do_scroll		lda	max_length	; usually use user's requestcalc_field_2	sta	input_field		rts		eject;----------------------------------------------------------;;  copy_def_str - Starting a new input.  Copy the default;                 string into the user buffer.  Use a length;                 of MIN (def_len, input_field);;----------------------------------------------------------copy_def_str	short		lda	def_str_len	; always <255		beq	copy_def_1		cmp	input_field		blt	copy_def_1	; take the smaller of the two		lda	input_fieldcopy_def_1		sta	input_length		beq	q_copy_def	; quit here if no def string		pha		mode_16		jsr	make_def_ptr		mode_8		plycopy_def_lp		dey		lda	[def_str_ptr],y		sta	[input_str],y		tyx		bne	copy_def_lpq_copy_def		rts			; exit 8-bit		eject;----------------------------------------------------------;;  pad_input    - from the end of the string to the end of;                 the field, pad the input buffer with;                 fill characters (fill_char);;----------------------------------------------------------pad_input	short		ldy	input_length		lda	fill_charpad_input_lp		cpy	input_field		beq	q_pad_input		sta	[input_str],y		iny		bra	pad_input_lpq_pad_input		rts		eject;----------------------------------------------------------;;  copy_curs_mode - copies def_cursor into cursor_mode.  Then,;                   based on (1) size of string and (2) cursor;                   mode, choose a 0..n position for it.;;-----------------------------------------------------------copy_curs_mode	short		lda	def_cursor		sta	cursor_mode		stz	cursor_pos	; assume start of string		bmi	copy_curs_1		lda	input_length	; but if mode indicates,		sta	cursor_pos	; put it at the end.copy_curs_1		lda	#-1		; initialize cursor		sta	flash_flag		rts		eject;----------------------------------------------------------;;  set_cursor;;  First, remove the cursor (if displayed) from the screen.;  Then, based on origin_h, origin_v, and cursor_pos, move;  the cursor (ch, cv) to the correct screen position.;;  ch = wnd_left + [(cursor_pos + origin_x) MOD wnd_width];  cv = origin_v + [(cursor_pos + origin_x) DIV wnd_width];;  Finally, if we have moved to cursor_pos == input_field,;  which is actually 1 beyond the field, record the character;  underneath the cursor.  This way we can non-destructively;  blink outside of our given workspace.;;-----------------------------------------------------------set_cursor	short		jsr	rmv_cursor	; take it away and re-initialize		mode_16		lda	wnd_width	; make 16 bit version of w_w		and	#$00FF		sta	dp_temp_2		lda	cursor_pos	; add an 8 bit qty		and	#$00FF		clc		adc	origin_x	; to a 16 bit qty		stz	dp_temp_1	; count DIV hereset_cursor_lp		cmp	dp_temp_2		blt	set_cursor_1		sbc	dp_temp_2	; carry's already set		inc	dp_temp_1		bra	set_cursor_lpset_cursor_1	mode_8		clc		adc	wnd_left		sta	ch		lda	dp_temp_1		clc		adc	origin_v		sta	cv		jsr	cv_bas_calc;  record screen char if at end of field		lda	cursor_pos		cmp	input_field		bne	q_set_cursor		sta	>txtpage1		lda	ch		bit	col_size	; screen mode?		bpl	set_cursor_2	; 40.		lsr	a		; 80.  choose even or odd		bcs	set_cursor_2		sta	>txtpage2	; evenset_cursor_2		tay		lda	[cur_base],y		sta	bord_char		sta	>txtpage1q_set_cursor		rts		eject;----------------------------------------------------------;;  rmv_cursor;;  If the cursor is currently displayed (flash_flag = +1);  remove it from the screen.  Then reset the cursor to;  non-initialized state (flash_flag = -1).;;----------------------------------------------------------rmv_cursor	short		dec	flash_flag	; showing cursor?		bne	rmv_curs_1	; if <> 1, not showing		jsr	draw_char	; erase the cursor.rmv_curs_1		lda	#-1		sta	flash_flag		rts		eject;----------------------------------------------------------;;  init_curs_tim;;  This installs a VBL task which will be the cursor timer.;  At installation time the timer is disabled, but later the;  timer will be activated each time a cursor phase is;  begun.;;  Output:  C = installation status;;----------------------------------------------------------init_curs_tim	long		stz	curs_int_cnt	; don't start yet!		pea	curs_tim_hdr>>16		pea	curs_tim_hdr		ldx	#$1203		jsl	$E10000		; SetHeartBeat toolbox call		bcs	q_init_vbl	; something's awry		pea	$0002		; vbl ON		ldx	#$2303		jsl	$E10000		; IntSource toolbox callq_init_vbl	rts;----------------------------------------------------------;;  rmv_curs_time;;  Remove the cursor interrupt timer.;;----------------------------------------------------------rmv_curs_time	long		pea	curs_tim_hdr>>16		pea	curs_tim_hdr		ldx	#$1303		jsl	$E10000		; DelHeartBeat toolbox call		rts		eject;----------------------------------------------------------;;  This is the cursor interrupt handler.  It works like;  this:  If you want to get a message sometime later,;  put the number of ticks into curs_int_cnt.  That many;  ticks later, curs_int_flag will be incremented.;;----------------------------------------------------------curs_tim_hdr	short		DS.B	4		; space for interrupt chaincurs_int_cnt	DS.B	2		; interrupt count		DC.B	$5A,$A5		; goofy signature		phk			; this is the handler		plb		stz	curs_int_cnt		stz	curs_int_cnt+1		inc	curs_int_flag		rtl		eject;----------------------------------------------------------;;  blink;;  This handles blinking the cursor.  The key player here is;  'flash_flag' which has three values:;;  -1 = cursor not displayed, timer not running;   0 = cursor displayed, timer running;  +1 = character displayed, timer running;;  If curs_int_flag becomes non-zero, it's time for the cursor;  to change state.  This is done by drawing the new cursor and;  resetting the cursor timer.;;----------------------------------------------------------blink		short		lda	flash_flag	; cursor initialized?		bpl	blink_run	; yes.  keep running.;  Time to initialize the cursor.  We always initialize to;  'display cursor' mode.  This keeps the cursor on the screen;  during cursor movement, etc.		lda	#1		; 'cursor on'		sta	flash_flag		jsr	set_curs_time	; reset the timer		brl	draw_cursor	; (rts) show the cursor;  Cursor is currently displayed.  If time for a new one,;  invert state and redraw.blink_run		lda	curs_int_flag	; timed out yet?		bne	blink_1		; yes...		rts			; no.  done.;  ok.  time for a new cursorblink_1		lda	flash_flag		eor	#1		and	#1		sta	flash_flag		jsr	set_curs_time	; reset the timer		lda	flash_flag		beq	blink_off	; go for character display		jsr	draw_cursor	; now its curs time		brl	new_curs_rateblink_off		jsr	draw_char	; now its char time		brl	new_curs_rate		eject;----------------------------------------------------------;;  set_curs_time;;  Based on (1) cursor state, (2) insert mode, and (3) control;  panel cursor flash rate ; pick a new time constant for the;  cursor speed.;;  The basic cursor flash rates (normal speed) are:;;                 Insert mode        Overstrike mode;  Cursor      :    15 ticks             30 ticks;  Character   :    30 ticks             15 ticks;;  Where 'ticks' are 1/60 of a second intervals signalled by;  VBL interrupts.;;----------------------------------------------------------set_curs_time	short		stz	curs_int_flag		stz	curs_int_cnt+1	; (always <= 255)		lda	flash_flag	; compute cursor state		eor	cursor_mode		and	#1		beq	set_curs_long;  set for short flash time.		lda	cursor_rate		sta	curs_int_cnt		rts;  set for long flash timeset_curs_long		lda	cursor_rate		asl	a		sta	curs_int_cnt		rts		eject;----------------------------------------------------------;;  new_curs_rate;;  Lookup the current cursor speed # from the battery RAM.;  From this number [0..4] pick a time constant from a table,;  which is the number of ticks duration for a short flash.;;----------------------------------------------------------curs_time_tb	DC.B	22,18,15,11,8new_curs_rate	mode_16			; (call in 8 mode)		pha			; get flash rate from pRam		pea	$002F		ldx	#$0C03		jsl	$E10000		plx		mode_8		bcs	set_ctime_1	; something wrong...  take default		lda	curs_time_tb,X	; get flash tick time		bra	set_ctime_2set_ctime_1		lda	curs_time_tb+2	; error.  use the default rateset_ctime_2		sta	cursor_rate		rts		eject;----------------------------------------------------------;;  draw_cursor;;  Draw the cursor....;;----------------------------------------------------------draw_cursor	short		stz	cons_advance	; stay put!		lda	cursor_mode	; which type?		ror	a		bcc	draw_ins_curs	; insert cursor.;  overstrike cursor.  set inverse display mode and print;  the actual character, unless we are past the end of the;  string, where we print the reverse of the fill_char.;  That is, unless the fill_char is MouseText, in which case;  no inverse exists, thus we default in that case to a simple;  inverse space.  Is this exciting or what?  But wait, there's;  more.  If we are beyond the very very end of the field,;  we also print this simple inverse space.  Now how much would;  you pay?		lda	cons_video	; set inverse of current mode		pha		eor	#$80		and	#$80		sta	cons_video		lda	fill_char	; assume past end		cmp	#$C0		; mouse text?		blt	draw_curs_1	; no		cmp	#$E0		; mouse text?		bge	draw_curs_1		lda	#$20		; mouse fill chars become spacedraw_curs_1		ldy	cursor_pos	; where are we?		cpy	input_field	; at very very end?		bne	draw_curs_2		lda	#$20		; yes. draw inv. space		bra	draw_curs_pastdraw_curs_2		cpy	input_length	; in filler space?		bge	draw_curs_past	; yes.  a = fill_char		lda	[input_str],y	; within string - take a chardraw_curs_past		jsr	char_out	; draw it!		pla			; restore video mode		sta	cons_video		bra	q_draw_curs;  draw an insert cursor.  this is easy, just print a '_'.draw_ins_curs		lda	#'_'				jsr	char_outq_draw_curs		lda	#$80		; restore cursor advance		sta	cons_advance		rts		eject;----------------------------------------------------------;;  Draw_char;;  Draw the character underneath the cursor position,;  or fill_char if in the padded area, or bord_char if;  outside of the input field.;;----------------------------------------------------------draw_char	short		ldy	cursor_pos		cpy	input_field	; very worstest case?		beq	draw_char_2		lda	fill_char	; assume the next most worst		cpy	input_length		bge	draw_char_1		lda	[input_str],y	; its only the somewhat disagreeabledraw_char_1		stz	cons_advance	; freeze position		jsr	char_out	; print the sucker		lda	#$80		; release cursor		sta	cons_advance		rtsdraw_char_2		sta	>txtpage1	; we must write directly to screen		lda	ch		bit	col_size	; screen mode?		bpl	draw_char_3	; 40.		lsr	a		; 80.  choose even or odd		bcs	draw_char_3		sta	>txtpage2	; evendraw_char_3		tay		lda	bord_char		sta	[cur_base],y		sta	>txtpage1		rts		eject;----------------------------------------------------------;;  wr_full_string - output the entire string.;;  wr_part_string - output the string from cursor_pos right.;;----------------------------------------------------------wr_full_string	short		lda	origin_h		sta	ch		lda	origin_v		sta	cv		jsr	cv_bas_calc		lda	#0		bra	write_stringwr_part_string	short		jsr	set_cursor		lda	cursor_poswrite_string	short		pha			; save starting point		lda	input_field	; calculate # bytes to print		ldx	fill_char	; check the fill character		cpx	#$20		; is it a space?		bne	@not_space	; no, continue as before		lda	input_length	; else print only the valid contents@not_space		sec		sbc	1,s		sta	msg_len		; always <= 255		stz	msg_len+1		pla		mode_16		stz	msg_len+2	; finish above job!		and	#$00FF		; calc start offset into string		clc		adc	input_str		sta	msg_ptr		lda	input_str+2		adc	#0		sta	msg_ptr+2		mode_8		brl	console		; (rts)  print the sucker!		eject;----------------------------------------------------------;;  add_to_str;;  Add the character at last_char into the string.  Either;  insert it or replace the current character (depending on;  the current cursor mode).  If we are going off the end,;  call the beeper.;;----------------------------------------------------------add_to_str	short		ldy	cursor_pos	; where are we?		cpy	input_field		bne	add_to_str_1	; add or insert		lda	beep_flag	; enabled?		beq	@no_beep	; no, skip it		mode_16			; go to 16-bit mode		pea	$000A		; code for Input Field Full		ldx	#$3803		; SysBeep2		jsl	$E10000		mode_8		bcc	@no_beep	; if no error, we're done		pla			; else remove parameter		pla			; (compatibility w/5.0.x)@no_beep		rts		add_to_str_1		lda	cursor_mode	; which mode?		ror	a		bcs	add_overstrike	; (with y=cursor_pos);  insert cursor is active.  right shift;  the string from cursor to end		ldy	input_field	; shift the string over!		cpy	input_length	; (grow if not full already)		beq	add_to_lp		inc	input_lengthadd_to_lp		dey			;  (y=input_field)		cpy	cursor_pos	; done yet?		beq	add_common	;  (with y = cursor_pos)		dey			; shift 1 char right		lda	[input_str],y		iny		sta	[input_str],y		bra	add_to_lp;  overstrike.  The only trick here is to lengthen the string;  _only if_ we are at the end.add_overstrike	short		lda	input_length	; have we lengthened the string?		cmp	cursor_pos		bne	add_common		inc	input_length	; yes;  now stick the new character in at the cursor position,;  display it, and reposition the cursor.add_common		lda	last_char	; store character		sta	[input_str],y; update direct page transfer_count variable.  No need to update the high word, 'cause; it'll never change (UIR is limited to 254 characters)		ldy	#drvr_tran_cnt		lda	input_length		sta	[drvr_parm_ptr],y		jsr	rmv_cursor		jsr	wr_part_string	; update string		inc	cursor_pos	; move up		brl	set_cursor	; (rts)		eject;----------------------------------------------------------;;  next_char;;  Checks for keypress and flashes the cursor.;;  Output:  C           clear = no key, C set = key pressed;           last_char   0 if no key, ascii if key;           last_mod    0 if no key, modifier bits if key;;----------------------------------------------------------next_char	short		jsr	read_key	; keypress?		bcs	next_char_1		stz	last_char		stz	last_mod		jsr	blink		clc		rtsnext_char_1		sta	last_char		stx	last_mod		sec		rts		eject;----------------------------------------------------------;;  read_key;;  Attempts to read a key from the keyboard.  If the event;  manager is active, use it.  Otherwise read the hardware;  directly.;;  Outputs:  C = set if key pressed, clear if no key;            A = ascii code of key (0-127);            X = keypress modifiers;;----------------------------------------------------------read_key	mode_16			; called from 8 bit mode		pea	$0000		; check event mgr		_EMStatus		pla		bne	em_active;  Read directly from keyboard.		mode_8		lda	>kbd		; anything?		bpl	no_key		and	#$7F		; got one.		pha		lda	>keymodreg	; get the modifiers		and	#$D7		; remove b3 and b5		tax		lda	>kbdstrb	; clear strobe		pla			; get keypress again		bra	xit_with_key;  No key pressedno_key		clc		rts;  Key pressedxit_with_key		sec		rts;  Read key from event managerem_active		Long		pea	$0000		; result space		lda	#$0428		; key-down, autokey, DA		pha		lda	#^evt_record		pha		lda	#<evt_record		pha		_getnextevent		pla		mode_8		beq	no_key;  Got one!  Now re-translate the modifiers from event mgr format;  to the same format as output by the hardware.;;     EM:  xx xx KP CT OP CL SH AP B0 B1 xx xx xx xx xx xx;  $C025:                          AP OP 00 KP 00 CL CT SH		lda	evt_modifiers+1		sta	dp_temp_1		lda	#0		; build new word in A		asl	dp_temp_1	; throw out 1st 2 bits		asl	dp_temp_1		bpl	em_act_1	; testing KP bit		ora	#%00010000em_act_1		asl	dp_temp_1		bpl	em_act_2	; testing CT bit		ora	#%00000010em_act_2		asl	dp_temp_1		bpl	em_act_3	; testing OP bit		ora	#%01000000em_act_3		asl	dp_temp_1		bpl	em_act_4	; testing CL bit		ora	#%00000100em_act_4		asl	dp_temp_1		bpl	em_act_5	; testing SH bit		ora	#%00000001em_act_5		asl	dp_temp_1		bpl	em_act_6	; testing AP bit		ora	#%10000000em_act_6		tax			; modifiers in X		lda	evt_message	; keypress in A		sec		rts		eject;----------------------------------------------------------;;  check_special;;  Check for special keypresses.  First, check for terminator;  hits (so terminators can override standard edit keys).;  Then, check the built-in table of editing keys.  Finally,;  if we still have a control character, it is invalid and;  we beep.  If a key is entered as 'control-open-apple-char';  then we convert it to our internal control char representation;  ($80-$9F) and pass it as a normal keystroke.;;  in:   last_key = ascii of current keypress;        last_mod = modifier bits;;  out:  X  = -1 : key already processed internally;           =  0 : not special.  add to the string.;           >  0 : terminator #.;	c set = X = termintor #;;----------------------------------------------------------check_special	short		nop		jsr	rmv_cursor	; clear the cursor		lda	last_mod	; build combined input word		xba		lda	last_char		mode_16		pha		lda	term_count	; any terminators?		beq	try_specials;  Okay, we need to scan the terminator list.		dec	a		; convert count to word index		asl	a		tay		lda	1,s		; apply the terminator mask		and	term_mask		phascan_term_lp		lda	[term_ptr],y		and	#$DFFF		; remove interrupt bit		cmp	1,s		; match?		beq	found_term		dey			; move to next		dey		bpl	scan_term_lp;  terminator not found.  clean up and go to special char check		pla			; dump work value...		bra	try_specials;  found a terminator!  save the terminator, and return its index;  number in X.found_term		pla			; clean up stack		pla		lda	[term_ptr],y	; get it again		sta	last_term		tya			; convert to terminator #		lsr	a		inc	a		tax		sec			; indicate that we have found a terminator		mode_8		rts;  no terminators encountered.  Try for an editing key.try_specials	long		lda	1,s		; get key+mod again		and	#$D2FF		; we ignore caplock, shift, keypad		ldx	#edit_tb_len-2	; tables indexspec_scan_lp		cmp	edit_ch_codes,X		beq	found_edit		dex		dex		bpl	spec_scan_lp		bra	no_edit_foundfound_edit	pla		mode_8			; NOTE - max 127 edit chars!		jsr	(edit_ch_jumps,X)		ldx	#-1		; signal: already completed		clc				rts;  No editing keys were found.  There is one more alternative.;  If open-apple and control are simultaneous, the user is;  entering a control char.no_edit_found	long		lda	1,s		; first some special cases		and	#$C0FF		; checking apple keys only		cmp	#$8009		; special case OA-tab		beq	ins_control		cmp	#$801B		; special case OA-esc		beq	ins_control		and	#$4000		; check CA key		bne	spec_ch_beep	; pressed.  beep.		lda	1,s		and	#$8200		; look for OA+CTRL		beq	ins_normal	; neither.  regular kind o' guy		cmp	#$8200		bne	spec_ch_beep	; one or other.  error.ins_control		lda	1,s		; final check - really a control ch?		and	#$00FF		cmp	#$20		bge	spec_ch_beep	; no.  beep!		bit	cursor_mode-1	; final check- ctrl entry allowed? (minus 1 for byte)		bvc	spec_ch_beep		pla			; convert to 'my' representation		ora	#$0080		; from $00-$1F to $80-$9F		mode_8		sta	last_char	; new insertion char		ldx	#0		clc		rtsins_normal	long		pla		mode_8		cmp	#$20		; final check:  control char?		blt	spec_ch_beep_2		ldx	#0		clc		rtsspec_ch_beep	long		plaspec_ch_beep_2	mode_8		jsr	input_beep		ldx	#-1		clc		rts		eject;----------------------------------------------------------;;  input_beep;;  if the edit beep is enabled, call the console beep;  output routine.;;----------------------------------------------------------input_beep	short		lda	beep_flag	; enabled?		beq	q_input_beep		mode_16		pea	$0008		; code for Bad Keypress		ldx	#$3803		; SysBeep2		jsl	$E10000		mode_8		bcc	q_input_beep	; if no error, exit		pla			; else remove input parameter		pla			; (compatibility w/pre-6.0 system)q_input_beep		rts		eject;----------------------------------------------------------;;  Editing character tables.  The first is word-combinations;  of editing keystrokes with their modifiers.;;  In all cases, only the following subset of mod bits is;  used:;;  bit 7 : open apple                   { all other;  bit 6 : closed apple (option)          bits are 0 };  bit 4 : keypad;  bit 1 : control;;----------------------------------------------------------edit_ch_codes		DC.W	$0008		; left arrow		DC.W	$0208		; control H		DC.W	$0015		; right arrow		DC.W	$0215		; control U		DC.W	$8008		; apple left arrow		DC.W	$8015		; apple right arrow		DC.W	$803E		; apple >		DC.W	$802E		; apple dot		DC.W	$803C		; apple <		DC.W	$802C		; apple comma		DC.W	$007F		; delete		DC.W	$027F		; control delete		DC.W	$807F		; apple delete		DC.W	$0204		; control D		DC.W	$8044		; apple D		DC.W	$8064		; apple d		DC.W	$0206		; control F		DC.W	$8046		; apple F		DC.W	$8066		; apple f		DC.W	$0218		; control X		DC.W	$1018		; clear key		DC.W	$8058		; apple X		DC.W	$8078		; apple x		DC.W	$0219		; control Y		DC.W	$8059		; apple Y		DC.W	$8079		; apple y		DC.W	$021A		; control Z		DC.W	$805A		; apple Z		DC.W	$807A		; apple z		DC.W	$0205		; control E		DC.W	$8045		; apple E		DC.W	$8065		; apple eedit_tb_len	equ	*-edit_ch_codesedit_ch_jumps		DC.W	ed_left_char		DC.W	ed_left_char		DC.W	ed_right_char		DC.W	ed_right_char		DC.W	ed_left_word		DC.W	ed_rt_word		DC.W	ed_right_end		DC.W	ed_right_end		DC.W	ed_left_end		DC.W	ed_left_end		DC.W	ed_del_left		DC.W	ed_del_left		DC.W	ed_del_left		DC.W	ed_del_left		DC.W	ed_del_left		DC.W	ed_del_left		DC.W	ed_del_right		DC.W	ed_del_right		DC.W	ed_del_right		DC.W	ed_clear		DC.W	ed_clear		DC.W	ed_clear		DC.W	ed_clear		DC.W	ed_clr_eol		DC.W	ed_clr_eol		DC.W	ed_clr_eol		DC.W	ed_restart		DC.W	ed_restart		DC.W	ed_restart		DC.W	ed_toggle		DC.W	ed_toggle		DC.W	ed_toggle		eject;----------------------------------------------------------;;  editing subroutines.  Each performs a keystroke;  function on the input string.;;----------------------------------------------------------;----------------------------------------------------------;;  ed_left_char  -  like, backspace, dude!;ed_left_char	short		lda	cursor_pos	; at left already?		bne	ed_left_ch_1		brl	input_beep	; can't move no more!ed_left_ch_1		dec	cursor_pos		brl	set_cursor	; (rts);----------------------------------------------------------;;  ed_right_char  -  you know, move FORWARD man!;ed_right_char	short		lda	cursor_pos	; at end already?		cmp	input_length		bne	ed_rt_ch_1		brl	input_beep	; sorry, sir, maximum warped_rt_ch_1		inc	cursor_pos		brl	set_cursor	; (rts);----------------------------------------------------------;;  ed_left_word  -  okay, the definition of a word is kinda;                   tricky:  (from UI guidelines....);;  "A word is defined as any continuous string that contains;   only the following characters:;;  -  a letter or a digit;  -  a dollar sign or percent sign or hyphen;  -  a comma between digits;  -  a period before a digit;  -  an apostrophe between letters or digits ";;  However, examination of popular Apple II software (ie;  Appleworks) shows these rules to be largely ignored, so;  we will too!  From here on out the definition of a word;  is 'a sequence of characters bordered by spaces'.;;  So what we do is to scan from our current position left,;  keeping track of our current state (in or out) and looking;  for a transition from in to out.  When the next motion;  would cause such a transition, we stop.;ed_left_word	short		ldy	cursor_pos	; already at start?		bne	ed_lf_wd_1		brl	input_beep	; at start.  beep!ed_lf_wd_1		dey			; move back at least one		jsr	word_stateed_lf_lp		dey			; test previous loc		cpy	#255		; off edge yet?		beq	ed_lf_wd_2		jsr	word_state		bcc	ed_lf_lp	; loop until word exited_lf_wd_2		iny			; ok!  we're here!		sty	cursor_pos		brl	set_cursor;----------------------------------------------------------;;  ed_rt_word  -  an identical twin to the routine above.;                 except that this routine is black on the;                 left side, and the one above is black on;                 the right side.  can't you see it?;ed_rt_word	short		ldy	cursor_pos	; already at start?		cpy	input_length		bne	ed_rt_wd_1		brl	input_beep	; at start.  beep!ed_rt_wd_1		iny			; move up at least one		jsr	word_stateed_rt_lp		iny			; test next loc		jsr	word_state		bcc	ed_rt_lp		dey			; ok!  we're here!		sty	cursor_pos		brl	set_cursor;----------------------------------------------------------;;  word_state;;  this is the guts of the word move routine.  it examines;  a particular character in the input string and determines;  whether it's 'in a word' (see above for extremely arbi-;  trary definition of 'word').  It maintains this information;  in a state byte called 'wd_state_flag' into which bits;  are rolled from the lsb end.  '0' means the current;  character is an 'innie' and '1' means it's an 'outie.';  thusly one can examine the rightmost 2 bits of the flag;  and look for transitions!;;  And isn't that special!;;  In:  Y = character index;;  Out: C set         = transition found, or out of bounds;       C clear       = no transition found;       wd_state_flag = history of states;;----------------------------------------------------------word_state	short		cpy	#255		; moved back too far?		beq	word_state_xx		cpy	input_length	; moved forward too far?		beq	word_state_yy	; special case if outside		bge	word_state_xx	; (bgt word_state_xx)word_state_1		lda	[input_str],y	; ok, what do we have here?		cmp	#' '				php			; get Z flag, 1 if space		pla		lsr	a		; and roll it to the C		lsr	aword_state_2		rol	wd_state_flag	; and roll it into the state reg		lda	wd_state_flag		and	#3		; now, have we left a word?		cmp	#1		; 0, 1  means  in, out		beq	word_state_out		clc			; report no transition		rtsword_state_xx		sec			; out of word.  force 'out'		rol	wd_state_flag	; _and_ report 'out'word_state_out		sec			; report exit transition		rtsword_state_yy		sec		bra	word_state_2;----------------------------------------------------------;;  ed_left_end;ed_left_end	short		lda	cursor_pos		bne	ed_left_end_1		brl	input_beep	; (rts)ed_left_end_1		stz	cursor_pos		brl	set_cursor	; (rts);----------------------------------------------------------;;  ed_right_end;ed_right_end	short		lda	input_length		cmp	cursor_pos		bne	ed_rt_end_1		brl	input_beep	; (rts)ed_rt_end_1		sta	cursor_pos		brl	set_cursor	; (rts);----------------------------------------------------------;;  ed_del_left;;  Delete the character one position to the left.  And move;  the cursor there.  This is the delete key.;ed_del_left	short		ldy	cursor_pos	; at left edge already?		bne	ed_d_lf_1		brl	input_beep	; (rts)ed_d_lf_1		dey			; deleting previous char		sty	cursor_pos	; and put cursor there		brl	do_delete	; (rts) finish the process;----------------------------------------------------------;;  ed_del_right;ed_del_right	short		ldy	cursor_pos	; anything under the cursor?		cpy	input_length		bne	do_delete	; (rts)		brl	input_beep	; (rts);----------------------------------------------------------;;  do_delete.;;  Shift right from 'Y' to the end of the input string, then;  set the new cursor position and redraw the string.;do_delete	short		iny			; copy next char		cpy	input_field	; at end yet?		beq	do_del_1		lda	[input_str],y		dey		sta	[input_str],y		iny			; and keep going		bra	do_deletedo_del_1		dey		lda	fill_char	; bring in empty space char		sta	[input_str],y		jsr	wr_part_string		dec	input_length	; shrink a say!		brl	set_cursor	; (rts);----------------------------------------------------------;;  ed_clear  -   zapola!;ed_clear	short		ldy	input_field		lda	fill_chared_clr_lp		dey		sta	[input_str],y		bne	ed_clr_lp		lda	origin_h	; restore starting cursor position		sta	ch		lda	origin_v		sta	cv		jsr	cv_bas_calc		lda	input_length	; get the length of the original input		sta	dle_count	; set as # of spaces to write		jsr	comp_dle_1	; go write some spaces				stz	input_length		stz	cursor_pos		jsr	wr_full_string		brl	set_cursor	; (rts);----------------------------------------------------------;;  ed_clr_eol;ed_clr_eol	short		lda	input_length		sec		sbc	cursor_pos	; calc # of characters to clear		sta	dle_count		jsr	comp_dle_1	; blast to end of input		jsr	set_cursor	; reset cursor position		ldy	cursor_pos		sty	input_length		lda	fill_chared_clreol_lp		cpy	input_field		beq	ed_clreol_1		sta	[input_str],y		iny		bra	ed_clreol_lped_clreol_1		jsr	wr_part_string		brl	set_cursor	; (rts);----------------------------------------------------------;;  ed_restart  -  return to default input;ed_restart	short		lda	input_length	; remember current input length		pha		jsr	copy_def_str	; get the default string		jsr	copy_curs_mode	; reset cursor		jsr	fake_controls	; diddle with control chars		jsr	pad_input	; insert fill_char's		pla			; retrieve original string length		ldx	input_length	; get the new length		phx			; save it		cmp	input_length	; which is longer, the old or the new?		bcc	@new_longer	; the new one is, so use that length		sta	input_length	; reset to original length for proper screen update@new_longer		jsr	wr_full_string	; print it!		pla			; restore new string length		sta	input_length		brl	set_cursor	; (rts);----------------------------------------------------------;;  ed_toggle - switch between insert & overstrike modes;ed_toggle	short		lda	cursor_mode		eor	#1		; toggle the bit!		sta	cursor_mode		rts		ENDP		END			; anything?