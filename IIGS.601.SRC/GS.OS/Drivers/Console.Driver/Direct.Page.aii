; The following record defines the direct page used by the Console Driver.; It allocates the direct page starting at the top of the page and builds; down as variables are added.	if Library=1 then		;conditional assembly for library versiondirect_page	record	0	elsedirect_page	record	$100,decrement	endifcur_base	ds.l	1		; (ptr)   Cursor's base addressline_base	ds.l	1		; (ptr)   Work base addressmsg_ptr		ds.l	1		; (ptr)   buffer pointersrc_line	ds.l	1		; (ptr)   Source linedst_line	ds.l	1		; (ptr)   Destination linedp_temp_1	ds.l	1		; (ptr)   Temporary storagedp_temp_2	ds.w	1		; (word)drvr_parm_ptr	ds.l	1		; (ptr)   Points to GS/OS DPinput_str	ds.l	1		; (ptr)   Input String addressterm_ptr	ds.l	1		; (ptr)   To my terminator listdef_str_ptr	ds.l	1		; (long)  pointer to default stringsize		endr