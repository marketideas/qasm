		msb	off		string	asis		print	sym		print	nopage		print	nomdir;--------------------------------------------------------------------------------------;;				.RPM Driver;				.AFP Driver;				.APPLETALK Driver;;				Copyright (c) 1988;				Apple Computer, Inc.;				All rights reserved.;;--------------------------------------------------------------------------------------;; All drivers go in the */SYSTEM/DRIVERS/ sub-directory.  They MUST have the following; attributes set correctly.;;	File		File type	Aux type;;	ATALK		$00 BB		$0000 0110;;--------------------------------------------------------------------------------------;; Here is a list of the files that are needed to build the ATALK driver file...;;	appletalk.aii		This file contain the APPLETALK driver code.;	atalk.aii		This file contains the DIBs for all the drivers.;	equates			This is a general GS/OS equate file.;	others.aii		This file contains the AFP driver code.;	rpm.aii			This file contains the RPM driver code.;; To build the ATALK driver file, simply use the build command and build 'ALL'.;;--------------------------------------------------------------------------------------;; Change History:;; 0.01e01	03/27/88	TGH	-First attempt; 0.02a01	07/12/88	TGH	-Took out AFP (character) driver.; 0.03a01	08/01/88	TGH	-Changes to AFP driver.; 0.04a01	08/04/88	MSD	-Control call's reset routine now forces the;					 DIBs to be rebuilt.; 0.05a01	08/04/88	TGH	-Added support for PFI vector notification.; 0.06a01	09/19/88	TGH	-Fixed BlockRead bug.; 0.07a01	11/28/88	TGH	-Changed characteristics for AFPn drivers;					 from $03E4 to $03A4.  Write not allowed.; 00.05		11/29/88	TGH	-Changed version string to match system disk.;					-Changed the order of the DIBs.; 00.07		12/15/88	TGH	-No longer make AppleTalk calls to the;					 supervisor (RPM).;					-Changed transfer and request count from;					 6 to 13 in DSTATUS and DCONTROL calls (RPM).;					-Added RESET call to .APPLETALK driver.;					-Fixed unmount check bug. I was looking at;					 the P8 device # which wasn't valid.;					-Added 'unknown block size' bit to status word.;; 2.18A		1/4/88		TGH	-Changed error code for open and write in the;					 AFP drivers from BAD_REQUEST to NO_ERROR.;; 2.19A		1/16/88		TGH	-Fixed bug in .APPLETALK get_port call.;; 2.1BB		2/9/88		TGH	-Changed flush error result from $20 to $00 in;					 .AFPn and .APPLETALK drivers.;					-Added RPM session between OPEN and CLOSE calls.;; 2.1CB		2/9/88		TGH	-Changed the characteristics word for the .RPM;					 driver so that you can now read from it.;					-Changed the characteristics word for the;					 .APPLETALK driver so you cannot rename it.;					-Added support for standard STATUS and CONTROL;					 calls for the .APPLETALK and .AFPn drivers.;					-Now use channel # to report port # in Get_Port;					 call.  I used to use a ATalk global in bank;					 $E1.;					-Added AFP messages.;; 2.1DB		3/6/89		TGH	-Now all drivers are re-startable.;					-Added minutes to .AFP driver messages.;					-Fixed MountVol bug (moved 1 byte too much.);; 2.1EB		3/28/89		MSD	-Changed device characteristics for AFP;					 drivers from $BA4 to $BE4 (device is writable).;; NOTE: I changed the version number to it's final value (2.01).  From now on,;       changes will be refered to by build disk name (e.g. 5.0 d19) and date.;; 5.0 d20	4/24/89		TGH	-Changed version number to 201B (2.01B).;					-Added ASL A to EjectStatus table calculation.;; 5.0 d22	5/11/89		TGH	-Fixed eject status check bug in .AFPn driver.;					-Changed hook call to follow ERS documentation.;; 5.0 d25	6/1/89		TGH	-Changed version number to Final.;; 5.0.3 d16	7/5/90		MSD	-Changed .RPM characteristics from $0B60;					 to $0B40 (clearing the Read enable bit);					 since it doesn't make sense to read from;					 a printer.  Fixes the DRead hang.;; 6.0 d37	16-May-91	MSD	Changed version number to $4000 (i.e. 4.0);					to match the GS/OS version number.; *** 6.0.1;; 6.0.1d12	14-Dec-92	DAL	Changed version number to $402B.;; 6.0.1d16	2-Apr-93	SS	Changed version number to $4020 (final);;--------------------------------------------------------------------------------------version		equ	$4020		;2-Apr-93 SSAFPChar		equ	$0BE4RPMChar		equ	$0B40ATALKChar	equ	$0F00atalk_dispatch	equ	$E11014		print	off		include	'm16.util'		include	'equates'		print	on		eject;--------------------------------------------------------------------------------------;; Below is the header that is required for drivers.;;--------------------------------------------------------------------------------------header		proc		EXPORT	dib_table		EXPORT	dibv1		EXPORT	SS_Count		IMPORT	entryvols		IMPORT	entry1		IMPORT	entry2TotDIB_Count	equ	16		dc.w	dibv1-header		;Offset to 1st DIBDev_Count	dc.w	TotDIB_Count			;17 devices		dc.w	confv1-header		;offset to V1 configuration list		dc.w	confv2-header		;offset to V2 configuration list		dc.w	confv3-header		;offset to V3 configuration list		dc.w	confv4-header		;offset to V4 configuration list		dc.w	confv5-header		;offset to V5 configuration list		dc.w	confv6-header		;offset to V6 configuration list		dc.w	confv7-header		;offset to V7 configuration list		dc.w	confv8-header		;offset to V8 configuration list		dc.w	confv9-header		;offset to V9 configuration list		dc.w	confv10-header		;offset to V10 configuration list		dc.w	confv11-header		;offset to V11 configuration list		dc.w	confv12-header		;offset to V12 configuration list		dc.w	confv13-header		;offset to V13 configuration list		dc.w	confv14-header		;offset to V14 configuration list		dc.w	conf_1-header		;offset to 1st configuration list		dc.w	conf_2-header		;offset to 2nd configuration listSS_Count	dc.w	0confv1		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv2		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv3		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv4		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv5		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv6		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv7		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv8		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv9		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv10		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv11		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv12		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv13		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconfv14		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconf_1		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default listconf_2		dc.l	0			;0 bytes in parameter list		dc.l	0			;0 bytes in default list;		Block devices belowdibv1		dc.l	dibv2			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP1'			;Device name with length		dcb.b	27,$20		dc.w	0			;Slot number		dc.w	1			;Unit number		;This will		dc.w	version			;Version number		;always be		dc.w	$001E			;ID # (AFP generic)	;device #1		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	0			;Block device #0		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv2		dc.l	dibv3			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP2'			;Device name with length		dcb.b	27,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	1			;Block device #1		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv3		dc.l	dibv4			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP3'			;Device name with length		dcb.b	27,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	2			;Block device #2		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv4		dc.l	dibv5			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP4'			;Device name with length		dcb.b	27,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	3			;Block device #3		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv5		dc.l	dibv6			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP5'			;Device name with length		dcb.b	27,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	4			;Block device #4		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv6		dc.l	dibv7			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP6'			;Device name with length		dcb.b	27,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	5			;Block device #5		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv7		dc.l	dibv8			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP7'			;Device name with length		dcb.b	27,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	6			;Block device #6		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv8		dc.l	dibv9			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP8'			;Device name with length		dcb.b	27,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	7			;Block device #7		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv9		dc.l	dibv10			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP9'			;Device name with length		dcb.b	27,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	8			;Block device #8		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv10		dc.l	dibv11			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP10'			;Device name with length		dcb.b	26,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	9			;Block device #9		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv11		dc.l	dibv12			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP11'			;Device name with length		dcb.b	26,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	10			;Block device #10		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv12		dc.l	dibv13			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP12'			;Device name with length		dcb.b	26,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	11			;Block device #11		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv13		dc.l	dibv14			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP13'			;Device name with length		dcb.b	26,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	12			;Block device #12		dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedibv14		dc.l	dib_1			;Link pointer to next DIB		dc.l	entryvols		;Entry pointer		dc.w	AFPChar			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFP14'			;Device name with length		dcb.b	26,$20		dc.w	0			;Slot number		dc.w	0			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reser3ed		dc.w	0			;Reser3ed		dc.w	0			;Device number		dc.w	13			;Block device #13		dc.b	0			;Session reference number		dc.b	0			;Dummy byte (slot/drive)		dcb.b	28,0			;Volume name		dc.w	0			;Volume ID		dc.w	0			;Device status word		dcb.b	32,0			;Server name		dcb.b	33,0			;Zone namedib_1		dc.l	dib_2			;Link pointer to next DIB		dc.l	entry1			;Entry pointer		dc.w	RPMChar			;Characteristics		dc.l	0			;Block count		str	'RPM'			;Device name with length byte		dcb.b	28,$20		dc.w	7			;Slot number		dc.w	1			;Unit number		dc.w	version			;Version number		dc.w	$001F			;ID # (RPM driver)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reserved		dc.w	0			;Reserved		dc.w	0			;Device number; These additional DIB values are used as a GDIB.  These are needed in order to use the; generated device slot emulation code.		dc.w	$0080			;Generated drvr_class (character)		dc.w	$0000			;Smartport type (none)		dc.w	$0000			;Smartport sub-type (none)		dc.w	$0000			;Open flag		dc.w	$0000			;Block size (none)		dc.w	$0000			;Hardware unit # (none)dib_2		dc.l	0			;Link pointer to next DIB		dc.l	entry2			;Entry pointer		dc.w	ATALKChar		;Characteristics		dc.l	0			;Block count		str	'APPLETALK'		;Device name with length		dcb.b	22,$20		dc.w	7			;Slot number		dc.w	2			;Unit number		dc.w	version			;Version number		dc.w	$001D			;ID # (AppleTalk main)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reserved		dc.w	0			;Reserved		dc.w	0			;Device number;;The following pointers point to the each individual AFP DIBs session reference numbers.;dib_table	dc.w	dibv1+$42		dc.w	dibv2+$42		dc.w	dibv3+$42		dc.w	dibv4+$42		dc.w	dibv5+$42		dc.w	dibv6+$42		dc.w	dibv7+$42		dc.w	dibv8+$42		dc.w	dibv9+$42		dc.w	dibv10+$42		dc.w	dibv11+$42		dc.w	dibv12+$42		dc.w	dibv13+$42		dc.w	dibv14+$42		endp;--------------------------------------------------------------------------------------		END