		msb	off		string	asis		print	sym		print	nopage		print	nomdir;--------------------------------------------------------------------------------------;;				.APPLETALK Driver;;				Copyright (c) 1988;				Apple Computer, Inc.;				All rights reserved.;;--------------------------------------------------------------------------------------;; 0.01e01	03/27/88	TGH	-First attempt; 0.02a01	07/12/88	TGH	-Changed label (entry3 => entry2);					-AFP: Took out AFP (character) driver.; 0.03a01	08/01/88	TGH	-AFP: Changes to AFP driver.; 0.04a01	08/04/88	MSD	-AFP: Control call's reset routine now forces;					      the DIBs to be rebuilt.; 0.05a01	08/04/88	TGH	-AFP: Added support for PFI vector notification.; 0.06a01	09/19/88	TGH	-AFP: Fixed BlockRead bug.; 00.07		12/15/88	TGH	-Added RESET call to .APPLETALK driver.; 2.19A		1/16/88		TGH	-Fixed transfer count bug in get_port call.; 0.11B		2/9/88		TGH	-Added null flush call.;; NOTE:	All new change notes can be found in the MAIN.AII file.;;--------------------------------------------------------------------------------------		print	off		include	'equates'		print	on		eject		IMPORT	SS_Count		entry	startup,\			open,\			nullreq,\			close,\			status,\			control,\			shutdown	:CODE		entry	Status_Word,\			OpenFlag :CODE		eject;--------------------------------------------------------------------------------------;; Following is the dispatch table used for to call the supported call numbers.;;--------------------------------------------------------------------------------------disp_table	proc		dc.w	startup-1		dc.w	open-1		dc.w	nullreq-1		;read		dc.w	nullreq-1		;write		dc.w	close-1		dc.w	status-1		dc.w	control-1		dc.w	nullreq-1		;flush		dc.w	shutdown-1		endp		eject********************************************************************************* DRIVER MAIN entry POINT: entry2** This is the main entry point for the device driver.  The* routine validates the call number prior to dispatching to* the requested function.** Call Number:  $0000   Function: Startup*               $0001             Open*               $0002             Read*               $0003             Write*               $0004             Close*               $0005             Status*               $0006             Control*               $0007             Flush*               $0008             Shutdown*               $0009-$FFFF       Reserved** ENTRY: Call via 'JSL'*     [<drvr_dib_ptr] = Points to the DIB for the device being accessed*       <drvr_dev_num = Device number of device being accessed*      <drvr_call_num = Call number*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT:   Direct page = unchanged with the exception of <drvr_tran_cnt*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************		EXPORT	entry2entry2		proc		longa	on		longi	on		phb			;Save the GS/OS bank register		phk		plb		cmp	#0009		;Max command number		bge	illegal_req	;Oops, too big.		pea	func_ret-1	;Push our return address		asl	a		tax		lda	disp_table,x		pha			;Push the address of routine on the stack		rtsfunc_ret	tay			;Save the returned error code		plb		bcs	gen_exit	;Branch if there is an error		ldy	#no_errorgen_exit	tya		rtlillegal_req	plb		lda	#drvr_bad_req		sec		rtl		endp********************************************************************************* DRIVER CALL:  STARTUP** This routine must prepare the driver to accept all other driver* calls.** ENTRY: Call via 'JSR'*     [<drvr_dib_ptr] = Points to the DIB for the device being accessed*       <drvr_dev_num = Device number of device being accessed*      <drvr_call_num = Call number*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as program bank*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************startup		proc		entry	sup_num,\			Channel		longa	on		longi	on		lda	#$0000		tax		ldy	#$0001		jsl	sup_drvr_disp		bcs	justleave		stx	sup_num		lda	#Start_ParmList		sta	<sup_parm_ptr		lda	#^Start_ParmList+2		sta	<sup_parm_ptr+2		lda	sup_num		ldx	#$0002			;call number 2		ldy	#$0001		jsl	sup_drvr_disp		bcs	justleave		ldy	#slot_num		lda	Slot		sta	[drvr_dib_ptr],y		ldy	#unit_num		lda	Unit		sta	[drvr_dib_ptr],y		inc	SS_Count		stz	OpenFlag		;Mark us as not open		lda	#0000		clcjustleave	rtssup_num		dc.w	0Start_ParmListSlot		dc.w	0000Channel		dc.w	0000Unit		dc.w	0000		endp		eject********************************************************************************* DRIVER CALL:  OPEN** This call will allow the .APPLETALK driver to be opened 64K times.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************open		proc		ENTRY	OpenFlag		longa	on		longi	on		lda	OpenFlag		;Check the open flag.		bne	Already_Open		inc	OpenFlag		;Increment our counter.		lda	Status_Word		;Fix the status word if it		ora	#$0001			;needs it to reflect that		sta	Status_Word		;the driver is open.		lda	#no_error		clc		rtsAlready_Open	lda	#drvr_prior_open		sec		rtsOpenFlag	dc.w	0000		endp;--------------------------------------------------------------------------------------;; Below is the routine that is called for all un-supported calls.;;--------------------------------------------------------------------------------------nullreq		proc		longa	on		longi	on		lda	#no_error		clc		rts		endp********************************************************************************* DRIVER CALL:  CLOSE** This call will allow the driver to be closed.  The open flag will only* be clear if the OPEN_FLAG goes to zero.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************close		proc		longa	on		longi	on		lda	OpenFlag		;Is driver realy open?		beq	Not_Open		;If not, error out.		stz	OpenFlag		lda	Status_Word		;This is the last close		and	#$FFFE			;so fix the Status_Word		sta	Status_Word		;to reflect that the driver						;is closed.Good_Close	lda	#no_error		clc		rtsNot_Open	lda	#drvr_not_open		sec		rts		endp********************************************************************************* DRIVER CALL:  STATUS** This routine supports all the standard device status calls.** Status Code:  $0000   Return Device Status*               $0001   Return Control Parameters*               $0002   Return Wait/No Wait Mode*               $0003   Return Format Options** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************status		proc		entry	Status_Word		longa	on		longi	on		lda	<drvr_stat_code		;Is this a legal status call?		cmp	#$8001			;Get Port?		beq	get_port		cmp	#status_max		blt	@L1		lda	#drvr_bad_code		;Invalid call number		sec		rts@L1		asl	a		tax		lda	status_table,x		pha		rtsstatus_null	lda	#no_error		clc		rtsdev_stat	ldy	<drvr_req_cnt+2		;High word		bne	status_bparm		ldy	<drvr_req_cnt		;Low word		beq	status_null		cpy	#0002		blt	status_bparm		cpy	#$0007		blt	L2status_bparm	lda	#drvr_bad_parm		;Invalid request count		sec		rtsL2		sep	#$20		longa	off		dey@L3		lda	Status_Word,y		sta	[<drvr_slist_ptr],y		dey		bpl	@L3		rep	#$30		longa	onset_xfer_cnt	lda	<drvr_req_cnt		;Set the transfer count equal		sta	<drvr_tran_cnt		;to the request count.		lda	<drvr_req_cnt+2		sta	<drvr_tran_cnt+2		bra	status_nullget_ctrl	lda	<drvr_req_cnt+2		bne	status_bparm		lda	<drvr_req_cnt		beq	set_xfer_cnt		cmp	#0002		bne	status_bparm		lda	#0		sta	[<drvr_slist_ptr]	;Store 0		bra	set_xfer_cntget_wait	lda	<drvr_req_cnt+2		bne	status_bparm		lda	<drvr_req_cnt		beq	set_xfer_cnt		cmp	#0002		bne	status_bparm		lda	#0000		sta	[<drvr_slist_ptr]		bra	set_xfer_cntget_port	lda	<drvr_req_cnt+2		;High word		bne	status_bparm		lda	<drvr_req_cnt		;Low word		beq	set_xfer_cnt		cmp	#0002		bne	status_bparm		lda	Channel		sta	[<drvr_slist_ptr]		bra	set_xfer_cntStatus_Word	dc.w	$0010		dc.l	0status_table	dc.w	dev_stat-1		dc.w	get_ctrl-1		dc.w	get_wait-1		dc.w	status_null-1		;get_format-1		dc.w	status_null-1		;get_partn_map-1status_max	equ	(*-status_table)/2		endp********************************************************************************* DRIVER CALL:  CONTROL** This routine supports all the standard device control calls.** Control Code: $0000   Reset Device*               $0001   Format Device*               $0002   eject Media*               $0003   Set Control Parameters*               $0004   Set Wait/No Wait Mode*               $0005   Set Format Options*               $0006   Assign Partition Owner*               $0007   Arm Signal*               $0008   Disarm Signal** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************control		proc		longa	on		longi	on		lda	<drvr_ctrl_code		;Is this a legal control call?		cmp	#control_max		blt	L1control_bad	lda	#drvr_bad_code		;Invalid call number		sec		rtsL1		asl	a		tax		lda	control_table,x		pha		rtscontrol_null	lda	#no_error		clc		rtsset_ctrl	lda	<drvr_req_cnt+2		;If there are ANY parameters		bne	@L1		lda	<drvr_req_cnt		;to set, we have an error!		cmp	#0003		blt	control_null@L1		lda	#drvr_bad_parm		sec		rtscontrol_table	dc.w	control_null-1		;dev_reset-1		dc.w	control_null-1		;format-1		dc.w	control_null-1		;media_eject-1		dc.w	set_ctrl-1		dc.w	control_null-1		;set_wait-1		dc.w	control_null-1		;set_format-1		dc.w	control_null-1		;set_partn-1		dc.w	control_bad-1		;arm_signal-1		dc.w	control_bad-1		;disarm_signal-1		dc.w	control_null-1		;set_partn_map-1control_max	equ	(*-control_table)/2		endp********************************************************************************* DRIVER CALL:  SHUTDOWN** This call prepares the driver for shutdown.  This may include* closing a character device as well as releasing any and all* system resources that may have been aquired by either a* STARTUP or OPEN call.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************shutdown	proc		longa	on		longi	on		dec	SS_Count		beq	@L1		lda	#drvr_bad_req		sec		rts@L1		lda	#$0000		clc		rts		endp;--------------------------------------------------------------------------------------		END