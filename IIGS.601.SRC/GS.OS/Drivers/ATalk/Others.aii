		msb	off		string	asis		print	sym		print	nopage		print	nomdir;-------------------------------------------------------------------------------;;				.AFPn Drivers;;				Copyright (c) 1988;				Apple Computer, Inc.;				All rights reserved.;;-------------------------------------------------------------------------------;; 0.01e01	05/18/88	TGH	-First attempt;; 0.02a01	07/12/88	TGH	-Moved code from .AFP (character) driver;					to initialize the DIBs on startup.;; 0.03a01	08/01/88	TGH	-Added disk switch checking for read and;					 status calls.;; 0.04a01	08/04/88	MSD	-Control call's reset routine now forces;					 the DIBs to be rebuilt.;; 0.05a01	08/04/88	TGH	-Added support for PFI vector;					 notification.;; 0.06a01	09/19/88	TGH	-Fixed BlockRead bug.;; 0.07a01	11/15/88	TGH	-Fixed bug in attention routines by;					 adding a PHK/PLB.;					-Fixed eject bug in that we were always;					 trying to mount instead of unmount.;					-No longer mark the volume as unmounted.;					 The unmount vector does it instead.;; 00.07		12/15/88	TGH	-Fixed unmount check bug. I was looking;					 at the P8 device # which wasn't valid.;					-Added 'unknown block size' bit to status;					 word.;; 2.18A		1/4/88		TGH	-Changed error code for open and write;					 in the AFP drivers from BAD_REQUEST to;					 NO_ERROR.;;		1/25/89		MSD	-Read now returns network_error instead;					 of unknown_vol.;; 0.11B		2/9/88		TGH	-Added null flush call.;; 27-Sep-91	MSD	Shutdown messages with a non-zero time for devices other;			than .AFP1 were writing outside our space (likely to stomp;			on something else) because only 4 bytes were reserved per;			number string, but the pointers were offset by 32 bytes.;			Fixed the pointers and rewrote ConvertToAscii which;			builds the number of minutes string.;;  6-Mar-93	JCM	Fixed bug in VUnMountVol where string compare was really;			quite bogus. It was comparing the entire volume name buffer;			when it should have been simply comparing the Pascal strings.;			This was the source of volumes appearing to not unmount when;			they were ejected under GS/OS.;;-------------------------------------------------------------------------------		print	off		include	'equates'		include	'm16.misctool'		include	'm16.memory'		include	'm16.util'		include	'm16.intmath'		print	onRamDispatch	equ	$E11014			;Entry point for all AppleTalk						;calls.Warm_Cold_Flag	equ	$E101CF			;Word:	0=cold startup/shutdown						;	1=warm startup/shutdownPost_OS_Event	equ	$1FCC4			;SCM entry point.		IMPORT	SS_Count		ENTRY	startup,\			read,\			write,\			status,\			control,\			nullreq,\			shutdown	:CODE		ENTRY	VMountVol,\			VUnMountVol,\			VAttention,\			ShowMessages	:CODE			IMPORT	dib_table,\			dibv1		:CODE		eject;-------------------------------------------------------------------------------;; Following is the dispatch table used for to call the supported call numbers.;;-------------------------------------------------------------------------------disp_table	proc		dc.w	startup-1		;startup		dc.w	nullreq-1		;open		dc.w	read-1			;read		dc.w	write-1			;write		dc.w	nullreq-1		;close		dc.w	status-1		;status		dc.w	control-1		;control		dc.w	nullreq-1		;flush		dc.w	shutdown-1		;shutdown		endpeject_status	proc		dcb.w	14,0000			;14 zeros		endp		eject********************************************************************************* DRIVER MAIN entry POINT: entryvols** This is the main entry point for the device driver.  The* routine validates the call number prior to dispatching to* the requested function.** Call Number:  $0000   Function: Startup*               $0001             Open*               $0002             Read*               $0003             Write*               $0004             Close*               $0005             Status*               $0006             Control*               $0007             Flush*               $0008             Shutdown*               $0009-$FFFF       Reserved** ENTRY: Call via 'JSL'*     [<drvr_dib_ptr] = Points to the DIB for the device being accessed*       <drvr_dev_num = Device number of device being accessed*      <drvr_call_num = Call number*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT:   Direct page = unchanged with the exception of <drvr_tran_cnt*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************entryvols	proc	EXPORT		longa	on		longi	on		phb			;Save the GS/OS bank register		phk		plb		cmp	#0009		;Max command number		bge	illegal_req	;Oops, too big.		pea	func_ret-1	;Push our return address		asl	a		tax		lda	disp_table,x		pha			;Push the address of routine on the stack		rtsfunc_ret	tay			;Save the returned error code		plb		bcs	gen_exit	;Branch if there is an error		ldy	#no_errorgen_exit	tya		rtlillegal_req	plb		lda	#drvr_bad_req		sec		rtl		endp********************************************************************************* DRIVER CALL:  STARTUP** This routine must prepare the driver to accept all other driver* calls.** ENTRY: Call via 'JSR'*     [<drvr_dib_ptr] = Points to the DIB for the device being accessed*       <drvr_dev_num = Device number of device being accessed*      <drvr_call_num = Call number*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as program bank*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************startup		procwork1		equ	$00work2		equ	$04		entry	sup_num,start_flag		longa	on		longi	on;------------------------------------------------------------------------------; Below we check to see if we've been cold started.  If we haven't cold; started yet, we call the supervisory driver.;------------------------------------------------------------------------------		lda	#$0000			;Supervisor number (0=find)		tax				;Call number (find sup number)		ldy	#$0001			;Supervisor ID (SCC Manager)		jsl	sup_drvr_disp		bcs	justleave		;AHH! SCC Manager not found!						;AppleTalk is off!		stx	sup_num			;Store the sup number for later.		lda	#Start_ParmList		;Move parameter list pointer		sta	<sup_parm_ptr		;onto the zero page.		lda	#^Start_ParmList+2		sta	<sup_parm_ptr+2		lda	sup_num			;Supervisor number (SCC)		ldx	#$0002			;call number 2		ldy	#$0001			;Supervisor number		jsl	sup_drvr_disp		bcs	justleave		ldy	#slot_num		;Move the slot		lda	Slot			;number received from the		sta	[drvr_dib_ptr],y	;SCC Manager into our DIB.;------------------------------------------------------------------------------; Below we check to see if we're initilizing .AFP1 and if so, we don't; store the unit number because it's hard-coded to #1 in order to replace; any boot device that might exist.  This will waste one unit number, but; that shouldn't hurt anything.;------------------------------------------------------------------------------		ldy	#dib_specific		;Offset to internal DIB #		lda	[drvr_dib_ptr],y	;Load the internal DIB #		beq	@L1			;Branch if .AFP1		ldy	#unit_num		;Move the unit		lda	Unit			;number received from the		sta	[drvr_dib_ptr],y	;SCC Manager into our DIB.;------------------------------------------------------------------------------; Below we check to see if we've been warm started.  If we haven't warm; started yet, we init all the DIBS and set the PFI vectors.;------------------------------------------------------------------------------@L1		lda	start_flag		;Load warm start flag		bne	DoneInit		;Branch if we've already started		jsr	InitDIBs		;Only init the DIBs the first time						;through here.		ldx	#SetPFIVecs		;Tell PFI to jump to me when		ldy	#^SetPFIVecs		;anything important happens.		jsl	>RamDispatchDoneInit	inc	SS_Count		;Increment the global startup/						;shutdown flag.		inc	start_flag		;Mark that we've started.		lda	#0000			;No error		clcjustleave	rts				;Leave;-----------------------------------------------------------------------------; InitDIBs routine first sets all the .AFP drivers status word to $8001; (disk offline).  It then gets some memory for the ListSessions2 call.  It; then stuffs the resulting data from the ListSessions2 call into the DIBs.;-----------------------------------------------------------------------------InitDIBs	pei	<work1		pei	<work1+2		pei	<work2;-----------------------------------------------------------------------------; Below we init all the status words to Device Offline.;-----------------------------------------------------------------------------		ldx	#0000		;Start with entry number 1InitLoop	txa		asl	a		tay		lda	dib_table,y		sta	<work2		ldy	#$0020		;Index to status word.		lda	#$8000		;Disk not in drive		sta	(<work2),y		inx		cpx	#0014		bne	InitLoop;-----------------------------------------------------------------------------; Below we get a unique ID for our ListSessions2 destination buffer.;-----------------------------------------------------------------------------		pea	0000			;Result space		pea	$3C00			;Allocated by driver		_GetNewID		pla				;Get an ID and		sta	MyID			;store ID		bcc	@GotID			;Branch if successful		jmp	FixZP			;Ahh! Error out.;-----------------------------------------------------------------------------; Below we get a destination buffer for the ListSessions2 call.;-----------------------------------------------------------------------------@GotID		PushLong #0000			;Result space		PushLong #1358			;Max size of block for ListSession2		PushWord MyID			;User ID		PushWord #$C018			;Locked no-cross		PushLong #0			;Location (don't care)		_NewHandle		pla				;Pull low word		sta	<work1		sta	MyHandle		pla				;Pull high word		sta	<work1+2		sta	MyHandle+2		bcc	@GotMem			;Branch if successful		jmp	DeleteID		;Ahh! Error out.@GotMem		ldy	#2			;Dereference handle at WORK1		lda	[<work1]		;and store the resulting pointer		tax				;back at WORK1 and into the		lda	[<work1],y		;ListSession2 call parameter		sta	<work1+2		;block.		sta	DestBuffer+2		stx	<work1		stx	DestBuffer		ldx	#ListSessions		;Get the list of volumes that		ldy	#^ListSessions		;are already mounted.  This will		jsl	>RamDispatch		;be nill on booting.		bcs	NoVols			;If error, just leave.;-----------------------------------------------------------------------------; Below we loop through (0..NUMVOLS) and set all the necessary data in; all the .AFPn drivers DIBs.;-----------------------------------------------------------------------------		lda	NumVols		;Are there any volumes?		beq	NoVols		;Branch if not.		ldx	#0000		;Start with entry number 1CleanLoop	txa		asl	a		tay		lda	dib_table,y		sta	<work2		ldy	#0030			;Move 32 bytes (0-31)NameLoop	lda	[<work1],y		;Move the session ref #,		sta	(<work2),y		;name, and vol ID in.		dey		dey		bpl	NameLoop		inc	<Work2			;Bump Work2 so that Work2,20 and		inc	<Work2			;Work1,20 both point to server name.		sep	#$30		longa	off		longi	off		ldy	#96			;Move the next 65 bytes (base@L1		lda	[<Work1],y		;32 + 32 (server) +33 (zone) -1		sta	(<Work2),y		;(we start at 0) = 96 into the		dey				;dest buffer.		cpy	#32			;Keep going until we reach the		bcs	@L1			;status word.		rep	#$30		longa	on		longi	on		ldy	#$0020-2		;-2 because of two incs.		lda	#$8010			;Disk in drive		sta	(<work2),y		clc			;plus address		lda	<work1		adc	#97		sta	<work1		lda	<work1+2		adc	#0		sta	<work1+2				inx		cpx	NumVols		bcc	CleanLoop;-----------------------------------------------------------------------------; Now we dispose of our memory and user ID and leave.;-----------------------------------------------------------------------------NoVols		PushLong MyHandle	;My handle		_DisposeHandle		;Get rid of the memoryDeleteID	lda	MyID		;Push my ID onto the stack		pha		_DeleteID		;Delete my ID.FixZP		pla		sta	<work2		pla		sta	<work1+2		pla		sta	<work1		lda	#0000		clc		rtsMyID		dc.w	0MyHandle	dc.l	0sup_num		dc.w	0Start_ParmListSlot		dc.w	0000Channel		dc.w	0000Unit		dc.w	0000start_flag	dc.w	0			;+1 for each AFPn driver started.ListSessions	dc.b	00			;Synchronous		dc.b	$39			;FIListSessions		dc.w	0			;Result		dc.w	1358			;Buffer lengthDestBuffer	dc.l	0			;Buffer pointerNumVols		dc.b	00			;Entries returned		dc.b	00			;dummy zero for long compareSetPFIVecs	dc.b	00			;Synchronous		dc.b	$37			;FISetVectors		dc.w	0			;Result code		dc.b	$40			;$40 = GS/OS active		dc.l	VMountVol		;Mount Vol Vector		dc.l	VUnMountVol		;UnMount Vol Vector		dc.l	VAttention		;Attention Vector		dc.l	0		dc.l	0		endp		eject********************************************************************************* Below is the routine that is called for all un-supported calls with no error.********************************************************************************nullreq		proc		longa	on		longi	on		lda	#no_error		clc		rts		endp********************************************************************************* DRIVER CALL:  READ** This call executes a read from the device.  Block devices must* validate the initial block number and that the request count is* an integral multiple of the block size.  In addition the block* number of each successive block must be validated as it is* accessed when an multiple block I/O transaction is in place.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*       <drvr_buf_ptr = Pointer to I/O buffer*       <drvr_blk_num = Initial block number*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_blk_size = Size of block to be accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0  if no error*                       x x 0 0 0 0 x 1  0  if error********************************************************************************read		proc		longa	on		longi	on		ldy	#afpn_status		lda	[<drvr_dib_ptr],y	;Check for a disk switch		bit	#$0001			;(Insertion or Ejection)		beq	read1			;Branch if not.		and	#$FFFE			;Clear the disk switch		sta	[<drvr_dib_ptr],y	;state bit.		lda	#drvr_disk_sw		;Return with proper error.		sec		rtsread1		ldy	#afpn_status		;Get the current status for this		lda	[drvr_dib_ptr],y	;device.		and	#$0010			;Drive offline?		bne	readit			;Branch if not.		lda	#drvr_off_line		;Return with proper error.		sec		rtsreadit		lda	<drvr_req_cnt		;If the request count = 0 then		ora	<drvr_req_cnt+2		;we're already done.		beq	GoodExit		lda	<drvr_req_cnt+2		;Check the request count		cmp	#$0080			;If > $007FFFFF, too much.		blt	@L1		lda	#drvr_bad_count		;They asked for too much		sec				;Flag error and leave.		rts@L1		lda	#network_error		; was unknown_vol (MSD)		sec		rts; The code below transfers a block of zeros into the destination buffer.  This; routine was taken out in favor of the above error condition.;;		sta	<drvr_tran_cnt+2	;Set the transfer count =;		lda	<drvr_req_cnt;		sta	<drvr_tran_cnt		;to the request count.;;		pea	SourceBuffer>>16	;Source buffer;		pea	SourceBuffer;		pei	drvr_buf_ptr+2		;Destination buffer;		pei	drvr_buf_ptr;		pei	drvr_req_cnt+2		;Request count;		pei	drvr_req_cnt;		pea	$0804;		jsl	>$01FC70		;MOVE_INFOGoodExit	lda	#no_error		clc		rtsSourceBuffer	dc.w	0000		endp********************************************************************************* DRIVER CALL:  WRITE** This call executes a write from the device.  Block devices must* validate the initial block number and that the request count is* an integral multiple of the block size.  In addition the block* number of each successive block must be validated as it is* accessed when an multiple block I/O transaction is in place.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*       <drvr_buf_ptr = Pointer to I/O buffer*       <drvr_blk_num = Initial block number*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_blk_size = Size of block to be accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = 0=m=x=e*                       Carry = 1 if error occured*                       Carry = 0 if no error occured********************************************************************************write		proc		longa	on		longi	on		ldy	#afpn_status		lda	[<drvr_dib_ptr],y	;Check for a disk switch		bit	#$0001			;(Insertion or Ejection)		beq	write1			;Branch if not.		and	#$FFFE			;Clear the disk switch		sta	[<drvr_dib_ptr],y	;state bit.		lda	#drvr_disk_sw		;Return with proper error.		sec		rtswrite1		ldy	#afpn_status		;Get the current status for this		lda	[drvr_dib_ptr],y	;device.		and	#$0010			;Drive offline?		bne	writeit			;Branch if not.		lda	#drvr_off_line		;Return with proper error.		sec		rtswriteit		lda	<drvr_req_cnt		;If the request count = 0 then		ora	<drvr_req_cnt+2		;we're already done.		beq	GoodExit		lda	<drvr_req_cnt+2		;Check the request count		cmp	#$0080			;If > $007FFFFF, too much.		blt	@L1		lda	#drvr_bad_count		;They asked for too much		sec				;Flag error and leave.		rts@L1		lda	#drvr_wr_prot		;Just return with this error.		sec		rtsGoodExit	lda	#no_error		clc		rts		endp********************************************************************************* DRIVER CALL:  STATUS** This routine supports all the standard device status calls.* Any status call which is able to detect an OFFLINE or DISK* SWITCHED condition should call the system service routine* SET_DISKSW.  OFFLINE and DISKSW are conditions and not errors* when detected by a status call and should only be returned as* conditions in the status list.** Status Code:  $0000   Return Device Status*               $0001   Return Control Parameters*               $0002   Return Wait/No Wait Mode*               $0003   Return Format Options** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************status		proc		longa	on		longi	on		lda	<drvr_stat_code		;Is this a legal status call?		cmp	#$8002		beq	get_eject_status		cmp	#status_max		blt	@L1		lda	#drvr_bad_code		;Invalid call number		sec		rts@L1		asl	a		tax		lda	status_table,x		pha		rtsget_eject_status		lda	<drvr_req_cnt+2		bne	@badreqcnt		lda	<drvr_req_cnt		beq	status_null		cmp	#0002			;We only want 2.		bne	@badreqcnt		ldy	#dib_specific		lda	[drvr_dib_ptr],y		asl	a		tay		lda	eject_status,y		sta	[drvr_slist_ptr]@setxfercnt	brl	set_xfer_cnt@badreqcnt	lda	#drvr_bad_parm		;Invalid request count		sec		rtsstatus_table	dc.w	dev_stat-1		dc.w	get_ctrl-1		dc.w	get_wait-1		dc.w	status_null-1		;get_format-1		dc.w	status_null-1		;get_partn_map-1status_max	equ	(*-status_table)/2blockcount	dc.l	$007FFFFFstatus_null	lda	#no_error		clc		rtsdev_stat	ldx	<drvr_req_cnt+2		;High word		bne	status_bparm		ldx	<drvr_req_cnt		;Low word		beq	status_null		cpx	#0002		blt	status_bparm		cpx	#0007		bge	status_bparm		pei	<drvr_slist_ptr		pei	<drvr_slist_ptr+2		ldy	#afpn_status		sec		lda	<drvr_slist_ptr		sbc	#afpn_status		sta	<drvr_slist_ptr		lda	<drvr_slist_ptr+2		sbc	#0000		sta	<drvr_slist_ptr+2		lda	[<drvr_dib_ptr],y		sta	[<drvr_slist_ptr],y		cpx	#0003		blt	doneit		sep	#$20		longa	off		ldy	#afpn_status+2		ldx	#0002@L1		lda	blockcount-2,x		sta	[<drvr_slist_ptr],y		inx		iny		cpx	<drvr_req_cnt		bne	@L1doneit		rep	#$20		longa	on		pla		sta	<drvr_slist_ptr+2		pla		sta	<drvr_slist_ptr;; Now that we're done returning the device status (and block count), we have to; check for OFFLINE and DISKSW state.  If this condition exist then the; driver must call SET_DISKSW via the system service call table.  We don't want; to call SET_DISKSW if the volume is coming on-line.  The SET_DISKSW routine; doesn't understand that case.;		ldy	#afpn_status		lda	[<drvr_dib_ptr],y		and	#$0001			;Has it gone offline or disksw?		beq	set_xfer_cnt		;Branch if not.		ldy	#afpn_status		;Offset into dib		lda	[<drvr_dib_ptr],y	;Load current status		and	#$FFFE			;Disk switched handled.		sta	[<drvr_dib_ptr],y	;Store new status		jsl	set_disksw		;Tell GS/OS about switchset_xfer_cnt	lda	<drvr_req_cnt		;Set the transfer count equal		sta	<drvr_tran_cnt		;to the request count.		lda	<drvr_req_cnt+2		sta	<drvr_tran_cnt+2		lda	#no_error		clc		rtsget_ctrl	ldx	<drvr_req_cnt+2		bne	status_bparm		ldx	<drvr_req_cnt		beq	set_xfer_cnt		cpx	#0002			;Check againts min.		blt	status_bparm		cpx	#specific_size+3	;Check againts max.		blt	get_ctrl1status_bparm	lda	#drvr_bad_parm		;Invalid request count		sec		rtsget_ctrl1	lda	#specific_size		;Load real length of list		sta	[<drvr_slist_ptr]	;Store it in destination		dex				;Are we at the end yet?		dex		beq	set_xfer_cnt		ldx	#0002		ldy	#dib_specific		sep	#$20		longa	off@L1		lda	[drvr_dib_ptr],y		phy		txy		sta	[<drvr_slist_ptr],y		ply		iny		inx		cpx	<drvr_req_cnt		bne	@L1		rep	#$20		longa	on		bra	set_xfer_cntget_wait	lda	<drvr_req_cnt+2		bne	status_bparm		lda	<drvr_req_cnt		beq	set_xfer_cnt		cmp	#0002		bne	status_bparm		lda	#0000		sta	[<drvr_slist_ptr]		bra	set_xfer_cnt		endp********************************************************************************* DRIVER CALL:  CONTROL** This routine supports all the standard device control calls.** Control Code: $0000   Reset Device*               $0001   Format Device*               $0002   eject Media*               $0003   Set Control Parameters*               $0004   Set Wait/No Wait Mode*               $0005   Set Format Options*               $0006   Assign Partition Owner*               $0007   Arm Signal*               $0008   Disarm Signal** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************control		procwork1		equ	00		longa	on		longi	on		lda	<drvr_ctrl_code		;Is this a legal control call?		cmp	#$8001		beq	spec_c1		cmp	#$8002		beq	set_eject_status		cmp	#control_max		blt	L1control_bad	lda	#drvr_bad_code		;Invalid call number		sec		rtsL1		asl	a		tax		lda	control_table,x		pha		rtsspec_c1		jsl	ShowMessages		bra	control_null		;Leave with no errorset_eject_status		lda	<drvr_req_cnt+2		bne	@badreqcnt		lda	<drvr_req_cnt		beq	control_null		cmp	#0002			;We only want 2.		bne	@badreqcnt		ldy	#dib_specific		lda	[drvr_dib_ptr],y		asl	a		tay		lda	[drvr_clist_ptr]		sta	eject_status,y@setxfercnt	brl	set_xfer_cnt@badreqcnt	brl	bad_req_cntcontrol_null	lda	#no_error		clc		rtscontrol_table	dc.w	control_null-1		;dev_reset-1		dc.w	control_null-1		;format-1		dc.w	media_eject-1		dc.w	set_ctrl-1		dc.w	control_null-1		;set_wait-1		dc.w	control_null-1		;set_format-1		dc.w	control_null-1		;set_partn-1		dc.w	control_bad-1		;arm_signal-1		dc.w	control_bad-1		;disarm_signal-1		dc.w	control_null-1		;set_partn_map-1control_max	equ	(*-control_table)/2media_eject	ldy	#afpn_status		;Get the current status for this		lda	[drvr_dib_ptr],y	;device.		and	#$0010			;=zero if drive offline		beq	GoodExit			;Disk is offline, just leave@diskthere	ldy	#dib_specific		;Load index to DIB number		lda	[drvr_dib_ptr],y	;Load DIB number (0-13)		asl	a		tay				;Move into index reg.		lda	eject_status,y		;Load the eject status		beq	DoEject			;Branch if zero		ldy	#afpn_status		;Reset our status word to volume		lda	[drvr_dib_ptr],y		ora	#$0001			;disk switched. (bit 0)		sta	[drvr_dib_ptr],y		pei	<drvr_dev_num		;Device number		ldx	#0000			;Load null		phx				;Null		phx				;Null		lda	#$0008			;Disk inserted (not really)		jsl	>Post_OS_Event		bra	GoodExit		ENTRY	DoEject			;Entry for ShutDown call.DoEject		ldy	#afpn_session		;Get the session number of this		lda	[drvr_dib_ptr],y	;volume.		and	#$00FF			;Mask off dummy slot/drive byte.		beq	GoodExit		;Just leave if no volume mounted.		sta	LOSession		;Store in logoff call block.		sta	UMSessNum		;Store in unmount call block.		lda	drvr_dib_ptr		;UMVolName=^volume name in DIB.		clc		adc	#afpn_volname		sta	UMVolName		lda	drvr_dib_ptr+2		and	#$00FF		adc	#0		sta	UMVolName+2		ldy	#afpn_volID		;Copy the volid into the unmount		lda	[drvr_dib_ptr],y	;call block.		sta	UMVolID		ldx	#UnMountVol		;Unmount the volume.		ldy	#^UnMountVol		jsl	>RamDispatch		bcs	@L0;; We no longer fix-up the status word.  We let the unmount vector routine handle; this.  11/15/88   **TGH;;		ldy	#afpn_session		;Zero our session number in the;		lda	#0000			;DIB.;		sta	[drvr_dib_ptr],y;		ldy	#afpn_status		;Reset our status word to volume;		lda	#$0001			;offline and disk switched. (bit 4 & 0);		sta	[drvr_dib_ptr],y		jsr	Scan_4_Session		;Scan for other volumes with this #		bcc	GoodExit		;Branch if session # is valid.		ldx	#LogOut		ldy	#^LogOut		jsl	>RamDispatch		bcc	GoodExit@L0		lda	#$0088		sec		rtsGoodExit	lda	#$0000		clc		rtsScan_4_Session	pei	<work1		ldx	#0013ScanLoop	txa		asl	a		tay		lda	dib_table,y		sta	<work1		ldy	#$0020		lda	(<work1),y		;Load the status word		and	#$0010			;Is the disk in drive bit set?		beq	ScanNext		lda	(<work1)		;Load the session ref #		and	#$00FF		cmp	LOSession		beq	ScanExitScanNext	dex		bpl	ScanLoop		pla		sta	work1		sec		rtsScanExit	pla		sta	work1		lda	#no_error		clc		rtsUnMountVol	dc.b	00			;Synchronous		dc.b	$2E			;FIMountVol		dc.w	0			;Result codeUMSessNum	dc.b	0			;Session number ->		dc.b	$80			;UnMount VolUMVolName	dc.l	0			;Volume name pointer ->UMVolID		dc.w	0			;Volume ID # ->		dc.b	0			;Slot and driver		dc.l	0			;Password pointer (nil)LogOut		dc.b	00			;Synchronous		dc.b	$2D			;FILogout		dc.w	0			;Result codeLOSession	dc.b	0			;Session number		dc.b	0			;dummy byte for word storeset_ctrl	lda	<drvr_req_cnt+2		bne	bad_req_cnt		lda	<drvr_req_cnt		beq	set_xfer_cnt		cmp	#specific_size+2	;Plus 2 because of length word.		blt	set_xfer_cntbad_req_cnt	lda	#drvr_bad_parm		sec		rtsset_xfer_cnt	lda	<drvr_req_cnt		;Set the transfer count equal		sta	<drvr_tran_cnt		;to the request count.		lda	<drvr_req_cnt+2		sta	<drvr_tran_cnt+2		lda	#no_error		clc		rts		endp********************************************************************************* DRIVER CALL:  SHUTDOWN** This call prepares the driver for shutdown.  This may include* closing a character device as well as releasing any and all* system resources that may have been aquired by either a* STARTUP or OPEN call.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured********************************************************************************shutdown	proc		longa	on		longi	on; First we check to see if we're shuting down for good (cold).  If we're not,; we just continue on.  If we are, we unmount the volume (if any) and log off; the server if it's the last volume.		lda	Warm_Cold_Flag		;0 = cold, 1 = warm		bne	@CheckLocalShutdown	;Branch if we're just switching.; We now know that the machine is about to be turned off or restarted.  We; want to log off all file servers just to stay clean.		ldy	#afpn_status		;Offset into DIB for status word		lda	[<drvr_dib_ptr],y	;Load the status word		and	#$0010			;Is there a volume on line?		beq	@CheckLocalShutdown	;Branch if not.		jsr	DoEject			;This will do the ejectulation.; Now we check if we've shutdown any .AFPn drivers.  If not, we re-set the; PFI hooks to their default settings and mark us as shutdown.  We only want; to re-set the PFI hooks on the last driver.  If we have shutdown once, we; just skip to the main ATALK shutdown check.@CheckLocalShutdown		dec	start_flag		;Have we shutdown all yet?		bne	@CheckMainShutdown		ldx	#SetPFIVecs		;Tell PFI to NOT jump to me when		ldy	#^SetPFIVecs		;anything important happens.		jsl	>RamDispatch; Now we check to see if we're the last driver to shutdown.  We're just part; of the main .AFPn, .APPLETALK, and .RPM driver file.@CheckMainShutdown		dec	SS_Count		beq	@LastOne		lda	#drvr_bad_req		sec		rts@LastOne	lda	#no_error		clc		rtsSetPFIVecs	dc.b	00			;Synchronous		dc.b	$37			;FISetVectors		dc.w	0			;Result code		dc.b	$40			;$40 = GS/OS active		dc.l	0	;Default	;Mount Vol Vector		dc.l	0	;Default	;UnMount Vol Vector		dc.l	0	;Default	;Attention Vector		dc.l	0		dc.l	0		endp;-------------------------------------------------------------------------------;; VMountVol;; This routine is called by PFI when a volume has come on line.  It will first; scan the AFP DIBs for a free DIB.  If one is found its DIB specific information; is updated and is marked as on-line.  If a free DIB is NOT found, the MountVol; event is ignored.;; On Entry (via JSL):;;	A Reg = Unknown;	X Reg = Low word of parameter block pointer;	Y Reg = High word of parameter block pointer;	D Reg = PFI direct page;	B Reg = PFI data bank;	P Reg = N V M X D I Z C E;	        x x 0 0 0 x x x 0;; X and Y point to the following data structure:;;		Byte		Session reference number;		Byte		Unit #;		PString[28]	Volume name;		Word		Volume ID;		PString[32]	Server name;		PString[33]	Zone name;; On Exit (via RTL):;;	A Reg = Unknown;	X Reg = Unknown;	Y Reg = Unknown;	D Reg = PFI direct page;	B Reg = PFI data bank;	P Reg = N V M X D I Z C E;	        x x 0 0 0 x x x 0;VMountVol	proc				;Mount Vol VectorWork1		equ	$00Work2		equ	$04		phb		php				;     and P.		phk		plb		rep	#$30			;Longall		longa	on		longi	on		pei	<Work1			;Save PFI's zero page.		pei	<Work1+2		pei	<Work2		stx	<Work1			;Put the pointer to the data on zero		sty	<Work1+2		;page so we can access the data.		ldx	#0000SearchLoop	txa		asl	a		tay		lda	dib_table,y		sta	<Work2		ldy	#$0020		lda	(<Work2),y		;Load status word		and	#$0010		bne	KeepLooking		ldy	#0030NameLoop	lda	[<Work1],y		;Move the session ref #,		sta	(<Work2),y		;name, and vol ID in.		dey		dey		bpl	NameLoop		inc	<Work2		inc	<Work2		sep	#$30		longa	off		longi	off		ldy	#97-1@L1		lda	[<Work1],y		sta	(<Work2),y		dey		cpy	#32		bcs	@L1		rep	#$30		longa	on		longi	on		ldy	#$0020-2		;minus 2 because of the 2 inc's.		lda	#$8011			;Disk in drive, Disk switched		sta	(<Work2),y		bra	Exit			;Leave now...KeepLooking	inx				;Next DIB please...		cpx	#14			;Are we past the last one?		blt	SearchLoop		;Branch if not.Exit		pla				;Restore PFI's zero page.		sta	<Work2		pla		sta	<Work1+2		pla		sta	<Work1		plp				;Restore the state.		plb				;Restore b				rtl				;And exit.		endp;-------------------------------------------------------------------------------;; VUnMountVol;; This routine is called by PFI when a volume has gone off line.  It will first; scan all the AFP DIBs.  If the DIB was found it will mark the drive as off-line.; If the DIB was NOT found, the unmount event will be ignored.;; On Entry (via JSL):;;	A Reg = Unknown;	X Reg = Low word of parameter block pointer;	Y Reg = High word of parameter block pointer;	D Reg = PFI direct page;	B Reg = PFI data bank;	P Reg = N V M X D I Z C E;	        x x 0 0 0 x x x 0;; X and Y point to the following data structure:;;		Byte		Session reference number;		Byte		Unit #;		PString[28]	Volume name;		Word		Volume ID;		PString[32]	Server name;		PString[33]	Zone name;; On Exit (via RTL):;;	A Reg = Unknown;	X Reg = Unknown;	Y Reg = Unknown;	D Reg = PFI direct page;	B Reg = PFI data bank;	P Reg = N V M X D I Z C E;	        x x 0 0 0 x x x 0;VUnMountVol	proc				;UnMount Vol VectorWork1		equ	$00			;Zero page equates	(LONG)Work2		equ	$04			;			(WORD)		phb		php				;     and P.		phk		plb		rep	#$30			;Longall		longa	on		longi	on		pei	<Work1			;Save PFI's zero page.		pei	<Work1+2		pei	<Work2		stx	<Work1			;Put the pointer to the data on zero		sty	<Work1+2		;page so we can access the data.		ldx	#0000SearchLoop	txa		asl	a		tay		lda	dib_table,y		sta	<Work2		sep	#$30			;3-Mar-93 JCM		longa	off		longi	off			;3-Mar-93 JCM		lda	[<Work1]		;session refNum		cmp	(<Work2)		bne	KeepLooking*** Added - 3-Mar-93 JCM - This actually does a string compare based on the current length***			   of the string in the buffer. Before it was comparing all of the***			   bytes in the buffer, which can be a bad thing. If you had mounted***			   two volumes, one with a longer name than the other, the extra***			   characters could be in the source buffer (such as those coming***			   from the Ethernet card), causing the old compare to fail even when***			   we had really found the right volume. This caused AFP volumes to***			   appear not to unmount sometimes under GS/OS with the Ethertalk card.		ldy	#2		lda	[<Work1],y		;volume name string length byte					inc	a		inc	a		tay			ScanLoop	lda	[<Work1],y		cmp	(<Work2),y		bne	KeepLooking		dey		cpy	#2		bge	ScanLoop;;;		ldy	#0002;;;ScanLoop	lda	[<Work1],y;;;		cmp	(<Work2),y;;;		bne	KeepLooking;;;		iny;;;		cpy	#30;;;		bne	ScanLoop*** End - 3-Mar-93 JCM		rep	#$30			;3-Mar-93 JCM		longa	on		longi	on			;3-Mar-93 JCM		ldy	#$0020		lda	#$8001			;Disk NOT in drive, Disk switched		sta	(<Work2),y		bra	Exit			;Leave now...KeepLooking	rep	#$30			;3-Mar-93 JCM		longa	on		longi	on			;3-Mar-93 JCM		inx				;Next DIB please...		cpx	#14			;Are we past the last one?		blt	SearchLoop		;Branch if not.Exit		pla				;Restore PFI's zero page.		sta	<Work2		pla		sta	<Work1+2		pla		sta	<Work1		plp				;Restore the state.		plb				;Restore b				rtl				;And exit.		endp;-------------------------------------------------------------------------------;; VAttention;; This routine is called by PFI when an attention routine was received from the; server of the connection to the server was closed.;; On Entry (via JSL):;;	A Reg = Unknown;	X Reg = Low word of parameter block pointer;	Y Reg = High word of parameter block pointer;	D Reg = PFI direct page;	B Reg = PFI data bank;	P Reg = N V M X D I Z C E;	        x x 0 0 0 x x x 0;; X and Y point to the following data structure:;;		Byte		Session reference number;		Byte		Type;		Word		Attention data;		PString[32]	Server name;; On Exit (via RTL):;;	A Reg = Unknown;	X Reg = Unknown;	Y Reg = Unknown;	D Reg = PFI direct page;	B Reg = PFI data bank;	P Reg = N V M X D I Z C E;	        x x 0 0 0 x x x 0;VAttention	proc				;Attention Vector		ENTRY	ShowMessagesWork1		equ	$00			;Zero page equates	(LONG)Work2		equ	$04			;			(WORD)Work3		equ	$06			;			(WORD)		phb				;Save B register		php				;     and P register.		phk		plb		rep	#$30			;Longall		longa	on		longi	on		pei	<Work1			;Save PFI's zero page.		pei	<Work1+2		pei	<Work2		pei	<Work3		stx	<Work1			;Put the pointer to the data on zero		sty	<Work1+2		;page so we can access the data.		lda	[Work1]			;Session reference number		and	#$00FF			;1 byte long!		asl	a			;Times 2 for table.		tay		lda	AMessageTable,y		;Address of 1st sub string.		sta	Work2		lda	BMessageTable,y		;Address of 2nd sub string.		sta	Work3		jsr	MoveServerName		;Move server name into 1st						;sub string.		lda	[<Work1]		;Load attention type byte		and	#$FF00		bne	CrashCode		;Branch if session lost		ldy	#0002		lda	[<Work1],y		;Test attention code		and	#$00FF		bit	#$0040		bne	CrashCode		bit	#$0080		bne	ShutdownTime		jmp	Exit			;Anything else we ignore!CrashCode	lda	#0051		brl	PostItShutdownTime	ldy	#2		lda	[<Work1],y		xba				;Swap word because it's in						;AFP (high-low) format and						;we want it the other way.		beq	@L1			;If zero, it's closed down.		and	#$0FFF		cmp	#$0FFF		beq	ShutdownCancel				pha				; save number of minutes				sta	HValue		stz	DValue		ldy	#16		sed@L2		asl	HValue		lda	DValue		adc	DValue		sta	DValue		dey		bne	@L2		cld		jsr	ConvertToAscii		pla				; get number of minutes		jsr	SetCMsg			; set CMessages entry				lda	#0048			;Closing down in x minutes!		bra	PostIt@L1		lda	#0			; time is 0 minutes from now		jsr	SetCMsg				lda	#0049			;Closed down (0 minutes)!		bra	PostItSetCMsg; Convert minutes in A to seconds on stack		pha				; room for result		pha		pha				; push number of minutes		pea	60			; seconds/minute		_Multiply; Get the current date/time in seconds		pha				; room for result		pha		pea	$0006			; return time in seconds		pha				; ignore number of seconds		pha		pha				; ignore pointer to buffer		pha		_ConvSeconds			; get current time in seconds		; Add current and offset and store in CMessages		lda	[Work1]			; get session refnum		and	#$00FF			; low byte only		dea				; convert from 1-8 to 0-7		asl	a			; *2		asl	a			; *4		tay				; index to table of longs		clc		pla				; get current time low		adc	3,s			; add offset low		sta	CMessages,y		pla				; current time high		adc	3,s			; offset high		sta	CMessages+2,y		pla				; remove offset seconds		pla				rts		HValue		dc.w	0DValue		dc.w	0ShutdownCancel	lda	#0050PostIt		pha				;Save message number.		lda	[Work1]			;Get session number for		and	#$00FF			;index.  One byte!		asl	a		tay		pla				;Restore message number.		sta	MessageTable,y		;Store message number.		jsr	CallPostExit		rep	#$30		longa	on		longi	on		pla				;Restore PFI's zero page.		sta	<Work3		pla		sta	<Work2		pla		sta	<Work1+2		pla		sta	<Work1		plp				;Restore the state.		plb				;Restore b				rtl				;And exit.CallPost	sep	#$20		longa	off		lda	>$E1C068		;Save the statereg		pha		lda	>$E1C08B		;LCBANK1 - Switch in RAM		lda	>$E1C08B		;LCBANK1		rep	#$20		longa	on		lda	#0000			;Priority		ldx	#SHandler		;Handler low		ldy	#^SHandler		;Handler hight		jsl	>$01FC88		;Post Signal		sep	#$20		longa	off		pla		sta	>$E1C068		;Restore the statereg		rep	#$20		longa	on		rtsMoveServerName	php		sep	#$30		longa	off		longi	off		ldy	#4		lda	[Work1],y		tax		clc		adc	#4		tay@L1		lda	[Work1],y		phy		txy		sta	(Work2),y		ply		dex		dey		cpy	#4		bcs	@L1		plp		longa	on		longi	on		rts;--------------------------------------------------------------------------------; Convert a two-byte BCD number at DValue to a Pascal string of at most 3 digits; at the address pointed to by (Work3).  The upper nibble is ignored.  Leading; zero digits are removed (a value of zero is converted to "0").;--------------------------------------------------------------------------------ConvertToAscii		ldx	#2		; number of digits to generate - 1		ldy	#0		; index into string@loop		bit	#$0F00		; is upper digit zero?		bne	@stuff		; no, so start putting digits in		asl	a		; shift up one nibble (one BCD digit)		asl	a		asl	a		asl	a		dex			; any more digits to strip?		bne	@loop@stuff		pha			; save value		xba			; get next digit in low byte		and	#$000F		; want low digit only		ora	#$0030		; convert to ASCII digit character		iny			; point to next char in string				sep	#$20		; short A for store		sta	(Work3),y	; put ASCII digit in string		rep	#$20				pla			; get old value back		asl	a		; shift next digit up		asl	a		asl	a		asl	a		dex			; any more digits to do?		bpl	@stuff				tya			; get length in A		sep	#$20		; short A for store		sta	(Work3)		; save length byte		rep	#$20				rts		longa	on		longi	on;>>>>>>>>>>>>>>>>>>>>>>>>>>>	Signal Handler BelowSHandler	phb		phk		plb		php		php		pla		and	#$0004		beq	@L1		jsr	CallPost		bra	@L2@L1		ldy	#dib_dev_num		lda	dibv1,y		sta	DisplayDevice		jsl	>$E100A8		dc.w	$202E			;DCONTROL Class 2		dc.l	DisplayBlock@L2		plb		rtlShowMessages		ldx	#0016@L0		lda	MessageTable,x		beq	@L1		stz	MessageTable,x		phx		pha				;Push message number				lda	AMessageTable,x		; get pointer to server name		sta	Substitutions		; update sub. string *0		lda	BMessageTable,x		; get pointer to minutes string		sta	Substitutions+4		; update sub. string *1		; Make a date/time string by calling ConvSeconds		pha				; room for result		pha		pea	$0002			; convert seconds to ASCII text		txa				; get index into table of words		asl	a			; make it an index into table of longs		tax		lda	CMessages-2,x		; get high word of seconds		pha		lda	CMessages-4,x		; get low word of seconds		pha		PushLong #DateTimeStr+1		; push pointer to string data		_ConvSeconds		pla				; ignore result		pla				ldx	#18			; index to last word@loop		lda	DateTimeStr+1,x		and	#$7F7F			; strip high bits		sta	DateTimeStr+1,x		dex		dex		bpl	@loop				PushLong #Substitutions		jsl	>$01FC9C		; full_error system service call		plx@L1		dex		dex		bne	@L0		rtlDisplayBlock	dc.w	0005			;PcountDisplayDevice	dc.w	0			;Dev num		dc.w	$8001			;control code		dc.l	FakeList		;control list		dc.l	0			;request count		dc.l	0			;transfer countFakeList	equ	*			;NOT REALLY USED!MessageTable	dc.w	0		dcb.w	8,0Substitutions		dc.l	AMessages	; *0 = server name		dc.l	BMessages	; *1 = number of minutes to shutdown		dc.l	DateTimeStr	; *2 = date/time of shutdownDateTimeStr	dc.b	20		; length is always 20 bytes		dcb.b	20,0		; overwritten by ConvSeconds		AMessageTable	dc.w	0		dc.w	AMessages		dc.w	AMessages+(1*32)		dc.w	AMessages+(2*32)		dc.w	AMessages+(3*32)		dc.w	AMessages+(4*32)		dc.w	AMessages+(5*32)		dc.w	AMessages+(6*32)		dc.w	AMessages+(7*32)BMessageTable	dc.w	0		dc.w	BMessages		dc.w	BMessages+(1*4)		dc.w	BMessages+(2*4)		dc.w	BMessages+(3*4)		dc.w	BMessages+(4*4)		dc.w	BMessages+(5*4)		dc.w	BMessages+(6*4)		dc.w	BMessages+(7*4)AMessages	dcb.b	32,0		; Server name strings		dcb.b	32,0		dcb.b	32,0		dcb.b	32,0		dcb.b	32,0		dcb.b	32,0		dcb.b	32,0		dcb.b	32,0BMessages	dc.l	0		; number of minutes strings		dc.l	0		dc.l	0		dc.l	0		dc.l	0		dc.l	0		dc.l	0		dc.l	0CMessages		dc.l	0		; date/time of shutdown strings		dc.l	0		dc.l	0		dc.l	0		dc.l	0		dc.l	0		dc.l	0		dc.l	0		endp		;-------------------------------------------------------------------------------		END