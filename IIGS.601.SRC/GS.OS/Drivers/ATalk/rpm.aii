		msb	off		string	asis		print	sym		print	nopage		print	nomdir;--------------------------------------------------------------------------------------;;				.RPM Driver;;				Copyright (c) 1988;				Apple Computer, Inc.;				All rights reserved.;;--------------------------------------------------------------------------------------;; 0.01e01	03/27/88	TGH	-First attempt;; 00.07		12/15/88	TGH	-No longer make AppleTalk calls to the;					 supervisor.;					-Changed transfer and request count from;					 6 to 13 in DSTATUS and DCONTROL calls.;; 00.11B	2/1/88		TGH	-Added session between Opens and Closes;; NOTE:	All new change notes can be found in the MAIN.AII file.;;		1/6/90		MSD	-Added call to PMFlushSession in Close.;					 Fixes BRC #57640.  Also added call to;					 PMFlushSession in Flush (so Flush really;					 works).;;		14-Dec-92	DAL	-Changed BRAMLocation logic to allow for;					 having NO BRAM location controlling the;					 CR+LF preference, in the case of Ethernet.;;--------------------------------------------------------------------------------------		print	off		include	'm16.misctool'		include	'equates'		print	on		ejectRAMDispatch	equ	$E11014		IMPORT	SS_Count		entry	startup,\			open,\			read,\			write,\			close,\			slot_mask,\			status,\			control,\			flush,\			shutdown	:CODE		entry	Old_Timeout		entry	OpenCount		entry	read_mode		entry	x_value,y_value,e_read,e_status;--------------------------------------------------------------------------------------;; Following is the dispatch table used to call the supported call numbers.;;--------------------------------------------------------------------------------------disp_table	proc 		dc.w	startup-1		dc.w	open-1		dc.w	read-1		dc.w	write-1		dc.w	close-1		dc.w	status-1		dc.w	control-1		dc.w	flush-1		dc.w	shutdown-1		endp;--------------------------------------------------------------------------------------;; Main entry point for the .RPM driver.;;--------------------------------------------------------------------------------------		EXPORT	entry1entry1		proc		longa	on		longi	on		phb			;Save the GS/OS bank register		phk		plb		cmp	#0009		;Max command number		bge	illegal_req	;Oops, too big.		pea	func_ret-1	;Push our return address		asl	a		tax		lda	disp_table,x		pha			;Push the address of routine on the stack		rtsfunc_ret	tay			;Save the returned error code		plb		bcs	gen_exit	;Branch if there is an error		ldy	#no_errorgen_exit	tya		rtlillegal_req	plb		lda	#drvr_bad_req		sec		rtl		endp		eject;--------------------------------------------------------------------------------------;; STARTUP;; We first operate on this function and then pass control on to the generated device; driver dispatch entry point.;;--------------------------------------------------------------------------------------startup		proc		entry	sup_num,BRAMLocation		longa	on		longi	on		lda	#$0000		tax		ldy	#$0001		jsl	sup_drvr_disp		bcs	@shortleave		stx	sup_num		lda	#Start_ParmList		sta	<sup_parm_ptr		lda	#^Start_ParmList+2		sta	<sup_parm_ptr+2		lda	sup_num		ldx	#$0002			;call number 2		ldy	#$0001		jsl	sup_drvr_disp@shortleave	bcs	justleave		ldy	#slot_num		lda	Slot		sta	[drvr_dib_ptr],y		ldy	#unit_num		lda	Unit		sta	[drvr_dib_ptr],y		jsl	gen_dispatch		bcs	justleave		lda	Slot		pha		ora	#$00C0		sta	x_value			;This stores $00Cn		xba		sta	slot_mask		;This stores $Cn00		pla		and	#$000F		asl	a		asl	a		asl	a		asl	a		sta	y_value		lda	slot_mask		;Load $Cn00		ora	#$000E			;OR it with read offset		tax				;Move to index reg		lda	>0,x			;Load the offset value.		and	#$00FF			;We only want the low byte.		ora	slot_mask		;OR it with the $Cn00		sta	e_read			;Store it in read vector value.		lda	slot_mask		;Load $Cn00		ora	#$0010			;OR it with status offset		tax				;Move to index reg		lda	>0,x			;Load the offset value.		and	#$00FF			;We only want the low byte.		ora	slot_mask		;OR it with the $Cn00		sta	e_status		;Store it in status vector value.		stz	read_mode		;Make sure readmode is set to wait*** Modified 14-Dec-92 DAL  		ldx	#0			;anticipate no BRAM preference available (Ethernet)		lda	Channel			;Load channel (1 or 2)		beq	@storeBRAM*** end 14-Dec-92		ldx	#$0003			;Assume slot 1 firmware use		lda	Channel			;Load channel (1 or 2)		cmp	#0001			;Is it 1?		beq	@storeBRAM		;Branch if yes (store $3)		ldx	#$000F			;Load a $F for slot 2 firmware)@storeBRAM	stx	BRAMLocation		;Store BRAM location for firmware		inc	SS_Count		stz	OpenCount		;Mark us as not open		lda	#no_error		clcjustleave	rtssup_num		dc.w	0BRAMLocation	dc.w	0000Start_ParmListSlot		dc.w	0000Channel		dc.w	0000Unit		dc.w	0000		endp;--------------------------------------------------------------------------------------;; OPEN;; This call is passed on to the generated device driver dispatch entry point.;;--------------------------------------------------------------------------------------open		proc		entry	OpenCount		lda	OpenCount		beq	@L1		lda	#drvr_prior_open		sec		rts@L1		lda	#$0001		sta	RPM_Flags		ldx	#RPM_ParmList		ldy	#^RPM_ParmList		jsl	>RamDispatch		lda	RPM_Timeout		sta	Old_Timeout		stz	RPM_Timeout		ldx	#RPM_ParmList		ldy	#^RPM_ParmList		jsl	>RamDispatch		jsl	gen_dispatch		bcc	@good_open;----------------------------------------------------------------------; Oops, below we handle the case of an error from the generated; device management code after the open call.  We have to restore; the old timeout value.;----------------------------------------------------------------------		pha				;Save the error number		lda	Old_Timeout		;Load the old timeout value		sta	RPM_Timeout		;Store it for re-set.		ldx	#RPM_ParmList		;Reset the old timeout		ldy	#^RPM_ParmList		;value with a PMSetPrinter		jsl	>RamDispatch		;call.		pla				;Restore the error number		sec				;Flag an error		rts				;Return;----------------------------------------------------------------------; Below we read the battery ram byte to see if we should set the bit; in the AppleTalk slot screen hole that will add a linefeed to ; carriage returns.  We have to do this because the Pascal open routine; always turns this bit off regardless to the Control Panel settings.;----------------------------------------------------------------------@good_open	lda	BRAMLocation		;Load $3 or $F		beq	@done_open		;or $00 for Ethernet, no BRAM parameter (added 14-Dec-92 DAL)		pea	0000			;Result space		pha				;Push reference number (03 or 0F)		_ReadBParam		pla				;1 = yes, 0 = no		beq	@done_open		;Branch if don't add LF to CR		lda	slot_mask		;Load $Cn00 value		xba				;Make it $00Cn		tax				;Move into index register		sep	#$20		longa	off		lda	>$000738,x		;Load 738,$Cn		ora	#$40			;Turn on the +LFtoCR bit		sta	>$000738,x		;Store it back		rep	#$20		longa	on@done_open	inc	OpenCount		;Mark us as open		clc				;Flag no error		rts				;ReturnRPM_ParmList	dc.b	$00				;Synchronous Call		dc.b	$28				;Call NumberRPM_Result	dc.w	$00				;Result Code		dc.l	Entity_Name			;Entity PointerRPM_Flags	dc.b	$01				;FlagsRPM_Flush	dc.w	$0000				;Flush IntervalRPM_Timeout	dc.w	$0000				;Timeout IntervalRPM_BuffNum	dc.w	$0000				;Number of BuffersEntity_Name	ds.b	33		;Name		ds.b	33		;Kind		ds.b	34		;ZoneOpenCount	dc.w	0		endp;--------------------------------------------------------------------------------------;; READ;; This call is passed on to the generated device driver dispatch entry point.;;--------------------------------------------------------------------------------------read		proc		ENTRY	read_mode,\			e_status,\			e_read,\			x_value,\			y_value		lda	OpenCount		;Load the open count flag		bne	@drvr_open		;Branch if we're open		lda	#drvr_not_open		;Else we report not open		sec				;error.		rts@drvr_open	lda	<drvr_req_cnt		;Check the request count		ora	<drvr_req_cnt+2		;for zero		bne	read_loop		;Branch if not zero		jmp	rgood_exit		;Just exit, no error.read_loop	pea	0000		;Result space		pea	0000		;Result space		pea	0000		;Result space		pea	0000		;Result space		pea	0001		;A reg (1 = read ready?)		lda	x_value		;X reg		pha		lda	y_value		;Y reg		pha		lda	e_status	;emulation entry point		pha		ldx	#$2403		;_FWEntry		jsl	>$E10000		ply			;Y reg (ignore)		plx			;X reg ( 0 = no error, 3 = error)		ply			;A reg (ignore		pla			;P reg ( c=0 = not ready, c=1 = ready)		cpx	#0		;Was there an error?		bne	rgood_exit	;Branch if yes (shouldn't happen)		and	#$0100		;Are there characters to read?		bne	@read_it	;Branch if yes		lda	read_mode	;Load read mode flag		bpl	read_loop		bra	rgood_exit; No we fall through and read a character@read_it	pea	0000		;Result space		pea	0000		;Result space		pea	0000		;Result space		pea	0000		;Result space		pea	0000		;A reg (1 = read ready?)		lda	x_value		;X reg		pha		lda	y_value		;Y reg		pha		lda	e_read		;emulation entry point		pha		ldx	#$2403		;_FWEntry		jsl	>$E10000		ply			;Y reg (ignore)		plx			;X reg ( 0 = no error, 3 = error )		pla			;A reg ( character )		ply			;P reg (ignore)		cpx	#0		;Was there an error?		beq	@goodread	;Branch if not		lda	#drvr_io_error	;Some kind of read error.		bra	exit		;Leave with IO ERROR.@goodread	sta	[<drvr_buf_ptr]	;Store the character in user buffer		inc	<drvr_buf_ptr		bne	@inc_tran_cnt		inc	<drvr_buf_ptr+2@inc_tran_cnt	inc	<drvr_tran_cnt		bne	@check_req_cnt		inc	<drvr_tran_cnt+2@check_req_cnt	lda	<drvr_tran_cnt		cmp	<drvr_req_cnt		bne	@loop_back		lda	<drvr_tran_cnt+2		cmp	<drvr_req_cnt+2		beq	rgood_exit@loop_back	jmp	read_looprgood_exit	lda	#no_error		clcexit		rtsread_mode	dc.w	0e_status	dc.w	0e_read		dc.w	0	export slot_maskslot_mask	dc.w	0x_value		dc.w	0y_value		dc.w	0		endp;--------------------------------------------------------------------------------------;; WRITE;; This call is passed on to the generated device driver dispatch entry point.;;--------------------------------------------------------------------------------------write		proc		jsl	gen_dispatch		rts		endp;--------------------------------------------------------------------------------------;; CLOSE;; This call is passed on to the generated device driver dispatch entry point.;;--------------------------------------------------------------------------------------close		proc		entry	Old_Timeout		lda	OpenCount		beq	@L1;; MSD: Added call to PMFlushSession (1/6/90).  Fixes BRC #57640 (DTS 89.0602).; Unwritten data now gets flushed before closing session.;		ldx	#PMFlushSession		ldy	#^PMFlushSession		jsl	>RamDispatch				ldx	#PMCloseSession		ldy	#^PMCloseSession		jsl	>RamDispatch		lda	#$0001		sta	RPM_Flags		ldx	#RPM_ParmList		ldy	#^RPM_ParmList		jsl	>RamDispatch		lda	RPM_Timeout		bne	@L1		lda	Old_Timeout		sta	RPM_Timeout		ldx	#RPM_ParmList		ldy	#^RPM_ParmList		jsl	>RamDispatch@L1		jsl	gen_dispatch		bcs	@L2		stz	OpenCount@L2		rtsPMCloseSession	dc.b	$00				;Synchronous Call		dc.b	$47				;PMCloseSession		dc.w	0				;Result Code; MSD: Added 1/6/90PMFlushSession	dc.b	$00				;Synchronous Call		dc.b	$48				;PMFlushSession		dc.w	0				;Result CodeRPM_ParmList	dc.b	$00				;Synchronous Call		dc.b	$28				;Call NumberRPM_Result	dc.w	$00				;Result Code		dc.l	Entity_Name			;Entity PointerRPM_Flags	dc.b	$01				;FlagsRPM_Flush	dc.w	$0000				;Flush IntervalRPM_Timeout	dc.w	$0000				;Timeout IntervalRPM_BuffNum	dc.w	$0000				;Number of BuffersEntity_Name	ds.b	33		;Name		ds.b	33		;Kind		ds.b	34		;ZoneOld_Timeout	dc.w	$0000				;Old Timeout Interval		endp;--------------------------------------------------------------------------------------;; STATUS;; We first operate on this function and then pass control on to the generated device; driver dispatch entry point.;;--------------------------------------------------------------------------------------status		proc		longa	on		longi	on		lda	<drvr_stat_code		cmp	#$0002			;Return wait status?		beq	stat0002		;branch if yes		cmp	#$8001			;Return RPM data?		beq	stat8001		;branch if yes		jsl	gen_dispatch		rtsstat0002	lda	#drvr_bad_parm		;Assume error for now		ldx	<drvr_req_cnt+2		;If high word > 0, error		bne	@bad_stat0002		ldx	<drvr_req_cnt		;If low word <> 0, error		beq	set_xfer_cnt		cpx	#$0002		beq	@ok_stat0002@bad_stat0002	sec		rts@ok_stat0002	lda	read_mode		sta	[<drvr_slist_ptr]		bra	set_xfer_cntstat8001	lda	<drvr_req_cnt+2		bne	badstat8001		lda	<drvr_req_cnt		beq	set_xfer_cnt		cmp	#$000D		beq	goodstat8001badstat8001	lda	#drvr_bad_parm		sec		rtsgoodstat8001	lda	#$0001		sta	RPM_Flags		ldy	#$0002		lda	[drvr_slist_ptr],y		sta	RPM_Entity		iny		iny		lda	[drvr_slist_ptr],y		sta	RPM_Entity+2		ldx	#RPM_ParmList		ldy	#^RPM_ParmList		jsl	>RamDispatch		php		pha		lda	RPM_Result		sta	[drvr_slist_ptr]		pla		plp		bcs	done		ldy	#$0006		lda	RPM_Flags		sta	[drvr_slist_ptr],y		iny		lda	RPM_Flush		sta	[drvr_slist_ptr],y		iny		iny		lda	RPM_Timeout		sta	[drvr_slist_ptr],y		iny		iny		lda	RPM_BuffNum		sta	[drvr_slist_ptr],yset_xfer_cnt	lda	<drvr_req_cnt		sta	<drvr_tran_cnt		lda	#0000		sta	<drvr_tran_cnt+2		clcdone		and	#$00FF		rtsRPM_ParmList	dc.b	$00				;Synchronous Call		dc.b	$28				;Call NumberRPM_Result	dc.w	$00				;Result CodeRPM_Entity	dc.l	$0000				;Entity PointerRPM_Flags	dc.b	$01				;FlagsRPM_Flush	dc.w	$0000				;Flush IntervalRPM_Timeout	dc.w	$0000				;Timeout IntervalRPM_BuffNum	dc.w	$0000				;Number of Buffers		endp;--------------------------------------------------------------------------------------;; CONTROL;; We first operate on this function and then pass control on to the generated device; driver dispatch entry point.;;--------------------------------------------------------------------------------------control		proc		longa	on		longi	on		lda	<drvr_ctrl_code		cmp	#$0000			;Reset?		beq	ctrl0000		cmp	#$0004			;Set wait/nowait mode?		beq	ctrl0002		;branch if yes		cmp	#$8001			;Set RPM parameters?		beq	ctrl8001		;branch if yesctrl_todispatch	jsl	gen_dispatch		rtsctrl0000	stz	read_mode		bra	ctrl_todispatchctrl0002	lda	#drvr_bad_parm		;Assume error for now		ldx	<drvr_req_cnt+2		;If high word > 0, error		bne	@bad_ctrl0002		ldx	<drvr_req_cnt		;If low word <> 0, error		beq	set_xfer_cnt		cpx	#$0002		beq	@ok_ctrl0002@bad_ctrl0002	sec		rts@ok_ctrl0002	lda	[<drvr_clist_ptr]		sta	read_mode		bra	set_xfer_cntctrl8001	lda	<drvr_req_cnt+2		bne	badctrl8001		lda	<drvr_req_cnt		beq	set_xfer_cnt		cmp	#$000D		beq	goodctrl8001badctrl8001	lda	#drvr_bad_parm		sec		rtsgoodctrl8001	ldy	#$0002		lda	[drvr_clist_ptr],y		sta	RPM_Entity		iny		iny		lda	[drvr_clist_ptr],y		sta	RPM_Entity+2		iny		iny		lda	[drvr_clist_ptr],y		sta	RPM_Flags		iny		lda	[drvr_clist_ptr],y		sta	RPM_Flush		iny		iny		lda	[drvr_clist_ptr],y		sta	RPM_Timeout		iny		iny		lda	[drvr_clist_ptr],y		sta	RPM_BuffNum		ldx	#RPM_ParmList		ldy	#^RPM_ParmList		jsl	RamDispatch		php		pha		lda	RPM_Result		sta	[drvr_clist_ptr]		pla		plp		bcs	done		ldy	#$0006		lda	RPM_Flags		sta	[drvr_slist_ptr],y		iny		lda	RPM_Flush		sta	[drvr_slist_ptr],y		iny		iny		lda	RPM_Timeout		sta	[drvr_slist_ptr],y		iny		iny		lda	RPM_BuffNum		sta	[drvr_slist_ptr],yset_xfer_cnt	lda	<drvr_req_cnt		sta	<drvr_tran_cnt		lda	#0000		sta	<drvr_tran_cnt+2		clcdone		and	#$00FF		rtsRPM_ParmList	dc.b	$00				;Synchronous Call		dc.b	$28				;Call NumberRPM_Result	dc.w	$00				;Result CodeRPM_Entity	dc.l	$0000				;Entity PointerRPM_Flags	dc.b	$01				;FlagsRPM_Flush	dc.w	$0000				;Flush IntervalRPM_Timeout	dc.w	$0000				;Timeout IntervalRPM_BuffNum	dc.w	$0000				;Number of Buffers		endp;--------------------------------------------------------------------------------------;; FLUSH;; This call first passes the call on to the generated device driver dispatcher; and then does a PMFlushSession to make sure all the bytes are written.;;--------------------------------------------------------------------------------------flush		proc		jsl	gen_dispatch		bcs	exit			; just return if error				ldx	#<PMFlushSession	; Flush them bytes		ldy	#^PMFlushSession		jsl	RamDispatch				clc		lda	#0exit		rtsPMFlushSession	dc.b	$00				;Synchronous Call		dc.b	$48				;PMFlushSession		dc.w	0				;Result Code		endp;--------------------------------------------------------------------------------------;; SHUTDOWN;; This call is passed on to the generated device driver dispatch entry point.;;--------------------------------------------------------------------------------------shutdown	proc		jsl	gen_dispatch		dec	SS_Count		beq	@L1		lda	#drvr_bad_req		sec		rts@L1		lda	#$0000		clc		rts		endp;--------------------------------------------------------------------------------------		END