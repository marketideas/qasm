********************************************************************************* File: ATPATCH** This file contains the 65816 implementation of ZIP for the Apple IIGS.** ATPATCH was originally responsible for loading ATINIT under prodos 16.* It also contained all the patches for the ROM code.** Copyright Apple Computer, 1986* Original Author: Greg Seitz*                  18-Jun-86*                  ver 1.2********************************************************************************** Modification History*** v1.2** 10/28/86    gws	- added old rom nbp patch the second entry point*	  after zip will install the required patches to*	  the old version 1.0 roms that contain a bug in*	  NBP case comparisions** 12/8/87     gws	- corrected problem in getzonelist where a large*	  number of zones would not be counted properly*	  when we sent more than 1 request.** v1.3** 8/18/88    TGH	- Started working on changes for the RevD ROM** 14-Dec-90  MSD	Added new call, GetNetInfo ($3F) and placeholders*	for GetZoneList2 ($3C), GetLocalZones ($3D),*	SetMyZone ($3E).** 06-Feb-91  MSD	Removed the new calls added on 14-Dec-90 since Phase II*	support will be delayed until Dudley ships.********************************************************************************	MACHINE M65816	PRINT GEN	INCLUDE '::ASP:atp.equates.inc'	INCLUDE '::ASP:global.equates.inc'zipNotExtended	equ $0604	; network not extendedzipBufTooSmall	equ $0605	; (multicast) buffer too smallzipinstall	PROC EXPORT	import	GetZoneList2,GetLocalZones,SetMyZone,GetNetInfo	import	gzl2cmdlist,glzcmdlist		jml installinstall		; ;init and install	driver	rep #mbit+xbit	longa on	longi on	phb	phk	;data is in same bank as code	plb	lda softreset	;get the current reset vector	sta oldreset	;and store internally	lda softreset+2	sta oldreset+2	;now we have the old vector	lda jzourreset	;store a jml ourreset	sta softreset	;into vector	lda jzourreset+2	sta softreset+2	jsr zipinit	;zero out stuff	; Install original ZIP calls	ldx #ourcmds	;get our command table	ldy #$d600+($1a*4)	;table starts at $d600	lda #endcmds-ourcmds-1 ;move this many bytes	mvn ourcmds,$e10000	;to bank $e1	; Install AppleTalk Phase 2 calls	ldx #ourcmds2	;get our command table	ldy #$d600+($3C*4)	;table starts at $d600	lda #endcmds2-ourcmds2-1 ;move this	many bytes	mvn ourcmds2,$e10000 ;to bank $e1	plb	rtljzourreset	jml ourresetzipinit		; 	stz zerodata	;start with a zero	ldx #zerodata	;move from here	ldy #zerodata+1	;move to here (carrys zeros forward)	lda #zeroend-zerodata-2 ;number of bytes to clear out	mvn zerodata,zerodata	stz gzl2cmdlist	; these are in separate data areas	stz gzl2cmdlist+2	stz glzcmdlist	stz glzcmdlist+2		rtsourcmds		; 	DC.A getmyzone	;$1a	DC.B zipzplen	DC.A getzonelist	;$1b	DC.B zipzplenendcmds		; ourcmds2	dc.a GetZoneList2	; $3C	dc.b 0	; no zero page used	dc.a GetLocalZones	; $3D	dc.b 0	; no zero page used	dc.a SetMyZone	; $3E	dc.b 0	; no zero page used	dc.a GetNetInfo	; $3F	dc.b 0	; no zero page usedendcmds2ourreset		; ;should come here	during reset	php	;save mode bits	phb	;and databank	jsl oldreset	;let lower protocol	get called first	phk	;set up data bank	plb	jsr zipinit	;and re-init zip	plb	;restore bank	plp	;and mode bits	rtl	;and return to our calleroldreset		; ;this code gets old   reset vector	jml $000000	;dummy code	entry setupsetup		; 	jsl RamForbid	rep #mbit+xbit	longa on	longi on	phk	plb	rts** getzonelist* gets a list of zones for the user* from the user supplied bridge*getzonelist		; 	jsr setup	;sets up stuff for entry	longa on	longi on	lda gzlcmdlist	;see if call in progress	ora gzlcmdlist+2	beq callok	;no	lda #zipinuse	;error	jmp accumexit	;and leavecallok		; 	lda cmdlist	sta gzlcmdlist	lda cmdlist+2	;mark call as in use	sta gzlcmdlist+2	ldy #$0a	;offset to buffer pointer	lda [cmdlist],y	sta gzlrqbds+bds_bufptr	iny	iny	lda [cmdlist],y	sta gzlrqbds+bds_bufptr+2	ldy #$08	;move to length field	lda [cmdlist],y	sta gzlrqbds+bds_bufsize ;set up buffer	size	ldy #$0f	;get index of start	lda [cmdlist],y	xba	;put in mac format	sta gzlrq+atprq_user+2	ldy #$11	;get retry interval	and count	lda [cmdlist],y	sta gzlrq+atprq_interval	ldy #$0e	;get bridge node to	use	lda [cmdlist],y	sep #mbit	;use 8 bit a	longa off	sta gzlrq+atprq_dnode	rep #mbit	longa on	stz icount	;none have been counted yet	sep #mbit+xbit	longa off	longi off	lda #$01	;reset bitmap	sta gzlrq+atprq_bitmap	rep #mbit+xbit	longa on	longi on	lda #zipbusy	;get pap busy flag	ldy #$02	;get offset to result	sta [cmdlist],y	;and save it	ldx #gzlrq	ldy #^gzlrq	jsl RamDispatch	jml RamPermit	;re-enable ints and	leavegzlcomp		; ;comes here when above call completes	clc	xce	rep #mbit+xbit	longa on	longi on	lda gzlrq+2	;get result	beq compok	;ok	lda #zipnotfound	sta status	;set error code	lda icount	;get count	bra errxcompok		; 	lda gzlrqbds+bds_actlen ;see if got overflow	bpl checkend	;no so see if done normally	ldy #0000	tyx	;set x,y to zero for use in loop	lda gzlrqbds+bds_bufptr ;get pointer to	current buf position	sta cmdlist	lda gzlrqbds+bds_bufptr+2	sta cmdlist+2ovlp		; 	lda [cmdlist],y	;get length of item	and #$00ff	;strip high byte	clc	pha	tya	adc $1,s	;add to current index	ply	tay	cpy gzlrqbds+bds_bufsize ;see if beyond	size of buffer	bcs ovdone	;yes so we are done	counting good stuff	inx	;bump good counter	iny	;move to next length field	bra ovlp	;and keep goingovdone		; 	txa	xba	;put in mac format	sta gzlrqbds+bds_user+2 ;set correct count for this call	lda #zipoverflow	;more names than buffer	sta status	bra yesend	;and do exit stuffcheckend		; ;see if we are at	the end	lda gzlrqbds+bds_user	beq morenames	;not at end yet	stz status	;no erroryesend		; ;we are done gathering names	clc	lda gzlrqbds+bds_user+2 ;get count	xba	;put in our format	adc icount	;internal counterrx		; ;error so leave	ldx gzlcmdlist	;get their command list	stx cmdlist	ldx gzlcmdlist+2	stx cmdlist+2	ldy #$13	sta [cmdlist],y	;and return number of zones	stz gzlcmdlist	stz gzlcmdlist+2	jsl RamForbid	;balance permit in exit	lda status	;get error code	jmp accumexit	;and leavemorenames		; ;we still have more   names to get	clc	lda gzlrqbds+bds_user+2 ;add count from	this call	xba	pha	;save a copy of it in our format	adc icount	;get internal count	sta icount	;and save new total	clc	lda gzlrq+atprq_user+2 ;get running position of zones	xba	;put in our format	adc $1,s	;add to count from this call	xba	;put result in mac format	sta gzlrq+atprq_user+2 ;store new position to scan from	plx	;discard junk	lda gzlrqbds+bds_actlen ;get actual amount of buffer used	pha	;save temporarily	clc	adc gzlrqbds+bds_bufptr	sta gzlrqbds+bds_bufptr	lda #0000	;add in carry if any	adc gzlrqbds+bds_bufptr+2	sta gzlrqbds+bds_bufptr+2	sec	;set up for subtract	lda gzlrqbds+bds_bufsize ;get current buffer remaining	sbc $1,s	;and subtract amount just used	plx	;discard junk	sta gzlrqbds+bds_bufsize ;save new amount remaining	sep #mbit+xbit	longa off	longi off	lda #$01	;reset bitmap	sta gzlrq+atprq_bitmap	rep #mbit+xbit	longa on	longi on	ldx #gzlrq	;issue a new request for another packet	ldy #^gzlrq	jml RamDispatch	;make the callasyncexit		; 	rep #mbit+xbit	longa on	longi on	lda #zipbusy	;get pap busy flag		entry accumexitaccumexit		; ;exit with what's in accum	rep #mbit+xbit	longa on	longi on	ldy #$02	;get offset to result	sta [cmdlist],y	;and save it	jsl RamPermit	;back down ints	sep #mbit+xbit	longa off	longi off	ora #00	;see if done	bpl chkiocmp	;yepgoback		; 	rep #mbit+xbit	rtl	;otherwise just exitchkiocmp		; 	sep #mbit+xbit	longa off	longi off	lda [cmdlist]	;see what type of command	bpl goback	;sync so exit	ldy #$02	;offset to result	lda [cmdlist],y	;get result	bmi goback	;still busy	ldy #$04	;offset to completioncallcomp		; 	rep #mbit+xbit	longa on	longi on	lda [cmdlist],y	;get low word completion	sta execaddr	iny	iny	lda [cmdlist],y	;get high word completio`	sta execaddr+2	ora execaddr	;see if zero	beq goback	;yep, so nothing to	call	jmp RamGoComp	;call completion routinegetmyzone		; ;gets users zone	jsr setup	longa on	longi on	lda gmzcmdlist	ora gmzcmdlist+2	;see if call in progress	beq callok1	;nope so ok	lda #zipinuse	;error	jmp accumexit	;and leavecallok1		; 	lda cmdlist	sta gmzcmdlist	lda cmdlist+2	sta gmzcmdlist+2	ldx #getinfo	;make getinfo call	ldy #^getinfo	jsl RamDispatch	lda abridge	;get bridge number;; 09-Jul-91 MSD: If the router node number is zero, immediately return ZIPNotFound;	and #$FF	; get just A-Bridge	bne @router	; keep going if we have a router	lda #zipnotfound	jmp accumexit	; no zone because there's no router@router;; end of 09-Jul-91 MSD change;	sep #mbit+xbit	;go to 8 bit mode	longa off	longi off	sta gmzrq+atprq_dnode ;use as destination node	lda #01	;set bitmap	sta gmzrq+atprq_bitmap	rep #mbit+xbit	;back to full 16	longa on	longi on	ldy #$0c	;offset to retry interval and count	lda [cmdlist],y	;get both	sta gmzrq+atprq_interval ;and store them in list	ldy #$08	;offset to buffer pointer	lda [cmdlist],y	;get low word	sta gmzrqbds+bds_bufptr ;save low word	iny	;move to high word	iny	lda [cmdlist],y	sta gmzrqbds+bds_bufptr+2	lda #zipbusy	;show that zip is currently busy	ldy #$02	;offset to result	sta [cmdlist],y	ldx #gmzrq	ldy #^gmzrq	;issue call	jsl RamDispatch	jml RamPermit	;let atalk ints in again, and exitgmzcomp		; 	clc	xce	rep #mbit+xbit	longa on	longi on	lda gmzrq+2	;get result from call	beq exitgmz	;exit good	lda #zipnotfound	;no response from bridgeexitgmz		; 	pha	;save error code	lda gmzcmdlist	;get users command list	sta cmdlist	lda gmzcmdlist+2	sta cmdlist+2	stz gmzcmdlist	stz gmzcmdlist+2	;let user make new calls	jsl ramforbid	pla	;recover error code	jmp accumexit	;and leave with error in azerodata		; icount	DS.B 2gzlcmdlist	DS.B 4gmzcmdlist	DS.B 4	entry statusstatus	DS.B 2zeroend		; gzlrq	DC.B $80,$12,$00,$00 ;cnt, cmd, result	DC.L gzlcomp	;io completion	DC.B $00	;our socket (listener socket)	DC.B $00,$00	;their network	DC.B $00	;their node	DC.B $06	;their skt	DC.B $00,$00	;their tid	DC.W 0	;buffer to send size	DC.L 0	;no buffer to send	DC.B $08,$00,$00,$00 ;user bytes	DC.B $01	;need 1 response bds	DC.L gzlrqbds	;bds for input	DC.B 0	;flag	DC.B 0	;user sets this	DC.B 0	;'            '	DC.B $01	;bitmap for request	DC.B $00	DC.B $00,$00,$00,$00,$00,$00 ;reserved fieldsgzlrqbds	DC.W 0	;max buf size	DC.L 0	;start code here   	DC.B $00,$00,$00,$00 ;user bytes returned here	DC.B $00,$00	;and actual length received	entry getinfo,thisnet,abridgegetinfo	DC.B $00,$02,$00,$00 ;command for getinfo	DS.B 4	;comp routinethisnet	DS.B 2	;network numberabridge	DS.B 1	;current bridge number	DS.B 4	;machine id and version and nodegmzrq	DC.B $80,$12,$00,$00 ;cnt, cmd, result	DC.L gmzcomp	;io completion	DC.B $00	;our socket (listener socket)	DC.B $00,$00	;their network	DC.B $00	;their node	DC.B $06	;their skt	DC.B $00,$00	;their tid	DC.W 0	;buffer to send size	DC.L 0	;no buffer to send	DC.B $07,$00,$00,$00 ;user bytes	DC.B $01	;need 1 response bds	DC.L gmzrqbds	;bds for input	DC.B 0	;flag	DC.B 0	;user sets this	DC.B 0	;'            '	DC.B $01	;bitmap for request	DC.B $00	DC.B $00,$00,$00,$00,$00,$00 ;reserved fieldsgmzrqbds	DC.W 33	;max buf size	DC.L 0	;start code here   	DC.B $00,$00,$00,$00 ;user bytes returned here	DC.B $00,$00	;and actual length received	ENDP;----------------------------------------------------------------------; GetZoneList2;; Returns a list of zones on the network.  This	call differs from; GetZoneList in that the user supplies	a zero-filled field (zipWork); instead of a bridge node number so that it can send to a router on; a different network.;----------------------------------------------------------------------GetZoneList2	proc	export		import	gzl2cmdlist,setup,accumexit		import	GetZonesCommon,CommonComppb		record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1bufLength	ds.w	1bufPointer	ds.l	1startIndex	ds.w	1retryInterval	ds.b	1retryCount	ds.b	1zonesReturned	ds.w	1zipWork		ds.l	1		; holds	address	of aRouterreserved	ds.l	1		; ???		endr		jsr	setup		lda	gzl2cmdlist		ora	gzl2cmdlist+2	; a call already in progress?		beq	callok		; no, so handle	the call		lda	#zipinuse	; only one of these calls at a time		jmp	accumexit	; complete immediatelycallok		lda	cmdlist		; copy pointer to parameter block		sta	gzl2cmdlist	; to indicate call in progress		lda	cmdlist+2		sta	gzl2cmdlist+2		ldx	#<sendRequest	; set up pointer to ATP	SendRequest PB		jmp	GetZonesCommon	; jump into common processingsendRequest				; ATP send request for GetZoneList		DC.B	$80,$12		; async	ATPSendRequestreqResult	dc.w	0		; result		DC.L	CommonComp	;io completion		DC.B	$00		;our socket (listener socket)reqDestNet	DC.B	$00,$00		;their networkreqDestNode	DC.B	$00		;their node		DC.B	$06		;their skt		DC.B	$00,$00		;their tid		DC.W	0		;buffer	to send	size		DC.L	0		;no buffer to sendreqUser		DC.B	$08,$00,$00,$00	;user bytes		DC.B	$01		;need 1	response buffer		DC.L	reqBDS		;bds for input		DC.B	0		;flagreqInterval	DC.B	0		;retry interval		DC.B	0		;retry countreqBitmap	DC.B	$01		;bitmap	for request		DC.B	$00		; number of responses received		DC.B	$00,$00,$00,$00,$00,$00	;reserved fieldsreqBDSreqBDSLength	DC.W	0		;max buf sizereqBDSBuf	DC.L	0		;start code here   reqBDSUser	DC.B	$00,$00,$00,$00	;user bytes returned herereqBDSActLen	DC.B	$00,$00		;and actual length receivedcount		ds.w	1		; running count	of zones returned		entry	gzl2cmdlistgzl2cmdlist	ds.l	1		; pointer to active command		endp;----------------------------------------------------------------------; GetLocalZones;; Returns a list of zones on the node's own network.  Since LocalTalk; is a non-extended network, this call degenerates to GetMyZone.;----------------------------------------------------------------------GetLocalZones	proc	export		import	setup,accumexit		import	GetZonesCommon,CommonComppb		record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1bufferLen	ds.w	1bufferPointer	ds.l	1startIndex	ds.w	1retryInterval	ds.b	1retryCount	ds.b	1zonesReturned	ds.w	1zipWork		ds.l	1		; holds	address	of aRouterreserved	ds.l	1		; ???		endr		jsr	setup		lda	glzcmdlist		ora	glzcmdlist+2	; a call already in progress?		beq	callok		; no, so handle	the call		lda	#zipinuse	; only one of these calls at a time		jmp	accumexit	; complete immediatelycallok		lda	cmdlist		; copy pointer to parameter block		sta	glzcmdlist	; to indicate call in progress		lda	cmdlist+2		sta	glzcmdlist+2		ldx	#<sendRequest	; set up pointer to ATP	SendRequest PB		jmp	GetZonesCommon	; jump into common processing;; Data used by this call;sendRequest				; ATP send request for GetZoneList		DC.B	$80,$12		; async	ATPSendRequestreqResult	dc.w	0		; result		DC.L	CommonComp	;io completion		DC.B	$00		;our socket (listener socket)reqDestNet	DC.B	$00,$00		;their networkreqDestNode	DC.B	$00		;their node		DC.B	$06		;their skt		DC.B	$00,$00		;their tid		DC.W	0		;buffer	to send	size		DC.L	0		;no buffer to sendreqUser		DC.B	$09,$00,$00,$00	;user bytes (get local zones call)		DC.B	$01		;need 1	response buffer		DC.L	reqBDS		;bds for input		DC.B	0		;flagreqInterval	DC.B	0		;retry interval		DC.B	0		;retry countreqBitmap	DC.B	$01		;bitmap	for request		DC.B	$00		; number of responses received		DC.B	$00,$00,$00,$00,$00,$00	;reserved fieldsreqBDSreqBDSLength	DC.W	0		;max buf sizereqBDSBuf	DC.L	0		;start code here   reqBDSUser	DC.B	$00,$00,$00,$00	;user bytes returned herereqBDSActLen	DC.B	$00,$00		;and actual length receivedcount		ds.w	1		; running count	of zones returned		entry	glzcmdlistglzcmdlist	ds.l	1		; pointer to active command		endp;----------------------------------------------------------------------; GetZonesCommon;; This is the common code to handle both GetZoneList2 and GetLocalZones; since	the parameter blocks and the packet structure are the same.;; On entry to GetZonesCommon and gzcomplete:; cmdlist points to the	parameter block	being handled; X = low byte of address of ATPSendRequest block;; Caution: I use absolute,X addressing mode to access the ATPSendRequest; pb and the BDS.  It requires them to be in the same bank as the code.; The absolute base address becomes an offset from the address in X; (which points	the this call's ATPSendRequest).  Be sure to force; absolute addressing by using the vertical bar	(|) character.;----------------------------------------------------------------------GetZonesCommon	proc	export;; Define the common parameter block structure;pb		record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1bufferLen	ds.w	1bufferPointer	ds.l	1startIndex	ds.w	1retryInterval	ds.b	1retryCount	ds.b	1zonesReturned	ds.w	1zipWork		ds.l	1		; holds	address	of aRouterreserved	ds.l	1		; ???		endr;; Define the common structure of the ATPSendRequest and	BDS;req		record	0		ds.b	2		; async	and commandresult		ds.w	1		; result		ds.l	1		;io completion		ds.b	1		;our socket (listener socket)dNet		ds.b	2		;their networkdNode		ds.b	1		;their node		ds.b	1		;their skt		ds.b	2		;their tid		ds.w	1		;buffer	to send	size		ds.l	1		;address of send bufferuser		ds.b	4		;user bytes		ds.b	1		;# of response buffers		ds.l	1		;pointer to bds	for response		ds.b	1		;flagsretry		ds.b	1		;retry interval		ds.b	1		;retry countbitmap		ds.b	1		;bitmap	for request		ds.b	1		; number of responses received		ds.b	6		;reserved fieldsbdsbdsLen		ds.w	1		;max buf sizebdsBuf		ds.l	1		;start code here   bdsUser		ds.b	4		;user bytes returned herebdsActLen	ds.w	1		;and actual length receivedcount		ds.w	1		; number of zones returned so farcmdList		ds.l	1		; pointer to active command		endr;; Define the locations on zero page that I use;dp		record	0zones					; temporarily points into returned zone	listpbPtr		ds.l	1		; points to PB that completedbdsLen					; word:	temporarily holds bdsLencompAddr	ds.l	1		; points to completion routine		endr		ldy	#pb.bufferLen		lda	[cmdlist],y	; buffer length	into BDS		sta	|req.bdsLen,x	; put into this	BDS		iny		iny			; Y = pb.bufPointer		lda	[cmdlist],y	; put buffer pointer into BDS		sta	|req.bdsBuf,x		iny		iny		lda	[cmdlist],y		sta	|req.bdsBuf+2,x		iny		iny			; Y = pb.startIndex		lda	[cmdlist],y	; start	index into request packet		xba			; change to 68000 order		sta	|req.user+2,x	; startIndex in	ATP user bytes		iny		iny			; Y = pb.retryInterval		lda	[cmdlist],y	; get retry interval and count		sta	|req.retry,x	; put them in ATP pb		iny		iny			; Y = pb.zonesReturned		lda	#0		sta	[cmdlist],y	; no zones returned yet		sta	|req.count,x	; save in easier spot to use;; If zipWork is	non-zero, copy it to destination address in ATP	pb.; We'll actually copy it, then test for zero (and fill in aRouter; if it	was zero).;		ldy	#pb.zipWork		lda	[cmdlist],y	; get previous router address		sta	|req.dNet,x		iny		iny		lda	[cmdlist],y	; get node and socket		sta	|req.dNode,x	; set node and socket		ora	|req.dNet,x	; was whole thing zero?		bne	nonzero		; no, so use it	as-is		phx			; save pointer to SendRequest		ldx	#getinfo	;make getinfo call		ldy	#^getinfo		jsl	RamDispatch		plx			; restore pointer to SendRequest		lda	aBridge		; node = aBride		and	#$00FF		; get byte only		bne	bridgeOK	; do we	have a bridge?		lda	#zipnotfound	; no router!		jmp	accumexitbridgeOK		ora	#$0600		; socket = 6 (ZIP socket)		ldy	#pb.zipWork+2		sta	[cmdlist],y	; put it back in caller	pb		sta	|req.dNode,x	; and in ATP pb		dey		dey			; Y = pb.zipWork (network field)		lda	thisNet		sta	[cmdlist],y	; update caller	pb		sta	|req.dNet,x	; and ATP pbnonzero		lda	#1		; reset	bitmap		sta	|req.bitmap,x		lda	#zipbusy	; call in progress result code		ldy	#pb.result		sta	[cmdlist],y	; show call in progress					; X already points to SendRequest PB		ldy	#^GetZonesCommon ; get our bank	in Y		jsl	RamDispatch	; start	the send request call		jml	RamPermit	; re-enable interrupts and exit		entry	commonCompCommonComp				; common completion for	GetZone	calls		clc		xce			; force	native mode, just in case		rep	#$30		; force	full 16-bit mode		ldx	cmdlist		; pick up pointer to ATPSendRequest PB		lda	|req.result,x	; get result of	send request		beq	compOK		; no error, do some work		lda	#zipnotfound	; error, assume	no router		sta	status		; save result code temporarily		lda	|req.count,x	; get number of	returned zones		bra	errorexit	; return an errorcompOK		lda	|req.bdsActLen,x ; was there an	overflow?		bpl	checkend	; no, see if we	completed normally		lda	|req.bdsLen,x	; we'll need this in the loop below		sta	dp.bdsLen	; put it on zero page for loop		lda	|req.bdsBuf,x	; put request BDS buffer pointer on		sta	dp.zones	; direct page as pointer		lda	|req.bdsBuf+2,x		sta	dp.zones+2		phx			; save base address		ldy	#0		; index	into response buffer		tyx			; number of zones that fitoverflowlp		lda	[dp.zones],y	; get length of	this zone name		and	#$00FF		; only a byte		pha			; save on stack	for add		clc			; add 1	for length byte		tya			; get current index in A		adc	1,s		; add to length	of this	name					; Note:	A holds	index of last byte of name		ply			; clean	length from stack		tay			; move new index into Y		cmp	dp.bdsLen	; will it fit in buffer		bge	overflow	; no, so we're done		inx			; one more zone	fit		iny			; point	to length byte of next name		bra	overflowlp	; try again with this zoneoverflow		txa			; get number of	zones that actually fit		xba			; put it in 68000 order		plx			; recover pointer to ATPSendRequest		sta	|req.bdsUser+2,x ; pretend that's all router returned		lda	#zipoverflow	; more returned	than could fit		sta	status		; remember the error		bra	yesend		; and complete the callcheckend		lda	|req.bdsUser,x	; was the LastFlag set (no more	zones)?		beq	morenames	; no, go get some more		stz	status		; that was it, done with no erroryesend		clc		lda	|req.bdsUser+2,x ; get number of zones this packet		xba			; put in 65xxx order		adc	|req.count,x	; plus number of previous zoneserrorexit		ldy	|req.cmdList,x	; set up pointer to our	parameter block		sty	cmdlist		ldy	|req.cmdList+2,x		sty	cmdlist+2		ldy	#pb.zonesReturned		sta	[cmdlist],y	; update number	of zones returned		stz	|req.cmdList,x	; no more call in progress		stz	|req.cmdList+2,x		jsl	RamForbid	; balance the RamPermit	in accumexit		lda	status		jmp	accumexit	; return the saved error and completemorenames		clc		lda	|req.bdsUser+2,x ;add count from this call		xba			; in 65xxx order		pha			;save a	copy of	it in our format		adc	|req.count,x	;add to	total returned		sta	|req.count,x	;and save new total		clc		lda	|req.user+2,x	;get running position of zones		xba			;put in	our format		adc	$1,s		;add to	count from this	call		xba			;put result in mac format		sta	|req.user+2,x	;store new position to scan from		ply			;discard junk		lda	|req.bdsActLen,x ;get actual amount of buffer used		pha			;save temporarily		clc		adc	|req.bdsBuf,x		sta	|req.bdsBuf,x		lda	#0000		;add in	carry if any		adc	|req.bdsBuf+2,x		sta	|req.bdsBuf+2,x		sec			;set up	for subtract		lda	|req.bdsLen,x	;get current buffer remaining		sbc	$1,s		;and subtract amount just used		ply			;discard junk		sta	|req.bdsLen,x	;save new amount remaining		lda	#1		; reset	bitmap		sta	|req.bitmap,x					; X already points to SendRequest PB		ldy	#^GetZonesCommon ; get our bank	in Y		jml	RamDispatch	;make a	call for more data		endp;----------------------------------------------------------------------; SetMyZone;; Allows a node	on an extended network to specify which	of its local; zones	it wishes to belong to.	 Since LocalTalk is non-extended, this; call returns an error, zipNotExtended	($0604).;----------------------------------------------------------------------SetMyZone	proc	exportpb		record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1bufferPointer	ds.l	1		; points to P-String		endr;; Fall into GetNetInfo to return a zipNotExtended error;		endp;----------------------------------------------------------------------; GetNetInfo;; ; Returns network information about an extended	network.  Since]; LocalTalk is non-extended, this call returns an error, zipNotExtended; ($0604).;----------------------------------------------------------------------GetNetInfo	proc	export		import	setup,accumexitpb		record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1requestZone	ds.l	1zipFlags	ds.w	1netLow		ds.w	1netHigh		ds.w	1multiLength	ds.w	1		; length of multicast address buffermultiBuffer	ds.l	1		; points to multicast address bufferretryInterval	ds.b	1retryCount	ds.b	1multiActLen	ds.w	1		; returns actual length	of multicast addressdefaultZone	ds.l	1		; points to buffer for default zone name;reserved   ds.l 1  ; ??? Do we	need this ???		endr		jsr	setup		lda	#zipNotExtended	; this call valid only for extended networks		jmp	accumexit	; return the error, call completion		endp	END	