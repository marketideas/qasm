********************************************************************************* File: ATPATCH** This file contains the 65816 implementation of PAP for the Apple IIGS.** ATPATCH was originally responsible for loading ATINIT under prodos 16.* It also contained all the patches for the ROM code.** Copyright Apple Computer, 1986* Original Author: Greg Seitz*                  6-May-86*                  ver 1.1*                  ver 1.2********************************************************************************** Modification History*** v1.2** 4/15/87    gws	- changed papinuse error code from $0801 to $080b had*	  read and write return papinuse instead of busy when*	  they had calls in progress.*	- changed open to return paptoomany error instead of*	  papinuse when another open was attempted beyond the*	  first one.** v1.3** 8/18/88    TGH	- Started working on changes for the RevD ROM** 5/25/89    TGH	- Took statcmdlist out of zerodata because anything that*	  called papinit would wipe out any pending PAPStatus.*	  I now init statcmdlist by hand in the INIT and RESET*	  routines** 27-Sep-91 MSD	PAPOpen now checks the incoming flow quantum.  If it is*	not 1, you get a quantum error.**  7-Oct-91 MSD	PAPOpen now returns error $0808 (printer not responding)*	if there is no response to the open connection request.*	If the printer responds, but says it is busy, it will continue*	to retry and increment WaitTime as before.**  8-Oct-91 MSD	The 7-Oct-91 fix didn't work because it was storing the result*	in the ATP send request parameter block, not the open pb because*	the pointer at cmdlist wasn't set up properly.** 14-Nov-91 MSD	If the object, type, or zone is 33 characters or longer*	for PAPOpen and PAPStatus, return error $0807 (network error)*	instead of doing the lookup and returning $0805 (name not*	found).********************************************************************************	MACHINE M65816	PRINT GEN	ENTRY canrd	ENTRY closebds	ENTRY closecmdlist	ENTRY closereq	ENTRY closersp	ENTRY closeskt	ENTRY clsbds	ENTRY clsreq	ENTRY connid	ENTRY conntimer	ENTRY cpapclose	ENTRY cpapopen	ENTRY cpapread	ENTRY cpapstatus	ENTRY cpapunload	ENTRY cpapwrite	ENTRY dowrite	ENTRY inseq	ENTRY lkcomp	ENTRY lkcurr	ENTRY lknext	ENTRY lookbuf	ENTRY nextseq	ENTRY odata	ENTRY opencmdlist	ENTRY openflag	ENTRY opentimer	ENTRY oplkparms	ENTRY opsktparms	ENTRY orqbds	ENTRY orqparms	ENTRY pgrq	ENTRY rdbds	ENTRY rdrq	ENTRY readcmdlist	ENTRY rspskt	ENTRY srqbds	ENTRY srqparms	ENTRY startticks	ENTRY statcmdlist	ENTRY statcomp	ENTRY stlkcomp	ENTRY stlkparms	ENTRY tkbds	ENTRY tkrq	ENTRY unloadcmd	ENTRY upapclose	ENTRY wdata	ENTRY writecmdlist	ENTRY wtbds	ENTRY wtpkt	ENTRY wtrel	ENTRY wtrsp	ENTRY zerodata	ENTRY zeroend	entry converterrtopap,closing	entry ValidateName	INCLUDE '::ASP:atp.equates.inc'	INCLUDE '::ASP:global.equates.inc'papzplen	equ $08	;save this much zero pagepapnoerr	equ $0000paptoomany	equ $0801papnotopen	equ $0802papsessinvalid	equ $0802papquantumerr	equ $0803papnoprinter	equ $0805papconnclosed	equ $0806papneterr	equ $0807papnoserver	equ $0808papsizeerr	equ $080apapinuse	equ $080bpapbusy	equ $08ffqtrinstall	equ $480qtrremove	equ $500senddata	equ 03closeconn	equ 06openwait	equ 08maxconn	equ 120*4	;two minutespstat_async	equ $00pstat_command	equ $01pstat_result	equ $02pstat_iocomp	equ $04pstat_prname	equ $08pstat_statbuf	equ $0cpopen_async	equ $00popen_command	equ $01popen_result	equ $02popen_iocomp	equ $04popen_refnum	equ $08popen_prname	equ $09popen_flowq	equ $0dpopen_statbuf	equ $0epclose_async	equ $00pclose_command	equ $01pclose_result	equ $02pclose_iocomp	equ $04pclose_refnum	equ $08pread_async	equ $00pread_command	equ $01pread_result	equ $02pread_iocomp	equ $04pread_refnum	equ $08pread_buflen	equ $09pread_bufptr	equ $0bpread_eofflag	equ $0fpwrite_async	equ $00pwrite_command	equ $01pwrite_result	equ $02pwrite_iocomp	equ $04pwrite_refnum	equ $08pwrite_blen	equ $09pwrite_bptr	equ $0bpwrite_eofflag	equ $0f** pap.core** these are the routines that get things going.* they install pap into the command lists and* do any initialization neccesarry*papinstall	PROC EXPORT	clc	;force native	xce	rep #mbit+xbit	longa on	longi on	phb	phk	;data is in same bank as code	plb	lda softreset	;get the current reset vector	sta oldreset	;and store internally	lda softreset+2	sta oldreset+2	;now we have the old vector	lda callreset	;store a jml ourreset	sta softreset	;into vector	lda callreset+2	sta softreset+2	stz lkcurr	stz lknext	stz lkcomp	;these only need to	be cleared at init	stz statcmdlist	;We now have to manually zero this out	stz statcmdlist+2	;because we took it out of papinit **TGH	jsr papinit	;zero out stuff	ldx #ourcmds	;get our command table	ldy #$d600+($22*4)	;table starts at $d600	lda #endcmds-ourcmds-1 ;move this many bytes	mvn ourcmds,$e10000	;to bank $e1	plb	;restore data bank register	rtl	;and exit.callreset	jml ourreset	;this code is moved	to vector	ENTRY papinit	; EXPORT -> ENTRY  **TGHpapinit		;       	lda #ourreset	;so we can install our own	stz zerodata	;start with a zero	ldx #zerodata	;move from here	ldy #zerodata+1	;move to here (carrys zeros forward)	lda #zeroend-zerodata-2 ;number of bytes to clear out	mvn zerodata,zerodata	rtsourcmds	DC.A cpapstatus	;$22	DC.B papzplen	DC.A cpapopen	;$23	DC.B papzplen	DC.A cpapclose	;$24	DC.B papzplen	DC.A cpapread	;$25	DC.B papzplen	DC.A cpapwrite	;$26	DC.B papzplen	DC.A cpapunload	;$27	DC.B papzplenendcmds		; ourreset		;should come here during reset	php	;save mode bits	phb	;and databank	jsl oldreset	;let lower protocol	get called first	phk	;set up data bank	plb	stz lkcurr	stz lknext	stz lkcomp	;these only need to	be cleared at init	stz statcmdlist	;We now have to manually zero this out	stz statcmdlist+2	;because we took it out of papinit **TGH	jsr papinit	;and re-init pap	plb	;restore bank	plp	;and mode bits	rtl	;and return to our calleroldreset	jml $000000	;stick old reset vector here	ENDP;-------------------------------------------------------------------------------;;	pap.status;;	Greg Seitz;	6-May-86;cpapstatus	PROC	jsr setup	;sets up stuff for entry (data bank)	longa on	longi on	lda statcmdlist	;see if call already in progress	ora statcmdlist+2	beq callok	;call is valid	lda #papinuse	;return a pap in use errortoaccumexit	jmp accumexitcallok; BEGIN 14-Nov-91 MSD	ldy #pstat_prname	jsr ValidateName	; make sure name length is OK	bcs toaccumexit	; not OK, so return error; END 14-Nov-91 MSD	lda cmdlist	;save command list locally	sta statcmdlist	lda cmdlist+2	sta statcmdlist+2	ldy #pstat_result	lda #papbusy	;set result to busy	sta [cmdlist],y	;before doing anything	ldy #pstat_prname	;get offset to printer name pointer	lda [cmdlist],y	;get low word	tax	;and pass in x	iny	iny	;move to high word	lda [cmdlist],y	;and get it	stx stlkparms+8	;low word of name to find	sta stlkparms+10	;and high word	ldx #stlkparms	ldy #^stlkparms	jsr lookname	;look for this name* after the call to	lookname, it is actually possible that the call* has completed with an error, in which	case the completion	routine* should have already been called.  So all we need to do is	to simply* re allow interrupts and return to the	dispatcher	jsl RamPermit	;allow ints to happen again	rtl	;and return to dispatcher	ENTRY stlkcomp	; EXPORT -> ENTRY  **TGHstlkcomp		;       	clc	xce	;force native mode	rep #mbit+xbit	longa on	longi on	lda statcmdlist	;get status command	list	sta cmdlist	lda statcmdlist+2	sta cmdlist+2	lda stlkparms+23	and #$00ff	;just check low byte	bne nbpok	;the lookup worked	lda #papnoprinter	;no printer found error	brl clearstat	;exit with errornbpok		; 	ldy #pstat_statbuf	;get offset to status buffer	lda [cmdlist],y	;get low word	sta srqbds+bds_bufptr ;save it	iny	iny	lda [cmdlist],y	;get high word	sta srqbds+bds_bufptr+2 ;and save it	sep #mbit	;make sure 8 bit a	longa off	lda #01	;set bitmap for request	sta srqparms+atprq_bitmap	ldy #0004	;move address from lookupmvlp		; 	lda lookbuf,y	;get from lookup list	sta srqparms+atprq_dnet,y ;and put in send request	dey	bpl mvlp	;keep moving	rep #mbit+xbit	;back to full native	longa on	longi on	ldx #srqparms	;get low word of parm list	ldy #^srqparms	;and high word	jsl RamDispatch	;and call dispatcher	rtl	;and exit lookup completion	ENTRY statcomp	; EXPORT -> ENTRY  **TGHstatcomp		;       ;completion	for status request	clc	;go to native mode	xce	rep #mbit+xbit	longa on	longi on	lda statcmdlist	;get status command	list	sta cmdlist	lda statcmdlist+2	sta cmdlist+2	lda srqparms+atprq_result ;get result from call	jsr converterrtopap	; convert the error codeclearstat		;       ;clean up and leave	jsl RamForbid	;balance permit in accumexit	stz statcmdlist	stz statcmdlist+2	;indicate call is free again	jsl accumexit	;call completion routine if any	rtl	;and return	ENTRY converterrtopap ; EXPORT -> ENTRY  **TGHconverterrtopap	cmp #0000	;see if no error	beq ceexit	;and return with the zero	cmp #requestfail	bne @ce1	;nope	lda #papnoserver	bra ceexit	;and exit@ce1		lda #papneterr	;default is to return network errorceexit	rts	;and return with converted error in a	ENTRY setup	; EXPORT -> ENTRY  **TGHsetup		;       ;sets things up for a call	jsl RamForbid	;don't bother routines that call this	rep #mbit+xbit	longa on	longi on	phk	;push program bank	plb	;and make it the data bank	rts	;and return	ENTRY asyncexit	; EXPORT -> ENTRY  **TGHasyncexit		;       	rep #mbit+xbit	longa on	longi on	lda #papbusy	;get pap busy flag	ENTRY accumexit	; EXPORT -> ENTRY  **TGHaccumexit		;       ;exit with what's in accum	rep #mbit+xbit	longa on	longi on	ldy #pstat_result	;get offset to result	sta [cmdlist],y	;and save it	jsl RamPermit	;back down ints	sep #mbit+xbit	longa off	longi off	ora #00	;see if done	bpl chkiocmp	;yepgoback		; 	rep #mbit+xbit	rtl	;otherwise just exitchkiocmp	sep #mbit+xbit	longa off	longi off	lda [cmdlist]	;see what type of command	bpl goback	;sync so exit	ldy #pstat_result	lda [cmdlist],y	;get result	bmi goback	;still busy	ldy #pstat_iocomp	;offset to completioncallcomp	rep #mbit+xbit	longa on	longi on	lda [cmdlist],y	;get low word completion	sta execaddr	iny	iny	lda [cmdlist],y	;get high word completio`	sta execaddr+2	ora execaddr	;see if zero	beq goback	;yep, so nothing to	call	jmp RamGoComp	;call completion routine** lookname** this routine allows async lookups for	the very special* case of papstatus	and papopen* x contains address of lookup list (parm list must be in current data bank)*	ENTRY lookname	; EXPORT -> ENTRY  **TGHlookname	lda lkcurr	;see if something in progress	beq allclear	;nope so we can go	stx lknext	;set up to wait till other done	rts	;and returnallclear		; ;we have the go ahead	stx lkcurr	;we are the current	process	stz lknext	;make sure next is clear since no nextmakelook		; 	stx execaddr	;and set up zero page	ldy #4	;get iocomp for this list	lda (execaddr),y	;get low word of their address	sta lkcomp	;save comp address for curr	lda #lookcomp	;and put ours in its place	sta (execaddr),y	ldy #^stlkparms	;get high word of our bank (low in x)	jsl RamDispatch	;and make the call	rts	;and returnlookcomp		;comes here when above completes	clc	xce	rep #mbit+xbit	lda lknext	;move next into curr	sta lkcurr	stz lknext	;make sure no next	lda lkcomp	;get back their comp pointer	ldy #4	sta [cmdlist],y	;and plug it back in	ldx lkcurr	;save flag for next lookup on stack	phx	;since can get changed by above	jsl chkiocmp	;call completion routine	plx	;recover lkcurr flag state before giving user control	beq lkrtn	;no call was pending, so leave	jsr makelook	;do the next lookuplkrtn		; 	rtl	;and return	ENDP;-------------------------------------------------------------------------------;;	pap.open;;	opens a connection with a printer;cpapopen	PROC	jsr setup	;sets proper bank and does forbid	longa on	longi on	lda openflag	;see if currently open	beq callok	;nope, so it's valid to open	lda #paptoomany	;can't have more than 1 sessiontoaccumexit	jmp accumexitcallok; BEGIN 14-Nov-91 MSD	ldy #popen_prname	jsr ValidateName	; make sure name length is OK	bcs toaccumexit	; not OK, so return error; END 14-Nov-91 MSD; BEGIN 27-Sep-91 MSD	ldy #popen_flowq	lda [cmdlist],y	and #$00FF	; get one byte only	cmp #1	; only deal with a quantum of 1	beq @okflow	lda #papquantumerr	jmp accumexit@okflow; END 27-Sep-91 MSD	jsr papinit	;zero everything out	lda cmdlist	;save their command	list	sta opencmdlist	lda cmdlist+2	sta opencmdlist+2	ldy #popen_result	;indicate call busy	lda #papbusy	;before doing anything	sta [cmdlist],y	stz closing	;we are obviously not closing now	inc openflag	;set to 1 for first	stage open	ldy #popen_refnum	;get offset to refnum field	lda #1	sep #mbit	sta [cmdlist],y	;store it	rep #mbit	;back to 16 bit a	ldy #popen_prname	;get offset to printer name	lda [cmdlist],y	;get low word	tax	;and pass in x	iny	iny	;move to high word	lda [cmdlist],y	;and get it	stx oplkparms+8	;save name	sta oplkparms+10	;and high word	ldx #oplkparms	jsr lookname	;do async lookup	jsl RamPermit	;allow ints againanrtl		; 	rtl	;and return	ENTRY oplkcomp	; EXPORT -> ENTRY  **TGHoplkcomp		;comes here	when lookup done	clc	xce	;force native mode	rep #mbit+xbit	longa on	longi on	lda openflag	;see if open	beq anrtl	;nope so leave	lda opencmdlist	;get their command list	sta cmdlist	lda opencmdlist+2	sta cmdlist+2	lda oplkparms+23	;get number of responses	and #$00ff	;check only low byte	bne lookok	;lookup found something	lda #papnoprinter	;otherwise return not found erropenerrexit		; 	pha	;save error	jsr papinit	;abort this open	pla	ENTRY exitcomp	; EXPORT -> ENTRY  **TGHexitcomp		;       	jsl RamForbid	;balance permit in accumexit	jmp accumexit	;and return error codelookok		; 	stz opsktparms+opskt_result+1 ;clear socket field	ldx #opsktparms	;open atp responding socket	ldy #^opsktparms	jsl RamDispatch	;make call	lda opsktparms+2	;get result	beq gotskt	;we got a socket	jsr converterrtopap	brl openerrexit	;return converted errorgotskt		; 	ldy #popen_statbuf	;get their status buffer	lda [cmdlist],y	sta orqbds+bds_bufptr	iny	iny	lda [cmdlist],y	;get high word	sta orqbds+bds_bufptr+2	sep #mbit+xbit	;8 bit a,x	longa off	longi off	lda #01	sta inseq	;next expected read	sequence num	sta orqparms+atprq_bitmap ;set bitmap	sta clsreq+atprq_bitmap	sta odata+1	;save flow quantum (always 1 for us)	lda opsktparms+opskt_skt ;get responding socket number	sta rspskt	;save for internal use	sta odata	;and put into packet	sta pgrq+getrq_ourskt ;set up get request for future use	sta closeskt+clsskt_skt ;set up for close later	inc connid	;bump connection id	lda connid	;and get it	sta orqparms+atprq_user ;store in first	user byte	sta rdrq+atprq_user	;set up for reads in future	sta tkrq+atprq_user	;and tickles	sta clsreq+atprq_user ;and closes	sta wtbds+bds_user	;set up for writes	ldy #04mvlp		; 	lda lookbuf,y	sta orqparms+atprq_dnet,y ;put address info into send request	sta rdrq+atprq_dnet,y ;set up for future read	sta tkrq+atprq_dnet,y ;and tickles	sta clsreq+atprq_dnet,y ;init for later	close	dey	bpl mvlp	rep #mbit+xbit	;back to full native mode	longa on	longi on	lda $e1da00	;get tick count from rom stuff	sta startticks	;and save current value	stz odata+2	;and clear wait field	ldx #orqparms	ldy #^orqparms	;make the call	jsl RamDispatchanrtl1		; 	rtl	;and return from completion routine	ENTRY opencomp	; EXPORT -> ENTRY  **TGHopencomp		;comes here	when above call completes	clc	xce	;native mode	rep #mbit+xbit	longa on	longi on; BEGIN 8-Oct-91 MSD	lda opencmdlist	;get their command list	sta cmdlist	lda opencmdlist+2	sta cmdlist+2; END 8-Oct-91 MSD	lda orqparms+2	;get result from call	beq @opencomp1	;no error so continue	cmp #reqabort	;was request aborted	beq anrtl1	;yes so must be closing; BEGIN 7-Oct-91 MSD: No response, so return error	lda #papnoserver	brl openerrexit	; return the error; END 7-Oct-91 MSD@opencomp1		;comes here on no error	lda orqbds+bds_bufptr	sta execaddr	;use for zp	lda orqbds+bds_bufptr+2	sta execaddr+2	ldy #2	;offset to result field	lda [execaddr],y	;get result	bne doqtrstuff	;not ready to open with us	brl gotconn	;got a connectiondoqtrstuff		; * check here for close, and abort if close happened	lda #qtrinstall	;install timer command	sta opentimer	;make sure we do install	lda #openwait	;wait time before next try	sta opentimer+insqtr_count	ldx #opentimer	;and install it, it	will complete	ldy #^opentimer	;by going to 'trynextopen'	jsl RamDispatch	;make the install call	rtl	;and return to caller	ENTRY trynextopen	; EXPORT -> ENTRY  **TGHtrynextopen		;1/4 second timer expired	clc	xce	rep #mbit+xbit	longa on	longi on	lda opentimer+insqtr_ticks ;get current	tick count	sec	sbc startticks	;get difference	lsr a	;divide by 2	lsr a	;and 2 more makes for to give secs	xba	;put in mac format	sta odata+2	;update wait field	sep #mbit	longa off	lda #01	;reset bitmap	sta orqparms+atprq_bitmap	rep #mbit+xbit	longa on	longi on	ldx #orqparms	;and re-issue call	ldy #^orqparms	jsl RamDispatch	rtl	;and returnGotConn		;we have been accepted by the device	lda opencmdlist	sta cmdlist	lda opencmdlist+2	;get users parm list	sta cmdlist+2	lda orqbds+bds_bufptr ;get result buffer pointer	sta execaddr	lda orqbds+bds_bufptr+2	sta execaddr+2	lda [execaddr]	;get their listener	socket	sep #mbit+xbit	;use 8 bit a	longa off	longi off	sta rdrq+atprq_dskt	;store their socket	for read	sta tkrq+atprq_dskt	;and tickle requests	sta clsreq+atprq_dskt ;and close* our implementation has a max quantum of 1 in both directions	lda #01	;get max flow quantum	ldy #popen_flowq	sta [cmdlist],y	sta tkrq+atprq_bitmap ;and set up tickle bitmap	rep #mbit+xbit	;back to full native	longa on	longi on	inc openflag	;open should be 2 for full open	ldx #pgrq	;set up get request	mechanism	ldy #^pgrq	jsl RamDispatch	ldx #tkrq	;now start tickle packets	ldy #^tkrq	jsl RamDispatch	lda #qtrinstall	;install a connection timer	sta conntimer	lda #maxconn	;get maximum connection time	sta conntimer+insqtr_count	ldx #conntimer	ldy #^conntimer	jsl RamDispatch	stz opencmdlist	stz opencmdlist+2	;close is done	lda #0000	;indicate no error for open	jmp exitcomp	ENTRY pgrqcomp	; EXPORT -> ENTRY  **TGHpgrqcomp		;comes here when requests come in	clc	xce	;go to native mode	sep #mbit+xbit	longa off	longi off	lda pgrq+2	;get result	bne exitgrq	;only error should be close	ldy #getrq_user	;go to connid field	lda [cmdlist],y	;and get it	cmp connid	;see if matches	bne nextgrq	;issue next get request	rep #mbit+xbit	;they are talking to us	longa on	longi on	lda #maxconn	;reset connection time out	sta conntimer+insqtr_count	sep #mbit+xbit	longa off	longi off	ldy #getrq_user+1	;move to pap type field	lda [cmdlist],y	cmp #closeconn	;see if close	beq closereq	;yes so close up	cmp #senddata	;see if this is a request for data	bne nextgrq	;issue next request	rep #mbit+xbit	longa on	longi on	ldy #getrq_user+2	;move to sequence number field	lda [cmdlist],y	;it's in mac format	beq goodseqnum	;it's the old format	xba	;put in 6502 format	cmp inseq	;check against expected seq num	bne nextgrq	;not what we expectedgoodseqnum		; 	lda wtrsp+1	;get low byte of result in high a	bpl normal	;no write pending	sep #mbit+xbit	longa off	longi off	ldy #06	;move address infomvlprel		; 	lda wtrsp+sdrsp_sskt,y	sta wtrel+relcb_ourskt,y ;set up to release this response	dey	bpl mvlprel	rep #mbit+xbit	longa on	longi on	ldx #wtrel	;release the old write	ldy #^wtrel	;since it must be done if we	jsl RamDispatch	;got a new read requestnormal		; 	sep #mbit+xbit	longa off	longi off	ldy #06	;move address infomvlp1		; 	lda pgrq+getrq_ourskt,y	sta wtrsp+sdrsp_sskt,y	dey	bpl mvlp1	rep #mbit+xbit	longa on	longi on	lda wdata	;see if any data to	send	beq nosend	;nope	jsr dowrite	bra nextgrq	;issue next get requestnosend		; 	lda #1	;set flag for packet ready	sta wtpktnextgrq		; 	rep #mbit+xbit	longa on	longi on	ldx #pgrq	ldy #^pgrq	jsl RamDispatchexitgrq		; 	rtl	;and return	ENDP;-------------------------------------------------------------------------------;;	pap.close;closeup	PROC	;close section	ENTRY closereq	; EXPORT -> ENTRY  **TGHclosereq		;other side wants to close	sep #mbit+xbit	longa off	longi off	ldy #06	;move address infocmvlp1		; 	lda pgrq+getrq_ourskt,y	sta closersp+sdrsp_sskt,y ;set up close	response	dey	bpl cmvlp1	rep #mbit+xbit	longa on	longi on	ldx #closersp	;send close up response	ldy #^closersp	jsl RamDispatch	rtl	;and return	ENTRY closecomp	; EXPORT -> ENTRY  **TGHclosecomp		;       ;completion	routine for close rsp	clc	xce	rep #mbit+xbit	longa on	longi on	lda #0001	;set closing to true	sta closing	;since we are closing now	lda rdrq+atprq_tid	;get read tid	sta canrd+creq_tid	;cancel transaction	ldx #canrd	ldy #^canrd	jsl RamDispatch	lda tkrq+atprq_tid	;get tickle tid	sta canrd+creq_tid	;cancel transaction	ldx #canrd	ldy #^canrd	jsl RamDispatch	ldx #closeskt	ldy #^closeskt	;close down reponse	socket	jsl RamDispatch	lda readcmdlist	sta cmdlist	lda readcmdlist+2	sta cmdlist+2	ora cmdlist	beq next99	lda #papconnclosed	;connection closed	jsl exitcomp	;so call completionnext99		; 	lda writecmdlist	sta cmdlist	lda writecmdlist+2	sta cmdlist+2	ora cmdlist	beq next1	lda #papconnclosed	;tell write routine	connection closed	jsl exitcompnext1		; 	lda orqparms+atprq_tid	sta canrd+creq_tid	;use same list for read and open	ldx #canrd	ldy #^canrd	jsl RamDispatch	lda opencmdlist	sta cmdlist	lda opencmdlist+2	sta cmdlist+2	ora cmdlist	beq next2	lda #papconnclosed	jsl exitcompnext2		; 	lda #qtrremove	;remove all timers	sta conntimer	sta opentimer	ldx #conntimer	ldy #^conntimer	jsl RamDispatch	ldx #opentimer	ldy #^opentimer	jsl RamDispatch	lda closecmdlist	sta cmdlist	lda closecmdlist+2	sta cmdlist+2	jsr papinit	;now clear all flags	lda cmdlist+2	ora cmdlist	;see if came from user close	beq next3	;nope	lda #papnoerr	;tell user that we are done	jsl exitcomp	;and call users routinenext3		; 	rtl	;and return to caller	ENTRY cpapclose	; EXPORT -> ENTRY  **TGHcpapclose		;       ;user wants	to close	jsr setup	;set up bank and forbid	longa on	longi on	;comes back full 16	bit	ldx openflag	;see if pap even open	bne closeok	;it is so we can close	lda #papnotopen	jmp accumexit	;exit with errorcloseok		; 	lda closecmdlist	;see if close already in progress	ora closecmdlist+2	beq closeok1	;yes so all is ok	lda #papinuse	jmp accumexit	;and return with errorcloseok1		; 	ldy #popen_refnum	;get reference number	lda [cmdlist],y	and #$00ff	;only want one byte	cmp #0001	;see if valid	beq closeok2	lda #papsessinvalid	jmp accumexitcloseok2		; 	lda cmdlist	sta closecmdlist	lda cmdlist+2	sta closecmdlist+2	;make sure closecomp knows we have a close going on	dex	;see what stage open in	bne fullclose	;it was fully open	jsl closecomp	;just tear everything down & call completion routines	bra leaveclose	;exit, error should	be set alreadyfullclose		; ;we really have a	connection	lda #papbusy	;and return with pap busy	ldy #pstat_result	;get offset to result	sta [cmdlist],y	;and save it	ldx #clsreq	;send close request	ldy #^clsreq	jsl RamDispatch	;do close, and complete to closecompleaveclose		; 	jml RamPermit	;back down ints and	leave	ENTRY cpapunload	; EXPORT -> ENTRY  **TGHcpapunload		;       	jsr setup	;set everything up ok	ldy #pstat_result	;offset to result	lda #papbusy	;show we are currently busy	sta [cmdlist],y	lda cmdlist	sta unloadcmd	lda cmdlist+2	sta unloadcmd+2	ldx #upapclose	;do a close call async	ldy #^upapclose	jsl RamDispatch	;make the call	jml RamPermit	;back down ints and	leave	ENTRY unloadcomp	; EXPORT -> ENTRY  **TGHunloadcomp	clc	xce	rep #mbit+xbit	longa on	longi on	lda unloadcmd	sta cmdlist	lda unloadcmd+2	sta cmdlist+2	lda #papnoerr	;tell user that we are done	jsl exitcomp	;and call users routine	rtl	;and return to caller	ENDP;-------------------------------------------------------------------------------;;	pap.write;cpapwrite	PROC	;write section	jsr setup	;do normal entry stuff	longa on	longi on	;comes back full 16	lda openflag	;see if open	cmp #2	;must be at stage 2	beq callok	;it is open	lda #papnotopen	;pap is not open now	jmp accumexit	;and return with errorcallok		; 	lda writecmdlist	;see if write already in progress	ora writecmdlist+2	beq callok1	;ok since not writing	lda #papinuse	;pap call is in progress	jmp accumexitcallok1		; 	ldy #popen_refnum	;get reference number	lda [cmdlist],y	and #$00ff	;only want one byte	cmp #0001	;see if valid	beq callok2	lda #papsessinvalid	jmp accumexitcallok2		; 	ldy #pwrite_blen	;get users length	lda [cmdlist],y	cmp #513	;see if bigger than	512 bytes	bcc callok3	;less than 513 so ok	lda #papsizeerr	;buffer to big	jmp accumexitcallok3		; 	sta wtbds+bds_bufsize ;number of bytes to write	ldy #pwrite_bptr	;now get their buffer pointer	lda [cmdlist],y	;get low word	sta wtbds+bds_bufptr	iny	iny	lda [cmdlist],y	sta wtbds+bds_bufptr+2	sep #mbit+xbit	longa off	longi off	ldy #pwrite_eofflag	;get end of file flag offset	lda [cmdlist],y	;and get the flag	sta wtbds+bds_user+2 ;and store in packet	rep #mbit+xbit	longa on	longi on	lda cmdlist	;now set up internal pointer	sta writecmdlist	lda cmdlist+2	sta writecmdlist+2* the user bytes have already been set up by the open call	lda wtpkt	;has a read come in?	bne writeit	;yes, so ready to go	inc wdata	;tell getrequest data pending	jmp asyncexit	;return with busy flag setwriteit		; 	ldy #pstat_result	lda #papbusy	;set result to busy	sta [cmdlist],y	;before doing anything	jsr dowrite	;issue the send response	jml RamPermit	;and leave	ENTRY dowrite	; EXPORT -> ENTRY  **TGHdowrite	rep #mbit+xbit	;make sure in full 16 bit mode	longa on	longi on	stz wtpkt	;no read waiting now	stz wdata	;no data pending	inc inseq	;bump expected sequence number	bne seqok	;not back to 0	inc inseq	;was zero so make 1seqok		; 	ldx #wtrsp	ldy #^wtrsp	jsl RamDispatch	rts	;and return	ENTRY writecomp	; EXPORT -> ENTRY  **TGHwritecomp		;comes here	when write completes	clc	xce	;go to native mode	rep #mbit+xbit	longa on	longi on	lda writecmdlist	;get users list	sta cmdlist	lda writecmdlist+2	sta cmdlist+2	lda wtrsp+2	;check for error	beq goodwt	;if zero it was successful	cmp #noatprel	;see if expired normally	beq goodwt	;normal expire so good	cmp #rsprel	;see if forced to expire	beq goodwt	;somebody forced routine to finish, so this is ok	cmp #noddpskt	bne wtexit	lda #papneterr	bra ewtexit	;report an errorgoodwt		; ;it was good	lda closing	;see if connection is in closing phase	bne wtexit	;yes, so leave without calling completion (called in close)	stz writecmdlist	;and zero out since	done	stz writecmdlist+2	lda #papnoerr	;tell user good callewtexit		; 	jsl exitcomp	;call completionwtexit		; 	rtl	;and return	ENDP;-------------------------------------------------------------------------------;;	pap.read;cpapread	PROC	;read section	jsr setup	;do normal entry stuff	longa on	longi on	;comes back full 16	lda openflag	;see if open	cmp #2	;must be at stage 2	beq callok	;it is open	lda #papnotopen	;pap is not open now	jmp accumexit	;and return with errorcallok		; 	lda readcmdlist	;see if read already in progress	ora readcmdlist+2	beq callok1	;ok since not writing	lda #papinuse	;pap call is in progress	jmp accumexitcallok1		; 	ldy #popen_refnum	;get reference number	lda [cmdlist],y	and #$00ff	;only want one byte	cmp #0001	;see if valid	beq callok2	lda #papsessinvalid	jmp accumexitcallok2		; 	ldy #pread_bufptr	;get address of where to store	lda [cmdlist],y	;data read in	sta rdbds+bds_bufptr	iny	iny	lda [cmdlist],y	;get high word	sta rdbds+bds_bufptr+2	lda cmdlist	;now save users parm list	sta readcmdlist	lda cmdlist+2	;so we know where results should go	sta readcmdlist+2	inc nextseq	;bump sequence number	bne okfine	inc nextseq	;skip over 0 alwaysokfine		; 	lda nextseq	xba	sta rdrq+atprq_user+2 ;and send sequence with request	sep #mbit+xbit	longa off	longi off	lda #01	;set bitmap for read request	sta rdrq+atprq_bitmap	rep #mbit+xbit	;and back to full 16 bit	longa on	longi on	ldy #pstat_result	lda #papbusy	;set result to busy	sta [cmdlist],y	;before doing anything	ldx #rdrq	;and make the call	ldy #^rdrq	jsl RamDispatch	jml RamPermit	;error in busy mode	ENTRY readcomp	; EXPORT -> ENTRY  **TGHreadcomp		;comes here when read completes	clc	xce	;go to native mode	rep #mbit+xbit	longa on	longi on	lda readcmdlist	;get users list	sta cmdlist	lda readcmdlist+2	sta cmdlist+2	lda rdrq+2	;check for error	beq readcompgood	;no error	cmp #noddpskt	;see if no more sockets	bne rdexit	;error so just exit	lda #papneterr	jml exitcomp	;call completion routine if anyreadcompgood		; 	stz readcmdlist	;and zero out since	done	stz readcmdlist+2	lda rdbds+bds_actlen ;get length of data just read	ldy #pread_buflen	;and pass on to user	sta [cmdlist],y	sep #mbit+xbit	longa off	longi off	lda rdbds+bds_user+2 ;get eof flag (from bds not rqlist 6/15/88)	ldy #pread_eofflag	sta [cmdlist],y	rep #mbit+xbit	longa on	longi on	lda #papnoerr	;tell user good call	jsl exitcomp	;call completionrdexit		; 	rtl	;and return	ENDP;-------------------------------------------------------------------------------;;	pap.vars;datablock	PROC	entry zerodata	entry statcmdlist	entry opencmdlist	entry writecmdlist	entry readcmdlist	entry closecmdlist	entry wdata	entry wtpkt	entry openflag	entry inseq	entry nextseq	entry closing	entry zeroend	entry lkcurr	entry lknext	entry lkcomp	entry connid	entry rspskt	entry startticks	entry unloadcmd	entry stlkparms	entry oplkparms	entry srqparms	entry srqbds	entry opsktparms	entry orqparms	entry odata	entry orqbds	entry opentimer	entry rdrq	entry rdbds	entry canrd	entry tkrq	entry tkbds	entry conntimer	entry pgrq	entry wtrsp	entry wtbds	entry wtrel	entry closeskt	entry clsreq	entry clsbds	entry closersp	entry closebds	entry upapclose	entry lookbufzerodata		;data to zero on init starts hereopencmdlist	DS.B 4writecmdlist	DS.B 4readcmdlist	DS.B 4closecmdlist	DS.B 4wdata	DS.B 2wtpkt	DS.B 2openflag	DS.B 2inseq	DS.B 2	;sequence number we	are expectingnextseq	DS.B 2	;next sequence to go out in readclosing	ds.b 2	;flag to tell us if we are in the middle of a closezeroend		;and zeroing stops herestatcmdlist	DS.B 4	;Took this out of zerodata **TGH 5/25/89lkcurr	DS.B 2	;current item being	looked uplknext	DS.B 2	;next item to look uplkcomp	DS.B 2	;real completion address for lkcurrconnid	DS.B 2rspskt	DS.B 2startticks	DS.B 2unloadcmd	DS.B 4stlkparms	DC.B $80,$10,$00,$00 ;cnt, cmd, result	DC.L stlkcomp	;completion routine	DC.L 0	;entity name stuff	DC.B 1	;look every 1/4 sec	DC.B 12	;look up to 12 times	DC.B $00,$00	;reserved bytes	DC.W 105	;105 byte buffer	DC.L lookbuf	DC.B $01	;only want 1 match total	DC.B $00	;number gottenoplkparms	DC.B $80,$10,$00,$00 ;cnt, cmd, result	DC.L oplkcomp	;completion routine	DC.L 0	;entity name stuff	DC.B 1	;look every 1/4 sec	DC.B 12	;look up to 12 times	DC.B $00,$00	;reserved bytes	DC.W 105	;105 byte buffer	DC.L lookbuf	DC.B $01	;only want 4 match total	DC.B $00	;number gottensrqparms	DC.B $80,$12,$00,$00 ;cnt, cmd, result	DC.L statcomp	;io completion	DC.B $00	;our socket (listener socket)	DC.B $00,$00	;their network	DC.B $00	;their node	DC.B $00	;their skt	DC.B $00,$00	;their tid	DC.W 0	;buffer to send size	DC.L 0	;no buffer used	DC.B $00,$08,$00,$00 ;user bytes	DC.B $01	;1 response buffer	DC.L srqbds	;bds for input	DC.B $00	;flag	DC.B $08	;every 2 seconds	DC.B 05	;try 10 times	DC.B $01	;bitmap for request	DC.B $00	DC.B $00,$00,$00,$00,$00,$00 ;reserved fieldssrqbds	DC.W 256	;max buf size	DC.L 0	;start code here   	DC.B $00,$08,$00,$00 ;this is a status call	DC.B $00,$00	;and actual length receivedopsktparms	DC.B $00,$14,$00,$00,$00 ;open a dynamic socketorqparms	DC.B $80,$12,$00,$00 ;cnt, cmd, result	DC.L opencomp	;io completion	DC.B $00	;our socket (listener socket)	DC.B $00,$00	;their network	DC.B $00	;their node	DC.B $00	;their skt	DC.B $00,$00	;their tid	DC.W 4	;buffer to send size	DC.L odata	;send this data	DC.B $00,$01,$00,$00 ;user bytes	DC.B $01	;1 response buffer	DC.L orqbds	;bds for input	DC.B atpxobit	;flag	DC.B $08	;every 2 seconds	DC.B 05	;try 10 times	DC.B $01	;bitmap for request	DC.B $00	DC.B $00,$00,$00,$00,$00,$00 ;reserved fieldsodata	DS.B 4orqbds	DC.W 256	;max buf size	DC.L 0	;start code here   	DC.B $00,$08,$00,$00 ;this is a status call	DC.B $00,$00	;and actual length receivedopentimer	DC.B $80,$04,$00,$00	DC.L trynextopen	DC.B $00,$00	DC.B $00,$00	;code fills in time	DC.B $00,$00,$00,$00 ;internal userdrq	DC.B $80,$12,$00,$00 ;cnt, cmd, result	DC.L readcomp	;io completion	DC.B $00	;our socket (listener socket)	DC.B $00,$00	;their network	DC.B $00	;their node	DC.B $00	;their skt	DC.B $00,$00	;their tid	DC.W 0	;buffer to send size	DC.L 0	;no buffer used	DC.B $00,$03,$00,$00 ;user bytes	DC.B $01	;1 response buffer 	DC.L rdbds	;bds for input	DC.B atpxobit	;flag	DC.B 60	;every 15 seconds	DC.B $ff	;try forever	DC.B $01	;bitmap for request	DC.B $00	DC.B $00,$00,$00,$00,$00,$00 ;reserved fieldsrdbds	DC.W 512	;max buf size	DC.L 0	;start code here   	DC.B $00,$00,$00,$00 ;user bytes returned here	DC.B $00,$00	;and actual length receivedcanrd	DC.B $00,$13,$00,$00 ;cancel cmd	DC.B $00,$00	;tid goes heretkrq	DC.B $80,$12,$00,$00 ;cnt, cmd, result	DC.L 0	;io completion	DC.B $00	;our socket (listener socket)	DC.B $00,$00	;their network	DC.B $00	;their node	DC.B $00	;their skt	DC.B $00,$00	;their tid	DC.W 0	;buffer to send size	DC.L 0	;no buffer used	DC.B $00,$05,$00,$00 ;user bytes	DC.B $01	;no response buffer	DC.L tkbds	;bds for input	DC.B $00	;flag	DC.B 60*4	;every minute	DC.B $ff	;try forever	DC.B $01	;bitmap for request	DC.B $00	DC.B $00,$00,$00,$00,$00,$00 ;reserved fieldstkbds	DC.W 0	;max buf size	DC.L 0	;start code here   	DC.B $00,$00,$00,$00 ;user bytes returned here	DC.B $00,$00	;and actual length receivedconntimer	DC.B $80,$04,$00,$00	DC.L closecomp	;close up if expires	DC.B $00,$00	DC.B $00,$00	;code fills in time	DC.B $00,$00,$00,$00 ;internal usepgrq	DC.B $80,$16,$00,$00 ;cnt, async cmd, result	DC.L pgrqcomp	;io completion	DC.B $00	;our socket (listener socket)	DC.B $00,$00	;their net (filed in by call)	DC.B $00,$00	;their node & skt	DC.B $00,$00	;their tid	DC.W 0	;buffer size	DC.L 0	;buffer for incoming requests	DC.B $00,$00,$00,$00 ;incoming user data	DC.B $00,$00	;actual length of incoming request	DC.B $00,$00	;flag and bitmap	DC.B $00,$00,$00,$00 ;reserved for linkwtrsp	DC.B $80,$17,$00,$00 ;cnt, async cmd, result	DC.L writecomp	;io completion	DC.B $00	;source socket	DC.B $00,$00	;destination net	DC.B $00,$00	;dest node & skt	DC.B $00,$00	;tid	DC.B $01,$01	;number of buffers and max bufs	DC.L wtbds	;bds for response	DC.B atpxobit	;flag	DC.B $01	;responding bitmap	DC.B $00,$00,$00,$00 ;add routine and flag	DC.B $00wtbds	DC.W 0	;number of bytes to	send	DC.L 0	;buffer to write from	DC.B $00,$04,$00,$00 ;user bytes	DC.B $00,$00	;actual length fieldwtrel	DC.B $00,$19,$00,$00 ;release cb	DS.B 7	;rest filled in by codecloseskt	DC.B $00,$15,$00,$00 ;close cmd	DC.B $00	;socket to close goes hereclsreq	DC.B $80,$12,$00,$00 ;cnt, cmd, result	DC.L closecomp	;io completion	DC.B $00	;our socket (listener socket)	DC.B $00,$00	;their network	DC.B $00	;their node	DC.B $00	;their skt	DC.B $00,$00	;their tid	DC.W 0	;buffer to send size	DC.L 0	;no buffer to send	DC.B $00,$06,$00,$00 ;user bytes	DC.B $01	;need 1 response bds	DC.L clsbds	;bds for input	DC.B 0	;flag	DC.B 8	;every 2 secs	DC.B 5	;5 times	DC.B $01	;bitmap for request	DC.B $00	DC.B $00,$00,$00,$00,$00,$00 ;reserved fieldsclsbds	DC.W 0	;max buf size	DC.L 0	;start code here   	DC.B $00,$00,$00,$00 ;user bytes returned here	DC.B $00,$00	;and actual length receivedclosersp	DC.B $80,$17,$00,$00 ;cnt, async cmd, result	DC.L closecomp	;io completion	DC.B $00	;source socket	DC.B $00,$00	;destination net	DC.B $00,$00	;dest node & skt	DC.B $00,$00	;tid	DC.B $01,$01	;number of buffers and max bufs	DC.L closebds	;bds for response	DC.B atpeombit	;flag	DC.B $01	;bitmap filled in by call	DC.B $00,$00,$00,$00 ;add routine and flag	DC.B $00closebds	DC.W 0	;number of bytes to	send	DC.L 0	;buffer to write from	DC.B $00,$07,$00,$00 ;user bytes	DC.B $00,$00	;actual length fieldupapclose	DC.B $80,$24,$00,$00	DC.L unloadcomp	;completion routine	for unload	DC.B 1	;1 is only valid numberlookbuf	DS.B 105	;enough for 1 full response	ENDP; BEGIN 14-Nov-91 MSD;; ValidateName is used to do basic validation of the length of the object,; type, and zone strings of the printer name used in PAPOpen and PAPStatus.;; On entry, the Y register contains the offset in the parameter block where; the pointer to the printer name is stored.  It uses 4 bytes on zero page; at location execaddr ($84).  If there is an error, carry is set and A; contains $0807 (network error); otherwise, carry is clear (A is undefined).;ValidateName	proc	lda [cmdlist],y	; get low word of printer entity pointer	sta execaddr	; put on zero page	iny	iny	lda [cmdlist],y	sta execaddr+2		ldx #3	; going to check 3 stringsloop	lda [execaddr]	; get length	and #$00FF	; one byte only	cmp #33	; too long to be valid?	bge err	; yes, so return error		sec	; add 1 for length byte	adc execaddr	; point to next string	sta execaddr	bcc nextstr	; no carry, don't go to next bank	inc execaddr	; carry into bank bytenextstr	dex	; done all strings yet?	bne loop	clc	; all OK, no error	rtserr	sec	lda #papneterr	rts	endp; END 14-Nov-91 MSD	END	