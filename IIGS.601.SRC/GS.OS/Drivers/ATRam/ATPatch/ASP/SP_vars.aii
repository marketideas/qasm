;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------* * Sp_vars* * by *   Greg Seitz*   2-Jun-87** this file contains the declarations of the data used* by the session protocol code.** 16-May-91  MSD	Changed to use equates for the retry interval and*	count for sending close requests.*		EXPORT	spvars              spvars	PROC		EXPORT	spbankspbank		; ;referenced in calls to atalk for bank		EXPORT	saver1saver1		DS.B 4		EXPORT	wsswss		DS.B 2	;socket for getrequests goes here   		EXPORT	callexecflagcallexecflag		DS.B 2		EXPORT	wascancelledwascancelled		DS.B 2	;semaphore for close routine syncronization		EXPORT	closesessnumclosesessnum		DS.B 2	;space for local		EXPORT	openatpsocketopenatpsocket		; 	DC.B	$00,$14,$00,$00	DC.B	$00,$00	;socket returned here		EXPORT	grqparmgrqparm	DC.B	$80,$16,$00,$00	;cnt, async cmd, result	DC.L	grqcomp	;io completion	DC.B	$00	;our socket (listener socket)	DC.B	$00,$00	;their net (filed in by call)	DC.B	$00,$00	;their node & skt	DC.B	$00,$00	;their tid	DC.W	2	;buffer size	DC.L	grqbuf	;buffer for incoming requests	DC.B	$00,$00,$00,$00	;incoming user data	DC.B	$00,$00	;actual length of incoming request	DC.B	$00,$00	;flag and bitmap	DC.B	$00,$00,$00,$00	;reserved for link		EXPORT	grqbufgrqbuf		DS.B 2	;incoming data goes	here		EXPORT	relparmrelparm	DC.B	$00,$19,$00,$00		DS.B 8	;rest filled in by code		EXPORT	cancelrequestcancelrequest	DC.B	$00,$13,$00,$00		DS.B 2	;tid goes here      		EXPORT	arsparsp	DC.B	$80,$17,$00,$00	;cnt, async cmd, result	DC.L	0	;io completion	DC.B	$00	;source socket	DC.B	$00,$00	;destination net	DC.B	$00,$00	;dest node & skt	DC.B	$00,$00	;tid	DC.B	$01,$01	;number of buffers and max bufs	DC.L	arspbds	;bds for response	DC.B	0	;flag	DC.B	$01	;responding bitmap	DC.B	$00,$00,$00,$00	;add routine and flag	DC.B	$00		EXPORT	arspbdsarspbds	DC.W	0	;number of bytes to	send	DC.L	0	;buffer to write from	DC.B	$00,$00,$00,$00	;user bytes	DC.B	$00,$00	;actual length field* the structure of the data in the following table is:* $0000addr - data at addr is available	for use in status call* $0001addr - data at addr is in use* $ffffaddr - end of table marker		EXPORT	statustablestatustable		; 	DC.W	statusreq1	DC.W	0	DC.W	statusreq2	DC.W	0	DC.W	statusreq3	DC.W	0	DC.W	statusreq4	DC.W	0	DC.W	statusreq5	DC.W	0	DC.W	statusreq6	DC.W	0	DC.W	statusreq7	DC.W	0	DC.W	statusreq8	DC.W	0	DC.L	$ffff0000	;end of table		EXPORT	statusreq1statusreq1	DC.B	$80,$12,$00,$00	;cnt, cmd, result	DC.L	statuscomp	;io completion	DC.B	$00	;our socket (listener socket)	DC.B	$00,$00	;their network	DC.B	$00	;their node	DC.B	$00	;their skt	DC.B	$00,$00	;their tid	DC.W	0	;buffer to send size	DC.L	0	;send this data	DC.B	$03,$00,$00,$00	;user bytes	DC.B	8	;8 response buffers	DC.L	stsrqbds1	;bds for input	DC.B	0	;flag	DC.B	cmdintvl	;retry interval	DC.B	cmdcount	;retry count	DC.B	$ff	;bitmap for request	DC.B	$00	DC.B	$00,$00,$00,$00,$00,$00	;reserved fields	DC.W	statustable	;point back to sessionrec we belong to	DC.L	0	;user command list goes here		EXPORT	stsrqbds1stsrqbds1	DC.W	578	;max buf size	DC.L	0	;data goes here   	DC.B	$00,$00,$00,$00	;user bytes returned here	DC.B	$00,$00	;and actual length received	DC.W	578	;max buf size	DC.L	0	;data goes here   	DC.B	$00,$00,$00,$00	;user bytes returned here	DC.B	$00,$00	;and actual length received	DC.W	578	;max buf size	DC.L	0	;data goes here   	DC.B	$00,$00,$00,$00	;user bytes returned here	DC.B	$00,$00	;and actual length received	DC.W	578	;max buf size	DC.L	0	;data goes here   	DC.B	$00,$00,$00,$00	;user bytes returned here	DC.B	$00,$00	;and actual length received	DC.W	578	;max buf size	DC.L	0	;data goes here   	DC.B	$00,$00,$00,$00	;user 