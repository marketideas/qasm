;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------** sp_open**   by*   Greg Seitz*   8-jun-87** this is the open module for asp.  It starts a session off.**;; 16-May-91 MSD	Changed error returned when no more sessions;	can be opened (the session table is full) from;	$0702 (too many ASP calls) to $0708 (too many;	open sessions).;; 25-Sep-91 MSD	If I can't open an ATP socket when trying to open;	a session, return network error instead of too many;	open sessions.;	EXPORT cspopensessioncspopensession	PROC	longa on	longi on	jsr sp_setup	;set everything up	lda wss	;get work station socket	bne goodsocket	;it's valid	lda #0000	sta openatpsocket+4	;clear out socket num field	ldx #openatpsocket	;open a socket	ldy #^openatpsocket	jsl >RamDispatch	;make the call	lda openatpsocket+2	;get result	beq gotsocket	;got a good socket  	lda #spneterr	; 25-Sep-91 MSD	brl accumexitgotsocket		; 	lda openatpsocket+4	;get socket num returned	sta wss	;and save our socket num	sta grqparm+8	;issue first getrequest	ldx #grqparm	ldy #^grqparm	jsl >RamDispatchgoodsocket		; 	ldx #sessiontable	;find us a free item	jsr findfree	bcc gotfree	;we got a free session	lda #sptoomanysess	;to many open calls	active (16-May-91 MSD)	brl accumexit	;leave with error codegotfree		; 	pha	;save index number returned	stx <R0	lda #iteminuse	;we are in process of opening	ldy #0002	;move to marker position	sta (<R0),y	lda (<R0)	;get pointer to sessionrec	sta <R0	;save it	pla	;recover index number to free sessiontable	ldy #srec_usersesnum ;	sta (<R0),y	;save index number till open completion	routine is called	ldy #srec_oreq	lda (<R0),y	;get openrequest parmlist ptr	sta <R1	;save for later	tax	jsr movenetinfo	;move network info into request	ldy #srec_treq	lda (<R0),y	;get ticklerequest parmlist ptr	tax	jsr movenetinfo	;move network info into request	ldy #srec_creq	lda (<R0),y	;get closerequest parmlist ptr	tax	jsr movenetinfo	;move network info into request	ldy #srec_cmdreq	lda (<R0),y	;get commandrequest	parmlist ptr	tax	jsr movenetinfo	;move network info into request	ldy #srec_wreq	lda (<R0),y	;get writerequest parmlist ptr	tax	jsr movenetinfo	;move network info into request	lda <cmdlist	;get users command list	ldy #srec_ocmdlist	sta (<R0),y	iny	iny	lda <cmdlist+2	sta (<R0),y	sep #mbit	;use 8 bit a	longa off	lda wss	;get socket	ldy #atprq_user+1	;move to wss field  	sta (<R1),y	;store in open request	ldy #atprq_bitmap	lda #01	sta (<R1),y	;set bitmap each time	rep #mbit	;back to full native	longa on	lda #spbusy	ldy #spopen_result	;offset to result	sta [cmdlist],y	;and show that we are busy	ldx <R1	;get parm list address	ldy #^spbank	jsl >RamDispatch	;call atalk	jml >RamPermit	;back down ints and	exit** opencomp - this is the completion routine for the open session call* we must determine	whether the open was succesful, and if so set everything* up appropriatly.*	EXPORT opencompopencomp		;       	pei <R0	;save zero page usage	pei <R1	lda <cmdlist	;save our list pointer	sta <R0	;in R0	ldy #rqtableoffset	;offset to storage location of cmdlist ptr	lda (<R0),y	;get related session record	sta <R1	;save pointer to session rec	ldy #srec_ocmdlist	lda (<R1),y	;get low word of users open cmdlist	sta <cmdlist	iny	iny	lda (<R1),y	sta <cmdlist+2	ldy #0002	;move to result field	lda (<R0),y	;get result of open	request	cmp #requestfail	;request timed out	bne notfail	;not a fail	lda #spnoresponse	;no server responding	brl openerrexit	;exit with errornotfail	cmp #spnoerr	;see if call good	beq goodopen	;yes	lda #spneterr	;un-expected error	brl openerrexitgoodopen		; 	ldy #atprq_rbdsad	lda (<R0),y	;get rbds pointer	sta <R0	;r0 now points to rbds	ldy #bds_user+2	;get offset to error returned	lda (<R0),y	;get error code	beq goodopen1	;opening is still good	cmp #badvernum	;see if server bad version number	bne serverbusyerr	;no, so assume server busy	lda #spbadver	;return bad version	number	brl openerrexitserverbusyerr		; 	lda #spserverbusy	brl openerrexitgoodopen1		; 	ldy #bds_user	;offset to sss field	sep #mbit	;8 bit mode	lda (<R0),y	;get sss	ldy #srec_sss	sta (<R1),y	;save in session record	ldy #srec_cmdreq	jsr setsss	ldy #srec_wreq	jsr setsss	ldy #srec_creq	jsr setsss* the following field (srec_usersesnum)	contains the session number* that we give to the person who called	us, so he can make other calls* like writes and commands.  This field	is currently the index into the * session table.  The sessionrefnum that is maintained to the server may* not neccesarily be the same as the one that we return to the user*	ldy #srec_usersesnum ;get user session number assigned in first stage of open	lda (<R1),y	ldy #spopen_sref	sta [<cmdlist],y	;tell user his session ref number	ldy #bds_user+1	;get session num offset	lda (<R0),y	;get session num	ldy #srec_cmdreq	;set session number	jsr setses	ldy #srec_treq	jsr setses	ldy #srec_wreq	jsr setses	ldy #srec_creq	jsr setses	rep #mbit	;back to full native	and #$00ff	;low byte has session num	ora #itemopen	;mark session as open	jsr settable	;set table entry with this flag	ldy #spopen_attention	lda [<cmdlist],y	;get attention routine	pha	iny	iny	lda [<cmdlist],y	;get high byte attention routine	ldy #srec_attention+2	sta (<R1),y	;store in session record	pla	dey	dey	sta (<R1),y	lda #$ffff	;start here so first one is zero	ldy #srec_seqnum	sta (<R1),y	ldy #srec_treq	lda (<R1),y	;get tickle request	pointer	tax	ldy #^spbank	jsl >RamDispatch	;call atalk	ldy #srec_timer	lda (<R1),y	;get timer pointer	tax	sta <R0	lda #instimer	;install timer command	sta (<R0)	ldy #insqtr_count	lda #conntime	sta (<R0),y	;store connection timeout	ldy #^spbank	jsl >RamDispatch	;call atalk	lda #spnoerr	;exit with no error	bra spopenexit	;openerrexit		; 	pha	lda #itemfree	;table entry is now	free	jsr settable	pla	;recover errorspopenexit		; 	tax	;save error	pla	sta <R1	pla	sta <R0	txa	brl exitcomp	;exit and set error	code	EXPORT timercomptimercomp		;       ;comes here	if session timer expires	ldy #ttableoffset	;get offset to session rec for	lda (<cmdlist),y	;this timer	tax	lda #timeoutbit	;show timeout when calling atten routine	jsr closeconnection	;close everything up	rtl	;and return** grqcomp -completion routine for getrequest* all incoming requests for all open sessions come here* and are tied to only 1 get request for all asp activity* therefore we must	keep re-isuing this	getrequest every time* it gets here to make sure it stays active.*	EXPORT grqcompgrqcomp		;       	pei <R0	;save zp useage	pei <R1	stz callexecflag	;assume not to call	attention routine	lda grqparm+getrq_result ;see if we got	an error	beq nogrqerr	;no error so continue	brl grqexitrel	;assume error was norspcbmem and re-issue new grq and exitnogrqerr		; 	lda grqparm+getrq_user+1 ;get session ref	and #$00ff	;clear high byte	jsr grqsessionmatch	;attempt to find a matching session	bcc grqsesgood	;still a good session	brl grqexitrel	;re-issue grq and exitgrqsesgood		; * sessionmatch returns the session rec pointer in a	sta <R0	tax	jsr resettime	;reset timeout timer	lda grqparm+getrq_user ;get command from request	and #$00ff	;strip high byte	cmp #writedata	;see if they are asking us to write	bne chkclose	;no, check for close	ldy #srec_wcmdlist	;offset to writecmdlist	lda (<R0),y	;get low word	sta <cmdlist	iny	iny	lda (<R0),y	;get high word	sta <cmdlist+2	ora <cmdlist	;see if call active	bne activecall	brl grqexitrel	;no call so exitactivecall		; 	ldy #srec_wreq	lda (<R0),y	;get write atprequest	sta <R1	ldy #atprq_user+2	;sequence number expected	lda (<R1),y	;from write rq	cmp grqparm+getrq_user+2	beq grqseqmatch	;sequence numbers match	brl grqexitrel	;not matching sequence numbersgrqseqmatch		; 	lda grqbuf	;get servers max buffer size	xba	;put in our format	ldy #spwrt_wrtlen	;check against amount of data to write	cmp [<cmdlist],y	bcc setlen	;use accum to set len	lda [<cmdlist],y	;we can write this muchsetlen		; 	ldy #spwrt_writtenlen	sta [<cmdlist],y	;store amount written	pha	;save for a moment	ldy #srec_wreply	lda (<R0),y	;get reply parm list	tax	pla	;recover len	phx	;save reply parm list for call	jsr setupreply	;set up the reply	plx	;get reply parm list low word	ldy #^spbank	;get high word	jsl >ramdispatch	;and send the response	brl grqexitchkclose		; 	cmp #closesession	bne chkattn	;not a close request	ldy #srec_creply	;get close reply	lda (<R0),y	pha	;save for later	clc	adc #sdrsp_sskt	tax	;move data here	lda #grqparm+getrq_ourskt	ldy #7	jsr movemem	;move net info	plx	;get reply parmlist	address	stx <R1	lda grqparm+getrq_flag	ldy #sdrsp_flag	sta (<R1),y	;put getrequest flag and bitmap into response	ldy #^spbank	jsl >RamDispatch	;send close reply	ldx <R0	;get session rec ptr	lda #closebit	;show close happened and call atten routine	jsr closeconnection	;shut down the session	brl grqexitrelchkattn		; 	cmp #attention	;see if they are sending attention	bne grqexitrel	;no so exit	ldx #arsp+sdrsp_sskt ;get offset to net	info in response	lda #grqparm+getrq_ourskt ;get offset to incoming net info	ldy #7	;amount of data to move	jsr movemem	lda grqparm+getrq_flag	sta arsp+sdrsp_flag	;put getrequest flag and bitmap into response	ldx #arsp	ldy #^spbank	jsl >RamDispatch	;send response	ldy #srec_attention	;offset to attention routine	lda (<R0),y	;get low word	sta <cmdlist	iny	iny	lda (<R0),y	;get high word	sta <cmdlist+2	ora <cmdlist	;see if no attention routine	beq grqexitrel	jsr getsessnum	;find out what the session number is that goes with this attention	sta [<cmdlist]	;store session number	lda grqparm+getrq_user+2 ;get attention	word	ldy #0002	;put attention word	at 2 bytes	sta [<cmdlist],y	;past attention routine	clc	lda <cmdlist	adc #0004	;call routine at 4 bytes past address	sta <execaddr	lda <cmdlist+2	adc #0000	sta <execaddr+2	inc callexecflag	;show we want routine calledgrqexitrel		; ;release rspcb and exit	ldx #relparm+4	;move data to here	lda #grqparm+8	;move from here	ldy #7	;move 7 bytes	jsr movemem	;move it	ldx #relparm	ldy #^relparm	jsl >RamDispatch	;release the cbgrqexit		; 	pla	sta <R1	pla	sta <R0	ldx #grqparm	ldy #^grqparm	jsl >RamDispatch	lda callexecflag	;see if need to call attention routine	beq grqexitdone	;we can exit, no need to call routine	jsl >RamGoComp	;call the routinegrqexitdone		; 	rtl** resettime - resets connection timeout	mechanism* x = srec ptr*	EXPORT resettimeresettime		;       	pei <R0	stx <R0	ldy #srec_timer	lda (<R0),y	;get pointer to timer	sta <R0	ldy #insqtr_count	lda #conntime	sta (<R0),y	;re-update connection timeout	pla	sta <R0	rts** movemem* moves memory from	a to x, moving y bytes*	EXPORT movememmovemem		;       	pei <R0	pei <R1	sta <R0	stx <R1	php	;save state	sep #mbit	;go to 8 bit a modemvlp	dey	bmi moveexit	lda (<R0),y	sta (<R1),y	bra mvlpmoveexit		; 	plp	;recover mode	pla	sta <R1	pla	sta <R0	rts** setupreply - sets	up reply parmlist and reply bds* x = reply parmlist pointer* a = max number of	bytes to set buffers for* cmdlist = users write cmdlist** 	EXPORT setupreplysetupreply		;       	pei <R0	pei <R1	pei <R2+2	pei <R2	stx <R0	;save parm list ptr	sta <R2	;save len	ldy #spwrt_wrtadr	lda [<cmdlist],y	;get reply buffer start	sta <execaddr	iny	iny	lda [<cmdlist],y	sta <execaddr+2	ldy #sdrsp_rbdsad	lda (<R0),y	;get rbds ptr	sta <R1	stz <R2+2	;number of buffers	lda <R2	;see if asked to send no data	beq usea	;and special case if so...(always send at least 1 bds)setuplp		; 	sec	lda <R2	beq setupdone	;we are done setting bds	sbc #maxcmdsize	;see if still larger	bmi useR2	;use existing len	sta <R2	lda #maxcmdsize	bra useauseR2	lda <R2	stz <R2	;nothing leftusea		; 	ldy #bds_bufsize	sta (<R1),y	;save len	ldy #bds_bufptr	clc	lda <execaddr	sta (<R1),y	adc #maxcmdsize	sta <execaddr	;new address	iny	iny	lda <execaddr+2	sta (<R1),y	;set buffer address	to write from	adc #^maxcmdsize	sta <execaddr+2	lda <R1	clc	adc #12	sta <R1	;new bds pointer	inc <R2+2	;bump number of buffers	bra setuplpsetupdone		; 	lda <R2+2	;get number of buffers	ldy #sdrsp_rbnum	sep #mbit	sta (<R0),y	iny	sta (<R0),y	;set up number of buffers in parms	lda grqparm+getrq_bitmap	ldy #sdrsp_bitmap	sta (<R0),y	;copy bitmap	rep #mbit	lda <R0	clc	adc #sdrsp_sskt	;response socket address	tax	;move to dest register	lda #grqparm+getrq_ourskt	ldy #7	;move this many bytes	jsr movemem	pla	sta <R2	pla	sta <R2+2	pla	sta <R1	pla	sta <R0	rts** sessionmatch - checks to see if session number passed in* accumulator is valid, and returns with carry clear if it is.* found.  If a match is found the session ptr is returned in a*	EXPORT sessionmatchsessionmatch		;       	pha	;save session number	dec a	;put in zero to n range	bmi sessionnomatch	;invalid session number	cmp #maxaspsessions	;see if out of range	bcs sessionnomatch	;out of range	asl a	asl a	;multiply by four to point to get table	offset	tax	;use as index	lda sessiontable+2,x ;get flag field of	table entry	and #$ff00	;strip unwanted data	cmp #itemopen	;see if this item is open	beq sessionfound	;yessessionnomatch		; 	sec	;indicate error	bra sessionexitsessionfound		; 	clc	;indicate match found	lda sessiontable,x	;get session ptrsessionexit		; 	plx	;recover session num	rts	EXPORT setssssetsss		;       	php	rep #mbit+xbit	pei <R0	tax	lda (<R1),y	sta <R0	ldy #atprq_dskt	txa	sep #mbit	sta (<R0),y	;store in 8 bit mode	plx	;recover r0	stx <R0	plp	rts	EXPORT setsessetses		;       	php	rep #mbit+xbit	pei <R0	tax	lda (<R1),y	sta <R0	ldy #atprq_user+1	txa	sep #mbit	sta (<R0),y	;store in 8 bit mode	plx	;recover r0	stx <R0	plp	rts** settable - sets table entry to flag in accum* R1=session record	pointer* a=flag to set*	EXPORT settablesettable		;       	pei <R0	pha	ldy #srec_tableaddr	lda (<R1),y	;get our table location	sta <R0	ldy #0002	;flag field	pla	;get flag	sta (<R0),y	pla	sta <R0	rts** grqsessionmatch -	searches for session number passed in* accumulator, if finds a match, it then continues to test* whether or not the network numbers and nodes match, * and returns with carry clear if a match is* found.  If a match is found the session ptr is returned in a*	EXPORT grqsessionmatchgrqsessionmatch		;       	pha	;save session to find	ldx #0000grqsmlp		; 	lda sessiontable+2,x ;get flag field	cmp #endtable	;see if at end	beq grqsessionnomatch ;no match was found	cmp #itemfree	;see if looking at empty session	beq grqbumpx	;yes so skip	eor #itemopen	;if is open set high byte to zero	cmp $1,s	;compare with session num	beq grqsessionfound	;we have a matchgrqbumpx		; 	inx	inx	inx	inx	bra grqsmlp	;keep searchinggrqsessionnomatch		; 	sec	;indicate error	bra grqsessionexitgrqsessionfound		; 	lda sessiontable,x	;get session rec ptr	pha	jsr donetmatch	;see if nets match and	pla	;recover session record	bcs grqbumpx	;not a matching sessiongrqsessionexit		; 	plx	;recover session num	rts** donetmatch - * passed session record in A, checks to	see if net info in* the getrequest packet matches that of	the open for this * session, if it does we return carry clear, otherwise we* return carry set*donetmatch		; 	phx	;preserve the x register	pei <R0	;save zero page	sta <R0	;save pointer to session record	ldy #srec_oreq	;get open request pointer	lda (<R0),y	sta <R0	;R0 now points to the original open request	lda grqparm+getrq_snet ;check to see if	their net is zero	beq donodematch	;match up node and socket, first test was ok	ldy #atprq_dnet	;lets get the original destination net	lda (<R0),y	;see if it is zero	beq donodematch	;yes, check node and socket	cmp grqparm+getrq_snet ;see if they are	both the same	beq donodematch	;yes, check node and socketnonodematch		; 	sec	;indicate no match was found	bra exitnetmatchdonodematch		; ;try to match node and socket	sep #mbit	;only check node	ldy #atprq_dnode	;offset to node and	socket bytes	lda (<R0),y	;get them	cmp grqparm+getrq_snode ;see if we have	a match	rep #mbit	;back to full 16 bit mode	bne nonodematch	;no match here, sorry	clc	;a match was found,	show with carry clearexitnetmatch		; 	pla	;restore zero page	sta <R0	plx	;restore x	rts	;and return;and return	ENDP