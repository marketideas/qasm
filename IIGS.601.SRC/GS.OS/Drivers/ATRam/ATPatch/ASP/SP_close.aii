;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------** sp_close**   by*   Greg Seitz*   10-jun-87** this is the close	module for asp.  It	takes care of shutting down* all processes related to the session it is being asked to	close**	EXPORT cspclosecspclose	PROC	longa on	longi on	jsr sp_setup	;set everything up	ldy #spclose_sref	lda [<cmdlist],y	;get session number	and #$00ff	;strip high byte junk	jsr sessionmatch	;see if session number is valid	bcc goodsession	;the session is good	lda #spbadrefnum	;bad reference number	brl accumexit	;leave with errorgoodsession		; 	sta <R1	;save session rec ptr in r1	ldy #srec_ccmdlist	lda (<R1),y	;see if command in progress	iny	iny	ora (<R1),y	;make sure both zero	beq goodsession1	;session still good	lda #sptoomany	;too many command calls	brl accumexitgoodsession1		; 	ldy #srec_ccmdlist	lda <cmdlist	sta (<R1),y	iny	iny	lda <cmdlist+2	sta (<R1),y	ldy #srec_creq	lda (<R1),y	;get closerequest list	sta <R0	sep #mbit	longa off	ldy #atprq_bitmap	lda #01	sta (<R0),y	;set bitmap each time	rep #mbit	longa on	lda #spbusy	ldy #spopen_result	;offset to result	sta [cmdlist],y	;and show that we are busy	ldx <R0	ldy #^spbank	jsl >RamDispatch	;make the close request	jml >RamPermit	;back down ints and	exit	EXPORT closecompclosecomp		;       ;comes here	when close request completes	pei <R0	ldy #rqtableoffset	;find session rec	lda (<cmdlist),y	sta <R0	;save session rec	tax	ldy #atprq_result	;get offset to result	lda (<cmdlist),y	;get result of atprequest	cmp #reqabort	;see if request was	aborted by close	beq dontclosetwice	;the 'closeconnection' routine forced cancel, don't call again 	lda #00	;no attention to call	jsr closeconnection	;close up loose endsdontclosetwice		; 	ldy #srec_ccmdlist	lda (<R0),y	sta <cmdlist	;get users cmdlist	lda #0000	;clear out old entry	sta (<R0),y	iny	iny	lda (<R0),y	sta <cmdlist+2	lda #0000	sta (<R0),y	;clear out high word of old entry	pla 	sta <R0	lda #spnoerr	brl exitcomp	;exit completion routine** closeconnection -	cancels cmd and write and timer for the* session rec passed to it, also frees up table entry for that* session.* x = srec ptr*	EXPORT closeconnectioncloseconnection		;       	pei <R0	pei <R1	pha	;save attention flag	stx <R0	;save session rec	ldy #srec_timer	;first cancel timer	lda (<R0),y	sta <R1	lda #rmvtimer	sta (<R1)	;remove connection timer	ldx <R1	ldy #^spbank	jsl >RamDispatch	lda <R0	sta <R1	lda #iteminuse	;session no longer open, but still in use	jsr settable	ldy #srec_cmdreq	;cancel this request	jsr canrequest	;cancel it	ldy #srec_wreq	;cancel this request	jsr canrequest	;cancel it	ldy #srec_treq	;cancel this request	jsr canrequest	;cancel it	jsr getsessnum	;find out number of	this session	sta closesessnum	plx	;get atten routine flag	beq alldone	;we are done so exit* now we need to call the users attention routine* with the appropriate data stored in it.	pei <cmdlist+2	pei <cmdlist	;save zp use	pei <execaddr+2	pei <execaddr	ldy #srec_attention	;offset to attention routine	lda (<R0),y	;get low word	sta <cmdlist	iny	iny	lda (<R0),y	;get high word	sta <cmdlist+2	ora <cmdlist	;see if no attention routine	beq callattenexit	lda closesessnum	;get session ref	sta [<cmdlist]	;store session number	ldy #0001	;put attention word	at 2 bytes	txa	;get attention flag	sta [<cmdlist],y	;pass to attention routine	clc	lda <cmdlist	adc #0004	;call routine at 4 bytes past address	sta <execaddr	lda <cmdlist+2	adc #0000	sta <execaddr+2	pei <R0	;save session record pointer	jsl >RamGoComp	;call attention routine	pla	sta <R0	;restore session record pointercallattenexit		; 	pla	sta <execaddr	pla	sta <execaddr+2	pla	sta <cmdlist	pla	sta <cmdlist+2	;zp is restoredalldone		; * the last thing we	should do is attempt to cancel the close request* that might have been pending, since it is possible that the close could* have been issued by the server just after we issued our own close.  If* we do not cancel,	we would have to wait until the close request timed* out before the users close call would	complete.  	ldy #srec_creq	;cancel the close request	jsr canrequest	;cancel it	lda <R0	sta <R1	lda #itemfree	;now we are really all closed up, so item can 	jsr settable	;be set to free.	pla	sta <R1	pla	sta <R0	rts** getsessnum - returns session number of session rec* R0=session record	to get session for* a=session number*	EXPORT getsessnumgetsessnum		;       	ldy #srec_tableaddr	lda (<R0),y	;get our table location	sec	sbc #sessiontable	;subtract base	lsr a	lsr a	;divide by four to get index	inc a	;index starts at 1	rts** canrequest - cancels request for list	passed in y* assumes R0 points	to session rec, and	it can destroy* R1*canrequest		; 	lda (<R0),y	;get parm list 	sta <R1	ldy #atprq_tid	;get tid	lda (<R1),y	;from that request	sta cancelrequest+4	;set in can request	list	ldx #cancelrequest	ldy #^cancelrequest	jsl >RamDispatch	;do the cancel	rts	ENDP