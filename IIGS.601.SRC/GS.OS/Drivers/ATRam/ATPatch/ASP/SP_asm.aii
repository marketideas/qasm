;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------** sp.asm**   by*       Greg Seitz*       3-Jun-87** this file is responsible for installing asp into the command * dispatcher and doing any neccessary initialization stuff*	EXPORT spinstallspinstall	PROCrealinstall		; 	clc	;force native	xce	phb	phk	;data is in same bank as code	plb	sep #mbit+xbit	lda >statereg	pha	;save machine state	lda >lcbank2	lda >lcbank2	;enable lcbank2 for	writing	rep #mbit+xbit	longa on	longi on	lda >softreset	;get the current reset vector	sta oldreset	;and store internally	lda >softreset+2	sta oldreset+2	;now we have the old vector	lda callreset	;store a jml ourreset	sta >softreset	;into vector	lda callreset+2	sta >softreset+2	jsr spinit	;zero out stuff	ldx #ourcmds	;get our command table	ldy #$d600+($1c*4)	;table starts at $d600	lda #endcmds-ourcmds-1 ;move this many bytes	mvn ourcmds,$e10000	;to bank $e1	sep #mbit+xbit	pla	;get statereg	sta >statereg	rep #mbit+xbit	plb	rtlcallreset	jml ourreset	;this code is moved	to vector	EXPORT spinitspinit		;       	lda <R1	;save zero page	sta saver1	stz wss	;no work station socket yet	stz wascancelled	;clear semaphore flag	ldx #sessiontable	;clear this table out to init state	jsr zerotable	ldx #statustable	jsr zerotable	lda saver1	sta <R1	;restore zero page	rtszerotable		; 	stx <R1	;use for zp pointer	ldy #0002	;point to first itemzitem	lda (<R1),y	;get flag item 	cmp #endtable	;see if we are done	beq zerodone	lda #0000	sta (<R1),y	;zero hi word out (leave low word intact)	iny	iny	iny	iny	bra zitem	;keep loopingzerodone	rtsourcmds		; 	DC.A cspgetparms	;$1c	DC.B spzplen	DC.A cspgetstatus	;$1d	DC.B spzplen	DC.A cspopensession	;$1e	DC.B spzplen	DC.A cspclose	;$1f	DC.B spzplen	DC.A cspcommand	;$20	DC.B spzplen	DC.A cspwrite	;$21	DC.B spzplenendcmds		; 	EXPORT ourresetourreset		;       ;should come here during reset	php	;save mode bits	phb	;and databank	jsl oldreset	;let lower protocol	get called first	phk	;set up data bank	plb	jsr spinit	;and re-init pap	plb	;restore bank	plp	;and mode bits	rtl	;and return to our caller	EXPORT oldresetoldreset		;       ;this code gets old reset vector	jml $000000	;dummy code	ENDP