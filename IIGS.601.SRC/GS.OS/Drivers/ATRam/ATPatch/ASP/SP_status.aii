;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------** sp_status**   by*       Greg Seitz*       3-Jun-87** this file contains the status routines and the get parms routine*;; 16-May-91 MSD	SPGetStatus fixed to return a buffer error ($0705);	instead of a size error ($0704) when the user's;	reply buffer was too small.;;  7-Oct-91 MSD	Now allows sync only.;	import CheckAsync	; 7-Oct-91 MSD	EXPORT cspgetparmscspgetparms	PROC	longa on	longi on	jsr CheckAsync	; 7-Oct-91 MSD		jsr sp_setup	;set everything up	ldy #0004	;move to max command size field	lda #maxcmdsize	;get max command size	sta [<cmdlist],y	iny	iny	;move to max data size field	lda #quantumsize	sta [<cmdlist],y	;and save it	lda #spnoerr	brl accumexit	;exit from there	EXPORT sp_setupsp_setup		;       	rep #mbit+xbit	jsl >ramforbid	;forbid atalk related events	phk	;make data bank the	same	plb	;as the code bank	rts	EXPORT exitcompexitcomp		;       	jsl >ramforbid	;offset permit in accumexit	bra accumexit	;and leave through there	EXPORT asyncexitasyncexit		;       	rep #mbit+xbit	longa on	longi on	lda #spbusy	;get spbusy flag	EXPORT accumexitaccumexit		;       ;exit with what's in accum	rep #mbit+xbit	longa on	longi on	ldy #spstat_result	;get offset to result	sta [<cmdlist],y	;and save it	jsl >RamPermit	;back down ints	sep #mbit+xbit	longa off	longi off	ora #00	;see if done	bpl chkiocmp	;yepgoback		; 	rep #mbit+xbit	rtl	;otherwise just exit	EXPORT chkiocmpchkiocmp		;       	sep #mbit+xbit	longa off	longi off	lda [<cmdlist]	;see what type of command	bpl goback	;sync so exit	ldy #spstat_result	lda [<cmdlist],y	;get result	bmi goback	;still busy	ldy #spstat_iocomp	;offset to completion	EXPORT callcompcallcomp		;       	rep #mbit+xbit	longa on	longi on	lda [<cmdlist],y	;get low word completion	sta <execaddr	iny	iny	lda [<cmdlist],y	;get high word completio`	sta <execaddr+2	ora <execaddr	;see if zero	beq goback	;yep, so nothing to	call	jmp >RamGoComp	;call completion routine	EXPORT cspgetstatuscspgetstatus		;       	longa on	longi on	jsr sp_setup	ldx #statustable	;find free item in this table	jsr findfree	;go do it	bcc gotone	;item good, ptr in x	lda #sptoomany	;too many calls at one time	brl accumexit	;leave with this error codegotone		; ;got good table entry ptr in x	stx <R0	;save pointer to table entry	lda #iteminuse	;mark item as in use	ldy #0002	;move to marker position	sta (<R0),y	lda (<R0)	;now get pointer to	request parms	sta <R0	;and save it	ldy #rqusercmdlist	;offset to storage location of cmdlist ptr	lda <cmdlist	sta (<R0),y	iny	iny	lda <cmdlist+2	sta (<R0),y	;now users command list is tied to request	ldx <R0	;pass parmlist start in x	jsr movenetinfo	;move the network info into parmlist in	x	ldy #spstat_buflen	;provide offset to buffer len field	ldx <R0	;address of parmlist	jsr setreplybuf	;set up rbds in parmlist request	lda #spbusy	ldy #spopen_result	;offset to result	sta [cmdlist],y	;and show that we are busy	ldx <R0	ldy #^spbank	;get bank in y reg	jsl >RamDispatch	jml >RamPermit	;back down ints and	exit	EXPORT statuscompstatuscomp		;       	pei <R0	;save zero page usage	lda <cmdlist	;save our list pointer	sta <R0	;in R0	ldy #rqusercmdlist	;offset to storage location of cmdlist ptr	lda [<cmdlist],y	;get users cmdlist	pha	iny	iny	lda [<cmdlist],y	sta <cmdlist+2	pla	sta <cmdlist	;now has users cmdlist	lda #0000	;set return length to zero at first	ldy #spstat_datalen	sta [<cmdlist],y	ldy #spstat_result	;offset to result field	lda (<R0),y	;get result of request call	cmp #requestfail	;see if request failed	bne notbadyet	lda #spnoresponse	;get no response error	bra exiterr	;exit and store errornotbadyet		; 	cmp #0000	;see if no error	beq goodrequest	;the request was successful	lda #spneterr	;unknown error	bra exiterrgoodrequest		; 	ldx <R0	;pass rqlist	jsr findbdslen	;finds total len of	bds	ldy #spstat_datalen	sta [<cmdlist],y	;store the length	lda #spbuffererr	;assume buffer size error (16-May-91 MSD)	bcs exiterr	;there was an error	lda #spnoerr	;no error, fall throughexiterr		; 	tax	;save error result	ldy #rqtableoffset	;get table entry address	lda (<R0),y	sta <R0	;use this since we are almost done	ldy #0002	;offset to flag field	lda #itemfree	;show item as available	sta (<R0),y	pla	sta <R0	;restore zero page	txa	;get error code	brl exitcomp	;and exit with it** findbdslen - figures the length of a response by adding up the*              bds's actlen fields.* x - pointer to request parmlist* returns a - actual length* errors - carry set if length error*	EXPORT findbdslenfindbdslen		;       	pei <R0	pei <R1	;save off zp useage	pei <R2	;	stx <R0	;use for rq parmlist	ldy #atprq_rbdsad	lda (<R0),y	;get buffer address	sta <R1	;point to bds	ldy #atprq_response	lda (<R0),y	and #$00ff	;mask off insignificant stuff	tax	;hold in x, number of buffers received	stz <R2	;zero off working lenlenlp		; 	ldy #bds_actlen	lda (<R1),y	;get len of item	bmi addlasterr	;we have an error, but add amount received	clc	adc <R2	;add to running total	sta <R2	clc	lda <R1	adc #bds_actlen+2	;move to next bds	sta <R1	dex	;decrement packet count	bne lenlp	;keep going while >	0	clc	;no error	bra findbdslenexit	;and leaveaddlasterr		; 	and #$7fff	;strip high bit	clc	adc <R2	sta <R2	sec	;show there was a len error             findbdslenexit		; 	lda <R2	;exit with len in A	plx	stx <R2	plx	stx <R1	plx	stx <R0	rts** findfree-* x = table address	to find free entry in* returns address of entry in x. Carry is set* if a free item can not be found.* return table offset number in a (first item is number 1)*	EXPORT findfreefindfree		;       	pei <R0	;save zero page usage	pei <R1	stx <R0	stz <R1	;start out at zero	ldy #0002	;look at high word of each entryfreelp		; 	inc <R1	;bump index number (always at least 1)	lda (<R0),y	;get flag field	beq freefound	cmp #endtable	;see if end of table reached	beq freenotfound	;no free item found	clc	lda <R0	adc #0004	;skip to next item	sta <R0	bra freelp	;keep loopingfreefound		; 	clc	;no error	ldx <R0	;get result	bra freeexitfreenotfound		; 	sec	;indicate errorfreeexit		; 	lda <R1	;get index number	ply	sty <R1	ply	;recover zero page usage	sty <R0	rts** movenetinfo - moves network info from	cmdlist to parmlist* x = parmlist to store into* cmdlist = users command list* returns nothing*	EXPORT movenetinfomovenetinfo		;       	pei <R0	;save zero page usage	stx <R0	ldy #spstat_slsnet	;get offset to net field in cmdlist	lda [<cmdlist],y	;get net	pha	;and save	iny	iny	;move to node and socket field	lda [<cmdlist],y	;get those	ldy #atprq_dnode	;get offset to node	field in parmlist	sta (<R0),y	;store it	dey	dey	;back up to net field	pla	;recover net number	sta (<R0),y	pla	;recover zp	sta <R0	rts** setreplybuf - sets up rbds of request	pointed to by x based on*               users data buffer length in their cmdlist* x = points to request parmlist* y = gives offset in cmdlist to len field* cmdlist = users command list** destroys R2 and next zp locations	EXPORT setreplybufsetreplybuf		;       	pei <R0	;save zero page usage	pei <R1	stx <R0	;save parmlist	phy	;save offset for a moment	ldy #atprq_rbdsad	;get offset to rbds	in parmlist	lda (<R0),y	;get address	sta <R1	;and use R1 for rbds pointer	ply	;recover offset	lda [<cmdlist],y	;get buffer length	sta <R2	;save in R2	iny	iny	;move to buffer address field	lda [<cmdlist],y	;get low word	sta <next	iny	iny	lda [<cmdlist],y	;get high word	sta <next+2	;next has address of buffer to use	stz <R2+2	;store number of buffers built heresetrplylp		; 	lda <R2+2	;get num of bufs	inc a	;bump by 1	cmp #0009	;see if too many	beq setrplydone	;we are done setting buffs	sta <R2+2	;save new value	sec	;set up for subtract	lda <R2	;get remaining length	sbc #maxcmdsize	;reduce by 1 quantum	bmi storelast	;went negative, so do last store	sta <R2	;save new len=len-maxcmdsize	lda #maxcmdsize	;buffer should be this size	sta (<R1)	;store in bds	ldy #bds_bufptr	;get offset to buf pointer field	clc	lda <next	;get buffer address	to use	sta (<R1),y	adc #maxcmdsize	;add in amount to move buffer	sta <next	iny	iny	lda <next+2	;do high word	sta (<R1),y	adc #^maxcmdsize	;add high word of cmdsize	sta <next+2	clc	lda <R1	;bump this to next rbds entry	adc #bds_actlen+2	sta <R1	bra setrplylp	;keep loopingstorelast		; 	lda <R2	;get len of last packet	sta (<R1)	;and save in len field	ldy #bds_bufptr	;get offset to buf pointer field	lda <next	;get buffer address	to use	sta (<R1),y	;save it	iny	iny	lda <next+2	sta (<R1),ysetrplydone		; 	lda <R2+2	;get number of buffers	ldy #atprq_rbnum	;offset to number of bufs field in rq	php	sep #mbit	sta (<R0),y	;store it in 8 bit mode	tax	;use as index to get bitmap value	lda bitmaptable,x	;get it	ldy #atprq_bitmap	sta (<R0),y	;store bitmap in 8 bit mode	plp	pla	sta <R1	pla	sta <R0	rtsbitmaptable		; 	DC.B $00,$01,$03,$07,$0f,$1f,$3f,$7f,$ff	ENDP