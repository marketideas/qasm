;-----------------------------------------------** sp_write**   by*   Greg Seitz*   9-jun-87** this is the write	module for asp.  It	sends asp writes.** 16-May-91  MSD	SPWrite now returns BufferError ($0705) instead of*	SizeError ($0704) when the user's reply buffer isn't*	big enough to hold the actual reply.*	EXPORT cspwritecspwrite	PROC	longa on	longi on	jsr sp_setup	;set everything up	ldy #spwrt_sref	lda [<cmdlist],y	;get session number	and #$00ff	;strip high byte junk	jsr sessionmatch	;see if session number is valid	bcc goodsession	;the session is good	lda #spbadrefnum	;bad reference number	brl accumexit	;leave with errorgoodsession		; 	sta <R1	;save session rec ptr in r1	ldy #srec_wcmdlist	lda (<R1),y	;see if command in progress	iny	iny	ora (<R1),y	;make sure both zero	beq goodsession1	;session still good	lda #sptoomany	;too many command calls	brl accumexitgoodsession1		;	ldy #spwrt_wrtlen	;check length of data they want to write	lda [cmdlist],y	cmp #quantumsize+1	;see if beyond legal range	bcs wrtsizeerr	;yes, so exit with error	ldy #spwrt_writtenlen	lda #0000	sta [cmdlist],y	;in case we don't get to write any	ldy #srec_wreq	lda (<R1),y	;get wrequest list	sta <R0	tax	lda <R1	;get session rec	jsr setrequestbuf	;set up request buffer data & seq num	bcc lenok	;length was goodwrtsizeerr		;	lda #spsizeerr	brl accumexit	;exit with errorlenok		; 	ldy #srec_wcmdlist	lda <cmdlist	sta (<R1),y	;save users write command list	iny	iny	lda <cmdlist+2	sta (<R1),y	ldy #spwrt_rbuflen	;offset to len field in cmdlist	ldx <R0	;wrtrequest parmlist ptr	jsr setreplybuf	;set up reply bds	lda #spbusy	ldy #spopen_result	;offset to result	sta [cmdlist],y	;and show that we are busy	ldx <R0	;call atalk with request	ldy #^spbank	jsl >RamDispatch	;make the call	jml >RamPermit	;back down ints and	exit	EXPORT writecompwritecomp		;       	pei <R0	pei <R1	lda <cmdlist	sta <R0	;points to parmlist	ldy #rqtableoffset	lda (<R0),y	;get sessionrec ptr	sta <R1	;and save it	ldy #srec_wcmdlist	lda (<R1),y	;get users cmdlist	sta <cmdlist	lda #0000	sta (<R1),y	;clear out entry in	srec	iny	iny	lda (<R1),y	;get high word	sta <cmdlist+2	lda #0000	sta (<R1),y	;clear out high word to release cmd	ldy #srec_wreply	lda (<R1),y	;get reply parm	clc	adc #8	;move from rsp skt field	ldx #relparm+4	;move data to here	ldy #7	;move 7 bytes	jsr movemem	;move it	ldx #relparm	ldy #^relparm	;free up any rspcb that might be there	jsl >RamDispatch	ldy #atprq_result	;get offset to result	lda (<R0),y	;get result of atprequest	cmp #reqabort	;request was aborted by close	bne notfail	;nope	lda #spclosed	;connection has closed	brl cmderrexit	;exit with this errornotfail		; 	cmp #spnoerr	;see if no error occurred	beq goodcmd	;it was good	ldy #rqtableoffset	lda (<R0),y	;get sessionrec ptr	sta <R1	;and save it	ldy #srec_seqnum	;get sequence number field	lda (<R1),y	;get sequence number	dec a	;put it back the way it was	sta (<R1),y	;save it 	lda #spneterr	;unexpected error	brl cmderrexitgoodcmd		; 	ldx <R1	;point to srec	jsr resettime	;reset timeout	ldx <R0	;pointer to atprequest	ldy #spwrt_cmdresult ;offset to cmdresult field	jsr setcmdresult	;set the cmdresult for user	ldx <R0	;pointer to atprequest	jsr findbdslen	;calculate len of bds	ldy #spwrt_replylen	sta [<cmdlist],y	;set len for user	lda #spbuffererr	;assume buffer error	bcs cmderrexit	;exit with err in a	lda #spnoerr	;no errorcmderrexit		; 	tax	pla	sta <R1	pla	sta <R0	txa	brl exitcomp	;set error and exit;set error and exit	ENDP