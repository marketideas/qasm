** sp_cmd**   by*   Greg Seitz*   9-jun-87** this is the command module for asp.  It sends asp commands.**	EXPORT cspcommandcspcommand	PROC	longa on	longi on	jsr sp_setup	;set everything up	ldy #spcmd_sref	lda [<cmdlist],y	;get session number	and #$00ff	;strip high byte junk	jsr sessionmatch	;see if session number is valid	bcc goodsession	;the session is good	lda #spbadrefnum	;bad reference number	brl accumexit	;leave with errorgoodsession		; 	sta <R1	;save session rec ptr in r1	ldy #srec_cmdcmdlist	lda (<R1),y	;see if command in progress	iny	iny	ora (<R1),y	;make sure both zero	beq goodsession1	;session still good	lda #sptoomany	;too many command calls	brl accumexitgoodsession1		; 	ldy #srec_cmdreq	lda (<R1),y	;get cmdrequest list	sta <R0	tax	lda <R1	;get session rec	jsr setrequestbuf	;set up request buffer data	bcc lenok	;length was good	lda #spsizeerr	brl accumexit	;exit with errorlenok		; 	ldy #srec_cmdcmdlist	lda <cmdlist	sta (<R1),y	;save users command	list	iny	iny	lda <cmdlist+2	sta (<R1),y	ldy #spcmd_rbuflen	;offset to len field in cmdlist	ldx <R0	;cmdrequest parmlist ptr	jsr setreplybuf	;set up reply bds	lda #spbusy	ldy #spopen_result	;offset to result	sta [cmdlist],y	;and show that we are busy	ldx <R0	;call atalk with request	ldy #^spbank	jsl >RamDispatch	;make the call	jml >RamPermit	;back down ints and	exit	EXPORT cmdcompcmdcomp		;       ;completion	routine for above	pei <R0	pei <R1	lda <cmdlist	sta <R0	;points to parmlist	ldy #rqtableoffset	lda (<R0),y	;get sessionrec ptr	sta <R1	;and save it	ldy #srec_cmdcmdlist	lda (<R1),y	;get users cmdlist	sta <cmdlist	lda #0000	sta (<R1),y	;clear out entry in	srec	iny	iny	lda (<R1),y	;get high word	sta <cmdlist+2	lda #0000	sta (<R1),y	;clear out high word to release cmd	ldy #atprq_result	;get offset to result	lda (<R0),y	;get result of atprequest	cmp #reqabort	;request was aborted by close	bne notfail	;nope	lda #spclosed	;connection has closed	brl cmderrexit	;exit with this errornotfail		; 	cmp #spnoerr	;see if no error occurred	beq goodcmd	;it was good	ldy #rqtableoffset	lda (<R0),y	;get sessionrec ptr	sta <R1	;and save it	ldy #srec_seqnum	;get sequence number field	lda (<R1),y	;get sequence number	dec a	;put it back the way it was	sta (<R1),y	;save it 	lda #spneterr	;unexpected error	brl cmderrexitgoodcmd		; 	ldx <R1	;point to srec	jsr resettime	;reset timeout timer	ldx <R0	;pointer to atprequest	ldy #spcmd_cmdresult ;offset to cmdresult field	jsr setcmdresult	;set the cmdresult for user	ldx <R0	;pointer to atprequest	jsr findbdslen	;calculate len of bds	ldy #spcmd_replylen	sta [<cmdlist],y	;set len for user	lda #spsizeerr	;assume size error	bcs cmderrexit	;exit with err in a	lda #spnoerr	;no errorcmderrexit		; 	tax	;save error code	pla	sta <R1	pla	sta <R0	txa	brl exitcomp	;set error and exit** setcmdresult - sets result field in users command list* x = pointer to atprequest* y = offset to cmdresult field in cmdlist* cmdlist = users cmdlist pointer*	EXPORT setcmdresultsetcmdresult		;       	pei <R0	stx <R0	;save request pointer	phy	;save offset	ldy #atprq_rbdsad	lda (<R0),y	;get address of bds	sta <R0	ldy #bds_user+2	;get result	lda (<R0),y	tax	;hold high word in x	dey	dey	lda (<R0),y	;get low word	ply	;recover offset	sta [<cmdlist],y	;store low word in users cmdlist	iny	iny	txa	;get high word	sta [<cmdlist],y	;store high word in	users cmdlist	pla	sta <R0	rts** setrequestbuf* sets the request parmlists data to send and also sets the* sequence number, and increments it.** x = pointer to request parmlist* a = pointer to session rec* cmdlist = users command list** returns carry set	if there was a size	error (too big)*	EXPORT setrequestbufsetrequestbuf		;       	pei <R0	pei <R1	stx <R0	;point to parmlist	sta <R1	;point to srec	ldy #spcmd_cmdlen	lda [<cmdlist],y	;get len user wants	to set	cmp #maxcmdsize+1	bcs exitsetrq	;exit with error (c	is set)	ldy #atprq_bufsize	sta (<R0),y	;save size	ldy #spcmd_cmdadr	lda [<cmdlist],y	pha	iny	iny	lda [<cmdlist],y	;get high word of command buf	ldy #atprq_bufptr+2	sta (<R0),y	dey	dey	pla	sta (<R0),y	;save command buf in request list	ldy #srec_seqnum	;get sequence number field	lda (<R1),y	;get sequence number	inc a	;increment it	sta (<R1),y	;save it 	ldy #atprq_user+2	;move to sequence num field	xba	;put in mac format	sta (<R0),y	;save in atprequest	parmlist	clcexitsetrq		; 	pla	sta <R1	pla	sta <R0	rts	ENDP