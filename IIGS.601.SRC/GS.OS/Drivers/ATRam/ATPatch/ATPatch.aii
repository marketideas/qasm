********************************************************************************* File: ATPATCH** This file contains the 65816 implementation of EP for the Apple IIGS.** ATPATCH was originally responsible for loading ATINIT under prodos 16.* It also contained all the patches for the ROM code.** Copyright Apple Computer, 1986* Original Author: Greg Seitz*                  11-Jun-87*                  ver 1.3********************************************************************************** Modification History** 6/15/87    par        - lap bug fixes** 6/15/87    gws        - scheduler fixes** 6/15/87    gws        - echo protocol** 6/15/87    gws        - atp bug...need to     make sure we preserve savey between calls*         to atalk. (6/15/87 gws)*** 7/13/87    gws        - Added vector at location $e1103e for dispatches of prodos calls*         to be handled by pfi.  This allows this module to remain seperate*         from pfi.* * 8/26/87    gws        - Replaced DDPWrite     routine in firmware     with ram based routine.*         this was needed to fix a ddp bug where it did not let you     send*         a maximum sized packet.** 9/1/87     gws        - Removed stuff that deals with atinit file and put it in another file*         that can get executed last...This file needs to be executed first *         since it contains     patches.** 8/18/88    TGH        - Started working on changes for the RevD ROM (ROM03)*       - Took out check to see if AppleTalk is on.** 5/25/89    TGH        - Added patch for ROM03 init.**  1-Mar-90  MSD        - Added patch to intercept setting of the real time clock,*         so that startcount can be adjusted.** 22-Oct-90  MSD        - Fixed the above patch for the real time clock.  Interrupts*         must be disabled the entire time or else an interrupt could*         happen after the clock is changed, but before the global*         "startcount" is updated, causing the system to think more*         time has gone by.** 13-Dec-90 MSD Added a "tail patch" to the GetInfo call to change the returned*       version to 2.0 ($200D).  Also, leaving interrupts off while we*       patch the RESET vector.** 13-Dec-90 MSD Added the GetInfo2 call ($3B).** 06-Feb-91 MSD Removed the version number patch and the GetInfo2 call*       (13-Dec-90 changes) since System Disk 6.0 won't have these features.** 24-Jun-91 MSD Put AppleTalk Phase II stuff back.** 28-Jun-91 MSD Temporarily removed ROM 03 patch of Init call since it*       interferes with getting the ATP1.ATROM file loaded and*       initialized.  Changed version to $2002.*******************************************************************************		MACHINE	M65816		PRINT	GENHardReset	equ	$ff1c06		;If we move in ROM,     this will change.atalkcardon	equ	$e102e7		;Magic location that is zero if we are on					;this isn't true anymore  **TGH; Below are some equates for the new init patch for ROM03ATInitVector	equ	$E1D604		;Address for init vector callATGetInfoVect	equ	$E1D608		;Address for GetInfo callATGetInfo2Vec	equ	$E1D6EC		;Address for GetInfo2 call ($3B)GetInfoVersion	equ	$2002		; version 2.00 d1jresetcode	equ	$FDF064		;Vector for control-resetstartcount	equ	$E1DE6A		;Address of 1/4 second timeContInit	equ	$FDF051		;Vector into ROM03 init codeToWriteTime	equ	$E10088		;vector to set real time clockCLKWDATA	equ	$E103E5		;time in seconds during WriteTime		IMPORT	papinstall		IMPORT	rpmSinstall		IMPORT	zipinstall		IMPORT	spinstall		ENTRY	echoinstall		ENTRY	patches		INCLUDE	':ASP:global.equates.inc';       INCLUDE ':ASP:atp.equates.inc'ATPATCHInit	PROC	EXPORT		rep	#$30		;full native		longa	on		longi	on		phb			;save data bank		phk			;set data bank to code		plb		stx	RomVers		sty	AtalkSlot		lda	>$86		;save some zero page		pha		lda	>$84		pha		sep	#mbit+xbit	;go to 8 bit mode		longa	off		longi	off		lda	statereg	;get previous state		pha			;and save it		lda	lcbank2		;switch in correct bank		lda	lcbank2** We don't check to see if AppleTalk is on because the AppleTalk supervisory* driver wouldn't have loaded us if it wasn't.**       lda >atalkcardon        ;see if appletalk card active*       bne exitinstall ;not active so don't install stuff*** Call HardReset to     initialize ATalk variables (we're essentially rebooting).**       jsl     HardReset       ;REMEMBER to change this if ROM changes.** NOTE: if we put the code that was in rom back into rom we should make the* above call.  Currently however, we do not need it since an equivalent call* is made when the a2gsrom file is loaded.** We don't have to call the above HardReset with the new ROMs because this* file can never be loaded if the ROMs were not reset first.*		rep	#mbit+xbit	;ok they want code installed		longa	on		longi	on		lda	#0000		sta	>pfivec		sta	>pfivec+2	;pfi not installed yet		jsr	PatchInit	;Patch init code for 03 ROMs		ldx	#initparms	;do init before any     patches		ldy	#^initparms		jsl	>RamDispatch		ldx	RomVers		ldy	AtalkSlot		jsr	patches		;install patches first		ldx	RomVers		ldy	AtalkSlot		jsl	zipinstall	;install zip protocol		ldx	RomVers		ldy	AtalkSlot		jsl	papinstall	;install pap code		ldx	RomVers		ldy	AtalkSlot		jsl	rpmSinstall	;and rpm code		ldx	RomVers		ldy	AtalkSlot		jsl	echoinstall	;install echo protocol		ldx	RomVers		ldy	AtalkSlot		jsl	spinstall	;install asp protocolexitinstall	sep	#mbit+xbit		longa	off		longi	off		pla			;recover state reg		sta	statereg		rep	#mbit+xbit		longa	on		longi	on		pla			;restore zero page		sta	>$84		pla		sta	>$86		plb			;recover data bank		rtl			;and exit.PatchInit		rts			; %%% Temporarily bypass		lda	RomVers		;Are we running on 03 ROMs?		cmp	#$0003		bne	@PatchDone		lda	#NewInit		sta	>ATInitVector		lda	#^NewInit		sta	>ATInitVector+2@PatchDone	rtsNewInit* assume our reset is always first installed, so it can be* in rom, since it need not know who it should call		lda	>jresetcode	;$5c+(resetcode<<8)       ;put jml to resetcode		sta	softreset	;routine into the vector		lda	>jresetcode+2		sta	softreset+2; Below is the code we're trying to patch out;;       php;       sei     ;don't want to be interrupted in here;       pea $0000       ;push space for result of readtime;       pea $0000       ;push space for result of readtime;       pea $0000       ;push space for result of readtime;       pea $0000       ;push space for result of readtime;       ldx #$0d03      ;call readtimehex;       jsl >$e10000;       pla     ;get seconds and minutes;       plx;       plx;       plx     ;discard other stuff;       and #$00ff      ;just want number of seconds;       sta startcount  ;initialize for 1/4     sec irq routine;       plp     ;restore state; Below is the code we're patching it with		php			;This routine is cheaper		sei		sep	#$30		;in cycles than the above routine.		jsl	>$E1008C	; 3/6/89  *** TGH		longa	on		longi	on		rep	#mbit+xbit		lda	>$E103E1		and	#$00FF;       sta startcount;       plp     ;Restore interupts		pha		ldx	#$F2D9		;iparmstart     ;init parms start		ldy	#$DE3D		;rparmstart     ;ram parm start		lda	#$000C		;(iend-iparmstart)-1 ;length of initialized data		mvn	$FD0000,$E10000	;main,databank  ;from rom to ram		sep	#mbit+xbit		longa	off		longi	off		;8 bit x,a		lda	#00		;clear them bytes		ldy	#$24		;savecnt        ;number of bytes to     clearclre1lp					; 		sta	$DE49,y		;initsec-1,y    ;clear bytes in $e1		dey		bne	clre1lp		longa	on		longi	on		rep	#mbit+xbit+cbit		pla		sta	startcount		plp			;Restore interupts		jmp	>ContInit	;FDF051initparms	DC.B	$00,$01,$00,$00	;open the drivers		DC.B	$C0ProEntPt	DC.B	$00,$00,$00,$00	;past junk		DC.B	$00		;pick a node, any node		DC.B	$00,$00RomVers		dc.w	0		;ROM versionAtalkSlot	dc.w	0		;AppleTalk slot number		ENDP; Below we used to install any patches for the ROM, but now we just put; ourselves in the reset chain so we can re-install the EP after reset.;;  1-Mar-90 (MSD):      Added patch to intercept ToWriteTime on all ROMs.; 13-Dec-90 (MSD):      Added patch to GetInfo so it returns version 2.0.;       Also install command handler for GetInfo2 ($3B).patches		PROC		import	GetInfo2		sep	#mbit+xbit		longa	off		longi	off		lda	>statereg	; save language card state		pha		lda	>lcbank2	; force bank 2 to patch AppleTalk vars		lda	>lcbank2	; make it writable		rep	#mbit+Xbit		longa	on		longi	on		php		sei			;no interrupts while I mess with vectors!		lda	>ToWriteTime	;save original vector		sta	jToWriteTime		lda	>ToWriteTime+2		sta	jToWriteTime+2		lda	jMyWriteTime	;put my vector in		sta	>ToWriteTime		lda	jMyWriteTime+2		sta	>ToWriteTime+2		lda	softreset	;get the current reset vector		sta	proldreset	;and store internally		lda	softreset+2		sta	proldreset+2	;now we have the old vector		lda	jpatchesreset	;store a jml ourreset		sta	softreset	;into vector		lda	jpatchesreset+2		sta	softreset+2		plp			;restore interrupts		lda	ATGetInfoVect	; get original routine's address, low word		sta	NewGetInfo+1	; patch into JSL		lda	ATGetInfoVect+1	; middle word		sta	NewGetInfo+2	; patch rest of JSL		lda	#<NewGetInfo	; low word		sta	ATGetInfoVect		lda	#>NewGetInfo	; middle word		sta	ATGetInfoVect+1		lda	#<GetInfo2	; low word of address		sta	ATGetInfo2Vec		lda	#^GetInfo2	; high word of address and zero bytes to save		sta	ATGetInfo2Vec+2		sep	#mbit+xbit		longa	off		longi	off		pla		sta	>statereg	; restore language card state		rep	#mbit+xbit		longa	on		longi	on		rtsjpatchesreset	jml	patchesresetpatchesreset				; ;should come here     during reset		php			;save mode bits		phb			;and databank		jsl	proldreset	;let lower protocol     get called first		phk			;set up data bank		plb		jsl	echoinstall	;re-install echo code		plb			;restore bank		plp			;and mode bits		rtl			;and return to our callerproldreset				; ;this code gets old reset vector		jml	$000000		;dummy code;; 13-Dec-90 MSD: This is the "tail patch" to the GetInfo call that changes; the version number it returns after it has been handled by the normal; GetInfo code.;NewGetInfo		jsl	$000000		; do original routine first		ldy	#$C		; offset to version number in PB		lda	#GetInfoVersion	; get the new version		sta	[cmdlist],y	; update version		rtl			; return to dispatcher;; This is the ToWriteTime patch.  First, it calls the original vector.; Then it takes the low byte of the seconds at CLKWDATA and saves it; in startcount so that the 1/4 second handler knows the real time has; changed (and won't fire off all the timers).;jToWriteTime	jml	$000000		; original ToWriteTime goes herejMyWriteTime	jml	MyWriteTimeMyWriteTime		longa	off		; entered in 8-bit native mode		longi	off		php			; save interrupt state		sei			; disable interrupts		jsl	jToWriteTime	; call original WriteTime routine		bcs	WriteTimeErr	; skip it if time couldn't be written		lda	>CLKWDATA	; get low byte of seconds		sta	>startcount	; update AppleTalk's last known real time		plp			; restore interrupts		clc			; no error		rtl			; return to caller (carry clear)WriteTimeErr		plp			; restore interrupts		sec			; error		rtl			; return to caller (carry unchanged)		longa	on		longi	on		ENDP;-------------------------------------------------------------------------------; GetInfo2;; Returns information about extended networks.;-------------------------------------------------------------------------------GetInfo2	proc	export		import	CheckAsync		thisNet		equ	$E1D010		; this network number in globalsourNode		equ	$E11095		; source node number in globalsaBridge		equ	$E1D013		; a bridge number in globalsourLink		equ	1		; 1=LocalTalkbadVersion	equ	$0108		; unsupported version requestedbufTooSmall	equ	$0107		; buffer was too small to return requested datapb		record	0async		ds.b	1		; must be $00command		ds.b	1		; = $3Bresult		ds.w	1reqVersion	ds.w	1		; only version 1 defined (input)flags		ds.l	1		; currently unusednetLow		ds.w	1		; network range low (68000 order)netHigh		ds.w	1		; network range high (68000 order)ourAddr		ds.l	1		; this node's internet addressaRouter		ds.l	1		; internet address of some routerlinkType	ds.w	1		; 1=LocalTalk, 2=EthernetlinkLength	ds.w	1		; length of buffer to return physical addresslinkBuffer	ds.l	1		; address of buffer to return physical addresslinkActLen	ds.w	1		; actual length of link address		endrdp		record	$80cmdlist		ds.l	1		; pointer to our parameter blockgoCompAddr				; normally for jumping to completion routineslink		ds.l	1		; but we'll use it to point to link buffer		endr		jsr	CheckAsync				jsl	RamForbid	; don't interrupt us;; Make sure requested version 1 of info;		ldy	#pb.reqVersion		lda	[cmdlist],y	; get requested version		cmp	#1		; only version 1 defined		beq	vers1		; continue		lda	#badVersion	; asked for unsupported version		bra	exit		; return the errorvers1;; Return a long of all zeros in flags;		lda	#0		; no flags defined yet		iny		iny			; Y = pb.flags		sta	[cmdlist],y	; zero low word of flags		iny		iny		sta	[cmdlist],y	; zero high word of flags;; return thisNet as both ends of our network number range, network; of ourAddr, network of aRouter.;		lda	thisnet		; get our network number		iny		iny			; Y = pb.netLow		sta	[cmdlist],y	; save as netLow		iny		iny			; Y = pb.netHigh		sta	[cmdlist],y	; save as netHigh		iny		iny			; Y = pb.ourAddr		sta	[cmdlist],y	; save as our node's network number;; return address of a router;		ldy	#pb.aRouter		sta	[cmdlist],y	; save as network number of router		iny		iny			; Y points to node number in aRouter		lda	aBridge		; get router's node number		and	#$00FF		; low byte only		sta	[cmdlist],y	; fill in node of aRouter;; return our address;		ldy	#pb.ourAddr+2	; point to our node number		lda	ourNode		and	#$00FF		; low byte only		sta	[cmdlist],y	; return it;; return our link type;		ldy	#pb.linkType		lda	#ourLink	; get our type of link		sta	[cmdlist],y	; return it;; return the length of our link address;		ldy	#pb.linkActLen		lda	#1		; our link address is only 1 byte		sta	[cmdlist],y	; return it;; see if they want the link address (our node number) returned;		ldy	#pb.linkBuffer		lda	[cmdlist],y	; get low byte of link buffer pointer		sta	dp.link		; save on zero page		iny		iny		lda	[cmdlist],y	; get high byte		sta	dp.link+2	; save high on zero page		ora	dp.link		; was pointer zero (no link address wanted)?		beq	exit		; zero, so complete with no error		ldy	#pb.linkLength		lda	[cmdlist],y	; get size of their buffer		bne	OKBufSize	; anything non zero is big enough		lda	#bufTooSmall	; buffer not big enough		bra	exit		; return the errorOKBufSize		sep	#$20		; short A to move a byte		longa	off		lda	ourNode		; our link address is our node number		sta	[dp.link]	; put in first byte of buffer		rep	#$20		; back to full native		longa	on		lda	#0		; call is done, no errorexit					; Here, error code is in A!		ldy	#pb.result		sta	[cmdlist],y	; return result code		jml	RamPermit	; allow interrupts again and return		endp;-------------------------------------------------------------------------------;;       Echo protocol code;;-------------------------------------------------------------------------------echoinstall	PROC		ldx	#eopenskt	;open echo socket		ldy	#^eopenskt		jsl	>RamDispatch		rtlecholisten				;		pei	<cmdlist+2	;save byte we destroy		lda	#$00e1		;set high byte of globals		sta	<cmdlist+2	;since cmdlist has address already there		ldy	#$0009		;offset to their net num		lda	[<cmdlist],y	;get it		sta	eddpsend+5	;put in ddp send parms		sep	#mbit		ldy	#$000c		;offset to their node		lda	[<cmdlist],y	;get it		sta	eddpsend+7		ldy	#$000e		;offset to their socket		lda	[<cmdlist],y		sta	eddpsend+8		ldy	#$000f		;offset to ddptype		lda	[<cmdlist],y		sta	theddptype	;save it for later		rep	#mbit		ldx	#edordbuf		ldy	#^edordbuf		jsl	>RamDispatch	;read all the data		lda	edordbuf+$0b	;get amount read		beq	noecho		;nothing to echo		sta	esendbds+6	;set len to send		sep	#mbit		longa	off		lda	theddptype		cmp	#$04		;see if echo type		bne	noecho		lda	ebuf		;see if echo request		cmp	#01		bne	noecho		inc	a		;set as echo reply		sta	ebuf		rep	#mbit		longa	on		ldx	#eddpsend		ldy	#^eddpsend		jsl	>RamDispatch	;send the responsenoecho					; 		rep	#mbit		pla		sta	<cmdlist+2	;restore zero page		rtltheddptype	DS.B	1eopenskt	DC.B	$00,$0b,$00,$00	;ddp open skt		DC.B	4		;echo skt		DC.L	echolisten	;echo socket listenereddpsend	DC.B	$00,$0d,$00,$00	;ddp send datagram		DC.B	0		;checksum flag		DC.W	0		;dest net		DC.B	0		;dest node		DC.B	0		;dest skt		DC.B	4		;source skt (echo)		DC.B	4		;ddp type (echo)		DC.L	esendbds	;echo send bdsesendbds	DS.B	6		;reserved bytes		DC.W	0		;buffer length		DC.L	ebuf		;pointer to buffer to echo		DC.W	$ffff		;end of tableedordbuf	DC.B	$00,$08,$00,$00	;read buf call		DC.W	600		;maximum we can read		DC.L	ebuf		;the echo read buffer		DC.B	1		;purge data after reading		DC.W	0		;actual length of data readebuf		DS.B	600		;maximum we can read		ENDP;-------------------------------------------------------------------------------;; CheckAsync -- Makes sure the async flag is zero (i.e. synchronous).  If not,; it sets the result code to AsyncErr, pops the return address, and does an; RTL to the dispatcher.;;-------------------------------------------------------------------------------CheckAsync	proc	export		lda	[cmdlist]	; get async flag		and	#$00FF		; only a byte		beq	sync		; sync is OK		pla			; pop return address		ldy	#2		; result code offset		lda	#AsyncErr		sta	[cmdlist],y	; update result		rtl			; return to dispatchersync		rts			; return to caller		endp		END