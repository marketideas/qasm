********************************************************************************* File: ATPATCH** This file contains the 65816 implementation of RPM for the Apple IIGS.** ATPATCH was originally responsible for loading ATINIT under prodos 16.* It also contained all the patches for the ROM code.** Copyright Apple Computer, 1986* Original Author: Greg Seitz*                  ??-Nov-86*                  ver 1.2********************************************************************************** NOTE: RPM contains patches for a bug in the appletalk roms.* This bug exists in rev 0 & 1 (and possibly future versions since there* is currently no room to patch the bug	in the rom area).  The bug that* we are fixing is caused when a program is running out of aux memory* using the ALTZP switch.  This causes bank e1 language card area to* sit on top of bank e0 language card area.  Since we have code in bank* $e0 language card	area, whenever an attempt was made to call this code,* it was really calling what was at the	same location in bank $e1.* In order to fix this bug we must have	some code in lower memory $e1/12xx* that first saves the machine state and makes sure the proper bank stuff* is switched in.  This code needs to be called whenever we	dispatch a packet* during interrupts	and whenever someone makes a printing call through RPM.** NOTE: It is always assumed that anyone calling the appletalk dispatcher* directly is calling it with the main stack in use.  (CAN'T USE ALTZP WHEN* CALLING ATALK DIRECTLY)********************************************************************************** Modification History*** v1.2** 4/21/87    gws	- changed WBJ string to %%Include ProcSet 'IWEM'*	  to be compatable with lasershare** v1.3** 8/18/88    TGH	- Started working on changes for the RevD ROM** 11/14/88   TGH    - Added parameter checking to make sure that the timeout*	  value is >= to flush time.**  1/ 6/90   MSD	- Added PMFlushSession call ($48) to cause data to be*	  flushed immediately (great for calling just before*	  you do a PMCloseSession).**  5/16/91   MSD	- If you ask PMSetPrinter to return the selected printer*	  and set any of the other bits in the flag byte, you will*	  get error $0901.**  6/04/91   MSD	- PMSetPrinter now returns error $0904 (invalid buffer count)*	  if you tell it to use zero buffers.**  7-Oct-91 MSD	PMSetPrinter now returns error if made async.********************************************************************************	MACHINE M65816	PRINT GEN	INCLUDE '::ASP:atp.equates.inc'	INCLUDE '::ASP:global.equates.inc'	ENTRY availhd	ENTRY bufferchar	ENTRY closephase	ENTRY conncomp	ENTRY rpmconntimer	ENTRY critflag	ENTRY ctime	ENTRY currbuf;	ENTRY flushphase	; Added 1/6/90 MSD	ENTRY flushtimer	ENTRY ftime	ENTRY getchar	ENTRY idtag	ENTRY installconn	ENTRY installflush	ENTRY myserread	ENTRY myserstat	ENTRY myserwrit	ENTRY nbufs	ENTRY rpmopenflag	ENTRY outhd	ENTRY ovflwch	ENTRY papclose	ENTRY papopen	ENTRY papread	ENTRY papwrite	ENTRY pmsetprinter	ENTRY pmclosesession	ENTRY pmflushsession ;MSD: Added 1/6/90	ENTRY postend	ENTRY poststart	ENTRY prname	ENTRY readavail	ENTRY readbuf	ENTRY readindex	ENTRY rpmflag	ENTRY startopen	ENTRY statbuf	ENTRY writebuf	ENTRY writeindex	ENTRY writeready	ENTRY rpmzerodata	ENTRY rpmzeroend	Import CheckAsync	pmflagerr	equ $0901	;Added 11/14/88  **TGHpmtimeerr	equ $0902	;Added 11/14/88  **TGHpmbufcnterr	equ $0904	; MSD 6/4/91papnoerr	equ $0000paptoomany	equ $0801papnotopen	equ $0802papsessinvalid	equ $0802papnoprinter	equ $0805papconnclosed	equ $0806papneterr	equ $0807papsizeerr	equ $080apapinuse	equ $080bpapbusy	equ $08ffqtrinstall	equ $0480qtrremove	equ $0500qtrcancel	equ $4500senddata	equ 03closeconn	equ 06openwait	equ 08maxconn	equ 120*4	;two minutespstat_async	equ $00pstat_command	equ $01pstat_result	equ $02pstat_iocomp	equ $04pstat_prname	equ $08pstat_statbuf	equ $0cpopen_async	equ $00popen_command	equ $01popen_result	equ $02popen_iocomp	equ $04popen_refnum	equ $08popen_prname	equ $09popen_flowq	equ $0dpopen_statbuf	equ $0epclose_async	equ $00pclose_command	equ $01pclose_result	equ $02pclose_iocomp	equ $04pclose_refnum	equ $08pread_async	equ $00pread_command	equ $01pread_result	equ $02pread_iocomp	equ $04pread_refnum	equ $08pread_buflen	equ $09pread_bufptr	equ $0bpread_eofflag	equ $0fpwrite_async	equ $00pwrite_command	equ $01pwrite_result	equ $02pwrite_iocomp	equ $04pwrite_refnum	equ $08pwrite_blen	equ $09pwrite_bptr	equ $0bpwrite_eofflag	equ $0frpmSInstall	PROC EXPORT	longa on	clc	xce	php	sei	;no interrupts while changing vectors	phb	;save bank	phk	plb	;set bank to code	rep #MBit	stx ROMVers	sty ATalkSlot	lda jmypascal	sta Pascal	lda jmypascal+2	sta Pascal+2	lda jmyserwrit	sta SerWrite	lda jmyserwrit+2	sta SerWrite+2	lda jmyserread	sta SerRead	lda jmyserread+2	sta SerRead+2	lda jmyserstat	sta SerStatus	lda jmyserstat+2	sta SerStatus+2	lda #$6B	sta SerBackgnd	lda Jnewbasic	sta Basic	lda Jnewbasic+2	sta Basic+2;; Below we fix our two vectors for writting to the serial port firmware;	lda RomVers	cmp #0002	bcs ROM2	cmp #0001	beq ROM1ROM0	lda #$004B	sta QsetupPatch+1	lda #$034B	sta QpascalPatch+1	lda #$FF4B	bra DoneROMCheckROM1	lda #$C7D8	sta QsetupPatch+1	lda #$C7DC	sta QpascalPatch+1	lda #$00C7	bra DoneROMCheckROM2	lda ATalkSlot	cmp #0001	beq ROM2_Port1	lda #$C2D8	sta QsetupPatch+1	lda #$C2DC	sta QpascalPatch+1	lda #$00C2	bra DoneROMCheckROM2_Port1	lda #$C1D8	sta QsetupPatch+1	lda #$C1DC	sta QpascalPatch+1	lda #$00C1;	bra DoneROMCheck	;Just fall through the last check.;	-->	;Put new ROM checks in here!DoneROMCheck	sta QsetupPatch+2	sta QpascalPatch+2	jsr install	;install rpm into atalk	plb	;restore bank	plp	xce	rtljmypascal	jml mypascaljmyserwrit	jml myserwritjmyserread	jml myserreadjmyserstat	jml myserstatjnewbasic	jml newbasicRomVers	dc.w 0ATalkSlot	dc.w 0	longa offNewBasic		; 	phb	;save bank	phk	plb	;set bank to code	jsl nbasic	plb	;restore bank	rtl	;and returnnbasic		; 	phx	bvc Go	clc	;assume output if init	jsr Init	pha	lda CSWL	beq InitOut	lda KSWL	bne Go3	lda #5	sta KSWL	sec	;the init was for input	bra Go3InitOut		; 	lda #7	sta CSWL	clc	;the init was for outputGo3		; 	plaGo		; 	pha	lda xslotval	tax	pla	bcc Go2	;If input,	bvc Go2	;and if initializing,	stx KSWL+1	;make it look like slot 1 or 2 is	jsl QSetup	;being inited.	pha	lda ATalkSlot	ora #$C0	sta KSWL+1	pla	plx	rtlGo2		; 	jsl QSetup	plx	rtlInit		; 	pha	phy	php* now that everything is set up for firmware, we will attempt to get* a connection with	the printer	cli	;allow ints	jsr startopen	;start the open procedureropenwait		; ;wait for open to	complete	lda writeready	;see if we can write	beq ropenwait	;wait till we can	plp	ply	pla	rtsMyPascal		; 	phb	phk	plb	jsl MPascal	plb	rtlMPascal		; 	longi off	longa off	pha	tya	and #$0F	tay	pla	cpy #$04	;Is it an init command?	bne NotInit	jsr InitNotInit		; 	cpy #$02	;see if write command	bne NotWrite	;nope	pha	;save char to write	lda rpmflag	;get flag	and #fastbit	;see if the fast bit is set	bne fastwait	;fast write mode	pla	;get back char	bra NotWrite	;not fast write at leastfastwait	plafastwait1		; 	ldx writeready	;wait till ready to	send	beq fastwait1	;not yet	jsl myserwrit	;send the char	ldx #00	clc	;no error	rtl	;and returnNotWrite		; 	pha	tya	and #$F	ora pSlotVal	;pSlotVal	tay	lda xslotval	tax	pla	jml QPascalinstall		; ;init and install	driver	rep #mbit+xbit	longa on	longi on	phb	phk	;data is in same bank as code	plb	lda softreset	;get the current reset vector	sta oldreset	;and store internally	lda softreset+2	sta oldreset+2	;now we have the old vector	lda jourreset	;store a jml ourreset	sta softreset	;into vector	lda jourreset+2	sta softreset+2	jsr rpminit	;zero out stuff	ldx #ourcmds	;get our command table	ldy #$d600+($28*4)	;table starts at $d600	lda #endcmds-ourcmds-1 ;move this many bytes	mvn ourcmds,$e10000	;to bank $e1	ldx #ourcmds2	;get our command table	ldy #$d600+($47*4)	;table starts at $d600	lda #endcmds2-ourcmds2-1 ;move this many bytes	mvn ourcmds,$e10000	;to bank $e1	plb	rtsjourreset	jml ourresetrpminit	pha	phx	phy	php	rep #MBit+XBit	longa on	longi on	ldy #$C110	ldx #$1596	lda whichSCC	cmp #SCCAReg	beq ItsA	ldy #$C220	inxItsA		; 	tya	sta pslotval	sep #MBit	longa off	lda #$80	sta >$E10000,x	rep #mbit	longa on	stz rpmzerodata	;start with a zero	ldx #rpmzerodata	;move from here	ldy #rpmzerodata+1	;move to here (carrys zeros forward)	lda #rpmzeroend-rpmzerodata-2 ;number of bytes to clear out	mvn rpmzerodata,rpmzerodata	plp	ply	plx	pla	rtsourcmds		; 	DC.A pmsetprinter	;$28	DC.B rpmzplenendcmds		; ourcmds2		; 	DC.A pmclosesession	;$47	DC.B rpmzplen;; MSD: New call to cause an immediate flush of data in the buffers;	DC.A pmflushsession	;$48	DC.B rpmzplenendcmds2		; ourreset		; ;should come here	during reset	php	;save mode bits	phb	;and databank	jsl oldreset	;let lower protocol	get called first	phk	;set up data bank	plb	jsr rpminit	;and re-init pap	plb	;restore bank	plp	;and mode bits	rtl	;and return to our calleroldreset		; ;this code gets old reset vector	jml $000000	;dummy code** I don't know what the below vector does as it isn't called anywhere* in this file.  So I'm taking it out.  **TGH**ljmpvec	jml $e10000	;address gets filled later*Qsetup	phb	;save bank	pha	php	;save state	sep #mbit+xbit	longa off	longi off	lda $c082	;turn on roms       	lda #00	pha	plb** Instead of checking the ROM version here for each call, we patch a* JSL at init time to point to the correct location.  **TGH**	lda >romid	;test flag*	bne newq	;new roms*	lda >romid+1	;and high byte*	cmp #$10	;see if version 1*	bne newq	;nope*	plp	;restore state*	pla	;and accum*	jsl oldQSetup	;call mikes stuff old way*	bra qafternew*newq		; *	plp	;restore state*	pla	;and accum*	jsl newQSetup	plp	;Restore state	pla	;and accum.QsetupPatch	jsl $000000	;We patch this for each ROMqafternew		; 	pha	;save accum	php	sep #mbit+xbit	longa off	longi off	lda lcbank2	;language card bank	2	lda lcbank2	plp	;restore state	pla	;restore accum	plb	;restore our bank	rtl	;and returnQpascal	phb	;save bank	pha	php	;save state	sep #mbit+xbit	longa off	longi off	lda $c082	;turn on roms       	lda #00	pha	plb** Instead of checking the ROM version here for each call, we patch a* JSL at init time to point to the correct location.  **TGH**	lda >romid	;low byte was 0 for	version 1.0*	bne newp	;new roms*	lda >romid+1	;high byte was $10 for version 1.0*	cmp #$10	;see if version 1*	bne newp	;nope*	plp	;restore state*	pla	;and accum*	jsl oldQPascal	;call mikes stuff old way*	bra qafternew*newp		; *	plp	;restore state*	pla	;and accum*	jsl newQPascal*	bra qafternew	;exit through above	routine	plp	;Restore state	pla	;and accum.QpascalPatch	jsl $000000	;We patch this for each ROM.	bra qafternew	;Exit through above routine.	ENDPpmsetprinter	PROC	jsr CheckAsync	; 7-Oct-91 MSD		longa on	longi on	;comes here full 16	from dispatcher	phk	plb	;set data bank to code bank	ldy #$04	;get pointer to entity	lda [cmdlist],y	sta execaddr	;and save low word	iny	iny	lda [cmdlist],y	sta execaddr+2	;and high word of entity name	sep #mbit+xbit	;go to 8 bit mode	longa off	longi off	ldy #$08	;get flag field	lda [cmdlist],y	tax	;hold onto	ldy #maxname	;get maximum name size	lsr a	;see if they want name returned	bcc setname	;they want to set the name; --> MSD 16-May-91	beq getname	; no other bits set -> return name		rep #mbit+xbit	longa on	longi on		lda #pmflagerr	; return printer and other bits set	brl pmerrexit		longa off	longi offgetname; <-- MSD 16-May-91	ldy #$08	;get flag field	lda rpmflag	;get old flag	sta [cmdlist],y	ldy #maxname	;get maximum name sizegetcplp		; 	lda prname,y	;get name from buffer	sta [execaddr],y	;and save it	dey	bpl getcplp	;keep going	rep #mbit+xbit	longa on	longi on	ldy #$09	;get flush time	lda ftime	sta [cmdlist],y	ldy #$0b	;get connection time	lda ctime	sta [cmdlist],y	ldy #$0d	;get number of bufs	to allocate	lda nbufs	sta [cmdlist],y	bra pmsetdone	;and exitsetname		; 	stx rpmflag	;and save for later	usecplp		; ;copy the name to	internal storage	lda [execaddr],y	sta prname,y	;and save it	dey	;reduce pointer	bpl cplp	;loop while still plus	rep #mbit+xbit	;back to full native mode	longa on	longi on* do not close the job, just change the values, so that the time outs* will take place in the context of the current job * GWS 6/15/88*	jsl conncomp	;shut down any open	connection*wtcls		; ;wait for close to finish*	lda closephase*	bne wtcls	;still closing	sec	ldy #$0B	;get connection time	lda [cmdlist],y	beq @L1	ldy #$09	;subtract flush time	sbc [cmdlist],y	bcs @L1@L0	lda #pmtimeerr	;     ;Added 11/14/88  **TGH@L2	ldy #2	;move to result field	sta [cmdlist],y	;and store result	rtl	;and return@L1	ldy #$09	;get flush time	lda [cmdlist],y	beq @L0	sta ftime	ldy #$0b	;get connection time	lda [cmdlist],y	sta ctime	ldy #$0d	;get number of bufs	to allocate	lda [cmdlist],y	; is it zero? (MSD 6/4/91); ---> Begin MSD 6/4/91	bne @okbuf	lda #pmbufcnterr	; zero is an invalid buffer count	bra @L2	; return the error@okbuf; <--- End MSD 6/4/91	sta nbufs	lda idtag	;see if we already got a tag	bne pmsetdone	;yes, so don't get a new one	pea $0000	;result comes back here	pea $8000	;get an id	ldx #$2003	;call misc tools	jsl $e10000	;make the call	pla	;get id	sta idtag	;and save in global	areapmsetdone		; 	rep #mbit+xbit	longa on	longi on	lda #0000	;no errorpmerrexit	ldy #2	;move to result field	sta [cmdlist],y	;and store result	rtl	;and return	ENTRY MySerStat	; EXPORT -> ENTRY  **TGHMySerStat	php	;state, and	phb	;data bank	sep #mbit+xbit	;force 8 bit mode	longa off	longi off	phk	;set data bank to code bank	plb	lda #$28	;start building scc	status reg with thi	ora readavail	;bring in read avail bit	ora writeready	;and write ready bit	plb	;restore old bank	plp	;and status reg	rtl	ENTRY MySerWrit	; EXPORT -> ENTRY  **TGHMySerWrit	pha	phx	phy	phb	;save data bank	php	phk	plb	;make sure data bank = code bank	jsr bufferchar	;put char in packet	plp	plb	;restore data bank	ply	plx	pla	rtl	ENTRY MySerRead	; EXPORT -> ENTRY  **TGHMySerRead	phx	phy	phb	;save data bank	php	phk	plb	;make sure data bank = code bank	jsr getchar	;get char from buffer	plp	plb	;restore data bank	ply	plx	rtl	ENDP;;	rpm.open;startopen	PROC	;begin connection establishment	rep #mbit+xbit	longa on	longi onclosefinish		; 	lda closephase	;see if in process of closing	bne closefinish	;let closing finish	lda rpmopenflag	;see if we are currenty open	beq newopen	;nope so open up*           jsl    RamForbid	;don't let anything come between us*           jsr    removeconn	;remove connection timer*           jsr    removeflush	;and flush timer*           jsr    installconn	;install connection	timer*           jsr    installflush	;and flush timer*           jsl    RamPermit	;now we allow ints again	brl xstopen	;exit the open routinenewopen		; 	inc rpmopenflag	;show that we are open	stz readavail	;no chars currently	available	stz writeready	;and writing not permited yet	lda #writebuf	;set up current buffer	sta currbuf	lda #^writebuf	sta currbuf+2	stz critflag	;not in flush critical section	stz outhd	;no buffers waiting	to go out	stz outhd+2	stz ovflwch	;no overflow yet	stz papwrite+pwrite_bptr ;no buffer currently being written	stz papwrite+pwrite_bptr+2 ;	stz availhd	;no extra bufs yet	stz availhd+2	pei crzp+2	pei crzp	;save zp usage	ldx nbufs	;get number of buffers to use	dex	beq gotmem	;we got all we wantedmemloop		; 	phx	;save num of bufs	pea $0000	;make room for result	pea $0000	pea $0000	pea maxwrite+link	;size of buf	lda idtag	pha	pea $4008	;fixed memory, not special	pea $0000	pea $0000	ldx #$0902	;call newhandle	jsl $e10000	;make the call	ply	;get result	sty crzp	ply	sty crzp+2	plx	;get num of bufs to	allocate	bcs gotmem	;error so we are done	ldy #0002	;point to high word	lda [crzp]	;de reference handle	pha	lda [crzp],y	;get high word of handle	sta crzp+2	pla	sta crzp	;now it points to actual packet	lda availhd	;set it to head of list	sta [crzp]	lda availhd+2	sta [crzp],y	lda crzp	sta availhd	;now set hd to node	just inserted	lda crzp+2	sta availhd+2	dex	bne memloop	;they want more memorygotmem		; 	pla	;recover zp	sta crzp	pla	sta crzp+2	ldx #papopen	ldy #^papopen	;and issue the open	call	jsl RamDispatch	;which completes to	openph3xstopen		; ;exit open routine with permit	rts	;and return	ENTRY openph3	; EXPORT -> ENTRY  **TGHopenph3	clc	;make sure native mode	xce	phk	plb	;set data bank to code bank	sep #mbit+xbit	;go to 8 bit mode	longa off	longi off	lda papopen+8	;get session ref num	sta papread+8	;and set it for the	other calls	sta papclose+8	sta papwrite+8	rep #mbit+xbit	longa on	longi on	ldy #link	sty writeindex	;point to start of data for pkt	stz readindex	;for reading and writing	lda #$0004	;but we can send chars now	sta writeready	lda rpmflag	;get flag in high byte of word	and #$0020	;check postscript emulation bit	beq noheader	;no need for header	sep #mbit+xbit	;go to 8 bit mode	longa off	longi off	lda papopen+8	;get session ref num	sta papread+8	sta papclose+8	sta papwrite+8	ldy #0	;must start at left	side of wordsetlp		; 	lda poststart,y	;get char	phy	;save index	php	;and mode	jsr bufferchar	plp	;recover mode	ply	;and index	iny	;bump index	cpy #postend-poststart ;see if equal to	len	bne setlp	;not yet keep sendingnoheader		; 	rep #mbit+xbit	longa on	longi on	jsl newread	;issue first read	jsr installconn	;install connection	timer	jsr installflush	;and flush timer	rtl	;and return	ENTRY rpmreadcomp	; EXPORT -> ENTRY  **TGHrpmreadcomp		;reads complete here	clc	;make sure native mode	xce	phk	plb	;set data bank to code bank	rep #mbit+xbit	longa on	longi on	lda papread+2	;see if we got an error	bne readdone	;if so then no more	reads	stz readindex	;set read pointer to start	lda papread+9	;get length of data	read	bne okread	;we got something	lda papread+$0f	;get eof flag	and #$00ff	;dump high byte	bne readdone	;eof so we are donenewread		; 	php	;save mode bits	rep #mbit+xbit	;force to full native	longa on	longi on	ldx #papread	ldy #^papread	;we didn't get any data so issue	jsl RamDispatch	;new read	plp	;restore previous mode bits	bra readdone	;and we are doneokread		; 	lda #0001	;show we have data	sta readavailreaddone		; 	rtl	;and return	ENTRY getchar	; EXPORT -> ENTRY  **TGHgetchar		;get data from buffer	sep #mbit	;8 bit a	longa off	rep #xbit	;16 bit x,y	longi on	ldy readindex	;get current buffer	pointer	lda readbuf,y	;and get actual data	pha	;and save for later	iny	;bump index	sty readindex	;and save for next call	cpy papread+9	;see if equal to size of buffer read	bne getchok	;nope so all is ok	stz readavail	;no more data available	jsl newread	;issue a new readgetchok		; 	pla	;get char read	rts	;and return	ENTRY removeconn	; EXPORT -> ENTRY  **TGHremoveconn	rep #mbit+xbit	longa on	longi on	pha	lda #qtrremove	;set up for remove	sta rpmconntimer	ldx #rpmconntimer	ldy #^rpmconntimer	jsl RamDispatch	pla	rts	;and return	ENTRY removeflush	; EXPORT -> ENTRY  **TGHremoveflush	rep #mbit+xbit	longa on	longi on	pha	lda #qtrremove	sta flushtimer	ldx #flushtimer	ldy #^flushtimer	jsl RamDispatch	pla	rts	ENTRY installconn	; EXPORT -> ENTRY  **TGHinstallconn	rep #mbit+xbit	longa on	longi on	pha	lda #qtrinstall	sta rpmconntimer	lda ctime	;total time before connection closes	bne @L1	lda #$FFFF@L1	sta rpmconntimer+insqtr_count	ldx #rpmconntimer	ldy #^rpmconntimer	jsl RamDispatch	pla	rts	ENTRY installflush	; EXPORT -> ENTRY  **TGHinstallflush	rep #mbit+xbit	longa on	longi on	pha	lda #qtrinstall	sta flushtimer	lda ftime	;total time before flush happens	sta flushtimer+insqtr_count	ldx #flushtimer	ldy #^flushtimer	jsl RamDispatch	pla	rts	ENDP;;	rpm.conn;bufferchar	PROC	;buffers chars for output	inc critflag	;we are critical here	rep #xbit+mbit	;and 16 bit x,y	longi on	longa on	pei crzp+2	pei crzp	;save zp usage	ldx ftime	;set up flush time again	stx flushtimer+insqtr_count	ldx ctime	;and overall connection time out	bne @L1	ldx #$FFFF@L1	stx rpmconntimer+insqtr_count	pha	;save char to send	lda currbuf	;get current buf pointer	sta crzp	;set up zero page	lda currbuf+2	sta crzp+2	ora crzp	;see if no curr buf	bne normbuf	;we have a buffer so put char in	pla	;recover char	sta ovflwch	;and save it	sep #mbit	longa off	lda #$ff	;set high byte to indicate overflow	sta ovflwch+1	bra notfull	;and exitnormbuf		; 	pla	;recover char	sep #mbit	;force 8 bit a	longa off	ldy writeindex	;get current offsetbuffernorm		; 	sta [crzp],y	;save char in currbufsetindex		; 	iny	;bump index	sty writeindex	cpy #maxwrite+link	;see if buffer full	bcc notfull	;not full yet	jsl RamForbid	;dont get interrupted here	jsr packetout	;send the packet	jsr nextpkt	;get next avail packet	jsl RamPermitnotfull		; 	plx	;recover zero page	stx crzp	plx	stx crzp+2	dec critflag	;no longer critical	code	rts	;and returnpacketout		;here we write the packet	rep #mbit+xbit	longa on	longi on	pei lpzp+2	pei lpzp	lda papwrite+pwrite_bptr ;see if packet	already being written	ora papwrite+pwrite_bptr+2	beq usecrzp	;nope so use this one* otherwise append this to list of packets to write	lda #outhd	sta lpzp	lda #^outhd	sta lpzp+2	;set up headnormappend		; 	ldy #0002	;set up for high word indexnmaplp		; 	lda [lpzp],y	;get high word of link	tax	ora [lpzp]	;see if link points	to nil	beq foundapp	;yes so exit	lda [lpzp]	;get low link again	sta lpzp	;and set up for next time	stx lpzp+2	;set high word	bra nmaplp	;and keep goingfoundapp		; ;we found it so append	lda crzp	;get low word of item to append	sta [lpzp]	;save it in list	lda crzp+2	sta [lpzp],y	;and save high word	lda #0000	sta [crzp]	;clear link of item	appended	sta [crzp],y	iny	;move to length field	iny	lda writeindex	sta [crzp],y	;save length for later	bra exitpktout	;and leaveusecrzp		; ;send current pkt	out	clc	lda crzp	adc #link	;skip link stuff	sta papwrite+pwrite_bptr ;show that we are writing	lda crzp+2	adc #0000	sta papwrite+pwrite_bptr+2 ;this packet	sec	lda writeindex	;get length of packet	sbc #link	;subtract link offset	sta papwrite+pwrite_blen	stz papwrite+pwrite_eofflag-1 ;this is not last packet	jsr removeflush	;take out flush timer	jsr removeconn	;and connection timer since writing;	inc flushphase	;MSD: in the middle of writing	lda #packetcomp	sta papwrite+4	;set up completion routine	ldx #papwrite	ldy #^papwrite	;and do the write	jsl RamDispatch	;completes to packetcompexitpktout		; 	pla	;recover zp	sta lpzp	pla	sta lpzp+2	rtsnextpkt		;gets next avail pkt	rep #mbit+xbit	longa on	longi on	stz writeready	;assume not ready to write	lda availhd	;get next avail buffer	sta currbuf	sta crzp	lda availhd+2	sta currbuf+2	sta crzp+2	ora crzp	;see if we are getting nothing	beq getout	;nothing in list	lda #$04	;tell them we can receive more data	sta writeready	ldy #link	;skip link stuff	sty writeindex	ldy #0002	lda [crzp]	;get low word of next avail	sta availhd	;becomes first avail	lda [crzp],y	sta availhd+2getout		; 	rts	ENTRY packetcomp	; EXPORT -> ENTRY  **TGHpacketcomp		;comes here	when packetout done	clc	;make sure native mode	xce	phk	plb	;set data bank to code bank	rep #mbit+xbit	longa on	longi on	jsr removeflush	;take flush timer out as precaution	jsr installflush	;and install it since write now waiting	jsr removeconn	;take conn timer out as precaution	jsr installconn	;and put back in since waiting again	lda papwrite+pwrite_bptr ;get node that	is now free	sec	sbc #link	;get back to pointer	sta crzp	lda papwrite+pwrite_bptr+2	sbc #0000	sta crzp+2	ldy #0002	lda availhd	;put packet on avail list	sta [crzp]	lda availhd+2	sta [crzp],y	lda crzp	sta availhd	lda crzp+2	sta availhd+2	lda papwrite+pwrite_result ;get result	bne nowait	;there was an error	don't send more	stz papwrite+pwrite_bptr ;show no pkt in progress	stz papwrite+pwrite_bptr+2	lda outhd	;get next waiting buffer	sta crzp	lda outhd+2	sta crzp+2	ora crzp	;see if we are getting nothing	beq nowait	;nothing in list	lda [crzp]	;take crzp out of list	sta outhd	lda [crzp],y	sta outhd+2	iny	iny	lda writeindex	;save previous write index	pha	lda [crzp],y	;get length of packet	sta writeindex	;and set length	jsr packetout	;send packet in crzp	pla	;recover previous write index	sta writeindexnowait		; 	lda currbuf	;see if we already have a buf	ora currbuf+2	bne indxok	;yes so no need to get new one	jsr nextpkt	;get next avail pkt	lda ovflwch	;see if we got overflow char	beq indxok	;nope	jsr bufferchar	;yes so put in current buffer	rep #mbit+xbit	longa on	longi on	stz ovflwchindxok		; 	lda #25000	;do a 100ms waitindxok1		; 	dec a	;to speed up the printer!	bne indxok1;	dec flushphase	;done with write	rtl	;and return	ENTRY flushcomp	; EXPORT -> ENTRY  **TGHflushcomp		;comes here	when we want to flush	clc	;make sure native mode	xce	phk	plb	;set data bank to code bank	rep #mbit+xbit	longa on	longi on	lda critflag	;see if bufferchar active	bne newflush	;yes so dont flush them	ldy writeindex	;see if anything to	flush	cpy #link	beq newflush	;no so re-install flush (& reset phase)	lda currbuf	sta crzp	;tell it flush this	buffer	lda currbuf+2	sta crzp+2	jsr packetout	;otherwise send out	packet	jsr nextpkt	;get ready with next packet	rtl	;and return;newflush0;	dec flushphase	; nothing left to flushnewflush 	jsr installflush	;nothing to send so	try later	rtl	ENTRY conncomp	; EXPORT -> ENTRY  **TGHconncomp		;       ;comes here	when connection times out	clc	xce	phk	plb	;set data bank to code bank	rep #mbit+xbit	longa on	longi on	lda rpmconntimer+insqtr_result	cmp #qtrcanceled	beq @L1	lda ctime	;total time before connection closes	bne @L1	lda #$FFFF	sta rpmconntimer+insqtr_count	lda #qtrinstall	sta rpmconntimer	ldx #rpmconntimer	ldy #^rpmconntimer	jsl RamDispatch	rtl@L1	jsr removeconn	;remove connection timer	jsr removeflush	;and flush timer	stz papwrite+pwrite_blen	lda #$0100	;set eofflag	sta papwrite+pwrite_eofflag-1	stz writeready	;not ready to write	any more	inc closephase	;we are now closing	lda #closec1	;close connection phase 1	sta papwrite+4	;set completion routine	ldx #papwrite	ldy #^papwrite	;and do the write	jsl RamDispatch	;completes to packetcomp	rtlclosec1		; 	clc	;make sure native mode	xce	phk	plb	;set data bank to code bank	rep #mbit+xbit	longa on	longi on	lda #rpmclosecomp	;complete to open phase 2	sta papclose+4	;by having close calling openph2	ldx #papclose	;first close any previous connection	ldy #^papclose	jsl RamDispatch	rtl	;and return	ENTRY rpmclosecomp	; EXPORT -> ENTRY  **TGHrpmclosecomp		;       	clc	;make sure native mode	xce	phk	plb	;set data bank to code bank	rep #mbit+xbit	longa on	longi on	stz papwrite+pwrite_bptr ;show no pkt in progress	stz papwrite+pwrite_bptr+2	stz closephase	;we are now closed	stz rpmopenflag	;not open any more	lda #$0004	;tell them we can write again!	sta writeready	;even though connection is closed	lda idtag	pha	ldx #$1102	;call disposeall	jsl $e10000	;make the call	rtl	ENDPpmclosesession	PROC	jsr CheckAsync	; 7-Oct-91 MSD		longa on	longi on	;comes here full 16	from dispatcher	phk	plb	;set data bank to code bank	lda #qtrcancel	;set up for cancel	sta rpmconntimer	ldx #rpmconntimer	ldy #^rpmconntimer	jsl RamDispatch	ldy #$02	;get pointer to entity	lda #0	sta [cmdlist],y	rtl	ENDP;; PMFlushSession ($48);; $00    Async flag    Byte    $00  (Synchronous only); $01    Command       Byte    $48; $02    Result Code   Word    <--;; (Always returns $0000, no error);; MSD: This call causes data to be flushed immediately by causing the; flush timer to complete immediately.;pmflushsession	proc	jsr CheckAsync	; 7-Oct-91 MSD		longa on	longi on	;comes here full 16	from dispatcher	phk	plb	;set data bank to code bank; MSD: This didn't work.  When I tried doing a flush to the .RPM driver,; it just hung (I didn't have time to investigate, but I suspect that; the phase flag wasn't getting set right when there was no data to flush).;;	jsr removeflush	; don't let timer expire;	inc flushphase	; we're busy doing a flush!;	;	lda ftime	; get current flush interval;	pha	; and save it;	lda #1	; do flush as fast as possible;	sta ftime;	;	jsl flushcomp	; start flushing stuff;loop;	lda flushphase	; wait for flush to finish;	bne loop;	;	pla	; get old flush time;	sta ftime	; and restore it	lda #qtrcancel	;set up for cancel	sta flushtimer	ldx #flushtimer	ldy #^flushtimer	jsl RamDispatch	ldy #$02	;get pointer to result	lda #0	;return no error	sta [cmdlist],y	rtl	endp	;-------------------------------------------------------------------------------;;	rpm.vars;rpmdatablock	PROC	ENTRY	rpmzerodata,\		rpmopenflag,\		readavail,\		readindex,\		writeready,\		writeindex,\		closephase,\		currbuf,\		outhd,\		availhd,\		ovflwch,\		critflag,\		idtag,\		rpmzeroend,\		rpmflag,\		ftime,\		ctime,\		nbufs,\		rpmconntimer,\		flushtimer,\		papopen,\		papclose,\		papwrite,\		papread,\		poststart,\		postend,\		statbuf,\		writebuf,\		readbuf,\		prnamerpmzerodata		;start zeroing here   on initrpmopenflag	DS.B 2	;=0 if not openreadavail	DS.B 2readindex	DS.B 2writeready	DS.B 2writeindex	DS.B 2closephase	DS.B 2currbuf	DS.B 4outhd	DS.B 4availhd	DS.B 4ovflwch	DS.B 2critflag	DS.B 2idtag	DS.B 2;flushphase	ds.b 2	; <>0 if still flushing data (MSD)rpmzeroend		; ;and stop zeroing	hererpmflag	DS.B 2ftime	DC.W 2	;time before flushctime	DC.W 120	;inactivity time before closenbufs	DS.B 2rpmconntimer		; 	DC.B $80,$04,$00,$00	DC.L conncomp	DS.B 8	;the rest is set up	by code or internalflushtimer		; 	DC.B $80,$04,$00,$00	DC.L flushcomp	DS.B 8papopen		; 	DC.B $80,$23,$00,$00	DC.L openph3	DC.B 0	DC.L prname	DC.B 1	DC.L statbufpapclose		; 	DC.B $80,$24,$00,$00	DC.L rpmclosecomp	;completion routine	set by code	DC.B $00papwrite		; 	DC.B $80,$26,$00,$00	DC.L packetcomp	DC.B $00	DC.W 0	;buffer length filled in by code	DC.L writebuf	DC.B 0papread		; 	DC.B $80,$25,$00,$00	DC.L rpmreadcomp	DC.B $00	DC.W 0	;buffer length filled in by call	DC.L readbuf	;put data read in here	DC.B 0	;end of file flagpoststart		; 	DC.B '%%IncludeProcSet IWEm 1 1'	DC.B $0d	DC.B '_WBJ_ 'postend		; statbuf	DS.B 128	;maximum status buffer sizewritebuf	DS.B 512+8readbuf	DS.B 512prname	DS.B maxname	;maximum size name we can have	ENDP	end	