********************************************************************************* ATalk.Protocols** This file contains a code header that calls the init routines to all the* AppleTalk protocols in this file.********************************************************************************		MACHINE	M65816		MSB	OFF		STRING	ASIS		import	ATPATCHInit		import	pfinstall		import	ATSTARTInitmain		PROC		longa	on		longi	on		bra	begin		dc.b	'ATRAM VERSION 4.0'	; includes AppleTalk Phase II;		dc.b	'***************';		dc.b	'ATPATCH ------>';		dc.w	atpatchinit;		dc.b	'PFI ---------->';		dc.w	pfinstall;		dc.b	'ATSTART ------>';		dc.w	atstartinit;		dc.b	'***************'begin		phb		phk		plb		sty	AtalkSlot		stx	ROMVers		jsl	ATPATCHInit		ldy	AtalkSlot		ldx	ROMVers		jsl	pfinstall		ldy	AtalkSlot		ldx	ROMVers		jsl	ATSTARTInit		plb		clc		lda	#$0000		rtlAtalkSlot	ds.w	1ROMVers		ds.w	1		ENDP		END