;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		IMPORT	AFP		IMPORT	AFP_PFXLOC		IMPORT	AFP_PFX_DEV		IMPORT	BLKCNTL		IMPORT	BUFFMOVE		IMPORT	CHKSLASH		IMPORT	CHK_BITMAP		IMPORT	CHK_PRODOS		IMPORT	CMD_ROUTING		IMPORT	CURSESS		IMPORT	Cn_DEVNUM		IMPORT	Cn_LEVEL		IMPORT	Cn_PFIERR		IMPORT	Cn_WSICMD		IMPORT	DIR_GETEOF		IMPORT	DO_JSRLOCAL		IMPORT	FILE_GETEOF		IMPORT	FILE_SIZE		IMPORT	FND_CURSRV		IMPORT	FROM_SEC		IMPORT	GETCOUNT		IMPORT	GETMBPL		IMPORT	LOCAL		IMPORT	LOCALREF		IMPORT	MARK_WRAP		IMPORT	MLI_GBL_UPDT		IMPORT	NEW_SRCPATH		IMPORT	NLMV_CNT		IMPORT	ORG_REQ		IMPORT	PATH2BUF		IMPORT	PATH2CARD		IMPORT	PDOS_BITMAP		IMPORT	PFIBANK		IMPORT	PFI_BANK		IMPORT	PFI_NAMING		IMPORT	PKT_CNT		IMPORT	PRO_PFXLOC		IMPORT	PRO_PFX_DEV		IMPORT	PRO_TIME		IMPORT	RD_CHKCNTL		IMPORT	RETURNPL		IMPORT	RWSETUP		IMPORT	SESSION_TBL		IMPORT	SETTRCNT		IMPORT	SIZE_ALLOWED		IMPORT	SIZE_AVAIL		IMPORT	STRIP_PREFIX		IMPORT	STUFF_IDS		IMPORT	UBUFPTRH		IMPORT	UBUFPTRL		IMPORT	UCURBLKH		IMPORT	UCURBLKL		IMPORT	UCURSHR		IMPORT	UDEVNUM		IMPORT	UDIRID1		IMPORT	UDIRID2		IMPORT	UDIRID3		IMPORT	UDIRID4		IMPORT	UENMASK		IMPORT	UEOB1		IMPORT	UEOB2		IMPORT	UEOB3		IMPORT	UERROR		IMPORT	UFILEIDX		IMPORT	UFILELOC		IMPORT	ULEVEL		IMPORT	UMARK1		IMPORT	UMARK2		IMPORT	UMARK3		IMPORT	UMODE		IMPORT	UNLCHAR		IMPORT	USRVNUM1		IMPORT	USRVNUM2		IMPORT	USTATUS		IMPORT	UTRANCNT		IMPORT	UTYPE		IMPORT	UVOLID1		IMPORT	UVOLID2		IMPORT	UWORK1		IMPORT	UWORK2		IMPORT	WRITE_BLK		IMPORT	WRT_CHKCNTL		IMPORT	WS_COMBUF		IMPORT	WS_PATH		IMPORT	XBUFPTR		IMPORT	ws_plist,pfi_retry** pfi_cmdsubs2** Greg Seitz (11-Aug-87)** 16-May-91 MSD	    If you do a	SpecialOpenFork	(call $43 to the P8 MLI),*		    and	the volume is unkown, return a volume not found*		    error ($45)	instead	of passing it to the local ProDOS*		    (which will	return invalid command,	$01).** 23-Oct-91 MSD		Unfixed the 16-May-91 fix.  It now returns error $01*			again since MECC depends on getting that error.  It still does*			not call local ProDOS (PFI returns the error directly).*;	EXPORT	zpcmdscs2   ;zpcmdscs2  PROC		INCLUDE	'zp.equates';	ENDP		include	'global.equates'		include	'pfi_equates';	include	'atp.equates'		EXPORT	pficmdsubs2pficmdsubs2	PROC		longa	off		longi	off** PARAMIS NETWORK SOFTWARE***   CONFIDENTIAL*** MODULE : PFI2	- PRODOS FILING	INTERFACE   (PART 2)*   FILING CALLS (12 MLI CALLS)**   WRITTEN BY Thomas Eager**   MODIFIED: 06-09-87	10:00 TE**   COPYRIGHT 1986,87 ParaMIS CORPORTATION** ALL RIGHTS RESERVED**** COMMAND $C8 =	OPEN* COMMAND $43 =	OPEN FORK (SPECIAL NETWORK CALL)***   ISSUE GET FILE/DIRECTORY PARMS**   IF FILE THEN ISSUE OPEN FORK (DATA)**		EXPORT	OPENOPEN					;       ** IS THERE ROOM	FOR ONE	MORE OPEN ?*		LDX	#0OPEN1					; 		LDA	UMODE,X		;FIND SPACE IN TABLE		BEQ	OPEN2		;SPACE FOUND		INX			;NEXT TBL POSITION		CPX	#8		;END OF	TBL ?		BNE	OPEN1;		LDA	#$42		;FCB FULL		STA	UERROR		RTS** MOVE PATHNAME	ONTO THE CARD*OPEN2					; 		STX	UFILEIDX	;SAVE TABLE INDEX		JSR	PATH2CARD		BCS	OPEN2_ERR	;PATH HAS ERROR		lda	ws_plist		beq	open2_err	;zero length path;** IS PRODOS NAMING ACTIVE ?*		BIT	PFI_NAMING		BMI	OPEN2A;		JSR	CHK_PRODOS		BCC	OPEN2A;OPEN2_ERR				; 		LDA	#$40		STA	UERROR		;INVALID PATH -	TOO LONG		RTS** IS VOLUME SPECIFIED?*OPEN2A					; 		JSR	CHKSLASH		BCC	OPEN3		;NO,FIRST CHARACTER WAS	NOT A SLASH** VOLUME IS SPECIFIED. IS IT IN	OUR NETWORK TABLE?*		JSR	FND_CURSRV		BCS	OPEN4		;NOT IN	OUR TABLE - GO LOCAL		JSR	STRIP_PREFIX		BRA	OPEN5		;FILE/DIR IS ON	A SERVER** VOLUME IS NOT	SPECIFIED. USE PFXLOC TO DETERMINE WHERE TO* OPEN IT.*OPEN3					; 		BIT	PFI_NAMING		BMI	OPEN3_AFP** PRODOS PREFIX	IS ACTIVE*		LDA	PRO_PFXLOC		STA	CURSESS		;SET UP	CURSESS		CMP	#$FF		BEQ	OPEN4		;EXECUTE CALL LOCALLY !!!;		LDA	PRO_PFX_DEV		AND	#%11110000	;strip low nibble		STA	Cn_DEVNUM	;TELL PRODOS ABOUT DEVICE		BRA	OPEN5;;OPEN3_AFP				; 		LDA	AFP_PFXLOC		STA	CURSESS		;SET UP	CURSESS		CMP	#$FF		BEQ	OPEN4		;EXECUTE CALL LOCALLY !!!;		LDA	AFP_PFX_DEV		AND	#%11110000	;strip low nibble		STA	Cn_DEVNUM	;TELL PRODOS ABOUT DEVICE		BRA	OPEN5;;** IT WILL BE OPENED LOCALLY*;; 16-May-91	MSD	If it was a special open fork, return a volume;			not found error instead of doing a local call.;OPEN4		lda	cn_wsicmd		cmp	#$43		; was it special open fork?		bne	Open4_Local	; no, so pass to local ProDOS						; 23-Oct-91 MSD changed $45 to $01 below		lda	#$01		; couldn't find a network volume for special open		bne	open_err;Open4_Local	JSR	LOCAL		BEQ	OPEN4A		RTS			;ERROR ,EXIT NOW** MOVE UPDATED MOTHERBOARD PARAMETER LIST ONTO CARD*OPEN4A					; 		JSR	GETMBPL** RECORD LOCAL REFERENCE FOR US, AND SWITCH IN OUR* REFERENCE NUMBER FOR THEM.*		LDX	UFILEIDX		LDA	WS_PLIST+5		STA	USRVNUM1,X		STZ	USRVNUM2,X	;NOT USED LOCALLY;		LDA	#$FF		STA	UFILELOC,X	;SPECIFY WHERE FILE LIVES		LDA	Cn_LEVEL		STA	ULEVEL,X		LDA	#%00100011	;READ/WRITE MODE		STA	UMODE,X		INX		TXA		STA	WS_PLIST+5** UPDATE SRCPATH FIELD*		JSR	NEW_SRCPATH** SET AMOUNT TO	BE RETURNED*		LDA	#$06		STA	RETURNPL		RTS;;** OPEN IS FOR A	SERVER*OPEN5					; ** CHECK	IO BUFFER ADDRESS*		LDA	WS_PLIST+$03		BNE	c8_BUFFBAD;		LDX	WS_PLIST+$04	;HB OF IO BUFFER		cpx	#$C0		bcs	c8_BUFFBAD					;		LDY	#$04		;4 pageS		JSR	CHK_BITMAP		BCC	c8_BUFFOK;c8_BUFFBAD	LDA	#$56open_err	STA	UERROR		RTS** CREATE GET FILE/DIRECTORY PARMS*c8_BUFFOK	LDA	#GETFDINFO		STA	WS_COMBUF		STZ	WS_COMBUF+1;		JSR	STUFF_IDS;		LDA	WS_COMBUF+2		STA	WS_PATH-2	;SAVE VOL ID - HB		LDA	WS_COMBUF+3		STA	WS_PATH-1	;SAVE VOL ID - LB;;		STZ	WS_COMBUF+$08	;HB OF FILE BITMAP		LDA	#$01		;GET ATTRI (NEED TO GET	SOMETHING)		STA	WS_COMBUF+$09	;LB OF FILE BITMAP		LDA	#%00010001	;GET DIRECTORY ID & ACCESS		STA	WS_COMBUF+$0A	;HB OF DIR  BITMAP		STZ	WS_COMBUF+$0B	;LB OF DIR  BITMAP;		CLC		LDX	#$0C		JSR	PATH2BUF;** ISSUE	GET FILE/DIR PARAMETER*		JSR	CMD_ROUTING		BCC	OPEN6		;CALL HAS COMPLETED OK;		LDA	Cn_PFIERR;;----> 11/05/87	TE;		CMP	#$78		;ACCESS	ERROR (DROP BOX	??)		BNE	op_CHKERR;		STZ	WS_COMBUF+$04	;FILE IS THE TYPE		STZ	WS_COMBUF+$05	;SOMETHING		STZ	WS_COMBUF+$06	;SOMETHING		STZ	UERROR		BRA	OPEN6		;CONTINUE ON AS	IF IT WERE A FILE;;---->;op_chkerr				; 		CMP	#$5B		BEQ	OP_ERROR;		LDA	UERROR		CMP	#$44		BNE	OP_ERROR		LDA	#$46		;FILE NOT FOUND		STA	UERROROP_ERROR	SEC		RTS			;ERROR IN GET INFO CALL** SAVE TYPE IN USER'S TABLE** BIT 7	= FILE/DIR FLAG* BIT 6	= RESOURCE FORK* BIT 5	= BOTH FORKS* BIT 4	= BUFFERING  VS	NO BUFFERING* BIT 3	= SPECIAL OPEN FORK VS NORMAL PRODOS OPEN*OPEN6					; 		LDX	UFILEIDX		LDA	WS_PLIST		AND	#%11100000	;DATA &	RESOURCE OR BOTH		LSR	a		;MOVE TO BIT 4 , 5 & 6		STA	UTYPE,X;		LDA	WS_COMBUF+4	;FILE OR DIRECTORY		AND	#%10000000	;FIND BIT 7	= FILE/DIR		ORA	UTYPE,X		;FIND BIT 5 & 6	= FORK;		LDY	Cn_WSICMD		cpy	#$43		beq	op_over		ora	#%00001000	;bit 3 = prodos	Open $C8op_over		STA	UTYPE,X** FIND OUT WHAT	TYPE OF	ITEM IT	IS - FILE OR DIRECTORY ?*		LDA	UTYPE,X		BPL	OPEN7		;IT WAS	A FILE !!!;		AND	#%00010000	;BUFFERING		BEQ	op_OK;		LDA	#$4B		;STORAGE TYPE ERROR		STA	UERROR		RTS** IS THIS DIRECTORY IN SEARCH MODE ?*op_OK		LDA	WS_COMBUF+$0A	;ACCESS		AND	#%00000011	;BIT 0,1= SEARCH & READ	RIGHTS		BNE	OPEN6A		;YES , IT IS;		LDA	#$4E		;ACCESS	ERROR		STA	UERROR		RTS			;ALL DONE** WAS THIS A SPECIAL OPEN ?*OPEN6A					; 		LDA	Cn_WSICMD		CMP	#$43		BNE	OPEN6B		;NORMAL	OPEN;		LDA	#$4B		;UNSUPPORTED STORAGE TYPE		STA	UERROR		RTS			;ALL DONE** FIND DIR ID &	VOL ID*OPEN6B					; 		LDA	WS_PATH-2		STA	UVOLID1,X	;SAVE HB OF VOL	ID		LDA	WS_PATH-1		STA	UVOLID2,X	;SAVE LB OF VOL	ID;		LDA	WS_COMBUF+6		STA	UDIRID1,X	;SAVE HI B OF DIR ID		LDA	WS_COMBUF+7		STA	UDIRID2,X	;SAVE MH B OF DIR ID		LDA	WS_COMBUF+8		STA	UDIRID3,X	;SAVE ML B OF DIR ID		LDA	WS_COMBUF+9		STA	UDIRID4,X	;SAVE LO B OF DIR ID;		LDA	#%00000001	;READ ONLY MODE		STA	UMODE,X		JMP	OPEN11		;SET COMMON AREAS IN USER TABLE** IF BOTH ARE REQUESTED	THEN ERROR ??*OPEN7					; 		BIT	WS_PLIST		BVC	OPEN7A;		LDA	#$4B		;UNSUPPORTED STORAGE TYPE		STA	UERROR		RTS			;ALL DONE** SPECIAL OPEN - SAVE SHARE MODE*OPEN7A					; 		LDA	Cn_WSICMD		CMP	#$43		BNE	OPEN8		;NORMAL	OPEN;		LDA	WS_PLIST+6		STA	UCURSHR		;SHARE MODE		BRA	OPEN8A** NORMAL PRODOS	OPEN*OPEN8					; 		LDA	#%00100011	;TRY READ/WRITE		STA	UCURSHR		;SHARE MODE** CREATE OPEN FORK PACKET*OPEN8A					; 		LDA	#OPENFORK		STA	WS_COMBUF	;COMMAND BYTE;		BIT	WS_PLIST		BPL	c8_OPEN8AA	;DATA FORK		LDA	#$80		;SET RESOURCE FORK		BRA	c8_OPEN8ABc8_OPEN8AA	LDA	#$00		;SET DATA FORKc8_OPEN8AB	STA	WS_COMBUF+1	;FORK FLAG;		JSR	STUFF_IDS;		STZ	WS_COMBUF+$08		LDA	#$01		;SET TO	SOMETHING !!		STA	WS_COMBUF+$09		STZ	WS_COMBUF+$0A		LDA	UCURSHR		;OPEN MODE		STA	WS_COMBUF+$0B;		CLC		LDX	#$0C		JSR	PATH2BUF** ISSUE	CALL*		JSR	CMD_ROUTING	;EXECUTE OPEN		BCC	OPEN10		;FILE IS NOW OPEN;;----->	11/05/87 TE DROP BOX DIR ??;		LDA	Cn_PFIERR		cmp	#$5F		;OBJECT	TYPE ERROR ???		bne	op1_chkerr;		lda	#$4e		;access	error for directory		sta	UERROR		sec		rts;;---->;** IS THIS THE SPECIAL OPEN ?*op1_chkerr				; 		LDA	Cn_WSICMD		CMP	#$43		BNE	OPEN8C;		SEC		LDA	UERROR		RTS			;UNABLE	TO OPEN	FILE** IS THIS THE LAST MODE	?*OPEN8C					; 		LDA	UCURSHR		CMP	#%00110010	;WRITE + DENY WRITE + DENY READ		BNE	op8c_OVER		SEC		LDA	UERROR		RTS			;UNABLE	TO OPEN	FILE** IS THIS READ ONLY ?*op8c_OVER	LDA	#%00000001	;Read ONLY		CMP	UCURSHR		;SAME MODE		BNE	OPEN9		LDA	#%00110010	;WRITE + DENY WRITE + DENY READ** TRY LAST MODE*OPEN9					; 		STA	UCURSHR		BRA	OPEN8A		;TRY OPENING IT	AGAIN** SAVE REFERENCE # IN TABLE*OPEN10					; 		LDX	UFILEIDX		LDA	WS_COMBUF+2	;GET REF #		STA	USRVNUM1,X	;PUT REF # IN TBL		LDA	WS_COMBUF+3		STA	USRVNUM2,X	;PUT REF # IN TBL;;;		LDA	UCURSHR		;GET OPEN MODE		BNE	op10_OVER		LDA	#$80		;for special open with no modeop10_OVER	STA	UMODE,X;;		STZ	UDIRID1,X	;used by Drop Boxes w/ $C8		STZ	UDIRID2,X	;used by Drop Boxes w/ $C8		STZ	UDIRID3,X	;used by Drop Boxes w/ $C8** UPDATE THE USER'S TABLE (COMMON DATA)*OPEN11					; 		LDA	CURSESS		STA	UFILELOC,X	;SAVE SESSION;		LDA	WS_PLIST+3		STA	UBUFPTRL,X	;SAVE LB BUF PTR		LDA	WS_PLIST+4		STA	UBUFPTRH,X	;SAVE HB BUF PTR;		LDA	Cn_DEVNUM		STA	UDEVNUM,X	;SAVE DEVICE NUMBER		LDA	Cn_LEVEL		STA	ULEVEL,X	;SAVE PRODOS LEVEL;		STZ	UMARK1,X	;CLEAR MARK		STZ	UMARK2,X		STZ	UMARK3,X;		STZ	UEOB1,X		;CLEAR EOB		STZ	UEOB2,X		STZ	UEOB3,X;		STZ	USTATUS,X	;CLEAR STATUS		STZ	UENMASK,X	;CLEAR ENABLE MASK;		LDA	#$FF		STA	UCURBLKL,X	;SET CURR BLOCK		STA	UCURBLKH,X		INX		TXA		STA	WS_PLIST+5	;STORE REFIDX IN LIST** UPDATE PRODOS	SYSTEM BITMAP*		LDX	WS_PLIST+$04		SEC		JSR	PDOS_BITMAP** UPDATE SOURCE	PATH*		JSR	NEW_SRCPATH** SET AMOUNT TO	BE RETURNED*		LDA	#$06		STA	RETURNPL** GET FIRST BLOCK INTO IO BUFFER*		LDX	UFILEIDX		LDA	UMODE,X		AND	#%00000001	;READ MODE ?		BEQ	OPEN12		;DON'T READ FIRST BLOCK;;----->		LDA	UTYPE,X		AND	#%00010000	;BIT 4 - BUFFERING ??		BNE	OPEN12;;---->;		JSR	BLKCNTL		;READ FIRST BLOCK INTO IO BUFFER		stz	uerror** FILL SECOND HALF OF IO BUFFER	FILL $FF*OPEN12					; 		LDA	#$FF		LDY	#$00c8_NEXT		STA	WS_COMBUF,Y		STA	WS_COMBUF+$100,Y		INY		BNE	c8_NEXT;		LDA	#WS_COMBUF		STA	<SRCBUF		LDA	#>WS_COMBUF		STA	<SRCBUF+1		LDA	#^WS_COMBUF		STA	<SRCBUF+2;		STZ	<DESTBUF	;EVEN PAGE BOUNDARY		LDX	UFILEIDX		CLC		LDA	UBUFPTRH,X		ADC	#$02		STA	<DESTBUF+1	;OFFSET	BY TWO PAGES		LDA	PFI_BANK		STA	<DESTBUF+2	;BANK;		STZ	<COUNT		LDA	#$02		;move two pages		STA	<COUNT+1;		JSR	BUFFMOVE		RTS;;		eject*** COMMAND $C9 =	NEWLINE** HANDLED LOCALLY IN TABLES !!!**		EXPORT	NEWLINENEWLINE					;       		LDX	UFILEIDX		LDA	WS_PLIST+2	;GET ENABLE MASK		STA	UENMASK,X	;SAVE IN TABLE		LDA	WS_PLIST+3	;GET NEWLINE CHAR		STA	UNLCHAR,X	;SAVE IN TABLE		RTS;;		eject*** COMMAND $CA =	READ**		EXPORT	READREAD					;       ** CAN I	READ THIS FILE ?*		LDX	UFILEIDX		LDA	UMODE,X		AND	#%00000001	;READ MODE		BNE	READ0		;YES I CAN READ	THIS;		LDA	#$4E		;ACCESS	ERROR		JMP	READ_X		;EXIT NOW** IS THERE A REQUEST COUNT ?*READ0					; 		LDA	WS_PLIST+$04	;LB OF COUNT		ORA	WS_PLIST+$05	;HB OF COUNT		BNE	ca_OVER;		JMP	READ_X** IF THERE IS A	LOCAL PRODOS,* IS THE START OF THE BUFFER TO	HIGH ?*ca_OVER		LDA	MLI_GBL_UPDT		BEQ	READ0AA		;THERE IS NO LOCAL PRODOS;		LDA	WS_PLIST+$03	;HB OF IO BUFFER		CMP	#$C0		BCC	READ0AA		;WITHIN	THE ACCEPTABLE RANGE;		LDA	#$56		;BAD BUFFER ADDRESS		JMP	READ_X** SAVE ORIGINAL	REQUEST	COUNT*READ0AA					; 		LDA	WS_PLIST+$05		STA	ORG_REQ+1	;SAVE HB ON STACK		LDA	WS_PLIST+$04		STA	ORG_REQ		;SAVE LB ON STACK** DOES THE MARK	WRAP AROUND ?** This routine will also adjust	request	count*		JSR	MARK_WRAP		BCC	ca_OK1;		LDA	#$4C		;END OF	FILE ERROR		JMP	READ_X1** FIND NUMBER OF PAGES TO CHECK** PLACE	RESULT IN [Y]*ca_OK1		LDY	#$C0		CPY	WS_PLIST+$05		BCC	ca_GO					;		CLC		LDA	WS_PLIST+$04	;LB OF LENGTH TO READ		ADC	WS_PLIST+$02	;LB OF BUFFER ADDRESS		TAX			;SAVE LB OF SIZE IN [X]					;		LDA	WS_PLIST+$05	;HB OF LENGTH TO READ		ADC	#$00		TAY			;SAVE HB OF SIZE IN [Y];		CPX	#$00		;PARTIAL PAGE ???		BEQ	ca_GO		;NO , SKIP		INY			;YES, LOOK AT ONE MORE PAGE** CHECK	PRODOS SYSTEM BITMAP*;ca_GO		LDX	WS_PLIST+$03		JSR	CHK_BITMAP		BCS	ca_BADCONT		JMP	READCONT** BUFFER RUNS INTO PROTECTED MEMORY*ca_BADCONT	STY	UWORK1		;BYTE OFFSET TO	BITMAP		ASL	UWORK1		ASL	UWORK1		ASL	UWORK1		;SHIFT OVER THREE BITS		TXA		ORA	UWORK1		STA	UWORK1		;HB OF PROTECTED PAGE** IS FIRST PAGE	PROTECTED ?*		CMP	WS_PLIST+$03	;NO FREE SPACE ??		BNE	ca_SIZE		JMP	ca_BUFFERR;ca_size					; 		SEC		LDA	#$00		SBC	WS_PLIST+$02		STA	SIZE_ALLOWED	;LB AMOUNT ALLOWABLE TO	MOVE		LDA	UWORK1		;HB OF PROTECTED PAGE		SBC	WS_PLIST+$03		STA	SIZE_ALLOWED+1	;HB AMOUNT ALLOWABLE TO	MOVE;;;THIS IS LIKE A	GET EOF	CALL;** HAS THIS BLOCK BEEN READ IN  ?*		LDX	UFILEIDX		LDA	USTATUS,X		AND	#%00001000		BEQ	ca_READ1	;NOT READ IN YET** IS THE EOB IN	THIS BLOCK ?*		LDA	UEOB2,X		AND	#%11111110		CMP	UCURBLKL,X		BNE	ca_READ1	;NOT THIS BLOCK;		LDA	UEOB3,X		CMP	UCURBLKH,X		BNE	ca_READ1	;NOT THIS BLOCK** MOVE END OF BLOCK INTO PARAMETER LIST*		LDA	UEOB1,X		STA	FILE_SIZE		LDA	UEOB2,X		STA	FILE_SIZE+1		LDA	UEOB3,X		STA	FILE_SIZE+2		BRA	ca_READ3	;ALL DONE !!** ASK SERVER ABOUT END OF FILE* IS IT	A DIRECTORY ?*ca_READ1	LDA	UTYPE,X		BPL	ca_READ2	;IT WAS	A FILE		JSR	DIR_GETEOF		LDA	UERROR		BNE	READ_X1		BRA	ca_READ3** FIND FILE - EOF !!*ca_READ2	JSR	FILE_GETEOF		LDA	UERROR		BNE	READ_X1** FIND AMOUNT AVAILABLE*ca_READ3	SEC		LDX	UFILEIDX		LDA	FILE_SIZE		SBC	UMARK1,X		STA	SIZE_AVAIL	;LBSIZE	OF AMOUNT ALLOWED		LDA	FILE_SIZE+1		SBC	UMARK2,X		STA	SIZE_AVAIL+1	;MB OF AMOUNT ALLOWED		LDA	FILE_SIZE+2		SBC	UMARK3,X		STA	SIZE_AVAIL+2	;HB OF AMOUNT ALLOWED** WILL DATA FIT	INTO BUFFER WITHOUT FIT	NONPROCTECTED AREA*		LDA	SIZE_AVAIL+2		BNE	ca_BUFFERR;		SEC		LDA	SIZE_ALLOWED		SBC	SIZE_AVAIL		LDA	SIZE_ALLOWED+1		SBC	SIZE_AVAIL+1		BCC	ca_BUFFERR** CHANGE REQUEST COUNT TO SIZE AVAILABLE*		LDA	SIZE_AVAIL		STA	WS_PLIST+$04		LDA	SIZE_AVAIL+1		STA	WS_PLIST+$05		BRA	READCONT	;CONTINUE AS NORMAL** ERROR	- DATA WILL RUN	INTO PROTECT MEMORY*ca_BUFFERR	LDA	#$56;;;** read exit routine*READ_X1					; 		LDY	ORG_REQ		STY	WS_PLIST+$04		LDY	ORG_REQ+1		STY	WS_PLIST+$05;READ_X					; 		STA	UERROR		STZ	WS_PLIST+$06	;NO DATA TRANSFERRED		STZ	WS_PLIST+$07					;		LDA	#$08		STA	RETURNPL		RTS			;NO ERROR;;;;;** WHAT IS THE REQUEST COUNT ?* (IS IT OVER ONE BLOCK	?)*READCONT	STZ	WS_PLIST+$06	;reset transfer	count		STZ	WS_PLIST+$07		JSR	RWSETUP		;SETUP;		PHP			;----->		LDX	UFILEIDX		LDA	UTYPE,X		AND	#%00010000	;BUFFERING		BEQ	rc_CONT		;YES BUFFER;		PLP		BRA	rc_LSTCHK;rc_CONT		PLP		BCS	READ1		;DON'T USE CHUNK CONTROL** IS THIS A DIRECTORY ?*		LDX	UFILEIDX		LDA	UTYPE,X		BMI	READ1		;YES, USE SINGLE BLOCK MODE** IS THE NEWLINE ENABLED ?* (NOT ALLOWED TO USE NEWLINE WITH CHUNK CONTROL)*		LDA	UENMASK,X		BNE	READ1		;YES,USE SINGLE	BLOCK MODE** ARE WE AT THE	END OF THE FILE	?*rc_LSTCHK				; 		LDX	UFILEIDX		LDA	USTATUS,X	;EOF ?		BPL	READ0A		;NO , NOT YET;		LDA	#$4C		;EOF		STA	UERROR		JMP	READ11** READ IS OVER ONE BLOCK WITH NO NEWLINE CHARACTER* USE CHUNK CONTROL !!!*READ0A					; 		JSR	RD_CHKCNTL** WAS SOME DATA	RETURNED  ?*		LDA	UERROR		BNE	ca_OK		;THERE WAS AN ERROR;;		LDA	WS_PLIST+$06		ORA	WS_PLIST+$07		BNE	ca_OK		;YES;		LDA	#$4C		;EOF		STA	UERROR;		LDX	UFILEIDX	;SET EOF STATUS		LDA	USTATUS,X		ORA	#%10000000	; MSD 13-Sep-89: changed %10000000 to #%10000000		STA	USTATUS,X** RESTORE REQUEST COUNT*ca_OK		LDA	ORG_REQ		STA	WS_PLIST+$04	;RESTORE REQUEST COUNT		LDA	ORG_REQ+1		STA	WS_PLIST+$05		RTS;;** USE SINGLE BLOCK MODE**  MAKE	SURE IO	BUFFER HAS CORRECT BLOCK*READ1					; 		JSR	BLKCNTL		;CALL BLOCK CONTROL		BEQ	READ3		;NO ERROR IN IO	UPDATE		JMP	READ11		;ERROR - EXIT THE READ CALL** ARE WE AT THE	END OF THE FILE	?*READ3					; 		LDX	UFILEIDX		LDA	USTATUS,X	;EOF ?		BPL	READ4		;NO , NOT YET** SET THE TRANSFER COUNT & SIZE	OF PL TH BE RETURNED*		JSR	SETTRCNT		LDA	#$08		STA	RETURNPL** WAS SOME DATA	RETURNED  ?*		LDA	WS_PLIST+$06		ORA	WS_PLIST+$07		BEQ	ca_NODATA	;No;		LDA	#$00		;reset error code		BRA	ca_DONE;ca_NODATA	LDA	#$4C		;EOFca_DONE		STA	UERROR;		LDA	ORG_REQ		STA	WS_PLIST+$04		LDA	ORG_REQ+1		STA	WS_PLIST+$05		RTS** SET LOCATIONS	FOR MOVE* (FROM	IO BUFFER INTO USER'S BUFFER)*READ4					; 		LDA	XBUFPTR		;GET CURRENT BUFR PTR  (DESTINATION)		STA	<destbuf		LDA	XBUFPTR+1		STA	<destbuf+1;		LDA	PFI_BANK		STA	<destbuf+2	;BANK;		CLC		LDA	UBUFPTRL,X	;SETUP CURRENT FILE BUFR (SOURCE)		ADC	UMARK1,X	;POINTER		STA	<srcbuf		LDA	UMARK2,X		AND	#%00000001		ADC	UBUFPTRH,X		STA	<srcbuf+1;		LDA	PFI_BANK		STA	<srcbuf+2	;BANK** SET COUNT TO END OF THE BUFFER*		SEC		LDA	UEOB1,X		;SETUP COUNT TO	EOB		SBC	UMARK1,X		STA	<count		LDA	UEOB2,X		SBC	UMARK2,X		STA	<count+1		BNE	READ5		LDA	<count		BNE	READ5** ERROR	- THERE	IS NO DATA IN THE BUFFER* SET EOF BIT IN STATUS*		LDA	USTATUS,X		ORA	#%10000000		STA	USTATUS,X		JMP	READ11** SET MARK TO NEW LOCATION*READ5					; 		JSR	GETCOUNT	;SETMARK ETC_** IS THE NEW LINE MASK BEING USED ?*		LDA	UENMASK,X	;ENABLE	MASK SET ?		BNE	READ6		;YES !!!** SET MOVE TYPE	AND EXECUTE THE	MOVE ROUNTINE*		JSR	BUFFMOVE	;MOVE DATA** IS THERE MORE	DATA TO	BE READ	?*	(ANOTHER BLOCK?)*		JMP	READ9;;** THE NEWLINE MASK IS ENABLED !!!** THIS MEANS THAT WE MUST USE A	SPECIAL	MOVE ROUTINE* WHICH	STOPS IF THE NEWLINE CHARACTER IS ENCOUNTERED.*READ6					; ** PLACE	2'S COMP VALUE FOR COUNT IN NLMV_CNT* (THIS	IS USED	BY THE SPECIAL MOVE ROUTINE)*		LDA	#$00		SEC		SBC	<COUNT		STA	NLMV_CNT		LDA	#$00		SBC	<COUNT+1		STA	NLMV_CNT+1** SETUP	MOTHERBOARD SOURCE & DEST BUFFERS* SUBTRACT 2'S COMPLEMENT OFFSET FROM SOURCE & DESTINATION** (ADJUSTMENT TO LOCATIONS IS DUE TO USE OF 2'S COMPLEMENT)*		LDA	<SRCBUF		SEC		SBC	NLMV_CNT		STA	NLM_SRC		LDA	<SRCBUF+1		SBC	#$00		STA	NLM_SRC+1;		LDA	<DESTBUF		SEC		SBC	NLMV_CNT		STA	NLM_DEST		LDA	<DESTBUF+1		SBC	#$00		STA	NLM_DEST+1** SETUP	NEWLINE	MASK & NEWLINE CHAR* (PLACE IN SPECIAL MOVE ROUTINE IN C800)*		LDA	UENMASK,X		STA	NLM_MASK		LDA	UNLCHAR,X		STA	NLM_CHAR** (TELL	MOTHERBOARD TO DO SPECIAL NEWLINE MOVE)*READ6A		jsr	newlnmv		;move the data**   SPECIAL FLAG - IF HB OF COUNT = $01	THIS MEANS*   THAT THE NEWLINE CHARACTER WAS ENCOUNTERED AS*   THE	LAST CHARACTER IN THE READ*		LDA	NLMV_CNT+1		CMP	#$01		;WAS NEWLINE CHARACTER LAST IN BUFFER ?		BNE	READ7		;NO !!;		DEC	NLMV_CNT+1	;NEWLINE WAS LAST CHARACTER IN BUFFER		BRA	READ8		;FINISHED WITH MOVE** WAS THE NEWLINE CHARACTER WITHIN THE READ ?* (IF COUNT NOT	EQUAL TO ZERO -	ONE WAS	ENCOUNTERED)*READ7					; 		LDA	NLMV_CNT		BNE	READ8		;YES,IT	WAS ENCOUNTERED		LDA	NLMV_CNT+1		BNE	READ8		;YES,IT	WAS ENCOUNTERED** A COMPLETE MOVE WAS EXECUTED.	CONTINUE ON* CHECK	TO SEE IF THERE	IS MORE	DATA TO	READ* (ANOTHER BLOCK ? )*		brl	READ9** THE NEWLINE CHAR WAS ENCOUNTERED* THE SPECIAL MOVE ROUTINE TERMINATED EARLY* CONVERT 2'S COMPLEMENT BYTE COUNTER BACK INTO THE NORMAL COUNT*READ8					; 		LDA	#$00		SEC		SBC	NLMV_CNT		STA	<COUNT		LDA	#$00		SBC	NLMV_CNT+1		STA	<COUNT+1** SET TRANSFER COUNT*		CLC			;ADD REMAINING IN		LDA	UTRANCNT	;		ADC	<COUNT		STA	UTRANCNT		LDA	UTRANCNT+1		ADC	<COUNT+1		STA	UTRANCNT+1** ADJUST THE MARK FOR DATA NOT READ*		SEC		LDA	UMARK1,X		SBC	<COUNT		STA	UMARK1,X		LDA	UMARK2,X		SBC	<COUNT+1		STA	UMARK2,X		LDA	UMARK3,X		SBC	#0		STA	UMARK3,X** NEWLINE READ IS FINISHED - EXIT NOW*		JMP	READ11*** THIS IS THE NEWLINE MOVE & ATTENTION ROUTINE FOR PFI**   8/20/87 -->	TE*** PFI** THIS IS THE NEWLINE READ MOVE	ROUTINE *newlnmv					; 		phb			;save current bank		phx			;save x	and y		phy		LDY	NLMV_CNT	;from code bank		lda	#00		pha		plb			;set bank to zero					;					;					;NLM_SRCROM				; NLM_SRC		equ	*+1		LDA	$FFFF,YNLM_DEST	equ	*+1		STA	$FFFF,Y		INYNLM_MASK	equ	*+1		AND	#00NLM_CHAR	equ	*+1		CMP	#$FF		BNE	NLM_SRCROM1	;CONTINUE		CPY	#$00		;NEW LINE ENCOUNTERED		BNE	NLMX_ROM	;TIME TO EXIT;; ---> 3/28/88 need to set bank	te;		phb		lda	#^PFIBANK		pha		plb					;					;		LDX	NLMV_CNT+1	;HIGH BYTE ROLL	OVER		INX		STX	NLMV_CNT+1		CPX	#$00		BNE	NLMX_BKROM	;NOT END OF BLOCK !!!		INX		STX	NLMV_CNT+1	;MAKE IT $01 - FLAG THAT NEWLINE AS LAStNLMX_BKROM	plb		jmp	NLMX_ROM					;NLM_SRCROM1				; 		CPY	#0		BNE	NLM_SRCROM					;		phb		lda	#^PFIBANK		pha		plb		INC	NLM_SRC+1		INC	NLM_DEST+1		INC	NLMV_CNT+1		ldx	NLMV_CNT+1		plb		txa		BNE	NLM_SRCROM** RESET	MAIN TRAP*NLMX_ROM				; 		tya			;get amount left to move		sta	>NLMV_CNT	;RECORD	AMOUNT LEFT TO MOVE*NLMX_ROM1				; 		ply		plx			;restore registers		plb			;recover original bank		RTS			;return	to caller;;;** IS THERE MORE	DATA TO	BE READ	?* (ANOTHER BLOCK ? )*READ9					; 		LDA	UTRANCNT	;CHECK TRANS COUNT		BNE	READ10		;YES THERE IS MORE !!!		LDA	UTRANCNT+1		BEQ	READ11		;NO, EXIT, NOWREAD10					; 		JMP	READ1		;GO SETUP IO BUFFER** SET THE TRANSFER COUNT & SIZE	OF PL TH BE RETURNED*READ11					; 		JSR	SETTRCNT		LDA	#$08		STA	RETURNPL** WAS SOME DATA	RETURNED  ?*		LDA	UERROR		BNE	car_OK		;THERE WAS AN ERROR;;		LDA	WS_PLIST+$06		ORA	WS_PLIST+$07		BNE	car_OK		;YES;		LDA	#$4C		;EOF		STA	UERROR;		LDX	UFILEIDX	;SET EOF STATUS		LDA	USTATUS,X		ORA	#%10000000	; MSD 13-Sep-89: changed %10000000 to #%10000000		STA	USTATUS,X** RESTORE REQUEST COUNT*car_OK		LDA	ORG_REQ		STA	WS_PLIST+$04	;RESTORE REQUEST COUNT		LDA	ORG_REQ+1		STA	WS_PLIST+$05	;RESTORE REQUEST COUNT		RTS			;RETURN;;;;		eject*** COMMAND $CB =	WRITE**		EXPORT	WRITEWRITE					;       ** CAN I	WRITE TO THIS FILE ?*		LDX	UFILEIDX		LDA	UMODE,X		;IS IT READ ONLY		AND	#%00000010	;WRITE MODE		BNE	WRITE0		;YES !!!;		LDA	#$4E		;ACCESS	ERROR		BRA	WRITE_X** IS THERE A REQUEST COUNT ?*WRITE0					; 		LDA	WS_PLIST+$04	;LB OF COUNT		ORA	WS_PLIST+$05	;HB OF COUNT		BEQ	WRITE_X					;					;					;====> 05/09/87	PROTECT	$C000 AREA					;** IS THE BUFFER	RUN TOO	HIGH ?*		CLC		LDA	WS_PLIST+$04		ADC	WS_PLIST+$02		LDA	WS_PLIST+$05		ADC	WS_PLIST+$03		bcs	Wrt_Buferr		CMP	#$C0		Bcc	Write0A					;Wrt_Buferr	lda	#$56		;Buffer	error		bra	Write_X** SAVE ORIGINAL	REQUEST	COUNT*Write0A		LDA	WS_PLIST+$05		STA	ORG_REQ+1	;SAVE HB ON STACK		LDA	WS_PLIST+$04		STA	ORG_REQ		;SAVE LB ON STACK** DOES THE MARK	WRAP AROUND ?** This routine will also adjust	request	count*		JSR	MARK_WRAP		BCC	WRITE1		LDA	#$4C		;END OF	FILE ERROR** write	exit routine*WRITE_X1				; 		LDY	ORG_REQ		STY	WS_PLIST+$04		LDY	ORG_REQ+1		STY	WS_PLIST+$05WRITE_X					; 		STA	UERROR		STZ	WS_PLIST+$06	;NO DATA TRANSFERRED		STZ	WS_PLIST+$07					;		LDA	#$08		STA	RETURNPL		RTS			;NO ERROR;;;;** YES  , WE CAN	WRITE TO IT* WHAT IS THE REQUEST COUNT (OVER 1 BLK) ?*WRITE1		JSR	RWSETUP		BCC	WRITE1A		;USE CHUNK CONTROL;					;----->		LDX	UFILEIDX		LDA	UTYPE,X		AND	#%00010000	;BUFFERING ???		BNE	WRITE1A		;NO BUFFERING;;---->** CAN I	READ THIS FILE ?*		LDX	UFILEIDX		LDA	UMODE,X		AND	#%00000001		BNE	WRITE2		;YES I CAN** WRITE	IS FOR OVER A BLOCK -- USE CHUNK CONTROL*WRITE1A					; 		JSR	WRT_CHKCNTL** RESTORE REQUEST COUNT*WRITE1B					; 		LDA	ORG_REQ+1	;SAVE HB ON STACK		STA	WS_PLIST+$05		LDA	ORG_REQ		;SAVE LB ON STACK		STA	WS_PLIST+$04		RTS			;DONE WITH WRITE;;** BLOCK	CONTROL** MAKE SURE THAT THE CORRECT BLOCK IS IN THE IO	BUFFER*WRITE2					; 		JSR	BLKCNTL		;CALL BLOCK CONTROL		BEQ	WRITE3		;BLOCK IS IN PLACE		JMP	WRITE7		;ERROR - SET TRANSFER COUNT** SET UP LOCATIONS TO MOVE DATA* (FROM	USER'S BUFFER -- TO IO BUFFER)*WRITE3					; 		LDX	UFILEIDX	;GET CURRENT USER		LDA	XBUFPTR		;SETUP USER BUF	PTR (SOURCE)		STA	<srcbuf		LDA	XBUFPTR+1		STA	<srcbuf+1;		LDA	PFI_BANK		STA	<srcbuf+2	;BANK;		LDA	UBUFPTRL,X	;SETUP FILE BUFR PTR (DESTINATION)		CLC		ADC	UMARK1,X		STA	<destbuf		LDA	UMARK2,X		AND	#%00000001		ADC	UBUFPTRH,X		STA	<destbuf+1;		LDA	PFI_BANK		STA	<destbuf+2	;BANK** FIND NUMBER OF BYTES TO THE END OF THE BLOCK ?*		SEC		LDA	#0		SBC	UMARK1,X	;SETUP COUNT TO	END		STA	<count		;OF BLOCK		LDA	UMARK2,X		AND	#%00000001		STA	UWORK1		LDA	#2		SBC	UWORK1		STA	<count+1** UPDATE THE MARK TO IT'S NEW LOCATION*		JSR	GETCOUNT	;SET MARK ETC** DO I NEED TO RESET THE EOB ?* (COMPARE EOB WITH NEW	MARK)*		LDX	UFILEIDX;		LDA	UEOB3,X		;BUG UPDATE 9/30/86		CMP	UMARK3,X		BCC	WRITE4		BNE	WRITE5;		LDA	UEOB2,X		;COMPARE EOB WITH MARK		CMP	UMARK2,X		BCC	WRITE4		BNE	WRITE5;		LDA	UEOB1,X		CMP	UMARK1,X		BCS	WRITE5** SET THE EOB TO THE NEW MARK LOCATION*WRITE4					; 		LDA	UMARK1,X	;SET NEW EOB		STA	UEOB1,X		LDA	UMARK2,X		STA	UEOB2,X		LDA	UMARK3,X		STA	UEOB3,X** SET STATUS - BLOCK HAS BEEN WRITTEN INTO*WRITE5					; 		LDA	USTATUS,X		ORA	#%00000001	;BLOCK WRITTEN INTO		STA	USTATUS,X** SET HOW TO MOVE THE DATA (MB TO MB)*		JSR	BUFFMOVE	;MOVE DATA** ARE THERE MORE BYTE TO TRANSFER ?* (ANOTHER BLOCK?)*		LDA	UTRANCNT		BNE	WRITE6		;MORE !!		LDA	UTRANCNT+1		BEQ	WRITE7AWRITE6					; 		JMP	WRITE2** IS THE BLOCK FULL ?*WRITE7A					; 		LDX	UFILEIDX		LDA	UEOB2,X		AND	#%00000001	;LOOK ONLY AT LOW BIT		ORA	UEOB1,X		;LOOK ALSO AT LOW BYTE		BNE	WRITE7		;NO, NOT A FULL	BLOCK;		JSR	WRITE_BLK	;FLUSH BLOCK TO	SERVER** WRITE	IS NOW DONE -- SET THE TRANSFER	COUNT*WRITE7					; 		JSR	SETTRCNT		LDA	#$08		STA	RETURNPL** RESTORE REQUEST COUNT*		LDA	ORG_REQ+1	;SAVE HB ON STACK		STA	WS_PLIST+$05		LDA	ORG_REQ		;SAVE LB ON STACK		STA	WS_PLIST+$04		RTS			;RETURN;;		eject*** COMMAND $CC =	CLOSE**		EXPORT	CLOSECLOSE					;       ** FIND REFERENCE # (CHECK FOR 0	WHICH MEANS ALL)*		STZ	PFI_RETRY		LDA	WS_PLIST+1	;GET REF #		TAX		DEX		STX	UFILEIDX		BPL	CLOSE2		;ORIGINAL REF #	WAS NOT	ZERO** CLOSE	ALL FILE (THIS LEVEL OR	HIGHER)*					;					;----> 6/21/88 TE for close all	bug					;		jsr	LOCAL					;					;----->	end					;CLOSE1					; 		INC	UFILEIDX	;CLOSE ALL FILES		LDX	UFILEIDX		CPX	#8		;END OF	TABLE ?		BEQ	cl1_DONE	;MORE TO LOOK AT;		LDA	UMODE,X		;IS THIS ENTRY ACTIVE ?		BEQ	CLOSE1		;GO TO NEXT FILE;		LDA	ULEVEL,X	;IF FILE LEVEL LESS THAN SYSTEM		CMP	Cn_LEVEL	;LEVEL DON'T CLOSE IT		BCC	CLOSE1		;GO TO NEXT FILE					;					;					;					;----> 6/21/88 TE for close all	bug					;					;					;		LDA	UFILELOC,X		CMP	#$FF		BNE	CLOSE1a		;FILE IS ON A SERVER !!!		stz	UMODE,x		bra	CLOSE1					;					;----->	end					;;CLOSE1a		JSR	CLOSE2		;TIME TO CLOSE A FILE !!!		BRA	CLOSE1;;cl1_DONE	LDA	PFI_RETRY		BEQ	cl_RTS		;NO ERROR;		LDA	#$27		;I/O ERROR		STA	UERRORcl_RTS		RTS			;ALL DONE !!!!;;;;** TIME TO CLOSE	A SINGLE FILE* WHERE	IS THE FILE LOCATED ?*CLOSE2					; 		LDA	UFILELOC,X		CMP	#$FF		BNE	CLOSE3		;FILE IS ON A SERVER !!!		JSR	LOCALREF	;GO LOCAL TO CLOSE FILE		BRA	CLOSE5		;REMOVE	FROM TABLE** CLOSE	IS FOR A SERVER** CLEAR	PRODOS SYSTEM BITMAP*CLOSE3					; 		LDX	UFILEIDX		LDA	UBUFPTRH,X		TAX		LDY	#$04		JSR	CHK_BITMAP	;TO MOVE BITMAP	TO CARD;		CLC			;CLEAR BITMAP		LDX	UFILEIDX		LDA	UBUFPTRH,X	;HB OF IO BUFFER		TAX		JSR	PDOS_BITMAP** IS IT	A DIRECTORY ?*		LDX	UFILEIDX		LDA	UTYPE,X		BMI	CLOSE5		;YES,IT	IS A DIR (NO NEED TO CLOSE)** CAN WE WRITE TO THIS FILE ?*		LDA	UMODE,X		CMP	#%00100000	;WRITE ???		BEQ	CLOSE4		;YES,WE	CAN WRITE** IS THE FILE IN READ MODE ?*		LDA	UMODE,X		AND	#%00000001	;READ MODE ?		BEQ	CLOSE4		;NO NEED TO FLUSH** HAS THE BLOCK	BEEN WRITTEN INTO*		LDA	USTATUS,X		AND	#%00000001	;WRITTEN INTO ?		BEQ	CLOSE4		;NO,NEED TO WRITE !!!;		LDA	UFILELOC,X		STA	CURSESS		;SPECIFY SERVER	TO SEND	IT TO;		JSR	WRITE_BLK	;WRITE CURR BLOCK;		LDA	UERROR		;WAS THERE AN ERROR ??		CMP	#$27		BEQ	CLOSE5;** CREATE CLOSE PACKET*CLOSE4					; 		LDA	#CLOSEFORK		STA	WS_COMBUF		STZ	WS_COMBUF+1;		LDX	UFILEIDX		LDA	UFILELOC,X		STA	CURSESS;		LDA	USRVNUM1,X		STA	WS_COMBUF+2		LDA	USRVNUM2,X		STA	WS_COMBUF+3		LDA	#4		STA	PKT_CNT		STZ	PKT_CNT+1** ISSUE	CLOSE FORK CALL*		JSR	CMD_ROUTING	;CALL ROUTING** REMOVE FILE/DIR FROM TABLES*CLOSE5					; 		LDX	UFILEIDX	;FREE FILE TABLE		STZ	UMODE,X					;       		LDA	UERROR		ORA	PFI_RETRY		STA	PFI_RETRY		RTS;;		eject*** COMMAND $CD =	FLUSH* *		EXPORT	FLUSHFLUSH					;       ** FIND REFERENCE # (CHECK FOR 0	WHICH MEANS ALL)*		STZ	PFI_RETRY		LDA	WS_PLIST+1	;GET REF #		TAX		DEX		STX	UFILEIDX		BPL	FLUSH2		;ORIGINAL REF# WAS NOT ZERO** FLUSH	ALL FILES (THIS	LEVEL OR HIGHER)*FLUSH1					; 		INC	UFILEIDX	;FLUSH ALL		LDX	UFILEIDX		CPX	#8		;END OF	TABLE ?		BEQ	fl1_DONE	;MORE TO LOOK AT;		LDA	UMODE,X		;IS THIS ENTRY ACTIVE ?		BEQ	FLUSH1		;GO TO NEXT FILE;		LDA	ULEVEL,X	;IF FILE LEVEL LESS THAN SYSTEM		CMP	Cn_LEVEL	;LEVEL DON'T CLOSE IT		BCC	FLUSH1		;GO TO NEXT FILE;		JSR	FLUSH2		;TIME TO FLUSH A FILE !!!		BRA	FLUSH1		;LOOK AT THE NEXT ENTRY;;;fl1_DONE	LDA	PFI_RETRY		BEQ	fl1_RTS		;NO ERROR;		LDA	#$27		;I/O ERROR		STA	UERRORfl1_RTS		RTS			;ALL DONE !!!!;;;;** TIME TO FLUSH	A SINGLE FILE* WHERE	IS THE FILE LOCATED ?*FLUSH2					; 		LDA	UFILELOC,X		CMP	#$FF		BNE	FLUSH3		;IT IS ON A SERVER		JSR	LOCALREF	;GO LOCAL TO FLUSH FILE		BRA	FL_RTS** FLUSH	IS FOR A SERVER* CAN WE WRITE TO THIS FILE ?*FLUSH3					; 		LDA	UTYPE,X		BMI	FL_RTS					;		LDA	UMODE,X		CMP	#%00100000	;WRITE ???		BEQ	FL_RTS** IS THE FILE IN READ MODE ?*FLUSH4					; 		LDA	UMODE,X		AND	#%00000001	;READ MODE ?		BEQ	FL_RTS		;NO NEED TO FLUSH** HAS THE BLOCK	BEEN WRITTEN INTO*		LDA	USTATUS,X		AND	#%00000001	;WRITTEN INTO ?		BEQ	FL_RTS		;NO,NEED TO WRITE !!!;		LDA	UFILELOC,X		STA	CURSESS		;SPECIFY SERVER	TO SEND	IT TO;		JSR	WRITE_BLK	;WRITE CURR BLOCK;		LDX	UFILEIDX		LDA	USTATUS,X		ORA	#%00001000	;BLOCK HAS BEEN	READ		STA	USTATUS,XFL_RTS					; 		LDA	UERROR		ORA	PFI_RETRY		STA	PFI_RETRY		RTS;;		eject*** COMMAND $CE =	SET MARK**		EXPORT	SETMARKSETMARK					;       ;;----->11/06/87	te for drop boxes;** is the suggested mark	lower than the old ?*		SEC		LDX	UFILEIDX		LDA	WS_PLIST+2		SBC	UMARK1,X		STA	UWORK1		;save adjust space - lb;		LDA	WS_PLIST+3		SBC	UMARK2,X		STA	UWORK2		;save adjust space - hb;		LDA	WS_PLIST+4		SBC	UMARK3,X		BCS	sm_EQUCHK		JMP	SETMARK5	;yes, clear eof	& update mark** are they equal ?** [A] has highest byte*sm_EQUCHK	ORA	UWORK1		ORA	UWORK2		BNE	sm_CONT		JMP	SETMARK6	;yes, update mark;;---->;** HAS THIS BLOCK BEEN READ IN YET ?*sm_CONT		LDX	UFILEIDX		LDA	USTATUS,X		AND	#%00001000	;BLK HAS BEEN READ ?		BEQ	SETMARK1	;GO GET	EOF !!!!** COMPARE MARK WITH CURRENT BLOCK (HIGH	BYTE)*		LDA	WS_PLIST+4		CMP	UCURBLKH,X	;CMP MARK WITH CURRBLK		BCC	SETMARK5	;IF > :	CHECK AGAINST EOF		BNE	SETMARK1	;GO GET	EOF !!!!** COMPARE MARK WITH CURRENT BLOCK (LOW BYTE)*		LDA	WS_PLIST+3		AND	#%11111110		CMP	UCURBLKL,X	;CMP MARK WITH CURRBLK		BCC	SETMARK5	;IF > :	CHECK AGAINST EOF		BNE	SETMARK1	;GO GET	EOF !!!!** MARK IS WITHIN THIS BLOCK . COMPARE MARK WITH	EOB* (DO THIS IN CASE THE END OF FILE IS IN THIS BLOCK)*;;  ---->>  08/05/87;		LDA	UEOB3,X		CMP	WS_PLIST+4	;CMP AGAINST EOB		BCC	SETMARK4	;RANGE ERROR		BNE	SETMARK5	;SET THE MARK !!!;;  ---->>;;		LDA	UEOB2,X		CMP	WS_PLIST+3	;CMP AGAINST EOB		BCC	SETMARK4	;RANGE ERROR		BNE	SETMARK5	;SET THE MARK !!!;		LDA	UEOB1,X		CMP	WS_PLIST+2		BCC	SETMARK4	;RANGE ERROR		BNE	SETMARK5	;SET THE MARK &	CLEAR EOF STATUS!!;; EOB =	NEW MARK; DON'T CLEAR EOF STATUS		BRA	SETMARK3A	; SET THE EOF STATUS & MARK !!!** TIME TO CHECK	EOF WITH SERVER* IS THIS A FILE OR A DIRECTORY	?*SETMARK1				; 		LDA	UTYPE,X		BPL	SETMARK2	;IT WAS	A FILE;		JSR	DIR_GETEOF		LDA	UERROR		BEQ	SETMARK3		RTS			;ERROR (UNABLE TO FIND EOF)** FIND EOF FOR FILE*SETMARK2				; 		JSR	FILE_GETEOF		LDA	UERROR		BEQ	SETMARK3		RTS			;ERROR (UNABLE TO FIND EOF)** COMPARE EOF TO MARK IN PARAMETER LIST* IS MARK SMALLER THAN EOF ?*SETMARK3				; 		LDX	UFILEIDX		LDA	FILE_SIZE+2		CMP	WS_PLIST+4	;CMP EOF WITH MARK		BCC	SETMARK4		BNE	SETMARK5;		LDA	FILE_SIZE+1		CMP	WS_PLIST+3		BCC	SETMARK4		BNE	SETMARK5					;		LDA	FILE_SIZE		CMP	WS_PLIST+2		BCC	SETMARK4	;OUT OF	RANGE		BNE	SETMARK5	;SET THE MARK &	CLEAR EOF STATUS!!;; EOB =	NEW MARK; DON'T CLEAR EOF STATUSSETMARK3A				; ; SET	EOF STATUS !!!		LDA	USTATUS,X		ORA	#%10000000		STA	USTATUS,X		BRA	SETMARK6	; SET THE MARK !!!** ERROR	- MARK IS OUT OF RANGE !!!*SETMARK4				; 		LDA	#$4D		STA	UERROR		;POSITION OUT OF RANGE		RTS** CLEAR	EOF BIT	IS STATUS BYTE*SETMARK5				; 		LDA	USTATUS,X		AND	#%01111111	;CLEAR EOF STATUS		STA	USTATUS,X** MARK IS OK --- SET IT	NOW !!!!!*SETMARK6				; 		LDX	UFILEIDX		LDA	WS_PLIST+2		STA	UMARK1,X		LDA	WS_PLIST+3		STA	UMARK2,X		LDA	WS_PLIST+4		STA	UMARK3,X		RTS;;		eject*** COMMAND $CF =	GET MARK**		EXPORT	GETMARKGETMARK					;       		LDX	UFILEIDX		LDA	UMARK1,X	;GET MARK		STA	WS_PLIST+2	;STORE IN LIST		LDA	UMARK2,X		STA	WS_PLIST+3		LDA	UMARK3,X		STA	WS_PLIST+4;		LDA	#$05		STA	RETURNPL		RTS;;		eject*** COMMAND $D0 =	SET EOF**		EXPORT	SETEOFSETEOF					;       ** IS THIS FILE WRITE ENABLED ?*		LDX	UFILEIDX		LDA	UMODE,X		AND	#%00000010	;WRITE MODE		BNE	SETEOF1		;YES WE	CAN WRITE TO IT;		LDA	#$4E		;ACCESS	ERROR		STA	UERROR		RTS** CREATE SET FORK PARMS*SETEOF1					; 		LDA	#SETFORKPARM		STA	WS_COMBUF	;SAVE COMMAND BYTE		STZ	WS_COMBUF+1	;ZERO BYTE;		LDA	USRVNUM1,X		STA	WS_COMBUF+2	;SAVE REF # HB		LDA	USRVNUM2,X		STA	WS_COMBUF+3	;SAVE REF # LB					;		BIT	UTYPE,X		;IS A RESOUCE OR A DATA	FORK ?		BVC	d0_SETDATA		LDA	#%00000100	;SET EOF FOR RESOURCE FORK		BRA	d0_SETBITS;d0_SETDATA	LDA	#%00000010	;SET EOF FOR DATA FORKd0_SETBITS	STA	WS_COMBUF+4	;SAVE BITMAP HB		STZ	WS_COMBUF+5	;SAVE BITMAP LB;		STZ	WS_COMBUF+6	;'FOREST' FILE BYTE;		LDA	WS_PLIST+4		STA	WS_COMBUF+7		LDA	WS_PLIST+3		STA	WS_COMBUF+8		LDA	WS_PLIST+2		STA	WS_COMBUF+9;		LDA	#$0A		STA	PKT_CNT		STZ	PKT_CNT+1** ISSUE	AFP SET	FORK PARAMETERS*		JSR	CMD_ROUTING	;EXECUTE ON SERVER		BCC	SETEOF3		;CALL COMPLETED	OK		RTS;;---->11/07/87 te -- drop box;** if this is an	open ($C8) & it	is in drop box Mode,* then set local EOF*SETEOF3					; 		LDX	UFILEIDX		LDA	UTYPE,X		AND	#$08		;bit 3 = normal	open ($C8) ???		BEQ	seof3_over	;no, special open;		LDA	UMODE,X		CMP	#$32		;drop box ??		BNE	seof3_over	;no, some other	mode;;		LDX	UFILEIDX	;update	Local EOF		LDA	WS_PLIST+2		STA	UDIRID1,X		LDA	WS_PLIST+3		STA	UDIRID2,X		LDA	WS_PLIST+4		STA	UDIRID3,X;;---->;seof3_over				; 		SEC		LDX	UFILEIDX		LDA	UMARK1,X		SBC	WS_PLIST+2;		LDA	UMARK2,X		SBC	WS_PLIST+3;		LDA	UMARK3,X		SBC	WS_PLIST+4		BCC	SETEOF5		;MARK IS LESS THAN EOF !!!** RESET	THE MARK !!!*SETEOF4					; 		LDA	WS_PLIST+2		STA	UMARK1,X		LDA	WS_PLIST+3		STA	UMARK2,X		LDA	WS_PLIST+4		STA	UMARK3,X** SET OR CLEAR EOF STATUS !!!*		LDA	USTATUS,X		ORA	#%10000000	;SET EOF STATUS		BRA	SET5ASETEOF5					; 		LDA	USTATUS,X		AND	#%01111111	;CLEAR EOF STATUSSET5A		STA	USTATUS,X** DO I NEED TO RESET THE BLOCK ?*		LDX	UFILEIDX		LDA	USTATUS,X		AND	#%00001000	;HAS THE BLOCK BEEN READ ?		BNE	d0_SETEOF5A	;YES IT	HAS		RTS			;LEAVE FOR NOW;;d0_SETEOF5A	LDA	WS_PLIST+4		CMP	UCURBLKH,X	;COMPARE EOF WITH CURRBLK		BCC	SETEOF7		;CLEAR CURRENT BLOCK READ		BNE	SETEOF8		;RESET EOB TO END OF BUFFER					;		LDA	WS_PLIST+3		AND	#%11111110		CMP	UCURBLKL,X		BCC	SETEOF7		;CLEAR CURRENT BLOCK READ		BNE	SETEOF8		;RESET EOB TO END OF BUFFER** DO I NEED TO RESET THE EOB WITHIN THE	BLOCK ?*		LDA	WS_PLIST+3		CMP	UEOB2,X		;COMPARE EOF WITH EOB		BNE	SETEOF6		;RESET EOB;		LDA	WS_PLIST+2		CMP	UEOB1,X		BNE	SETEOF6		;RESET EOB		RTS			;ALL DONE !!!** RESET	THE END	OF BLOCK (WITHIN BLOCK)*SETEOF6					; ;RESET EOB		LDA	WS_PLIST+2		STA	UEOB1,X		LDA	WS_PLIST+3		STA	UEOB2,X		RTS** RESET	THE STATUS FOR THIS BLOCK*SETEOF7					; ;RESET CURR BLK		LDA	USTATUS,X		AND	#%11110111	;BLOCK HAS NOT BEEN READ		STA	USTATUS,X		RTS** RESET	EOB TO THE END OF BLOCK*SETEOF8					; 		LDX	UFILEIDX		STZ	UEOB1,X					;		LDA	UCURBLKL,X		AND	#%11111110					;		CLC		ADC	#$02		;ONE BLOCK!!!		STA	UEOB2,X		;MED BYTE OF EOB;		LDA	UCURBLKH,X		ADC	UCURBLKH,X		STA	UEOB3,X		;HB BYTE OF EOB		RTS;;		eject*** COMMAND $D1 =	GET EOF**		EXPORT	GETEOFGETEOF					;       ** HAS THIS BLOCK BEEN READ IN	?*		LDX	UFILEIDX		LDA	USTATUS,X		AND	#%00001000		BEQ	GETEOF1		;NOT READ IN YET** IS THE EOB IN	THIS BLOCK ?*		LDA	UEOB2,X		AND	#%11111110		CMP	UCURBLKL,X		BNE	GETEOF1		;NOT THIS BLOCK;		LDA	UEOB3,X		CMP	UCURBLKH,X		BNE	GETEOF1		;NOT THIS BLOCK** MOVE END OF BLOCK INTO PARAMETER LIST*		LDA	UEOB1,X		STA	WS_PLIST+2		LDA	UEOB2,X		STA	WS_PLIST+3		LDA	UEOB3,X		STA	WS_PLIST+4		BRA	GETEOF5		;ALL DONE !!** ASK SERVER ABOUT END OF FILE* IS IT	A DIRECTORY ?*GETEOF1					; 		LDA	UTYPE,X		BPL	GETEOF2		;IT WAS	A FILE		JSR	DIR_GETEOF		LDA	UERROR		BEQ	GETEOF3		;MOVE INTO PARAMETER LIST		RTS			;ERROR** FIND FILE - EOF !!*GETEOF2					; 		JSR	FILE_GETEOF		LDA	UERROR		BEQ	GETEOF3		;MOVE INTO PARAMETER LIST		RTS			;ERROR - LEAVE** MOVE EOF FROM	WS_COMBUF INTO WORKSTATION PARAMETER LIST*GETEOF3					; 		LDA	FILE_SIZE+2	;MOVE EOF TO CALLER'S LIST		STA	WS_PLIST+4		LDA	FILE_SIZE+1		STA	WS_PLIST+3		LDA	FILE_SIZE		STA	WS_PLIST+2** TIME TO EXIT - NO ERROR !!!*GETEOF5					; 		LDA	#$05		STA	RETURNPL		RTS;;		eject*** COMMAND $D2 =	SET BUF** HANDLED LOCALLY IN TABLES**		EXPORT	SETBUFSETBUF					;       ** CHECK	IO BUFFER ADDRESS*		LDA	WS_PLIST+$02		BNE	d2_BUFFBAD;;		LDX	WS_PLIST+$03					;					;----->	6/2/88					;	    		cpx	#$C0		bcs	d2_BUFFBAD					;					;----->	end					;		LDY	#$04		JSR	CHK_BITMAP		BCC	d2_CONT;d2_BUFFBAD	LDA	#$56		STA	UERROR		RTS** TAKE BITS FOR	NEW BUFFER*d2_CONT		SEC			;SET BITMAP		LDX	WS_PLIST+$03	;HB OF IO BUFFER		JSR	PDOS_BITMAP** FREE ejectS OF OLD IO	BUFFER ADDRESS*		LDX	UFILEIDX		LDA	UBUFPTRH,X		TAX		CLC		JSR	PDOS_BITMAP** SET UP FOR BUFFER MOVE*		LDX	UFILEIDX		LDA	UBUFPTRL,X	;GET BUFR PTR FROM		STA	<SRCBUF		;TBL - SOURCE BUFFER		LDA	UBUFPTRH,X		STA	<SRCBUF+1;		LDA	PFI_BANK		STA	<SRCBUF+2	;BANK*		LDA	WS_PLIST+2	;STORE NEW PTR		STA	UBUFPTRL,X	;IN TBL	AND WS_ZP2		STA	<DESTBUF		LDA	WS_PLIST+3		STA	UBUFPTRH,X		STA	<DESTBUF+1;		LDA	PFI_BANK		STA	<DESTBUF+2	;BANK*		STZ	<COUNT		LDA	#%00000100	;BOTH OF CARD LOCATIONS,1024 BYTES		STA	<COUNT+1		JMP	BUFFMOVE	;MOVE BUFFER;;		eject*** COMMAND $D3 =	GET BUF**   HANDLED LOCALLY IN TABLES**		EXPORT	GETBUFGETBUF					;       		LDX	UFILEIDX		LDY	#2		LDA	UBUFPTRL,X	;GET BUFR PTR		STA	WS_PLIST+2	;SAVE IN LIST		LDA	UBUFPTRH,X		STA	WS_PLIST+3;		LDA	#$04		STA	RETURNPL		RTS;;		eject*** COMMAND $65 =	QUIT**   HANDLED LOCALLY**		EXPORT	QUITCALLQUITCALL				;       ** DON'T ALLOW NORMAL QUIT CALL IF 'DIRECT' IS SET*** MAKE CALL TO LOCAL PRODOS*QUIT1					; 		ldx	#$FF		txs		Jmp	DO_JSRLOCAL	;SEND MOTHERBOARD TO LOCAL PRODOS;;		eject*** COMMAND $44 =	BYTE RANGE LOCK**   (SPECIAL NETWORK CALL)**		EXPORT	BYTELOCKBYTELOCK				;       ** CHECK	BYTE LOCK FLAG TO SEE IF IT IS VALID ??** 1. EXTRA BITS	SET* 2. UNLOCK RELATIVE TO	EOF* 3. LENGTH OF ZERO* 4. LOCK RELATIVE TO START*;; CHECK	#1 -- EXTRA BITS SET ???;		LDA	WS_PLIST+2	;		AND	#%11000001		CMP	WS_PLIST+2		BNE	bl_PARM		;EXTRA BITS SET;; CHECK	#2 -- UNLOCK RELATIVE TO EOF ??;		ROR	a		;IS BIT	0 SET ?? (LOCK/UNLOCK)		BCC	bl_NEXT1		AND	#%01000000	;IS IT RELATIVE	TO EOF ??		BNE	bl_PARM;; CHECK	#3 -- LENGTH OF	ZERO;bl_NEXT1	LDA	WS_PLIST+6		ORA	WS_PLIST+7		ORA	WS_PLIST+8		BEQ	bl_PARM;; CHECK	#4 -- LOCK BEFORE START;		BIT	WS_PLIST+2		BMI	bl_OK		;RELATIVE TO EOF		BVC	bl_OK		;NOT BEFORE;;bl_PARM		LDA	#$53		STA	UERROR		RTS;;** CREATE BYTE LOCK PACKET*bl_OK		LDA	WS_PLIST+2		AND	#%10000001	;LEAVE BITS 7 &	0		STA	WS_COMBUF+$01	;SAVE LOCK FLAG;		STZ	PFI_RETRY** FIND OFFSET IN FILE (PLUS/ MINUS)*		STZ	WS_COMBUF+$04	;OFFSET	IN FILE		LDA	WS_PLIST+5		STA	WS_COMBUF+$05		LDA	WS_PLIST+4		STA	WS_COMBUF+$06		LDA	WS_PLIST+3		STA	WS_COMBUF+$07;		BIT	WS_PLIST+2	;lock flag byte		BVC	BYTE_LOOP;		SEC			;MAKE THIS A TWO'S COMPLETMENT		LDA	#$00		;OFFSET	IN THE FILE		SBC	WS_COMBUF+$07		STA	WS_COMBUF+$07		LDA	#$00		SBC	WS_COMBUF+$06		STA	WS_COMBUF+$06		LDA	#$00		SBC	WS_COMBUF+$05		STA	WS_COMBUF+$05		LDA	#$00		SBC	WS_COMBUF+$04		STA	WS_COMBUF+$04;;;BYTE_LOOP				; 		LDA	#BYTERANGE		STA	WS_COMBUF					;		LDX	UFILEIDX		LDA	USRVNUM1,X		STA	WS_COMBUF+$02		LDA	USRVNUM2,X		STA	WS_COMBUF+$03;		STZ	WS_COMBUF+$08	;LENGTH	TO LOCK		LDA	WS_PLIST+8		STA	WS_COMBUF+$09		LDA	WS_PLIST+7		STA	WS_COMBUF+$0A		LDA	WS_PLIST+6		STA	WS_COMBUF+$0B;		LDA	#$0C		STA	PKT_CNT		;SIZE OF PACKET		STZ	PKT_CNT+1					;		LDX	UFILEIDX		LDA	UFILELOC,X	;LOCATION OF SERVER		STA	CURSESS** ISSUE	COMMAND	TO SERVER*		JSR	CMD_ROUTING		BCC	BYTELOCK3;		LDA	UERROR		CMP	#$53		;PARM ERROR ????		BNE	DONENOW;RANGE		LDA	#$4D		;RANGE ERROR (too Long)		STA	UERRORDONENOW		RTS** is the lock out of range ???*BYTELOCK3				; 		LDA	PFI_RETRY		BNE	RANGE		;second	time all done;		LDA	WS_PLIST+2		AND	#%00000001	;unlock	????		BNE	bl1_OK		;yes, unlock !!!;;		CLC		LDA	WS_COMBUF+3		ADC	WS_PLIST+6		LDA	WS_COMBUF+2		ADC	WS_PLIST+7		LDA	WS_COMBUF+1		ADC	WS_PLIST+8		LDA	WS_COMBUF		ADC	#$00		CMP	#$00		BEQ	bl1_OK** need to unlock lock due to range*		INC	PFI_RETRY;		LDA	WS_COMBUF		STA	WS_COMBUF+$04	;OFFSET	IN FILE		LDA	WS_COMBUF+1		STA	WS_COMBUF+$05		LDA	WS_COMBUF+2		STA	WS_COMBUF+$06		LDA	WS_COMBUF+3		STA	WS_COMBUF+$07;		LDA	#$01		;unlock		STA	WS_COMBUF+$01	;SAVE LOCK FLAG		JMP	BYTE_LOOP	;issue call to unlock range;;** PLACE	START OF LOCK IN PARAMETER LIST*bl1_OK		LDX	#$02		LDY	#$00BYTELOCK4				; 		LDA	WS_COMBUF+1,X		STA	WS_PLIST+9,Y		INY		DEX		BPL	BYTELOCK4;		LDA	#$0C		;AMOUNT	TO RETURN TO MB		STA	RETURNPL		RTS;;*** COMMAND $81 =	GETTIME**    HANDLED LOCALLY**		EXPORT	GETTIMEGETTIME					;       *** IS THERE A LOCAL CLOCK (CHECK	GLOBAL PAGE) ?*		LDA	>$bf98		;check prodos global		ROR	a		BCC	gt_CHKSRV	;NO LOCAL CLOCK;		JSR	LOCAL		BRA	gt_ERROR** IS THERE A SESSION OPEN ??*gt_CHKSRV	LDX	#$00gt_LOOP		LDA	SESSION_TBL,X		BNE	gt_DOIT		INX		CPX	#MAXSESSION		BNE	gt_LOOP		BRA	gt_ERROR	;NO SESSION GOING** CREATE & SEND	REQUEST	FOR SERVER INFO*gt_DOIT		STA	CURSESS		;SAVE CURRENT SESSION;		LDA	#16		STA	WS_COMBUF					;		LDA	#$01		STA	PKT_CNT		STZ	PKT_CNT+1;		JSR	CMD_ROUTING		BCC	gt_OK;gt_ERROR	STZ	UERROR		RTS** CONVERT TIME INTO PRODOS TIME*gt_OK		LDX	#$03gt_LOOP1	LDA	WS_COMBUF,X		STA	AFP,X		DEX		BPL	gt_LOOP1;		JSR	FROM_SEC;		LDX	#$03gt_LOOP2	LDA	PRO_TIME,X		STA	>$bf90,X	;store directly	into prodos global page		DEX		BPL	gt_LOOP2		STZ	UERROR		RTS;;		ENDP		end