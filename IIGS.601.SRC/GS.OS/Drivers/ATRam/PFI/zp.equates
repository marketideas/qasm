ZP0			equ		$80							;-\LISTPTR		equ		ZP0							;	|ZP1			equ		ZP0+4						;	|ZP2			equ		ZP1+4						;	|Must be in this orderZP_HP		equ		ZP2+4						;-/MZP			equ		ZP_HP+4						;(2)ZP3			equ		MZP+4ZP4			equ		ZP3+4*SRCBUF		equ		ZP4+4						;(4) BUFF MOVE SOURCE BUFFERDESTBUF		equ		SRCBUF+4				;(4) BUFF MOVE DEST BUFFERCOUNT		equ		DESTBUF+4				;(2) BUFF MOVE COUNT FIELDpfizplen	equ		count+2-ZP0				;save this much zp**END OF ZERO PAGE !!!!!*