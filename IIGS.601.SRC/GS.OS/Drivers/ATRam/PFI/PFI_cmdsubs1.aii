;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	IMPORT	ACCESS	IMPORT	AFP	IMPORT	AFP_DIR_ID	IMPORT	AFP_PFXLOC	IMPORT	AFP_PFX_DEV	IMPORT	AFP_PREFIX	IMPORT	AFP_VOL_ID	IMPORT	ATTRIBUTE	IMPORT	AUN_RAM	IMPORT	BUFFMOVE	IMPORT	BYTE2BLKS	IMPORT	CALC_DIRINFO	IMPORT	CHKDBL	IMPORT	CHKSLASH	IMPORT	CHK_BITMAP	IMPORT	CHK_PRODOS	IMPORT	CHK_VOLUME	IMPORT	CMDCODE	IMPORT	CMDTYPE	IMPORT	CMD_ROUTING	IMPORT	CURSESS	IMPORT	Cn_DEVNUM	IMPORT	Cn_ERROR	IMPORT	Cn_LEVEL	IMPORT	Cn_PFIERR	IMPORT	Cn_PFIXPTR	IMPORT	DO_JSRLOCAL	IMPORT	FILE_BLKS	IMPORT	FILE_SIZE	IMPORT	FIRST_MOUNT	IMPORT	FND_CURSRV	IMPORT	FROM_ATTRI	IMPORT	FROM_SEC	IMPORT	INTO_ATTRI	IMPORT	INTO_SEC	IMPORT	LOCAL	IMPORT	LOCALREF	IMPORT	MCPADDR	IMPORT	NDT_CNT	IMPORT	NDT_IDH	IMPORT	NDT_IDL	IMPORT	NDT_IDX1	IMPORT	NDT_IDX2	IMPORT	NDT_NAME	IMPORT	NDT_SESS	IMPORT	NDT_UNIT	IMPORT	NEW_PREFIX	IMPORT	OFFSPRING	IMPORT	PATH2BUF	IMPORT	PATH2CARD	IMPORT	PCOUNT	IMPORT	PDOS_BITMAP	IMPORT	PDOS_DEVICE	IMPORT	PFI_CLEANUP	IMPORT	PFI_NAMING	IMPORT	PFI_NODEV	IMPORT	PKT_CNT	IMPORT	PRO_DIR_ID	IMPORT	PRO_PFXLOC	IMPORT	PRO_PFX_DEV	IMPORT	PRO_PREFIX	IMPORT	PRO_TIME	IMPORT	PRO_VOL_ID	IMPORT	PUN_ROM	IMPORT	REMOVE_DEV	IMPORT	RETURNPL	IMPORT	SESSION_TBL	IMPORT	SESS_TMRTBL	IMPORT	STRIP_PREFIX	IMPORT	STUFF_IDS	IMPORT	UBUFPTRH	IMPORT	UCMDIDX	IMPORT	UDEVNUM	IMPORT	UERROR	IMPORT	UFILEIDX	IMPORT	UFILELOC	IMPORT	UMODE	IMPORT	UWORK1	IMPORT	UWORK2	IMPORT	WS_COMBUF	IMPORT	WS_PATH	IMPORT	WS_PLIST	IMPORT	WS_PREPATH	IMPORT	ZP_BANK	IMPORT	cn_cmdpdos	IMPORT	cn_wsicmd	IMPORT	cn_wsipl	IMPORT	pfi_bank	IMPORT	pfisavezparea	IMPORT	setup	IMport	Active8;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	MLIPROC** pfi_cmdsubs1** Greg Seitz (28-Jul-87)**;		EXPORT	zpcmdscs1	;zpcmdscs1	PROC		INCLUDE	'zp.equates';		ENDP		include	'global.equates'		include	'pfi_equates'				EXPORT	pficmdsubs1	pficmdsubs1	PROC*		using	atpequates*		using 	pfiglobals*		using	zpcmdscs1			longa	off			longi	off			eject** PARAMIS NETWORK SOFTWARE***	CONFIDENTIAL*** MODULE : PFI - PRODOS FILING INTERFACE	(PART 1)*	1) INITIALIZE*	2) DISPATCH*	3) COMMAND INTERPRETER*	4) HOUSEKEEPING CALLS (8 MLI CALLS)** WRITTEN BY Thomas Eager** MODIFIED:	06-15-87	10:00 TE**	COPYRIGHT 1986,87	PARAMIS CORPORTATION** ALL RIGHTS RESERVED*			eject**** PRODOS FILING INTERFACE DISPATCH***		EXPORT	DISPATCH_PFIDISPATCH_PFI		;					phb					;save bank on entry			phy					;save y reg			tax					;move pointer to command			sta		>cn_cmdpdos			lda		>0,x		;get command			sta		>cn_wsicmd	;save it			lda		>1,x		;get pointer to parm list			sta		>cn_wsipl			lda		>pdos_level	;get level from pdos global area			sta		>Cn_LEVEL	;and save for internal use			jsr		callpdosdispatch	;do the dispatch			rep		#mbit+xbit	;restore the y reg			ply			sep		#mbit		;now set error code of a			pha			lda		Cn_DEVNUM	;get device num to tell prodos			beq		checkpfixptr	;don't save this if zero			sta		>pdos_devnum	;and store to prodoscheckpfixptr	; 			lda		Cn_PFIXPTR			inc		a			;see if was $ff, now $0 if it was (carry not effected)			beq		recovererr	;nope, so don't move it			dec		a			;put it back to where it was			sta		>pdos_pfixptr	;save pfix active flagrecovererr	; 			pla					;recover error condition			rep		#mbit+xbit+vbit	;show we claimed it			plb					;restore bank before exiting			rtl					;and return			longa	off			longi	offsavezp	; ;save off zp here			ldx		#pfizplen	;amount to savesavezplp	; 			lda		>ZP0,x		;get a byte to save			sta		pfisavezparea,x	;and save it			dex			bpl		savezplp	;keep looping while bytes to save			rts					;and returnrestorezp	; 			ldx		#pfizplen	;amount to restorerestorezplp	; 			lda		pfisavezparea,x	;get a byte from storage			sta		>ZP0,x		;and restore the zp it used			dex			bpl		restorezplp			rts** getmbpl* copies the users parm list to ws_plist, so we can* work on a copy of their list and not their list directly*		EXPORT	getmbplgetmbpl		;					lda		cn_wsipl			sta		<srcbuf			lda		cn_wsipl+1			sta		<srcbuf+1			;			;-----> 5/31/88 CHECK TO SEE IF IT IS ZERO PAGE			;			BNE		GETMBPL0			LDA		ZP_BANK			BRA		GETMBPL1			;			;GETMBPL0	lda		pfi_bankGETMBPL1	sta		<srcbuf+2			;			;			;-----> END			;			LDY		#PFI_PLMAX-1L_LOOP1		LDA		[srcbuf],Y			STA		WS_PLIST,Y			DEY			BPL		L_LOOP1		;MORE TO MOVE			rtscallpdosdispatch	; 			jsr		setup			jsr		savezp		;save our zp use			jsr		pdosdispatch			pha					;save error code			jsr		restorezp	;and restore our zp use			pla					;recover error code			rtspdosdispatch	; 								;								;-----> 4/4/88 TE								;								; This is placed here to make sure that								; Local Prodos can function with RAMForbid.								; If RamForbid has been called don't check Timers								; for each of the sessions.								; 			LDA		>AT_Lockout			bne		ProDOS_DIS								;								;-----> end								;								;								;								;----->3/11/88 te								;								; this checks the time since the last PFI								; communication for each of the sessions.  								;  								; If more that 1 minute has expired, then a								; get server params packet is sent to the server.								; This packet was chosen because :								;    1) No Disk hit on the server side								;    2) Only packet per server								;    3) Command Packet is small (one byte) 								;** is this entry in the table active*			ldx		#$00TMR_loop	phx			lda		SESSION_TBL,x			beq		TMR_skip** Find the Session's Timer*			sta		CURSESS			txa			asl		a			tax			lda		SESS_TMRTBL,x			sta		ZP1			inx			lda		SESS_TMRTBL,x			sta		ZP1+1** Has the timer Expired ?*			ldy		#$02			lda		(zp1),y		;has the timer expired ??			bne		TMR_skip	;not done yet** build packet to send to the server*			lda		#16			;Get Server Parms			sta		WS_COMBUF			;			lda		#$01			sta		PKT_CNT			STZ		PKT_CNT+1			;			JSR		CMD_ROUTING		;reinstall timer in here** any more Sessions to look at ??*TMR_skip	plx			inx			cpx		#$08			Bne		TMR_loop								;								; -----> end								;							** INITIALIZE VALUES*ProDOS_DIS	STZ		RETURNPL	;SIZE OF PL TO BE RETURNED TO MB			STZ		Cn_DEVNUM	;IF NONZERO = LAST DEVICE ACCESS			STZ		UERROR		;INIT ERROR CODE			STZ		Cn_PFIERR	;init PFI ERROR;			LDA		#$FF			STA		Cn_PFIXPTR	;IF NOT $FF THE PREFIX LOCATION			STA		UFILEIDX	;REFERENCE INDEX NUMBER** WAS THERE A SHUTDOWN WITH VOLUMES*			LDA		PFI_NODEV			BEQ		PDCLEANUP	;NO			JSR		REMOVE_DEV			STZ		PFI_NODEV** INITIALIZE OPEN MODE FOR FILES IF NEEDED*PDCLEANUP	; 			LDA		PFI_CLEANUP			Bpl		L_CONT;								;								;---> 3/2/88 te								;								;** INIT NETWORK DEVICE TABLE*			ldx		#13PD_LOOP2	lda		NDT_SESS,X			beq		PD_skip			phx			lda		NDT_UNIT,X			CLC			JSR		PDOS_DEVICE			PLX			STZ		NDT_SESS,XPD_skip		DEX			BPL		PD_LOOP2** MOVE ALL POSSIBLE UNIT NUMBERS FROM ROM TABLE INTO RAM*			LDX		#0PD_LOOP3	LDA		PUN_ROM,X	;POSSIBLE UNIT NUMBERS			STA		AUN_RAM,X	;AVAILABLE UNIT NUMBERS			INX			CPX		#14			BCC		PD_LOOP3;			LDA		#$FF			STA		AUN_RAM,X	;END INDICATOR			STZ		NDT_CNT		;NUMBER OPF MOUNTED VOLUMES			STZ		FIRST_MOUNT	;FLAG FOR FIRST MOUNT !!!								;								;								;----> end								;								;			LDX		#$10		;ANYTHING BELOW $C0 (this was lda)			LDY		#$04		;# OF Pages			JSR		CHK_BITMAP	;DON'T CARE ABOUT RESULTS;			LDX		#7L_LOOP1A	LDA		UMODE,X		;IS THIS ONE ACTIVE ??			BEQ		L_LOOP1C	;NO, NOT OPEN;			LDA		UFILELOC,X	;WHERE IS IT LOCATED ??			CMP		#$FF		;LOCAL ?			Beq		L_LOOP1C	;NETWORK SERVER;			PHX					;SAVE INDEX			LDA		UBUFPTRH,X			TAX			CLC					;CLEAR BITMAP			JSR		PDOS_BITMAP			PLX					;RESTORE INDEX;			STZ		UMODE,XL_LOOP1C	DEX			BPL		L_LOOP1A;			STZ		PFI_CLEANUP	;CLEAR FLAG** IS THERE A LOCAL PRODOS ?*L_CONT	; 			lda 	Active8			bne 	L_DSP0				;FIXED *** TGH & TDE 3/24/89 (beq)			lda		#$0f			sta 	Cn_Level** MOVE MLI PARAMETER LIST INTO PFI AREA*L_DSP0		jsr		getmbpl				;copy parm list from main to here** FIND MLI COMMAND IN THE COMMAND TABLE*			LDX		#0L_DSP2		LDA		CMDCODE,X	;FIND COMMAND IN TBL			BEQ		L_DSP3			CMP		Cn_WSICMD			BEQ		L_DSP4		;COMMAND IS FOUND IN THE TABLE			INX			BRA		L_DSP2L_DSP3		LDA		#$01		;INVALID COMMAND			STA		UERROR			JMP		END_CMD** IS THIS A SPEICAL PCOUNT CASE ($C4 , $C8 , $43 ) ?*L_DSP4		STX		UCMDIDX		;SAVE TABLE INDEX			LDA		CMDCODE,X	;FIND COMMAND IN TBL			CMP		#$82		;GET TIME?			BEQ		L_DSP5			TAY					;PLACE COMMAND IN Y			LDA		WS_PLIST	;GET PCOUNT IN A			CPY		#$C8		;STRIP OUT HIGH BITS OF PCOUNT			BEQ		L_DSP4A			CPY		#$43			BNE		L_DSP4B;L_DSP4A		AND		#%00011111L_DSP4B		CPY		#$C4			BNE		L_DSP4C			AND		#%00111111	;STRIP OUT HIGH BITSL_DSP4C	; 			CMP		PCOUNT,X			BEQ		L_DSP5		;CONTINUE;			LDA		#$04		;BAD PARAMETER COUNT			STA		UERROR			JMP		END_CMD;;**	**** CHECK BIT 0 *****	IS THIS AN ONLY LOCAL TYPE CALL ?*L_DSP5		LDA		CMDTYPE,X			AND		#%00000001	;LOCAL CALL ?			BEQ		L_DSP6		;NO, NOT A LOCAL CALL			JMP		GO_LOCAL	;YES, EXECUTE LOCALLY;;**	**** CHECK BIT 2 *****	DOES THIS CALL HAVE A REFERENCE NUMBER ?*L_DSP6		LDA		CMDTYPE,X			AND		#%00000100	;REF # NEEDED ?			BEQ		L_DSP9		;NO REF # IS NEEDED !!!** IS REFERENCE NUMBER ZERO ?*			LDA		WS_PLIST+1	;CHECK REF # RANGE			BNE		L_DSP7		;NON-ZERO --> CHECK SIZE** IS THIS A CLOSE ALL OR FLUSH ALL ?*			LDA		Cn_WSICMD			CMP		#$CC		;CLOSE ALL ??			BEQ		L_DSP8		;YES GO DO IT !!!;			CMP		#$CD		;FLUSH ALL ??			BEQ		L_DSP8		;YES GO DO IT !!!			BRA		L_DSP8_A		;ERROR --> ZERO NOT VALID;;** IS THIS LESS THAN THE MAX ACCEPTED?*L_DSP7		CMP		#9			BCS		L_DSP8_A	;ERROR --> TOO LARGE** IS THIS AN ACCEPTABLE REFERENCE NUMBER ?*			TAX			DEX			LDA		UMODE,X		;IS THIS ENTRY ACTIVE ??			BEQ		L_DSP8_A	;INVALID REFERENCE #** IF THIS IS A CLOSE OR FLUSH GO TO COMMAND*			LDA		Cn_WSICMD			CMP		#$CC		;CLOSE ALL ??			BEQ		L_DSP8		;YES GO DO IT !!!			CMP		#$CD		;FLUSH ALL ??			BEQ		L_DSP8		;ERROR --> ZERO NOT VALID** SAVE COMMAND INDEX AND SESSION NUMBER*			STX		UFILEIDX	;SAVE REF # INDEX			LDA		UFILELOC,X			STA		CURSESS		;SAVE CURRENT SESSION NUMBERL_DSP8		JMP		GO_CMD;L_DSP8_A		LDA		#$43		;INVALID REF #			STA		UERROR			JMP		END_CMD;;**	**** CHECK BIT 3 *****	DOES COMMAND HAVE A PATHNAME ?*L_DSP9		LDA		CMDTYPE,X			AND		#%00001000			BNE		L_DSP9_A			JMP		L_DSP11		;NO PATHNAME REQUIRED !!!** THE PATHNAME DETERMINES WHETHER THE CALL IS EXECUTED LOCALLY* OR OVER THE NETWORK.** IF VOLUME IS SPECIFIED (SLASH IS FIRST CHARACTER OF NAME)*	VOL IS NOT MOUNTED - GO LOCAL*	VOL IS	MOUNTED - GO OVER NETWORK** IF VOLUME IS NOT SPECIFIED (FIRST CHARACTER NOT A SLASH)*	PREFIX IS LOCAL (...PFXLOC = $FF) - GO LOCAL*	PREFIX IS A SERVER	- GO OVER NETWORK** SPECIAL CASES*	1. OPEN IS MONITOR REGARDLESS OF PATHNAME*	2. SET PREFIX IS MONITORED WHEN THE VOLUME IS SPECIFIED AND*	AND IT IS MOUNTED (NEED TO KNOW THE RESULT)*** MOVE NAME ONTO THE CARD*L_DSP9_A		JSR		PATH2CARD	;MOVE NAME ONTO THE CARD			BCC		L_DSP9_A1			JMP		L_DSP9_ERR	;UNABLE TO GET NAME ON CARD** IS THE LENGTH ZERO OR ONE ?*L_DSP9_A1	LDA		WS_PATH			CMP		#$02			BCS		L_DSP9_C		;PATH IS LONGER** IS THIS A VALID PATH ?*			LDA		WS_PATH			BEQ		L_DSP9_B		;NO LENGTH			LDA		WS_PATH+1			CMP		#SLASH			BNE		L_DSP9_C		;OK IT IS ANOTHER CHARACTER** IS THIS A SET PREFIX ?*L_DSP9_B		LDX		UCMDIDX			LDA		CMDCODE,X			CMP		#$C6		;SET PREFIX			BEQ		L_DSP9_B1			JMP		L_DSP9_ERR	;NO, IT IS NOT A SET PREFIX** THERE IS NOT AN ACTIVE PREFIX*L_DSP9_B1	BIT		PFI_NAMING			BMI		L_DSP9_B2	;AFP NAMING ACTIVE			STZ		PRO_PREFIX			BRA		L_DSP9_B3L_DSP9_B2	STZ		AFP_PREFIXL_DSP9_B3	STZ		Cn_PFIXPTR;			LDA		Active8		;Is there a local ProDOS ???			beq		L_DSP9_B4			;			JSR		LOCALL_DSP9_B4	LDA		UERROR			JMP		END_CMD;;** IS PRODOS NAMING ACTIVE ?*L_DSP9_C		BIT		PFI_NAMING			BMI		L_DSP9_D;			JSR		CHK_PRODOS			BCC		L_DSP9_D			JMP		L_DSP9_ERR** IS VOLUME SPECIFIED?*L_DSP9_D		JSR		CHKSLASH			BCS		L_DSP9_H		;NO SLASH !!!** NO VOLUME SPECIFIED* WHAT PREFIX IS ACTIVE ?*			BIT		PFI_NAMING			BMI		L_DSP9_E** PRODOS PREFIX IS ACTIVE* WHERE IS THAT PREFIX SET (LOCAL OR SERVER) ?*			LDA		PRO_PFXLOC			CMP		#$FF		;LOCAL ??			BEQ		L_DSP9_I		;YES;			LDA		PRO_PFX_DEV	;PRODOS PREFIX DEVICE			AND		#%11110000	;strip low nibble			STA		Cn_DEVNUM	;SAVE IN LAST ACCESSED DEVICE !!!			LDA		PRO_PFXLOC			STA		CURSESS			JMP		GO_CMD** AFP PREFIX IS ACTIVE* WHERE IS THAT PREFIX SET (LOCAL OR SERVER) ?*L_DSP9_E		LDA		AFP_PFXLOC			CMP		#$FF		;LOCAL ??			BEQ		L_DSP9_I		;YES;			LDA		AFP_PFX_DEV	;AFP PREFIX DEVICE			AND		#%11110000	;strip low nibble			STA		Cn_DEVNUM	;SAVE IN LAST ACCESSED DEVICE !!!			LDA		AFP_PFXLOC			STA		CURSESS			JMP		GO_CMD		;GO MAKE CALL;** VOLUME IS SPECIFIED. IS THE VOLUME IN OUR NETWORK LIST?*L_DSP9_H		JSR		FND_CURSRV			BCS		L_DSP9_I		;VOLUME NOT FOUND			JSR		STRIP_PREFIX			JMP		GO_CMD		;YES IT IS. GO MAKE CALL;;** IS THERE A LOCAL PRODOS ?*L_DSP9_I	;			LDA		Active8		;Is there a local ProDOS ???			bne		L_DSP9_J			;			lda		#$27			sta 	uError			jmp 	End_CMD			;** CALL WILL GO LOCALLY . IF IT IS A SET* PREFIX CALL WE MUST DO SPECIAL PROCESSING.*L_DSP9_J		LDX		UCMDIDX			LDA		CMDCODE,X			CMP		#$C6		;SET PREFIX			BEQ		L_DSP9_K		;YES,IT IS A SET PREFIX			JMP		GO_LOCAL	;OK, LET IT GO LOCAL**	CALL IS A SET PREFIX*	WE NEED TO MONITOR THE RESULTS*L_DSP9_K		JSR		LOCAL		;MAKE CALL LOCALLY			BEQ		L_DSP9_L		;IF ERROR, LEAVE PFXLOC ALONE			JMP		END_CMD		;ERROR IN CALL** SET PREFIX LOCATION TO	LOCAL*L_DSP9_L		LDA		#$FF;			BIT		PFI_NAMING			BMI		L_DSP9_M			STA		PRO_PFXLOC	;PREFIX LOCATION IS LOCAL			BRA		L_DSP9_N		;SAVE PREFIX;L_DSP9_M		STA		AFP_PFXLOC	;PREFIX LOCATION IS LOCAL** SAVE PREFIX IN PREFIX BUFFER*L_DSP9_N		JSR		NEW_PREFIX			JMP		END_CMD		;EXIT NORMALLY;;** ERROR IN PATHNAME*L_DSP9_ERR	LDA		#$40		;INVALID PATHNAME			STA		UERROR			JMP		END_CMD;;**	**** CHECK BIT 4 *****	DOES COMMAND HAVE A UNIT NUMBER ?*L_DSP11		LDA		CMDTYPE,X			AND		#%00010000			BEQ		GO_CMD		;NO UNIT NUMBER NEEDED*			LDA		NDT_CNT		;ANY SERVER UNITS UP?			BNE		L_DSP11A			JMP		GO_LOCAL	;NO, GO LOCAL ALL THE WAY** UNIT # SPECIFIED. SEARCH NDT FOR MATCH. IF NOT FOUND* GO LOCAL.*L_DSP11A	LDA		WS_PLIST+1	;ONLINE, FIND ALL VOLUMES?			and		#$f0		;strip low nibble only want device			sta		ws_plist+1			BEQ		L_DSP14		;;			STZ		NDT_IDX1	;SAVE POSITION FOR ONLINE			STZ		NDT_IDX1+1			LDY		#0L_DSP12		STY		NDT_IDX2			LDA		NDT_SESS,Y	;IS IT ACTIVE			BEQ		L_DSP13		;NO LOOK AT THE NEXT RECORD;			LDA		NDT_UNIT,Y			AND		#$F0		;STRIP OUT LENGTH			CMP		WS_PLIST+1			BEQ		L_DSP14		;MAKE CALL ON NET;L_DSP13		CLC					;LOOK AT THE NEXT NDT RECORD			LDA		NDT_IDX1			ADC		#NDT_NAMELEN			STA		NDT_IDX1			LDA		NDT_IDX1+1			ADC		#$00			STA		NDT_IDX1+1;			INY			CPY		#14			;7 SLOTS * 2 DRIVES			BNE		L_DSP12		;MORE RECORDS TO LOOK AT			JMP		GO_LOCALL_DSP14	; 			LDX		UCMDIDX			LDA		CMDCODE,X			CMP		#$80			BEQ		L_NOGOOD	;READ BLOCK BAD			CMP		#$81		;			BNE		GO_CMD		;IT IS AN OK CALLL_NOGOOD	; 			LDA		WS_PLIST+1			BNE		L_NETERR			LDA		#$28		;NO DEVICE CONNECTED ERROR			BRA		L_NETERR1L_NETERR	LDA		#$88		;NETWORK ERRORL_NETERR1	; 			STA		UERROR			BRA		END_CMD;;** PROCESS MLI CALL WITH NETWORK'S HELP !!!!!!!!*GO_CMD	; 			JSR		MLIPROC		;CALL MLI PROCESSOR** RETURN SOME OF THE PARAMETER LIST?*END_CMD	; 			LDA		RETURNPL			BEQ		END_CMD1	;NONE TO RETURN;			STA		<COUNT			LDA		#00			STA		<COUNT+1;			LDA		#WS_PLIST			STA		<SRCBUF		;LB OF PFI PL			LDA		#>WS_PLIST			STA		<SRCBUF+1	;HB OF PFI PL			lda		#^ws_plist			sta		<srcbuf+2;			LDA		Cn_WSIPL			STA		<DESTBUF			LDA		Cn_WSIPL+1			STA		<DESTBUF+1			;			;-----> 5/31/88 CHECK TO SEE IF IT IS ZERO PAGE			;			BNE		ENDCMD0A			LDA		ZP_BANK			BRA		ENDCMD0B			;			;ENDCMD0A	lda		pfi_bankENDCMD0B	sta		<DESTbuf+2			;			;			;-----> END			;			JSR		BUFFMOVE** IS THERE A LOCAL PRODOS ?*END_CMD1	; 			LDA		Active8		;Is there a local ProDOS ???			bne		END_CMD1A			;			STZ		Cn_DEVNUM			LDA		#$FF			STA		Cn_PFIXPTR** SET ERROR CODE AND CARRY IN CN00*END_CMD1A	; 			LDA		UERROR		;PUT ERROR CODE IN A			STA		Cn_ERROR			BNE		END_CMD2			CLC			BRA		END_CMD3END_CMD2	; 			SECEND_CMD3	; ** THE MLI COMMAND IS NOW COMPLETE - RELEASE MOTHERBOARD*			rts;;;;*** RETURN TRAPPED MLI CALL TO LOCAL MLI FIRMWARE !!!**GO_LOCAL	; ** IS THERE A LOCAL PRODOS ?*			LDA		Active8		;Is there a local ProDOS ???			bne		GO_LOCAL1			;			lda		#$27			sta 	uError			jmp 	End_CMD			;** MAKE LOCAL CALL TO PRODOS*GO_LOCAL1	; 			JSR		DO_JSRLOCAL	;DIRECT MOTHERBOARD LOCAL			LDA		Cn_ERROR			STA		UERROR			BRA		END_CMD		;SAVE ERROR AND SET THE CARRY;;;			eject**** MLI CALL PROCESSOR***** SHOULD CALL GO LOCAL (REFERENCE # FOR LOCAL FILE) ?*		EXPORT	MLIPROCMLIPROC		;					LDX		UFILEIDX	;IS THERE A REFERENCE # ?			BMI		MLIP1		;NO , CONTINUE			LDA		UFILELOC,X	;IS THE FILE LOCAL ?			CMP		#$FF			BNE		MLIP0		;NO,NETWORK LOCATION			JMP		LOCALREF	;MAKE LOCAL CALL** SAVE DEVICE FOR THIS REFERENCE NUMBER*MLIP0	; 			LDA		UDEVNUM,X	;GET DEVICE NUMBER			AND		#%11110000	;strip low nibble			STA		Cn_DEVNUM	;UPDATE LAST DEVICE ACCESSED** GO TO THE REQUESTED COMMAND*MLIP1	; 			LDX		UCMDIDX		;GET CMD INDEX			TXA			ASL		A			;MULTIPLY INDEX BY 2			TAX			LDA		MCPADDR,X	;GET ADDR			STA		<zp1			;AND STORE IN JMP VECTOR			LDA		MCPADDR+1,X			STA		<zp1+1			LDX		UCMDIDX			JMP		(zp1)		;JUMP TO ROUTINE;;			eject*** COMMAND $C0 = CREATE*** IF STORAGE TYPE = $0D THEN CREATE A DIRECTORY*	= $01 THEN CREATE A FILE.** SET FILE/DIR INFO (1.PRODOS INFO, 2.ACCESS)** IF UNABLE TO SET INFO - DELETE IT**		EXPORT	CREATECREATE		;	* ARE THERE EXTRA BITS SET?			LDA		WS_PLIST+3			AND		#%00011000			Bne		cBad			JSR		CHK_VOLUME			BCC		LC_CREATE00		;NO , NOT A VOLUME;cbad		LDA		#$4E		;ACCESS ERROR			STA		UERROR			RTS** IS THIS A VALID STORAGE TYPE ?*LC_CREATE00	LDA		WS_PLIST+$07			CMP		#$0D			BEQ		LC_CREATE0	;YES, A DIRECTORY			CMP		#$04			BCC		LC_CREATE0	;YES , A FILE (0-3);			LDA		#$4B		;UNACCEPTABLE STORAGE TYPE			STA		UERROR			RTS** STUFF VOLUME ID AND DIRECTORY ID*LC_CREATE0	JSR		STUFF_IDS** MOVE PATHNAME TO THE BUFFER*			CLC			LDX		#$08		;OFFSET TO PATHNAME IN PACKET			JSR		PATH2BUF** IS THIS A DIRECTORY OR A FILE ? (SAVE COMMAND BYTE)*			LDA		WS_PLIST+7	;STORAGE TYPE			CMP		#$0D		;IS IT A DIRECTORY ?			BNE		LC_CREATE1;			LDA		#CREATEDIR			BRA		LC_CREATE2;LC_CREATE1	LDA		#CREATEFILLC_CREATE2	STA		WS_COMBUF			STZ		WS_COMBUF+1** TIME TO CALL ASP COMMAND CALL FOR AFP CREATE*			JSR		CMD_ROUTING			BCC		LC_CREATE3	;CONTINUE WITH CREATE			RTS					;TIME TO EXIT DUE TO ERROR** STUFF COMMAND FOR SET FILE/DIR PARAMETER*LC_CREATE3	LDA		WS_PLIST+3			STA		ACCESS;			LDA		#SETFDINFO			STA		WS_COMBUF	;SAVE COMMAND			STZ		WS_COMBUF+1** STUFF VOLUME AND DIRECTORY IDS*			JSR		STUFF_IDS** STUFF HB OF BITMAP*			LDA		#%00100000		;PRODOS INFO			STA		WS_COMBUF+$08	;HB OF BITMAP** STUFF LB OF BITMAP*LC_CREATE3A	LDA		#%00000001		;ATTRIBUTESLC_CREATE3B	STA		WS_COMBUF+$09	;LB OF BITMAP** STUFF PATHNAME*			SEC					;PADDING NEEDED			LDX		#$0A		;OFFSET TO PATHNAME IN PACKET			JSR		PATH2BUF	;SAVE PATH IN PACKET** SET ACCESS FOR FILE**	PRODOS FORMAT	AFP FORMAT**	DESTORY = BIT 7	===	BIT 0 - HIGH BYTE = DELETE*	RENAME	= BIT 6	===	BIT 7 - LOW	BYTE = RENAME*	BACKUP	= BIT 5	===	BIT 6 - LOW	BYTE = BACKUP*	WRITE	= BIT 1	===	BIT 5 - LOW	BYTE = READ ONLY*	READ	= BIT 0	===	NOT VALID*			LDA		WS_PLIST+$07			CMP		#$0D		;DIRECTORY ??			BEQ		LC_DIR			LDA		#$00		;TYPE = FILE			BRA		LC_DOITLC_DIR		LDA		#$80		;TYPE = DIRECTORYLC_DOIT		JSR		INTO_ATTRI	;DOES NOT CHANGE X REGISTER;			LDA		ATTRIBUTE+1			STA		WS_COMBUF,X	;SAVE HB OF ATTRIBUTES			INX			LDA		ATTRIBUTE			ORA		#%01000000	;SET BACKUP BIT			STA		WS_COMBUF,X	;SAVE LB OF ATTRIBUTES			INX;;-----> 11/19/87   TE;** is there a create time in packet*			LDA		WS_PLIST+$08			ORA		WS_PLIST+$09			ORA		WS_PLIST+$0A			ORA		WS_PLIST+$0B			BEQ		LC_FINDER		;automatic stamping by server** unique creation date (no automatic stamping)* set create date in bitmap*			LDA		#%00000100	   ;,CREATE DATE			ORA		WS_COMBUF+09			STA		WS_COMBUF+09;;----> end;* CONVERT PRODOS CREATE TIME INTO AFP TIME			PHX			LDX		#$03LC_LOOP	; 			LDA		WS_PLIST+$08,X			STA		PRO_TIME,X			DEX			BPL		LC_LOOP			JSR		INTO_SEC	;CHANGE PTIME INTO AFPTIME			PLX			LDY		#00LC_LOOP2	; 			LDA		AFP,Y			STA		WS_COMBUF,X			INX			INY			CPY		#04			BNE		LC_LOOP2;;** IS THIS A DIRECTORY OR A FILE (STUFF FINDER INFO)?** FINDER INFO*LC_FINDER	; ** SAVE PRODOS INFORMATION*LC_CREATE3E	LDA		WS_PLIST+4	;FILE TYPE			STA		WS_COMBUF,X			INX			STZ		WS_COMBUF,X	;NOT USED ON APPLE 2E;			INX			LDA		WS_PLIST+5			STA		WS_COMBUF,X	;AUX TYPE LB			INX			LDA		WS_PLIST+6			STA		WS_COMBUF,X	;AUX TYPE HB			INX			STZ		WS_COMBUF,X	;NOT USED ON APPLE 2E			INX			STZ		WS_COMBUF,X	;NOT USED ON APPLE 2E** TIME TO CALL ASP COMMAND CALL FOR SET DIR PARMS*			INX			STX		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING			BCS		LC_CREATE4	;UNABLE TO SET PARMS - DELETE			RTS					;TIME TO EXIT DUE - NO ERROR** DELETE FILE OR DIRECTORY THAT WAS JUST CREATED !!*LC_CREATE4	LDA		UERROR			PHA					;SAVE IT ON THE STACK;			LDA		#DELETE			STA		WS_COMBUF			STZ		WS_COMBUF+1;			JSR		STUFF_IDS;			CLC			LDX		#$08		;OFFSET TO PATHNAME			JSR		PATH2BUF;			JSR		CMD_ROUTING			PLA					;RESTORE ERROR ON SET PARMS			STA		UERROR		;SAVE IT AS ERROR			RTS;;			eject*** COMMAND $C1 = DESTROY** ISSUE THE AFP DELETE COMMAND REGARDLESS OF WHAT IT IS**		EXPORT	DESTROYDESTROY		;					JSR		CHK_VOLUME			BCC		LC_OVER		;NO , NOT A VOLUME;			LDA		#$4E		;ACCESS ERROR			STA		UERROR			RTS** ISSUE THE AFP DELETE COMMAND REGARDLESS OF WHAT IT IS*LC_OVER		LDA		#DESTROYCMD			STA		WS_COMBUF			STZ		WS_COMBUF+1;			JSR		STUFF_IDS;			CLC			LDX		#$08		;OFFSET TO PATHNAME			JSR		PATH2BUF;			JSR		CMD_ROUTING;			LDA		Cn_PFIERR			CMP		#$5B			BEQ		LC_DESTORY1			CMP		#$5F			BEQ		LC_DESTORY1;			LDA		UERROR			CMP		#$44		;NOT FOUND			BNE		LC_DESTORY1			LDA		#$46			STA		UERRORLC_DESTORY1	RTS;;			eject*** COMMAND $C2 = RENAME** ISSUE THE AFP RENAME COMMAND REGARDLESS OF WHAT IT IS**		EXPORT	RENAMERENAME		;					JSR		CHK_VOLUME			BCC		LR_OVER		;NO , NOT A VOLUME;			LDA		#$4E		;ACCESS ERROR			STA		UERROR			RTS** ISSUE THE AFP RENAME COMMAND REGARDLESS OF WHAT IT IS*LR_OVER		LDA		#RENAMECMD			STA		WS_COMBUF			STZ		WS_COMBUF+1;			JSR		STUFF_IDS;			CLC			LDX		#$08			JSR		PATH2BUF			PHX** RENAME --- SAVE STRUCTURE AND ITS LENGTH IN WS_PREPATH*** FIND LENGTH OF PREPATH*			LDY		WS_PATH			CPY		#$02		;IS IT 0 OR 1 ?			BCS		LR_RENAME1	;YES THERE IS MORE TO IT;			STZ		WS_PREPATH			BRA		LR_RENAME3	;MOVE SECOND NAME;LR_RENAME1	DEY			STY		WS_PREPATH			BEQ		LR_RENAME3	;FINISHED WITH NAME (ONE SEGMENT);			LDA		WS_PATH,Y			CMP		#SLASH			BNE		LR_RENAME1	;START OF LAST SEGMENT** SAVE LENGTH OF WS_PREPATH*			DEY					;SKIP SLASH			STY		WS_PREPATH			BEQ		LR_RENAME3	;MOVE SECOND NAME;LR_RENAME2	LDA		WS_PATH,Y			STA		WS_PREPATH,Y			DEY			BNE		LR_RENAME2	;END OF MOVE** MOVE SECOND NAME TO CARD*LR_RENAME3	LDA		#WS_PATH			STA		<DESTBUF			LDA		#>WS_PATH			STA		<DESTBUF+1			LDA		#^WS_PATH			STA		<DESTBUF+2*			LDA		WS_PLIST+3	;PATHNAME POINTER - LB			STA		<SRCBUF			INY			LDA		WS_PLIST+4	;PATHNAME POINTER - HB			STA		<SRCBUF+1;			LDA		PFI_BANK			STA		<SRCBUF+2	;FIND BANK !!!*			LDA		#MAX_AFPPATH			STA		<COUNT			LDA		#00			STA		<COUNT+1*			JSR		BUFFMOVE**  check for a Double Slash*			JSR		CHKDBL			BCS		LR_NAMEERR** IS THE LENGTH OF THE SECOND NAME TOO LONG ??*			LDA		WS_PATH			CMP		#MAX_AFPPATH-1			BCS		LR_NAMEERR** CHECK PRODOS ???*			BIT		PFI_NAMING			BMI		LR_RENAME4;			JSR		CHK_PRODOS			BCS		LR_NAMEERR** Strip Prefix from Second Name*LR_RENAME4	JSR		STRIP_PREFIX	;REMOVE PREFIX FROM SECOND NAME** IS THE SECOND PATH AS LONG AS THE PREPATH ???*			LDA		WS_PREPATH			CMP		WS_PATH			BCC		LR_NAME4A;LR_NAMEERR	PLX					;remove unused index			LDA		#$40			STA		UERROR			RTS** SAVE FILE TYPE IN PACKET*LR_NAME4A		PLX					;RESTORE INDEX TO PACKET			LDA		#$02		;NAME TYPE			STA		WS_COMBUF,X			INX					;** SAVE LENGTH OF SEGMENT*			CLC					;ADD ONE			LDA		WS_PATH			SBC		WS_PREPATH			STA		WS_COMBUF,X** CHECK SECOND NAME AGAINST WS_PREPATH*			LDY		WS_PREPATH			BNE		LR_RENAME5	;CHECK AGAINST NAME;			INC		WS_COMBUF,X			BRA		LR_RENAME6;LR_RENAME5	LDA		WS_PATH,Y			CMP		WS_PREPATH,Y			BEQ		LR_RENAME5C	;YES IT IS THE SAME LETTER;** IF IN AFP MODE, IS HI BIT SET?*			BIT		PFI_NAMING			BPL		LR_RENAME5A;			LDA		WS_PATH,Y	;IS HI BIT SET ???			BMI		LR_RENAME_ERR	;NOT INSENSITIVE** CONVERT TO UPPER CASE*LR_RENAME5A	CMP		#$61			BCC		LR_RENAME5B	;TEST CHARACTER			AND		#$5F;LR_RENAME5B	CMP		#$41		;IS IT LT 'A' ?			BCC		LR_RENAME_ERR	;NO,FLUNK TEST			CMP		#$5B		;IS IT GT 'Z' ?			BCS		LR_RENAME_ERR	;NO,FLUNK TEST*			LDA		WS_PATH,Y	;CHECK CASE INSENSITIVE			EOR		#$20			CMP		WS_PREPATH,Y			BNE		LR_RENAME_ERR	;NO,FLUNK TEST*LR_RENAME5C	DEY			BNE		LR_RENAME5** SHIFT NAME TO PACKET*			LDY		WS_PREPATH			INYLR_RENAME6	INY			INX			LDA		WS_PATH,Y			CMP		#SLASH			BEQ		LR_RENAME_ERR	;THERE SHOULD BE NO SLASHES;			STA		WS_COMBUF,X			CPY		WS_PATH			BNE		LR_RENAME6;			INX			STX		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING;			LDA		Cn_PFIERR			CMP		#$5B			BEQ		LR_RENAME7			CMP		#$5F			BEQ		LR_RENAME7;			LDA		UERROR			CMP		#$44		;NOT FOUND			BNE		LR_RENAME7			LDA		#$46			STA		UERRORLR_RENAME7	RTS;;LR_RENAME_ERR	LDA		#$40			STA		UERROR			RTS;;			eject*** COMMAND $C3 = SET FILE INFO** ISSUE AFP SET FILE/DIR INFO*	1.MOD TIME*	2.PRODOS AUX TYPE*	3.ACCESS*		EXPORT	SETINFOSETINFO		;		* ARE THERE EXTRA BITS SET?			LDA		WS_PLIST+3			AND		#%00011000			BEQ		SIOK			LDA		#$4E			STA		UERROR			RTSSIOK	; ** STUFF COMMAND FOR SET FILE/DIR PARAMETER*LS_SETF		LDA		WS_PLIST+3			STA		ACCESS			LDA		#$00		;DOESN'T MATTER ANYMORE			JSR		INTO_ATTRI	;DOES NOT CHANGE;			LDA		#SETFDINFO			STA		WS_COMBUF	;SAVE COMMAND			STZ		WS_COMBUF+1** STUFF VOLUME AND DIRECTORY IDS*			JSR		STUFF_IDS** STUFF BITMAPS*			LDA		#%00100000	 ;PRODOS INFO			STA		WS_COMBUF+8	;HB OF BITMAP;			LDA		#%00001001	 ;ACCESS & MOD DATELS_SETG		STA		WS_COMBUF+9	;LB OF BITMAP;** STUFF PATHNAME & ATTRIBUTES*			SEC					;NEEDS TO BE PADDED			LDX		#$0A		;OFFSET TO PATHNAME IN PACKET			JSR		PATH2BUF	;SAVE PATH IN PACKET;			LDA		ATTRIBUTE+3			STA		WS_COMBUF,X	;SAVE HB OF ATTRIBUTES			INX			LDA		ATTRIBUTE+2			STA		WS_COMBUF,X	;SAVE LB OF ATTRIBUTES			INX** CONVERT PRODOS TIME INTO AFP TIME*			PHX					;SAVE [X] REGISTER			LDX		#$03SETINFO1	; 			LDA		WS_PLIST+$0A,X			STA		PRO_TIME,X			DEX			BPL		SETINFO1;			JSR		INTO_SEC	;CHANGE PRODOS TIME IN TO AFP TIME;			PLX					;RESTORE X REGISTER			LDY		#$00SETINFO2	; 			LDA		AFP,Y			STA		WS_COMBUF,X			INX			INY			CPY		#$04			BNE		SETINFO2** SET PRODOS FILE TYPE*LS_SETI		LDA		WS_PLIST+4	;FILE TYPE			STA		WS_COMBUF,X			INX			STZ		WS_COMBUF,X	;NOT USED ON APPLE 2E;			INX			LDA		WS_PLIST+5			STA		WS_COMBUF,X	;AUX TYPE LB			INX			LDA		WS_PLIST+6			STA		WS_COMBUF,X	;AUX TYPE HB			INX			STZ		WS_COMBUF,X	;NOT USED ON APPLE 2E			INX			STZ		WS_COMBUF,X	;NOT USED ON APPLE 2E** SEND THE FIRST PACKET*			INX			STX		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING	;ISSUE AFP CALL			LDA		UERROR			BEQ		SETINFO3;			RTS					;ERROR ,EXIT NOW;;;** are there any bits to SET ??*SETINFO3	; 			LDA		ATTRIBUTE+1			AND		#%01111111			ORA		ATTRIBUTE			BNE		LS_OVER			RTS** ISSUE SECOND CALL TO SET ATTRIBUTES*LS_OVER		LDA		#SETFDINFO			STA		WS_COMBUF	;SAVE COMMAND			STZ		WS_COMBUF+1** STUFF VOLUME AND DIRECTORY IDS*			JSR		STUFF_IDS** STUFF BITMAPS*			LDA		#%00000000	 ;			STA		WS_COMBUF+8	;HB OF BITMAP			LDA		#%00001001	 ;ACCESS AND MODE DATE			STA		WS_COMBUF+9	;LB OF BITMAP** STUFF PATHNAME & ATTRIBUTES*			SEC					;NEEDS TO BE PADDED			LDX		#$0A		;OFFSET TO PATHNAME IN PACKET			JSR		PATH2BUF	;SAVE PATH IN PACKET;			LDA		ATTRIBUTE+1			STA		WS_COMBUF,X	;SAVE HB OF ATTRIBUTES			INX			LDA		ATTRIBUTE			STA		WS_COMBUF,X	;SAVE LB OF ATTRIBUTES;			INX			LDY		#$00SFLOOP1	; 			LDA		AFP,Y			STA		WS_COMBUF,X			INX			INY			CPY		#$04			BNE		SFLOOP1			STX		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING	;ISSUE AFP CALL;			LDA		UERROR			BEQ		SETINFO4;			RTS					;ERROR ,EXIT NOW;;** ARE THEY TRYING TO CLEAR THE BACKUP BIT*SETINFO4	; 			LDA		ATTRIBUTE+2			AND		#%01000000	;BACKUP NEEDED BIT			BNE		ZLS_OVER			RTS** ISSUE THIRD CALL TO CLEAR ATTRIBUTES*ZLS_OVER	LDA		#SETFDINFO			STA		WS_COMBUF	;SAVE COMMAND			STZ		WS_COMBUF+1** STUFF VOLUME AND DIRECTORY IDS*			JSR		STUFF_IDS** STUFF BITMAPS*			LDA		#%00000000	 ;			STA		WS_COMBUF+8	;HB OF BITMAP			LDA		#%00000001	 ;ACCESS			STA		WS_COMBUF+9	;LB OF BITMAP** STUFF PATHNAME & ATTRIBUTES*			SEC					;NEEDS TO BE PADDED			LDX		#$0A		;OFFSET TO PATHNAME IN PACKET			JSR		PATH2BUF	;SAVE PATH IN PACKET;			LDA		#$00			STA		WS_COMBUF,X	;SAVE HB OF ATTRIBUTES			INX			LDA		#%01000000	;BACKUP NEEDED BIT			STA		WS_COMBUF,X	;SAVE LB OF ATTRIBUTES;			INX			LDY		#$00SFLOOP3	; 			LDA		AFP,Y			STA		WS_COMBUF,X			INX			INY			CPY		#$04			BNE		SFLOOP3			STX		PKT_CNT			STZ		PKT_CNT+1			JMP		CMD_ROUTING	;ISSUE AFP CALL;;			eject*** COMMAND $C4 = GET FILE INFO** ISSUE AFP GET FILE/DIR INFO**	1.ACCESS (TRANSLATE FROM AFP BITS INTO PRODOS BITS)*	2.PRODOS AUX TYPE (FILES ONLY)*	3.MOD TIME & DATE (TRANSLATE INTO PRODOS TIME)*	4.CREATION TIME & DATE (TRANSLATE INTO PRODOS TIME)*	*5.BLOCKS USED (FOR DIR USE OFFSPRING CNT TO FIND SIZE)*	6.STORAGE TYPE (LOOK AT START OF PARAMETERS IN PACKET)** IF THE DIRECTORY IS A VOLUME -*	PLACE TOTAL BLOCKS USED	IN BLOCKS USED*	PLACE TOTAL BLOCKS POSSIBLE IN AUX TYPE**		EXPORT	GETFINFOGETFINFO		;		** STUFF GET FIL/DIR INFO*			LDA		#GETFDINFO			STA		WS_COMBUF			STZ		WS_COMBUF+1;			JSR		STUFF_IDS;			LDA		#%00100110	   ;HB OF FILE BITMAP			STA		WS_COMBUF+$08	;RSC + DATA LENGTH, PRODOS AUX TYPE			LDA		#%00001101	   ;LB OF FILE BITMAP			STA		WS_COMBUF+$09	;ATTRIBUTES,MOD DATE, CREATE DATE;			LDA		#%00100010	   ;HB OF DIR BITMAP			STA		WS_COMBUF+$0A	;# OF OFFSPRING, PRODOS AUX TYPE			LDA		#%00001101	   ;LB OF DIR BITMAP			STA		WS_COMBUF+$0B	;ATTRIBUTES,MOD DATE, CREATE DATE;			CLC			LDX		#$0C			JSR		PATH2BUF	;MOVE PATHNAME TO BUFR;			JSR		CMD_ROUTING	;EXECUTE CALL			BCC		GETINFO1;			LDA		Cn_PFIERR			CMP		#$5B			BEQ		GETERR			CMP		#$5F			BEQ		GETERR;			LDA		UERROR			CMP		#$44			BNE		GETERR;			LDA		#$46		;FILE NOT FOUND			STA		UERRORGETERR	; 			RTS					;ERROR IN GET INFO CALL;;** SET ACCESS BYTES IN PL (WITH SOME TRANSLATION)*GETINFO1	; 			LDX		#$06		;HB OF ATTRIBUTES			LDA		WS_COMBUF,X			STA		ATTRIBUTE+1			INX			LDA		WS_COMBUF,X			STA		ATTRIBUTE;			LDA		WS_COMBUF+4	;TYPE (80=DIR/00=FILE)			JSR		FROM_ATTRI			LDA		ACCESS			STA		WS_PLIST+3	;SAVE ACCESS** FIND MOD DATE & TIME*			LDX		#$03GET_INFO2	; 			LDA		WS_COMBUF+$0C,X			STA		AFP,X			DEX			BPL		GET_INFO2	;MORE OF AFP TIME TO MOVE;			JSR		FROM_SEC;			LDX		#$03GET_INFO3	; 			LDA		PRO_TIME,X			STA		WS_PLIST+$0A,X			DEX			BPL		GET_INFO3	;MORE OF PRODOS TIME TO MOVE** FIND CREATION DATE & TIME*			LDX		#$03GET_INFO4	; 			LDA		WS_COMBUF+$08,X			STA		AFP,X			DEX			BPL		GET_INFO4	;MORE OF AFP TIME TO MOVE;			JSR		FROM_SEC;			LDX		#$03GET_INFO5	; 			LDA		PRO_TIME,X			STA		WS_PLIST+$0E,X			DEX			BPL		GET_INFO5	;MORE OF PRODOS TIME TO MOVE** IS THE OBJECT A FILE OR A DIRECTORY ?*			LDA		WS_COMBUF+4			BEQ		GETINFO6	;IT IS A FILE			JMP		GETINFO7	;IT IS A DIRECTORY** SAVE - PRODOS AUX TYPE INFO*GETINFO6	; 			LDA		WS_COMBUF+$18			STA		WS_PLIST+$04	;SAVE FILE TYPE								;			LDA		WS_COMBUF+$1A			STA		WS_PLIST+$05	;SAVE LB OF AUX TYPE			LDA		WS_COMBUF+$1B			STA		WS_PLIST+$06	;SAVE HB OF AUX TYPE** WHAT FORK WAS REQUESTED ???*   BOTH ???*			BIT		WS_PLIST			BVC		LG_CONT1;; ADD BOTH FORKS TOGETHER			CLC			LDA		WS_COMBUF+$13			ADC		WS_COMBUF+$17			STA		WS_COMBUF+$13;			LDA		WS_COMBUF+$12			ADC		WS_COMBUF+$16			STA		WS_COMBUF+$12;			LDA		WS_COMBUF+$11			ADC		WS_COMBUF+$15			STA		WS_COMBUF+$11;			LDA		WS_COMBUF+$10			ADC		WS_COMBUF+$14			STA		WS_COMBUF+$10			BCC		LG_CONT2		;NO, OVERFLOW;			LDA		#$FF		;OVERFLOW			STA		WS_COMBUF+$10			BRA		LG_CONT2;** WAS THE RESOURCE FORK REQUESTED*LG_CONT1		BPL		LG_CONT2		;NO IT WAS THE DATA FORK;			LDX		#$03LG_CONT1A		LDA		WS_COMBUF+$14,X			STA		WS_COMBUF+$10,X			DEX			BPL		LG_CONT1A		;MOVE ALL BYTES TO FIRST AREA** SAVE FILE BLOCKS USED*LG_CONT2		LDA		WS_COMBUF+$10			STA		FILE_SIZE			LDA		WS_COMBUF+$11			STA		FILE_SIZE+1			LDA		WS_COMBUF+$12			STA		FILE_SIZE+2			LDA		WS_COMBUF+$13			STA		FILE_SIZE+3;			JSR		BYTE2BLKS;			LDA		FILE_BLKS+1			STA		WS_PLIST+9	;SAVE HB OF BLOCKS			LDA		FILE_BLKS			STA		WS_PLIST+8	;SAVE LB OF BLOCKS** SET STORAGE TYPE*			LDA		FILE_BLKS+1			LSR		A			BNE		LG_TREE		;IS IT A TREE ?			BCC		LG_NEXT		;NOT A TREE			LDA		FILE_BLKS			BEQ		LG_SAPLINGLG_TREE		LDA		#$03		;TREE !!!!			BRA		LG_SAV;LG_NEXT		LDA		FILE_BLKS			LSR		A			;			BEQ		LG_SEED		;LG_SAPLING	LDA		#$02		;SAPLING !!!!!!			BRA		LG_SAVLG_SEED		LDA		#$01		;SEEDLING !!!LG_SAV		STA		WS_PLIST+$07	;SAVE FILE TYPE** TIME TO LEAVE FOR FILE - PLEASE EXIT*			LDA		#$12			STA		RETURNPL			RTS;;** SAVE DIRECTORY FILE TYPE & STORAGE TYPE*GETINFO7	; 			LDA		#$0D			STA		WS_PLIST+$07	;SAVE STORAGE TYPE** SAVE - PRODOS AUX TYPE INFO*			LDA		WS_COMBUF+$12			STA		WS_PLIST+$04	;SAVE FILE TYPE								;			LDA		WS_COMBUF+$14			STA		WS_PLIST+$05	;SAVE LB OF AUX TYPE			LDA		WS_COMBUF+$15			STA		WS_PLIST+$06	;SAVE HB OF AUX TYPE** IS THIS A VOLUME ?*			JSR		CHK_VOLUME			BCS		GETINFO8	;YES IT IS A VOLUME** CALCULATE # OF BLOCKS USED BY DIRECOTRY !!!*			LDA		WS_COMBUF+$10			STA		OFFSPRING			LDA		WS_COMBUF+$11			STA		OFFSPRING+1;			JSR		CALC_DIRINFO;			LDA		FILE_BLKS			STA		WS_PLIST+$08	;SAVE BLOCKS USED - LB			LDA		FILE_BLKS+1			STA		WS_PLIST+$09	;SAVE BLOCKS USED - HB** TIME TO LEAVE FOR DIRECTORY WHICH IS NOT A VOLUME*			LDA		#$12			STA		RETURNPL			RTS;;*** THIS IS FOR A VOLUME*** SET ACCESS RIGHTS TO $01 + BACKUP BIT**GETINFO8	; 			LDA		WS_PLIST+3			AND		#%00100000	;BACKUP BIT			ORA		#%00000001	;READ ENALBLE			STA		WS_PLIST+3** CREATE GET VOL PARMS** NOTE : NDT_IDX2 IS SET BY FND_CURSRV*			LDA		#GETVOLPARMS			STA		WS_COMBUF	   ;SAVE  AFP COMMAND			STZ		WS_COMBUF+1	  ;SAVE ZERO;			LDX		NDT_IDX2			LDA		NDT_IDH,X			STA		WS_COMBUF+$02	;SAVE VOLUME ID - HB			LDA		NDT_IDL,X			STA		WS_COMBUF+$03	;SAVE VOLUME ID - LB;			STZ		WS_COMBUF+$04	;SAVE BITMAP - HB			LDA		#%11000000	   ;TOTAL BYTES,FREE BYTES			STA		WS_COMBUF+$05	;SAVE BITMAP - LB** ISSUE AFP GET VOLUME PARAMETERS*			LDA		#$06			STA		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING			BCC		GETINFO9	;GOT INFO OK			RTS** FIND TOTAL BLOCKS AVAILABLE ON SERVER VOLUME*GETINFO9	; 			LDA		WS_COMBUF+$06			STA		FILE_SIZE	;			LDA		WS_COMBUF+$07			STA		FILE_SIZE+1			LDA		WS_COMBUF+$08			STA		FILE_SIZE+2			LDA		WS_COMBUF+$09			STA		FILE_SIZE+3;			JSR		BYTE2BLKS;			LDA		FILE_BLKS			STA		WS_PLIST+5	;LB OF TOTAL BLOCKS AVAIL			LDA		FILE_BLKS+1			STA		WS_PLIST+6	;HB OF TOTAL BLOCKS AVAIL** FIND TOTAL BLOCKS USED* (AVAIL - FREE = USED)*			SEC			LDA		WS_COMBUF+$09			SBC		WS_COMBUF+$05			STA		FILE_SIZE+3;			LDA		WS_COMBUF+$08			SBC		WS_COMBUF+$04			STA		FILE_SIZE+2;			LDA		WS_COMBUF+$07			SBC		WS_COMBUF+$03			STA		FILE_SIZE+1;			LDA		WS_COMBUF+$06			SBC		WS_COMBUF+$02			STA		FILE_SIZE;			JSR		BYTE2BLKS;			LDA		FILE_BLKS			STA		WS_PLIST+8	;SAVE BLOCKS USED - LB			LDA		FILE_BLKS+1			STA		WS_PLIST+9	;SAVE BLOCKS USED - HB** TIME TO LEAVE FOR A VOLUME GET INFO CALL*			LDA		#$12			STA		RETURNPL			RTS;;			eject*** COMMAND $C5 = ONLINE CALL**	CHECK NDT & GO LOCAL (IF THERE IS LOCAL PRODOS)*		EXPORT	ONLINEONLINE		;		** CHECK BUFFER ADDRESS*			LDX		WS_PLIST+$03	;HB OF IO BUFFER			LDY		#$01		;CHECK 1 eject			JSR		CHK_BITMAP			BCC		LS_BUFFOK;LS_BUFFBAD	LDA		#$56			STA		UERROR			RTS** FIND UNIT NUMBER REQUESTED (0=ALL)*LS_BUFFOK	LDA		WS_PLIST+1			AND		#%11110000	;STRIP OFF UNUSED BITS			BEQ		OL_ALL		;FIND ALL VOLUMES** MOVE SERVER MATCH INTO WORK AREA*;			CLC			LDA		NDT_IDX1			ADC		#NDT_NAME			STA		<ZP2			LDA		NDT_IDX1+1			ADC		#>NDT_NAME			STA		<ZP2+1;			LDY		#$00OL_ONE1	; 			LDA		(ZP2),Y			cmp		#'a'			bcc		@notlower			cmp		#'z'+1			bcs		@notlower			and		#$DF@notlower	STA		WS_COMBUF,Y			INY			CPY		#$10			BNE		OL_ONE1** DOES THIS VOLUME NEED TO BE TRUCATED ?*			LDA		WS_COMBUF			AND		#%11110000			BEQ		OL_ONE1A	;LENGTH IS OK;			LDA		#$0F			STA		WS_COMBUF	;CUT NAME SHORT			LDA		#$2A			STA		WS_COMBUF+$0F	;'*' LAST CHARACTEROL_ONE1A	; 			LDX		NDT_IDX2			LDA		NDT_UNIT,X	;SAVE UNIT NUMBER			AND		#%11110000	;STRIP OFF LB			ORA		WS_COMBUF			STA		WS_COMBUF** MOVE SERVER MATCH INTO THE USER BUFFER.*			LDA		#WS_COMBUF			STA		<SRCBUF		;SETUP SOURCE BUFF			LDA		#>WS_COMBUF			STA		<SRCBUF+1			LDA		#^WS_COMBUF			STA		<SRCBUF+2;			LDA		WS_PLIST+2			STA		<DESTBUF		;SETUP DESTINATION BUFF			LDA		WS_PLIST+3			STA		<DESTBUF+1;			LDA		PFI_BANK			STA		<DESTBUF+2	;BANK !!!;			LDA		#$10			STA		<COUNT		;SETUP COUNT			LDA		#00			STA		<COUNT+1			JMP		BUFFMOVE*** FIND ALL VOLUMES !!!!!!!!**OL_ALL	; ** IS THERE ANY ENTRIES IN THE NDT ?*			STZ		UWORK2		;OFFSET IN WS_COMBUF			LDA		NDT_CNT			BEQ		OL_ALL6		;NO THERE IS NONE* UPDATE THE LOCAL PRODOS TABLE			LDA		#00			;REMOVE ALL DEVICES			CLC			JSR		PDOS_DEVICE** MOVE ENTRY FROM NDT TO WS_COMBUF*			LDA		#<NDT_NAME			STA		<ZP2			LDA		#>NDT_NAME			STA		<ZP2+1;			LDX		#$00OL_ALL1	; 			STX		NDT_IDX2	;INDEX TO NDT TABLE			LDA		NDT_SESS,X			BEQ		OL_ALL5		;NOT, ACTIVE			;			lda		NDT_UNIT,x			and		#$f0			beq		OL_ALL5** SAVE VOLUME NAME*			LDA		#$0F			STA		UWORK1		;BYTE COUNTER;			LDX		UWORK2			LDY		#$00OL_ALL2	; 			INX			INY			LDA		(ZP2),Y			STA		WS_COMBUF,X			DEC		UWORK1			BNE		OL_ALL2		;MOVE MORE OF VOLUME NAME			PHX					;SAVE INDEX TO WS_COMBUF** SAVE VOLUME UNIT AND LENGTH*			LDA		(ZP2)			CMP		#$10			BCC		OL_ALL1A	;LENGTH IS OK;			CLC			LDA		UWORK2			ADC		#$0F			TAY			LDA		#$2A	 	;'*'			STA		WS_COMBUF,Y	;TRUNCATED VOLUME NAME			LDA		#$0F;OL_ALL1A	; 			LDX		UWORK2			STA		WS_COMBUF,X	;SAVE LENGTH OF VOLUME;			LDY		NDT_IDX2			LDA		NDT_UNIT,Y			AND		#%11110000	;STRIP OUT LOW NIBBLE !!!			ORA		WS_COMBUF,X			STA		WS_COMBUF,X	;SAVE UNIT AND LENGTH OF VOLUME;			PLX					;RESTORE INDEX			INX					;MOVE POINTER TO NEXT BYTE			STX		UWORK2		;SAVE INDEX TO WS_COMBUF** DID WE MOVE LAST RECORD YET ?*OL_ALL5	; 			CLC			LDA		<ZP2			ADC		#NDT_NAMELEN			STA		<ZP2			LDA		<ZP2+1			ADC		#$00			STA		<ZP2+1;			LDX		NDT_IDX2			INX			CPX		#14			BNE		OL_ALL1** DO A LOCAL ONLINE*OL_ALL6	; 			LDA		UWORK2			PHA					;SAVE INDEX TO WS_COMBUF;;			JSR		LOCAL		;Make Local Online CallLS_OL_ALL6A	PLX					;RESTORE INDEX TO WS_COMBUF;			LDA		NDT_CNT		;IS THERE ANY ENTRIES IN THE NDT?			BEQ		OL_ALL7		;TIME TO LEAVE** PLACE LOCAL RESULTS IN WS_COMBUF*			LDA		WS_PLIST+2			STA		<SRCBUF			LDA		WS_PLIST+3			STA		<SRCBUF+1;			LDA		PFI_BANK			STA		<SRCBUF+2	;BANK !!!;			CLC			TXA					;RESTORE OFFSET IN WS_COMBUF			ADC		#WS_COMBUF			STA		<DESTBUF			LDA		#$00			ADC		#>WS_COMBUF			STA		<DESTBUF+1			lda		#^ws_combuf			sta		<destbuf+2;			STZ		<COUNT			LDA		#$01		;MOVE ONE PAGE ONTO CARD			STA		<COUNT+1;			JSR		BUFFMOVE	;MOVE THE RESULT NOW** NOW RETURN COMBINED RESULTS TO USER BUFFER*			LDA		#WS_COMBUF			STA		<SRCBUF			LDA		#>WS_COMBUF			STA		<SRCBUF+1			LDA		#^WS_COMBUF			STA		<SRCBUF+2;			LDA		WS_PLIST+2			STA		<DESTBUF			LDA		WS_PLIST+3			STA		<DESTBUF+1;			LDA		PFI_BANK			STA		<DESTBUF+2	;BANK !!!;			STZ		<COUNT			LDA		#$01	;RETURN ONE PAGE TO MOTHERBOARD			STA		<COUNT+1;			JSR		BUFFMOVE** TIME TO LEAVE ONLINE CALL*OL_ALL7	; 			LDA		#00		;PUT DEVICES BACK			SEC			JSR		PDOS_DEVICE			RTS;;			eject*** COMMAND $C6 = SET PREFIX** SET OPEN DIR OVER NETWORK*		EXPORT	SETPREFIXSETPREFIX		;		** IS THIS A VOLUME ?*			JSR		CHK_VOLUME			BCC		SETPREFIX0A	;NOT A VOLUME;			STZ		WS_COMBUF+6			STZ		WS_COMBUF+7			STZ		WS_COMBUF+8			LDA		#$02			STA		WS_COMBUF+9			BRA		SETPREFIX0	;GO SET PREFIX ID** IS THE PREFIX LENGTH OVER MAX*SETPREFIX0A	; 			JSR		CHKSLASH	;IF SLASH CONTINUE			BCS		SETPREFIX00;;			BIT		PFI_NAMING			BMI		SETPREFIX0B;			CLC			LDA		PRO_PREFIX			ADC		WS_PATH			CMP		#MAX_PROPATH			BCC		SETPREFIX00	;LENGTH OK			BCS		SETPREFIX0C	;ERROR IN LENGTH;SETPREFIX0B	; ;			CLC			LDA		AFP_PREFIX			ADC		WS_PATH			CMP		#MAX_AFPPATH-1			BCC		SETPREFIX00	;LENGTH OK;SETPREFIX0C	; 			LDA		#$40		;INVALID PATHNAME			STA		UERROR			RTS** CREATE GET FILE/DIR PARMS CALL*SETPREFIX00	; 			LDA		#GETFDINFO			STA		WS_COMBUF			STZ		WS_COMBUF+1;			JSR		STUFF_IDS;			STZ		WS_COMBUF+$08	;HB OF FILE BITMAP			STZ		WS_COMBUF+$09	;LB OF FILE BITMAP;			LDA		#%00010001	;DIR ID & ACCESS RIGHTS			STA		WS_COMBUF+$0A	;HB OF DIRECTORY BITMAP			STZ		WS_COMBUF+$0B	;LB OF DIRECTORY BITMAP;			CLC			LDX		#$0C		;OFFSET TO NAME IS PACKET			JSR		PATH2BUF** ISSUE GET FILE/DIR PARMS*			JSR		CMD_ROUTING			BCC		SETPREFIX00A	;CALL COMPLETED OK			RTS** IS THIS A FILE OR A DIRECTORY ?*SETPREFIX00A	; 			LDA		WS_COMBUF+$04			BNE		LS_SETCONT;			LDA		#$4B		;STORAGE TYPE ERROR			STA		UERROR			RTS** DOES THE USER HAVE ACCESS TO THIS DIRECTORY ?*LS_SETCONT	LDA		WS_COMBUF+$0A			AND		#%01111111	;ANY RIGHTS ?			BNE		SETPREFIX0	;YES ,ACCESS GRANTED;			LDA		#$4E		;ACCESS ERROR			STA		UERROR			RTS** SET PREFIX LOCATION & DIR ID*SETPREFIX0	; 			LDA		CURSESS;			BIT		PFI_NAMING			BMI		SETPREFIX0_A			STA		PRO_PFXLOC	;UPDATE PREFIX FLAG;			LDX		#$03SETPREFIX1_1	; 			LDA		WS_COMBUF+6,X			STA		PRO_DIR_ID,X	;UPDATE NETWORK DIRECTORY ID			DEX			BPL		SETPREFIX1_1			BRA		SETPREFIX0_B;;SETPREFIX0_A	; 			STA		AFP_PFXLOC	;UPDATE PREFIX FLAG;			LDX		#$03SETPREFIX1_2	; 			LDA		WS_COMBUF+6,X			STA		AFP_DIR_ID,X	;UPDATE NETWORK DIRECTORY ID			DEX			BPL		SETPREFIX1_2** SET MLI PREFIX FLAG TO ACTIVE*SETPREFIX0_B	; 			LDA		#$80		;SET MLI PFIX ACTIVE FLAG			STA		Cn_PFIXPTR** SET PREFIX IN PREFIX BUFFER*			JSR		NEW_PREFIX** UPDATE '..._PFX_DEVNUM'_	THIS FIELD IS USED TO UPDATE DEVNUM* FIELD IN PRODOS WHEN A NETWORK CALL IS MADE THAT USES A* PATHNAME BUT DOESN'T SPECIFY THE VOLUME NAME_ THE FIELD IS* ONLY UPDATED UPON A SUCCESSFUL SET PREFIX CALL WHERE THE* VOLUME WAS SPECIFIED*			JSR		CHKSLASH	;IF NO SLASH THEN EXIT			BCS		SETPREFIX3			RTS					;EXIT NO SLASH** SLASH IS PRESENT SO FND_CURSRV WAS CALLED SO Cn_DEVNUM FIELD* IS VALID*SETPREFIX3	; 			BIT		PFI_NAMING			BMI		SETPREFIX4	;AFP PREFIX;			LDA		Cn_DEVNUM			STA		PRO_PFX_DEV;			LDX		NDT_IDX2			LDA		NDT_IDH,X			STA		PRO_VOL_ID			LDA		NDT_IDL,X			STA		PRO_VOL_ID+1			RTS** UPDATE AFP PREFIX - LAST DEVICE*SETPREFIX4	; 			LDA		Cn_DEVNUM			STA		AFP_PFX_DEV;			LDX		NDT_IDX2			LDA		NDT_IDH,X			STA		AFP_VOL_ID			LDA		NDT_IDL,X			STA		AFP_VOL_ID+1			RTS;;			eject*** COMMAND $C7 = GET PREFIX**		EXPORT	GETPREFIXGETPREFIX		;		** CHANGE SERVER DELIMITERS TO PRODOS DELIMITERS*GETPREFIX1	; 			BIT		PFI_NAMING			BMI		GETPREFIX1A;			LDY		PRO_PREFIX			BRA		GETPREFIX2;GETPREFIX1A	; 			LDY		AFP_PREFIX;GETPREFIX2	; 			BIT		PFI_NAMING			BMI		GETPREFIX2A;			LDA		PRO_PREFIX,Y			BRA		GETPREFIX2B;GETPREFIX2A	; 			LDA		AFP_PREFIX,Y;GETPREFIX2B	; 			CPY		#$00			BEQ		GETPREFIX3	;LENGTH BYTE !!			CMP		#SRVR_SLASH	;IS IT A SEGMENT DIVIDER ?			BNE		GETPREFIX3	;NO, SAVE IT LIKE IT IS			LDA		#SLASH		;REPLACE $1C WITH A SLASH ($2F)GETPREFIX3	; 			STA		WS_COMBUF,Y			DEY			BPL		GETPREFIX2	;MORE TO MOVE** SETUP B1_BUFFMOVE TO MOTHERBOARD*			LDA		WS_PLIST+1	;DESTINATION			STA		<DESTBUF			LDA		WS_PLIST+2			STA		<DESTBUF+1;			LDA		PFI_BANK			STA		<DESTBUF+2	;BANK !!!;			LDA		#WS_COMBUF	;SOURCE			STA		<SRCBUF			LDA		#>WS_COMBUF			STA		<SRCBUF+1			LDA		#^WS_COMBUF			STA		<SRCBUF+2;			LDY		WS_COMBUF	;COUNT			INY					;INCLUDE COUNT BYTE			STY		<COUNT			LDA		#%00		;MOVE FROM CARD TO MOTHERBOARD			STA		<COUNT+1			JMP		BUFFMOVE;;		ENDP		end