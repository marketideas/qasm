;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	Import	NETWORK_CALL_RESULT	Import	SESSION_VERS	Import	Session_Name	Import	SESSION_NET	IMPORT	AFP_PFXLOC	IMPORT	AFP_PREFIX	IMPORT	ATTEN_TIME	IMPORT	AUN_CNT	IMPORT	AUN_HOLD	IMPORT	AUN_RAM	IMPORT	CHK_PRODOS	IMPORT	CLOSE_SESSION	IMPORT	CMD_ROUTING	IMPORT	CURSESS	IMPORT	Cn_DEVNUM	IMPORT	Cn_PFIERR	IMPORT	EXIT_PFI	IMPORT	FIRST_MOUNT	IMPORT	FND_CURSRV	IMPORT	LCL_DEVCNT	IMPORT	NDT_CNT	IMPORT	NDT_IDH	IMPORT	NDT_IDL	IMPORT	NDT_IDX1	IMPORT	NDT_IDX2	IMPORT	NDT_NAME	IMPORT	NDT_SESS	IMPORT	NDT_UNIT	IMPORT	PDOS_DEVICE	IMPORT	PFI_CLEANUP	IMPORT	PFI_NAMING	IMPORT	PFI_NODEV	IMPORT	PFI_RETRY	IMPORT	PFI_STATUS	IMPORT	PKT_CNT	IMPORT	PRO_PFXLOC	IMPORT	PRO_PREFIX	IMPORT	PUN_ROM	IMPORT	SESSION_NETH	IMPORT	SESSION_NETL	IMPORT	SESSION_NODE	IMPORT	SESSION_TBL	IMPORT	SESS_CHK	IMPORT	SRCPATH	IMPORT	THISNET	IMPORT	UCURSHR	IMPORT	UERROR	IMPORT	UMODE	IMPORT	USER_NAME	IMPORT	UWORK1	IMPORT	UWORK2	IMPORT	Update_TMR	IMPORT	VOL_UNMOUNT	IMPORT	WS_COMBUF	IMPORT	WS_PATH	IMPORT	ZP_BANK	IMPORT	adjust	IMPORT	adjust_c	IMPORT	aspopparm	IMPORT	getinfoparm	IMPORT	login_error	IMPORT	network_call	IMPORT	pfi_bank	IMPORT	pl_bank	IMPORT	sess_idx	IMPORT	userbuf	IMPORT	ACTIVE8		IMPORT	VECTOR_MOUNT	IMPORT	VECTOR_UNMNT	IMPORT	VECTOR_ATTEN	import	CheckAsync		; 7-Oct-91 MSD	;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	UNMOUNT** pfi_cmds** Greg Seitz (13-Jul-87)** fixed off by 1 problem in setting name on mount at label MOUNT9* 2-Sep-87 GWS***	PARAMIS NETWORK SOFTWARE***	CONFIDENTIAL*** MODULE _	PFI0.A - PRODOS FILING INTERFACE	(PART 0)*	ADDITIONAL CALLS**	WRITTEN BY THOMAS EAGER**	MODIFIED_ 06-15-87	4_18	TE**	COPYRIGHT 1986,87	ParaMIS CORPORATION** ALL RIGHTS RESERVED**		include	'global.equates'		include 'pfi_equates'		;		EXPORT	zpcmds		;zpcmds		PROC		INCLUDE	'zp.equates';		ENDP		EXPORT	pficmds		pficmds		PROC		EXPORT	setupsetup		;		;routine that sets things up for cmds			phk			plb					;set data bank to code bank			sep		#mbit+xbit	;force 8 bit mode			longa	off			longi	off			ldx		#00			;assume normal mode of bank zero main mem in			lda		>isramrd	;see if aux ram is on			bpl		usexmode	;use what x is (zero)			ldx		#01			;aux mem was active use bank 1usexmode	; 			stx		pl_bank		;set these later to reflect real			stx		pfi_bank	;bank prodos call came from			;			;			;-----> 5/31/88 FIND ZERO PAGE BANK			;			ldx		#$00			lda		>ALTZP			bpl		XUSE_MODE			LDX		#$01XUSE_MODE	;			STX		ZP_BANK			;			;-----> END			;			rts		EXPORT	buffmovebuffmove	 					;moves data with 24 bit addresses			php					;save mode			phb					;save current bank			longi	on			longa	on			rep		#Mbit+Xbit			;			lda		<count		;get count			bit		#$0001			beq		Buffmove1			;			tay			longa	off			sep		#Mbit			dey			lda		[srcbuf],y			sta		[destbuf],y			rep		#mbit			longa	on			dec		<count			;Buffmove1	ldy		<count			beq		buffmvdn	;nothing to moveBuffmove2	dey			dey			lda		[srcbuf],y			sta		[destbuf],y			cpy		#$00			bne		Buffmove2			;			;buffmvdn	 			plb					;recover bank, since changed by mvn			plp					;restore state			longa	off			longi	off			rts		EXPORT	getzp1parmgetzp1parm		;					lda		#aspopparm			sta		<zp1			lda		#>aspopparm			sta		<zp1+1		;point to some memory for open parm			rts*** INITIALZE RAM AREAS ON RESET**			longa	off			longi	off		EXPORT	WSINITWSINIT		;		** INITIALIZE CURRENT SERVER & CURRENT SHARE on reset*			php					;save state			sep		#mbit+xbit	;force 8 bit mode			STZ		UCURSHR			STZ		CURSESS			STZ		PFI_STATUS	;NO CALL IN PROCESS			STZ		PFI_RETRY	;LOGIN NOT ACTIVE !!!			STZ		PFI_NODEV;			LDA		#$80			STA		PFI_CLEANUP	;NEED TO CLEANUP NETWORK FILES** ZERO OUT SESSION TABLE*			LDX		#MAXSESSION-1ws_LOOP7	STZ		SESSION_TBL,X			DEX			BPL		ws_LOOP7			plp					;recover state			RTS;;			eject**** INITIALIZE WITH INITIALIZE CALL***		EXPORT	PFI_INITPFI_INIT		;		** INITIALIZE VARIABLES*			php					;save state			sep		#mbit+xbit	;force 8 bit mode			STZ		PFI_NAMING	;USE PRODOS NAMING CONVENTION			STZ		PRO_PREFIX	;NO PRODOS PREFIX			STZ		AFP_PREFIX	;NO AFP	PREFIX			STZ		ACTIVE8		;ProDOS 8 Is not ACTIVE								;			ldx 	#$03WS_LP1A		STZ		VECTOR_MOUNT,x			STZ		VECTOR_UNMNT,x			STZ		VECTOR_ATTEN,x			DEX			BNE		WS_LP1A			;			LDA		#$FF			STA		PRO_PFXLOC	;INIT PREFIX LOCATION			STA		AFP_PFXLOC	;INIT PREFIX LOCATION								;								;								;----> 3/2/88 te                                ;								;								;** INIT NETWORK DEVICE TABLE*			STZ		PFI_CLEANUP			STZ		NDT_CNT		;NUMBER OPF MOUNTED VOLUMES			STZ		FIRST_MOUNT	;FLAG FOR FIRST MOUNT !!!			LDX		#14			DEXws_LOOP2	STZ		NDT_SESS,X			DEX			BPL		ws_LOOP2								;								;-----> 3/2/te								;								;** initialize open modes for all files*			ldx	#7ws_loop4	stz UMODE,x			dex			BPL ws_loop4								;								;-----> end								;								;		** ZERO OUT USER'S NAME*			LDX		#$00pf_LOOP2	STZ		USER_NAME,X			INX			CPX		#MAXUSERSZ			BNE		pf_LOOP2** ZERO OUT SOURCE PATH*			LDX		#$00pf_LOOP3	STZ		SRCPATH,X			INX			CPX		#MAXSRCPATH			BNE		pf_LOOP3			LDX		#$03pf_LOOP4	lda		adjust_c,x			sta		adjust,x			dex			bpl		pf_LOOP4			plp						;recover state			RTS;;** COMMAND $2A = FINAME - SET/GET USER Prefex**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $2A	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	|	DIRECTIONAL FLAG	|*	---------------------*	5	|	BUFFER POINTER	(4)|*	---------------------**		EXPORT	CFINAMECFINAME			jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup		;standard setup stuff** FIND WHICH DIRECTION TO MOVE NAME*			LDY		#$04			LDA		[ZP0],Y			BEQ		GETNAME			CMP		#$AA			BEQ		FINAME2		;SET THE USER'S NAME			JMP		FINAME4** TIME TO GET THE USER'S NAME*;GETNAME		LDY		#$05			LDA		[ZP0],Y			STA		<DESTBUF			INY			LDA		[ZP0],Y			STA		<DESTBUF+1			INY			LDA		[ZP0],Y			STA		<DESTBUF+2;			LDA		#USER_NAME			STA		<SRCBUF			LDA		#>USER_NAME			STA		<SRCBUF+1			lda		#^user_name			sta		<srcbuf+2			lda		#maxusersz			STA		<COUNT			LDA		#0			STA		<COUNT+1		;TWO PORT MOVE - OFF OF CARD								;			JSR		BUFFMOVE;FINISHED WITH THE MOVE			BRA		FINAME4		;SET RESULT CODE** TIME TO SET THE USER'S NAME*FINAME2	; ;			LDY		#$05			LDA		[ZP0],Y			STA		<SRCBUF			INY			LDA		[ZP0],Y			STA		<SRCBUF+1			INY			LDA		[ZP0],Y			STA		<SRCBUF+2;			LDA		#USER_NAME			STA		<DESTBUF			LDA		#>USER_NAME			STA		<DESTBUF+1			lda		#^user_name			sta		<destbuf+2								;			lda		#maxusersz			STA		<COUNT			LDA		#0			STA		<COUNT+1		;TWO PORT MOVE - OFF OF CARD			JSR		BUFFMOVE	;FINISHED WITH THE MOVE;** SET THE RESULT CODE TO NO ERROR*FINAME4	; 			LDA		#$00		;RESULT CODE - LB			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI** COMMAND $36 = FIUSERBUF - SET/GET USER Buffer**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $36	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	|	DIRECTIONAL FLAG	|*   -------------------------*   5   |   BUFFER LENGTH   (2) |*	---------------------*	7	|	BUFFER POINTER	(4)|*	---------------------**		EXPORT	CFIUSERBUFCFIUSERBUF		;		** STANDARD SETUP STUFF*			jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup		;standard setup stuff			;			stz		UERROR		;INITIALIZE ERROR TO NONE**  IS THE BUFFER LENGTH TOO LONG ??**  SET LENGTH OF DATA TO MOVE*					SEC			LDY		#$05			LDA		#<maxuserbufsz			SBC		[ZP0],Y			INY			LDA		#>maxuserbufsz			SBC		[ZP0],Y			BCS		USERBUFOK			;			;			LDA		#$1A			;REQUEST TOO LONG			STA		UERROR			;			LDA		#<maxuserbufsz			STA		COUNT			LDA		#>maxuserbufsz			STA		COUNT+1			BRA		USERBUFCHK			;			;USERBUFOK	LDA [ZP0],Y			STA COUNT+1			DEY			LDA [ZP0],Y			STA COUNT** FIND WHICH DIRECTION TO MOVE buffer*USERBUFCHK	LDY		#$04			LDA		[ZP0],Y			BMI		FIUSERBUF2		;SET THE USER'S NAME** USER'S BUFFER IS THE DESTINATION*			LDY		#$07			LDA		[ZP0],Y			STA		<DESTBUF			INY			LDA		[ZP0],Y			STA		<DESTBUF+1			INY			LDA		[ZP0],Y			STA		<DESTBUF+2;			LDA		#userbuf			STA		<SRCBUF			LDA		#>userbuf			STA		<SRCBUF+1			lda		#^userbuf			sta		<srcbuf+2			BRA		FIUSERBUF4		** USER'S BUFFER IS THE SOURCE*FIUSERBUF2	; 			LDY		#$07			LDA		[ZP0],Y			STA		<SRCBUF			INY			LDA		[ZP0],Y			STA		<SRCBUF+1			INY			LDA		[ZP0],Y			STA		<SRCBUF+2;			LDA		#userbuf			STA		<DESTBUF			LDA		#>userbuf			STA		<DESTBUF+1			lda		#^userbuf			sta		<destbuf+2** MOVE THE DATA*FIUSERBUF4	; 		 	JSR		BUFFMOVE	;FINISHED WITH THE MOVE** SET THE RESULT CODE *			LDA		UERROR		;RESULT CODE - LB			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI			;			;			eject*** COMMAND $2B = FILOGIN - LOGIN TO SERVER**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $2B	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	|	SLS NETWORK	(2)|*	---------------------*	6	|	SLS NODE	|*	---------------------*	7	|	SLS SOCKET	|*	---------------------*	8	|	CMD BUFFER LEN	(2)|*	---------------------*	A	|	CMD BUFFER PTR	(4)|*	---------------------*	E	| REPLY BUFFER LEN (2)|*	---------------------* 10	| REPLY BUFFER PTR (4)|*	---------------------* 14	| SESSION REFERENCE # | **	---------------------*		Export	CFIXLogin		EXPORT	CFILOGINCFILOGINCFIXLogin	;					jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup			rep		#mbit+xbit			longa	on			longi	on			ldx		#getinfoparm			ldy		#^getinfoparm			jsl		>RamDispatch	;find network number			sep		#mbit+xbit			longa	off			longi	off** SAVE PL HEAP NUMBER*** IS THE WORKSTATION ALREADY LOGGED INTO THIS SERVER ?*			LDX		#$00_LOOP2b		LDA		SESSION_TBL,X			BEQ		_NEXT2b		;NOT ACTIVE*			LDY		#$04			LDA		[ZP0],Y		;IS NETWORK = ZERO ?			BNE		_CHKA		;NO, NOT ZERO			INY			LDA		[ZP0],Y			BEQ		_CHKB		;YES IT IS THISNET*_CHKA		LDY		#$04			LDA		[ZP0],Y		;IS NETWORK = THISNET ?			CMP		THISNET+1			BNE		_CHKD		;NOT THISNET			INY			LDA		[ZP0],Y			CMP		THISNET			BNE		_CHKD		;NOT THISNET*_CHKB		LDA		SESSION_NETH,X	;IS SESSION ENTRY = ZERO ?			BNE		_CHKC		;NOT ZERO			LDA		SESSION_NETL,X			BEQ		_CHKNODE	;NETWORK MATCHES*_CHKC		LDA		SESSION_NETH,X	;IS SESSION ENTRY = THISNET ?			CMP		THISNET			BNE		_NEXT2b		;NETWORK DOES NOT MATCH			LDA		SESSION_NETL,X			CMP		THISNET+1			BNE		_NEXT2b		;NETWORK DOES NOT MATCH			BRA		_CHKNODE	;MATCH !!!*_CHKD		LDY		#$04			LDA		[ZP0],Y			CMP		SESSION_NETH,X			BNE		_NEXT2b		;NOT A MATCH - NETWORK HB			INY			LDA		[ZP0],Y			CMP		SESSION_NETL,X			BNE		_NEXT2b		;NOT A MATCH - NETWORK LB;;_CHKNODE	LDY		#$06		;CHECK NODE NUMBER			LDA		[ZP0],Y			CMP		SESSION_NODE,X	;SAME NODE ??			BEQ		_SAMERR		;THE SAME !!!!!!!!_NEXT2b		INX			CPX		#MAXSESSION			BNE		_LOOP2b;			BRA		_NOTHERE	;NO MATCH FOUND** ERROR - ALREADY LOGIN TO SERVER*_SAMERR		LDA		SESSION_TBL,X	;[X] IS ALREADY SET			LDY		#$14			STA		[ZP0],Y;			INY					;[Y] LENGTH TO RETURN			LDA		#$13		;ALREADY LOGIN TO SERVER !!!!			SEC					;NON STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI** IS THERE ROOM FOR ONE MORE SESSION ?*_NOTHERE	; 			ldy		#8			;see if buffer len is zero			lda		[ZP0],y			iny			ora		[ZP0],y			bne		_xxlogin1	;no so continue			jmp		login5		;yes, so exit no error, don't issue call_xxlogin1	; 			LDX		#$00LOGIN1	; 			LDA		SESSION_TBL,X			BEQ		LOGIN1A			INX			CPX		#MAXSESSION			BNE		LOGIN1		;LOOK AT THE NEXT ONE** ERROR - NO MORE ROOM FOR MORE SESSIONS*			LDA		#$01		;TOO MANY SESSIONS !!!!			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI** FIND ASP HEAP SPACE FOR OPEN SESSION CALL*LOGIN1A	; 			stx		sess_idx** STUFF OPEN SESSION CALL*			jsr		getzp1parm	;get pointer to enough mem for cmd parm			LDY		#$00			LDA		#$00			STA		(ZP1),Y		;SAVE ASYNC FLAG			INY			LDA		#CMD_ASPOPN			STA		(ZP1),Y		;SAVE COMMAND			LDY		#$08			STY		UWORK2			LDY		#$04LOGIN2	; 			STY		UWORK1			LDA		[ZP0],Y		;GET SLS ADDRESS FROM FI PARAMETER LIST			LDY		UWORK2			STA		(ZP1),Y		;SAVE SLS ADDRESS IN THE ASP OPEN PL			INY			STY		UWORK2;			LDY		UWORK1			INY			CPY		#$08			BNE		LOGIN2;;** IS THERE AN ATTENTION ROUTINE ??*			LDY		#$15			LDA		#$00_LOOP2b1	ORA		[ZP0],Y			INY			CPY		#$19			BNE		_LOOP2b1;			CMP		#$00		;USE DEFAULT ??			BNE		_NODEFAULT** USE DEFAULT ATTENTION ROUTINE*			LDY		#$0C		;DEFAULT ATTENTION ROUTINE			LDA		#ATTEN_TIME			STA		(ZP1),Y			INY			LDA		#>ATTEN_TIME			STA		(ZP1),Y			INY			LDA		#^ATTEN_TIME			STA		(ZP1),Y			BRA		_SETFLAG** USE USER DEFINED ATTENTION ROUTINE*_NODEFAULT	LDY		#$15_SAVEIT		LDA		[ZP0],Y			PHA					;SAVE IT			INY			CPY		#$19			BNE		_SAVEIT;			LDY		#$0F_RESTORE	PLA			STA		(ZP1),Y			DEY			CPY		#$0B			BNE		_RESTORE** ISSUE NETWORK CALL*_SETFLAG	; ;make the open call here_pfi_process	; 			jsr		network_call	;make the call of zp1 parm list** WAS THERE AN ERROR IN THE OPEN SESSION CALL ?*			LDY		#$02			LDA		(ZP1),Y			BEQ		LOGIN3		;CONTINUE PROCESS			CMP		#$09		;SERVER TOO BUSY?			BNE		L3_NEXT			LDA		#$02		;UNABLE TO OPEN SESSION			BRA		LOGIN3BL3_NEXT	; 			CMP		#$06		;NO RESPONSE			BNE		L3_NEXT1			LDA		#$03		;NO RESPONSE FROM SERVER			BRA		LOGIN3BL3_NEXT1	; 			CMP		#$07		;BAD VERSION?			BNE		L3_NEXT2			LDA		#$19		;BAD VERSION			BRA		LOGIN3BL3_NEXT2	LDA		#$01		;TOO MANY SESSIONS** ERROR - UNABLE TO OPEN SESSION*LOGIN3B	; 			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI;** CREATE ASP CMD PACKET (LOGIN PACKET)*LOGIN3	; 			LDY		#$00			LDA		#$00			STA		(ZP1),Y		;SAVE ASYNC FLAG			INY			LDA		#CMD_ASPCMD			STA		(ZP1),Y		;SAVE COMMAND BYTE			LDY		#$10			LDA		(ZP1),Y		;FROM PREVIOUS OPEN SESSION CALL			LDY		#$08			STA		(ZP1),Y		;SAVE SESSION REFERENCE NUMBER			ldy		#$14		;save session number in logon			sta		[zp0],y		;parm list**			LDX		SESS_IDX			STA		SESSION_TBL,X	;SAVE IN TABLE;			LDY		#$04			LDA		[ZP0],Y			STA		SESSION_NETH,X;			INY			LDA		[ZP0],Y			STA		SESSION_NETL,X								;			INY			LDA		[ZP0],Y			STA		SESSION_NODE,X;			txa			asl		a			tax			LDA		#$02						;Make all logins version			STA		SESSION_VERS+1,X			;2.0 by default.			STZ		SESSION_VERS,X				;** TGH 3/6/89			;			;-----> find index to name table			;			LDX		SESS_IDX			LDA		#<SESSION_NAME			STA		ZP2			LDA		#>SESSION_NAME			STA		ZP2+1			LDA		#<SESSION_NET			STA		ZP4			LDA		#>SESSION_NET			STA		ZP4+1name_lp		dex 			bmi		Login3A			clc			LDA		ZP2			adc		#$21			sta		ZP2			LDA		ZP2+1			adc		#$00			STA		ZP2+1			clc			LDA		ZP4			adc		#$22			sta		ZP4			LDA		ZP4+1			adc		#$00			STA		ZP4+1			BRA		NAME_LP			;Login3A		LDA		#$00			STA		(ZP2)		;MAKE SURE IT IS INITALIZED			sta		(zp4)			;			;			;---> is this the special Login			;			ldy		#$01			lda		[ZP0],y			cmp		#$2B			beq		Login3ae		;not the special Command			;			; move AFP version number into table  3/6/89 **TGH			;			lda		SESS_IDX		;Session number times 2.			asl		a			tax			ldy		#$21			;offset to version number			lda		[ZP0],y			sta		SESSION_VERS,x			iny			lda		[ZP0],y			sta		SESSION_VERS+1,x			;			; move server name into table  11/17/88 **TGH			;			LDY		#$19			ldx		#$00Login3aa	LDA		[ZP0],Y			STA		ZP3,x			inx			INY			CPY		#$1d			bne		Login3aa			;			;			ldy		#$20Login3ab	lda		[ZP3],y			sta		(zp2),y			dey			bpl		Login3ab			;			; move network name into table 11/17/88 **TGH			;			LDY		#$1d			ldx		#$00Login3ac	LDA		[ZP0],Y			STA		ZP3,x			inx			INY			CPY		#$21			bne		Login3ac			;			;			ldy		#$21Login3ad	lda		[ZP3],y			sta		(zp4),y			dey			bpl		Login3ad** get ready for ASP Command*Login3ae		LDY		#$08		;MOVE BUFFER INFO (CMD & REPLY)LOGIN4	; 			LDA		[ZP0],Y			INY			STA		(ZP1),Y			CPY		#$14			BNE		LOGIN4		;MORE TO MOVE** ISSUE ASP COMMAND CALL TO SERVER*			JSR		NETWORK_CALL			BCC		LOGIN5		;CONTINUE WITH LOGIN** ERROR - NO RESPONSE FROM SERVER*			LDA		Cn_PFIERR			CMP		#$77		;LOG CONT ERROR			BNE		LOGIN4A;			JSR		Update_TMR			LDA		#$04		;LOGIN CONTINUE			LDY		#$15			SEC			JMP		EXIT_PFI;;LOGIN4A	; 			PHA			lda		NETWORK_CALL_RESULT			;CLOSE_SESSION clobbers			pha									;NETWORK_CALL_RESULT so we save it.			JSR		CLOSE_SESSION			pla									;Get back NETWORK_CALL_RESULT.			sta		NETWORK_CALL_RESULT			PLA			STA		CN_PFIERR	;RESTORE PFI ERROR;			jsr		login_error* The chunk of code below was added in order to return error #$1A* (parameter size error).  I push and pull a because I don't want* to trash a,x,or y because I'm not sure if EXIT_PFI wants them.* 11/29/88  **TGH			pha							;Save old error code.			lda		NETWORK_CALL_RESULT			cmp		#$04				;Was this an ASP size error?			bne		@L1					;Branch if not.			pla							;Pull old error code.			lda		#$1A				;PFI Parameter Size Error			pha							;Push new error code.@L1			pla							;Get error code.* End new code chunk			clc			JMP		EXIT_PFI** RETURN FI PARAMETER LIST*LOGIN5	; 			JSR		Update_TMR			LDA		#$00		;NO ERROR			LDY		#$15		;AMOUNT TO RETURN TO MB			SEC			JMP		EXIT_PFI			eject*** COMMAND $2C = FILOGCONT - CONTINUE LOGIN TO SERVER**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $2C	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	| SESSION REFERENCE # |*	---------------------*	5	|	CMD BUFFER LEN (2)|*	---------------------*	7	|	CMD BUFFER PTR (4)|*	---------------------*	B	| REPLY BUFFER LEN (2)|*	---------------------*	D	| REPLY BUFFER PTR (4)|*	---------------------*		EXPORT	CFILOGCONTCFILOGCONT		;					jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup** SAVE PL HEAP NUMBER*** IS THIS A VALID SESSION REFERENCE NUMBER ?*			JSR		SESS_CHK			BCC		LOGCONT1	;YES IT IS VALID** ERROR UNABLE TO FIND SESSION REFERENCE NUMBER*			LDA		#$06		;INVALID SESSION NUMBER			CLC			JMP		EXIT_PFI** CREATE ASP CMD PARAMETER LIST*LOGCONT1	; 			jsr		getzp1parm			LDY		#$00			LDA		#$00			STA		(ZP1),Y		;SAVE ASYNC FLAG			INY			LDA		#CMD_ASPCMD			STA		(ZP1),Y		;SAVE COMMAND BYTE			LDY		#$04			LDA		[ZP0],Y			LDY		#$08			STA		(ZP1),Y		;SAVE REFERENCE #;;			LDY		#$09			STY		UWORK2			LDY		#$05LOGCONT3	; 			STY		UWORK1			LDA		[ZP0],Y		;GET SLS ADDRESS FROM FI PARAMETER LIST			LDY		UWORK2			STA		(ZP1),Y		;SAVE SLS ADDRESS IN THE ASP OPEN PL			INY			STY		UWORK2;			LDY		UWORK1			INY			CPY		#$11			BNE		LOGCONT3** ISSUE ASP COMMAND CALL TO SERVER*			JSR		NETWORK_CALL			BCC		LOGCONT4	;CONTINUE WITH LOGCONT** ERROR - NO RESPONSE FROM SERVER*			LDA		Cn_PFIERR			CMP		#$77		;LOG CONT			BNE		LOGCONT3A;			LDA		#$04		;LOGIN CONTINUE			CLC			JMP		EXIT_PFI;;LOGCONT3A	; 			PHA			JSR		CLOSE_SESSION			PLA			STA		CN_PFIERR	;RESTORE PFI ERROR;			jsr		login_error			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI** RETURN RESULT CODE*LOGCONT4	; 			LDA		#$00		;NO ERROR			CLC			JMP		EXIT_PFI			eject*** COMMAND $2D = FILOGOUT - LOGOUT TO SERVER**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $2D	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	| SESSION REFERENCE # |*	---------------------*		EXPORT	CFILOGOUTCFILOGOUT		;					jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup** IS THIS A VALID SESSION REFERENCE NUMBER ?*			JSR		SESS_CHK			BCC		LOGOUT2		;SESSION IS FOUND** ERROR - UNABLE TO FIND SESSION*			LDA		#$06		;INVALID SESSION NUMBER			CLC			JMP		EXIT_PFI** CREATE & ISSUE LOGOUT PACKET*LOGOUT2	; 			LDA		#LOGOUT			STA		WS_COMBUF;			LDA		#$01			STA		PKT_CNT			STZ		PKT_CNT+1;			LDY		#$04			LDA		[ZP0],Y			STA		CURSESS		;SAVE SESSION REF #;			JSR		CMD_ROUTING** CLOSE SESSION*			JSR		CLOSE_SESSION** UNMOUNT VOLUMES FOR THAT SESSION*			LDX		#13LOGOUT3	; 			LDA		CURSESS			CMP		NDT_SESS,X			BNE		LOGOUT4		;THIS IS NOT THE SAME SESSION			lda		SESS_IDX			LDY		#$00			CLC					;SEND NO PACKET			JSR		VOL_UNMOUNT	;X IS OFFSET TO NDT TABLES								;X IS UNCHANGED !!!LOGOUT4	; 			DEX			BPL		LOGOUT3		;MORE TO CHECK** REMOVE SESSION FROM SESSION TABLE*			LDX		SESS_IDX			STZ		SESSION_TBL,X	;REMOVE FROM TABLE** RETURN NO ERROR FOR RESULT CODE*			LDA		#$00		;NO ERROR			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI			eject*** COMMAND $2E = FIMOUNT - MOUNT VOLUME FROM SERVER**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $2E	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	| SESSION REFERENCE # |*	---------------------*	5	|	MOUNT FLAG	|*	---------------------*	6	|	VOLUME NAME PTR (4)|*	---------------------*	A	|	VOLUME ID	(2)|*	---------------------*	C	|	SLOT/DRIVE	| **	---------------------*;; 20-Dec-91 MSD	Commented out three instructions that changed a;				slash (/) character in a volume name to a zero.;				This is inappropriate since only a volume name is;				supplied (normally, the separator -- either slash;				or colon -- is changed to nulls in a pathname).;		EXPORT	CFIMOUNTCFIMOUNT		;					jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup** SAVE PL HEAP NUMBER*** IS THIS A VALID SESSION REFERENCE NUMBER ?*			JSR		SESS_CHK			BCC		FIMOUNT1	;SESSION IS FOUND** ERROR - INVALID SESSION NUMBER*			LDA		#$06		;INVALID SESSION NUMBER			CLC			JMP		EXIT_PFI** MOVE PATHNAME TO THE CARD*FIMOUNT1	; 			LDY		#$04			LDA		[ZP0],Y			STA		CURSESS		;SAVE SESSION REF #;			LDY		#$06			LDA		[ZP0],Y			STA		<SRCBUF			INY			LDA		[ZP0],Y			STA		<SRCBUF+1			INY			LDA		[ZP0],Y			STA		<SRCBUF+2;			LDA		#WS_PATH			STA		<DESTBUF			LDA		#>WS_PATH			STA		<DESTBUF+1			lda		#^ws_path			sta		<destbuf+2;			LDA		#NDT_NAMELEN			STA		<COUNT			LDA		#00			STA		<COUNT+1;			JSR		BUFFMOVE** CHECK PATH LENGTH BYTE (IF OVER 28 )*			LDX		WS_PATH			beq		mnterr			CPX		#NDT_NAMELEN			BCC		FIMOUNT2	;LENGTH IS OK !!!** ERROR - INVALID NAME FORMAT*mnterr	; 			LDA		#$05		;INVALID NAME			CLC			JMP		EXIT_PFI** MUST SHIFT NAME ONE PLACE TO INSERT SLASH*FIMOUNT2	; 			LDA		WS_PATH,X			STA		WS_PATH+1,X			DEX			BNE		FIMOUNT2	;MORE TO MOVE			LDA		#SLASH			STA		WS_PATH+1			INC		WS_PATH		;UPDATE LENGTH** IS THIS A MOUNT CALL ?*			LDY		#$05			LDA		[ZP0],Y			BMI		MOUNT1			JMP		UNMOUNT		;NO , IT WAS TO UNMOUNT A VOLUME*** MOUNT A VOLUME**** IS THIS VOLUME ALREADY MOUNTED ?*MOUNT1	; 			JSR		FND_CURSRV			BCS		MOUNT1A		;VOLUME NOT FOUND** ERROR - VOLUME ALREADY MOUNTED*			LDA		#$11			CLC			JMP		EXIT_PFI** REMOVE THE SLASH AS FIRST CHARACTER*MOUNT1A	; 			LDY		#$01_LOOP2e		LDA		WS_PATH+1,Y			STA		WS_PATH,Y			INY			CPY		WS_PATH			BNE		_LOOP2e;			DEC		WS_PATH** IS THERE AN AVAILABLE SPACE IN THE NDT ?*MOUNT2	; 			LDA		NDT_CNT			CMP 	#14					;Changed from 15  **TGH			BCC		MOUNT3		;YES, THERE ARE SOME AVAIL UNIT #** ERROR - TOO MANY VOLUMES*			LDA		#$08		;TOO MANY VOLUMES !!!!			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI** ARE WE IN PRODOS NAMING MODE ?*MOUNT3	; 			LDA		WS_PATH			CMP		#NDT_NAMELEN			BCS		MOUNT3_AA	;LENGTH IS OK;			BIT		PFI_NAMING			BMI		MOUNT3_A	;AFP MODE;			JSR		CHK_PRODOS			BCC		MOUNT3_A	;VALID PRODOS MODE;MOUNT3_AA	; 			LDA		#$05		;INVALID NAME FORMAT			CLC			JMP		EXIT_PFI** CREATE OPEN VOLUME PACKET IN WS_COMBUF*MOUNT3_A	; 			LDA		#OPENVOL			STA		WS_COMBUF			STZ		WS_COMBUF+1;			STZ		WS_COMBUF+2	;HIGH BYTE OF BITMAP = 0			LDA		#%00100000	 ;RETURN VOLUME ID			STA		WS_COMBUF+3	;LOW BYTE OF BITMAP** MOVE NAME INTO PACKET*			LDY		WS_PATHMOUNT3A	; 			LDA		WS_PATH,Y;			CMP		#SLASH						; Removed 20-Dec-91 MSD;			BNE		MOUNT3AA	;NOT A SLASH	; Removed 20-Dec-91 MSD;			LDA		#SRVR_SLASH					; Removed 20-Dec-91 MSDMOUNT3AA	; 			STA		WS_COMBUF+4,Y			DEY			BPL		MOUNT3A** FIND LENGTH OF PACKET*			CLC			LDA		WS_PATH			ADC		#$05		;COUNT BYTE + BITMAP + CMD + 0			STA		PKT_CNT			STZ		PKT_CNT+1** IS THE LAST CHARACTER A SLASH ?*			LDY		WS_PATH			LDA		WS_COMBUF+4,Y			CMP		#SRVR_SLASH			BNE		MOUNT3AAA;			DEC		PKT_CNT		;REMOVE ONE FROM COUNT			DEC		WS_COMBUF+4	;REDUCE SIZE OF VOLUME** IS THE PACKET AN EVEN COUNT (PAD ?)*MOUNT3AAA	; 			LDA		PKT_CNT			AND		#%00000001	;ODD ?			BEQ		MOUNT3AAAA	;NO, PADDING NEEDED;			LDX		PKT_CNT			STZ		WS_COMBUF,X			INX			STX		PKT_CNT** IS THERE A PASSWORD ?*MOUNT3AAAA	; 			LDY		#$05			LDA		[ZP0],Y			AND		#%01000000			BEQ		MOUNT3B		;NO THERE IS NO PASSWORD** MOVE PASSWORD INTO PACKET*			LDY		#$0D			LDA		[ZP0],Y			STA		<SRCBUF			INY			LDA		[ZP0],Y			STA		<SRCBUF+1			INY			LDA		[ZP0],Y			STA		<SRCBUF+2;			CLC			LDA		PKT_CNT			ADC		#WS_COMBUF			STA		<DESTBUF			LDA		PKT_CNT+1			ADC		#>WS_COMBUF			STA		<DESTBUF+1			lda		#^WS_COMBUF			sta		<destbuf+2;			LDA		#$08		;SIZE OF PASSWORD			STA		<COUNT			LDA		#00			;MOVE ONTO CARD			STA		<COUNT+1;			JSR		BUFFMOVE** ADJUST PACKET SIZE*			CLC			LDA		PKT_CNT			ADC		#$08			STA		PKT_CNT** ISSUE AFP OPEN VOLUME COMMAND*MOUNT3B	; 			JSR		CMD_ROUTING			BCC		MOUNT4		;VOLUME IS NOW OPEN FOR USER** WAS THIS A PARM ERROR ??*			LDA		Cn_PFIERR			cmp		#$65			bne		mv_over** ERROR - INVALID SESSION NUMBER or unknow volume*			LDA		#$06		;INVALID SESSION NUMBER			CLC			JMP		EXIT_PFI** ERROR -- UNABLE TO OPEN VOLUME*mv_over		LDA		#$07		;UNABLE TO OPEN VOLUME !!!!			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI** FIND AVAILABLE SPACE IN TABLE*MOUNT4		;			;----->>>> IS PRODOS 8 ACTIVE  ????			;			;			;			lda 	ACTIVE8			beq		Mount6A			;			;			;			LDX		#$00MOUNT5		LDA		AUN_RAM,X			BNE		MOUNT6		;UNIT # FOUND !!			INX			cpx		#14			bne		Mount5			BRA		MOUNT6a		** FIND SPACE IN NDT FOR NEW VOLUME*MOUNT6		STZ		AUN_RAM,X	;REMOVE FROM AUN TABLE			Mount6A		AND		#%11110000	;HIGH NIBBLE ONLY			STA		AUN_HOLD			;			LDX		#$00MOUNT7		LDA		NDT_SESS,X			BEQ		MOUNT8		;SPACE IS FOUND			INX			BRA		MOUNT7		;ALWAYS AT LEAST ONE SPACE AVAIL** PLACE SESSION & VOLUME ID IN TABLE*MOUNT8		LDY		#$0A			LDA		WS_COMBUF+2			STA		NDT_IDH,X	;SAVE HB OF VOLUME ID			STA		[ZP0],Y			Sta		WS_Combuf+32;			INY			LDA		WS_COMBUF+3			STA		NDT_IDL,X	;SAVE LB OF VOLUME ID			STA		[ZP0],Y			Sta		WS_Combuf+33			;			LDY		#$04			LDA		[ZP0],Y			STA		NDT_SESS,X	;SAVE SESSION REF #			Sta		WS_Combuf+2** SAVE UNIT NUMBER !!!* IS THE USER BIT SET ??*			LDY		#$05			LDA		[ZP0],Y			AND		#%00000001	;SAVE USER BIT			ORA		AUN_HOLD			STA		NDT_UNIT,X	;SAVE UNIT NUMBER IN NDT;			LDY		#$0C			STA		[ZP0],Y		;SAVE IN PARAMETER LIST			Sta		WS_Combuf+3** UPDATE # OF VOLUMES IN NDT*			INC		NDT_CNT** FIND INDEX TO NDT_NAME*			STZ		NDT_IDX1			STZ		NDT_IDX1+1MOUNT9	; 			DEX			BMI		MOUNT10;			CLC			LDA		NDT_IDX1			ADC		#NDT_NAMELEN	;should be this not this + 1 like it was			STA		NDT_IDX1		;gws 2-sep-87			LDA		NDT_IDX1+1			ADC		#$00			STA		NDT_IDX1+1			BRA		MOUNT9** MOVE NAME INTO NDT*MOUNT10	; 			CLC			LDA		NDT_IDX1			ADC		#<NDT_NAME			STA		<ZP2			LDA		NDT_IDX1+1			ADC		#>NDT_NAME			STA		<ZP2+1;			LDY		WS_COMBUF+4	 ;OFFSET IN NAMEMOUNT11	; 			LDA		WS_COMBUF+4,Y			STA		(ZP2),Y			DEY			BPL		MOUNT11** ZERO OUT REST OF BUFFER*			LDY		WS_COMBUF+4			LDA		#$00MOUNT11B	; 			INY			CPY		#NDT_NAMELEN			BEQ		MOUNT11C	;DONE			STA		(ZP2),Y			Sta		WS_Combuf+4,y			BRA		MOUNT11B** SAVE SLOT/DRIVE*MOUNT11C	; 			LDA		AUN_HOLD			AND		#%11110000	;strip low nibble			STA		Cn_DEVNUM			beq		@L4			SEC			JSR		PDOS_DEVICE	;ADD TO LOCAL DEVICE TABLE** Add server name and network name to ws_combuf*@L4			LDA		#<SESSION_NAME			STA		ZP2			LDA		#>SESSION_NAME			STA		ZP2+1			LDA		#<SESSION_NET			STA		ZP4			LDA		#>SESSION_NET			STA		ZP4+1			ldx		SESS_IDX@L0			dex 			bmi		@L1			clc			LDA		ZP2			adc		#$21			sta		ZP2			LDA		ZP2+1			adc		#$00			STA		ZP2+1			clc			LDA		ZP4			adc		#$22			sta		ZP4			LDA		ZP4+1			adc		#$00			STA		ZP4+1			BRA		@L0@L1			ldy		#$20			;Move server name@L2			lda		(ZP2),y			sta		ws_combuf+$22,y			dey			bpl		@L2			ldy		#$21			;Move network name@L3			lda		(ZP4),y			sta		ws_combuf+$42,y			dey			bpl		@L3			;			;----> should we call the mount vector			;			lda		#$00			ldx 	#$03Mount11D	ora		Vector_Mount,x			dex			bne		Mount11D			cmp		#$00			beq		Mount11E			;no Vector installed			;			longi	on			longa 	on			;			REP		#$30			phb			ldx		#mount11E-1			;Put my return Address on the Stack			phx			;			;			longa 	off			longi	off			sep		#$30			lda		VECTOR_MOUNT+2			pha			longi	on			longa	on			REP		#$30			ldx		VECTOR_MOUNT		;Put vector on stack			dex			phx			;			ldx		#ws_combuf+2			ldy		#^ws_combuf+2			rtl			;			longi	off			longa 	off			;			;** RETURN NO ERROR*Mount11E	SEP		#$30			LDA		#$00		;NO ERROR			LDY		#$0D		;AMOUNT TO RETURN TO MB			SEC			JMP		EXIT_PFI*** UNMOUNT VOLUME**		EXPORT	UNMOUNTUNMOUNT		;		** IS VOLUME MOUNTED ?*			JSR		FND_CURSRV			BCC		UNMOUNT1	;SERVER FOUND** ERROR - VOLUME NOT MOUNTED*			LDA		#$09			CLC			JMP		EXIT_PFI** CLOSE VOLUME AND REMOVE FROM NDT* (X REGISTER IS THE INDEX TO THE TABLES)*UNMOUNT1	; 			lda		SESS_IDX			LDY		#00			LDX		NDT_IDX2	;INDEX TO NDT OTHER			SEC					;SEND PACKET TO SERVER			JSR		VOL_UNMOUNT** RETURN NO ERROR MESSAGE*			LDA		#$00		;NO ERROR			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI		ENDP		end