;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	IMPORT	ACCESS	IMPORT	AFP	IMPORT	ATTRIBUTE	IMPORT	BYTE2BLKS	IMPORT	CALC_DIRINFO	IMPORT	CMD_ROUTING	IMPORT	CMD_STUFF	IMPORT	ENTRY_CNT	IMPORT	FILE_BLKS	IMPORT	FILE_SIZE	IMPORT	FROM_ATTRI	IMPORT	FROM_SEC	IMPORT	HOLD_IOPTR	IMPORT	NETWORK_CALL	IMPORT	OFFSPRING	IMPORT	PFI_BANK	IMPORT	PFI_IOBUF	IMPORT	PFI_NAMING	IMPORT	PFI_NETCNT	IMPORT	PFI_NETMARK	IMPORT	PKT_CNT	IMPORT	PKT_OFFSET	IMPORT	PROCESS_CNT	IMPORT	PRO_TIME	IMPORT	RETURNPL	IMPORT	SIZE_ALLOWED	IMPORT	START_IDX	IMPORT	STUFF_DIRIDS	IMPORT	UBUFPTRH	IMPORT	UBUFPTRL	IMPORT	UCURBLKH	IMPORT	UCURBLKL	IMPORT	UDIRID1	IMPORT	UDIRID2	IMPORT	UDIRID3	IMPORT	UDIRID4	IMPORT	UENMASK	IMPORT	UEOB1	IMPORT	UEOB2	IMPORT	UEOB3	IMPORT	UERROR	IMPORT	UFILECNTH	IMPORT	UFILECNTL	IMPORT	UFILEIDX	IMPORT	UFILELOC	IMPORT	UMARK1	IMPORT	UMARK2	IMPORT	UMARK3	IMPORT	UMODE	IMPORT	UNLCHAR	IMPORT	USRVNUM1	IMPORT	USRVNUM2	IMPORT	USTATUS	IMPORT	UTRANCNT	IMPORT	UTYPE	IMPORT	UVOLID1	IMPORT	UVOLID2	IMPORT	UWORK1	IMPORT	WRT_CHK3	IMPORT	WS_COMBUF	IMPORT	WS_DIRBUF	IMPORT	WS_PATH	IMPORT	WS_PLIST	IMPORT	XBUFPTR	IMPORT	buffmove	IMPORT	getzp1parm;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	CHK_FIRST	ENTRY	CONVERT_CHAR	ENTRY	MOVE_ENTRY	ENTRY	READ_BLK	ENTRY	READ_DIR	ENTRY	WRITE_BLK	ENTRY	WRITE_STUFF	ENTRY	ZERO_IOBUF	ENTRY	dummy_fill** pfi_cmdsubs4** Greg Seitz (11-Aug-87)**;		EXPORT	zpcmdscs4	;zpcmdscs4	PROC		INCLUDE	'zp.equates';		ENDP		include	'global.equates'		include	'pfi_equates'				EXPORT	pficmdsubs4	pficmdsubs4	PROC			longa	off			longi	off						**	PARAMIS NETWORK SOFTWARE****	CONFIDENTIAL*** MODULE : PFI4 - PRODOS FILING INTERFACE	(PART 4)*	COMMON SUBROUTINES (PART2)**	WRITTEN BY THOMAS EAGERR**	MODIFIED: 06-15-87	4:18	TE**	COPYRIGHT 1986,87 PARAMIS CORPORATION** ALL RIGHTS RESERVED**						***	COMMON SUBROUTINES :** A: READ/WRITE BUFFER CONTROL SUBROUTINES**	1) BLKCNTL	- BLOCK CONTROL (ONE BLOCK AT A TIME)*	2) READ_BLK	- READ A BLOCK FOR IO BUFFER*	3) READ_DIR	- CREATE A DIR BLOCK FOR IO BUFFER*	4) WRITE_BLK	- WRITE A BLOCK FROM IO BUFFER*	5) RD_CHKCNTL	- READ CHUNK CONTROL (MULIT BLKS)*	6) WRT_CHKCNTL	- WRITE CHUNK CONTROL(MULIT BLKS)*	7) WRITE_STUFF	- STUFF ASP HEAP WITH WRT DEFAULT VALUES*	8) ZERO_IOBUF	- ZERO ALL OR PART OF THE IO BUFFER*	9) CMD_STUFF	- STUFF ASP HEAP WITH CMD DEFAULT VALUES*	10) MOVE_ENTRY	- MOVE DIRECTORY ENTRY TO MOTHERBOARD*	11) GETCOUNT	- CALC CNT OF BYTES TO MOVE & MOVE MARK*	12) SETTRCNT	- SET TRANSFER COUNT FOR READ AND WRITE*	13) RW_SETUP	- SETUP FOR READ AND WRITE**						eject			***	1) BLOCK CONTROL ROUTINE**	ENTER : USTATUS	= STATUS OF IO BUFFER*	UFILEIDX = INDEX TO USTATUS**	EXIT	: USTATUS	= UPDATED*	UCURBLK	= UPDATED DATA IN IO BUFFER*					EXPORT	BLKCNTLBLKCNTL		;		** HAS THIS BLOCK BEEN READ IN YET ?*			LDX		UFILEIDX			LDA		USTATUS,X			AND		#%00001000	;HAS BLOCK BEEN READ ?			BEQ		BLKCNTL1	;NO, MUST READ IT** IS THE MARK WITHIN THE CURRENT BLOCK ?*			LDA		UCURBLKH,X	;CHECK CURRENT BLOCK			CMP		UMARK3,X	;AGAINST MARK			BNE		BLKCNTL1	;NO, MUST READ IT;			LDA		UMARK2,X			AND		#%11111110			CMP		UCURBLKL,X				BEQ		BLKCNTL2	;GO CHECK THE STATUS !!!** IT IS TIME TO READ THE BLOCK !!!* SET STATUS TO FORCE READ*BLKCNTL1	; 			LDA		USTATUS,X	;FIND CURRENT STATUS			AND		#%11110111	;REMOVE - BLK HAS BEEN READ			ORA		#%00000100	;ADD	- FORCE READ			STA		USTATUS,X	;SAVE RESULT AS STATUS** CHECK STATUS -- IS A WRITE OR A READ REQUIRED ?*BLKCNTL2	; 			LDA		USTATUS,X			AND		#%00000110	;FORCE READ OR WRITE ?			BNE		BLKCNTL3	;YES IT IS TIME FOR ONE			LDA		UERROR			RTS					;EXIT,NOTHING TO DO !!!** HAS THIS BLOCK HAD DATA WRITTEN INTO IT ?*BLKCNTL3	; 			LDA		USTATUS,X			AND		#%00000001	;BLOCK WRITTEN INTO ?			BEQ		BLKCNTL4	;NO DATA WRITTEN, CHECK READ STATUS** WRITE CURRENT BLOCK TO SERVER !!!*			JSR		WRITE_BLK			BNE		BLKCNTL8	;ERROR, EXIT NOW** IS A READ REQUIRED ?*BLKCNTL4	; 			LDX		UFILEIDX			LDA		USTATUS,X			AND		#%00000100	;READ ?			BEQ		BLKCNTL8	;NO READ NEEDED !** READ BLOCK* IF IT IS A DIRECTORY -- NEED TO CREATE BLOCK !!*BLKCNTL5	; 			LDA		UTYPE,X			BPL		BLKCNTL6	;IT WAS A FILE;			JSR		READ_DIR	;CREATE A BLOCK			BEQ		BLKCNTL7	;SET STATUS - BLOCK HAS BEEN READ			BRA		BLKCNTL8	;ERROR - EXIT NOW !!** IT IS A FILE - GO READ BLOCK IN IO BUFFER*BLKCNTL6	; 			JSR		READ_BLK			BNE		BLKCNTL8	;ERROR - EXIT NOW !!** SET READ STATUS---BLOCK HAS BEEN READ INTO IO BUFFER !!*BLKCNTL7	; 			LDX		UFILEIDX			LDA		USTATUS,X			ORA		#%00001000			STA		USTATUS,X** UPDATE EOB AND CURRENT BLK*			CLC			LDA		PKT_CNT		;UPDATE TRANS COUNT			ADC		#$00			STA		UEOB1,X		;AND EOB;			LDA		UMARK2,X			AND		#%11111110			STA		UCURBLKL,X			ADC		PKT_CNT+1			STA		UEOB2,X;			LDA		UMARK3,X			STA		UCURBLKH,X			ADC		#$00			STA		UEOB3,X** RESET STATUS - KEEP ONLY EOF , BLOCK HAS BEEN READ*BLKCNTL8	; 			LDX		UFILEIDX			LDA		USTATUS,X			AND		#%10001000	;CLEAR STATUS			ORA		#%00001000			STA		USTATUS,X			LDA		UERROR			RTS;;			eject			*** 2) READ BLOCK FOR A FILE FROM A SERVER*	(INTO IO BUFFER)**	ENTRY : UFILEIDX = INDEX TO FILE INFO*	WS_PLIST = MLI PARAMETER LIST**	EXIT	: UCURBLK	= DATA IN IO BUFFER**					EXPORT	READ_BLKREAD_BLK		;		** ARE WE AT THE EOF ?*			LDX		UFILEIDX			LDA		USTATUS,X	;EOF ?			BPL		READ_BLK0A	;NOT AT THE END OF THE FILE !!!;;;;----->>> 8/6/87;			LDA		UMARK2,X	;IF EOF IS IN THIS BLOCK			AND		#%00000001	;AT LEAST READ UP TO IT			ORA		UMARK1,X			BNE		READ_BLK0A;;----->>>;;			STZ		PKT_CNT		;NO DATA - LB			STZ		PKT_CNT+1	;NO DATA - HB			JMP		READ_BLK3	;STUFF IO BUFFER WITH ZEROS;;----> 9/30/87 te;** initialize values** 1. mark to file* 2. request count* 3. buffer location*READ_BLK0A	; 			LDX		UFILEIDX			STZ		PFI_NETMARK			LDA		UMARK2,X			AND		#%11111110			STA		PFI_NETMARK+1			LDA		UMARK3,X			STA		PFI_NETMARK+2;			STZ		PFI_NETCNT			LDA		#2			STA		PFI_NETCNT+1;			LDA		UBUFPTRL,X			STA		PFI_IOBUF	;LB OF IO BUFFER			LDA		UBUFPTRH,X			STA		PFI_IOBUF+1	;SAVE HB OF IO BUFFER;;---->;** CREATE READ FORK PACKET*READ_BLK0	; 			LDA		#READFORK			STA		WS_COMBUF	;SAVE COMMAND			STZ		WS_COMBUF+$01*			LDX		UFILEIDX			LDA		USRVNUM1,X			STA		WS_COMBUF+$02	;SAVE REF# - HB			LDA		USRVNUM2,X			STA		WS_COMBUF+$03	;SAVE REF# - LB*			STZ		WS_COMBUF+$04	;NOT USED BY PRODOS;			LDA		PFI_NETMARK+2	 ;setup mark			STA		WS_COMBUF+$05			LDA		PFI_NETMARK+1			STA		WS_COMBUF+$06			LDA		PFI_NETMARK			STA		WS_COMBUF+$07*			STZ		WS_COMBUF+$08			STZ		WS_COMBUF+$09			LDA		PFI_NETCNT+1			STA		WS_COMBUF+$0A			LDA		PFI_NETCNT			STA		WS_COMBUF+$0B*			STZ		WS_COMBUF+$0C	;NO NEWLINE CHECK			STZ		WS_COMBUF+$0D	;NEWLINE SPACE (NOT USED)** CREATE ASP COMMAND PARAMETER LIST*			LDA		#$0E			STA		PKT_CNT			STZ		PKT_CNT+1;			JSR		CMD_STUFF;			LDY		#$0F			LDA		PFI_NETCNT			STA		(ZP1),Y		;SAVE LB OF REPLY LEN			INY			LDA		PFI_NETCNT+1			STA		(ZP1),Y		;SAVE HB OF REPLY LEN;			INY			LDA		PFI_IOBUF			STA		(ZP1),Y		;SAVE LB OF IO BUFFER			INY			LDA		PFI_IOBUF+1			STA		(ZP1),Y		;SAVE HB OF IO BUFFER;;			INY			LDA		PFI_BANK	;BANK			STA		(ZP1),Y		;			INY			LDA		#$00			STA		(ZP1),Y		;NOT USED BY PRODOS** ISSUE ASP COMMAND CALL*			JSR		NETWORK_CALL	;EXECUTE COMMAND** RESTORE ASP PARAMETER LIST POINTER*			jsr		getzp1parm** FIND REPLY LENGTH*			LDY		#$19			LDA		(ZP1),Y			STA		PKT_CNT		;SAVE REPLY LENGTH - LB			INY			LDA		(ZP1),Y			STA		PKT_CNT+1	;SAVE REPLY LENGTH - HB** CHECK AFP COMMAND RESULT*			LDA		UERROR			BEQ		READ_BLK5	;NO ERROR, FULL BLOCK			CMP		#$4C		;EOF ?			BEQ		READ_BLK1	;YES, ERROR WAS EOF !!!			RTS					;ERROR , TIME TO EXIT !!!** EOF ERROR CONDITION (FILL IO BUFFER WITH ZEROS)*READ_BLK1	; ;CLEAR ERROR			STZ		UERROR		;CLEAR ERROR CODE			LDX		UFILEIDX;			LDA		PKT_CNT			ORA		PKT_CNT+1			BNE		rblk_READ_BLK2A	;THERE IS SOME DATA;			LDA		#%10001000	;SET EOF STATUS== NO DATA			BRA		rblk_READ_BLK2B;rblk_READ_BLK2A	LDA		#%00001000	;BLOCK HAS BEEN READrblk_READ_BLK2B	STA		USTATUS,X** DID I GET A FULL BLOCK BACK ?*			LDA		PKT_CNT			BNE		READ_BLK3	;FILL THE REST WITH ZEROS !!!			LDA		PKT_CNT+1			CMP		#$02		;512 BLOCK ?			BEQ		READ_BLK4	;YES, IT WAS A FULL BLOCK** FILL THE REST OF THE BLOCK WITH ZEROS*READ_BLK3	; 			JSR		ZERO_IOBUF** RETURN TO BLOCK CONTROL !!!*READ_BLK4	; 			LDA		UERROR			RTS;;----> 9/30/87 te** how much of the block is left*READ_BLK5	; 			SEC			LDA		PFI_NETCNT			SBC		PKT_CNT			STA		PFI_NETCNT			LDA		PFI_NETCNT+1			SBC		PKT_CNT+1			STA		PFI_NETCNT+1;** is there any data left ??*			LDA		PFI_NETCNT			ORA		PFI_NETCNT+1			BNE		rblk_UPDATE;			LDA		UERROR			RTS;** update buffer location and file offset*rblk_UPDATE	CLC			LDA		PFI_NETMARK			ADC		PKT_CNT			STA		PFI_NETMARK			LDA		PFI_NETMARK+1			ADC		PKT_CNT+1			STA		PFI_NETMARK+1			LDA		PFI_NETMARK+2			ADC		$00			STA		PFI_NETMARK+2;			CLC			LDA		PFI_IOBUF			ADC		PKT_CNT			STA		PFI_IOBUF			LDA		PFI_IOBUF+1			ADC		PKT_CNT+1			STA		PFI_IOBUF+1			JMP		READ_BLK0	;try it again;;-----> end;;			eject			***	3) READ FOR A DIRECTORY BLOCK**	ENTER : UMARK	= OFFSET IN DIRECTORY*	UFILEIDX = INDEX TO UMARK*	UBLKPTR	= LOCATION OF IO BUFFER**	EXIT	: UERROR	= RESULT OF FILL ATTEMPT*	UBUFPTR? = HAS DIRECTORY BLOCK IN IT*					EXPORT	READ_DIRREAD_DIR		;		** IS THE EOF FLAG SET*			LDX		UFILEIDX			LDA		USTATUS,X			BPL		READ_DIR0	;STATUS OK;;;----->>> 8/6/87;			LDA		UMARK2,X	;IF EOF IS IN THIS BLOCK			AND		#%00000001	;AT LEAST READ UP TO IT			ORA		UMARK1,X			BNE		READ_DIR0;;----->>>;			JMP		READ_DIR37A	;NO DATA TO READ !!** INITIALIZE VALUES*READ_DIR0	; 			LDX		UFILEIDX	;INDEX FOR OPEN FILE			LDA		UBUFPTRL,X			STA		HOLD_IOPTR			LDA		UBUFPTRH,X			STA		HOLD_IOPTR+1;			LDA		#$01			STA		START_IDX			STZ		START_IDX+1;			STZ		ENTRY_CNT	;ENTRIES IN BLOCK			LDA		#$07			STA		PROCESS_CNT	;HALF OF BUFFER TO PROCESS** IS THE MARK IN BLOCK ZERO ?*			LDA		UMARK3,X			BNE		READ_DIR1			LDA		UMARK2,X			CMP		#$02			BCS		READ_DIR1			BRA		READ_DIR2;;** THIS IS NOT THE HEADER BLOCK !!!*READ_DIR1	; ** FIND NUMBER OF BLOCKS*			LDA		UMARK3,X			LSR		A			;LOW BIT IN CARRY			STA		FILE_BLKS+1			LDA		UMARK2,X			ROR		A			;SHIFT DOWN ON & ADD CARRY			STA		FILE_BLKS** FIND START INDEX* DO HIGH BYTE CHECK FIRST (13*256)*ENT_256		equ		13*256*			LDX		FILE_BLKS+1			BEQ		READ_DIR1BREAD_DIR1A	; 			CLC			LDA		START_IDX+1			ADC		#>ENT_256			STA		START_IDX+1			DEX			BNE		READ_DIR1A;READ_DIR1B	; 			LDX		FILE_BLKS			BEQ		READ_DIR1D	;FINISHEDREAD_DIR1C	; 			CLC			LDA		START_IDX			ADC		#$0D			STA		START_IDX			LDA		START_IDX+1			ADC		#$00			STA		START_IDX+1			DEX			BNE		READ_DIR1C;** TIME TO ENUMERATE*READ_DIR1D	; 			SEC			LDA		START_IDX	;ACCOUNT FOR HEADER ENTRY			SBC		#$01			STA		START_IDX			LDA		START_IDX+1			SBC		#$00			STA		START_IDX+1			JMP		READ_DIR17	;SKIP CREATION OF HEADER !!;;			*** TIME TO CREATE A HEADER ENTRY FOR A DIRECTORY*** STUFF GET FIL/DIR INFO*READ_DIR2	; 			LDA		#GETFDINFO			STA		WS_COMBUF			STZ		WS_COMBUF+1;			JSR		STUFF_DIRIDS	;SAVE VOL & DIR IDS;;			LDA		#%00000010		;HB OF FILE BITMAP			STA		WS_COMBUF+$08	;DATA FORK LENGTH			LDA		#%01000101		;LB OF FILE BITMAP			STA		WS_COMBUF+$09	;ATTRIBUTES,CREATE DATE,PATH;			LDA		#%00000010		;HB OF DIR BITMAP			STA		WS_COMBUF+$0A	;# OF OFFSPRING			LDA		#%01000101		;LB OF DIR BITMAP			STA		WS_COMBUF+$0B	;ATTRIBUTES,CREATE DATE,PATH;			LDA		#$02			STA		WS_COMBUF+$0C	;LONG PATHNAME			STZ		WS_COMBUF+$0D	;NO LENGTH** ISSUE ASP CALL*			LDA		#$0E			STA		PKT_CNT			STZ		PKT_CNT+1;			JSR		CMD_ROUTING	;EXECUTE CALL			BCC		READ_DIR3			RTS					;ERROR IN GET INFO CALL** SET ACCESS BYTES IN PL (WITH SOME TRANSLATION)*READ_DIR3	; 			LDA		WS_COMBUF+7			STA		ATTRIBUTE			LDA		WS_COMBUF+6			STA		ATTRIBUTE+1;			LDA		WS_COMBUF+4	;TYPE (80=DIR/00=FILE)			JSR		FROM_ATTRI;			LDA		ACCESS			STA		WS_DIRBUF+$22	;SAVE ACCESS** FIND CREATION DATE & TIME*			LDX		#$03READ_DIR4	; 			LDA		WS_COMBUF+$08,X			STA		AFP,X			DEX			BPL		READ_DIR4	;MORE OF AFP TIME TO MOVE;			JSR		FROM_SEC;			LDX		#$03READ_DIR5	; 			LDA		PRO_TIME,X			STA		WS_DIRBUF+$1C,X			DEX			BPL		READ_DIR5	;MORE OF PRODOS TIME TO MOVE** FIND DIRECTORY'S NAME (TRUCATE IF NEEDED)*;;----> 11/06/87 TE;			LDA		WS_COMBUF+$10	;LENGTH OF PATH			CMP		#$10			BCC		READ_DIR6						    	;			LDA		#$3F	   	;'?'			STA		WS_COMBUF+$1F	;CUT SHORT			LDA		#$0F	   	;MAX LENGTH FOR NAME						    	;READ_DIR6	; 			STA		WS_DIRBUF+$04	;SAVE LENGTH OF NAME			BEQ		READ_DIR7A			TAXREAD_DIR7	; 			LDA		WS_COMBUF+$10,X			JSR		CONVERT_CHAR			STA		WS_DIRBUF+$04,X			DEX			BNE		READ_DIR7	;MORE OF NAME TO MOVE			;			JSR		CHK_FIRST** ZERO OUT REST OF NAME FIELD*READ_DIR7A	; 			LDX		WS_DIRBUF+$04rdir_LOOP	CPX		#$0F			BEQ		rdir_DONE		;ALL DONE			INX			STZ		WS_DIRBUF+$04,X			BRA		rdir_LOOP;;----> END OF CHANGE;** # OF ENTRIES*;;-----> 11/04/87 te;rdir_DONE	LDX		UFILEIDX			LDA		WS_COMBUF+$0E	;HB OF COUNT			STA		UFILECNTH,X			STA		WS_DIRBUF+$26			LDA		WS_COMBUF+$0F			STA		UFILECNTL,X			STA		WS_DIRBUF+$25;;----->;** STUFF DEFAULT VALUES*READ_DIR10	; 			LDX		#7READ_DIR11	; 			STZ		WS_DIRBUF+$14,X	;ZERO RESERVED AREA			DEX			BPL		READ_DIR11;			LDA		#$10			STA		WS_DIRBUF+$20	;VERSION			LDA		#$00			STA		WS_DIRBUF+$21	;MIN VERSION;			LDA		#$27			STA		WS_DIRBUF+$23	;LENGTH OF ENTRY			LDA		#$0D			STA		WS_DIRBUF+$24	;ENTRIES PER BLOCK								;			STZ		WS_DIRBUF+$27	;BITMAP PTR			STZ		WS_DIRBUF+$28	;BITMAP PTR** IS THIS A VOLUME ?* (IF DIRCTORY ID'S = $00 00 00 02 THEN YES)*			LDX		UFILEIDX			LDA		UDIRID1,X			BNE		READ_DIR12	;NOT THE VOLUME			LDA		UDIRID2,X			BNE		READ_DIR12	;NOT THE VOLUME			LDA		UDIRID3,X			BNE		READ_DIR12	;NO THE VOLUME			LDA		UDIRID4,X			CMP		#$02		;ROOT ?			BEQ		READ_DIR13	;YES, IT IS THE VOLUME !!!** DIRECTORY :* SAVE STORAGE TYPE & LAST TWO BYTES OF HEADER*READ_DIR12	; 			LDA		WS_DIRBUF+$04			ORA		#$E0			STA		WS_DIRBUF+$04;			STZ		WS_DIRBUF+$29	;PARENT ENTRY #			LDA		#$27			STA		WS_DIRBUF+$2A	;PARENT LENGTH			BRA		READ_DIR16	;MOVE HEADER TO MOTHERBOARD BUF;;** VOLUME :* CREATE GET VOL PARMS*READ_DIR13	; 			LDA		WS_DIRBUF+$22			AND		#%00100000	;SAVE BACKUP BIT			ORA		#%00000001	;READ ENABLE			STA		WS_DIRBUF+$22	;SAVE ACCESS** CREATE GET VOL PARMS*			LDA		#GETVOLPARMS			STA		WS_COMBUF		;SAVE	AFP COMMAND			STZ		WS_COMBUF+1		;SAVE ZERO;			LDA		UVOLID1,X			STA		WS_COMBUF+$02	;SAVE VOLUME ID - HB			LDA		UVOLID2,X			STA		WS_COMBUF+$03	;SAVE VOLUME ID - LB;;			STZ		WS_COMBUF+$04	;SAVE BITMAP - HB			LDA		#%10000000		;TOTAL BYTES			STA		WS_COMBUF+$05	;SAVE BITMAP - LB** ISSUE AFP GET VOLUME PARAMETERS*			LDA		#$06			STA		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING			BCC		READ_DIR14	;GOT INFO OK			RTS** SAVE STORAGE TYPE*READ_DIR14	; 			LDA		WS_DIRBUF+$04			ORA		#$F0			STA		WS_DIRBUF+$04** FIND TOTAL BLOCKS AVAILABLE ON SERVER VOLUME*			LDX		#$03READ_DIR15	; 			LDA		WS_COMBUF+$02,X			STA		FILE_SIZE,X			DEX			BPL		READ_DIR15	;MORE TO MOVE;			JSR		BYTE2BLKS			LDA		FILE_BLKS			STA		WS_DIRBUF+$29	;LB OF TOTAL BLOCKS AVAIL			LDA		FILE_BLKS+1			STA		WS_DIRBUF+$2A	;HB OF TOTAL BLOCKS AVAIL;;** MOVE DIRCETORY HEADER INTO IO BUFFER*READ_DIR16	; 			JSR		MOVE_ENTRY			DEC		START_IDX	;MOVE IT BACK TO ONE !!!			DEC		PROCESS_CNT	;ONLY GET SIX OF THEM;;			** TIME TO PREPARE FOR AN EMUNERATE CALL* CREATE PACKET*READ_DIR17	; 			LDA		#ENUMERATE			STA		WS_COMBUF	;SAVE COMMAND			STZ		WS_COMBUF+$01;			JSR		STUFF_DIRIDS	;SAVE VOL & DIR IDS;			LDA		#%00100110	;PRODOS TYPE,SIZE (DATA & RESOURCE)			STA		WS_COMBUF+$08	;FILE BITMAP - HB;			LDA		#%00100010	;PRODOS TYPE,SIZE			STA		WS_COMBUF+$0A	;DIR	BITMAP - HB;			LDA		#%01001101	;NAME,MOD TIME,CREATION,ATTRI			STA		WS_COMBUF+$09	;FILE BITMAP - LB			STA		WS_COMBUF+$0B	;DIR	BITMAP - HB;			STZ		WS_COMBUF+$0C	;REQUEST COUNT - HB			LDA		PROCESS_CNT			STA		WS_COMBUF+$0D	;REQUEST COUNT - LB;			LDA		START_IDX+1			STA		WS_COMBUF+$0E	;START INDEX - HB			LDA		START_IDX			STA		WS_COMBUF+$0F	;START INDEX - LB;			LDA		#$02			STA		WS_COMBUF+$10	;MAX SIZE RESPONSE - HB			STZ		WS_COMBUF+$11	;MAX SIZE RESPONSE - LB;			LDA		#$02			STA		WS_COMBUF+$12	;NAME TYPE			STZ		WS_COMBUF+$13	;NO LENGTH** ISSUE AFP ENUMERATE CALL*			LDA		#$14			STA		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING			BCC		READ_DIR18** IS THERE AN EOF CONDITION ?*			LDA		UERROR			CMP		#$44		;NOT FOUND !!			BEQ		READ_DIR17A	;ANOTHER ERROR			RTS** ZERO OUT BUFFER*READ_DIR17A	; 			STZ		UERROR		;CLEAR ERROR			JMP		READ_DIR37	;ZERO OUT DATA BLOCK** INIT ZP0 TO POINT TO WS_COMBUF, PACKET COUNTER*READ_DIR18	; 			LDA		#WS_COMBUF+6	;POINTER TO FIRST STRUCTURE			STA		<ZP0			LDA		#>WS_COMBUF+6			STA		<ZP0+1;			STZ		PKT_CNT** IS THIS ENTRY INVISABLE ?*READ_DIR19	; ** SAVE ACCESS FOR PACKET ENTRY*READ_DIR19A	; 			LDY		#$02			LDA		(ZP0),Y			STA		ATTRIBUTE+1	;SAVE HB OF ATTRIBUTES			INY			LDA		(ZP0),Y			STA		ATTRIBUTE	;SAVE LB OF ATTRIBUTES;			LDY		#$01		;TYPE (80=DIR/00=FILE)			LDA		(ZP0),Y			JSR		FROM_ATTRI			LDA		ACCESS			STA		WS_DIRBUF+$22	;SAVE ACCESS** SAVE CREATION TIME AND DATE*			LDY		#$04READ_DIR20	; 			LDA		(ZP0),Y			STA		AFP-4,Y			INY			CPY		#$08			BNE		READ_DIR20	;MOVE TIME INTO WORK AREA;			JSR		FROM_SEC;			LDX		#$03READ_DIR21	; 			LDA		PRO_TIME,X			STA		WS_DIRBUF+$1C,X			DEX			BPL		READ_DIR21** SAVE MOD TIME AND DATE*			LDY		#$08READ_DIR22	; 			LDA		(ZP0),Y			STA		AFP-8,Y			INY			CPY		#$0C			BNE		READ_DIR22	;MOVE TIME INTO WORK AREA;			JSR		FROM_SEC;			LDX		#$03READ_DIR23	; 			LDA		PRO_TIME,X			STA		WS_DIRBUF+$25,X			DEX			BPL		READ_DIR23** IS IT A FILE OR A DIRECTORY ?*			LDY		#$01			LDA		(ZP0),Y			BNE		READ_DIR23A			JMP		READ_DIR28** FIND DIRECTORY'S NAME (TRUCATE IF NEEDED)*;;----> 11/06/87 TE;READ_DIR23A	; 			LDY		#$16			LDA		(ZP0),Y		;LENGTH OF PATH			CMP		#$10			BCC		READ_DIR24			LDY		#$25			LDA		#$3F			STA		(ZP0),Y		;'*' TO ASK CUT SHORT			LDA		#$0F		;MAX LENGTH FOR NAMEREAD_DIR24	; 			STA		WS_DIRBUF+$04	;SAVE LENGTH OF NAME;;			CLC			ADC		#$16		;OFFSET IN PACKET			TAYrd24_LOOP	LDA		(ZP0),Y			JSR		CONVERT_CHAR			STA		WS_DIRBUF-$12,Y	;($12= $16-$04)			DEY			CPY		#$16			BNE		rd24_LOOP		;MORE OF NAME TO MOVE			;			JSR		CHK_FIRST;;---->;** FIND BLOCKS USED FOR A DIRECTORY*			LDY		#$0E			LDA		(ZP0),Y			STA		OFFSPRING			INY			LDA		(ZP0),Y			STA		OFFSPRING+1;			JSR		CALC_DIRINFO;			LDA		FILE_BLKS			STA		WS_DIRBUF+$17			LDA		FILE_BLKS+1			STA		WS_DIRBUF+$18;			LDX		#$02READ_DIR27	; 			LDA		FILE_SIZE,X			STA		WS_DIRBUF+$19,X			DEX			BPL		READ_DIR27			LDY		#$10		;OFFSET TO PRODOS INFO			JMP		READ_DIR31	;SAVE PRODDOS INFO;;** FIND FILE'S NAME (TRUCATE IF NEEDED)*;;----> 11/06/87;READ_DIR28	; 			LDY		#$1C			LDA		(ZP0),Y		;LENGTH OF PATH			CMP		#$10			BCC		READ_DIR28A;			LDY		#$2B			LDA		#$3F			STA		(ZP0),Y		;'?' TO ASK CUT SHORT			LDA		#$0F		;MAX LENGTH FOR NAMEREAD_DIR28A	; 			STA		WS_DIRBUF+$04	;SAVE LENGTH OF NAME;			CLC					;			ADC		#$1C		;OFFSET IN PACKET			TAYrd28_LOOP	LDA		(ZP0),Y			JSR		CONVERT_CHAR			STA		WS_DIRBUF-$18,Y	;($18= $1C-$04)			DEY			CPY		#$1C			BNE		rd28_LOOP		;MORE OF NAME TO MOVE			;			JSR		CHK_FIRST;;----> END;** FIND # OF BLOCKS IN FILE*READ_DIR28B	; 			LDX		UFILEIDX			LDA		UTYPE,X			AND		#%00100000			BEQ		x_RD_DIR28BA	;NOT BOTH FILE TYPES;			CLC					;ADD DATA FORK LENGTH TO RESOURCE LENGTH			LDY		#$11		;LB OF LENGTH			LDA		(ZP0),Y			LDY		#$15			ADC		(ZP0),Y			LDY		#$11			STA		(ZP0),Y;			LDY		#$10		;ML OF LENGTH			LDA		(ZP0),Y			LDY		#$14			ADC		(ZP0),Y			LDY		#$10			STA		(ZP0),Y;			LDY		#$0F		;MH OF LENGTH			LDA		(ZP0),Y			LDY		#$13			ADC		(ZP0),Y			LDY		#$0F			STA		(ZP0),Y;			LDY		#$0E		;HB OF LENGTH			LDA		(ZP0),Y			LDY		#$12			ADC		(ZP0),Y			LDY		#$0E			STA		(ZP0),Y			BCC		x_RD_DIR28BB	;NO, OVERFLOW;			LDA		#$FF		;OVERFLOW, Y = $0E			STA		(ZP0),Y			BRA		x_RD_DIR28BB	;DON'T ADD !!!;;** WAS IT FOR A RESOURCE FORK ?*x_RD_DIR28BA	LDX		UFILEIDX			BIT		UTYPE,X			BVC		x_RD_DIR28BB	;DATA FORK;			LDY		#$15		;LB OF LENGTH			LDA		(ZP0),Y			LDY		#$11			STA		(ZP0),Y;			LDY		#$14		;ML OF LENGTH			LDA		(ZP0),Y			LDY		#$10			STA		(ZP0),Y;			LDY		#$13		;MH OF LENGTH			LDA		(ZP0),Y			LDY		#$0F			STA		(ZP0),Y;			LDY		#$12		;HB OF LENGTH			LDA		(ZP0),Y			LDY		#$0E			STA		(ZP0),Y** CHECK OUT DATA BLOCKS*x_RD_DIR28BB	LDY		#$0E			LDX		#$00READ_DIR28C	; 			LDA		(ZP0),Y			STA		FILE_SIZE,X			INX			INY			CPY		#$12			BNE		READ_DIR28C;			JSR		BYTE2BLKS;			LDA		FILE_BLKS			STA		WS_DIRBUF+$17			LDA		FILE_BLKS+1			STA		WS_DIRBUF+$18** FIND THE END OF FILE FOR A FILE*			LDY		#$0E			LDA		(ZP0),Y			BEQ		READ_DIR29	;SIZE IS OK;			LDA		#$FF			STA		WS_DIRBUF+$19			STA		WS_DIRBUF+$1A			STA		WS_DIRBUF+$1B			BRA		READ_DIR31	;SAVE PRODOS INFO;READ_DIR29	; 			INY			LDX		#$02READ_DIR30	; 			LDA		(ZP0),Y			STA		WS_DIRBUF+$19,X			INY			DEX			BPL		READ_DIR30** FIND PRODOS INFO*			LDY		#$16READ_DIR31	; 			LDA		(ZP0),Y			STA		WS_DIRBUF+$14	;SAVE FILE TYPE;			INY					;SKIP UNUSED			INY			LDA		(ZP0),Y			STA		WS_DIRBUF+$23	;SAVE LB OF AUX FIELD			INY			LDA		(ZP0),Y			STA		WS_DIRBUF+$24	;SAVE HB OF AUX FIELD** STUFF DEFAULT VALUES IN ENTRY*			STZ		WS_DIRBUF+$15	;KEY_POINTER			STZ		WS_DIRBUF+$16	;KEY POINTER;			LDA		#$10			STA		WS_DIRBUF+$20	;VERSION			LDA		#$00			STA		WS_DIRBUF+$21	;VERSION MIN;			STZ		WS_DIRBUF+$29	;HEADER POINTER			STZ		WS_DIRBUF+$2A	;HEADER POINTER;;----> 11/06/87** ZERO OUT REST OF NAME FIELD*			LDX		WS_DIRBUF+$04rd31_LOOP2	CPX		#$0F			BEQ		rd31_DONE		;ALL DONE			INX			STZ		WS_DIRBUF+$04,X			BRA		rd31_LOOP2;;---->;** FIND THE STORAGE TYPE*rd31_done	; 			LDY		#$01			LDA		(ZP0),Y			BEQ		READ_DIR31A;			LDA		#$D0		;STORAGE TYPE = DIRECTORY			BRA		READ_DIR34** IS THIS A TREE FILE ?*READ_DIR31A	; 			LDA		FILE_BLKS+1			LSR		A			BNE		rd_TREE		;IS IT A TREE ?			BCC		rd_NEXT		;NOT A TREE			LDA		FILE_BLKS			BEQ		rd_SAPLINGrd_TREE		LDA		#$30		;TREE !!!!			BRA		READ_DIR34;rd_NEXT		LDA		FILE_BLKS			LSR		A			;			BEQ		rd_SEED		;rd_SAPLING	LDA		#$20		;SAPLING !!!!!!			BRA		READ_DIR34rd_SEED		LDA		#$10		;SEEDLING !!!** SAVE STORAGE TYPE*READ_DIR34	; 			ORA		WS_DIRBUF+$04	;LENGTH OF NAME			STA		WS_DIRBUF+$04** MOVE ENTRY TO MOTHERBOARD*			JSR		MOVE_ENTRY** IS THIS BUFFER FULL ?*			LDA		ENTRY_CNT			CMP		#$0D		;FULL BLOCK ?			BNE		READ_DIR35	;NO, THIS IS NOT EQUAL								;			LDX		UFILEIDX			LDA		#%00001000	;BLOCK HAS BEEN READ			STA		USTATUS,X	;CLEAR;			SEC			LDA		HOLD_IOPTR			SBC		UBUFPTRL,X			STA		PKT_CNT		;LB OF LENGTH OF DATA			LDA		HOLD_IOPTR+1			SBC		UBUFPTRH,X			STA		PKT_CNT+1	;HB OF LENGTH OF DATA;			JSR		ZERO_IOBUF	;ZERO UNUSED BYTES;			STZ		PKT_CNT			LDA		#$02			STA		PKT_CNT+1;			LDA		UERROR			RTS** AM I FINISHED MOVING THE PROCESS AMOUNT ?*READ_DIR35	; 			LDA		PROCESS_CNT			CMP		PKT_CNT			BNE		READ_DIR36	;THIS HALF OF IO BUFFER IS DONE;			LDA		#$06			STA		PROCESS_CNT	;($06) SECOND HALF OF IO BUFFER			JMP		READ_DIR17	;ISSUE NEW CALL** ARE THERE ANY MORE ENTRIES IN THIS BUFFER ?(LB ONLY)*READ_DIR36	; 			LDA		PKT_CNT			CMP		WS_COMBUF+$05			BEQ		READ_DIR37	;NOT A FULL BLOCK (FILL WITH ZEROS)** TIME TO PROCESS NEXT ENTRY IN BUFFER*			CLC			LDA		(ZP0)		;LENGTH OF ENTRY			ADC		<ZP0			STA		<ZP0			LDA		<ZP0+1			ADC		#$00			STA		<ZP0+1			JMP		READ_DIR19;;** FILL THE REST OF THE IO BUFFER WITH ZEROS*READ_DIR37	; 			LDX		UFILEIDX			SEC			LDA		HOLD_IOPTR			SBC		UBUFPTRL,X			STA		PKT_CNT		;LB OF LENGTH OF DATA			LDA		HOLD_IOPTR+1			SBC		UBUFPTRH,X;			STA		PKT_CNT+1	;HB OF LENGTH OF DATA			ORA		PKT_CNT		;IS THERE ANY DATA ??			BEQ		READ_DIR37A	;SORRY THERE IS NO DATA;			LDX		UFILEIDX			LDA		#%00001000	;BLOCK HAS BEEN READ			STA		USTATUS,X	;CLEAR;;			jsr		dummy_fill;			JSR		ZERO_IOBUF;			LDA		#$02			STA		PKT_CNT+1			STZ		PKT_CNT;			LDA		UERROR			RTS** SET EOF CONDITION*READ_DIR37A	; 			LDX		UFILEIDX			LDA		#%10001000	;EOF & BLK READ			STA		USTATUS,X;			STZ		PKT_CNT			STZ		PKT_CNT+1			JSR		ZERO_IOBUF			LDA		UERROR			RTS;;			eject			*** 4) WRITE CURRENT IO BLOCK TO A SERVER**	ENTRY : UFILEIDX = INDEX TO FILE INFO*	UCURBLK	= DATA IN IO BUFFER*	WS_PLIST = MLI PARAMETER LIST**	EXIT	: USTATUS	= UPDATED**					EXPORT	WRITE_BLKWRITE_BLK		;		;;----> 9/30/87 te;** initialize values** 1. mark to file* 2. request count* 3. buffer location*			LDX		UFILEIDX			STZ		PFI_NETMARK			LDA		UCURBLKL,X			STA		PFI_NETMARK+1			LDA		UCURBLKH,X			STA		PFI_NETMARK+2;			LDA		UEOB1,X			STA		PFI_NETCNT			SEC			LDA		UEOB2,X			SBC		UCURBLKL,X			AND		#%00000011			STA		PFI_NETCNT+1;			LDA		UBUFPTRL,X			STA		PFI_IOBUF	;LB OF IO BUFFER			LDA		UBUFPTRH,X			STA		PFI_IOBUF+1	;SAVE HB OF IO BUFFER;;---->;** CREATE WRITE PACKET*WRITE_BLK0	; 			LDA		#WRITEFORK			STA		WS_COMBUF	 ;SAVE AFP COMMAND			STZ		WS_COMBUF+$01	;SAVE START FLAG;			LDX		UFILEIDX			LDA		USRVNUM1,X			STA		WS_COMBUF+$02	;SAVE REF # - HB			LDA		USRVNUM2,X			STA		WS_COMBUF+$03	;SAVE REF # - LB;			STZ		WS_COMBUF+$04	;SAVE MARK			LDA		PFI_NETMARK+2			STA		WS_COMBUF+$05			LDA		PFI_NETMARK+1			STA		WS_COMBUF+$06			LDA		PFI_NETMARK			STA		WS_COMBUF+$07;			STZ		WS_COMBUF+$08	;SAVE REQ CNT			STZ		WS_COMBUF+$09			LDA		PFI_NETCNT+1			STA		WS_COMBUF+$0A			LDA		PFI_NETCNT			STA		WS_COMBUF+$0B** CREATE ASP WRITE PARAMETER LIST* FIND ASP HEAP - STUFF DEFAULT VALUES*			JSR		WRITE_STUFF** STUFF WRITE DATA BUFFER INFO (IO BUFFER)*			LDY		#$0F			LDA		PFI_NETCNT			STA		(ZP1),Y		;SAVE LB OF LENGTH			INY			LDA		PFI_NETCNT+1			STA		(ZP1),Y		;SAVE HB OF LENGTH;			INY			LDA		PFI_IOBUF	;SAVE LB OF BUFFER			STA		(ZP1),Y			INY			LDA		PFI_IOBUF+1	;SAVE HB OF BUFFER			STA		(ZP1),Y;;			INY			LDA		PFI_BANK			STA		(ZP1),Y		;BANK			INY			LDA		#$00			STA		(ZP1),Y		;OFF BOARD LOCATION** ISSUES ASP WRITE CALL*			JSR		NETWORK_CALL** WAS THERE AN ERROR ?* CLEAR STATUS*			LDX		UFILEIDX			LDA		USTATUS,X			AND		#%00000100	;KEEP FORCE READ BIT			STA		USTATUS,X;			LDA		UERROR			BEQ		WRITE_BLK1			RTS** LOOK AT LENGTH OF REPLY*WRITE_BLK1	; 			jsr		getzp1parm;;;----> 9/30/87 te;			LDY		#$1F			LDA		(ZP1),Y			STA		PKT_CNT			INY			LDA		(ZP1),Y			STA		PKT_CNT+1;** how much of the block is left*			SEC			LDA		PFI_NETCNT			SBC		PKT_CNT			STA		PFI_NETCNT			LDA		PFI_NETCNT+1			SBC		PKT_CNT+1			STA		PFI_NETCNT+1;** is there any data left ??*			LDA		PFI_NETCNT			ORA		PFI_NETCNT+1			BNE		wb_UPDATE;			LDA		UERROR			RTS;** update buffer location and file offset*wb_UPDATE		CLC			LDA		PFI_NETMARK			ADC		PKT_CNT			STA		PFI_NETMARK			LDA		PFI_NETMARK+1			ADC		PKT_CNT+1			STA		PFI_NETMARK+1			LDA		PFI_NETMARK+2			ADC		$00			STA		PFI_NETMARK+2;			CLC			LDA		PFI_IOBUF			ADC		PKT_CNT			STA		PFI_IOBUF			LDA		PFI_IOBUF+1			ADC		PKT_CNT+1			STA		PFI_IOBUF+1			JMP		WRITE_BLK0	;try it again;;-----> end;;*** CONVERT CHARACTER IF NEEDED** USED BY READ_DIR** ENTRY : [A] = CHARACTER** EXIT  : [A] = CORRECTED CHARACTER**;;----> 11/06/87;		EXPORT	CONVERT_CHARCONVERT_CHAR		;		** IF THIS IS AFP NAMING MODE,* NO MODIFICATION IS NEEDED*			BIT		PFI_NAMING			BMI		cc_EXIT** CONVERT INTO PRODOS MODE*			AND		#$7F		;STRIP OFF HIGH BIT			CMP		#$61		;IS IT LOWER CASE ??			BCC		cc_NUMCHK			AND		#$5F		;MAKE IT UPPER CASEcc_NUMCHK	CMP		#$2E			BEQ		cc_EXIT		;IT WAS A '.'			CMP		#$30			BCC		cc_BADCHAR	;BAD PRODOS CHARACTER			CMP		#$3A			BCC		cc_EXIT		;IT WAS A NUMBER			CMP		#$41			BCC		cc_BADCHAR	;BAD PRODOS CHARACTER			CMP		#$5B			BCC		cc_EXIT		;IT WAS A LETTER** BAD PRODOS CHARACTER*cc_BADCHAR	LDA		#$3F		;'?' ----> 11/06/87 TE** CHARACTER IN [A]*cc_EXIT		RTS;;*** CONVERT FIRST CHARACTER IF NEEDED** USED BY READ_DIR** ENTRY : WS_DIRBUF** EXIT  : WS_DIRBUF**		EXPORT	CHK_FIRSTCHK_FIRST		;		** IF THIS IS AFP NAMING MODE,* NO MODIFICATION IS NEEDED*			BIT		PFI_NAMING			BMI		cf_EXIT** CONVERT INTO PRODOS MODE*			lda		WS_DIRBUF+5			CMP		#$2E			BEQ		cf_DONE		;IT WAS A '.'			CMP		#$3A			BCS		cf_EXIT		;IT WAS not A NUMBER** BAD PRODOS CHARACTER*cf_DONE		LDA		#$3F		;			STA		WS_DIRBUF+5** CHARACTER IN [A]*cF_EXIT		RTS;;			eject			***	5) READ CHUNK CONTROL (MULTI BLOCK READS)**	ENTER : UMARK	= OFFSET IN DIRECTORY*	UFILEIDX = INDEX TO UMARK*	WS_PLIST = POINTER TO WORKSTATION PARAMETER LIST**	EXIT	: DATA IN USER'S BUFFER**					EXPORT	RD_CHKCNTLRD_CHKCNTL		;		** HAS THE IO BUFFER BEEN WRITTEN INTO*			LDX		UFILEIDX			LDA		USTATUS,X			AND		#%00000001			BEQ		RD_CHK1		;NO DATA TO WRITE;			JSR		WRITE_BLK	;FLUSH - IO BUFFER** INITIALIZE AREA*RD_CHK1	; 			LDA		#$08			STA		RETURNPL	;SIZE OF PARAMETER LIST;			STZ		WS_PLIST+6	;ZERO TRANSFER COUNT			STZ		WS_PLIST+7** CREATE READ FORK PACKET*RD_CHK1A	; 			LDA		#READFORK			STA		WS_COMBUF	;SAVE COMMAND			STZ		WS_COMBUF+$01*			LDX		UFILEIDX			LDA		USRVNUM1,X			STA		WS_COMBUF+$02	;SAVE REF# - HB			LDA		USRVNUM2,X			STA		WS_COMBUF+$03	;SAVE REF# - LB*			STZ		WS_COMBUF+$04	;NOT USED BY PRODOS			LDA		UMARK3,X		;SETUP MARK			STA		WS_COMBUF+$05			LDA		UMARK2,X			STA		WS_COMBUF+$06			LDA		UMARK1,X			STA		WS_COMBUF+$07*			STZ		WS_COMBUF+$08	;SAVE REQUEST COUNT(1 BLK)			STZ		WS_COMBUF+$09			LDA		UTRANCNT			STA		WS_COMBUF+$0B	;SAVE LB OF REQUEST COUNT			LDA		UTRANCNT+1			STA		WS_COMBUF+$0A;;;----> 9/20/87 TE;			LDX		UFILEIDX			LDA		UTYPE,X			AND		#%00010000			BEQ		rd_NONE			LDA		UENMASK,X	;CLEAR ENABLE MASK			STA		WS_COMBUF+$0C;			LDA		UNLCHAR,X	;CLEAR CHARACTER IN TABLE			STA		WS_COMBUF+$0D			BRA		rd_OVERrd_NONE		STZ		WS_COMBUF+$0C	;NO NEWLINE CHECK			STZ		WS_COMBUF+$0D	;NEWLINE SPACE (NOT USED);;---->;** CREATE ASP COMMAND PARAMETER LIST*rd_over	; 			LDA		#$0E			STA		PKT_CNT			STZ		PKT_CNT+1;			JSR		CMD_STUFF;;			SEC			LDA		WS_COMBUF+$0B			SBC		#$10		;max size ??			LDA		WS_COMBUF+$0A			SBC		#$12		;max size ??			BCC		rd_UNDER;			LDA		#$10		;set to max length			LDX		#$12			BRA		rd_SETLEN;rd_UNDER		LDA		WS_COMBUF+$0B			LDX		WS_COMBUF+$0Ard_SETLEN		LDY		#$0F			STA		(ZP1),Y		;SAVE LB OF LENGTH			INY			TXA			STA		(ZP1),Y		;SAVE HB OF LENGTH;;			INY			LDA		XBUFPTR		;LB OF USER BUFFER POINTER			STA		(ZP1),Y		;SAVE HB OF IO BUFFER			INY			LDA		XBUFPTR+1	;HB OF USER BUFFER POINTER			STA		(ZP1),Y		;SAVE LB OF IO BUFFER;;			INY			LDA		PFI_BANK			STA		(ZP1),Y		;BANK			INY			LDA		#$00			STA		(ZP1),Y		;NOT USED BY PRODOS** ISSUE ASP COMMAND CALL*			JSR		NETWORK_CALL	;EXECUTE COMMAND** RESTORE ASP PARAMETER LIST POINTER*			jsr		getzp1parm** FIND REPLY LENGTH*			CLC			LDY		#$19			LDA		(ZP1),Y			ADC		WS_PLIST+6			STA		WS_PLIST+6	;SAVE REPLY LENGTH - LB			INY			LDA		(ZP1),Y			ADC		WS_PLIST+7			STA		WS_PLIST+7	;SAVE REPLY LENGTH - HB** UPDATE MARK*			LDX		UFILEIDX			CLC			LDY		#$19			LDA		(ZP1),Y			ADC		UMARK1,X			STA		UMARK1,X			INY			LDA		(ZP1),Y			ADC		UMARK2,X			STA		UMARK2,X			LDA		#$00			ADC		UMARK3,X			STA		UMARK3,X;;----> 9/30/87 TE;** UPDATE TRANSFER COUNT REMAINING*			SEC			LDY		#$19			LDA		UTRANCNT			SBC		(ZP1),Y			STA		UTRANCNT			INY			LDA		UTRANCNT+1			SBC		(ZP1),Y			STA		UTRANCNT+1;;----> END;** CHECK AFP COMMAND RESULT*			LDX		UFILEIDX			STZ		USTATUS,X	; CLEAR STATUS;			LDA		UERROR			BNE		RD_CHK3		;ERROR, CONTINUE PROCESS** IS THERE MORE DATA TO TRANSFER ?*			LDA		UTRANCNT			ORA		UTRANCNT+1			BNE		RD_CHK2A	;YES THERE IS MORE			LDA		UERROR			RTS					;TIME TO EXIT** IF BUFFERING IS ACTIVE, LOOK AT THE LAST CHARACTER*RD_CHK2A	; ;;---->			LDX		UFILEIDX			LDA		UTYPE,X			AND		#%00010000	;BUFFERING ???			BEQ		rd_UPDATE		;NO, UPDATE BUFFER POINTERS;			LDA		UENMASK,X	;NEWLINE MASK			BEQ		rd_UPDATE		;NEWLINE NOT ACTIVE !!!!;;			LDA		#WS_PATH	;MOVE TO CARD LOCATION			STA		DESTBUF			LDA		#>ws_path			STA		DESTBUF+1			LDA		#^ws_path			STA		DESTBUF+2;			LDA		#$01		;MOVE ONE BYTE ONTO THE CARD			STA		COUNT			LDA		#00			STA		COUNT+1;			CLC					;FIND ONE BYTE PAST DATA			LDY		#$19			LDA		(ZP1),Y			ADC		XBUFPTR			STA		SRCBUF			INY			LDA		(ZP1),Y			ADC		XBUFPTR+1			STA		SRCBUF+1;			SEC					;POINT TO LAST BYTE OF DATA			LDA		SRCBUF			SBC		#$01			STA		SRCBUF			LDA		SRCBUF+1			SBC		#$00			STA		SRCBUF+1			LDA		PFI_BANK			STA		SRCBUF+2;			JSR		buffmove	;MOVE IT NOW !!!!;;			LDX		UFILEIDX			LDA		WS_PATH		;LAST CHARACTER			AND		UENMASK,X	;NEWLINE MASK			CMP		UNLCHAR,X	;NEWLINE CHARACTER			BNE		rd_UPDATE;			LDA		UERROR			RTS;;---->** UPDATE USER'S BUFFER POINTER*rd_UPDATE		CLC			LDY		#$19			LDA		(ZP1),Y			ADC		XBUFPTR			STA		XBUFPTR			INY			LDA		(ZP1),Y			ADC		XBUFPTR+1			STA		XBUFPTR+1			JMP		RD_CHK1A** WAS IT AN EOF ERROR ?*RD_CHK3	; 			CMP		#$4C		;EOF ?			BEQ		RD_CHK4		;YES, ERROR WAS EOF !!!			RTS					;ERROR , TIME TO EXIT !!!** EOF ERROR CONDITION*RD_CHK4	; 			LDX		UFILEIDX			LDA		#%10000000	;SET EOF STATUS			STA		USTATUS,X			STZ		UERROR		;CLEAR ERROR CODE			RTS;;***  2) WRITE CHUNK CONTROL (MULTI BLOCK WRITES)**   ENTER : UMARK    = OFFSET IN DIRECTORY*           UFILEIDX = INDEX TO UMARK*           WS_PLIST = POINTER TO WORKSTATION PARAMETER LIST**   EXIT  : DATA FROM USER'S BUFFER**		EXPORT	WRT_CHKCNTLWRT_CHKCNTL		;		** HAS THE IO BUFFER BEEN WRITTEN INTO ?*			LDX		UFILEIDX			LDA		USTATUS,X			AND		#%00000001			BEQ		WRT_CHK1	;NO ,THERE IS NO DATA IN IO BUFFER;			JSR		WRITE_BLK** INITIALIZE AREA*WRT_CHK1	; 			LDA		#$08			STA		RETURNPL			STZ		WS_PLIST+6			STZ		WS_PLIST+7** CREATE WRITE PACKET*WRT_CHK1A	; 			LDA		#WRITEFORK			STA		WS_COMBUF	 ;SAVE AFP COMMAND			STZ		WS_COMBUF+$01	;SAVE START FLAG;			LDX		UFILEIDX			LDA		USRVNUM1,X			STA		WS_COMBUF+$02	;SAVE REF # - HB			LDA		USRVNUM2,X			STA		WS_COMBUF+$03	;SAVE REF # - LB;			STZ		WS_COMBUF+$04	;SAVE MARK			LDA		UMARK3,X			STA		WS_COMBUF+$05			LDA		UMARK2,X			STA		WS_COMBUF+$06			LDA		UMARK1,X			STA		WS_COMBUF+$07;			STZ		WS_COMBUF+$08	;SAVE REQ CNT			STZ		WS_COMBUF+$09;;;----> 9/30/87 te;								;LDA #$10								;CMP UTRANCNT+1; BCS WRT_CHK1B;								;STA WS_COMBUF+$0A								;STZ WS_COMBUF+$0B								;SEC								;LDA UTRANCNT+1								;SBC #$10								;STA UTRANCNT+1								;BRA WRT_CHK1C;;WRT_CHK1B = *			LDA		UTRANCNT+1			STA		WS_COMBUF+$0A			LDA		UTRANCNT			STA		WS_COMBUF+$0B								;STZ UTRANCNT								;STZ UTRANCNT+1;;----> end;** CREATE ASP WRITE PARAMETER LIST* FIND ASP HEAP - STUFF DEFAULT VALUES*WRT_CHK1C	; 			JSR		WRITE_STUFF** STUFF WRITE DATA BUFFER INFO (USERS BUFFER)*;			SEC			LDA		WS_COMBUF+$0B			SBC		#$10		;max size ??			LDA		WS_COMBUF+$0A			SBC		#$12		;max size ??			BCC		wrt_UNDER;			LDA		#$10		;set to max length			LDX		#$12			BRA		wrt_SETLEN;wrt_UNDER		LDA		WS_COMBUF+$0B			LDX		WS_COMBUF+$0Awrt_SETLEN		LDY		#$0F			STA		(ZP1),Y		;SAVE LB OF LENGTH			INY			TXA			STA		(ZP1),Y		;SAVE HB OF LENGTH;			INY			LDA		XBUFPTR			STA		(ZP1),Y		;LB OF BUFFER			INY			LDA		XBUFPTR+1			STA		(ZP1),Y		;HB OF BUFFER;;			INY			LDA		PFI_BANK			STA		(ZP1),Y		;BANK			INY			LDA		#$00			STA		(ZP1),Y		;OFF CARD** ISSUES ASP WRITE CALL*			JSR		NETWORK_CALL** CHECK AFP WRITE RESULT*			LDX		UFILEIDX			STZ		USTATUS,X	; CLEAR STATUS;			LDA		UERROR			BEQ		WRT_CHK3	;ERROR, CONTINUE PROCESS			RTS** SAVE LENGTH WRITTEN*WRT_CHK3			jsr		getzp1parm;			CLC			LDY		#$1F			LDA		(ZP1),Y			ADC		WS_PLIST+6			STA		WS_PLIST+6	;SAVE LENGTH WRITTEN - LB			INY			LDA		(ZP1),Y			ADC		WS_PLIST+7			STA		WS_PLIST+7	;SAVE LENGTH WRITTEN - HB** UPDATE MARK*			LDX		UFILEIDX			CLC			LDY		#$1F			LDA		(ZP1),Y			ADC		UMARK1,X			STA		UMARK1,X			INY			LDA		(ZP1),Y			ADC		UMARK2,X			STA		UMARK2,X			LDA		#$00			ADC		UMARK3,X			STA		UMARK3,X;;---->11/07/87 te -- drop box;** if this is an open ($C8) & it is in drop box Mode,* is this mark larger than the EOF ?* if yes update EOF !!!*			LDA		UTYPE,X			AND		#$08		;bit 3 = normal open ($C8) ???			BEQ		wrt_OVER		;no, special open;			LDA		UMODE,X			CMP		#$32		;drop box ??			BNE		wrt_OVER		;no, some other mode;			SEC			LDA		UMARK1,X			SBC		UDIRID1,X			LDA		UMARK2,X			SBC		UDIRID2,X			LDA		UMARK3,X			SBC		UDIRID3,X			BCC		wrt_OVER		;mark is lower, skip update;			LDA		UMARK1,X	;update EOF			STA		UDIRID1,X			LDA		UMARK2,X			STA		UDIRID2,X			LDA		UMARK3,X			STA		UDIRID3,X;;---->;** UPDATE TRANSFER COUNT REMAINING*;;----> 9/30/87 TE;wrt_OVER		SEC			LDY		#$1F			LDA		UTRANCNT			SBC		(ZP1),Y			STA		UTRANCNT			INY			LDA		UTRANCNT+1			SBC		(ZP1),Y			STA		UTRANCNT+1;;----> END;** IS THERE MORE DATA TO TRANSFER ?*			LDA		UTRANCNT			ORA		UTRANCNT+1			BNE		WRT_CHK2A	;YES THERE IS MORE;			LDA		UERROR			RTS					;TIME TO EXIT** UPDATE USER'S BUFFER POINTER*WRT_CHK2A	; 			CLC			LDY		#$1F			LDA		(ZP1),Y			ADC		XBUFPTR			STA		XBUFPTR			INY			LDA		(ZP1),Y			ADC		XBUFPTR+1			STA		XBUFPTR+1			JMP		WRT_CHK1A;			eject			*** 7) STUFF THE ASP HEAP THE THE DEFAULT VALUES**	ENTRY : ASP_HEAP = LENGTH OF DATA ALREADY IN BUFFER**	EXIT	: ZP1	= POINTER TO ASP PARAMTER LIST**					EXPORT	WRITE_STUFFWRITE_STUFF		;		** FIND ASP HEAP*			JSR		getzp1parm** STUFF ASYNC FLAG AND COMMAND*			LDY		#$00			LDA		#$00			STA		(ZP1),Y		;SAVE ASYNC FLAG			INY			LDA		#CMD_ASPWRT			STA		(ZP1),Y		;SAVE COMMAND** STUFF SESSION REFERENCE #*			LDY		#$08			LDX		UFILEIDX			LDA		UFILELOC,X			STA		(ZP1),Y** STUFF COMMAND BUFFER INFO*			INY			LDA		#$0C			STA		(ZP1),Y			INY			LDA		#$00		;SIZE OF CMD PACKET			STA		(ZP1),Y;			INY			LDA		#<WS_COMBUF			STA		(ZP1),Y			INY			LDA		#>WS_COMBUF			STA		(ZP1),Y			INY			LDA		#^WS_COMBUF			STA		(ZP1),Y			INY			LDA		#$00					STA		(ZP1),Y** STUFF REPLY BUFFER INFO*			LDY		#$15			LDA		#$04			STA		(ZP1),Y			INY			LDA		#$00		;SIZE OF REPLY DATA			STA		(ZP1),Y;			INY			LDA		#<WS_PATH			STA		(ZP1),Y			INY			LDA		#>WS_PATH			STA		(ZP1),Y			INY			LDA		#^WS_PATH			STA		(ZP1),Y			INY			LDA		#00			STA		(ZP1),Y			RTS;;			eject			*** 8) FILL THE REST OF THE IO BUFFER BLOCK WITH ZEROS**	ENTRY : PKT_CNT	= LENGTH OF DATA ALREADY IN BUFFER**	EXIT	: UBUFPTR	= CONTAINS A FULL BUFFER**					EXPORT	ZERO_IOBUFZERO_IOBUF		;		** SAVE LOCATION OF BUFFER TO BE FILLED WITH ZEROS*			LDA		#WS_COMBUF			STA		<ZP0			LDA		#>WS_COMBUF			STA		<ZP0+1** FILL ALL WHOLE ejectS*			LDX		PKT_CNT+1	;# OF PAGESZERO0	; 			CPX		#$02		;FULL			BEQ		ZERO2		;NO MORE;			LDY		#$00			LDA		#$00		;SAVE ZERO'SZERO1	; 			STA		(ZP0),Y			INY			BNE		ZERO1			INC		<ZP0+1		;HB OF POINTER			INX			BNE		ZERO0** MOVE ZERO INTO IO BUFFER - DATA BLOCK*ZERO2	; 			CLC			LDX		UFILEIDX			LDA		PKT_CNT		;SKIP DATA ALREADY IN IO BUFFER			ADC		UBUFPTRL,X			STA		<DESTBUF			LDA		PKT_CNT+1			ADC		UBUFPTRH,X			STA		<DESTBUF+1;			LDA		PFI_BANK			STA		<DESTBUF+2	;BANK;;			LDA		#WS_COMBUF			STA		<SRCBUF			LDA		#>WS_COMBUF			STA		<SRCBUF+1			LDA		#^WS_COMBUF			STA		<SRCBUF+2;			SEC			LDA		#$00			SBC		PKT_CNT			STA		<COUNT		;ROOM LEFT IN BUFFER - LB			LDA		#$02			SBC		PKT_CNT+1			STA		<COUNT+1	;ROOM LEFT IN BUFFER - HB			JMP		BUFFMOVE	;MOVE ZERO;;			eject			*** 10) MOVE THE ENTRY FOR A DIRECTORY TO MOTHERBOARD***	ENTRY : WS_DIRBUF = ENTRY FOR MOTHERBOARD*	PROCESS_CNT = # OF ENTRIES FOR THIS HALF*	ENTRY_CNT	= # OF ENTRIES IN IO BUFFER*	HOLD_IOPTR	= IO BUFFER POINTER**	EXIT : ENTRY_CNT	= UPDATED*	PKT_CNT	= UPDATED*	HOLD_IOPTR	= UPDATED**					EXPORT	MOVE_ENTRYMOVE_ENTRY		;		** INITIALIZE VAULES*			LDA		#$04			STA		PKT_OFFSET	;STANDARD OFFSET** IS THIS THE FIRST ENTRY FOR THIS BLOCK ?*			LDA		PROCESS_CNT			CMP		#$07			BNE		MOVE_ENTRY1	;NOT THE FIRST HALF;			LDA		ENTRY_CNT			BNE		MOVE_ENTRY1	;NOT THE FIRST ENTRY;;			STZ		PKT_OFFSET	;NO OFFSET;			LDX		#$03MOVE_ENTRY0	; 			STZ		WS_DIRBUF,X	;CLEAR POINTERS			DEX			BPL		MOVE_ENTRY0** SETUP SOURCE BUFFER*MOVE_ENTRY1	; 			CLC			LDA		#WS_DIRBUF			ADC		PKT_OFFSET			STA		<SRCBUF			LDA		#>WS_DIRBUF			ADC		#$00			STA		<SRCBUF+1			LDA		#^WS_DIRBUF			STA		<SRCBUF+2** SETUP COUNT*			SEC			LDA		#$2B			SBC		PKT_OFFSET			STA		<COUNT			LDA		#00			STA		<COUNT+1** SETUP DESTINATION BUFFER (& UPDATE PTR)*			CLC			LDA		HOLD_IOPTR			STA		<DESTBUF			ADC		<COUNT			STA		HOLD_IOPTR;			LDA		HOLD_IOPTR+1			STA		<DESTBUF+1			ADC		#$00			STA		HOLD_IOPTR+1;			LDA		PFI_BANK			STA		<DESTBUF+2	;BANK** MOVE THE BUFFER*			JSR		BUFFMOVE** UPDATE VARIABLE*			INC		ENTRY_CNT	;NUMBER OF PACKETS IN BUFFER			INC		PKT_CNT		;NUMBER OF PACKETS THIS HALF;			CLC			LDA		START_IDX			ADC		#$01			STA		START_IDX			LDA		START_IDX+1			ADC		#$00			STA		START_IDX+1			RTS;;			eject			*** 11) CALCULATE COUNT OF BYTES TO MOVE AND MOVE MARK**	ENTRY : UTRANCNT = TRANSFER REQUEST COUNT*	COUNT	= AMOUNT IN BLOCK AVAILABLE*	UMARK	= LOCATION OF MARK IN BLOCK*	XBUFPTR	= LOCATION OF USER'S BUFFER**	EXIT	: UTRANCNT = UPDATED TRANSFER COUNT*	COUNT	= UPDATED AMOUNT AVAILABLE*	UMARK	= UPADTED MARK*	XBUFPTR	= UPDATED OF BUFFER START**					EXPORT	GETCOUNTGETCOUNT		;		** COMPARE TRANSFER REQUEST AGAINST AMOUNT IN	BLOCK*			LDA		UTRANCNT+1	;COMPARE WITH REQ COUNT			CMP		<COUNT+1				BCC		GETCNT1		;TRANSFER COUNT WITHIN BLOCK			BNE		GETCNT2		;SAVE UPDATED TRANSFER COUNT;			LDA		UTRANCNT			CMP		<COUNT				BCS		GETCNT2		;SAVE UPDATED TRANSFER COUNT** SWITCH AMOUNT TO MOVE TO TRANSFER COUNT*GETCNT1	; 			LDA		UTRANCNT	;PUT UTRANCNT INTO ZP3			STA		<COUNT			LDA		UTRANCNT+1			STA		<COUNT+1** UPDATE TRANSFER COUNT (TRANSFER COUNT - AMOUNT TO MOVE)*GETCNT2	; 			SEC			LDA		UTRANCNT	;UPDATE UTRANCNT			SBC		<COUNT			STA		UTRANCNT			LDA		UTRANCNT+1			SBC		<COUNT+1			STA		UTRANCNT+1** UPDATE MARK TO NEW LOCATION*			CLC			LDA		UMARK1,X	;UPDATE MARK			ADC		<COUNT			STA		UMARK1,X			LDA		UMARK2,X			ADC		<COUNT+1			STA		UMARK2,X			BCC		GETCNT3			INC		UMARK3,X** UPDATE SAVED FILE BUFR PTR*GETCNT3	; 			CLC			LDA		XBUFPTR			ADC		<COUNT			STA		XBUFPTR			LDA		XBUFPTR+1			ADC		<COUNT+1			STA		XBUFPTR+1			RTS;;			eject			*** 12) SET TRANSFER COUNT FOR READ AND WRITE**	ENTRY : WS_PLIST = PARAMETER LIST LOCATION ON CARD*	UTRANCNT = AMOUNT TO MOVE**	EXIT	: WS_PLIST = UPDATED TRANSFER COUNT IN PL**					EXPORT	SETTRCNTSETTRCNT		;					SEC			LDA		WS_PLIST+4	;GET REQ COUNT			SBC		UTRANCNT	;AND SUB UTRANCNT			STA		WS_PLIST+6	;STORE IN TRANS COUNT;			LDA		WS_PLIST+5			SBC		UTRANCNT+1			STA		WS_PLIST+7			RTS;;			eject			*** 13) SETUP FOR READ AND WRITE**	ENTRY : WS_PLIST = PARAMETER LIST ON CARD**	EXIT	: XBUFPTR	= POINTER TO USER'S BUFFER*	UTRANCNT = AMOUNT TO MOVE*	C	= AMOUNT TO MOVE IS OVER A BLOCK**					EXPORT	RWSETUPRWSETUP		;		** SAVE USER'S BUFFER POINTER*			LDA		WS_PLIST+2	;STORE USER BUFR PIONTER			STA		XBUFPTR			LDA		WS_PLIST+3			STA		XBUFPTR+1** SAVE REQUEST COUNT*			LDA		WS_PLIST+4	;STORE REQ COUNT			STA		UTRANCNT			LDA		WS_PLIST+5			STA		UTRANCNT+1** IS THE REQUEST COUNT OVER ONE BLOCK ?*			SEC			LDA		#$00		;LB - ONE BLOCK			SBC		UTRANCNT			LDA		#$02		;HB - ONE BLOCK			SBC		UTRANCNT+1			RTS;;*** 14) ADJUST FOR MARK WRAP AROUND**  ENTRY : UFILEIDX = INDEX TO REF # FOR FILE*          WS_PLIST = PARAMETER LIST**  EXIT  : WS_PLIST = UPDATE PARAMETER LIST*          C        = SET IF WRAP SETUP**		EXPORT	MARK_WRAPMARK_WRAP		;		** DOES ALL OF THE DATA FIT BELOW A MARK OF $FF FF FF*			SEC			LDA		#$FF			SBC		UMARK1,X			STA		SIZE_ALLOWED			LDA		#$FF			SBC		UMARK2,X			STA		SIZE_ALLOWED+1			LDA		#$FF			SBC		UMARK3,X			STA		SIZE_ALLOWED+2;			LDA		SIZE_ALLOWED+2			BNE		mw_OK1		;MORE THAN ENOUGH SPACE;			SEC			LDA		SIZE_ALLOWED			SBC		WS_PLIST+$04			LDA		SIZE_ALLOWED+1			SBC		WS_PLIST+$05			BCS		mw_OK1		;MORE THAN ENOUGH SPACE;** REQUEST COUNT NEEDS TO BE ADJUSTED !!!*			LDA		SIZE_ALLOWED	;ADJUST REQUEST COUNT			STA		WS_PLIST+$04			LDA		SIZE_ALLOWED+1			STA		WS_PLIST+$05;			LDA		WS_PLIST+$04			ORA		WS_PLIST+$05			BNE		mw_OK1		;THERE IS SOME ROOM LEFT;			SEC			RTS** TIME TO LEAVE*mw_OK1		CLC			RTS*** 11) Fill the end of dir block with dummy entries**  ENTRY : UFILEIDX = INDEX TO REF # FOR FILE**  EXIT  : update i/o buffer***		EXPORT	DUMMY_FILLDUMMY_FILL		;		** find amount the count is off*			SEC			LDX		UFILEIDX			LDA		UFILECNTL,X			SBC		START_IDX			TAY					;save adjustment in y			LDA		UFILECNTH,X			SBC		START_IDX+1			BCS		df_CONT		;yes, the count is positive			RTS					;exit								;you got more than you thought (or equal);df_CONT		CPY		#$0D		;full block ??			BCS		df_MAX			CMP		#$00			BEQ		df_OVERdf_MAX		LDY		#$0D		;set size to max possible for a block;df_OVER		CPY		#$00			BNE		df_OVER1			RTS; [y] has amount off** how many free entries spaces are left in the block** must leave [y] alone*df_OVER1	SEC			LDA		#$0D			SBC		ENTRY_CNT			STA		UWORK1			BNE		df_MIN			RTS					;now room left in the data block** which is smaller 1)amount needed or 2) space available ?** [y] must still be set*df_MIN		SEC			TYA					;amount needed			SBC		UWORK1		;space available			BCS		df_FILL			STY		UWORK1		;update count to amount needed			BRA		df_FILL** stuff dummy entry*df_DUMMY_DIR		DS.B 4	        ;pointers	DC.B	$1F	;storage type ($10) + length ($0f)	DC.B	'???????????????'	;dummy name		DS.B $20	        ;extra bytes here to be safe;df_FILL		LDX		#$2Adf1_LOOP	LDA		df_DUMMY_DIR,X			STA		WS_DIRBUF,X			DEX			BPL		df1_LOOP** update i/o buffer*			LDA		UWORK1		;number of dummy entriesdf1_NEXT	PHA;			JSR		MOVE_ENTRY;			PLA			DEC		a			BNE		df1_NEXT		;go to next record** update PKT_CNT*			SEC			LDX		UFILEIDX			LDA		HOLD_IOPTR			SBC		UBUFPTRL,X			STA		PKT_CNT		;LB OF LENGTH OF DATA			LDA		HOLD_IOPTR+1			SBC		UBUFPTRH,X			STA		PKT_CNT+1	;HB OF LENGTH OF DATA			RTS;;;		ENDP		end