;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	Import	NETWORK_CALL_RESULT	Import	UM_INDEX	Import	Vector_Atten	Import	SESSION_NET	Import	SESSION_NAME	IMPORT	ATTEN_CNT	IMPORT	CURSESS	IMPORT	Cn_PFIERR	IMPORT	GETBUF	IMPORT	GETEOF	IMPORT	GETFINFO	IMPORT	GETMARK	IMPORT	GETPREFIX	IMPORT	NEWLINE	IMPORT	ONLINE	IMPORT	PFI_STATUS	IMPORT	PKT_CNT	IMPORT	QUITCALL	IMPORT	SESS_TMRTBL	IMPORT	SETBUF	IMPORT	SETEOF	IMPORT	SETINFO	IMPORT	SETMARK	IMPORT	SETPREFIX	IMPORT	SOUND_CNT	IMPORT	UERROR	IMPORT	WRITE	IMPORT	WS_COMBUF	IMPORT	changepath	IMPORT	gettime	IMPORT	getzp1parm	IMPORT	ndt_sess	IMPORT	pfibank	IMPORT	session_tbl	Import	SESS_IDX	IMPORT	uwork1	IMPORT	vol_unmount	import	create,destroy,rename,open,read,close,flush,bytelock;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	AFP_ERROR	ENTRY	CMD_STUFF	ENTRY	NETWORK_CALL	ENTRY	PRODOS_ERROR	ENTRY	Update_TMR** pfi_cmdsubs5** Greg Seitz (14-Jul-87)**;		EXPORT	zpcmdscs5	;zpcmdscs5	PROC		INCLUDE	'zp.equates';		ENDP		include	'global.equates'		include 'pfi_equates'				EXPORT	pficmdsubs5	pficmdsubs5	PROC*		using	atpequates*		using 	pfiglobals*		using	zpcmdscs5			longa	off			longi	off* dummy temporary routines go here* b1_trapmb	entry* b1_execmove	entry			longa	off			longi	off* now for the real stuff			eject**	PARAMIS NETWORK SOFTWARE****	CONFIDENTIAL*** MODULE : PFI5 - PRODOS FILING INTERFACE	(PART 5)*	COMMON SUBROUTINES (PART3)*	ROM TABLES**	WRITTEN BY THOMAS EAGERR**	MODIFIED: 06-15-87	4:18	TE**	COPYRIGHT 1986,87 PARAMIS CORPORATION** ALL RIGHTS RESERVED******* A: NETWORK INTERFACE SUBROUTINES**	1) DO_ATTEN	- EXECUTE ATTENTION CALL ON MOTHERBOARD*	2) CMD_ROUTING	- SEND CMD FROM & REPLY TO WS_COMBUF*	3) NETWORK_CALL - EXECUTE CALL IN ASP HEAP*	4) STUFF_COMPL	- STUFF COMPLETION ROUTINE*	5) PFI_COMPL	- ASP COMPLETION ROUTINE**** B: TABLES**	6) MLI COMMAND TABLE*	7) MLI PARAMETER COUNT TABLE*	8) MLI CHARACTERISTICS TABLE*	9) PROCESS ADDRESS TABLE* 10) POSSIBLE UNIT NUMBER TABLE* 11) AFP ERROR TABLE* 12) PRODOS ERROR TABLE* 13) MISC STRINGS**			eject***	1) EXECUTE ATTENTION ROUTINE ON MOTHERBOARD**	ENTRY : TIME LEFT - FIRST TWO BYTES**	EXIT	: NONE**		EXPORT	ATTEN_TIMEATTEN_TIME		;				DS.B 4				;asp stores info here then calls do_atten		EXPORT	DO_ATTENDO_ATTEN		;		** CHECK TYPE BYTE*			clc			xce			sep		#mbit+xbit	;put in 8 bit mode			lda		atten_time+1	;see how we shut down			bne		_dat_crash		;with timeout or close...			BIT		ATTEN_TIME+2			BVS		_dat_CRASH			BMI		_dat_ATNCHK1			brl		_dat_done		;NOT VALID** IS THIS A SERVER SHUTDOWN	?* (ADJUST HIGH BYTE HAS TIME)*_dat_ATNCHK1	LDA		ATTEN_TIME+2			AND		#$3F		;SKIP TWO HIGH BITS			BEQ		_dat_ATNCHK2	;CHECK LOW BYTE;			LDA		ATTEN_TIME+3			ORA		#$80		;OVER MAX			STA		ATTEN_TIME+3	;OVERFLOW TIME			jmp		DO_ATTEN0A	;THERE IS A TIME;_dat_ATNCHK2	LDA		ATTEN_TIME+3			BNE		DO_ATTEN0A	 ;TIMER								;CRASH !!!								;								;								;								;** SERVER CRASHED - -TRAP MOTHERBOARD*_dat_CRASH	; 			lda		atten_time		;get session number			beq		_dat_crash2		;no session number			ldx		#00_dat_crash1	; 			cmp		session_tbl,x	;check for active session			beq		_dat_sess_fnd	;yes it is active			inx			cpx		#maxsession			bne		_dat_crash1_dat_crash2	brl		_dat_done** remove session from session table*_dat_sess_fnd	; 			stz		session_tbl,x			stx		SESS_IDX			stz		uwork1			;no volumes unmounted			ldx		#13_dat_loop3	lda		atten_time			beq		_dat_done			cmp		ndt_sess,x			bne		_dat_loop4			inc		uwork1			;one more to unmount			lda		SESS_IDX			ldy		#$ff			clc			jsr		vol_unmount									; X IS UNCHANGED !!!_dat_LOOP4	DEX			BPL		_dat_LOOP3		;MORE TO CHECK			lda		uwork1			;see if any volumes unmounted			beq		_dat_done		;no, so no noise			;			;			;			;			;			;			;----> should we call the Attention vector			;			jsr		Atten_vector			bcs		_dat_DONE			;			;			;			;** SET UP NOTE*Crash_snd				php			sei								;			LDA		#$06			STA		SOUND_CNT;_dat_SOUND0	LDA		#$E0		;LOW NOTE			BRA		_dat_SOUND2_dat_SOUND1	LDA		#$40		;HIGH NOTE_dat_SOUND2	STA		SOUND+1			STA		SOUND+3;			LDX		#$01		;ONLY ONE NOTE AT A TIME			STX		ATTEN_CNT			jsr		dosound		;do sound and screen stuff** IS THE CRASH DONE ?*			LDA		SOUND_CNT			DEC		A			STA		SOUND_CNT			BEQ		_dat_DONE1			LSR		A			BCS		_dat_SOUND1		;HIGH NOTE			BRA		_dat_SOUND0		;LOW NOTE									;_dat_DONE1	plp** Done*_dat_DONE	; 			rep		#mbit+xbit			rtl						;return to asp;;;;;** MAKE SURE THAT COUNT IS UNDER MAX*DO_ATTEN0A	; 			lda		atten_time		;get session number			beq		_dat_Done		;no session number			ldx		#00 DO_ATTEN0b	cmp		session_tbl,x	;check for active session			beq		DO_ATTEN0c	;yes it is active			inx			cpx		#maxsession			bne		DO_ATTEN0b			brl		_dat_done			;			;			;----> should we call the Attention vector			;DO_ATTEN0c	stx		SESS_IDX			jsr		Atten_vector			bcs		_dat_DONE			;			;			;			;			LDX		ATTEN_TIME+3			CPX		#$0F			BCC		DO_ATTEN1	;TIME OK			CPX		#$FF			BNE		DO_ATTEN0;											;			LDX		#$02		;DO IT TWO TIMES			LDA		#$E0		;LONG INTERVALS			BRA		DO_ATTEN1A;DO_ATTEN0	; 			LDX		#$0F		;DO IT THE MAXDO_ATTEN1	; 			LDA		#$40		;SHORT INTERVALSDO_ATTEN1A	; 			STX		ATTEN_CNT			STA		SOUND+1			STA		SOUND+3			php			sei			jsr		dosound			bra		_dat_done1;;;;;;Atten_vector			lda		#$00			ldx 	#$03_dat_lp4a	ora		Vector_Atten,x			dex			bne		_dat_lp4a			cmp		#$00			bne		ATT_VEC1			;no Vector installed			clc			rts			;			;			;ATT_VEC1	lda		#<Session_name			STa		Zp3			lda		#>Session_name			STa		ZP3+1			lda		#<Session_net			STa		Zp4			lda		#>Session_net			STa		ZP4+1			;			ldx		SESS_IDXATT_VEC4	dex 			bmi		ATT_VEC5			clc			LDA		ZP3			adc		#$21			sta		ZP3			LDA		ZP3+1			adc		#$00			STA		ZP3+1			clc			LDA		ZP4			adc		#$22			sta		ZP4			LDA		ZP4+1			adc		#$00			STA		ZP4+1			BRA		ATT_VEC4			;			; move name into BUFFER			;ATT_VEC5				ldy		#$20ATT_VEC6	lda		(ZP3),y			sta		WS_COMBUF+4,y			dey			bpl		ATT_VEC6			;			ldy		#$21ATT_VEC6a	lda		(ZP4),y			sta		WS_COMBUF+$24,y			dey			bpl		ATT_VEC6a			;			LDX		#$03ATT_VEC7	LDA		Atten_time,x			sta		Ws_combuf,x			dex			bpl		Att_VEC7			;			;			;			;						longi	on			longa 	on			;			rep		#$30			phb			ldx		#_vector_X-1			;Put my return Address on the Stack			phx			;			longa 	off			longi	off			sep		#$30			lda		VECTOR_Atten+2			pha			longi	on			longa	on			;			rep		#$30			ldx		VECTOR_Atten		;Put vector on stack			dex			phx			;			ldx		#ws_combuf			ldy		#^ws_combuf			rtl			;			longi	off			longa 	off			;			;			;_vector_X	Sep		#$30			sec			rts;;;;;**	ATTENTION ROUTINE** GETS THE USER'S ATTENTION* BY INVERSING THE CURRENT* SCREEN AND MAKING A SOUND** THIS ROUTINE IS USED WHEN* THE SERVER IS ABOUT TO GO* DOWN. (MULTIPLE WARNINGS)*zPOINT		equ		$F0SPEAKER		equ		$E1C030;FIRST LETS FREE UP SOME ZERO PAGEDOSOUND		LDA		<zPOINT			PHA			LDA		<zPOINT+1			PHA			lda		<zPoint+2			pha;-------------------------------------------------------------------------------; NOTE:; Below we used to stuff a zero into ZPOINT (low byte) and ZPOINT+2 (bank byte); so we can change the screen values for bank 0.  Because shadowning might; not be on, we could be trashing bank E0s screen memory.  I'm changing the; ZPOINT+2 from $00 to $E0 so that we always touch the REAL screen memory.;-------------------------------------------------------------------------------			ldy		#$E0			sty		<zPoint+2			LDY		#0			;do stuff from bank zero;			sty		<zPoint+2	;No longer do this!  (See about note)			STY		<zPOINT								;			LDA		ATTEN_CNT			BEQ		ATTEN1;ATTEN0	; ** Inverse 2 TEXT pages*    		LDA		#$04			STA		<zPOINT+1			LDX		#$0C		;2 TEXT PAGES WORTHdsLOOP1		LDA		[zPOINT],Y	;INVERT RANGE STARTED AT zPOINT			EOR		#$FF		; TIL HIBYTE = X REG			STA		[zPOINT],Y			INY			BNE		dsLOOP1;			CLC			LDA		<zPOINT+1			ADC		#$04			STA		<zPOINT+1			CPX		<zPOINT+1			BNE		dsLOOP1** inverse 2 high hires pages*			LDA		#$20			STA		<zPOINT+1			LDX		#$60		;2 HIRES PAGES WORTHdsLOOP2		LDA		[zPOINT],Y	;INVERT RANGE STARTED AT zPOINT			EOR		#$FF		; TIL HIBYTE = X REG			STA		[zPOINT],Y			INY			BNE		dsLOOP2;			CLC			LDA		<zPOINT+1			ADC		#$04			STA		<zPOINT+1			CPX		<zPOINT+1			BNE		dsLOOP2** make some noise*SOUND		LDY		#$40SOUND0	; 			LDX		#$40SOUND1	; 			DEX			BNE		SOUND1			LDA		SPEAKER			DEY			BNE		SOUND0** reverse 2 TEXT pages*			LDA		#$04			STA		<zPOINT+1			LDX		#$0C		;2 TEXT PAGES WORTHdsLOOP3		LDA		[zPOINT],Y	;INVERT RANGE STARTED AT zPOINT			EOR		#$FF		; TIL HIBYTE = X REG			STA		[zPOINT],Y			INY			BNE		dsLOOP3;			CLC			LDA		<zPOINT+1			ADC		#$04			STA		<zPOINT+1			CPX		<zPOINT+1			BNE		dsLOOP3** reverse 2 high hires pages*			LDA		#$20			STA		<zPOINT+1			LDX		#$60		;2 HIRES PAGES WORTHdsLOOP4		LDA		[zPOINT],Y	;INVERT RANGE STARTED AT zPOINT			EOR		#$FF		; TIL HIBYTE = X REG			STA		[zPOINT],Y			INY			BNE		dsLOOP4;			CLC			LDA		<zPOINT+1			ADC		#$04			STA		<zPOINT+1			CPX		<zPOINT+1			BNE		dsLOOP4;;			DEC		ATTEN_CNT			BNE		ATTEN0;NOW LETS RESTORE ZERO PAGEATTEN1	; 			pla			sta		<zPoint+2			PLA			STA		<zPOINT+1			PLA			STA		<zPOINT			rts			;			;			eject***	2) COMMAND ROUTING - ISSUES AN ASP COMMAND*	THE COMMAND & REPLY BUFFER ARE THE SAME BUFFER**	ENTRY : UFILEIDX	= HEAP NUMBER FOR ASP HEAP*	PKT_CNT	= SIZE OF PACKET TO BE SENT*	WS_COMBUF = REQUEST PACKET LOCATION**	EXIT	: A	= ERROR CODE*	WS_COMBUF = REPLY IN BUFFER**		EXPORT	CMD_ROUTINGCMD_ROUTING		;		** STUFF ASP COMMAND PACKET WITH DEFAULT VALUES*			JSR		CMD_STUFF;			LDY		#$0F			LDA		#$00			STA		(ZP1),Y		;SAVE LB OF REPLY LEN			INY			LDA		#$02			STA		(ZP1),Y		;SAVE HB OF REPLY LEN;			INY			LDA		#WS_COMBUF			STA		(ZP1),Y		;SAVE LB OF COM BUFFER			INY			LDA		#>WS_COMBUF			STA		(ZP1),Y		;SAVE HB OF COM BUFFER			INY			LDA		#^WS_COMBUF			STA		(ZP1),Y			INY			LDA		#00			;			STA		(ZP1),Y		;** ISSUE ASP COMMAND CALL*			JMP		NETWORK_CALL	;EXECUTE COMMAND;;			eject***	3) NETWORK CALL - EXECUTE AN ASP CALL*	TRANSLATE COMMAND RESULT INTO PRODOS ERROR CODE**	ENTRY : ASP_HEAP = POINTER TO ASP HEAP**	EXIT	: UERROR	= PRODOS ERROR CODE*	C	= ERROR INDICATOR**		EXPORT	NETWORK_CALLNETWORK_CALL		;		**  IS APPLETALK LOCKUPED BECAUSE OF RAMFORBID ?*			lda		>AT_lockout			beq		net_1			jmp		nc_exit		;YES IT IS ---> DON'T SEND PACKET** ISSUE ASP CALL*net_1		php					;save state			rep		#mbit+xbit	;go full 16 bit			longa	on			longi	on			stz		NETWORK_CALL_RESULT	;-----------------> Fix for bug #37942			ldx		<ZP1		;get low word of parm	|	11/29/88			ldy		#^pfibank	;and get bank			|	**TGH			jsl		>RamDispatch	;make the call		|			ldy		#$02				;---------------|			lda		(ZP1),y				;---------------|			sta		NETWORK_CALL_RESULT ;---------------'			plp					;recover mode which was 8 bit			longa	off			longi	off			LDY		#$02		;LB OF RESULT CODE			LDA		(ZP1),Y			BNE		NETWORK_ERR	;ERROR IN NETWORK CALL** CLEAR PFI FLAG*			STZ		PFI_STATUS** IS THIS AN ASP OPEN SESSION ?*			LDY		#$01			LDA		(ZP1),Y			CMP		#CMD_ASPOPN			BNE		NETWORK_CALL1	;NO IT IS NOT			CLC			RTS					;FINISHED PROCESSING OPEN** IS THIS AN ASP CLOSE SESSION ?*NETWORK_CALL1	; 			CMP		#CMD_ASPCLO			BNE		NETWORK_CALL2	;NO IT IS NOT			CLC			RTS					;FINISHED PROCESSING CLOSE** IS THIS AN ASP COMMAND ?*NETWORK_CALL2	; 			;			;			pha				;saves ASP Command Number			lda		ZP1			pha			lda		ZP1+1			pha			jsr		Update_TMR			pla			sta		ZP1+1			pla			sta		ZP1			pla				;Restore ASP Command Number			;			;			;			CMP		#CMD_ASPCMD			BNE		NETWORK_CALL3	;NO,IT IS NOT								;			LDY		#$18		;OFFSET TO LB OF CMD RESULT			BRA		NETWORK_CALL4	;TRANSLATE ERROR** IS THIS AN ASP WRITE ?*NETWORK_CALL3	; 			CMP		#CMD_ASPWRT			BNE		NETWORK_ERR	;SHOULD NOT BE HERE								;			LDY		#$1E		;OFFSET TO LB OF CMD RESULT** FIND AFP ERROR IN ASP TABLE* IF ERROR IS NOT FOUND IT IS AN I/O ERROR*NETWORK_CALL4	; 			LDX		#$FFNETWORK_CALL5	; 			INX			LDA		AFP_ERROR,X			CMP		(ZP1),Y			BEQ		NETWORK_CALL6	;ERROR WAS FOUND			CMP		#$FF			;END OF TABLE ?			BNE		NETWORK_CALL5	;LOOK AT THE NEXT RECORD** SAVE UNKNOWN PFI ERROR - SET I/O ERROR*			STA		Cn_PFIERR	;save UNKNOWN PFI ERROR			LDA		#$27		;I/O ERROR			STA		UERROR			SEC			RTS** TRANSLATE INTO PRODOS ERROR*NETWORK_CALL6	; 			STA		Cn_PFIERR	;SAVE PFI ERROR;			LDA		PRODOS_ERROR,X			STA		UERROR			BEQ		NETWORK_CALL7	;NO ERROR;			SEC			RTS** NO ERROR IN ASP & AFP CALL*NETWORK_CALL7	; 			CLC			RTS** ERROR IN MAKING NETWORK CALL**NETWORK_ERR	; ** find asp parameter list*;			LDY		#$02			LDA		(ZP1),Y		;is this an invalid session error			CMP		#$03			BNE		nc_EXIT		;** is this a valid session ?*			LDY		#$08		;session ref #			LDA		(ZP1),Y			BEQ		nc_EXIT		;NOT A VALID SESSION #;			LDX		#$00nc_LOOP1	CMP		SESSION_TBL,X			BEQ		nc_SESS_FND	;yes this is an acitve session			INX			CPX		#MAXSESSION			BNE		nc_LOOP1			BRA		nc_EXIT		;session no longer valid** remove session from session table* UNMOUNT VOLUMES FOR THAT SESSION*nc_SESS_FND	stx		UM_INDEX		;Store for later use			STZ		SESSION_TBL,X			PHA;			LDX		#13nc_LOOP3	PLA			PHA			BEQ		nc_DONE			CMP		NDT_SESS,X			BNE		nc_LOOP4		;THIS IS NOT THE SAME SESSION			lda		UM_INDEX			ldy		#00			CLC					;SEND NO PACKET			JSR		VOL_UNMOUNT	;X IS OFFSET TO NDT TABLES; X IS UNCHANGED !!!nc_LOOP4	DEX			BPL		nc_LOOP3		;MORE TO CHECKnc_DONE		PLA** set flags for exit*nc_EXIT		STZ		PFI_STATUS	;MAKE SURE FLAG IS CLEARED;			LDA		#$FF			STA		Cn_PFIERR	;SET ERROR TO NETWORK;			LDA		#$27			STA		UERROR		;SAVE PRODOS ERROR			SEC			RTS;;			eject***	6) MLI COMMAND TABLE**		EXPORT	CMDCODECMDCODE		;			DC.B	$C0	;CREATE	DC.B	$C1	;DESTROY	DC.B	$C2	;RENAME	DC.B	$C3	;SET_FILE_INFO	DC.B	$C4	;GET_FILE_INFO	DC.B	$C5	;ON_LINE	DC.B	$C6	;SET_PREFIX	DC.B	$C7	;GET_PREFIX;	DC.B	$C8	;OPEN	DC.B	$C9	;NEWLINE	DC.B	$CA	;READ	DC.B	$CB	;WRITE	DC.B	$CC	;CLOSE	DC.B	$CD	;FLUSH	DC.B	$CE	;SET_MARK	DC.B	$CF	;GET_MARK	DC.B	$D0	;SET_EOF	DC.B	$D1	;GET_EOF	DC.B	$D2	;SET_BUF	DC.B	$D3	;GET_BUF;	DC.B	$65	;PRODOS QUIT CALL	DC.B	$43	;OPEN FORK	DC.B	$44	;BYTE LOCK	DC.B	$45	;change path	DC.B	$82	;get time;'	DC.B	$40	;ALLOC_INTERRUPT	DC.B	$41	;DEALLOC_INTERRUPT	DC.B	$80	;READ_BLOCK	DC.B	$81	;WRITE_BLOCK;	DC.B	$00	;END OF MAIN COMMANDS;;			eject**	7) MLI	PARAMETER COUNT TABLE**		EXPORT	PCOUNTPCOUNT		;			DC.B	$07	;CREATE	DC.B	$01	;DESTORY	DC.B	$02	;RENAME	DC.B	$07	;SET FILE INFO	DC.B	$0A	;GET FILE INFO	DC.B	$02	;ON LINE	DC.B	$01	;SET PREFIX	DC.B	$01	;GET PREFIX;'	DC.B	$03	;OPEN	DC.B	$03	;NEWLINE	DC.B	$04	;READ	DC.B	$04	;WRITE	DC.B	$01	;CLOSE	DC.B	$01	;FLUSH	DC.B	$02	;SET MARK	DC.B	$02	;GET MARK	DC.B	$02	;GET EOF	DC.B	$02	;GET EOF	DC.B	$02	;SET BUF	DC.B	$02	;GET BUF;	DC.B	$04	;PRODOS QUIT CALL	DC.B	$04	;OPEN FORK	DC.B	$05	;BYTE LOCK	DC.B	$02	;change path	DC.B	$00	;get time;	DC.B	$02	;ALLOCATE INTERRUPT	DC.B	$01	;DEALLOCATE INTERRUPT	DC.B	$03	;READ BLOCK	DC.B	$03	;WRITE BLOCK;;			eject***	8) MLI CHARACTERISTICS TABLE** BITMAP :*	BIT 0 = LOCAL CALL*	BIT 1 = LOCAL IF SET TO LOCAL*	BIT 2 = REF # NEEDED*	BIT 3 = PATHNAME USED*	BIT 4 = UNIT # USED*	BIT 5 = UNUSED*	BIT 6 = LIST RETURNED*	BIT 7 = DATA RETURNED*		EXPORT	CMDTYPECMDTYPE		;			DC.B	%00001010	;CREATE	DC.B	%00001010	;DESTROY	DC.B	%00001010	;RENAME	DC.B	%00001010	;SET FILE INFO	DC.B	%01001010	;GET FILE INFO	DC.B	%11010010	;ONLINE	DC.B	%00001000	;SET PREFIX	DC.B	%00000000	;GET PREFIX;'	DC.B	%01000000	;OPEN	DC.B	%00000100	;NEWLINE	DC.B	%11000100	;READ	DC.B	%01000100	;WRITE	DC.B	%00000100	;CLOSE	DC.B	%00000100	;FLUSH	DC.B	%00000100	;SET MARK	DC.B	%00000100	;GET MARK	DC.B	%00000100	;SET EOF	DC.B	%01000100	;GET EOF	DC.B	%00000100	;SET BUF	DC.B	%00000100	;GET BUF;	DC.B	%00000000	;PRODOS QUIT CALL	DC.B	%01000000	;OPEN FORK	DC.B	%01000100	;BYTE LOCK	DC.B	%00000000	;change path	DC.B	%00000010	;get time;	DC.B	%00000001	;ALLOC INT	DC.B	%00000001	;DEALLOCATE INT	DC.B	%00010000	;READ BLOCK	DC.B	%00010000	;WRITE BLOCK;;			eject***	9) PROCESS ADDRESS TABLE**		EXPORT	MCPADDRMCPADDR		;			DC.W	CREATE	;CREATE	DC.W	DESTROY	;DESTORY	DC.W	RENAME	;RENAME	DC.W	SETINFO	;SET FILE INFO	DC.W	GETFINFO	;GET FILE INFO	DC.W	ONLINE	;ON LINE	DC.W	SETPREFIX	;SET PREFIX	DC.W	GETPREFIX	;GET PREFIX;	DC.W	OPEN	;OPEN	DC.W	NEWLINE	;NEWLINE	DC.W	READ	;READ	DC.W	WRITE	;WRITE	DC.W	CLOSE	;CLOSE	DC.W	FLUSH	;FLUSH	DC.W	SETMARK	;SET MARK	DC.W	GETMARK	;GET MARK	DC.W	SETEOF	;SET EOF	DC.W	GETEOF	;GET EOF	DC.W	SETBUF	;SET BUF	DC.W	GETBUF	;GET BUF;	DC.W	QUITCALL	;PRODOS QUIT CALL	DC.W	OPEN	;OPEN FORK = OPEN	DC.W	BYTELOCK	;BYTE RANGE LOCK	DC.W	changepath	;change path call (for p16)	DC.W	gettime	;get time								;;			eject*** 10) POSSIBLE UNIT NUMBERS**		EXPORT	PUN_ROMPUN_ROM		;			DC.B	$70,$F0	;SLOT 7	DC.B	$60,$E0	;SLOT 6	DC.B	$50,$D0	;SLOT 5	DC.B	$40,$C0	;SLOT 4	DC.B	$30,$00	;SLOT 3 - ram disk not available	DC.B	$20,$A0	;SLOT 2	DC.B	$10,$90	;SLOT 1;;			eject*** ERROR CONVERSIONS FROM AFP INTO PRODOS***	AFP ERROR	PRODOS ERROR**	$00	NO ERROR	=	$00	NO ERROR*	$78	ACCESS DENIED	=	$4E	FILE ACCESS ERROR*	$77	AUTH CONTINUE	=	$27	I/O ERROR*	$76	BAD UAM	=	$27	I/O ERROR*	$75	BAD VERSION NUMBER	=	$27	I/O ERROR*	$74	BITMAP ERROR	=	$53	INVALID PARAMETER*	$73	CAN'T MOVE	=	$27	I/O ERROR*	$72	DENY CONFLICT	=	$4E	FILE ACCESS ERROR*	$71	DIR NOT EMPTY	=	$4E	FILE ACCESS ERROR*	$70	DISK FULL	=	$48	VOLUME FULL*	$6F	EOF ERROR	=	$4C	END OF FILE*	$6E	FILE BUSY	=	$50	FILE IS OPEN*	$6D	FLAT VOLUME	=	$27	I/O ERROR*	$6C	ITEM NOT FOUND	=	$44	DIRECTORY NOT FOUND*	$6B	LOCK ERROR	=	$4E	FILE ACCESS ERROR*	$6A	MISC ERROR	=	$27	I/O ERROR*	$69	NO MORE LOCKS	=	$27	I/O ERROR*	$68	NO SERVER	=	$27	I/O ERROR*	$67	OBJECT EXISTS	=	$47 DUPLICATE FILENAME*	$66	OBJECT NOT FOUND	=	$44	FILE NOT FOUND*	$65	PARAMETER ERROR	=	$53	INVALID PARAMETER*	$64	RANGE NOT LOCKED	=	$4D	POSITION OUT OF RANGE*	$63	RANGE OVERLAP	=	$4D	POSITION OUT OF RANGE*	$62	SESSION CLOSED	=	$27	I/O ERROR*	$61	USER NOT AUTH	=	$4E	ACCESS ERROR*	$60	CALL NOT SUPPORTED	=	$01	BAD CALL NUMBER*	$5F	OBJECT TYPE ERROR	=	$44 dir not found*	$5E	TOO MANY FILES OPEN =	$42	MAX NUMB OF OPEN FILES*	$5D	SERVER GOING DOWN	=	$27	I/O ERROR*	$5C	CAN'T RENAME	=	$4E	ACCESS ERROR**;;			eject*** 11) AFP ERROR TABLE (LOWEST BYTE)**		EXPORT	AFP_ERRORAFP_ERROR		;			DC.B	$00	;NO ERROR	DC.B	$78	;ACCESS DENIED	DC.B	$77	;AUTH CONTINUE	DC.B	$76	;BAD UAM	DC.B	$75	;BAD VERSION NUMBER	DC.B	$74	;BITMAP ERROR	DC.B	$73	;CANT MOVE	DC.B	$72	;DENY CONFLICT	DC.B	$71	;DIR NOT EMPTY	DC.B	$70	;DISK FULL	DC.B	$6F	;EOF ERROR	DC.B	$6E	;FILE BUSY	DC.B	$6D	;FLAT VOL	DC.B	$6C	;ITEM NOT FOUND	DC.B	$6B	;LOCK ERROR	DC.B	$6A	;MISC ERROR	DC.B	$69	;NO MORE LOCKS	DC.B	$68	;NO SERVER	DC.B	$67	;OBJECT EXISTS	DC.B	$66	;OBJECT NOT FOUND	DC.B	$65	;PARAMETER ERROR	DC.B	$64	;RANGE NET LOCKED	DC.B	$63	;RANGE OVERLAP	DC.B	$62	;SESSION CLOSED	DC.B	$61	;USER NOT AUTH	DC.B	$60	;CALL NOT SUPPORTED	DC.B	$5F	;OBJECT TYPE ERROR	DC.B	$5E	;TOO MANY FILES OPEN	DC.B	$5D	;SERVER GOING DOWN	DC.B	$5C	;CAN'T RENAME	DC.B	$5B	;directory not found	DC.B	$5A	;Icon Type Error	DC.B	$59	; Volume Locked	DC.B	$58	; Object Locked;	DC.B	$FF	;END OF THE ERROR TABLE;;			eject*** 12) PRODOS ERROR TABLE (TRANSLATED)**		EXPORT	PRODOS_ERRORPRODOS_ERROR		;			DC.B	$00	;NO ERROR	DC.B	$4E	;FILE ACCESS ERROR	DC.B	$27	;I/O ERROR	DC.B	$27	;I/O ERROR	DC.B	$27	;I/O ERROR	DC.B	$53	;INVALID PARAMETER	DC.B	$27	;I/O ERROR	DC.B	$4E	;FILE ACCESS ERROR	DC.B	$4E	;FILE ACCESS ERROR	DC.B	$48	;VOLUME FULL	DC.B	$4C	;END OF FILE	DC.B	$50	;FILE IS OPEN	DC.B	$27	;I/O ERROR	DC.B	$44	;DIRECTORY NOT FOUND	DC.B	$4E	;FILE ACCESS ERROR	DC.B	$27	;I/O ERROR	DC.B	$4E	;I/O ERROR	DC.B	$27	;I/O ERROR	DC.B	$47	;DUPLICATE FILENAME	DC.B	$44	;DIRECTORY NOT FOUND	DC.B	$53	;INVALID PARAMETER	DC.B	$4D	;POSITION OUT OF RANGE	DC.B	$4D	;POSITION OUT OF RANGE	DC.B	$27	;I/O ERROR	DC.B	$4E	;ACCESS ERROR	DC.B	$01	;BAD CALL NUMBER	DC.B	$44	;dir not found	DC.B	$42	;MAX NUMBER OF OPEN FILES	DC.B	$27	;I/O ERROR	DC.B	$4E	;ACCESS ERROR	DC.B	$44	;DIRECTORY NOT FOUND	DC.B	$27	;I /o  Error	DC.B	$4E	; Volume Locked	DC.B	$4E	; Object Locked;	DC.B	$27	;END OF TABLE;;			eject*** 9) STUFF THE ASP COMMAND PARAMETER LIST**	ENTRY : ASP_HEAP1 = HEAP NUMBER FOR ASP HEAP*	CURRSESS	= CURRENT SESSION NUMBER**	EXIT	: ZP1	= POINTER TO ASP PARAMETER LIST**		EXPORT	CMD_STUFFCMD_STUFF		;		** CREATE ASP COMMAND PARAMETER LIST*;			jsr		getzp1parm	;set zp1 to point to parm list area			LDY		#$00			LDA		#00			STA		(ZP1),Y		;SAVE ASYNC FLAG;			INY			LDA		#CMD_ASPCMD			STA		(ZP1),Y		;SAVE COMMAND			ldy		#$08			LDA		CURSESS			STA		(ZP1),Y		;SAVE SESSION REFERENCE #;			INY			LDA		PKT_CNT			STA		(ZP1),Y		;SAVE LB OF CMD LENGTH			INY			LDA		PKT_CNT+1			STA		(ZP1),Y		;SAVE HB OF CMD LENGTH;			INY			LDA		#WS_COMBUF			STA		(ZP1),Y		;SAVE LB OF CMD PTR			INY			LDA		#>WS_COMBUF			STA		(ZP1),Y		;SAVE HB OF CMD PTR			INY			LDA		#^WS_COMBUF			STA		(ZP1),Y			INY			LDA		#$80		;ONCARD BUFFER			STA		(ZP1),Y			RTS;;** update the session Timer **		EXPORT	Update_TMRUpdate_TMR		;					ldx		#$00			lda		CURSESS	;current session			beq		Update_x			;Update_lk	cmp		SESSION_TBL,x			beq		Update_fnd			inx			cpx		#$08			bne		Update_lkUpdate_x	rts					;not Found			;			;** Find the Session's Timer*Update_fnd	txa			asl		a			tax			lda		SESS_TMRTBL,x			sta		ZP1			inx			lda		SESS_TMRTBL,x			sta		ZP1+1** lock out Appletalk*			JSL		>Ramforbid** update time to wait to 240 quarter seconds*			ldy		#$0a			lda		#240			sta		(ZP1),y			iny			lda		#$00			sta		(ZP1),y** is the call done ??*			ldy		#$02			lda		(ZP1),y**  unlock Appletalk interrupts*			jsl		>Rampermit** reissue INstall Timer*			cmp		#$00			bne		Update_exit   ;call is still going			;			php				;save state			rep		#mbit+xbit	;go full 16 bit			longa	on			longi	on			ldx		<ZP1		;get low word of parm			ldy		#^pfibank	;and get bank			jsl		>RamDispatch	;make the call			plp				;recover mode which was 8 bit			longa	off			longi	offUpdate_exit	rts								;								; -----> end								;								ENDP		end