;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	IMPORT	cfiaccess	IMPORT	cfigetsrcpath	IMPORT	cfilist	IMPORT	cfilogcont	IMPORT	cfilogin	IMPORT	cfilogout	IMPORT	cfimount	IMPORT	cfiname	IMPORT	cfinaming	IMPORT	cfitimezone	IMPORT	cfiuserbuf	IMPORT	cFIhooks	Import	CFIXLOGIN	Import  CFIlist2	Import	CFIGETVERS	IMPORT	dispatch_pfi	IMPORT	pfi_init	IMPORT	wsinit	IMPORT	CONVERT_TIME;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	oldreset	ENTRY	ourreset	ENTRY	pfiinit** pfi.asm** 	by*		Greg Seitz*		13-Jul-87** this file is responsible for installing pfi into the command * dispatcher and doing any neccessary initialization stuff*		INCLUDE 'global.equates'		INCLUDE	'zp.equates'		EXPORT	pfinstall	    pfinstall	    PROC	jmp	Realinstall	DC.B	'PFI VERSION 2.01'realinstall		    clc						;force native	    xce	    phb	    phk						;data is in same bank as code	    plb		sep	#mbit+xbit		lda	>statereg		pha						;save machine state		lda	>lcbank2		lda	>lcbank2		;enable lcbank2 for writing	    rep	   #mbit+xbit	    longa	on	    longi	on	    lda	   >softreset		;get the current reset vector	    sta	   oldreset			;and store internally	    lda	   >softreset+2	    sta	   oldreset+2		;now we have the old vector	    lda	   callreset		;store a jml ourreset	    sta	   >softreset		;into vector	    lda	   callreset+2	    sta	   >softreset+2	    lda		jourdispatch	;get the jml to the pdos dispatcher	    sta		>pfivec	    lda		jourdispatch+2	    sta		>pfivec+2	    jsr	   pfiinit			;zero out stuff	    jsr		pfi_init		;do this only once at installation time	    ldx	   #ourcmds			;get our command table	    	ldy	#$d600+($2a*4)	;table starts at $d600	    	lda	#endcmds-ourcmds-1	;move this many bytes		mvn	ourcmds,$e10000	;to bank $e1		sep	#mbit+xbit		pla						;get statereg		sta	>statereg		rep	#mbit+xbit	    	plb	    	rtlcallreset	jml	ourreset		;this code is moved to vectorjourdispatch	jml	>dispatch_pfi		EXPORT	pfiinitpfiinit		;			    jsr		wsinit			;init pfi stuff	    rtsourcmds	; 	DC.A	cfiname	DC.B	pfizplen	DC.A	cfilogin	DC.B	pfizplen	DC.A	cfilogcont	DC.B	pfizplen	DC.A	cfilogout	DC.B	pfizplen	DC.A	cfimount	;$2e	DC.B	pfizplen	DC.A	cfilist		;$2f	DC.B	pfizplen	DC.A	cfitimezone	;$30	DC.B	pfizplen	DC.A	cfigetsrcpath	;$31	DC.B	pfizplen	DC.A	cfiaccess	;$32	DC.B	pfizplen	DC.A	cfinaming	;$33	DC.B	pfizplen	DC.A	CONVERT_Time	;$34 	DC.B	pfizplen	DC.A	0		;$35 - not supported on gs	DC.B	0	DC.A	cfiuserbuf	;$36 - let user have 512 bytes of memory to use 	DC.B	pfizplen	DC.A	cFIhooks	;$37 - hooks for GS/OS	DC.B	pfizplen	dc.A	CFIXLOGIN	;$38 - 'X'tra Special Login (w/ server Name)	DC.B	pfizplen	DC.A	cfilist2	;$39 - ListSessions2	DC.B	pfizplen	dc.a	CFIGETVERS	;$3A - FIGetSVersion	dc.b	pfizplenendcmds	; 		ENTRY	ourreset	;EXPORT -> ENTRY  **TGHourreset		;		;should come here during reset	    php				;save mode bits	    phb				;and databank	    jsl	   oldreset		;let lower protocol get called first	    phk				;set up data bank	    plb	    jsr	   pfiinit		;and re-init pfi	    plb				;restore bank	    plp				;and mode bits	    rtl				;and return to our caller		ENTRY	oldreset	;EXPORT -> ENTRY  **TGHoldreset		;		;this code gets old reset vector	    jml	   $000000		;dummy code		ENDP		end