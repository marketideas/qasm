;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	Import	Active8	IMPORT	ACCESS	IMPORT	AFP	IMPORT	AFP_DIR_ID	IMPORT	AFP_PREFIX	IMPORT	AFP_VOL_ID	IMPORT	ATTRIBUTE	IMPORT	AUN_RAM	IMPORT	B1_AFP2STD	IMPORT	B1_CLK2PRO	IMPORT	B1_CLK2STD	IMPORT	B1_PRO2CLK	IMPORT	B1_STD2AFP	IMPORT	B1_STD2CLK	IMPORT	BUFFMOVE	IMPORT	BYTE_COUNT	IMPORT	CMD_ROUTING	IMPORT	CURSESS	IMPORT	Cn_DEVNUM	IMPORT	Cn_ERROR	IMPORT	Cn_WSIPL	IMPORT	FILE_BLKS	IMPORT	FILE_SIZE	IMPORT	NAME_CNT	IMPORT	NDT_CNT	IMPORT	NDT_IDH	IMPORT	NDT_IDL	IMPORT	NDT_IDX1	IMPORT	NDT_IDX2	IMPORT	NDT_NAME	IMPORT	NDT_SESS	IMPORT	NDT_UNIT	IMPORT	OFFSPRING	IMPORT	PFI_BANK	IMPORT	PFI_NAMING	IMPORT	PKT_CNT	IMPORT	PRO_DIR_ID	IMPORT	PRO_PREFIX	IMPORT	PRO_TIME	IMPORT	PRO_VOL_ID	IMPORT	REMAINDER	IMPORT	SRCPATH	IMPORT	UDIRID1	IMPORT	UDIRID2	IMPORT	UDIRID3	IMPORT	UDIRID4	IMPORT	UERROR	IMPORT	UFILEIDX	IMPORT	UMODE	IMPORT	USRVNUM1	IMPORT	USRVNUM2	IMPORT	UTYPE	IMPORT	UVOLID1	IMPORT	UVOLID2	IMPORT	UWORK1	IMPORT	UWORK2	IMPORT	VOL_LEN	IMPORT	WS_COMBUF	IMPORT	WS_PATH	IMPORT	WS_PLIST	IMPORT	WS_PREPATH	IMPORT	cn_cmdpdos;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	CHGMBPLREF	ENTRY	CHKDBL	ENTRY	CHKSLASH	ENTRY	DO_JSRLOCAL	ENTRY	LOCAL	ENTRY	xpath2card** pfi_cmdsubs3** Greg Seitz (17-Jul-87)**;		EXPORT	zpcmdscs3	;zpcmdscs3	PROC		INCLUDE	'zp.equates';		ENDP		include	'global.equates'		include	'pfi_equates'				EXPORT	pficmdsubs3	pficmdsubs3	PROC*		using	atpequates*		using 	pfiglobals*		using	zpcmdscs3			longa	off			longi	off			eject**	PARAMIS NETWORK SOFTWARE****	CONFIDENTIAL*** MODULE : PFI3 - PRODOS FILING INTERFACE	(PART 3)*	COMMON SUBROUTINES**	WRITTEN BY THOMAS EAGER**	MODIFIED:	06-15-87	4:18	TE**	COPYRIGHT 1986,87 PARAMIS CORPORATION** ALL RIGHTS RESERVED****	COMMON SUBROUTINES :** A: LOCAL PRODOS SUBROUTINES**	1) LOCALREF	- EXECUTE A LOCAL CALL WITH REF #*	2) LOCAL	- EXECUTE A LOCAL CALL (PL OK)*	3) CHGMBPLREF	- CHANGE MB PL REFERENCE #*	4) DO_JSRLOCAL - CAUSE MB TO DO A LOCAL PRODOS CALL*** B: PATHNAME SUBROUTINES**	5) PATH2BUF	- MOVE PATHNAME INTO PACKET*	6) PATH2CARD	- MOVE PATHNAME ONTO CARD*	7) CHKSLASH	- IS THE FIRST CHARACTER A SLASH ?*	8) CHK_VOLUME	- IS THE PATHNAME A VOLUME ONLY ?*	9) FND_CURSRV	- FIND THE VOLUME IN THE NDT TABLES*	10) STUFF_IDS	- STUFF PATHNAME IDS IN PACKET*	11) STUFF_DIRIDS - STUFF DIRECTORY IDS FOR OPEN DIRECTORY*	12) NEW_PREFIX	- SAVE NEW PREFIX*	13) NEW_SRCPATH	- SAVE PATH OF LAST OPENDED FILE*	14) CHK_PRODOS	- CHECK PRODOS FORMAT*	15) STUFF_FINDER - STUFF THE FINDER WITH FILE TYPE/CREATER*	16) PDOS_BITMAP	- SET/CLEAR PRODOS SYSTEM BITMAP*	17) CHK_BITMAP	- CHECK PRODOS SYSTEM BITMAP*	18) STRIP_PREFIX - STRIP PREFIX FROM PATHNAME**** C: CONVERSION SUBROUTINES**	19) INTO_ATTRI	- CHANGES ACCESS INTO ATTRIBUTES*	20) FROM_ATTRI	- CHANGES ATTRIBUTES INTO ACCESS*	21) CALC_DIRINFO- CALCULATES BLOCKS/BYTES OF A DIRECTORY*	22) BYTE2BLKS	- CONVERTS # OF BYTES INTO BLOCKS*	23) INTO_SEC	- CHANGES PRODOS TIME INTO AFP TIME*	24) FROM_SEC	- CHANGES AFP TIME INTO PRODOS TIME*** D: END OF FILE SUBROUTINES** 25) FILE_GETEOF	- GET THE END OF FILE FOR A FILE* 26) DIR_GETEOF	- GET THE END OF FILE FOR A DIRECTORY***			eject***	1) EXECUTE A LOCAL CALL WITH REF # - LOCALREF** SPECIAL LOCAL CALLS. SINCE THESE CALLS USE A* REFERENCE NUMBER WE MUST SWITCH IN THE REAL PRODOS REF #,* LET LOCAL PRODOS EXECUTE THE CALL WITH THEIR PARAMETER LIST,* COPY THE UPDATED PARAMETER LIST ONTO THE CARD, RESTORE* OUR REFERENCE NUMBER INTO THEIR PARAMETER LIST.***	ENTRY : WS_PLIST = PARAMETER LIST ON CARD*	UFILEIDX = INDEX TO CROSS REFERENCE - REF #**	EXIT	: UERROR	= LOCAL PRODOS ERROR CODE**		EXPORT	LOCALREFLOCALREF		;		** SAVE PL REF # , REPLACE IT WITH REAL PRODOS REF #*			LDA		WS_PLIST+1			STA		UWORK1		;SAVE REF #;			LDX		UFILEIDX			LDA		USRVNUM1,X	;GET ACTUAL REF #			STA		WS_PLIST+1	;AND PUT IN LIST			JSR		CHGMBPLREF	;CHANGE MB REF #** EXECUTE A LOCAL PRODOS CALL*			JSR		LOCAL		;EXECUTE CALL** RESTORE REFERENCE # TO PL*			LDA		UWORK1		;RESTORE REF #			STA		WS_PLIST+1			JSR		CHGMBPLREF	;RESTORE MB'S ORIG REF #			RTS;;			eject***	2) EXECUTE LOCAL CALL - LOCAL*	(PARAMETER LIST IS OK- NO MODIFCATIONS)**	ENTRY : NONE**	EXIT	: UERROR - LOCAL PRODOS ERROR CODE**		EXPORT	LOCALLOCAL		;		** DIRECT MOTHERBOARD TO LOCAL PRODOS,* USING THEIR OWN PARAMETER LIST*			JSR		DO_JSRLOCAL			LDA		Cn_ERROR			STA		UERROR			RTS;;			eject*** 3) CHANGE REF # ON MOTHERBOARD'S PARAMETER LIST**	ENTRY : WS_PLIST = PARAMETER LIST ON CARD*	Cn_WSIPL = PARAMETER LIST ON MB**	EXIT	: Cn_WSIPL = UPDATED MB PL**		EXPORT	CHGMBPLREFCHGMBPLREF		;		** MOVE 2 BYTES (PCOUNT & REF #)*			LDA		#2			STA		<COUNT			LDA		#00						STA		<COUNT+1** SET FROM LOCATION TO ONCARD PL*			LDA		#WS_PLIST	;SOURCE			STA		<SRCBUF			LDA		#>WS_PLIST			STA		<SRCBUF+1			LDA		#^WS_PLIST			STA		<SRCBUF+2** SET TO LOCATION TO MB PL*			LDA		Cn_WSIPL	;DEST			STA		<DESTBUF			LDA		Cn_WSIPL+1			STA		<DESTBUF+1;			LDA		PFI_BANK			STA		<DESTBUF+2	;BANK** MOVE THE TWO BYTES*			JMP		BUFFMOVE;;			eject*** 4) CAUSE MB TO JSR TO LOCAL PRODOS*****	ENTRY : NONE**	EXIT	: NONE**		EXPORT	DO_JSRLOCALDO_JSRLOCAL		;		** SET WHERE VECTOR WITH JSR TO LOCAL PRODOS*exitvector	equ		$BFA0MLIACTIVE	equ		$00BF9B			jsr		savecdzp		;save off zero page			jsr		movecode		;move code to zp			phb						;save data bank			pea		$0000			plb			plb						;set bank zero			sec						; needs to be set for switch to emulation mode			jsl		>cdzpbase		;jump to code			plb						;recover our bank			sta		cn_error		;save error code returned			jsr		restorecdzp		;and put back zp			RTS					;savecdzp	; 			lda		#<cdzpbase			sta		<srcbuf			lda		#>cdzpbase			sta		<srcbuf+1			lda		pfi_bank			sta		<srcbuf+2			ldy		#zpcdlen	;length of code to movesavecdlp	; 			lda		[srcbuf],y			sta		savezparea,y			dey			bpl		savecdlp			lda		#<exitvector			sta		<srcbuf			lda		#>exitvector			sta		<srcbuf+1			lda		pfi_bank			sta		<srcbuf+2			ldy		#3			;length of code to movesaveexit	; 			lda		[srcbuf],y			sta		oldexitcode,y			dey			bpl		saveexit			rtsrestorecdzp	; 			lda		#<cdzpbase			sta		<srcbuf			lda		#>cdzpbase			sta		<srcbuf+1			lda		pfi_bank			sta		<srcbuf+2			ldy		#zpcdlenrscdlp	; 			lda		savezparea,y			sta		[srcbuf],y			dey			bpl		rscdlp			rtsmovecode	; 			lda		>ProEntry			;get pointer to interal pdos			inc		a			sta		realpdos+1			lda		>ProEntry+1			;get high byte			sta		realpdos+2			;don't worry about inc wrap			lda		cn_cmdpdos			;pointer to pdos parms (cmd and addr)			sta		<srcbuf			lda		cn_cmdpdos+1			sta		<srcbuf+1			lda		pfi_bank			sta		<srcbuf+2			ldy		#2mvcdlp	; 			lda		[srcbuf],y			sta		realpdos+3,y			dey			bpl		mvcdlp			lda		#<cdzpbase			sta		<srcbuf			lda		#>cdzpbase			sta		<srcbuf+1			lda		pfi_bank			sta		<srcbuf+2			ldy		#zpcdlenmvcdlp1	; 			lda		zpcode,y			sta		[srcbuf],y			dey			bpl		mvcdlp1			lda		realcmd			cmp		#$65			;Is is a quit call?			beq		mvleave			;If so, don't move exit code									;because it will never be called.			lda		#<exitvector			sta		<srcbuf			lda		#>exitvector			sta		<srcbuf+1			lda		pfi_bank			sta		<srcbuf+2			ldy		#3			;length of code to movemvexit	; 			lda		newexitcode,y			sta		[srcbuf],y			dey			bpl		mvexitmvleave		rtszpcode	; ;this code will execute out of zp			xce					;Assumes that the carry is set !!!realpdos	jsr		$bf00		;direct address will be put hererealcmd		DC.B	0			DC.W	0			;these will be set to real value laterretoffset	equ		*-zpcode			clc			xce					;back to native mode			rtlzpcdlen		equ		*-zpcodesavezparea		DS.B zpcdlen+1	;area to move zpexitcode	;			pha			lda		>MLIACTIVE			ora		#$80			sta		>MLIACTIVE			lda		#<cdzpbase+retoffset			sta		4,s			lda		#>cdzpbase			sta		5,s			phx			ldx		#3			;length of code to moverestexit	lda		>oldexitcode,x			sta		>exitvector,x			dex			bpl		restexit			plx			pla			jmp		>exitvectornewexitcode	jmp		>exitcodeoldexitcode	ds.l	1			eject*** 5) MOVE PATHNAME FROM USER'S BUFFER TO WS_COMBUF**	ENTRY:	X	= POSITION TO PLACE NAME IN WS_COMBUF*	WS_PATH = LOACTION OF PATHNAME*	CARRY	= PADDING FLAG (SEC - YES)**	EXIT :	PKT_CNT = AMOUNT OF DATA IN WS_COMBUF (2 BYTES)**		EXPORT	PATH2BUFPATH2BUF		;		** SAVE CARRY	(PADDING FLAG)*			PHP			lda		#00			;zero out high byte of a, since we might do 8 bit a to 16 bit x xfer			xba** SAVE PATHNAME TYPE (LONG NAME)*			LDA		#$02			STA		WS_COMBUF,X			INX			PHX					;SAVE OFFSET IN PACKET** IS THE FIRST CHARACTER A SLASH ?*			JSR		CHKSLASH			BCS		PATH2B1A** MOVE COUNT BYTE AND SAVE IT*			LDA		WS_PATH			STA		UWORK1			lda		#01			;move 1 into y without switching modes (always 8 bit a, but			tay					;can be 8 or 16 bit x) and move it 			BRA		PATH2B1B	;MOVE NAME** REMOVE VOLUME NAME FROM PATH*PATH2B1A	; 			CLC			LDA		#NDT_NAME			ADC		NDT_IDX1			STA		<ZP2			LDA		#>NDT_NAME			ADC		NDT_IDX1+1			STA		<ZP2+1;			SEC			LDA		WS_PATH			SBC		(ZP2)			TAX			DEX					;REMOVE SLASH BEFORE VOLUME			BEQ		PATH2B1AA	;ONLY VOLUME			DEX					;REMOVE SLASH AFTER VOLUMEPATH2B1AA	; 			STX		UWORK1;			CLC			LDA		(ZP2)		;LENGTH OF VOLUME			ADC		#$03		;ADD LENGTH BYTE			TAY					;ADD SLASH BEFORE VOLUME								;ADD SLASH AFTER VOLUME** SAVE LENGTH OF PATH*PATH2B1B	; 			PLX					;RESTORE INDEX TO PACKET			LDA		UWORK1		;LENGTH OF PATH			STA		WS_COMBUF,X			BEQ		PATH2B3		;END OF MOVE			PHX					;SAVE IN CASE LAST CHARACTER IS A SLASH			INX** MOVE THE NAME*PATH2B1	; 			LDA		WS_PATH,Y			CMP		#SLASH			BNE		PATH2B2			LDA		#SRVR_SLASH	;CHANGE DELIMITER FOR SERVERPATH2B2	; 			STA		WS_COMBUF,X			INX			INY			DEC		UWORK1			BNE		PATH2B1			DEX** IS THE LAST CHARACTER A SLASH*			PLY					;RESTORE INDEX TO NAME			CMP		#SRVR_SLASH			BNE		PATH2B3		;NO IT IS NOT A SLASH;			SEC			LDA		WS_COMBUF,Y			SBC		#$01			STA		WS_COMBUF,Y			DEX** SAVE END OF NAME*PATH2B3	; 			INX			STX		PKT_CNT			STZ		PKT_CNT+1** RESTORE PADDING FLAG*			PLP			BCC		PATH2B4		;NO NEED TO PAD;			LDA		PKT_CNT			AND		#%00000001	;ODD ??			BEQ		PATH2B4		;NO PADDING NEEDED;			LDX		PKT_CNT			STZ		WS_COMBUF,X			INX			STX		PKT_CNTPATH2B4	; 			RTS;;			eject*** 6) MOVE PATHNAME FROM MOTHER BOARD TO CARD BUFFER**	ENTRY : NONE**	EXIT	: WS_PATH = LOCATION OF PATHNAME ON CARD*	C	= SET MEANS THAT PATH IS TOO LONG**		EXPORT	PATH2CARDPATH2CARD		;					ldx		#01				;default case of first item			jmp		xpath2card		EXPORT	xpath2cardxpath2card		;		;alternate entry if you want to specify x** FIND LOCATION OF NAME ON MOTHERBOARD*			LDA		WS_PLIST,x			STA		<SRCBUF			LDA		WS_PLIST+1,x			STA		<SRCBUF+1;			LDA		PFI_BANK			STA		<SRCBUF+2	;BANK** SAVE LOCATION TO PLACE NAME ON CARD*			LDA		#WS_PATH			STA		<DESTBUF			LDA		#>WS_PATH			STA		<DESTBUF+1			LDA		#^WS_PATH			STA		<DESTBUF+2** MOVE MAX NAME POSSIBLE*			LDA		#MAX_AFPPATH			STA		<COUNT			LDA		#00				STA		<COUNT+1** EXECUTE MOVE OF NAME*			JSR		BUFFMOVE** check for double slash in pathname*			JSR		CHKDBL			BCC		p2_CHKLEN			RTS					;carry set mean Error** CHECK LENGTH OF PATHNAME*p2_CHKLEN	LDA		WS_PATH			CMP		#MAX_AFPPATH-1			RTS					;CARRY SET MEAN UNACCEPTABLE !!;CARRY CLC MEANS OK !!!;			eject***	7) CHECK FOR A SLASH IN THE FIRST POSTION OF THE PATHNAME**	ENTRY : WS_PATH = LOCATION WHERE PATHNAME IS LOCATED**	EXIT	: C	= CLEAR MEANS NOT A VOLUME**		EXPORT	CHKSLASHCHKSLASH		;		** LOOK AT THE FIRST CHARACETER OF THE NAME*			LDA		WS_PATH+1			AND		#$7F		;(BACIC_CI SETS HI BIT OF SLASH CHAR)			CMP		#SLASH			BEQ		CHKSLASH1			CLC			RTS** THE FIRST CHARACTER IS A SLASH !!!* THIS IS A VOLUME*CHKSLASH1	; 			SEC			RTS;;			eject***	8) CHECK TO SEE IF PATHNAME IS A VOLUME**	ENTRY : WS_PATH	= LOCATION WHERE PATHNAME IS LOCATED**	EXIT	: C	= CLEAR MEANS NOT A VOLUME**		EXPORT	CHK_VOLUMECHK_VOLUME		;		** IS THERE MORE THAN ONE CHARACTER ?*			LDA		WS_PATH			CMP		#$02			BCS		CHK_VOL0			RTS** IS THE FIRST CHARACTER A SLASH ?*CHK_VOL0	; 			JSR		CHKSLASH			BCS		CHKVOL1			RTS					;NOT A VOLUME** FIND LENGTH OF PATHNAME*CHKVOL1	; 			LDX		#$02CHKVOL2	; 			LDA		WS_PATH,X			AND		#$7F		;(BACIC.CI SETS HI BIT OF SLASH CHAR)			CMP		#SLASH			BEQ		CHKVOL3		;NOT A VOLUME (BUT A DIRECTORY)			INX			CPX		WS_PATH		;NOTE: DONT CHECK LAST CHARACTER !!!			BNE		CHKVOL2		;MORE TO LOOK AT;			SEC					;PATH WAS A VOLUME			RTS** THE PATHNAME IS NOT A SERVER VOLUME ONLY !!!*CHKVOL3	; 			CLC			RTS;;			eject***	9) FIND VOLUME FOR CURRENT SERVER IN NDT**	ENTRY : NDT_NAME	= LIST OF MOUNTED VOLUMES*	WS_PATH	= LOCATION OF PATHNAME**	EXIT	: C	= SET MEANS VOLUME NOT FOUND*	NDT_IDX1	= INDEX TO NDT_NAME*	NDT_IDX2	= INDEX TO NDT OTHER**		EXPORT	FND_CURSRVFND_CURSRV		;		** IS THIS THE END OF THE NETWORK DEVICE TABLE ?*			LDA		#<NDT_NAME			STA		<ZP2			LDA		#>NDT_NAME			STA		<ZP2+1;			LDX		#$00FND_SRV0	STX		NDT_IDX2			CPX		#14			BNE		FND_SRV0A	;NO,STILL MORE RECORDS TO PROCESS			SEC			RTS					;VOLUME NOT ON SERVER !!!!!** IS THIS ENTRY ACTIVE ?*FND_SRV0A	; 			LDA		NDT_SESS,X			BEQ		NXT_VOL		;NOT ,ACTIVE** IS DESIRED VOLUME AT LEAST LONG ENOUGHT ? (TEST #1)*			LDA		(ZP2)			STA		VOL_LEN	 	;TRUE LENGTH OF VOLUME			INC		VOL_LEN	 	;OFFSET LENGTH TO INCLUDE SLASH*			LDA		WS_PATH			CMP		VOL_LEN			BCC		NXT_VOL	 	;FLUNK TEST #1- TRY NEXT VOLUME** DO THE VOLUMES HAVE THE SAME NAME ? (TEST #2)*			LDY		#$01		;INITIALIZE TO THE FIRST BYTEFND_SRV1	LDA		WS_PATH+1,Y			CMP		(ZP2),Y			BEQ		FND_SRV1D	;MOVE TO NEXT CHARACTER;** IF IN AFP MODE, IS HI BIT SET?*			BIT		PFI_NAMING			BPL		FND_SRV1A;			LDA		WS_PATH+1,Y	;IS HI BIT SET			BMI		NXT_VOL		;NOT INSENSITIVE** CONVERT TO UPPER CASE*FND_SRV1A	; 			CMP		#$61			BCC		FND_SRV1B	;TEST CHARACTER			AND		#$5F;FND_SRV1B	; 			CMP		#$41		;IS IT LT 'A' ?			BCC		NXT_VOL		;NO,FLUNK TEST #2 - NEXT VOLUME			CMP		#$5B		;IS IT GT 'Z' ?			BCS		NXT_VOL		;NO,FLUNK TEST #2 - NEXT VOLUME*			LDA		WS_PATH+1,Y	;CHECK CASE INSENSITIVE			EOR		#$20			CMP		(ZP2),Y			BNE		NXT_VOL		;NO,FLUNK TEST #2 - NEXT VOLUME*FND_SRV1D	; 			INY			CPY		VOL_LEN		;END OF NAME ???			BNE		FND_SRV1	;NO NOT YET** IS THE NEXT CHARACTER A SLASH ? (TEST #3)*			LDA		WS_PATH+1,Y			CMP		#SLASH			BEQ		FND_SRV2	 ;PASSED ALL OF THE TEST !!!!!** ARE BOTH THE SAME LENGTH ? (TEST #4)*			LDA		VOL_LEN			CMP		WS_PATH			BNE		NXT_VOL		;FLUNK TEST #4 - TRY NEXT VOLUME** ALL TEST PASSED - VOLUME IS ON A SERVER !!!!!!!*FND_SRV2	; 			LDX		NDT_IDX2			LDA		NDT_UNIT,X	;FIND DEVICE			AND		#%11110000	;strip low nibble			STA		Cn_DEVNUM	;TELL PRODOS ABOUT LAST DEVICE ACCESSED*			LDA		NDT_SESS,X	;X POINTS TO THE SESSION NUMBER			STA		CURSESS;			SEC			LDA		<ZP2			SBC		#<NDT_NAME			STA		NDT_IDX1			LDA		<ZP2+1			SBC		#>NDT_NAME			STA		NDT_IDX1+1;			CLC			RTS** TRY NEXT VOLUME*NXT_VOL	; 			CLC			LDA		<ZP2			ADC		#NDT_NAMELEN			STA		<ZP2			LDA		<ZP2+1			ADC		#$00			STA		<ZP2+1								;			LDX		NDT_IDX2			INX			JMP		FND_SRV0;;			eject*** 10) STUFF THE VOLUME AND DIRECTORY IDS FVOR AFP PACKET**	ENTRY : WS_PATH	= LOCATION OF PATHNAME*	..._VOL_ID = PREFIX VOLUME ID*	..._DIR_ID = PREFIX DIRECTORY ID**	EXIT	: WS_COMBUF = VOL & DIR ID IN PACKET**		EXPORT	STUFF_IDSSTUFF_IDS		;		** IS THE VOLUME SPECIFIED IN PATH ?*			JSR		CHKSLASH			BCC		STUFFIDS1	;NO, IT IS NOT SPECIFIED** USE NDT TABLE TO FIND VOLUME ID & USE DEFAULT DIR ID*			LDX		NDT_IDX2			LDA		NDT_IDH,X			STA		WS_COMBUF+2	;SAVE VOLUME ID - HB			LDA		NDT_IDL,X			STA		WS_COMBUF+3	;SAVE VOLUME ID - LB;			STZ		WS_COMBUF+4			STZ		WS_COMBUF+5			STZ		WS_COMBUF+6			LDA		#$02		;DEFAULT DIR ID			STA		WS_COMBUF+7			RTS** USE PREFIX VOL ID AND DIR ID*STUFFIDS1	; 			BIT		PFI_NAMING			BMI		STUFFIDS3	;AFP PREFIX;			LDA		PRO_VOL_ID			STA		WS_COMBUF+2	;SAVE VOLUME ID - HB			LDA		PRO_VOL_ID+1			STA		WS_COMBUF+3	;SAVE VOLUME ID - LB;			LDX		#$03STUFFIDS2	; 			LDA		PRO_DIR_ID,X			STA		WS_COMBUF+4,X			DEX			BPL		STUFFIDS2	;MORE DIR ID TO MOVE			RTS*STUFFIDS3	; 			LDA		AFP_VOL_ID			STA		WS_COMBUF+2	;SAVE VOLUME ID - HB			LDA		AFP_VOL_ID+1			STA		WS_COMBUF+3	;SAVE VOLUME ID - LB;			LDX		#$03STUFFIDS4	; 			LDA		AFP_DIR_ID,X			STA		WS_COMBUF+4,X			DEX			BPL		STUFFIDS4	;MORE DIR ID TO MOVE			RTS;;			eject*** 11) STUFF THE DIRECTORY IDS ('FOR A OPEN DIRECTORY')**	ENTRY : UFILEIDX = OFFSET TO USER'S TABLES*	UVOLID?	= VOLUME ID*	UDIRID?	= DIRECTORY ID**		EXPORT	STUFF_DIRIDSSTUFF_DIRIDS		;					LDX		UFILEIDX** STUFF VOLUME IDS*			LDA		UVOLID1,X			STA		WS_COMBUF+2	;SAVE VOLUME ID - HB			LDA		UVOLID2,X			STA		WS_COMBUF+3	;SAVE VOLUME ID - LB** STUFF DIRECTORY IDS*			LDA		UDIRID1,X			STA		WS_COMBUF+4	;SAVE DIRECTORY ID (1)			LDA		UDIRID2,X			STA		WS_COMBUF+5	;SAVE DIRECTORY ID (2)			LDA		UDIRID3,X			STA		WS_COMBUF+6	;SAVE DIRECTORY ID (3)			LDA		UDIRID4,X			STA		WS_COMBUF+7	;SAVE DIRECTORY ID (4)			RTS;;			eject*** 12) SAVE PREFIX IN PREFIX BUFFER**	ENTRY : WS_PATH	= PATHNAME*	..._PREFIX = CURRENT PREFIX**	EXIT	: ..._PREFIX = NEW PREFIX**		EXPORT	NEW_PREFIXNEW_PREFIX		;		** IS A VOLUME SPECIFIED ?*			JSR		CHKSLASH	;IS A VOLUME HERE ?			BCS		NEW_PREFIX2	;SLASH, REPLACE CURRENT PREFIX** APPEND CURRENT PREFIX + PATHNAME* FIND LENGTH OF NEW PREFIX*			BIT		PFI_NAMING			BMI		NEW_PREFIX1A;			CLC			LDA		PRO_PREFIX			ADC		WS_PATH			STA		PRO_PREFIX;			LDY		WS_PATH		;APPEND NEW PATH ONTO PREFIX			LDX		PRO_PREFIXNEW_PREFIX1	; 			LDA		WS_PATH,Y			STA		PRO_PREFIX,X			DEX			DEY			BNE		NEW_PREFIX1	;MORE TO MORE			BRA		NEW_PREFIX4	;CHECK LAST CHARACTER;NEW_PREFIX1A	; 			CLC			LDA		AFP_PREFIX			ADC		WS_PATH			STA		AFP_PREFIX;			LDY		WS_PATH		;APPEND NEW PATH ONTO PREFIX			LDX		AFP_PREFIXNEW_PREFIX1B	; 			LDA		WS_PATH,Y			STA		AFP_PREFIX,X			DEX			DEY			BNE		NEW_PREFIX1B	;MORE TO MORE			BRA		NEW_PREFIX6	;CHECK LAST CHARACTER** REPLACE CURRENT PREFIX WITH PATH*NEW_PREFIX2	; 			BIT		PFI_NAMING			BMI		NEW_PREFIX3A;			LDX		WS_PATH		;MOVE NEW PATH AS PREFIXNEW_PREFIX3	; 			LDA		WS_PATH,X			STA		PRO_PREFIX,X			DEX			BPL		NEW_PREFIX3	;MORE TO MOVE			BRA		NEW_PREFIX4;NEW_PREFIX3A	; 			LDX		WS_PATH		;MOVE NEW PATH AS PREFIXNEW_PREFIX3B	; 			LDA		WS_PATH,X			STA		AFP_PREFIX,X			DEX			BPL		NEW_PREFIX3B	;MORE TO MOVE			BRA		NEW_PREFIX6	;AFP CHECK** MAKE SURE LAST CHARACTER IS A SERVER SLASH*NEW_PREFIX4	; 			LDX		PRO_PREFIX			LDA		PRO_PREFIX,X			AND		#$7F		;STRIP OFF HIGH BIT			CMP		#$2F		;SLASH			BEQ		NEW_PREFIX5	;NO IT IS NOT;;			INX			INC		PRO_PREFIX	;ADD ONE TO LENGTH			LDA		#SLASH			STA		PRO_PREFIX,XNEW_PREFIX5	; 			RTS;;NEW_PREFIX6	; 			LDX		AFP_PREFIX			LDA		AFP_PREFIX,X			CMP		#$2F		;SLASH			BEQ		NEW_PREFIX7	;NO IT IS NOT;			INX			INC		AFP_PREFIX	;ADD ONE TO LENGTH			LDA		#SLASH			STA		AFP_PREFIX,XNEW_PREFIX7	; 			RTS;;			eject*** 13) SAVE PATH AS SOURCE PATH FOR OPEN FILE**	ENTRY : WS_PATH	= PATHNAME*	..._PREFIX = CURRENT PREFIX**	EXIT	: SRCPATH	= NEW SRCPATH**		EXPORT	NEW_SRCPATHNEW_SRCPATH		;		** IS A VOLUME SPECIFIED ?*			JSR		CHKSLASH	;IS A VOLUME HERE ?			BCS		NEWSRCPTH3	;SLASH, REPLACE CURRENT SRCPATH** APPEND -- SRCPATH = CURRENT PREFIX + PATHNAME* 1) MOVE CURRENT PREFIX	2) MOVE PATHNAME*			BIT		PFI_NAMING			BMI		NEWSRCPTH2A	; AFP PREFIX;			LDX		PRO_PREFIX			BEQ		NEWSRCPTH1A	;NO PREFIXNEWSRCPTH1	; 			LDA		PRO_PREFIX,X			STA		SRCPATH,X			DEX			BPL		NEWSRCPTH1	;MORE TO MORE;NEWSRCPTH1A	; 			LDY		#00			LDX		PRO_PREFIXNEWSRCPTH2	; 			INX			INY			LDA		WS_PATH,Y			STA		SRCPATH,X			CPY		WS_PATH			BNE		NEWSRCPTH2	;MORE TO MOVE;			CLC			LDA		PRO_PREFIX			ADC		WS_PATH			STA		SRCPATH		;UPDATE LENGTH OF SRCPATH			RTS;;NEWSRCPTH2A	; 			LDX		AFP_PREFIX			BEQ		NEWSRCPTH2C	;NO PREFIXNEWSRCPTH2B	; 			LDA		AFP_PREFIX,X			STA		SRCPATH,X			DEX			BPL		NEWSRCPTH2B	;MORE TO MORE;NEWSRCPTH2C	; 			LDY		#00			LDX		AFP_PREFIXNEWSRCPTH2D	; 			INX			INY			LDA		WS_PATH,Y			STA		SRCPATH,X			CPY		WS_PATH			BNE		NEWSRCPTH2D	;MORE TO MOVE;			CLC			LDA		AFP_PREFIX			ADC		WS_PATH			STA		SRCPATH		;UPDATE LENGTH OF SRCPATH			RTS** SRCPATH IS ONLY PATHNAME (NO PREFIX)*NEWSRCPTH3	; 			LDX		WS_PATH		;MOVE NEW PATH AS PREFIXNEWSRCPTH4	; 			LDA		WS_PATH,X			STA		SRCPATH,X			DEX			BPL		NEWSRCPTH4	;MORE TO MOVE			RTS;;			eject***	14) CHK_PRODOS	- CHECK PRODOS FORMAT*** ENTRY : WS_PATH	= PATHNAME TO BE EXAMINES** EXIT	: CARRY SET MEAN UNACCEPTABLE**		EXPORT	CHK_PRODOSCHK_PRODOS		;		** IS THE LENGTH ACCEPTABLE ?*			LDA		WS_PATH			BEQ		BAD_PRODOS			CMP		#$41			BCS		BAD_PRODOS** INITIALIZE NAME COUNT*			LDA		#$FF			STA		NAME_CNT			LDX		#$01		;OFFSET IN NAME** GET NEXT CHARACTER*CHK_PRODOS1	; 			LDA		WS_PATH,X			AND		#%01111111	;'STRIP OFF HIGH BIT'			CMP		#$2F		;DELIMITER ?			BNE		CHK_PRODOS2	;NO IT IS SOMETHING ELSE;			LDY		NAME_CNT	;CHECK SEGMENTS LENGTH			CPY		#$FF		;FIRST CHARACTER ?			BEQ		CHK_PRODOS4			CPY		#$10			BCS		BAD_PRODOS;			LDA		#$FF			STA		NAME_CNT;			LDA		#$2F		;IT WAS A SLASH !!!!			BRA		CHK_PRODOS4	;SAVE CHARACTER** CONVERT TO UPPER CASE*CHK_PRODOS2	; 			CMP		#$61			BCC		CHK_PRODOS3	;SAVE CHARACTER			AND		#$5F** IS THIS THE FIRST CHARACTER ?*CHK_PRODOS3	; 			INC		NAME_CNT	;ONE MORE CHARACTER IN NAME			BNE		CHK_PRODOS3A			INC		NAME_CNT			BRA		CHK_PRODOS3B	;CHECK FOR ALPHA ONLY;** IT IS A '.' AND A NUMBER ?*CHK_PRODOS3A	; 			CMP		#$2E			BEQ		CHK_PRODOS4	;IT WAS A '.'			CMP		#$30			BCC		BAD_PRODOS			CMP		#$3A			BCC		CHK_PRODOS4	;IT WAS A NUMBER** IT IS A LETTER ?*CHK_PRODOS3B	; 			CMP		#$41			BCC		BAD_PRODOS			CMP		#$5B			BCS		BAD_PRODOS** SAVE THE MODIFED CHARACTER*CHK_PRODOS4	; 			STA		WS_PATH,X** ARE THERE MORE CHARACTERS TO PROCESS ?*			CPX		WS_PATH			BEQ		CHK_PRODOS5			INX			BRA		CHK_PRODOS1	;LOOK AT NEXT CHARACTER** IS THE LAST SEGMENT SHORT ENOUGTH ?*CHK_PRODOS5	; 			LDY		NAME_CNT	;CHECK SEGMENTS LENGTH			CPY		#$FF		;LAST CHARACTER A SLASH ??			BEQ		cp_CLEAR;			CPY		#$10		;OVERSIZE ??			BCS		BAD_PRODOS;cp_CLEAR	CLC			RTS					;CARRY CLEARED - NO PROBLEMS;;** UNACCEPTABLE PRODOS NAME*BAD_PRODOS	; 			SEC			RTS			eject***	15) STUFF_FINDER - STUFF THE FINDER WITH FILE TYPE/CREATER*** ENTRY : WS_COMBUF = PACKET BUFFER*	WS_PLIST	= WORKSTATION PARAMETER LIST*	X	= NEXT BYTE TO BE USED** EXIT	: NONE**		EXPORT	STUFF_FINDERSTUFF_FINDER		;						RTS			eject***	16) PDOS_BITMAP - SET/CLEAR PRODOS SYSTEM BITMAP*** ENTRY : X = HB OF IO BUFFER*	C = SET/CLEAR BITMAP FLAG** EXIT	: NONE**		EXPORT	PDOS_BITMAPPDOS_BITMAP		;		** SAVE CARRY AND HB OF IO BUFFER*			LDA		#$00			ROL		a					;MOVE CARRY INTO [A]			STA		REMAINDER;			TXA			STA		UWORK1			AND		#%00000111			STA		UWORK2		;SAVE BIT OFFSET			LSR		UWORK1			LSR		UWORK1			LSR		UWORK1		;SAVE BYTE OFFSET** is there a local ProDOS ??*			lda		Active8			bne  	pb_Cont			clc			rts** IS THIS A SET OR A CLEAR OF THE BITMAP ???*pb_CONT		LDA		REMAINDER			BEQ		pb_CLEARBITS** SET THE BIT IN THE BITMAP*			LDA		#$04			STA		PKT_CNT		;SHOULD SET ALL FOUR BITS			LDY		UWORK1			LDX		UWORK2;pb_SETBIT1	LDA		WS_PREPATH,Y			ORA		SET_BITS,X			STA		WS_PREPATH,Y;			INX			CPX		#$08		;WRAP AROUND			BNE		pb_SETBIT2	;OK			LDX		#$00			INY					;MOVE TO NEXT BIT;pb_SETBIT2	LDA		PKT_CNT			DEC		a			STA		PKT_CNT			BNE		pb_SETBIT1			BRA		pb_RETURN_BITS;;** CLEAR THE BIT MAP*pb_CLEARBITS	LDA		#$04			STA		PKT_CNT		;SHOULD CLEAR ALL FOUR BITS			LDY		UWORK1			LDX		UWORK2;pb_CLEBIT2	LDA		WS_PREPATH,Y			AND		CLEAR_BITS,X			STA		WS_PREPATH,Y;			INX			CPX		#$08		;WRAP AROUND			BNE		pb_CLEBIT3	;OK			LDX		#$00			INY					;MOVE TO NEXT BIT;pb_CLEBIT3	LDA		PKT_CNT			DEC		a			STA		PKT_CNT			BNE		pb_CLEBIT2** MOVE BITMAP TO CARD*pb_RETURN_BITS	LDA	#WS_PREPATH			STA		<SRCBUF			LDA		#>WS_PREPATH			STA		<SRCBUF+1			LDA		#^WS_PREPATH			STA		<SRCBUF+2;			LDA		#<PDOS_GBL_BIT			STA		<DESTBUF			LDA		#>PDOS_GBL_BIT			STA		<DESTBUF+1			LDA		PFI_BANK			STA		<DESTBUF+2;			LDA		#$18			STA		<COUNT			LDA		#00			STA		<COUNT+1;			JSR		BUFFMOVE			CLC			RTS;;			eject***	17) CHK_BITMAP - CHECK PRODOS SYSTEM BITMAP*** ENTRY : X = HB OF IO BUFFER*	Y = PAGES TO CHECK** EXIT	: C = USED IF SET**		EXPORT	CHK_BITMAPCHK_BITMAP		;					CPY		#$00			BNE		cb_DOIT			CLC					;NO PROBLEM			RTS					;NO ejectS TO CHECK;cb_DOIT		STY		PKT_CNT		;ejectS TO BE CHECK			STX		UWORK1		;HB OF IO BUFFER;			LDA		UWORK1			AND		#%00000111			STA		UWORK2		;SAVE BIT OFFSET			LSR		UWORK1			LSR		UWORK1			LSR		UWORK1		;SAVE BYTE OFFSET** is there a local ProDOS ??*			lda		Active8			bne  	cb_Cont			clc			rts** MOVE BITMAP TO CARD*cb_CONT		LDA		#WS_PREPATH			STA		<DESTBUF			LDA		#>WS_PREPATH			STA		<DESTBUF+1			LDA		#^WS_PREPATH			STA		<DESTBUF+2;			LDA		#<PDOS_GBL_BIT			STA		<SRCBUF			LDA		#>PDOS_GBL_BIT			STA		<SRCBUF+1			LDA		PFI_BANK			STA		<SRCBUF+2;			LDA		#$18			STA		<COUNT			LDA		#00			STA		<COUNT+1;			JSR		BUFFMOVE** ARE THE BITS ALREADY TAKEN ??*			LDY		UWORK1			LDX		UWORK2;cb_CHKBIT1	LDA		WS_PREPATH,Y			AND		SET_BITS,X			BEQ		cb_CHKBIT2	;NOT SET			SEC			RTS					;ERROR !!!;cb_CHKBIT2	INX			CPX		#$08		;WRAP AROUND			BNE		cb_CHKBIT3	;OK			LDX		#$00			INY					;MOVE TO NEXT BIT;			CPY		#$18		;OVERFLOW ???? ($C000)			BNE		cb_CHKBIT3			SEC					;X & Y ARE SET UP			RTS;cb_CHKBIT3	LDA		PKT_CNT			DEC		a			STA		PKT_CNT			BNE		cb_CHKBIT1								;			CLC			RTS					;BITMAP OK;;SET_BITS	; 	DC.B	%10000000	DC.B	%01000000	DC.B	%00100000	DC.B	%00010000	DC.B	%00001000	DC.B	%00000100	DC.B	%00000010	DC.B	%00000001;CLEAR_BITS	; 	DC.B	%01111111	DC.B	%10111111	DC.B	%11011111	DC.B	%11101111	DC.B	%11110111	DC.B	%11111011	DC.B	%11111101	DC.B	%11111110;;			eject***	18) STRIP_PREFIX - REMOVE PREFIX FROM PATHNAME** ENTRY : WS_PATH	= LOCATION OF PATHANME** EXIT	: WS_PATH	= UPDATE PREFIX** STRIP OFF THE PREFIX IF IT IS IN PATHNAME* (ALLOWS COMPARSION OF FULL AND PARITAL PATHNAMES)**		EXPORT	STRIP_PREFIXSTRIP_PREFIX		;		** IS THE FIRST CHARACTER A SLASH (FULL PATHNAME) ?*			JSR		CHKSLASH			BCS		sp_STRIP0		;YES IT IS FULL			RTS					;NOTHING TO DO !!!** FIND WHICH PREFIX IS ACTIVE*sp_STRIP0		BIT		PFI_NAMING			BMI		sp_STRIP2		;AFP NAMING*** PRODOS NAMING IS ACTIVE ;IS PREFIX IN PATHNAME ?**			LDY		PRO_PREFIX	;LENGTH OF PREFIX ?			BEQ		sp_STRIPDONE	;NO PREFIX ACTIVE			CPY		WS_PATH			BCS		sp_STRIPDONE	;PATH TO SHORT !!!;sp_STRIP1	LDA		WS_PATH,Y			CMP		PRO_PREFIX,Y			BNE		sp_STRIPDONE	;YES IT IS THE SAME LETTER			DEY			BNE		sp_STRIP1;			LDY		PRO_PREFIX			BRA		sp_STRIP3		;SHIFT PATHNAME*** AFP NAMING CONVENTION** CHECK PATHNAME AGAINST PREFIX**sp_STRIP2	LDY		AFP_PREFIX	;LENGTH OF PREFIX ?			BEQ		sp_STRIPDONE	;NO PREFIX ACTIVE;			CPY		WS_PATH			BCS		sp_STRIPDONE	 ;PATH TO SHORT !!!;sp_STRIP2A	LDA		WS_PATH,Y			CMP		AFP_PREFIX,Y			BEQ		sp_STRIP2D	;YES IT IS THE SAME LETTER** IS HI BIT SET?*			LDA		WS_PATH,Y	;IS HI BIT SET ???			BMI		sp_STRIPDONE	;NOT CASE INSENSTIVE, NO MATCH** CONVERT TO UPPER CASE*sp_STRIP2B	CMP		#$61			BCC		sp_STRIP2C	;TEST CHARACTER			AND		#$5F;sp_STRIP2C	CMP		#$41		;IS IT LT 'A' ?			BCC		sp_STRIPDONE	;NO,FLUNK TEST			CMP		#$5B		;IS IT GT 'Z' ?			BCS		sp_STRIPDONE	;NO,FLUNK TEST*			LDA		WS_PATH,Y	;CHECK CASE INSENSITIVE			EOR		#$20			CMP		AFP_PREFIX,Y			BNE		sp_STRIPDONE	;NO,FLUNK TEST*sp_STRIP2D	DEY			BNE		sp_STRIP2A;			LDY		AFP_PREFIX** PREFIX IS IN THE PATHNAME - STRIP IT OUT*sp_STRIP3	LDX		#$00sp_STRIP3A	CPY		WS_PATH			BEQ		sp_STRIP4;			INX					;			INY			LDA		WS_PATH,Y			STA		WS_PATH,X			BRA		sp_STRIP3A;sp_STRIP4	STX		WS_PATH** ALL DONE FOR NOW*sp_STRIPDONE	RTS;;***  18a) CHKDBL - Check for Double Slash in Path Name** ENTRY : WS_PATH   = LOCATION OF PATHANME** EXIT  : WS_PATH   = UPDATED PREFIX*         c         = Set if there is an Error**		EXPORT	CHKDBLCHKDBL		;		** initilize flag to no Slash*			STZ		UWORK1;			LDY		WS_PATH		;is there a pathname			BNE		a18_GET		;;			CLC					;no Path Present			RTS** get character*a18_GET		LDA		WS_PATH,Y** if this is in ProDOS Naming Mode,* strip  high Bit of Character*			BIT		PFI_NAMING			BMI		a18_CHECK		;AFP NAMING;			AND		#%01111111	;strip high bit for ProDOS mode** is the character a slash ?*a18_CHECK	CMP		#SLASH			BEQ		a18_FOUND;			STZ		UWORK1		;clear slash flag			BRA		a18_UPDATE		;no, not a slash**         a Slash was found* is this the second slash in a row ??* if no, set the slash found flag*a18_FOUND	BIT		UWORK1			BPL		a18_OK			;no, go set the flag			SEC			RTS					;two slashes in a Row;a18_OK		DEC		UWORK1** are there any more characters ?*a18_UPDATE	DEY			BNE		a18_GET** is the last character a slash ??*			LDY		WS_PATH			LDA		WS_PATH,Y;			BIT		PFI_NAMING			BMI		a18_CHKLAST	;AFP NAMING			AND		#%01111111	;strip high bit for ProDOS modea18_CHKLAST	CMP		#SLASH			BNE		a18_DONE;; At this point we simply reduce the length byte by one so that the trailing; slash becomes invisible.  If the pathname contains ONLY a slash, though, we; should leave it as is so that the Invalid Pathname is recognized as such.			DEC		WS_PATH		;reduce path size by one			bne		a18_DONE	;pathname still has a length, continue			inc		WS_PATH		;else make sure the slash stays put;a18_DONE	CLC			RTS;;			eject***  18b) PDOS_DEVICE** ENTRY : A = Device*         C = set means update** EXIT  : updated device table in global page**		EXPORT	PDOS_DEVICEPDOS_DEVICE		;		** save the carry & device number*			pha			php** is there a local ProDOS ??*			lda		Active8			beq  	PDEV_X		;no local Prodos** IS THIS IN UPDATE DEVICE TABLE MODE ??*			BIT		PFI_NAMING			BVC		b18_DOIT		;UPDATE IS NEEDED;PDEV_X		PLP					;UNUSED			PLA					;UNUSED			RTS					;JUST LEAVE** Pull device table into WS_COMBUF*b18_DOIT	lda		#WS_COMBUF			sta		DESTBUF			lda		#>WS_COMBUF			sta		DESTBUF+1			lda		#^WS_COMBUF			sta		DESTBUF+2			LDA		#$31			STA		SRCBUF			LDA		#$BF			STA		SRCBUF+1			LDA		PFI_BANK			STA		SRCBUF+2			LDA		#15			STA		COUNT			LDA		#00			STA		COUNT+1			JSR		BUFFMOVE** is this add or remove ??*			plp			bcc		clear***  THIS IS THE SET SIDE*** 'all Network Volumes' update ??*			pla			beq		b18_ALL_SET			JSR		b18_one_set	;only set one !!!			JMP		SAVEIT;;b18_ALL_SET	LDA		NDT_CNT			beq		b18_DONE		;no network volumes;			LDY		#$00b18_NEXT	LDA		NDT_SESS,Y			BEQ		b18_UPDATE			lda		NDT_UNIT,y			JSR		b18_one_setb18_UPDATE	iny			cpy		#14			bne		b18_NEXT			JMP		SAVEIT;b18_one_set			and		#$F0			; is unit number = 0?			beq		b18_DONE		; if 0, don't put device in device list			ldx		WS_COMBUF			inx			STX		WS_COMBUF	;one more device			inx;			and		#$F0			; AND already done above			ora		#$04			sta		WS_COMBUF,Xb18_DONE	rts;;****  THIS IS THE clear SIDE*** 'all Network Volumes' update ??*clear		pla			beq		b18b_ALL_CLEAR			JSR		b18b_one_clear	;only clear one !!!			JMP		SAVEIT;;b18b_ALL_CLEAR	LDA		NDT_CNT			beq		b18b_DONE		;no network volumes;			LDY		#$00b18b_NEXT	LDA		NDT_SESS,Y			BEQ		b18b_UPDATE			lda		NDT_UNIT,y			JSR		b18b_one_clearb18b_UPDATE	iny			cpy		#14			bne		b18b_NEXT			JMP		SAVEIT;;b18b_one_clear	LDX		WS_COMBUF			INX;			and		#$F0			ora		#$04b18b_loop	CMP		WS_COMBUF,x			beq		b18b_FOUND			dex			bne		b18b_loop		;not Found Yet			rts					;not Here, o well;b18b_FOUND		CPX		#14			BEQ		b18b_WIPEOUT;b18b_MOVE		LDA		WS_COMBUF+1,X			STA		WS_COMBUF,X			INX			CPX		#14			BNE		b18b_MOVE;b18b_WIPEOUT	STZ		WS_COMBUF+14			DEC		WS_COMBUFb18b_DONE	rts;;** RETURN RESULTS TO $BF31*SAVEIT	; 			lda		#WS_COMBUF			STA		SRCBUF			lda		#>WS_COMBUF			STA		SRCBUF+1			lda		#^WS_COMBUF			STA		SRCBUF+2;			LDA		#$31			sta		DESTBUF			LDA		#$BF			sta		DESTBUF+1			LDA		PFI_BANK	;LAST BANK USED			STA		DESTBUF+2;			LDA		#15			STA		COUNT			LDA		#00			STA		COUNT+1;			JMP		BUFFMOVE;;***  17) REMOVE_DEV -** ENTRY :*** EXIT  : updated device table**		EXPORT	REMOVE_DEVREMOVE_DEV		;** is there a local ProDOS ??*			lda		Active8			beq  	RMV_X		;no local Prodos** IS THIS IN UPDATE DEVICE TABLE MODE ??*			BIT		PFI_NAMING			BVC		c18_DOIT		;UPDATE IS NEEDEDRMV_X		RTS					;JUST LEAVE** Pull device table into WS_COMBUF*c18_DOIT	lda		#WS_COMBUF			sta		DESTBUF			lda		#>WS_COMBUF			sta		DESTBUF+1			lda		#^WS_COMBUF			sta		DESTBUF+2;			LDA		#$31			STA		SRCBUF			LDA		#$BF			STA		SRCBUF+1			LDA		PFI_BANK			STA		SRCBUF+2;			LDA		#15			STA		COUNT			LDA		#0			STA		COUNT+1;			JSR		BUFFMOVE** CLEAR ALL AUN FROM DEVICE TABLE*			LDY		#$00c18_NEXT	LDA		AUN_RAM,Y			BEQ		c18_UPDATE			JSR		c18_one_clearc18_UPDATE	iny			cpy		#14			bne		c18_NEXT			JMP		c18_SAVEIT;;c18_one_clear	LDX		WS_COMBUF			INX;			and		#$F0			ora		#$04c18_loop	CMP		WS_COMBUF,x			beq		c18_FOUND			dex			bne		c18_loop		;not Found Yet			rts					;not Here, o well;c18_FOUND	CPX		#14			BEQ		c18_WIPEOUT;c18_MOVE	LDA		WS_COMBUF+1,X			STA		WS_COMBUF,X			INX			CPX		#14			BNE		c18_MOVE;c18_WIPEOUT	STZ		WS_COMBUF+14			DEC		WS_COMBUFc18_DONE	rts;;** RETURN RESULTS TO $BF31*c18_SAVEIT		lda		#WS_COMBUF			STA		SRCBUF			lda		#>WS_COMBUF			STA		SRCBUF+1			lda		#^WS_COMBUF			STA		SRCBUF+2;			LDA		#$31			sta		DESTBUF			LDA		#$BF			sta		DESTBUF+1			LDA		PFI_BANK	;LAST BANK USED			STA		DESTBUF+2;			LDA		#15			STA		COUNT			LDA		#00			STA		COUNT+1;			JMP		BUFFMOVE;;*** 19) INTO_ATTRI : CONVERT PRODOS ACCESS BYTES INTO*	AFP ATTRIBUTE BYTE** ENTRY : ACCESS	= FILE OR DIRECTORY ATTRIBUTES*	A	= TYPE (80=DIR/00=FILE)** EXIT	: ATTRIBUTE = FILE ATTRIBUTE (AFP)**		EXPORT	INTO_ATTRIINTO_ATTRI		;		** SAVE TYPE*			PHA;;----> 10/02/87   TE;;*;* IS THIS A FILE OR A DIRECTORY ??;*								;AND #%10000000								;BEQ :OVER ;FILE TYPE;								;LDA ACCESS ;IN CASE BACKUP BIT IS USED								;ORA #$C3 ;FULL ACCESS								;STA ACCESS;;----> END;** SET HB OF ATTRIBUTES** BIT 0 = DELETE INHIBIT*ia_OVER		LDA		#$80			BIT		ACCESS			BMI		IN_ATT1			ORA		#%00000001	;SET DELETE BITIN_ATT1	; 			STA		ATTRIBUTE+1			ORA		#%01111110	;REVERSE OTHER BITS			EOR		#%11111111	;			STA		ATTRIBUTE+3	;HB OF CLEAR INFO** STUFF LB OF ATTRIBUTES*			LDA		#0			ROR		ACCESS			ROR		ACCESS			BCS		IN_ATT3			ORA		#%00100000	;SET READ ONLY BITIN_ATT3	; 			ROR		ACCESS			BCC		IN_ATT3A			ORA		#%00000001	;SET READ ONLY BITIN_ATT3A ;			ROL		ACCESS			ROL		ACCESS			ROL		ACCESS			ROL		ACCESS			BIT		ACCESS			BMI		IN_ATT4			ORA		#%10000000	;SET RENAME BITIN_ATT4	; 			BVC		IN_ATT5			ORA		#%01000000	;SET BACKUP BITIN_ATT5	; 			STA		ATTRIBUTE			ORA		#%00011110	;REVERSE OTHER BITS			EOR		#%11111111			STA		ATTRIBUTE+2;;;;----->10/05/87 TE;** RESTORE TYPE*			PLA;;----> 11/19/87 te per Pat DIRKS;;								;BPL :EXIT ;IT IS A FILE;								;LDA ATTRIBUTE ;IS THERE A RENAME ?								;BMI :MOVELOCK ;BIT 7 IS SET !!!								;LDA ATTRIBUTE+1								;ROR								;BCS :MOVELOCK ;BIT 8 IS SET !!!								;								;LDA ATTRIBUTE+3								;ORA #%00000010 ;CLEAR MOVE INHIBIT !!!								;STA ATTRIBUTE+3								;BRA :EXIT								;								;:MOVELOCK LDA ATTRIBUTE+1								;ORA #%00000010 ;SET MOVE INHIBIT !!!								;STA ATTRIBUTE+1ia_EXIT		RTS;;----> END;;;;;			eject*** 20) FROM_ATTRI : CONVERT PFI ATTRIBUTE BYTES INTO*	PRODOS ACCESS BYTE** ENTRY : ATTRIBUTE = FILE ATTRIBUTE (AFP)*	A	= TYPE (80=DIR/00=FILE)** EXIT	: ACCESS	= FILE OR DIRECTORY ATTRIBUTES**		EXPORT	FROM_ATTRIFROM_ATTRI		;		** SAVE TYPE*			PHA** TRANSFORM HB OF ATTRIBUTES INTO ACCESS*			LDA		#$01		;ALWAYS SET READ BIT !!!			ROR		ATTRIBUTE+1	;ROTATE HB			BCS		ATTRI1			ORA		#%10000000	;SET DELETE BIT** TRANSFORM LB OF ATTRIBUTES INTO ACCESS*ATTRI1	; 			ROL		ATTRIBUTE	;ROTATE LB			BIT		ATTRIBUTE			BPL		ATTRI3			ORA		#%00100000	;SET BACKUP BITATTRI3	; 			BVS		ATTRI4			ORA		#%00000010	;SET WRITE BITATTRI4	; 			BCS		ATTRI5			ORA		#%01000000	;SET REANEM BITATTRI5	; 			ROR		ATTRIBUTE	;ROTATE LB			ROR		ATTRIBUTE	;ROTATE LB			BCC		ATTRI6			ORA		#%00000100	;SET invisible BITATTRI6  ;						STA		ACCESS** LOOK AT TYPE*			PLAfa_OVER		RTS;;			eject** 21) CALC_DIRINFO: CALCULATE DIRCTORY BLOCKS/BYTES**	HEADER BLOCK = MAX 12 ENTRIES*	OTHER BLOCK = MAX 13 ENTRIES** ENTRY : OFFSPRING - 2 BYTES** EXIT	: FILE_BLKS - 2 BYTES*	FILE_SIZE - 3 BYTES** LOCAL VARIABLES :*	REMAINDER	- 3 BYTES*	BYTE_COUNT - 1 BYTE*** EQUATES*FULL_ENBLK	equ		$0D			;MAX ENTRIES TO FILL UP FILE_BLKS (LB)**		EXPORT	CALC_DIRINFOCALC_DIRINFO		;		** COUNT HEADER BLOCK*			LDX		#$00			LDA		OFFSPRING;			JSR		DBLKS1		;GO TO COUNT HB OF BLKS;			STA		FILE_BLKS+1	;SAVE # OF BLKS IN HB** CHECK REMAINDER*			LDX		REMAINDER			LDA		OFFSPRING+1;			JSR		DBLKS1		;GO TO COUNT LB OF BLKS;			STA		FILE_BLKS	;SAVE # OF BLKS IN LB			INC		FILE_BLKS** CALCULATE # OF BYTES*			STZ		FILE_SIZE			CLC			LDA		FILE_BLKS			ROL		a			STA		FILE_SIZE+1			LDA		FILE_BLKS+1			ROL		a			STA		FILE_SIZE+2			RTS					;END OF CALC_DIRINFO;;** COUNT # OF BLOCKS FOR HB/LB OF FILE_BLKS*DBLKS1	; 			STA		REMAINDER			STX		REMAINDER+1			LDA		#$FF		;INITIALIZE BYTE_COUNT			STA		BYTE_COUNT** IS FILE SIZE LARGER THAN 13*256 ENTRIES?*DBLKS2	; 			INC		BYTE_COUNT	;INCREMENT # OF BLOCKS			SEC			LDA		REMAINDER			SBC		#FULL_ENBLK			STA		REMAINDER			BCS		DBLKS2		;LF YES, KEEP COUNT HB								;			LDA		REMAINDER+1			BEQ		DBLKS4			DEC		REMAINDER+1	;DECREMENT HB OF FILE SIZE			BRA		DBLKS2;DBLKS4	; 			CLC					;GET REMAINDER ORIGIN			LDA		#$0D			ADC		REMAINDER			STA		REMAINDER			LDA		BYTE_COUNT	;RETURN # OF BLOCKS			RTS					;END OF SUBROUTINE;;			eject*** 22) BYTE2BLKS : CONVERT # OF BYTES INTO # OF BLOCKS*	1 BLOCK = 512 BYTES** ENTRY : FILE_SIZE - 4 BYTES** EXIT	: FILE_BLKS - 2 BYTES** EQUATES*MAXFILE0	equ		$01			;HBMAXFILE1	equ		$FF			;MIDHBMAXFILE2	equ		$FE			;MIDLBMAXFILE3	equ		$00			;LB**		EXPORT	BYTE2BLKSBYTE2BLKS		;		** CHECK OVERFLOW***			SEC			LDA		#MAXFILE3	;LB			SBC		FILE_SIZE+3			LDA		#MAXFILE2	;MIDLB			SBC		FILE_SIZE+2			LDA		#MAXFILE1	;MIDHB			SBC		FILE_SIZE+1			LDA		#MAXFILE0			SBC		FILE_SIZE+0	;HB			BCS		BYTE0		;OK, GO ON;			LDA		#$FF		;OVERFLOW ERROR			STA		FILE_BLKS	;END OF BYTE2BLKS			STA		FILE_BLKS+1			RTS** FIND NUMBER OF FULL BLOCKS*BYTE0	; 			LDA		FILE_SIZE			LSR		a			;MOVE LOW BIT INTO CARRY			LDA		FILE_SIZE+1			ROR		a			;MOVE IN HI BIT - MOVE OUT LOW BIT			STA		FILE_BLKS+1			LDA		FILE_SIZE+2			ROR		a			;MOVE IN HI BIT - MOVE OUT LOW BIT			STA		FILE_BLKS** IS THERE A PARTIAL BLOCK ?*			LDA		FILE_SIZE+3	;ANYTHING IN LAST BYTE OF FILE_SIZE?			BNE		BYTE2		;ADD ONE BLOCK			LDA		FILE_SIZE+2			AND		#%00000001			BNE		BYTE2		;ADD ONE BLOCK;** IF NUMBER OF BLOCK = 0 THEN MAKE IT = 1*			LDA		FILE_BLKS			ORA		FILE_BLKS+1			BNE		b2b_DONE			INC		FILE_BLKS	;MAKE IT ONEb2b_DONE	RTS					;END OF BYTE2BLKS** ADD ONE TO NUMBER OF BLOCKS*BYTE2	; 			CLC			LDA		FILE_BLKS			ADC		#$01			STA		FILE_BLKS			LDA		FILE_BLKS+1			ADC		#$00			STA		FILE_BLKS+1			RTS;;;			eject*** 23) INTO_SEC : CONVERT PRODOS TIME INTO AFP TIME** ENTRY : PRO_TIME - 4 BYTES** EXIT	: AFP	- 4 BYTES**		EXPORT	INTO_SECINTO_SEC		;					LDA		PRO_TIME			ORA		PRO_TIME+1			ORA		PRO_TIME+2			ORA		PRO_TIME+3			BNE		INTO_SEC1	;NOT DEFAULT** SET DEFAULT TIME*			LDA		#$80			STA		AFP			STZ		AFP+1			STZ		AFP+2			STZ		AFP+3			RTS** CONVERT FROM PRODOS TIME INTO AFP TIME*INTO_SEC1	; 			JSR		B1_PRO2CLK			JSR		B1_CLK2STD			JSR		B1_STD2AFP			RTS;;			eject*** 24) FROM_SEC : CONVERT AFP TIME INTO PRODOS TIME** ENTRY : AFP	- 4 BYTES** EXIT	: PRO_TIME - 4 BYTES**		EXPORT	FROM_SECFROM_SEC		;					LDA		AFP			CMP		#$80			BNE		FROM_SEC1	;NOT DEFAULT			LDA		#$00			ORA		AFP+1			ORA		AFP+2			ORA		AFP+3			BNE		FROM_SEC1	;NOT DEFAULT** SET DEFAULT*			LDX		#$03FROM_SEC0	; 			STZ		PRO_TIME,X			DEX			BPL		FROM_SEC0			RTS** CONVERT SECONDS TO PRODOS TIME*FROM_SEC1	; 			JSR		B1_AFP2STD			JSR		B1_STD2CLK			JSR		B1_CLK2PRO			RTS;;			eject*** 25) GET THE EOF FOR AN OPEN	FILE**	ENTRY : UFILEIDX	= HEAP NUMBER FOR ASP HEAP**	EXIT	: FILE_SIZE = EOF FOR FILE**		EXPORT	FILE_GETEOFFILE_GETEOF		;		;;---->11/07/87 te -- drop box;** if this is an open ($C8) & it is in drop box Mode,* then get EOF from table*			LDX		UFILEIDX			LDA		UTYPE,X			AND		#$08		;bit 3 = normal open ($C8) ???			BEQ		fg_OVER		;no, special open;			LDA		UMODE,X			CMP		#$32		;drop box ??			BNE		fg_OVER		;no, some other mode;;			LDA		UDIRID1,X			STA		FILE_SIZE			LDA		UDIRID2,X			STA		FILE_SIZE+1			LDA		UDIRID3,X			STA		FILE_SIZE+2			RTS;;---->;** CREATE GET FORK INFO PACKET*fg_over	; 			LDA		#GETFORKPARM			STA		WS_COMBUF	;SAVE COMMAND			STZ		WS_COMBUF+1;			LDX		UFILEIDX			LDA		USRVNUM1,X			STA		WS_COMBUF+2	;SAVE FILE REFERENCE # - HB			LDA		USRVNUM2,X			STA		WS_COMBUF+3	;SAVE FILE REFERENCE # - LB;			BIT		UTYPE,X			BVC		fg_SETDATA			LDA		#%00000100	;RESOURCE FORK - SIZE OF DATA			BRA		fg_SETBITS;fg_SETDATA	LDA		#%00000010	;DATA FORK - SIZE OF DATAfg_SETBITS	STA		WS_COMBUF+4	;SAVE HB OF FILE BITMAP			STZ		WS_COMBUF+5;			LDA		#$06			STA		PKT_CNT			STZ		PKT_CNT+1** ISSUE AFP GET FORK PARMS*			JSR		CMD_ROUTING			BEQ		FIL_GTEOF1	;NO ERROR			RTS					;ERROR, EXIT NOW !!!** CHECK FOR OVERFLOW*FIL_GTEOF1	; 			LDA		WS_COMBUF+2	;HIGHEST BYTE OF LENGTH			BEQ		FIL_GTEOF2	;NO,OVERFLOW;			LDA		#$FF			STA		FILE_SIZE			STA		FILE_SIZE+1			STA		FILE_SIZE+2			RTS** SAVE SIZE OF FILE IN WORK AREA*FIL_GTEOF2	; 			LDA		WS_COMBUF+3	;HB			STA		FILE_SIZE+2			LDA		WS_COMBUF+4	;MB			STA		FILE_SIZE+1			LDA		WS_COMBUF+5	; LB			STA		FILE_SIZE			RTS;;			eject*** 26) GET THE EOF FOR AN OPEN	DIRECTORY**	ENTRY : UFILEIDX	= HEAP NUMBER FOR ASP HEAP**	EXIT	: FILE_SIZE = EOF FOR FILE**		EXPORT	DIR_GETEOFDIR_GETEOF		;		** CREAT AFP GET FILE/DIRECTORY PARAMETER*			LDA		#GETFDINFO			STA		WS_COMBUF	 ;SAVE COMMAND			STZ		WS_COMBUF+1	;SAVE ZERO;			JSR		STUFF_DIRIDS;			STZ		WS_COMBUF+8	;SAVE ZERO IN FILE BITMAP (HB)			STZ		WS_COMBUF+9	;SAVE ZERO IN FILE BITMAP (LB)								;			LDA		#%00000010	;# OF OFFSPRING			STA		WS_COMBUF+$0A	;SAVE DIR BITMAP HB			STZ		WS_COMBUF+$0B	;SAVE ZERO IN DIR BITMAP LB;			LDA		#$02			STA		WS_COMBUF+$0C	;LONG NAME			STZ		WS_COMBUF+$0D	;NO LENGTH FOR NAME;			LDA		#$0E			STA		PKT_CNT			STZ		PKT_CNT+1** ISSUE AFP GET FILE/DIRECTORY PARMS*			JSR		CMD_ROUTING			BEQ		DIR_GTEOF1	;NO ERROR IN CALL			RTS					;ERROR,EXIT NOW !!!** CALCULATE THE NUMBER OF BLOCKS IN THE DIRECTORY*	FIND # OF BYTES*DIR_GTEOF1	; 			LDA		WS_COMBUF+$06			STA		OFFSPRING			LDA		WS_COMBUF+$07			STA		OFFSPRING+1;			JMP		CALC_DIRINFO;;		ENDP		end