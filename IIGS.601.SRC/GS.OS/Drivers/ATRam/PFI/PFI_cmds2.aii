;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	Import	UM_INDEX	Import	PFI_BANK	IMPORT	ADJUST	IMPORT	AFP	IMPORT	AFP_PREFIX	IMPORT	AUN_RAM	import	aun_cnt	IMPORT	B1_MULT	IMPORT	BUFFMOVE	IMPORT	CHK_PRODOS	IMPORT	CMD_ROUTING	IMPORT	CN_PFIXPTR	IMPORT	CURSESS	IMPORT	Cn_PFIERR	IMPORT	FND_CURSRV	IMPORT	LCL_DEVCNT	IMPORT	MULT1	IMPORT	MULT2	IMPORT	NAME_STAT	IMPORT	NDT_CNT	IMPORT	NDT_COUNT	IMPORT	NDT_IDH	IMPORT	NDT_IDL	IMPORT	NDT_IDX1	IMPORT	NDT_IDX2	IMPORT	NDT_NAME	IMPORT	NDT_SESS	IMPORT	NDT_UNIT	IMPORT	NETWORK_CALL	IMPORT	PATH2BUF	IMPORT	PDOS_DEVICE	IMPORT	PFI_NAMING	IMPORT	PFI_NODEV	IMPORT	AUN_CNT	IMPORT	AUN_HOLD	IMPORT	AUN_RAM	Import	PUN_ROM	IMPORT	PRO2CLK	IMPORT	CLK2STD	IMPORT	STD2AFP	IMPORT	AFP2STD	IMPORT	STD2CLK	IMPORT	CLK2PRO	IMPORT	CHK_PROTIME	IMPORT	PKT_CNT	IMPORT	PROD	IMPORT	PRO_PREFIX	IMPORT	PRO_TIME	IMPORT	SESSION_TBL	IMPORT	SESS_IDX	IMPORT	SRCPATH	IMPORT	STUFF_IDS	IMPORT	UWORK1	IMPORT	UWORK2	IMPORT	WS_COMBUF	IMPORT	WS_PATH	IMPORT	getzp1parm	IMPORT	setup	Import	Active8	Import	Vector_Mount	Import	Vector_UNMnt	Import	Vector_Atten	Import	SESSION_NAME	Import	SESSION_NET	; ===>	MSD	23-Apr-90	(imports)	import	chkslash	import	pro_pfxloc	import	afp_pfxloc; <===	MSD	23-Apr-90	(imports)	import	CheckAsync		; 7-Oct-91 MSD;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	EXIT_PFI** pfi_cmds2** Greg Seitz (14-Jul-87)**		INCLUDE	'zp.equates'		include	'global.equates'		include 'pfi_equates'		*		EXPORT	pficmds2	pficmds2	PROC			longa	off			longi	off***	PARAMIS NETWORK SOFTWARE***	CONFIDENTIAL*** MODULE :	PFI0.B - PRODOS FILING INTERFACE	(PART 0)*	ADDITIONAL CALLS**	WRITTEN BY THOMAS EAGER**	MODIFIED: 06-15-87	4:18	TE**	COPYRIGHT 1986,87	ParaMIS CORPORATION** ALL RIGHTS RESERVED**			eject*** COMMAND $2F = FILISTSESSIONS - LIST SESSIONS**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $2F	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	|	BUFFER LENGTH (2)|*	---------------------*	6	|	BUFFER POINTER	(4)|*	---------------------*	A	|	ENTRIES RETURNED	|*	---------------------*		EXPORT	CFILISTCFILIST		;					jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup** INITIALIZE COUNTER & OFFSETS*			LDA		#WS_COMBUF			STA		<ZP1			LDA		#>WS_COMBUF			STA		<ZP1+1;			STZ		NDT_COUNT	;NO VOLUMES IN BUFFER YET			STZ		NDT_IDX1	;INDEX TO NDT_NAMES (LB -START)			STZ		NDT_IDX1+1	;INDEX TO NDT_NAMES (HB -START)			LDX		#$00** IS THIS ENTRY IN NDT ACTIVE ?*LIST1	; 			STX		NDT_IDX2	;INDEX TO NDT_SESS,_IDL,_IDH,_UNIT			LDA		NDT_SESS,X			BEQ		LIST3		;UPDATE COUNTERS** PLACE SESSION IN WORK BUFFER*			LDY		#$00			STA		(ZP1),Y		;SAVE SESSION NUMBER			INY** PLACE UNIT NUMBER IN WORK BUFFER*			LDA		NDT_UNIT,X			STA		(ZP1),Y		;SAVE UNIT NUMBER			INY** PLACE NAME IN WORK BUFFER*			CLC			LDA		NDT_IDX1	;OFFSET TO NDT_NAME TABLE			ADC		#NDT_NAME			STA		<ZP2			LDA		NDT_IDX1+1			ADC		#>NDT_NAME			STA		<ZP2+1;			STY		UWORK1			LDY		#$00LIST2	; 			LDA		(ZP2),Y			STY		UWORK2;			LDY		UWORK1			STA		(ZP1),Y			INY			STY		UWORK1			LDY		UWORK2			INY			CPY		#NDT_NAMELEN+2			BNE		LIST2		;MORE OF NAME TO USE** PLACE VOLUME ID IN WORK BUFFER*			LDX		NDT_IDX2			LDA		NDT_IDH,X			STA		(ZP1),Y			INY			LDA		NDT_IDL,X			STA		(ZP1),Y** UPDATE ZP1 (DON'T HAVE TO WORRY ABOUT PAGE WRAP)*			CLC			LDA		#$20		;SIZE OF ONE ENTRY			ADC		<ZP1			STA		<ZP1			LDA		#$00			ADC		<ZP1+1			STA		<ZP1+1** UPDATE # OF ENTRIES IN BUFFER*			INC		NDT_COUNT** UPDATE COUNTERS*LIST3	; 			CLC			LDA		NDT_IDX1			ADC		#NDT_NAMELEN			STA		NDT_IDX1			LDA		NDT_IDX1+1			ADC		#$00			STA		NDT_IDX1+1;			LDX		NDT_IDX2			INX			CPX		#14			;7 SLOTS * 2 DRIVES			BEQ		LIST4		;CONTIINUE			JMP		LIST1		;MORE TO LOOK AT** ARE THERE ANY SESSIONS WITHOUT VOLUMES MOUNTED ?*LIST4	; 			LDX		#$00LIST5	; 			STX		SESS_IDX	;INDEX TO SESSION TABLE			LDY		#$00LIST6	; 			LDA		SESSION_TBL,X			BEQ		LIST7		;NOT AN ACTIVE SESSION			CMP		NDT_SESS,Y			BEQ		LIST7		;THIS ONE HAS A MOUNTED VOLUME			INY			CPY		#14			;SIZE OF NDT TABLES			BNE		LIST6** SAVE SESSION IN WORK BUFFER - NO MOUNTED VOLUMES*			LDA		SESSION_TBL,X			STA		(ZP1);			LDY		#$01			LDA		#$00		;NO NAMELIST6A	; 			STA		(ZP1),Y			INY			CPY		#$20		;SIZE OF ONE ENTRY			BNE		LIST6A** UPDATE ZP1 (DON'T HAVE TO WORRY ABOUT PAGE WRAP)*			CLC			LDA		#$20		;SIZE OF ONE ENTRY			ADC		<ZP1			STA		<ZP1			LDA		#$00			ADC		<ZP1+1			STA		<ZP1+1** UPDATE COUNT BYTE*			INC		NDT_COUNT** MOVE TO NEXT SESSION IN THE SESSION TABLE*LIST7	; 			LDX		SESS_IDX			INX			CPX		#MAXSESSION			BNE		LIST5		;LOOK AT THE NEXT SESSION** FIND LENGTH OF WORK BUFFER*			SEC			LDA		<ZP1			SBC		#WS_COMBUF			STA		<COUNT			LDA		<ZP1+1			SBC		#>WS_COMBUF			STA		<COUNT+1;			LDA		NDT_COUNT			STA		UWORK1		;MAX POSSIBLE** IS THE USERS BUFFER LARGE ENOUGH TO HOLD ALL OF IT ?*LIST7A	; 			SEC			LDY		#$04			LDA		[ZP0],Y			SBC		<COUNT			INY			LDA		[ZP0],Y			SBC		<COUNT+1			BCS		LIST8		;BUFFER ON MB IS BIG ENOUGH** REDUCE COUNT IF NEEDED*			LDA		NDT_COUNT			BEQ		LIST9		;NO HOPE TO MOVE DATA;			DEC		NDT_COUNT;			SEC			LDA		<COUNT			SBC		#$20			STA		<COUNT			LDA		<COUNT+1			SBC		#$00			STA		<COUNT+1			BRA		LIST7A		;TRY AGAIN** MOVE WORK BUFFER TO MB BUFFER*LIST8	; 			LDA		#WS_COMBUF			STA		<SRCBUF			LDA		#>WS_COMBUF			STA		<SRCBUF+1			LDA		#^WS_COMBUF			STA		<SRCBUF+2;			LDY		#06			LDA		[ZP0],Y			STA		<DESTBUF			INY			LDA		[ZP0],Y			STA		<DESTBUF+1			INY			LDA		[ZP0],Y			STA		<DESTBUF+2;								;			JSR		BUFFMOVE** PLACE # OF ENTRIES IN BUFFER IN PL*LIST9	; 			LDY		#$0A			LDA		NDT_COUNT			STA		[ZP0],Y** WAS ALL OF THE DATA GIVEN TO USER ?*			LDA		NDT_COUNT			CMP		UWORK1			BEQ		LIST10			LDA		#$0B		;BUFFER TOO SMALL			BRA		LIST11LIST10	; 			LDA		#$00		;NO ERROR** RETURN PARAMETER LIST*LIST11	; 			LDY		#$0B		;AMOUNT TO RETURN			SEC			JMP		EXIT_PFI			eject*** COMMAND $30 = GET TIME ZONE**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $30	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	|	TIME	FLAG	|*	---------------------**BANK1_ADJUST	DC.B	$05,$8B,$B2,$00	;USED BY TIME ROUTINE**		EXPORT	CFITIMEZONECFITIMEZONE		;					jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup** IS TIME WITHIN LIMITS ?*			LDY		#$04			LDA		[ZP0],Y			AND		#%01111111	;STRIP OFF DIRECTIONAL BIT			CMP		#24			BCC		TIMEZONE1	;TIME OK** ERROR - TIME FLAG ERROR*			LDA		#$0C			CLC			JMP		EXIT_PFI** CALCULATE OFFSET*TIMEZONE1	; 			STA		MULT1		;SAVE # OF HOURS;			STZ		MULT2		;SAVE SEC/HOUR			STZ		MULT2+1			LDA		#$0E			STA		MULT2+2			LDA		#$10			STA		MULT2+3;			LDX		#$03		; 14-Jan-92 MSD (was 2) get all 4 bytes!TIMEZONE2	; 			STZ		PROD,X		;ZERO OUT PROD			DEX			BPL		TIMEZONE2;			JSR		B1_MULT		;MULTIPLE** FIND DIRECTION OF OFFSET*			LDY		#$04			LDA		[ZP0],Y			BPL		TIMEZONE3	;NEGATIVE NUMBER** SUBTRACT OFFSET FROM DEFAULT*			SEC			LDA		BANK1_ADJUST+3			SBC		PROD+3			STA		ADJUST+3;			LDA		BANK1_ADJUST+2			SBC		PROD+2			STA		ADJUST+2								;			LDA		BANK1_ADJUST+1			SBC		PROD+1			STA		ADJUST+1;			LDA		BANK1_ADJUST			SBC		PROD			STA		ADJUST			BRA		TIMEZONE4	;ALL DONE** ADD OFFSET TO DEFAULT*TIMEZONE3	; 			CLC			LDA		BANK1_ADJUST+3			ADC		PROD+3			STA		ADJUST+3;			LDA		BANK1_ADJUST+2			ADC		PROD+2			STA		ADJUST+2								;			LDA		BANK1_ADJUST+1			ADC		PROD+1			STA		ADJUST+1;			LDA		BANK1_ADJUST			ADC		PROD			STA		ADJUST** SET THE RESULT CODE TO NO ERROR*TIMEZONE4	; 			LDA		#$00		;RESULT CODE - LB			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI			eject*** COMMAND $31 = FIGETSRCPATH - GET PATH TO LAST OPEN FILE**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $31	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	|	BUFFER POINTER	(4)|*	---------------------**		EXPORT	CFIGETSRCPATHCFIGETSRCPATH		;					jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup** TIME TO GET THE USER'S NAME*			LDX		SRCPATH			INX			STX		<COUNT			LDA		#00			STA		<COUNT+1		;TWO PORT MOVE - OFF OF CARD;			LDY		#$04			LDA		[ZP0],Y			STA		<DESTBUF			INY			LDA		[ZP0],Y			STA		<DESTBUF+1			INY			LDA		[ZP0],Y			STA		<DESTBUF+2;			LDA		#SRCPATH			STA		<SRCBUF			LDA		#>SRCPATH			STA		<SRCBUF+1			LDA		#^SRCPATH			STA		<SRCBUF+2								;			JSR		BUFFMOVE	;FINISHED WITH THE MOVE** SET THE RESULT CODE TO NO ERROR*			LDA		#$00		;RESULT CODE - LB			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI;;			eject*** COMMAND $32 = FIACCESS - GET /SET ACCESS RIGHTS**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $32	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	| DIRECTIONAL FLAG (1)|*	---------------------*	5	|	ACCESS RIGHTS	(4)| ***	---------------------*	9	| PATHNAME POINTER (4)|*	---------------------*	D	| CREATOR	POINTER (4)|*	---------------------*	11	| GROUP	POINTER (4)|*	---------------------**		EXPORT	CFIACCESSCFIACCESS		;					jsr		CheckAsync						jsr		setup** MOVE PATHNAME ONTO CARD*			LDY		#$09			LDA		[ZP0],Y			STA		<SRCBUF			INY			LDA		[ZP0],Y			STA		<SRCBUF+1			INY			LDA		[ZP0],Y			STA		<SRCBUF+2;			LDA		#WS_PATH			STA		<DESTBUF			LDA		#>WS_PATH			STA		<DESTBUF+1			LDA		#^WS_PATH			STA		<DESTBUF+2;			LDA		#MAX_AFPPATH			STA		<COUNT			LDA		#00			STA		<COUNT+1;			JSR		BUFFMOVE** WHAT NAMING MODE IS ACTIVE ?*			BIT		PFI_NAMING			BMI		FIACCESS0	;AFP;			JSR		CHK_PRODOS	;IS IT IN PRODOS FORMAT ?			BCC		FIACCESS0	;IT WAS OK								;ERROR			LDA		#$05		;INVALID NAME			CLC					;STANDARD AMOUNT			JMP		EXIT_PFI;;** IS THIS ON A SERVER VOLUME ?*; ===>; MSD	23-Apr-90;; The old code assumed the pathname was a complete pathname,; and compared the volume part ("/"+alphanumerics) to each; of the mounted volumes and succeeded if one matched.;; We need to check first if the path is a partial path.  If; so, we check instead to see if the current prefix is on a; network volume.  This is done in much the same way as the; pre-processing code PFI uses to determine if a call should; be handled by PFI or the local prodos (when the call involves; a pathname).;; <===FIACCESS0	;; ===>	MSD	23-Apr-90	(part 1)			jsr		chkslash	; complete path ("/"...)?			bcs		fiaccess0_b	; yes, so compare volume names; Partial path given.  See if prefix points to a server volume.			bit		pfi_naming	; are we using AFP naming mode?			bmi		fiaccess0_a	; yes, so check AFP mode prefix; We're using ProDOS naming mode, so check ProDOS mode prefix			lda		pro_pfxloc	; this is $FF if prefix is for local volume			cmp		#$FF		; local prefix?			bne		fiaccess1	; no, server prefix.  do the call			bra		fiaccess0_c	; prefix was local.  Error!!fiaccess0_a; Here, we're in AFP naming mode.  Check the AFP namine mode prefix			lda		afp_pfxloc	; this is $FF if prefix is for local volume			cmp		#$FF		; local prefix?			bne		fiaccess1	; no, server prefix.  do the call			bra		fiaccess0_c	; prefix was local.  Error!!fiaccess0_b; Here, the path is a complete one.  Fall into the existing code.; <===	MSD	23-Apr-90	(part 1)			JSR		FND_CURSRV	; does the volume match a mounted volume?			BCC		FIACCESS1	; yes, so complete the call;; ===>	MSD	23-Apr-90	(part 2)fiaccess0_c; Here, the pathname does not refer to any mounted server volume; so return an error (access privileges only work on server volumes).; <===	MSD	23-Apr-90	(part 2)			LDA		#$09		;VOLUME NOT MOUNTED			CLC			JMP		EXIT_PFI** IS THIS A GET OR SET ACCESS CALL ?*FIACCESS1	; 			LDY		#$04			LDA		[ZP0],Y			BMI		SETACC0		;A SET ACCESS CALL			JMP		GETACC0		;A GET ACCESS CALL;;*** ARE THERE ANY SPECIAL ID'S TO FIND*** DO I NEED CREATOR ID'S ?*SETACC0	; 			LDY		#$04			LDA		[ZP0],Y			AND		#%01000000			BEQ		SETACC0_C	;CHECK GROUP** STUFF MAPNAME CALL*			LDA		#MAPNAME			STA		WS_COMBUF			LDA		#$03		;CREATER			STA		WS_COMBUF+1;			LDY		#$0D		;MOVE CREATER NAME ONTO CARD			LDA		[ZP0],Y			STA		<SRCBUF			INY			LDA		[ZP0],Y			STA		<SRCBUF+1			INY			LDA		[ZP0],Y			STA		<SRCBUF+2;			LDA		#WS_COMBUF+2			STA		<DESTBUF			LDA		#>WS_COMBUF+2			STA		<DESTBUF+1			LDA		#^WS_COMBUF+2			STA		<DESTBUF+2;			LDA		#$20			STA		<COUNT			LDA		#00			STA		<COUNT+1								;			JSR		BUFFMOVE;			CLC			LDA		WS_COMBUF+2	;LENGTH OF STRING			ADC		#$03			STA		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING			BCC		SETACC0_B	;CALL IS OK !!!;			LDA		#$0A		;CREATOR NOT FOUND			CLC			JMP		EXIT_PFI;;** SAVE CREATOR ID IN AFP Time Field (TEMP Storage)*SETACC0_B	; 			LDY		#$03SETACC0_BB	; 			LDA		WS_COMBUF,Y			sta		AFP,y			dey			Bpl		SETACC0_BB;;** DO I NEED GROUP ID'S ?*SETACC0_C	; 			LDY		#$04			LDA		[ZP0],Y			AND		#%00100000			BEQ		SETACC1		;ISSUE SET FILE/DIR PARMS** STUFF MAPNAME CALL*			LDA		#MAPNAME			STA		WS_COMBUF			LDA		#$04		;GROUP			STA		WS_COMBUF+1;			LDY		#$11		;MOVE CREATER NAME ONTO CARD			LDA		[ZP0],Y			STA		<SRCBUF			INY			LDA		[ZP0],Y			STA		<SRCBUF+1			INY			LDA		[ZP0],Y			STA		<SRCBUF+2;			LDA		#WS_COMBUF+2			STA		<DESTBUF			LDA		#>WS_COMBUF+2			STA		<DESTBUF+1			LDA		#^WS_COMBUF+2			STA		<DESTBUF+2;			LDA		#$20			STA		<COUNT			LDA		#00			STA		<COUNT+1								;			JSR		BUFFMOVE;			LDX		WS_COMBUF+2	;LENGTH OF STRING			INX			INX			INX			STX		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING			BCC		SETACC00_CC	;CALL IS OK !!!;			LDA		#$0D		;GROUP NOT FOUND			CLC			JMP		EXIT_PFI** SAVE GROUP IDS IN PL*SETACC00_CC	; 			LDY		#$03SETACC0_CCC	; 			LDA		WS_COMBUF,Y			STA		PRO_TIME,y			dey			Bpl		SETACC0_CCC;;** STUFF COMMAND FOR SET DIR PARAMETERS*SETACC1	; 			LDA		#SETDIRPARMS			STA		WS_COMBUF	;SAVE COMMAND			STZ		WS_COMBUF+1** STUFF VOLUME AND DIRECTORY IDS*			JSR		STUFF_IDS** STUFF BITMAPS*			LDY		#$04			LDA		[ZP0],Y			AND		#%01100000	;SAVE USER AND/OR GROUP ID BITS			ASL		A			STA		WS_COMBUF+$08			LDA		#$10			BIT		WS_COMBUF+$08			BPL		_LOCAL32			ORA		#04_LOCAL32	BVC		_LABEL32			ORA		#08_LABEL32	STA		WS_COMBUF+$08	;HB OF BITMAP			STZ		WS_COMBUF+$09	;LB OF BITMAP** STUFF PATHNAME*			SEC					;PADDING NEEDED			LDX		#$0A		;OFFSET TO PATHNAME IN PACKET			JSR		PATH2BUF	;SAVE PATH IN PACKET** ADD USER ID BYTES IF PRESENT*			LDA		WS_COMBUF+$08			AND		#%00000100			BEQ		SETACC2AA	;NO;			LDY		#$00SETACC2A	; 			LDA		AFP,y			STA		WS_COMBUF,X			INX			INY			CPY		#$04			BNE		SETACC2A	;MORE TO MOVE** ADD GROUP ID BYTES IF PRESENT*SETACC2AA	; 			LDA		WS_COMBUF+$08			AND		#%00001000			BEQ		SETACC2B	;NO;			LDY		#$00SETACC2	; 			LDA		PRO_TIME,y			STA		WS_COMBUF,X			INX			INY			CPY		#$04			BNE		SETACC2		;MORE TO MOVE** SAVE ACCESS RIGHTS IN PACKET*SETACC2B	; 			stz		ws_combuf,x	;set user access byte to zero			inx			LDY		#$06SETACC2C	; 			LDA		[ZP0],Y			STA		WS_COMBUF,X			INX			INY			CPY		#$09			BNE		SETACC2C	;MORE TO MOVE** TIME TO CALL ASP COMMAND CALL FOR SET DIR PARMS*			STX		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING			LDA		#$00			BCC		SETACC5		;CALL COMPLETE;;ERROR = UNABLE TO SET ACCESS			LDA		Cn_PFIERR			CMP		#$66		;NOT FOUND			BNE		SETACC3			LDA		#$0E			BRA		SETACC5;SETACC3	; 			CMP		#$78		;ACCESS DENYIED			BNE		SETACC4			LDA		#$0F			BRA		SETACC5;SETACC4	; 			LDA		#$10		;SOME OTHER ERRORSETACC5	; 			CLC					;STANDARD AMOUNT TO RETURN			JMP		EXIT_PFI;;*** GET FILE ACCESS*** STUFF GET FIL/DIR INFO*GETACC0	; 			LDA		#GETFDINFO			STA		WS_COMBUF			STZ		WS_COMBUF+1;			JSR		STUFF_IDS;			STZ		WS_COMBUF+$08	;DATA FORK LENGTH, PRODOS AUX TYPE			LDA		#%00000001		;LB OF FILE BITMAP			STA		WS_COMBUF+$09	;ATTRIBUTES;			LDA		#%00011100		;HB OF DIR BITMAP			STA		WS_COMBUF+$0A	;ACCESS,CREATOR ID, GROUP ID			STZ		WS_COMBUF+$0B	;ATTRIBUTES,MOD DATE, CREATE DATE;			CLC					;NOT PADDING			LDX		#$0C			JSR		PATH2BUF	;MOVE PATHNAME TO BUFR;			JSR		CMD_ROUTING	;EXECUTE CALL			BCC		GETACC1;			LDA		Cn_PFIERR			CMP		#$66			BNE		GETACC0_A;			LDA		#$0E		;NOT FOUND			BRA		GETACC0_AAGETACC0_A	; 			LDA		#$10		;OTHER ERRORGETACC0_AA	; 			CLC			JMP		EXIT_PFI;;** WAS THIS A DIRECTORY ?*GETACC1	; 			BIT		WS_COMBUF+$04			BMI		GETACC2;			LDA		#$0E			CLC			JMP		EXIT_PFI** SAVE ACCESS*GETACC2	; 			STZ		NAME_STAT			LDY		#$05GETACC3	; 			LDA		WS_COMBUF+$09,Y			STA		[ZP0],Y			INY			CPY		#$09			BNE		GETACC3		;MORE TO MOVE** SAVE ALL 8 ID BYTE AT WS_PATH*			LDX		#$07GETACC4	; 			LDA		WS_COMBUF+$06,X			STA		WS_PATH,X			DEX			BPL		GETACC4** DO THEY WANT THE CREATOR'S NAME ?*			LDY		#$04			LDA		[ZP0],Y			AND		#%01000000			BEQ		GETACC5		;NO THEY DO NOT** STUFF MAPID COMMAND*			LDA		#MAPID			STA		WS_COMBUF			LDA		#$01			STA		WS_COMBUF+$01;			LDX		#$03GETACC4A	; 			LDA		WS_PATH,X			STA		WS_COMBUF+$02,X			DEX			BPL		GETACC4A** TIME TO CALL ASP COMMAND CALL FOR MAPID*			LDX		#$06			STX		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING			BCC		GETACC4B;			STZ		WS_COMBUF	;NO USER NAME RETURNED			LDA		#$12			STA		NAME_STAT	;SET ERROR CODE** RETURN USER NAME TO MOTHERBOARD*GETACC4B	; ;			LDX		WS_COMBUF			INX			STX		<COUNT			LDA		#%00			STA		<COUNT+1;			LDA		#WS_COMBUF			STA		<SRCBUF			LDA		#>WS_COMBUF			STA		<SRCBUF+1			LDA		#^WS_COMBUF			STA		<SRCBUF+2;			LDY		#$0D			LDA		[ZP0],Y			STA		<DESTBUF			INY			LDA		[ZP0],Y			STA		<DESTBUF+1			INY			LDA		[ZP0],Y			STA		<DESTBUF+2;			JSR		BUFFMOVE;;*** DO THEY WANT THE GROUP'S NAME ?**GETACC5	; 			LDY		#$04			LDA		[ZP0],Y			AND		#%00100000			BEQ		GETACC6		;NO THEY DO NOT** STUFF MAPID COMMAND*			LDA		#MAPID			STA		WS_COMBUF			LDA		#$02			STA		WS_COMBUF+$01;			LDX		#$03GETACC5A	; 			LDA		WS_PATH+$04,X			STA		WS_COMBUF+$02,X			DEX			BPL		GETACC5A** TIME TO CALL ASP COMMAND CALL FOR MAPID*			LDX		#$06			STX		PKT_CNT			STZ		PKT_CNT+1			JSR		CMD_ROUTING			BCC		GETACC5B;			STZ		WS_COMBUF	;NO GROUP NAME RETURNED			LDA		#$12			STA		NAME_STAT** RETURN GROUP NAME TO MOTHERBOARD*GETACC5B	; 			LDX		WS_COMBUF			INX			STX		<COUNT			LDA		#00			STA		<COUNT+1;			LDA		#WS_COMBUF			STA		<SRCBUF			LDA		#>WS_COMBUF			STA		<SRCBUF+1			LDA		#^WS_COMBUF			STA		<SRCBUF+2;			LDY		#$11			LDA		[ZP0],Y			STA		<DESTBUF			INY			LDA		[ZP0],Y			STA		<DESTBUF+1			INY			LDA		[ZP0],Y			STA		<DESTBUF+2;			JSR		BUFFMOVE** ALL DONE*GETACC6	; 			LDA		NAME_STAT			LDY		#$09			SEC			JMP		EXIT_PFI 			eject*** COMMAND $33 = FINAMING - SET PFI NAMING CONVENTION**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $32	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	|	GET/SET FLAG	(1)|*	---------------------*	5	|	NAMING MODE	(1)|** -- BOTH*	---------------------*** BIT 7 SET FOR GET/SET FLAG MEANS SET NAMING* BIT 7 SET FOR	NAMING MODE MEANS PFI NAMING**		EXPORT	CFINAMINGCFINAMING		;					jsr		CheckAsync	; 7-Oct-91 MSD						jsr		setup** IS IT GET OR SET MODE ?*			LDY		#$5			LDA		[ZP0],Y		;GET NAMING MODE			AND		#%11000000	;STRIP UNWANTED BITS			STA		[ZP0],Y			DEY					;MOVE INDEX TO FLAG FIELD			LDA		[ZP0],Y			AND		#%11000000	;STRIP UNWANTED BITS			STA		[ZP0],Y* GET / SET NAMING OR GO CHECK DEVICE			LDA		[ZP0],Y			BEQ		GETMODES	;GET INFO			BMI		SETNAMING	;SET NAMING MODE			JMP		DEVICECHK	;GO CHECK DEVICE UPDATE INFOGETMODES	; 			INY			LDA		PFI_NAMING	;GET FLAG			STA		[ZP0],Y		;SAVE MODE			BRA		FINAMING_X** SAVE IN MODE*SETNAMING	; 			INY			LDA		[ZP0],Y			AND		#%10000000	;LOOK ONLY AT BIT 7			STA		UWORK1		;SAVE NEW NAMING MODE			LDA		PFI_NAMING	;CHECK AGAINST OLD MODE			AND		#%10000000			CMP		UWORK1		;DID A CHANGE OCCUR			BEQ		DEVICECHK	;NO GO LOOK AT BIT 6			LDA		PFI_NAMING			AND		#$7F		;ONLY WANT BIT 7			ORA		UWORK1			STA		PFI_NAMING;			BIT		PFI_NAMING			BMI		SETNAMING0;			LDA		PRO_PREFIX			BNE		DEVICECHK	;GO CHECK BIT 6			BRA		SETNAMING1;SETNAMING0	; 			LDA		AFP_PREFIX			BNE		DEVICECHK	;THERE IS A PREFIX;SETNAMING1	; 			STZ		CN_PFIXPTR	;NO PREFIX** IS THIS A SET FOR DECIVE TABLE UPDATE ?*DEVICECHK	; 			LDY		#4			LDA		[ZP0],Y			AND		#%01000000			BEQ		FINAMING_X	;LEAVE, BIT NOT SET** REMOVE DEVICES*			LDA		#00			;ALL DEVICES			CLC			JSR		PDOS_DEVICE** SAVE IN UPDATE MODE*			LDY		#5			LDA		[ZP0],Y			AND		#%01000000	;CHECK BIT 6			STA		UWORK1			LDA		PFI_NAMING			AND		#%10111111			ORA		UWORK1			STA		PFI_NAMING** UPDATE GLOBAL PAGE INFO*			LDA		#00			;ALL DEVICES			SEC					;ADD ALL NETWORK DEVICES			JSR		PDOS_DEVICE** UPDATE PARAMATER LIST*FINAMING_X	; 			LDA		#00			LDY		#06			SEC			JMP		EXIT_PFI;			eject;;*** COMMAND $34 = Convert Time**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $34	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	|	From Format	(1)|*	---------------------*	5	|	From Date/Time	(4)|**	---------------------*	9	|	To Date/Time	(4)| **	---------------------**	EXPORT	CONVERT_TIME	Convert_Time		jsr		CheckAsync				jsr		setup** Do they want the time in AFP Format ?*		Ldy		#$04		lda		[ZP0],y		beq		Get_AFP** Place date & time in parameter list*		ldy		#$05CN_lp1	lda		[ZP0],y		sta		PRO_Time-5,y		iny		cpy		#$09		bne		CN_lp1** check for valid time*		jsr		CHK_PROTIME		BCS		CNVRT1				LDA		#$14		BRA		CNVRT_EXIT** Convert from prodos into AFP*CNVRT1	 		JSR		PRO2CLK		JSR		CLK2STD		jsr		STD2AFP** Move AFP Time into PL*		ldy		#$09CN_lp2	lda		AFP-9,y		sta		[ZP0],y		iny		CPY		#13		bne		CN_lp2		lda		#$00		Bra		CNVRT_EXIT;;;Get_AFP	 ** Place date & time in parameter list*		ldy		#$05CN_lp3	lda		[ZP0],y		sta		AFP-5,y		iny		cpy		#$09		bne		CN_lp3** Convert from AFP into prodos *		JSR		AFP2STD		JSR		STD2CLK		jsr		CLK2PRO** Move PRODOS Time into PL*		ldy		#$09CN_lp4	lda		PRO_TIME-9,y		sta		[ZP0],y		iny		CPY		#13		bne		CN_lp4		LDA		#$00		BRA		CNVRT_EXIT** if on board just return*CNVRT_EXIT			ldy		#$0d		sec		jmp		Exit_PFI		;		;*** SUBROUTINE - SESSION REFERENCE NUMBER CHECK** ENTRY : ZP0 = PARAMTER LIST** EXIT	: C	= SET MEANS NOT VALID*	SESS_IDX = OFFSET IN TABLE OF SESSION*		EXPORT	SESS_CHKSESS_CHK		;		** IS THIS A VALID SESSION REFERENCE NUMBER ?*			LDY		#$04			LDA		[ZP0],Y			BEQ		SESS_CHK1A	;ERROR - INVALID SESSION;			LDX		#$00SESS_CHK1	; 			CMP		SESSION_TBL,X			BEQ		SESS_CHK2	;MATCH !!!			INX			CPX		#MAXSESSION			BNE		SESS_CHK1	;LOOK AT THE NEXT SESSION** UNABLE TO FIND SESSION NUMBER*SESS_CHK1A	; 			SEC			RTS** SESSION NUMBER IS FOUND*SESS_CHK2	; 			STX		SESS_IDX			CLC			RTS;;*** PFI EXIT ROUTINE**	ENTER : A = RESULT CODE*	C = STANDARD AMOUNT TO RETURN*	Y = AMOUNT TO RETURN*	FI_HEAP = HEAP NUMBER**		EXPORT	EXIT_PFIEXIT_PFI		;					LDY		#$02			STA		[ZP0],Y		;SAVE RESULT CODE - LB			CMP		#$00			BEQ		EXIT_PFI1			LDA		#FI_LEVELEXIT_PFI1	; 			INY			STA		[ZP0],Y		;SAVE RESULT CODE - HB								;			rtl					;return to dispatcher*** CLOSE A SESSION** ENTRY : SESS_IDX = INDEX TO SESSION_TBL**		EXPORT	CLOSE_SESSIONCLOSE_SESSION		;		** FIND THE ASP HEAP*			JSR		getzp1parm	;put pointer to parm list in zp1** CREATE ASP CLOSE PL*			LDY		#$00			LDA		#00			STA		(ZP1),Y		;SAVE SYNC FLAG			INY			LDA		#CMD_ASPCLO	;SAVE CLOSE COMMAND CODE			STA		(ZP1),Y			LDY		#$08			LDX		SESS_IDX			LDA		SESSION_TBL,X			STA		(ZP1),Y		;SAVE REFERENCE NUMBER** ISSUE ASP CALL*			JSR		NETWORK_CALL** REMOVE SESSION FROM TABLE (REGARDLESS OF RESULT)*			LDX		SESS_IDX			STZ		SESSION_TBL,X** TIME TO LEAVE SUBROUTINE*			RTS*** UNMOUNT A VOLUME** ENTRY : X = INDEX TO TABLES*	(X REMAINS UNCHANGED !!!)*		EXPORT	VOL_UNMOUNTVOL_UNMOUNT		;		** DO I NEED TO SEND A PACKET TO THE SERVER ?*			sta		UM_INDEX	;Save session table index #			PHY			PHP			CPY		#00			BEQ		VU_OVER			STY		PFI_NODEV	;UPDATE FLAG FOR DELAYED ACTIONVU_OVER		PLP			STX		NDT_IDX2	;SAVE TO UNMOUNT VOLUME			BCC		VOL_UN0		;NO !!!** CREATE CLOSE VOLUME AFP PACKET*			LDA		#CLOSEVOL			STA		WS_COMBUF			STZ		WS_COMBUF+1;			LDA		NDT_IDH,X			STA		WS_COMBUF+2			LDA		NDT_IDL,X			STA		WS_COMBUF+3** ISSUE AFP CLOSE VOLUME COMMAND* (REGARDLESS OF RESULT CONTINUE TO REMOVE)*			LDA		#$04			STA		PKT_CNT			STZ		PKT_CNT+1;			LDX		NDT_IDX2			LDA		NDT_SESS,X			STA		CURSESS		;SAVE SESSION REF #;			JSR		CMD_ROUTING** FIND OPEN SPACE IN AUN TABLE IN RAM*VOL_UN0		LDX		NDT_IDX2			LDA		NDT_UNIT,X			AND		#%11110000	;HIGH NIBBLE ONLY			beq 	VOL_UN2a			;			LDY		#$00VOL_UN1		LDA		AUN_RAM,Y			BEQ		VOL_UN2		;SPACE FOUND			INY			BRA		VOL_UN1		;LOOK AT THE NEXT SPACE** SAVE FREED UNIT NUMBER IN AUN TABLE*VOL_UN2		LDX		NDT_IDX2			LDA		NDT_UNIT,X			AND		#%11110000	;HIGH NIBBLE ONLY			STA		AUN_RAM,YVOL_UN2a	PLY			BNE		VU_SKIP			;			cmp		#00			;Don't remove device #0 from PRODOS			beq		VU_SKIP		;device table.  (It doesn't exist)			CLC			JSR		PDOS_DEVICE	;REMOVE FROM LOCAL DEVICE TABLE			;			;----> should we call the unmount vector			;VU_SKIP		lda		#$00			ldx 	#$03VOL_UN3		ora		Vector_unMnt,x			dex			bne		VOL_UN3			cmp		#$00			bne		@L1			jmp		VOL_UN9			;no Vector installed									;Changed from VOL_UN4 -> VOL_UN9  11/17/88  **TGH			;			;@L1			LDX		NDT_IDX2			lda		NDT_SESS,X			sta		WS_ComBuf			lda		NDT_UNIT,x			stA		WS_ComBuf+1			;			LDA		NDT_IDH,X			STA		WS_COMBUF+30			LDA		NDT_IDL,X			STA		WS_COMBUF+31			;			;			lda		#<NDT_NAME			sta		ZP3			lda		#>NDT_NAME			sta		ZP3+1			;Vol_UN4		dex			bmi		 VOL_UN5			CLC			LDA		ZP3			ADC		#NDT_NAMELEN			STA		ZP3			LDA		ZP3+1			ADC		#$00			STA		ZP3+1			bra		Vol_UN4			;VOL_UN5		lda		(ZP3)			tayVOL_UN6		lda		(ZP3),y			sta		WS_Combuf+2,y			dey			bpl		VOL_UN6			;			lda		(ZP3)			tay			lda		#$00VOL_UN7		iny			cpy		#ndt_namelen			beq		VOL_UN8			sta		ws_combuf+2,y			bra		Vol_UN7			;VOL_UN8		LDA		#<SESSION_NAME			STA		ZP2			LDA		#>SESSION_NAME			STA		ZP2+1			LDA		#<SESSION_NET			STA		ZP4			LDA		#>SESSION_NET			STA		ZP4+1			ldx		UM_INDEX@L0			dex 			bmi		@L1			clc			LDA		ZP2			adc		#$21			sta		ZP2			LDA		ZP2+1			adc		#$00			STA		ZP2+1			clc			LDA		ZP4			adc		#$22			sta		ZP4			LDA		ZP4+1			adc		#$00			STA		ZP4+1			BRA		@L0@L1			ldy		#$20			;Move server name@L2			lda		(ZP2),y			sta		ws_combuf+$3E,y			dey			bpl		@L2			ldy		#$21			;Move network name@L3			lda		(ZP4),y			sta		ws_combuf+$5F,y			dey			bpl		@L3;; Call the vector now;			longi	on			longa 	on			;			REP		#$30			phb			ldx		#VOL_UN9-1			;Put my return Address on the Stack			phx			;			longa 	off			longi	off			SEP		#$30			lda		VECTOR_unmnt+2			pha			longi	on			longa	on			;			rep		#$30			ldx		VECTOR_unmnt		;Put vector on stack			dex			phx			;			Ldx		#ws_combuf			Ldy		#^ws_combuf			rtl			;			longi	off			longa 	off			;			;** CLEAR SESSION NUMBER FROM NDT* ENTRY IS NOW AVAILABLE FOR OTHERS*VOL_UN9		Sep		#$30			LDX		NDT_IDX2			STZ		NDT_SESS,X			DEC		NDT_CNT		;REDUCE COUNT OF ACTIVE NDT VOL			INC		AUN_CNT		;ONE MORE AVAILABLE UNIT			RTS;;*** TRANSLATE AFP LOGIN ERROR INTO PFI result code** ENTRY : Cn_PFIERR = AFP ERROR (LB)** EXIT  : A         = PFI RESULT CODE*		EXPORT	LOGIN_ERRORLOGIN_ERROR		;		** Is this  a user not auth error ?*			LDA		Cn_PFIERR;			LDX		#$04le_NEXT		CMP		log_afperr,x			BEQ		le_FOUND			DEX			BPL		le_NEXT** ASSUME --> no response from server*			LDA		#$03			RTS** FOUND AFP ERROR TRANSLATE IT*le_FOUND	LDA		log_pfierr,x			RTS;;log_afperr	; 	DC.B	$5d	;server going down	DC.B	$61	;user not auth	DC.B	$65	;parm error	DC.B	$75	;bad version	DC.B	$76	;bad UAM;log_pfierr	; 	DC.B	$17	DC.B	$15	DC.B	$16	DC.B	$19	DC.B	$18;;*** COMMAND $37 = CFIHOOKS**	---------------------*	0	|	ASYNC FLAG = $00	|*	---------------------*	1	|	COMMAND	= $37	|*	---------------------*	2	|	RESULT CODE	(2)| **	---------------------*	4	|	Active8 	(1)|*	---------------------*	5	|	Mount Vector	(4)|*	---------------------*	9	|	Unmount Vector	(4)| *	---------------------*	d	|	Attention Vector(4)| *	---------------------**	EXPORT	CFIHooksCFIHooks		jsr		CheckAsync				jsr		setup		;standard setup stuff**	Save information*		ldy		#$04		lda		[zp0],y		bit		#$40			;If bit 6 is one (x1xx xxxx)		bne		@L1				;we set the information		lda		Active8			;Else we just return the info		sta		[Zp0],y			;OS Flag byte type		ldx		#$00			;Now the 3 following vectors...		iny						;Mount, Unmount, and Attention.@L2		lda		Vector_Mount,x		sta		[Zp0],y		inx		iny		cpy		#$11		bne		@L2		jmp		FIHooks_X@L1		and		#$80			;Strip off any other flags.		sta		Active8		ldx		#$00		inyhooks1	lda		[Zp0],y		sta		Vector_Mount,x		inx		iny		cpy		#$11		bne		hooks1** let fix the NDT_Unit table*		lda		ACTIVE8		bne		hooks4** GS/OS is active just Zero out Unit numbers*		ldy		#13hooks2	lda		NDT_Sess,y 		beq		hooks3		lda		NDT_unit,y		AND		#$0F		STA		NDT_UNIT,yhooks3	dey		bpl		hooks2		Bra		FIHooks_X**** ProDOS 8 Is Now Active Find Available units**** FIND AVAILABLE UNIT NUMBERS ON THIS WORKSTATION*hooks4		LDA		#LCL_DEVCNT			STA		<DESTBUF			LDA		#>LCL_DEVCNT			STA		<DESTBUF+1			LDA		#^LCL_DEVCNT			STA		<DESTBUF+2;			LDA		#<DEVCNT			STA		<SRCBUF			LDA		#>DEVCNT			STA		<SRCBUF+1;			LDA		PFI_BANK			STA		<SRCBUF+2	;BANK OF PL;;			LDA		#$0F		;7 SLOT2 * 2 DRIVERS +1 COUNT BYTE			STA		<COUNT			LDA		#00			;MOVE ONTO THE CARD			STA		<COUNT+1;			JSR		BUFFMOVE** MOVE ALL POSSIBLE UNIT NUMBERS FROM ROM TABLE INTO RAM*			LDX		#0ws_LOOP3	LDA		PUN_ROM,X	;POSSIBLE UNIT NUMBERS			STA		AUN_RAM,X	;AVAILABLE UNIT NUMBERS			INX			CPX		#14			BCC		ws_LOOP3			stx		AUN_CNT			LDA		#$FF			STA		AUN_RAM,X	;END INDICATOR** ZERO EVERY UNIT NUMBER IN AUN_RAM WHICH IS ACTIVE IN* THE LOCAL PRODOS DEVICE LIST*			LDX		LCL_DEVCNT			INX					;PRODOS SAVES 'DEVCNT-1'			BEQ		ZUN4		;THERE ARE NO LOCAL DEVICESZUN			LDA		LCL_DEVCNT,X			AND		#$F0		;STRIP 'DISK-TYPE' BITS			LDY		#13ZUN1		CMP		AUN_RAM,Y			BEQ		ZUN2		;ZERO IT OUT			DEY			BPL		ZUN1		;HAVN'T FINISHED LIST YET			BRA		ZUN3		;FINISHED LISTZUN2		LDA		#$00			STA		AUN_RAM,Y			DEC		AUN_CNT		;DECREMENT AVAIL UNIT COUNTZUN3		DEX					;NEXT DEVICE ENTRY			BNE		ZUN			;MORE ENTRIES TO PROCESS** update the NDT_table*ZUN4	ldy		#13				;Change from a 00 to a 13 11/4/88 **TGHZUN5	lda		NDT_Sess,y 		beq		ZUN6		;		ldx		#00ZUN5a	lda		AUN_Ram,x		bne		ZUN5b		;one found		inx		CPX		#14				;Change from a $14 to a 14 11/4/88 **TGH		bne		ZUN5a		BRA 	FIHooks_X	;No more Unit NUmbers Available							;ZUN5b	ora		NDT_unit,y		STA		NDT_UNIT,y		stz		AUN_RAM,xZun6	dey		bpl		ZUN5** UPDATE PARAMATER LIST*FIHooks_X	; 		LDA		#00		LDY		#06		SEC		JMP		EXIT_PFI		ENDP		end