;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	IMPORT	ADJUST	IMPORT	AFP	IMPORT	CENT	IMPORT	CLK_BUF	IMPORT	DA	IMPORT	DIVID	IMPORT	DIVIS	IMPORT	DT	IMPORT	HR	IMPORT	MIN	IMPORT	MO	IMPORT	MULT1	IMPORT	MULT2	IMPORT	PROD	IMPORT	PRO_TIME	IMPORT	QUOT	IMPORT	REMAIN	IMPORT	SEC	IMPORT	YR	IMPORT	YR4	IMPORT	afp_pfx_dev	IMPORT	afp_pfxloc	IMPORT	chk_prodos	IMPORT	chkslash	IMPORT	cmd_routing	IMPORT	cn_devnum	IMPORT	fnd_cursrv	IMPORT	path2buf	IMPORT	pfi_naming	IMPORT	pro_pfx_dev	IMPORT	pro_pfxloc	IMPORT	secondname	IMPORT	strip_prefix	IMPORT	stuff_ids	IMPORT	tempv	IMPORT	uerror	IMPORT	ws_combuf	IMPORT	ws_path	IMPORT	xpath2card;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	DC_TBL	ENTRY	DIVIDE	ENTRY	MC_TBL	ENTRY	MO_2	ENTRY	MO_ADJ	ENTRY	MO_DAYS	ENTRY	MULT** pfi_cmdsubs6** Greg Seitz (14-Jul-87)** clock and misc routines;		EXPORT	zpcmdscs6	;zpcmdscs6	PROC		INCLUDE	'zp.equates';		ENDP		include	'global.equates'		include	'pfi_equates'				EXPORT	pficmdsubs6	pficmdsubs6	PROC			longa	off			longi	off* routines for changepath command*** checkvalidpath* takes path in ws_path checks to see if it is a valid name, and that* it is a name on a network volume.** X: points to where in users parmlist the pathname field exists.** exit* carry is clear if no error* carry set if badname or not network volume (A=error result)*		EXPORT	checkvalidpathcheckvalidpath		;					jsr		xpath2card		;move up parmlist at x			bcs		badname			;couldn't get name			lda		ws_path			;see if len is zero or one			beq		badname			;it is zero, error			cmp		#$02			bcs		cvp1			;so far so good			lda		ws_path+1		;check only char			cmp		#slash			beq		badname			;a bad name since only a slashcvp1		bit		pfi_naming		;see if in prodos mode			bmi		cvp2			;in afp mode			jsr		chk_prodos		;see if valid name under prodos			bcs		badname			;nopecvp2		jsr		chkslash			;see if volume			bcs		isvol			;yes it is			bit		pfi_naming		;see if prodos			bmi		cvp3			;no, afp mode			lda		pro_pfxloc			cmp		#$ff			;see if local			beq		accesserr			lda		pro_pfx_dev		;get device number			bra		isvalidcvp3		lda		afp_pfxloc			cmp		#$ff			beq		accesserr		;local prefix, not valid network call			lda		afp_pfx_devisvalid	; 			and		#%11110000			sta		cn_devnumgoodname	; 			clc						;no error occurred			rts						;and returnbadname	; 			lda		#$40			;invalid pathname			bra		seterraccesserr	lda		#$4e			;not on a network volumeseterr	; 			sta		uerror			sec			rts						;return with errorisvol	; 			jsr		fnd_cursrv		;see if we have this volume			bcs		accesserr		;volume not mounted			jsr		strip_prefix		;strip off the prefix if there is one that matches			bra		goodname		;and leave in good condition** command $45= changepath*		EXPORT	changepathchangepath		;					lda		#movecmd		;afpmove			sta		ws_combuf			stz		ws_combuf+1			ldx		#1				;get first parm list			jsr		checkvalidpath		;see if path is ok			bcs		cperr			;change path error, leave			jsr		stuff_ids			;stuff id's for it			ldx		#5				;move data from ws_combuf to temp spacecplp1	; 			lda		ws_combuf+2,x	;get data for volid and dirid			sta		tempv,x			;and move it			dex			bpl		cplp1			;keep moving			clc						;no padding			ldx		#12			;move pathname into combuf			jsr		path2buf			phx						;save position of next item in buf			ldx		#3				;get second parm list			jsr		checkvalidpath			bcc		cpcp			;no error			plx						;remove unused position of where to move dest pathcperr	; 			sep		#mbit+xbit			lda		#$40			sta		uerror			rtscpcp	; 			jsr		stuff_ids			;stuff id's for it			plx						;get position of where to move dest path			rep		#mbit+xbit			longa	on			longi	on				;full native			ldy		#0000cplp2	; 			lda		ws_combuf+4,y	;get dir id byte			sta		ws_combuf+8,y 	;move it to dest dir id			lda		tempv+2,y		;get dirid from first name			sta		ws_combuf+4,y	;and put it back			iny			iny			cpy		#4				;see if done moving			bne		cplp2			;not yet			lda		tempv			;see if volumes match			cmp		ws_combuf+2			bne		cperr 			phx						;save pointer in combuf 			jsr		breakname		;break name in two 			plx						;recover pointer in combuf			sep		#mbit			;path2buf needs 8 bit a			longa	off			clc						;no padding			jsr		path2buf			;and move second name in 			lda		secondname		;get len of second name 			tay						;strip high bytemvscnm	;  			lda		secondname,y		;move secondname to ws_path 			sta		ws_path,y 			dey			bpl		mvscnm						clc			jsr		path2buf			;and move third name in*			lda		#02*			sta		ws_combuf,x*			lda		#00*			sta		ws_combuf+1,x	;no rename so put nothing there*			inx*			inx*			stx		pkt_cnt			sep		#mbit+xbit		;back to 8 bit mode			longa	off			longi	off			jmp		cmd_routing		;make the callbreakname	; 			php			sep		#mbit+xbit			longa	off			longi	off			ldx		ws_path			;get len			lda		ws_path,x		;get last char			cmp		#slash			;see if a '/'			bne		splitup			;no so split name			dex			stx		ws_path			;save new lensplitup	; 			lda		ws_path,x		;get char			cmp		#slash			beq		dosplit			;found location to break maybe			dex			bne		splitup			;not yet zero			bra		dosplit			;we hit zero so we must split nownosecondname	stz		secondname		;secondname len is zero			bra		splexitdosplit	; 			phx						;save new len			lda		ws_path			;get original len			sec			sbc		$1,s			;subtract new len			cmp		#33			;see if too large			bcs		nosecondname		;make sure it fails			sta		secondname		;set length of second name			plx						;recover new len of first part			stx		ws_path			;set new len of first part			ldy		#00spmove	; 			lda		ws_path+1,x		;get name of second part			sta		secondname+1,y			iny			inx			cpy		secondname		;see if at end			bcc		spmove			;not yetsplexit	; 			plp			rts						;and return**------------------------**	TABLES FOR DAY OF WEEK CONVERSION_*MOTAB	DC.B	5,1,0,3,5,1,3,6,2,4,0,2YRTAB	DC.B	5,6,0,2,3,4,5,0,1,2,3,5,6,0,1**------------------------***	CONVERT TO PRODOS FORMAT (USED BY PFI & SERVER*	DRIVERS).*		EXPORT	b1_clk2prob1_clk2pro		;				EXPORT	CLK2PROCLK2PRO		;					LDA		CLK_BUF+8	; GET MONTH			ASL		A			ASL		A			ASL		A			ASL		A			ASL		A			; MSB OF MONTH TO CARRY			ORA	CLK_BUF+7	; 'ADD' IN DAY OF MONTH			STA	PRO_TIME			LDA		CLK_BUF+9	; GET YEAR			ROL		A			; MSB OF MONTH TO LSB OF [A]			STA	PRO_TIME+1			LDA		CLK_BUF+2	; GET MINUTES			STA	PRO_TIME+2			LDA		CLK_BUF+4	; GET HOURS			STA	PRO_TIME+3			RTS**--------------------------**	CONVERT FROM PRODOS TO CLOCK FORMAT (USED BY PFI **	SERVER DRIVERS).*		EXPORT	b1_pro2clkb1_pro2clk		;				EXPORT	PRO2CLKPRO2CLK		;					LDA		PRO_TIME+3	; GET HOURS			STA	CLK_BUF+4			LDA		PRO_TIME+2	; GET MINUTES			STA	CLK_BUF+2			LDA		PRO_TIME+1	; GET YEAR, MSB OF MONTH			LSR		A			; MONTH MSB TO CARRY			STA	CLK_BUF+9	; YEAR			TAY					; SAVE FOR D-O-W CONVERSION			LDA		PRO_TIME	; GET MONTH, DAY			ROR		A			; TACK ON MONTH BIT			LSR		A			LSR		A			LSR		A			LSR		A			; POSITION			STA	CLK_BUF+8	; MONTH			TAX				; SAVE FOR D-O-W CONVERSION			LDA		PRO_TIME	; GET DAY			AND	#%00011111	; DROP MONTH DATA			STA	CLK_BUF+7**	DO THE CONVERSION FOR DAY-OF-WEEK_	THIS CONVERSION*	FALLS APART AFTER FEBRUARY, 2012* AND BEFORE MARCH, 1985_*			CPX		#3			; MONTH GREATER THAN 2?			BCS		DOW1		; IF SO, USE SAME YEAR			DEY					; ELSE PRETEND IT IS LAST YEARDOW1		CPY		#85		; LESS THAN '85 IS NEXT CENTURY			BCC		DOW2			LDA		YRTAB-85,Y	; WORKS FOR '85 - '99			BRA	DOW3		; SKIP OVER OTHER TABLE FETCHDOW2		LDA		YRTAB+3,Y	; WORKS FOR '00 - '11DOW3		CLC			ADC	MOTAB-1,X	; ADD IN OFFSET FOR MONTH OF YEAR			ADC	CLK_BUF+7	; ADD IN DAY OF MONTH			DEC		A			; COMPENSATE FOR DAY OF MONTH OFFSET			SECDOW4		SBC		#7			; DO MOD 7 OPERATION			BCS		DOW4		; SUBTRACT UNTIL WE GO NEG			ADC	#7			; ADD ONE BACK			INC		A			; CONVERT TO 1-7			STA	CLK_BUF+6			RTS**	THIS IS THE DEFAULT TIME VALUE, USED WHEN THE CLOCK BATTERY*	HAS BEEN REPLACED OR HAS RUN-DOWN. (MIDNIGHT, MARCH 1, 1985).*		EXPORT	PRO_DEFPRO_DEF		;			DC.B	$61	; MARCH 1	DC.B	85*2	; 1985	DC.B	0,0	DC.B	0,0			eject** DRIVER SUBROUTINE: CHK_PROTIME -CHECK PRODOS TIME FORMAT**	ENTRY: PRO_TIME = PRODOS TIME**	EXIT:	[CARRY] = ERROR INDICATOR (CLEAR= FAILED)**		EXPORT	b1_chk_protimeb1_chk_protime		;				EXPORT	CHK_PROTIMECHK_PROTIME		;		** IS THE DATE LATER THAN THE DEFAULT DATE ? (MARCH 1,1985)*; SEC; LDA PRO_TIME; SBC PRO_DEF ;DEFALUT BYTE #1; LDA PRO_TIME+1; SBC PRO_DEF+1 ;DEFALUT BYTE #2; BCC XCHK_PROTIME ;ERROR, DATE TO EARLY !!!** IS THE MONTH IN A VALID RANGE ?*			LDA		PRO_TIME+1			AND	#%00000001	;SAVE ONLY LOW BIT			ROR		A			;SHIFT INTO CARRY*			LDA		PRO_TIME			ROR		A			;ROLL IN CARRY INTO HIGH BIT			AND	#%11110000	;SAVE HIGH FOUR BITS			BNE		CHK_PROTIME1	;THERE IS A MONTH			CLC			RTS					;ERROR, MONTH VALUE WAS ZERO*CHK_PROTIME1	; ;IS RANGE OK ?			CMP	#$D0		;LARGEST POSSIBLE MONTH+1			BCC		CHK_PROTIME2	;NO ERROR			CLC			BRA	XCHK_PROTIME	;ERROR,MONTH TOO LARGE** IS MINUTES IN A VALID RANGE ?*CHK_PROTIME2	; 			LDA		#59			CMP	PRO_TIME+2			BCC		XCHK_PROTIME	;ERROR,MINUTE VALUE TOO LARGE** IS HOUR IN A VALID RANGE ?*			LDA		#23			CMP	PRO_TIME+3*XCHK_PROTIME	RTS*************************************************************	CONVERT BETWEEN STANDARD AND AFP TIME**	WRITTEN BY HOWARD W. RIDENOUR*************************************************************	CONVERT AFP TIME TO LOCAL TIME IN STANDARD*	FORMAT**	ENTRY:	AFP TIME IN AFP - HIGH TO LOW ORDER*	EXIT:	TIME IN STD***********************************************************		EXPORT	b1_afp2stdb1_afp2std		;				EXPORT	AFP2STDAFP2STD		;		** CONVERT TO TIME IN SECONDS SINCE JAN 1ST 1929* FOR LOCAL TIME ZONE*			LDY		#3			LDA		AFP			EOR		#$80		;INVERT HI BIT			STA	AFP			CLCALOOP1		LDA		AFP,Y		;ADJUST TO JAN 1ST 1929 + ZONE			ADC	ADJUST,Y			STA	AFP,Y			DEY			BPL		ALOOP1** NOW USE CONSTANT TABLE AND DIVIDE TO CONVERT*			LDX		#0			LDY		#0ALOOP2		PHX			LDX		#3ALOOP3		LDA		DC_TBL,Y	;GET NEXT DIVISOR			STA	DIVIS,X			INY			DEX			BPL		ALOOP3			LDX		DC_TBL,Y	;GET POWER FACTOR			INY			PHY			JSR		DIVIDE		;DIVIDE IT			PLY			LDA		QUOT			PLX			STA	DT,X		;STORE RESULT IN STD			INX			CPX		#6			;ALL DONE DOWN TO SECS			BNE		ALOOP2			LDA		DIVID+3			STA	SEC			LDA		#28			;INIT FEB = 28 DAYS			STA	MO_2** HANDLE SPECIAL CASE OF 12/31 ON LEAP YEAR* IT GETS CALCULATED AS 1/1 OF THE NEXT YEAR** THIS ROUTINE CHECKS TO SEE IF YR = 4* THIS SHOULD NEVER OCCUR BECAUSE EVERY* 4 YEAR PERIOD WITH LEAP YEAR IS DIVIDED* OUT WITH THE FACTOR PLACED IN THE 'YR4'* FIELD** DAY IS SET AT 35 BECAUSE THIS IS THE VALUE* IT WOULD HAVE HAD BEFORE LEAP YEAR DAY IS* REMOVED AND THE ADJUSTMENT IS MADE FOR MONTHS* WITH OTHER THAN 30 DAYS*			LDA		YR			CMP	#4			;YR = 4 ?			BNE		A2S_1			DEC		YR			LDA		#11			STA	MO			;MONTH = 12			LDA		#35			STA	DA			;DAY = 31 + ADJUST** TOTAL YEARS = YEARS SINCE 1929*A2S_1		CLC			LDA		YR4			;CALC TOTAL YEARS			ASL		A			;MULTIPLY BY 4			ASL		A			ADC	YR			ADC	#29			STA	YR			STZ		YR4			;ZERO 4-YR FIELD			SEC			SBC		#100		;PAST YEAR 2000?			BCC		A2S_1A			STA	YR			;YEARS = REMAINDER			INC		CENT		;INCREMENT CENTURY** CHECK FOR LEAP YEAR*A2S_1A		LDA		YR			LSR		A			;YEAR DIVISIBLE BY 4 ?			BCS		A2S_2			LSR		A			BCS		A2S_2			LDA		#29		;FEB HAS 29 DAYS			STA	MO_2			LDX		MO			CPX		#2			;PAST FEB ?			BCC		A2S_2			DEC		DA			;ADJUST FOR LEAP YEAR DAY** ADJUST FOR MONTHS NOT = 30 DAYS*A2S_2		LDA		DA			LDX		MO			SEC			SBC		MO_ADJ,X	;ADJUST FOR MONTHS NOT = 30 DAYS			STA	DA			BPL		A2S_3		;IF DAY NEG - BACKUP ONE MONTH			DEC		MO			DEX			CLC			ADC	MO_DAYS,X	;SUBTRACT FROM DAYS IN MONTH			STA	DA** CHECK FOR TOO MANY DAYS IN FEB*A2S_3		LDA		MO			CMP	#1			BNE		A2S_4			LDA		DA			SEC					;MUST SUB 1 EXTRA			SBC		MO_2		;TOO MANY DAYS IN FEB ?			BCC		A2S_4			STA	DA			INC		MO			;IF YES - GO TO NEXT MONTH** DAY AND MONTH START WITH 1 NOT ZERO*A2S_4		INC		DA			INC		MO			RTS**********************************************************	CONVERT LOCAL TIME IN STANDARD FORMAT TO*	AFP TIME**	ENTRY: LOCAL TIME IN STD*	EXIT:	AFP TIME IN AFP********************************************************		EXPORT	b1_std2afpb1_std2afp		;				EXPORT	STD2AFPSTD2AFP		;					LDA		#28			;INIT FEB = 28 DAYS			STA	MO_2** ZERO OUT ACCUMULATED PRODUCT FIELD*			LDY		#3			LDA		#0S2A_1		STA	PROD,Y		;ZERO PRODUCT			DEY			BPL		S2A_1** DAY AND MONTH START WITH 1* ADJUST TO ZERO*			DEC		DA			DEC		MO** WE WANT TO CALCULATE SECONDS SINCE 1929*			LDA		YR			LDX		CENT		;21ST CENTURY ?			BEQ		S2A_1AA			CLC			ADC	#100		;ADD CENTURY TO YEARS			STA	YRS2A_1AA	SEC			SBC		#29		;SUB 1961 FROM YEARS** DIVIDE YEARS BY 4 TO GET 4 YEAR FIELD*			STA	YR4			LSR		YR4			;DIVIDE BY 4			LSR		YR4			AND	#%00000011			STA	YR** CHECK FOR LEAP YEAR* SAVE RESULT IN WORK*			LSR		A			BCC		S2A_1A			LSR		A			BCC		S2A_1A			LDA		#29			STA	MO_2** ADJUST FOR LEAP YEAR*			LDA		MO			CMP	#2			BCC		S2A_1A			INC		DA			;ADD LEAP YEAR DAY** ADJUST FOR MONTHS NOT = 30 DAYS*S2A_1A		CLC			LDX		MO			LDA		MO_ADJ,X	;ADJUST FOR MONTHS NOT = 30 DAYS			ADC	DA			BPL		S2A_1B		;IF DAY NEGATIVE THEN DATE IS			DEC		MO			;MAR 1 ON NON-LEAP YEAR			LDA		#29			;28 DAYS FROM FEB 1S2A_1B		STA	DA** NOW MULTIPLY EACH DATE/TIME FIELD BY SECONDS PER*			LDY		#0			LDX		#0S2A_2		PHX			LDA		DT,X			STA	MULT1		;SETUP FOR MULTIPLICATION			LDX		#3SLOOP2		LDA		MC_TBL,Y			STA	MULT2,X		;SETUP SECONDS PER XXX			INY			DEX			BPL		SLOOP2			PHY			JSR		MULT		;MULTIPLY			PLY			PLX			INX			CPX		#7			;DONE ?			BNE		S2A_2** ADJUST FROM SECONDS SINCE 1929 IN LOCAL TIME ZONE* TO SECONDS TILL 2000 GREENWICH TIME*			SEC			LDY		#3SLOOP3		LDA		PROD,Y			SBC		ADJUST,Y			STA	PROD,Y			DEY			BPL		SLOOP3			LDA		AFP			EOR		#$80		;INVERT HI BIT			STA	AFP			RTS**********************************************************	MULTIPLY NUMBER IN MULT2 BY NUMBER IN MULT1*	ACCUMULATED PRODUCT IN PROD*		EXPORT	b1_multb1_mult		;				EXPORT	MULTMULT		;		M_1		LSR		MULT1		;NEXT BIT OF MULTIPLIER			BCC		M_2			LDY		#3			CLCMLOOP2		LDA		PROD,Y		;ADD TO PRODUCT			ADC	MULT2,Y			STA	PROD,Y			DEY			BPL		MLOOP2M_2		CLC			ROL		MULT2+3		;MULTIPLY MULTIPLICAND BY 2			ROL		MULT2+2			ROL		MULT2+1			ROL		MULT2			LDA		MULT1			BNE		M_1			RTS************************************************************	DIVIDE NUMBER IN DIVID BY NUMBER IN DIVIS*	QUOTIENT IN QUOT - REMAINDER IN DIVID**	ENTRY: X = POWER OF 2 BY WHICH DIVIS HAS BEEN*	PRE-MULTIPLIED (BITS LEFT SHIFTED)*		EXPORT	b1_divideb1_divide		;				EXPORT	DIVIDEDIVIDE		;					STZ		QUOTDIV_1		LDY		#3			ASL		QUOT		;MULT QUOT BY 2			SECDLOOP1		LDA		DIVID,Y			SBC		DIVIS,Y		;SUBTRACT DIVISOR			STA	REMAIN,Y			DEY			BPL		DLOOP1			BCC		DIV_2		;BORROW ?			INC		QUOT			LDY		#3DLOOP2		LDA		REMAIN,Y	;TRANSFER REMAINDER BACK TO DIVIDEND			STA	DIVID,Y			DEY			BPL		DLOOP2DIV_2		DEX					;DIVISOR SHIFTED FULL AMOUNT ?			BMI		DDONE			CLC			ROR		DIVIS		;DIVIDE DIVISOR BY 2			ROR		DIVIS+1			ROR		DIVIS+2			ROR		DIVIS+3			BRA	DIV_1DDONE		RTS********************************************************** DATA AREAS********************************************************** ADJUSTMENT CONSTANT USED TO ADJUST AFP TIME FROM* SECONDS FROM 2000 TO SECONDS SINCE 1929.	THIS* CONSTANT MUST EQUAL THE AFP TIME FOR A YEAR AFTER* A LEAP YEAR.	THIS CONSTANT IS COMBINED WITH AN* OFFSET FOR THE LOCAL TIME ZONE AND SAVED IN THE* FIELD 'ADJUST'.*		EXPORT	ADJUST_CADJUST_C		;			DC.B	$05,$8B,$B2,$00***********************************************************	DIVIDE CONSTANT TABLE**	This table contains the divisors for the AFP to*	standard time conversion.	The values used are:**	sec/4years = 126,230,400 - $07 86 1F 80*	sec/year	=	31,536,000 - $01 E1 33 80*	sec/month	=	2,592,000 - $00 27 8D 00*	sec/day	=	86,400 - $00 01 51 80*	sec/hour	=	3,600 - $00 00 0E 10*	sec/min	=	60 - $00 00 00 3C**	Each value in entered in the table multiplied by a*	power of 2 (left shifted) which is determined by the*	maximum possible result.	Each value is placed in*	the table in low byte to high byte order and is*	followed by a byte containing the exponent of 2 by*	which the number has been multiplied.*		EXPORT	DC_TBLDC_TBL		;			DC.B	$00,$F0,$C3,$F0,$05	DC.B	$00,$CE,$84,$07,$02	DC.B	$00,$D0,$78,$02,$04	DC.B	$00,$30,$2A,$00,$05	DC.B	$00,$84,$03,$00,$06	DC.B	$00,$0F,$00,$00,$06***********************************************************	MULTIPLY CONSTANT TABLE**	This table is used to convert from standard time*	in the local time zone to AFP time. The constants*	are the same as for the divide routine except that*	they are not left shifted.	They are in low byte*	to high byte order also.*		EXPORT	MC_TBLMC_TBL		;			DC.B	$80,$1F,$86,$07	DC.B	$80,$33,$E1,$01	DC.B	$00,$8D,$27,$00	DC.B	$80,$51,$01,$00	DC.B	$10,$0E,$00,$00	DC.B	$3C,$00,$00,$00	DC.B	$01,$00,$00,$00*********************************************************	DAYS PER MONTH TABLE*		EXPORT	MO_DAYSMO_DAYS		;			DC.B	31		EXPORT	mo_2mo_2		;		;need to change feb	DC.B	28	DC.B	31,30,31,30,31,31,30,31,30,31******************************************************* MONTH ADJUST TABLE**	This table contains the amount of days to be*	adjusted based on the month.	This is to*	adjust for the fact that the program uses*	30days/month in calculations.*		EXPORT	MO_ADJMO_ADJ		;			DC.B	$00,$01,$FF,$00,$00,$01,$01,$02,$03,$03,$04,$04,$05********************************************************** TIME MOVING ROUTINES*** PLACE STANDARD FORMAT IN CLOCK BUFFER*		EXPORT	b1_std2clkb1_std2clk		;				EXPORT	STD2CLKSTD2CLK		;					LDA		YR			STA	CLK_BUF+9	;YEAR			LDA		MO			STA	CLK_BUF+8	;MONTH			LDA		DA			STA	CLK_BUF+7	;DAY OF MONTH			LDA		HR			STA	CLK_BUF+4	;HOUR			LDA		MIN			STA	CLK_BUF+2	;MIN			LDA		SEC			STA	CLK_BUF+0	;SEC			RTS** PLACE CURRENT TIME IN AFP CONVERSION BUFFER*		EXPORT	b1_clk2stdb1_clk2std		;				EXPORT	CLK2STDCLK2STD		;					LDA		CLK_BUF+9	;YEAR			STA	YR;			CMP	#30			;IS IT LATTER THAN 1930?			BCC		CLK2STD1			STZ		CENT		;19TH CENTURY			BRA	CLK2STD2CLK2STD1	; 			LDA		#$01			STA	CENT		;20TH CENTURY;CLK2STD2	; 			LDA		CLK_BUF+8	;MONTH			STA	MO			LDA		CLK_BUF+7	;DAY OF MONTH			STA	DA			LDA		CLK_BUF+4	;HOUR			STA	HR			LDA		CLK_BUF+2	;MINUTE			STA	MIN			LDA		CLK_BUF+0	;SECOND			STA	SEC			RTS;			STA	MO			LDA		CLK_BUF+7	;DAY OF MONTH			STA	DA			LDA		CLK_BUF+4	;HOUR			STA	HR			LDA		CLK_BUF+2	;MINUTE			STA	MIN			LDA		CLK_BUF+0	;SECOND			STA	SEC			RTS;		ENDP		end	