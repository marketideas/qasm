** The following calls are implemented in this file:** FIListSessions2* FIGetSVersion*;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	IMPORT	NDT_IDH	IMPORT	NDT_IDL	IMPORT	NDT_NAME	IMPORT	NDT_SESS	IMPORT	NDT_UNIT	IMPORT	SESSION_TBL	IMPORT	setup	Import	SESSION_NAME	Import	SESSION_NET	Import	SESSION_VERS	Import	EXIT_PFI	IMPORT	SESS_CHK		INCLUDE	'zp.equates'		include	'global.equates'		include 'pfi_equates'*** COMMAND $39 = FILISTSESSIONS2 - LIST SESSIONS**	   ---------------------*	0 | ASYNC FLAG = $00	|*	   ---------------------*	1 | COMMAND = $2F	|*	   ---------------------*	2 | RESULT CODE	(2)	| <--*	   ---------------------*	4 | BUFFER LENGTH (2)	| -->*	   ---------------------*	6 | BUFFER POINTER (4)	| -->*	   ---------------------*	A | ENTRIES RETURNED	| <--*	   ---------------------*CFILIST2	PROC	EXPORT		import	CheckAsync		entrysize	equ	97		;One entry is 97 bytes long		jsr	CheckAsync				jsr	setup		;SAVE PL HEAP NUMBER		rep	#$30		longa	on		longi	on		stz	count		;Set source count to zero		stz	zp4+2		;Set dest count to zero;-----------------------------------------------------------------------------; Below we divide the buffer size by the entry size and store the result,; which is the total number of entries we can return in the destination; buffer, at ZP4;-----------------------------------------------------------------------------		pea	0000		;Result space		pea 	0000		;Result space		ldy	#$0004		lda	[zp0],y		pha			;Dividend		pea	entrysize	;Divisor		ldx	#$0B0B		;UDivide		jsl	>$E10000		pla			;Quotient		sta	zp4		pla			;Remainder (throw away);-----------------------------------------------------------------------------; Below we move the destination pointer onto the zero page at ZP1;-----------------------------------------------------------------------------		ldy	#$0006		;Move pointer to destination		lda	[zp0],y		;buffer onto zero page.		sta	zp1		iny		iny		lda	[zp0],y		sta	zp1+2		lda	#NDT_NAME-2	;Move pointer to NDT_NAME		sta	zp2		;buffer onto zero page.		lda	#^(NDT_NAME-2)		sta	zp2+2		ldx	#0000		;Start at volume 0ListLoop	lda	NDT_SESS,x	;Is this session number alive?		and	#$00FF		;Only low byte counts		bne	@GoodSession	;Branch if yes.		jmp	ListSkip	;Else, keep trying@GoodSession	ldy	zp4		;Check the count and make sure		bne	@GoodCount	;we can move this session into		jmp	List1Skip	;the buffer.  Branch if no room.@GoodCount	sep	#$20		;Short C for moving byte fields.		longa	off		ldy	#00		sta	[zp1],y		;Store session #		iny		lda	NDT_UNIT,x	;Load unit #		sta	[zp1],y		;Store unit #		iny		phx			;Save the session number counter		ldx	#NDT_NAMELEN-1	;Load the maximum name length@L1		lda	[zp2],y		;Move the volume name into		sta	[zp1],y		;the destination buffer.		iny			;Increment destination index		dex			;Increment source index		bpl	@L1		;Keep looping until X<0		plx			;Restore the session number counter		lda	NDT_IDH,x	;Load volume ID high byte		sta	[zp1],y		;Store it		iny		lda	NDT_IDL,x	;Load volume ID low byte		sta	[zp1],y		;Store it		iny		lda	[zp1]		;Load the unit number.		jsr	MoveNames	;Move server and net name.		rep	#$20		longa	onNextSession	clc			;Increment our destination buffer		lda	zp1		;zero page pointer to point		adc	#0097		;to the next field.		sta	zp1		lda	zp1+2		adc	#0		sta	zp1+2		clc			;Increment our source volume name		lda	zp2		;zero page pointer to point to		adc	#NDT_NAMELEN	;the next volume name.		sta	zp2		lda	zp2+2		adc	#0		sta	zp2+2		dec	zp4		;Decrement dest count		inc	zp4+2		;Increment dest counterList1Skip	inc	count		;Increment source countListSkip	inx			;Keep looper for all 14		cpx	#0014		;possible volumes.		bcs	CheckSess	;Then check session w/no volumes		jmp	ListLoop	;Keep looking!;------------------------------------------------------------; Below we check for any sessions that don't have a volume; mounted.  If we find one, we return the session number,; server name, and zone name.;------------------------------------------------------------CheckSess	sep	#$20		longa	off		ldx	#00		;Start at session number 0.@SessionLoop	ldy	#00		;Volume session index.@VolumeLoop	lda	SESSION_TBL,x	;Active session?		beq	@NextSession	;Branch if no.		cmp	NDT_SESS,Y	;Does it have a volume?		beq	@NextSession	;Branch if yes.		iny			;Check all 14 possible		cpy	#14		;volumes.		bne	@VolumeLoop		lda	zp4		;Is there room for more in the		beq	@NoRoom		;user buffer?  Branch if no.		lda	SESSION_TBL,x	;Load the session number.		sta	[zp1]		;Save it in buffer.		ldy	#31		;Zero out all the other bytes.		lda	#00@L3		sta	[zp1],y		dey		bne	@L3		lda	SESSION_TBL,x	;Load the session number.		jsr	MoveNames		dec	zp4		;Decrement dest count		inc	zp4+2		;Increment dest counter@NoRoom		inc	count		;Increment source count@NextSession	inx		cpx	#MAXSESSION		bne	@SessionLoop		lda	#00		;No ErrorDoneList	sep	#$30		longa	off		longi	off		ldy	#$0A		lda	zp4+2		;Load the dest count		sta	[zp0],y		;Store # of entries		ldx	#00		cmp	count		;Compare againts the source count		beq	@L1		;If >= then no error!		ldx	#$0B@L1		txa			;Get error		ldy	#$0B		;Amount to return		sec		jmp	EXIT_PFI;-----------------------------------------------------------------------------; The following routine takes two inputs.  Y = index into destination buffer; to start storing our values.  A = session reference number to use as a; index into our server and zone name buffer.;-----------------------------------------------------------------------------MoveNames	php			;Save state on stack.		rep	#$30		longa	on		longi	on		phx			;Save x until exit		and	#$00FF		;Make sure we have session #		dec	a		;Range from 1-8 to 0-7		pha			;Save a (for later)		pea	0000		;Result space		pea 	0000		;Result space		pha			;Multiplicand (session#)		pea	#0033		;Multiplier		ldx	#$090B		;Multiply		jsl	>$E10000		pla			;Low		ply			;High (trash)		clc			;Add offset to base and		adc	#SESSION_NAME	;store on zero page.		sta	zp3		sep	#$20		longa	off		ldy	#32		;Dest index		ldx	#31		;Save server name into@L2		lda	(zp3)		;users buffer.		sta	[zp1],y		rep	#$20		longa	on		inc	zp3		sep	#$20		longa	off		iny		dex		bpl	@L2		rep	#$20		longa	on		pla			;Get session reference #		pea	0000		;Result space		pea 	0000		;Result space		pha			;Multiplicand (session#)		pea	#0034		;Multiplier		ldx	#$090B		;Multiply		jsl	>$E10000		pla			;Low		ply			;High		clc			;Add offset to base and		adc	#SESSION_NET	;store it on zero page.		sta	zp3		sep	#$20		longa	off		ldy	#64		;Dest index.		ldx	#32		;Move zone name into@L3		lda	(zp3)		;user's buffer.		sta	[zp1],y		rep	#$20		longa	on		inc	zp3		sep	#$20		longa	off		iny		dex		bpl	@L3		plx			;Restore original x.					;New y is in y.		plp			;Restore old state.		rts		longi	on		longa	on		ENDP*** COMMAND $3A = FIGetSVersion**	   ---------------------*	0 | ASYNC FLAG = $00	|*	   ---------------------*	1 | COMMAND = $3A	|*	   ---------------------*	2 | RESULT CODE	(2)	| <--*	   ---------------------*	4 | SESSION NUMBER	| <--*	   ---------------------*	6 | VERSION NUMBER (2)	| -->*	   ---------------------CFIGETVERS	PROC	EXPORT		import	CheckAsync				jsr	CheckAsync				jsr	setup		;SAVE PL HEAP NUMBER		sep	#$30		longa	off		longi	off		jsr	SESS_CHK		bcs	BadSessNum		txa		asl	a		tax		ldy	#5		lda	SESSION_VERS,x		sta	[zp0],y		iny		lda	SESSION_VERS+1,x		sta	[zp0],y		lda	#$00		;No error!		clc		jmp	EXIT_PFIBadSessNum	lda	#$06		;Invalid session number		sec		jmp	EXIT_PFI		ENDP		END