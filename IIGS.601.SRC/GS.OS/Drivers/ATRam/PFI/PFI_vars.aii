	DS.B 2				;(2)		EXPORT	Cn_ERRORCn_ERROR		DS.B 1				;(1)		EXPORT	Cn_CARRYCn_CARRY		DS.B 1				;(1)		EXPORT	Cn_WSICMDCn_WSICMD		DS.B 2				;(2)		EXPORT	Cn_TRAPCn_TRAP		DS.B 1				;(1)		EXPORT	Cn_WSIPLCn_WSIPL		DS.B 2				;(2)		EXPORT	Cn_WHERECn_WHERE		DS.B 1				;(1)		EXPORT	Cn_RAMREGCn_RAMREG		DS.B 1				;(1)		EXPORT	Cn_cmdpdosCn_cmdpdos		DS.B 2*********************************************************	AFP TIME CONVERSION DATA AREAS********************************************************* STANDARD DATE/TIME TABLE**	THE FIELD 'CENT' CONTAINS THE # OF CENTURIES*	PAST THE YEAR 1900**		EXPORT	DT,CENT,YR4		DT		CENTYR4		DS.B 1					EXPORT	STD,YRSTD		YR		DS.B 1			EXPORT	MOMO		DS.B 1						EXPORT	DADA		DS.B 1						EXPORT	HRHR		DS.B 1						EXPORT	MINMIN		DS.B 1						EXPORT	SECSEC		DS.B 1				**	ADJUST FIELD CONTAINING THE ADJUSTMENT*	CONSTANT +/- THE TIME ZONE OFFSET*		EXPORT	ADJUSTADJUST		DS.B 4				;(4)*		EXPORT	AFP,PROD,DIVID		AFP		DIVIDPROD		DS.B 4				;(4)		EXPORT	MULT2,REMAINMULT2REMAIN	DS.B 4				;(4)		EXPORT	QUOT,MULT1QUOT		MULT1	DS.B 1				;(1)		EXPORT	DIVISDIVIS		DS.B 4				;(4)*mo_days		ds		1*mo_2		ds		11		EXPORT	PRO_TIMEPRO_TIME		DS.B 4				;(4)		EXPORT	clk_bufclk_buf		DS.B 10		EXPORT	tempvtempv		DS.B 6				;(6) used in changepath		EXPORT	secondnamesecondname		DS.B 33				;used in changepath*** THIS IS DATA FOR THE NEWLINE MOVE IN THE TWO PORT**		EXPORT	NLMV_CNTNLMV_CNT		DS.B 2				;(2)		EXPORT	ATTEN_CNTATTEN_CNT		DS.B 2				;(2)		EXPORT	pfisavezpareapfisavezparea		DS.B 40			;place to store our zp use		EXPORT	aspopparmaspopparm		DS.B $24				;enough room for an open or asp cmd, or write		EXPORT	getinfoparmgetinfoparm	DC.B	$00,$02,$00,$00	DC.L	0	;completion routine address		EXPORT	thisnetthisnet	DC.W	0	;our network num		DS.B 4				;other parms		EXPORT	timertimer	DC.B	$00,$04,$00,$00	DC.L	0	DC.W	0	DC.W	0	DC.L	0	;	;		export	Active8		EXPORT	VECTOR_MOUNT		EXPORT	VECTOR_U