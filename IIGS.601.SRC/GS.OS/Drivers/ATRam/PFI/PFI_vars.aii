;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	SESS_Timer1	ENTRY	SESS_Timer2	ENTRY	SESS_Timer3	ENTRY	SESS_Timer4	ENTRY	SESS_Timer5	ENTRY	SESS_Timer6	ENTRY	SESS_Timer7	ENTRY	SESS_Timer8* * pfi_vars* * by *   Greg Seitz*   13-Jul-87** this file contains the declarations of the data used* by the pfi code.*		INCLUDE	'atp.equates'		INCLUDE	'global.equates'		INCLUDE	'zp.equates'		INCLUDE	'pfi_equates'		EXPORT	pfiglobals	pfiglobals	proc			;------------------------------------------;; Equates from procedure pfiglobals;;------------------------------------------		EXPORT	pfibankpfibank	; ;referenced in calls to atalk for bank**	PARAMIS NETWORK SOFTWARE****	CONFIDENTIAL***	MODULE : DATA.PFI - DATA FOR PRODOS FILING INTERFACE**	WRITTEN BY THOMAS EAGER**	MODIFIED:	06-15-87	4:18	TE**	COPYRIGHT 1986,87 PARAMIS CORPORATION** ALL RIGHTS RESERVED****	PFI equ USER FILE TABLE** USTATUS IS DEFINED AS :**	BIT 7 equ EOF OF FILE FLAG*	BIT 3 equ BLOCK HAS BEEN READ*	BIT 2 equ FORCE READ	OF BLOCK*	BIT 1 equ FORCE WRITE OF BLOCK*	BIT 0 equ BLOCK HAS BEEN WRITTEN INTO*** UTYPE IS DEFINED AS :**	FILE	equ %00000000*	DIRECTORY equ %00000001*** UMODE IS DEFINED AS :**	READ/WRITE equ %00110001*	READ ONLY	equ %00000001**		EXPORT	USRVNUM1USRVNUM1		DS.B 8			;(8) FILE # ON SRV (FFequNOT ACTIVE)		EXPORT	USRVNUM2USRVNUM2		DS.B 8			;(8) FILE # ON SERVER		EXPORT	UDEVNUMUDEVNUM		DS.B 8			;(8) DEVICE NUMBER		EXPORT	ULEVELULEVEL		DS.B 8			;(8) LEVEL		EXPORT	UBUFPTRLUBUFPTRL		DS.B 8			;(8) BUFFER POINTER - LOW BYTE		EXPORT	UBUFPTRHUBUFPTRH		DS.B 8			;(8) BUFFER POINTER - HIGH BYTE		EXPORT	UFILELOCUFILELOC		DS.B 8			;(8) FILE LOCATION (FFequLOCAL)		EXPORT	UMARK1UMARK1		DS.B 8			;(8) MARK - LOW BYTE		EXPORT	UMARK2UMARK2		DS.B 8			;(8) MARK - MIDDLE BYTE		EXPORT	UMARK3UMARK3		DS.B 8			;(8) MARK - HIGH BYTE		EXPORT	UEOB1UEOB1		DS.B 8			;(8) END OF BUFFER - LOW BYTE		EXPORT	UEOB2UEOB2		DS.B 8			;(8) END OF BUFFER - MIDDLE BYTE		EXPORT	UEOB3UEOB3		DS.B 8			;(8) END OF BUFFER - HIGH BYTE		EXPORT	UCURBLKLUCURBLKL		DS.B 8			;(8) CURRENT BLOCK - LOW BYTE		EXPORT	UCURBLKHUCURBLKH		DS.B 8			;(8) CURRENT BLOCK - HIGH BYTE		EXPORT	UENMASKUENMASK		DS.B 8			;(8) ENABLE MASK FOR NEWLINE		EXPORT	UNLCHARUNLCHAR		DS.B 8			;(8) NEWLINE CHARACTER		EXPORT	UMODEUMODE		DS.B 8			;(8) ACCESS FOR FILE/DIRECTORY		EXPORT	USTATUSUSTATUS		DS.B 8			;(8) STATUS CODE		EXPORT	UTYPEUTYPE		DS.B 8			;(8) TYPE OF OBJECT (0equFILE,1equDIR)		EXPORT	UVOLID1UVOLID1		DS.B 8			;(8) HB OF VOL ID (FOR OPEN DIR)		EXPORT	UVOLID2UVOLID2		DS.B 8			;(8) LB OF VOL ID (FOR OPEN DIR)		EXPORT	UDIRID1UDIRID1		DS.B 8			;(8) HI B OF DIR ID (FOR OPEN DIR)		EXPORT	UDIRID2UDIRID2		DS.B 8			;(8) MH B OF DIR ID (FOR OPEN DIR)		EXPORT	UDIRID3UDIRID3		DS.B 8			;(8) ML B OF DIR ID (FOR OPEN DIR)		EXPORT	UDIRID4UDIRID4		DS.B 8			;(8) LO B OF DIR ID (FOR OPEN DIR)		EXPORT	UFILECNTLUFILECNTL		DS.B 8			;(8) lb of file count for directories		EXPORT	UFILECNTHUFILECNTH		DS.B 8			;(8) hb of file count for directories*** NETWORK DEVICE TABLE - MOUNTED VOLUMES !!!**		EXPORT	NDT_NAMENDT_NAME		DS.B 14*28		;14 NETWORK DEVICE NAMES		EXPORT	NDT_IDHNDT_IDH		DS.B 14			;(14)	NETWORK DEVICE VOL ID -HB		EXPORT	NDT_IDLNDT_IDL		DS.B 14			;(14)	NETWORK DEVICE VOL ID -LB		EXPORT	NDT_SESSNDT_SESS		DS.B 14			;(14)	NETWORK DEVICE SESSION #		EXPORT	NDT_UNITNDT_UNIT		DS.B 14			;(14)	NETWORK DEVICE UNIT NUMBER		EXPORT	NDT_IDX1NDT_IDX1		DS.B 2			;(2)		EXPORT	NDT_IDX2NDT_IDX2		DS.B 1			;(1)		EXPORT	NDT_SIZENDT_SIZE		DS.B 1			;(1)		EXPORT	NDT_CNTNDT_CNT		DS.B 1			;(1)		EXPORT	NDT_COUNTNDT_COUNT		DS.B 1			;(1)** SESSION REFERENCE TABLE + NETWORK ADDRESS*		EXPORT	SESSION_TBLSESSION_TBL		DS.B maxsession	;(MAXSESSION)		EXPORT	SESSION_NETLSESSION_NETL		DS.B maxsession	;(MAXSESSION)		EXPORT	SESSION_NETHSESSION_NETH		DS.B maxsession	;(MAXSESSION)		EXPORT	SESSION_NODESESSION_NODE		DS.B maxsession	;(MAXSESSION)		Export	Session_NameSESSION_NAME		ds.b $21*maxsession				;New login server name		Export	Session_NetSESSION_NET			ds.b $22*maxsession				;New login network name		Export	Session_VersSESSION_VERS		ds.b 2*maxsession				;Version of AFP		EXPORT	SESS_IDXSESS_IDX		DS.B 1		EXPORT	UM_INDEXUM_INDEX		DS.B 2									;									;									;									;-----> 3/11/88 te									;									; add to GS PFI to Help stop timeouts 									; from servers during local copies									;		EXPORT	SESS_TMRTBLSESS_TMRTBL	DC.W	SESS_Timer1	DC.W	SESS_Timer2	DC.W	SESS_Timer3	DC.W	SESS_Timer4	DC.W	SESS_Timer5	DC.W	SESS_Timer6	DC.W	SESS_Timer7	DC.W	SESS_Timer8;		EXPORT	SESS_Timer1SESS_Timer1	DC.B	$80,$04	DC.B	$00,$00	DC.L	0	;no completion routine 	DC.W	0	;running tick count	DC.W	360	;# ticks to complete		DC.L	0	;reserved;		EXPORT	SESS_Timer2SESS_Timer2	DC.B	$80,$04	DC.B	$00,$00	DC.L	0	;no completion routine 	DC.W	0	;running tick count	DC.W	360	;# ticks to complete		DC.L	0	;reserved;		EXPORT	SESS_Timer3SESS_Timer3	DC.B	$80,$04	DC.B	$00,$00	DC.L	0	;no completion routine 	DC.W	0	;running tick count	DC.W	360	;# ticks to complete		DC.L	0	;reserved;		EXPORT	SESS_Timer4SESS_Timer4	DC.B	$80,$04	DC.B	$00,$00	DC.L	0	;no completion routine 	DC.W	0	;running tick count	DC.W	360	;# ticks to complete		DC.L	0	;reserved;		EXPORT	SESS_Timer5SESS_Timer5	DC.B	$80,$04	DC.B	$00,$00	DC.L	0	;no completion routine 	DC.W	0	;running tick count	DC.W	360	;# ticks to complete		DC.L	0	;reserved;		EXPORT	SESS_Timer6SESS_Timer6	DC.B	$80,$04	DC.B	$00,$00	DC.L	0	;no completion routine 	DC.W	0	;running tick count	DC.W	360	;# ticks to complete		DC.L	0	;reserved;		EXPORT	SESS_Timer7SESS_Timer7	DC.B	$80,$04	DC.B	$00,$00	DC.L	0	;no completion routine 	DC.W	0	;running tick count	DC.W	360	;# ticks to complete		DC.L	0	;reserved;		EXPORT	SESS_Timer8SESS_Timer8	DC.B	$80,$04	DC.B	$00,$00	DC.L	0	;no completion routine 	DC.W	0	;running tick count	DC.W	360	;# ticks to complete		DC.L	0	;reserved								;								;-----> end								;*** WSI GENERAL DATA AREA**		EXPORT	FI_HEAPFI_HEAP		DS.B 1				;(1)		EXPORT	ASP_HEAPASP_HEAP		DS.B 1				;(1)		EXPORT	userbufuserbuf		DS.B maxuserbufsz		EXPORT	USER_NAMEUSER_NAME		DS.B maxusersz		;(MAXUSERSZ)		EXPORT	SRCPATHSRCPATH		DS.B maxsrcpath		;(MAXSRCPATH)		EXPORT	WS_PLISTWS_PLIST		DS.B pfi_plmax		;(PFI_PLMAX)		EXPORT	FIRST_MOUNTFIRST_MOUNT		DS.B 1				;(1)		EXPORT	AUN_HOLDAUN_HOLD		DS.B 1				;(1)		EXPORT	UCMDIDXUCMDIDX		DS.B 1				;(1)		EXPORT	UFILEIDXUFILEIDX		DS.B 1				;(1)		EXPORT	UWORK1UWORK1		DS.B 1				;(1)		EXPORT	UWORK2UWORK2		DS.B 1				;(1)		EXPORT	UERRORUERROR		DS.B 1				;(1)		EXPORT	UTRANCNTUTRANCNT		DS.B 2				;(2)		EXPORT	UVECTORUVECTOR		DS.B 2				;(2)		EXPORT	XBUFPTRXBUFPTR		DS.B 2				;(2)		EXPORT	UCURSHRUCURSHR		DS.B 1				;(1)		EXPORT	PATHLENGTHPATHLENGTH		DS.B 1				;(1)		EXPORT	VOL_LENVOL_LEN		DS.B 1				;(1)		EXPORT	LEN_CNTLEN_CNT		DS.B 1				;(1)*		EXPORT	AFP_PFXLOCAFP_PFXLOC		DS.B 1				;(1)		EXPORT	AFP_PFX_DEVAFP_PFX_DEV		DS.B 1				;(1)		EXPORT	AFP_PREFIXAFP_PREFIX		DS.B 128				;(128)		EXPORT	AFP_VOL_IDAFP_VOL_ID		DS.B 2				;(2)		EXPORT	AFP_DIR_IDAFP_DIR_ID		DS.B 4				;(4);		EXPORT	PRO_PFXLOCPRO_PFXLOC		DS.B 1						EXPORT	PRO_PFX_DEVPRO_PFX_DEV		DS.B 1				;(1)		EXPORT	PRO_PREFIXPRO_PREFIX		DS.B max_propath+1	;(65)		EXPORT	PRO_VOL_IDPRO_VOL_ID		DS.B 2				;(2)		EXPORT	PRO_DIR_IDPRO_DIR_ID		DS.B 4				;(4);		EXPORT	LASTDEVLASTDEV		DS.B 1				;(1)		EXPORT	LCL_DEVCNTLCL_DEVCNT		DS.B 1				;(1)		EXPORT	LCL_DEVLSTLCL_DEVLST		DS.B 14				;(14)		EXPORT	AUN_RAMAUN_RAM		DS.B 15				;(15) AVAIL UNIT # + END		EXPORT	AUN_CNTAUN_CNT		DS.B 1				;(1)	AVAIL UNIT # COUNT		EXPORT	FILL_PGCNTFILL_PGCNT		DS.B 1				;(1)		EXPORT	CURSESSCURSESS		DS.B 1				;(1)		EXPORT	PKT_CNTPKT_CNT		DS.B 2				EXPORT	ORG_REQORG_REQ	