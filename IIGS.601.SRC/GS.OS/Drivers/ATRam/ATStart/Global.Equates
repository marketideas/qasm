* these are common global equates used throughout appletalk routines* *  Greg Seitz*  29-Apr-87*priorityvec	equ	$e1103a			;address of vector listpfivec		equ	$e1103e			;vector for calling pfi translator;atloadin	equ	$c7ae			;atload has been installed flagatloadloc	equ	$00bf01			;location of atloadin flagsmall		equ	1			;remove addresponsesline		equ	$000480			;print on this lineromread		equ	$e1c081			;make these longlcbank2		equ	$e1c083statereg	equ	$e1c068cyareg		equ	$e1c036;RomId		equ	$00c7fefixstatereg	equ	$6024			;Now in LAP......incbusyflag	equ	$e10064			;scheduler routinesdecbusyflag	equ	$e10068emulstack	equ	$010100databank	equ	$e1e1e1** first we have some global constants*nbit		equ	$80vbit		equ	$40mbit		equ	$20xbit		equ	$10ibit		equ	$04zbit		equ	$02cbit		equ	$01rspval		equ	120			;30 seconds for rspcb timer** ATP header constants*atpxobit	equ	$20atpeombit	equ	$10atpstsbit	equ	$08** interface equates** Fixed RAM vectors.*Extended	equ	$e11000			;RAM vectors.  Extended interface entry.Basic		equ	Extended+4		;Basic entry.Pascal		equ	Basic+4			;Pascal entry.RamGoComp	equ	Pascal+4		;users gocomp entry for completionsSoftReset	equ	RamGoComp+4		;Soft reset chain.RamDispatch	equ	SoftReset+4		;Command dispatcher.RamForbid	equ	RamDispatch+4		;RAM vector to long entry of forbid.RamPermit	equ	RamForbid+4		;For Permit.ProEntry	equ	RamPermit+4		;Original ProDOS entry point.Prodos		equ	ProEntry+2		;Prodos entry.SerStatus	equ	Prodos+4		;Serial interface status hookSerWrite	equ	SerStatus+4		;" " write hook.SerRead		equ	SerWrite+4		;For Read.SerBackgnd	equ	SerRead+4		;For background printing.PDispatch	equ	SerBackgnd+4		;For dispatching packets.lapzplen	equ	$10* ddp*e1ddpend	equ	$e1d600			;really $e1d600 (gets around dumb link)ddpzplen	equ	14** zero page usage** first two must be in order, since the dispatcher uses* them.*cmdlist		equ	$80			;global ptr to paramatersexecaddr	equ	cmdlist+4stackzp		equ	execaddr+4		;for use in gocompprev		equ	execaddr+4		;previous node pointercurr		equ	prev+4			;current node pointernext		equ	curr+4			;pointer to next nodeR0		equ	next+4			;4 byte registerR1		equ	R0+4			;and anotherR2		equ	R1+4laphead		equ	R2+4			;4 byte pointer to lap headerbdsptr		equ	laphead+4		;holds pointer to bdszplen		equ	bdsptr+4-cmdlist	;length of zero pageatpzplen	equ	zplen-8			;length minus first two varsCSWL		equ	$36KSWL		equ	$38sccareg		equ	$c039whichSCC	equ	$e110a0pslotval	equ	$e112fexslotval	equ	$e112ff;oldQSetup	equ	$ff4b00;oldQPascal	equ	$ff4b03;newQSetup	equ	$00c7d8			;for after version 1 roms;newQPascal	equ	$00c7dcldest		equ	$e11180			;interface code herealtsp		equ	$010101mainsp		equ	$010100rdaltzp		equ	$c016** rpm equates*maxwrite	equ	512rpmzplen	equ	$08			;number of bytes of zp to savemaxname		equ	99			;maximum possible size for a namecrzp		equ	$80lpzp		equ	$84link		equ	$08			;length of link fieldfastbit		equ	$04			;mask for fast bit 1 means onzipzplen	equ	$08zipinuse	equ	$0601zipoverflow	equ	$0602zipnotfound	equ	$0603zipbusy		equ	$06ff