** atp.equates*			;C7xx		equ	$C7A0		;emulation mode entry;C7xxGo		equ	$C7A1		;native mode entry;C7xxRet	equ	$C7A8		;return point for routines;C7Error	equ	$C7AB		;error point for pascal not installed;C7Prodos	equ	$C7AE		;bank 0 entry for prodos** errors*lapendbuf	equ	$0202lapextra	equ	$0209largeddp	equ	$0305		;only ddp err we care aboutnoatperr	equ	$0000largeatp	equ	$0501atpbadskt	equ	$0502noatpcb		equ	$0503noatprel	equ	$0505addnosnd	equ	$0506reqabort	equ	$0507requestfail	equ	$0508sktclsd		equ	$0509toomuchrsp	equ	$050bnoddpskt	equ	$050crsprel		equ	$050datpbusy		equ	$05ffnoqtrerr	equ	$0000norspcbmem	equ	$0102		;can't allocate rspcbqtrnotfound	equ	$0103qtrbusy		equ	$01ffnoentry		equ	$0101		;dispatcher item not found* * qtr second command lists** install*insqtr_parmcnt	equ	$00insqtr_command	equ	insqtr_parmcnt+1insqtr_result	equ	insqtr_command+1insqtr_iocomp	equ	insqtr_result+2insqtr_ticks	equ	insqtr_iocomp+4insqtr_count	equ	insqtr_ticks+2insqtr_link	equ	insqtr_count+2* * remove* must use same list that we used for install,* only change the command field.* rmvqtr_parmcnt	equ	$00rmvqtr_command	equ	rmvqtr_parmcnt+1rmvqtr_result	equ	rmvqtr_command+1rmvqtr_rsvd	equ	rmvqtr_result+13	;13 reserved bytes** now we have offsets for the atp command lists** SendATPReq*atprq_parmcnt	equ	$00atprq_command	equ	atprq_parmcnt+1atprq_result	equ	atprq_command+1atprq_iocomp	equ	atprq_result+2** the order of the following 8 paramaters must not change* since some internal assumptions are made about the order* of the data in order to save execution time and code space.*atprq_dymskt	equ	atprq_iocomp+4atprq_dnet	equ	atprq_dymskt+1atprq_dnode	equ	atprq_dnet+2atprq_dskt	equ	atprq_dnode+1atprq_tid	equ	atprq_dskt+1atprq_bufsize	equ	atprq_tid+2atprq_bufptr	equ	atprq_bufsize+2atprq_user	equ	atprq_bufptr+4atprq_rbnum	equ	atprq_user+4atprq_rbdsad	equ	atprq_rbnum+1atprq_flag	equ	atprq_rbdsad+4atprq_interval	equ	atprq_flag+1atprq_rtrycnt	equ	atprq_interval+1atprq_bitmap	equ	atprq_rtrycnt+1atprq_response	equ	atprq_bitmap+1atprq_link	equ	atprq_response+1atprq_timeleft	equ	atprq_link+4atprq_trysleft	equ	atprq_timeleft+1** CancelReq*creq_parmcnt	equ	$00creq_command	equ	creq_parmcnt+1creq_result	equ	creq_command+1creq_tid	equ	creq_result+2** SendATPResp*sdrsp_parmcnt	equ	$00sdrsp_command	equ	sdrsp_parmcnt+1sdrsp_result	equ	sdrsp_command+1sdrsp_iocomp	equ	sdrsp_result+2sdrsp_sskt	equ	sdrsp_iocomp+4sdrsp_dnet	equ	sdrsp_sskt+1sdrsp_dnode	equ	sdrsp_dnet+2sdrsp_dskt	equ	sdrsp_dnode+1sdrsp_tid	equ	sdrsp_dskt+1sdrsp_rbnum	equ	sdrsp_tid+2		;number of buffers send on this callsdrsp_tpkts	equ	sdrsp_rbnum+1		;maximum number of packets being sentsdrsp_rbdsad	equ	sdrsp_tpkts+1sdrsp_flag	equ	sdrsp_rbdsad+4sdrsp_bitmap	equ	sdrsp_flag+1sdrsp_addrtn	equ	sdrsp_bitmap+1sdrsp_aflag	equ	sdrsp_addrtn+4		;pass free packets back here** AddResp* adds a response to xo sendresponse*addrsp_parmcnt	equ	$00addrsp_command	equ	addrsp_parmcnt+1addrsp_result	equ	addrsp_command+1addrsp_sskt	equ	addrsp_result+2addrsp_dnet	equ	addrsp_sskt+1addrsp_dnode	equ	addrsp_dnet+2addrsp_dskt	equ	addrsp_dnode+1addrsp_tid	equ	addrsp_dskt+1addrsp_bsize	equ	addrsp_tid+2addrsp_bptr	equ	addrsp_bsize+2addrsp_user	equ	addrsp_bptr+4addrsp_flag	equ	addrsp_user+4		;only used for eom bitaddrsp_seqnum	equ	addrsp_flag+1		;packet number we are adding** GetRequest *getrq_parmcnt	equ	$00getrq_command	equ	getrq_parmcnt+1getrq_result	equ	getrq_command+1getrq_iocomp	equ	getrq_result+2getrq_ourskt	equ	getrq_iocomp+4getrq_snet	equ	getrq_ourskt+1getrq_snode	equ	getrq_snet+2getrq_sskt	equ	getrq_snode+1getrq_tid	equ	getrq_sskt+1getrq_bufsize	equ	getrq_tid+2		;size of memory buffer points to    getrq_bufptr	equ	getrq_bufsize+2		;address of buffer to put requests intogetrq_user	equ	getrq_bufptr+4getrq_actlen	equ	getrq_user+4		;actual length of data read ingetrq_flag	equ	getrq_actlen+2getrq_bitmap	equ	getrq_flag+1getrq_link	equ	getrq_bitmap+1** openatpsocket*opskt_parmcnt	equ	$00opskt_command	equ	opskt_parmcnt+1opskt_result	equ	opskt_command+1opskt_skt	equ	opskt_result+2** closeatpsocket*clsskt_parmcnt	equ	$00clsskt_command	equ	clsskt_parmcnt+1clsskt_result	equ	clsskt_command+1clsskt_skt	equ	clsskt_result+2** relrspcb*relcb_parmcnt	equ	$00relcb_command	equ	relcb_parmcnt+1relcb_result	equ	relcb_command+1relcb_ourskt	equ	relcb_result+2relcb_snet	equ	relcb_ourskt+1relcb_snode	equ	relcb_snet+2relcb_sskt	equ	relcb_snode+1relcb_tid	equ	relcb_sskt+1** rspcb* definition of internal response control block*rspcb_link	equ	$00			;first item is link to next rspcbrspcb_sndptr	equ	rspcb_link+4		;points to associated sndatprsprspcb_sskt	equ	rspcb_sndptr+4		;source socketrspcb_dnet	equ	rspcb_sskt+1		;destination netrspcb_dnode	equ	rspcb_dnet+2		;destination noderspcb_dskt	equ	rspcb_dnode+1		;destination socketrspcb_tid	equ	rspcb_dskt+1		;transaction idrspcb_timeout	equ	rspcb_tid+2		;internal release timerrspcbsize	equ	rspcb_timeout+1		;size of rspcb** bds* structure of a bds*bds_bufsize	equ	$00bds_bufptr	equ	bds_bufsize+2bds_user	equ	bds_bufptr+4bds_actlen	equ	bds_user+4		;actual len returned by atp