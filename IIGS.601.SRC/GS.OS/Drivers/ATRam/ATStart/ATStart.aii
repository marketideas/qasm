********************************************************************************* File: ATSTART** This file contains general startup code for AppleTalk** Copyright Apple Computer, 1986* Original Author: Greg Seitz*                  1-Sep-87*                  ver 1.0********************************************************************************** Modification History** 3/21/88	TGH	- Modified to work under GS/OS*			  Took out references to BF00 page in bank 0.** 8/2/88	TGH	- Added new PFI vector call.** 8/3/88	TGH	- Took out GS/OS switch code.** 8/19/88	TGH	- Started working on changes for the RevD ROM**********************************************************************************		MACHINE M65816		INCLUDE	'global.equates'		INCLUDE	'atp.equates'ATSTARTInit	PROC	EXPORTswitchkind	equ	$E100BCosswitch	equ	$E100ACpdosdevcnt	equ	$BF31pdosdevtbl	equ	$BF32MLIACTIVE	equ	$00BF9B		rep	#$30			;Long all.		longa	on		longi	on		phb				;Save the old data bank.		phk				;Set our data bank to the code bank.		plb		sty	AtalkSlot		stx	ROMVers		php				;Turn off interupts for just a second.		sei		lda	npjump			;Put our entry point for ProDOS calls		sta	>ProDOS			;in the ATalk global vector area.		lda	npjump+2		;This is where the Cnxx firmare jumps to		sta	>ProDOS+2		;on any ProDOS call.		lda	>osswitch		;Get the old chain vector and store it		sta	ourchain		;in ourselves so that we can jump to it		lda	>osswitch+2		;when we're done with our switch code.		sta	ourchain+2		lda	ourinit			;Now install us into the switch vector.		sta	>osswitch		lda	ourinit+2		sta	>osswitch+2;; Below we figure out where BF00 should jump to;		lda	ROMVers		cmp	#0002		bcs	ROM2ROM0_ROM1	lda	#$C7AE		bra	DoneROMCheckROM2		lda	AtalkSlot		cmp	#01		beq	ROM2_Port1		lda	#$C2AE		bra	DoneROMCheckROM2_Port1	lda	#$C1AE;		bra	DoneROMCheckDoneROMCheck	sta	CnProDOS		plp				;Now restore interupts.		lda	#$C0C0			;Set long naming and device		sta	pnaming+4		;table disabled.		ldx	#pnaming		;need to make 		ldy	#^pnaming		;the call to pfi		jsl	>RamDispatch		plb				;Recover data bank		rtlAtalkSlot	dc.w	0ROMVers		dc.w	0ourchain	ds.l	1			;make room for next linkourinit		jml	switchcode		;switch code;-----------------------------------------------------------------------------------------; This code is called whenever a new applicaiton is launched.; It can be called from ProDOS8, ProDOS16, or GS/OS to let us know we are; switching operating systems.;switchcode	phb				;Save data bank		php		phk		plb		rep	#$30			;Long all.		longa	on		longi	on		lda	>switchkind		;see if we are going into p16		and	#$00ff		beq	switch_p8		;switching into prodos8switch_p16	lda	#$C0C0			;Set long naming and device		sta	pnaming+4		;table disabled.		bra	justexitswitch_p8	lda	>$BF01			;Get old Prodos vector.		cmp	CnProDOS*		cmp	#C7ProDOS		;see if already us		beq	justnameit		;need to do switch code since not us		dec	A			;Make it look like a return address.		sta	>ProEntry		;Save it.		lda	CnProDOS		;get vector to appletalk pre-dispatch*		lda	#C7ProDOS		;get vector to appletalk pre-dispatch		sta	>$BF01			;set vector to point to atalkjustnameit	ldx	#pvectors		;Tell PFI that we're switching to		ldy	#^pvectors		;ProDOS 8.		jsl	>RamDispatch		lda	#$00C0			;set device table to update		sta	pnaming+$4		;and ProDOS naming mode.justexit	ldx	#pnaming		;need to make 		ldy	#^pnaming		;the call to pfi		jsl	>RamDispatch		plp		plb				;restore data bank		jmp	ourchain		;call routine installed before usCnProDOS	dc.w	0pnaming		dc.b	0		dc.b	$33		dc.w	0DirFlag		dc.b	0NameFlag	dc.b	0		dc.w	0			;flags set in codepvectors	dc.b	0			;Syncronous		dc.b	$37			;SetFIVectors		dc.w	0			;Result CodeActive8		dc.b	$C0			;Flag $C0 = set P8 active		dc.l	0			;Mount Vector		dc.l	0			;UnMount Vector		dc.l	0			;Attention Vector		dc.l	0			;Reserved		dc.l	0			;Reserved;---------------------------------------------------------------------------------------------npjump		jml	NewProdos		;code to be moved into jump vectorNewProdos	rep	#MBit+XBit		;16 bits.		longa	on		longi	on		phx				;Save X.		lda	6,s			;Get the Prodos call return address.		inc	A			;Points to Prodos command number.		tax				;Use as index.		lda	>0,x			;Get command #.		and	#$ff			;Mask.		cmp	#$42			;See if AppleTalk command #.		beq	Us			;If so, it's us.		php		sei				;Turn off interupts		sep	#$20		longa	off		lda	>MLIACTIVE		ora	#$80		sta	>MLIACTIVE		plp		longa	on		lda	>pfivec			;see if pfi installed		ora	>pfivec+2		beq	notus			;let local prodos handle it		txa		sta	>pdosparm		;save pointer to parm list		jsl	callpfi		bvs	notus			;pfi did not want it		php				;Save condition flags and INT state		pha				;Save return value (error)		sei				;Turn off interupts		sep	#$20			;Short to store a byte		longa	off		lda	#$00			;Zero MLIACTIVE flag		sta	>MLIACTIVE		rep	#$20			;Long mode again		longa	on		lda	>pdosparm		;Fix return address		inc	a		inc	a		sta	9,s			;new return address		pla				;recover result code,		plp				;condtion flags and INT state		bra	wasus			;and exitnotus		php		sei		sep	#$20		longa	off		lda	#$00		sta	>MLIACTIVE		plp		longa	on		plx				;Restore X.		sep	#VBit			;If not, set V for calling old Prodos.		rtl				;Return.Us		txa				;Change return address to skip past		inc	A			;command number and parameter list		inc	A			;pointer.		sta	6,s			;Put it back on the stack.		lda	>1,x			;Get pointer to parameter list.		tax				;Put in X for Dispatch.		phy				;save y reg since we destroy it		ldy	#0			;High word of 0 for bank 0.		jsl	RamDispatch		;Go dispatch.		ply				;recover y regWasUs		plx				;Restore X.*		plb*		plb*		plb				;discard return address*		pei	$0000			;return with data bank 0*		plb*		plb*		jml	$00c7c4			;return from there		sep	#mbit+xbit		;make sure we return in 8 bit mode		clv				;V cleared means we handled it.		pha		pla				;set zero bit		rtl				;Return.callpfi		jml	>pfivec			;call pfipdosparm	ds.b	2prodosvect	ds.b	2		ENDP;-----------------------------------------------------------------------------------		END