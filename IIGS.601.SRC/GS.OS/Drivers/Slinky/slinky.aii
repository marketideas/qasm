currentversion	equ	$1010		;version 1.01 (final)*******************************************************************               Copyright (c) 1990*               Apple Computer, Inc.*               All rights reserved.********************************************************************               Slinky (RAM card) Driver** NOTE:         This driver must be installed on the boot*               volume in the subdirectory "/SYSTEM/DRIVERS'.*               Additionally, the FileType for the driver file*               must be set to $00BB.  AuxType is also critical*               to the operating system recognizing the driver*               as a GS/OS device driver.  The AuxType is a long*               word which must have the upper word set to $0000.*               The most significant byte of the least significant*               word in the AuxType must be set to $01 to indicate*               an active GS/OS device driver or $81 to indicate*               an inactive GS/OS device driver.  The least*               significant byte of the least significant word*               of the AuxType field indicates the number of*               devices supported by the driver file.  This value*               should be analogous to the number of DIB's*               contained in the driver file.  GS/OS will only*               install the number of devices indicated in the*               AuxType field.**               GS/OS Device Driver:    FileType = $00BB*                                       AuxType  = $000001XX where:*                                                  XX = number of devices.**               An AuxType of $00000107 indicates seven devices.  When*               building a device driver, the best way to set the*               FileType and AuxType is to use the Exerciser to get*               the current file info (GET_FILE_INFO), modify the*               FileType & AuxType and then SET_FILE_INFO.******************************************************************** REVISION HISTORY:** Date_____ Version By_ Description______________________________** 06/01/90  0.91    MVS Initial release** 11/02/90          GAB Added formatting directives to source** 11/12/90  0.92d   GAB	Minor code cleanups, optimizations, etc.** 05/10/91  0.93d   GAB set_ctrl and set_format calls now simply*			return with no error.** 05/20/91  0.94d   GAB	vrw now returns drvr_bad_count error when*			the request count is a non-integral multiple*			of the block size** 08/01/91  0.95    GAB	Startup now performs a ProDOS-style Status*			call after verifying the existence of a*			RAM card.  This allows Applied Engineering*			cards to format themselves as ProDOS*			devices.** 23-Feb-93 1.01b    SS	Added format options to allow downsizing*			to 800k on a full card.** 1-Apr-93  1.01     SS Changed version to 1.01 (final).******************************************************************		String	AsIs		print	push		print	off		include	'common.equ.src'		include	'driver.equ.src'		include	'hw.equ.src'		include	'm16.misctool'		include	'm16.util2'		print	pop		blanks	off		print	nogen;;		macros.		MACRO		skip1		dc.b	$24		ENDM;;		readb - read a byte from slinky card.		macro		readb	&offset		lda	>slinky,x		sta	|&offset,y		endm;;		writeb - write a byte to slinky card.		macro		writeb	&offset		lda	|&offset,y		sta	>slinky,x		endm						eject******************************************************************* The following table is the header required for all loaded* drivers which consists of the following:**               Word    Offset from start to 1st DIB*               Word    Number of DIBs*               Word    Offset from start to 1st control list*               Word    Offset from start to 2nd control list*               etc.******************************************************************main		procslinky		equ	$bffb		;base read/write loc for slinky cardslinkadd	equ	$bff8		;base loc to set slinky address		here		dc.w	dib_1-here	;offset to 1st DIB		dc.w	7		;number of devices		dc.w	ctrl_list-here	;offset to 1st control list		dc.w	ctrl_list-here	;offset to 2nd control list		dc.w	ctrl_list-here	;offset to 3rd control list		dc.w	ctrl_list-here	;offset to 4th control list		dc.w	ctrl_list-here	;offset to 5th control list		dc.w	ctrl_list-here	;offset to 6th control list		dc.w	ctrl_list-here	;offset to 7th control list* 		The following are the driver control parameter lists.  *		Since the slinky has no real control lists, one common *		list is shared among all slinky devices.				ctrl_list	dc.w	0		;0 bytes in parameter list				default_list	dc.w	0		;0 bytes in default list		scr		equ	$5a		;- $5e used as temp storage		eject******************************************************************* The following are tables of format options for each device.* The format option tables have the following structure:**               Word    Number of entries in list*               Word    Display count (number of head links)*               Word    Recommended default option*               Word    Option that current online media is formatted with*               Entries 16 bytes per entry in the format list** The twenty byte structure for each entry in the format list* is as follows:**               Word    Media variables reference number*               Word    Link to reference number n.*               Word    Flags / Format environment*               Long    Number of blocks supported by device*               Word    Block size*               Word    Interleave factor*               Long    Number of bytes defined by flag** Bit definition within the flags word is as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |___|__ Format*   |   |   |   |   |   |   |   |   |   |   |   |   |___|__________ Flags*   |___|___|___|___|___|___|___|___|___|___|___|__________________ Reserved** Format Bit Definition: 00   Universal format*                        01   Apple Format*                        02   NonApple Format*                        11   Not Valid** Flag Bit Definition:   00   Size is in bytes*                        01   Size is in Kb*                        02   Size is in Mb*                        11   Size is in Gb******************************************************************		export	format_tblformat_tbl		dc.w	2		; 2 entries this list		dc.w	2		; 2 display entries		dc.w	1		; recommended option is #1		dc.w	0		; current media formatted w/option** List for entry reference number 1.*		dc.w	1		; reference number #1		dc.w	2		; ref num of linked entry		dc.w	4		; universal, size in K		dc.l	2048		; block count		dc.w	512		; block size		dc.w	0		; interleave factor		dc.w	1024		; device byte count in kilobytes** List for entry reference number 2.*		dc.w	2		; reference number #2		dc.w	0		; ref num of linked entry		dc.w	4		; universal, size in K		dc.l	1600		; block count		dc.w	512		; block size		dc.w	0		; interleave factor		dc.w	800		; device byte count in kilobytesformatOption	dc.w	0		;the current optionavailableBlocks	dc.w	0		;absolute total blocks available		eject*******************************************************************               Link Pointer*               Entry Pointer*               Device Characteristicscharacteristics	equ	%1000101111101000*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |_ RESERVED*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |_____ RESERVED*   |   |   |   |   |   |   |   |   |   |   |   |   |   |_________ REMOVABLE*   |   |   |   |   |   |   |   |   |   |   |   |   |_____________ FORMAT*   |   |   |   |   |   |   |   |   |   |   |   |_________________ RESERVED*   |   |   |   |   |   |   |   |   |   |   |_____________________ READ*   |   |   |   |   |   |   |   |   |   |_________________________ WRITE*   |   |   |   |   |   |   |   |   |_____________________________ BLOCK DEVICE*   |   |   |   |   |   |   |   |_________________________________ SPEED GROUP (LSB)*   |   |   |   |   |   |   |_____________________________________ SPEED GROUP (MSB)*   |   |   |   |   |   |_________________________________________ FIXED NAME*   |   |   |   |   |_____________________________________________ RESTARTABLE*   |   |   |   |_________________________________________________ BUSY*   |   |   |_____________________________________________________ LINKED*   |   |_________________________________________________________ GENERATED*   |_____________________________________________________________ RAM/ROM DEV**               Block Count*               Device Name*               Slot Number*               Unit Number*               Device ID Number*               Head Device Link*               Forward Device Link*               Extended DIB Pointer*               DIB Device Number******************************************************************				dib_1		dc.l	dib_2		;link pointer to second DIB		dc.l	dispatch	;entry pointer		dc.w	characteristics	;characteristics		dc.l	0		;block count		dc.b	8		;device name (length & ascii)		dc.b	'RAMCARD1                       '        		dc.w	8+1		;slot #		dc.w	1		;unit #   		dc.w	currentversion	;version # 		dc.w	$e		;device ID number		dc.w	0		;head device link		dc.w	0		;forward device link		dc.l	0		;Extended DIB pointer		dc.w	0		;DIB Device Numberdib_2		dc.l	dib_3		;link pointer		dc.l	dispatch	;entry pointer		dc.w	characteristics	;characteristics		dc.l	0		;block count		dc.b	8		;device name (length & ascii)		dc.b	'RAMCARD2                       '        		dc.w	8+2		;slot #		dc.w	1		;unit #		dc.w	currentversion	;version # 		dc.w	$e		;device ID number		dc.w	0		;head device link		dc.w	0		;forward device link		dc.l	0		;Extended DIB pointer		dc.w	0		;DIB Device Number		dib_3		dc.l	dib_4		;link pointer		dc.l	dispatch	;entry pointer		dc.w	characteristics	;characteristics		dc.l	0		;block count		dc.b	8		;device name (length & ascii)		dc.b	'RAMCARD3                       '        		dc.w	8+3		;slot #		dc.w	1		;unit #		dc.w	currentversion	;version #		dc.w	$e		;device ID number		dc.w	0		;head device link		dc.w	0		;forward device link		dc.l	0		;Extended DIB pointer		dc.w	0		;DIB Device Number				dib_4		dc.l	dib_5		;link pointer		dc.l	dispatch	;entry pointer		dc.w	characteristics	;characteristics		dc.l	0		;block count		dc.b	8		;device name (length & ascii)		dc.b	'RAMCARD4                       '        		dc.w	8+4		;slot #		dc.w	1		;unit #		dc.w	currentversion	;version #		dc.w	$e		;device ID number		dc.w	0		;head device link		dc.w	0		;forward device link		dc.l	0		;Extended DIB pointer		dc.w	0		;DIB Device Number				dib_5		dc.l	dib_6		;link pointer		dc.l	dispatch	;entry pointer		dc.w	characteristics	;characteristics		dc.l	0		;block count		dc.b	8		;device name (length & ascii)		dc.b	'RAMCARD5                       '        		dc.w	8+5		;slot #		dc.w	1		;unit #		dc.w	currentversion	;version #		dc.w	$e		;device ID number		dc.w	0		;head device link		dc.w	0		;forward device link		dc.l	0		;Extended DIB pointer		dc.w	0		;DIB Device Numberdib_6		dc.l	dib_7		;link pointer		dc.l	dispatch	;entry pointer		dc.w	characteristics	;characteristics		dc.l	0		;block count		dc.b	8		;device name (length & ascii)		dc.b	'RAMCARD6                       '        		dc.w	8+6		;slot #		dc.w	1		;unit #		dc.w	currentversion	;version #		dc.w	$e		;device ID number		dc.w	0		;head device link		dc.w	0		;forward device link		dc.l	0		;Extended DIB pointer		dc.w	0		;DIB Device Number		dib_7		dc.l	0		;link pointer - last one		dc.l	dispatch	;entry pointer		dc.w	characteristics	;characteristics		dc.l	0		;block count		dc.b	8		;device name (length & ascii)		dc.b	'RAMCARD7                       '        		dc.w	8+7		;slot #		dc.w	1		;unit #		dc.w	currentversion	;version #		dc.w	$e		;device ID number		dc.w	0		;head device link		dc.w	0		;forward device link		dc.l	0		;Extended DIB pointer		dc.w	0		;DIB Device Number			if *-dib_1 <> ($40*7) then		aerror	'incorrect sizes for dibs'	endif		eject******************************************************************* The following table is used to dispatch to GS/OS driver* functions.******************************************************************				dispatch_table	dc.w	startup		dc.w	open		dc.w	read		dc.w	write		dc.w	close		dc.w	status		dc.w	control		dc.w	flush		dc.w	shutdn				status_table	dc.w	dev_stat		dc.w	get_ctrl		dc.w	get_wait		dc.w	get_format		dc.w	get_partitioncontrol_table	dc.w	dev_reset		dc.w	format		dc.w	media_eject		dc.w	set_ctrl		dc.w	set_wait		dc.w	set_format		dc.w	set_partn		dc.w	arm_event		dc.w	disarm_event		dc.w	set_partition		eject******************************************************************* DRIVER MAIN ENTRY POINT: DISPATCH** This is the main entry point for the device driver.  The* routine validates the call number prior to dispatching to* the requested function.** Call Number: $0000    Function: Startup*              $0001              Open*              $0002              Read*              $0003              Write*              $0004              Close*              $0005              Status*              $0006              Control*              $0007              Flush*              $0008              Shutdown** ENTRY: Call via 'JSL'*     [<drvr_dib_ptr] = Points to the DIB for the device being accessed*       <drvr_dev_num = Device number of device being accessed*      <drvr_call_num = Call number*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT:   Direct page = unchanged with the exception of <drvr_tran_cnt*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************		longa	on		longi	ondispatch	phb			;save environment		phk		plb		cmp	#max_command	;is it a legal command?		bcs	illegal_req	;no;		save direct page that is used by driver.				pei	<scr		pei	<scr+2		pei	<scr+4;		pea	func_ret-1	;return address from function		asl	a		;make index to dispatch table				tax;	lda	|dispatch_table,x;	pha			;push function address for dispatch;	rts			;rts dispatches to function		jsr	(dispatch_table,x);		restore direct page that is used by driver.func_ret	plx		stx	<scr+4		plx		stx	<scr+2		plx		stx	<scr				plb			;restore data bank		rtl* 		Received an illegal request.  Return with an error.illegal_req	plb			;restore environement		lda	#drvr_bad_req	;set error		sec		rtl				eject******************************************************************* DRIVER CALL:  STARTUP** This routine must prepare the driver to accept all other driver* calls.** ENTRY: Call via 'JSR'*     [<drvr_dib_ptr] = Points to the DIB for the device being accessed*       <drvr_dev_num = Device number of device being accessed*      <drvr_call_num = Call number*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as program bank*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*         Direct page = unchanged with the exception of <drvr_tran_cnt*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************				longa	on		longi	on		startup		;		see if we're being restarted		ldy	#blk_cnt		lda	[<drvr_dib_ptr],y		iny		iny		ora	[<drvr_dib_ptr],y		beq	@1		;block count == 0, must check for card		brl	noerr		;else we've already identified the card@1;		try to identify if the card is here.		ldy	#slot_num	;slot to check for hardware		lda	[<drvr_dib_ptr],y		and	#7		sta	<scr+4		tay		tax			;save for now		shortm		cmp	#3					bne	startup1	;if not slot 3			lda	>rdc3rom	;get status of slot 3		bpl	startup2a	;if internal slot		bra	startup3	;see if slinky is there	startup1  	lda	>sltromsel	;get status of slots			startup2  	lsr	a		dey		bpl	startup2	;if more to check		bcs	startup3	;if an external slotstartup2a 	brl	startup6	;return with error		startup3	longm		txa			;restore		tay		xba		ora	#$C001		;create $Cn01		tax		shortm			lda	>0,x		;$Cn01 s/b $20		cmp	#$20		bne	startup2a		inx		inx		lda	>0,x		;$Cn03 s/b $00		bne	startup2a		inx		inx		lda	>0,x		;$Cn05 s/b $03		cmp	#$03		bne	startup2a		lda	#$fb		tax			;set low byte		lda	>0,x		;$CnFB 		and	#3		dec	a		bne	startup2a	;if not slinky;		see how much memory is in the card.;		now we create a smartport parameter block in bank zero:;;		+0 	= command = 0 to do a status call.;		+1 - 2	= abs ptr to parameter list (right after this);		+3	= parameter count = 3.;		+4	= unit #.  Always equal to 1.;		+5 - 6	= ptr to buffer to get status (right after nxt item);		+7	= status code = 3.  Returns DIB;;		the stuff after this is what comes back from smartport:;		+8	= general status byte returned by smartport;		+9 - 11	= # of blocks in the device;		+12	= length of device name;		+13-27	= device name;		+28	= type of device.  Should be 0 for ram card;		+29	= subtype of device.  Should be 0 for ram card;		+30-31	= version #		;		determine the address to call.		lda	#$ff		tax			;set address to access		lda	>0,x		;get offset from start		tax			;move low byte into X		longm		txa			;16-bit address into accumulator		sta	pdVector+1	;store into ProDOS call block		clc		adc	#3		;add 3 to get SmartPort entry point		sta	spcall+1	;address to call				tsc		sta	<scr		;save stack ptr				sec		sbc	#spslistlen	;offset for status info		tcs		sta	spptr2		;address of status buffer		sbc	#4		sta	spptr1		;address of parameter buffer on stack		;		copy over the call info for smartport.		shortmx		ldx	#spcall_len-1startup4	lda	spcall,x		pha		dex		bpl	startup4	;if more to copy		longmx				tsc		inc	a		;points to SP code start		ldx	#0		phx			;result space		phx		phx		phx		phx			;a register		phx			;x register		phx			;y register		pha			;address of call		_FWEntry		;call to our code in bank zero		ply			;get Y-reg after the call ($00yy)		plx			;get X-reg after the call ($00xx)		pla			;get A-reg after the call ($00aa)		cmp  	#1		bcc	fill_in_dib	;no error, continuestartup5	lda	<scr		;restore stack pointer		tcsstartup6	longm		lda	#drvr_io_error		sec		rts		fill_in_dib;		parameter block that is on the stack after call to fwentry;		these are accessed +1 to account for the fact that (sp)+1 is the;		first byte to access.;		;;		+0 - 1	= garbage left on stack;		+2 - 3	= jsr to smartport address on card.;		+4	= SP command = 0 to get status.;		+5 - 6	= (word) abs ptr to parameter list (right after nxt item);		+7	= rts;		+8	= parameter count = 3.;		+9	= unit #.  Always equal to 1.;		+10-11	= (word) ptr to buffer to get status (right after nxt item);		+12	= status code = 3.  Returns DIB;;		the stuff after is filled in by smartport:;		+13	= general status byte returned by smartport;		+14-16	= # of blocks in the device;		+17	= length of device name;		+18-33	= device name;		+34	= type of device.  Should be 0 for ram card;		+35	= subtype of device.  Should be 0 for ram card;		+36-37	= version #		lda	35,s		;get type and subtype of device		bne	startup5	;if not an apple ram card (slinky)				lda	14+1+2,s	;get uppermost byte of block count		and	#$ff		;strip off unused bits		ldy	#blk_cnt+2		sta	[drvr_dib_ptr],y  ;place into dib		lda	14+1,s		;get low 2 bytes of block count		ldy	#blk_cnt				sta	[<drvr_dib_ptr],y  ;place into dib		sta	|availableBlocks	;keep a copy to reset to defaults		stz	|formatOption	;reset to default format option number		cmp	#1600		;got more than 800k?		lda	#2		;preset for yes (and 2 options)		bcs	@full		; yes		dec	a		; no, reset to no options		dec	a@full		sta	|format_tbl	;number of options		sta	|format_tbl+2	;number to display				lda	<scr		;clean up stack		tcs; now that we know we have a slinky card, make a ProDOS-style Status call; to the card's firmware.  This will allow Applied Engineering cards to; format themselves as ProDOS devices.		ldy	#slot_num	;get slot # again		lda	[<drvr_dib_ptr],y		and	#$07		asl	a		;make into ProDOS Unit Num		asl	a		asl	a		asl	a		ora	unitNum+1	;combine with following instruction		sta	unitNum+1	;and store back into code block				jsl	get_sys_gbuf	;get address of SCM's global buffer		txa			;put low word into Accumulator		shortmx		xba			;get address into accumulator		sta	gbuf_addr+1	;store into code block		ldx	#pdcall_len-1@loop		lda	pdStatus,x		pha			;put code block on stack		dex		bpl	@loop		longmx				tsc		inc	a		;points to SP code start		ldx	#0		phx			;result space		phx		phx		phx		phx			;a register		phx			;x register		phx			;y register		pha			;address of call		_FWEntry		;call to our code in bank zero		lda	<scr		;clean up stack		tcs		brl	noerr		;flag that everything is good and return		longa	off		longi	off;		code that is placed into bank 0 on the stack.spcall		jsr  	$0000		;SP dispatch address		dc.b	0		;SP commandspptr1		dc.w	0  		;param list ptr		rts		spcall1		dc.b	3		;3 parameters		dc.b	1		;unit #spptr2		dc.w	0		;ptr to status list		dc.b	3		;status codespcall_len	equ	*-spcallspslistlen	equ	25		;length of returned status list; ProDOS-style status call, placed into bank 0 (stack area) and called; to allow the card to configure itself as a ProDOS device.pdStatus	stz	$42		;command numberunitNum		lda	#$00		;modified by code above		sta	$43		;ProDOS unit number		stz	$44		;buffer addressgbuf_addr	lda	#$00		;filled in by code above		sta	$45		stz	$46		stz	$47pdVector	jmp	$0000		;filled in above, ProDOS entry pointpdcall_len	equ	*-pdStatus		longa	on		longi	on		eject******************************************************************* DRIVER CALL:  READ** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*       <drvr_buf_ptr = Pointer to I/O buffer*       <drvr_blk_num = Initial block number*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_blk_size = Size of block to be accessed*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************		longa	on		longi	onread		lda	<drvr_req_cnt		ora	<drvr_req_cnt+2		bne	read1		;if something to do		clc			;return with no error (acc already 0)		read0		rts						read1		jsr	vrw		;verify read write parameters		bcs	read0		;if error 		jsr	gso		;get slot offset				ldy	<drvr_buf_ptr	;starting offset in bank		;		set the address to check.		lda	<drvr_blk_num		sta	<scr+4		;save for later		asl	a					shortm		sta	>slinkadd+1,x	;middle 8 bits of 24 bit address		xba		sta	>slinkadd+2,x	;hi 8 bits of 24 bit address		lda	#0		sta	>slinkadd,x	;lo 8 bits of address		read1a		lda	#512/32		;# of times through the loop		sta	<scr+2				lda	drvr_buf_ptr+2		pha		plb			;set bank correctly		;		now read the blocks in groups of 32.;		32 was chosen since it isn't enough to add another block of disk space and;		it is large enough to get some savings.read2		readb	0		readb	1		readb	2		readb	3		readb	4		readb	5		readb	6		readb	7		readb	8		readb	9		readb	10		readb	11		readb	12		readb	13		readb	14		readb	15		readb	16		readb	17		readb	18		readb	19		readb	20		readb	21		readb	22		readb	23		readb	24		readb	25		readb	26		readb	27		readb	28		readb	29		readb	30		readb	31		longmx		tya		clc		adc	#32		tay		shortm		bcc	read3		;if didn't cross bank				lda	<drvr_buf_ptr+2		ina		sta	<drvr_buf_ptr+2	;bump up the bank		pha		plb			;set the new data bankread3		dec	<scr+2					beq	read4		;if done with block		jmp	read2		;process next group of 32				read4		longm		sty	<scr		;save for now						lda	<drvr_tran_cnt		ldy	<drvr_tran_cnt+2		clc		adc	#512		sta	<drvr_tran_cnt		bcc	read5		iny		sty	<drvr_tran_cnt+2read5		cmp	<drvr_req_cnt		bne	read6		cpy	<drvr_req_cnt+2		beq	read9		;if totally done		;		check if beyond the size of the card.read6		lda	<scr+4		;current block that was read		ina			;increment block number		ldy	#blk_cnt		cmp	[<drvr_dib_ptr],y		bcs	read8		;if at end of disk		sta	<scr+4		;replace new value		read7		ldy	<scr		;last offset		shortm		jmp	read1a		;process next block				longa	on;		user tried to read too far.		read8		lda	#drvr_bad_block			rts			;(c) is set;		no problems.read9		clc		lda	#0		rts						eject******************************************************************* DRIVER CALL:  WRITE** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*       <drvr_buf_ptr = Pointer to I/O buffer*       <drvr_blk_num = Initial block number*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_blk_size = Size of block to be accessed*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************						longa	on		longi	onwrite		lda	<drvr_req_cnt		ora	<drvr_req_cnt+2		bne	write1		;if something to do		clc			;return with no error (acc already 0)		write0		rtswrite1		jsr	vrw		;verify read/write parameters		bcs	write0		;if error ocurred		jsr	gso		;get slot offset				ldy	<drvr_buf_ptr	;starting offset in bank		;		set the address to check.			lda	<drvr_blk_num		sta	<scr+4		;save for later		asl	a					shortm		sta	>slinkadd+1,x	;middle 8 bits of 24 bit address		xba		sta	>slinkadd+2,x	;hi 8 bits of 24 bit address		lda	#0		sta	>slinkadd,x	;lo 8 bits of address				write1a		lda	#512/32		;# of times through the loop		sta	<scr+2				lda	drvr_buf_ptr+2		pha		plb			;set bank correctly		;		now write the blocks in groups of 32.;		32 was chosen since it isn't enough to add another block of disk space and;		it is large enough to get some savings.write2		writeb	0		writeb	1		writeb	2		writeb	3		writeb	4		writeb	5		writeb	6		writeb	7		writeb	8		writeb	9		writeb	10		writeb	11		writeb	12		writeb	13		writeb	14		writeb	15		writeb	16		writeb	17		writeb	18		writeb	19		writeb	20		writeb	21		writeb	22		writeb	23		writeb	24		writeb	25		writeb	26		writeb	27		writeb	28		writeb	29		writeb	30		writeb	31		longmx		tya		clc		adc	#32		tay			shortm		bcc	write3		;if didn't cross bank				lda	drvr_buf_ptr+2		ina		sta	drvr_buf_ptr+2	;bump up the bank		pha		plb			;set the new data bankwrite3		dec	<scr+2		beq	write4		;if done with block		jmp	write2		;process next group of 32				write4		longm		sty	<scr		;save for now						lda	<drvr_tran_cnt		ldy	<drvr_tran_cnt+2		clc		adc	#512		sta	<drvr_tran_cnt		bcc	write5		iny		sty	<drvr_tran_cnt+2write5		cmp	<drvr_req_cnt		bne	write6		cpy	<drvr_req_cnt+2		beq	write9		;if totally done		;		check if beyond the size of the card.write6		lda	<scr+4		;current block that was written		ina			;increment block number		ldy	#blk_cnt		cmp	[<drvr_dib_ptr],y		bcs	write8		;if trying to write past end of disk		sta	<scr+4		;replace new valuewrite7		ldy	<scr		;last offset		shortm		jmp	write1a		;process next block				longa	on;		user tried to write too far		write8		lda	#drvr_bad_block		rts			;(c) set;		no problems.write9		clc		lda	#0		rts						EJECT******************************************************************* DRIVER CALL:  STATUS** This routine supports all the standard device status calls.* Any status call which is able to detect an OFFLINE or DISK* SWITCHED condition should call the system service routine* SET_DISKSW.  OFFLINE and DISKSW are conditions and not errors* when detected by a status call and should only be returned as* conditions in the status list.** Status Code:  $0000   Return Device Status*               $0001   Return Control Parameters*               $0002   Return Wait/No Wait Mode*               $0003   Return Format Options*               $0004   Return Parition Map** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************		longa	on		longi	on			status		*		 Need to verify that the status code specifies a* 		legal status request.		lda	<drvr_stat_code	;is this a legal status request?		cmp	#$0005		bcc	legal_status	;yes		lda	#drvr_bad_code	;else return 'BAD CODE' error		rts* 		It's a legal status.  Dispatch to the appropriate status routine.legal_status	asl	a		tax		jmp	(|status_table,x);	lda	|status_table,x;	pha;	rts			;dispatch is via an 'RTS'		eject******************************************************************* The DEVICE STATUS call returns a status list that indicates* specific status information regarding a character of block* device and the total number of blocks supported by a block device.** Status List Pointer:  Word            General status word*                       Longword        Total number of blocks** Encoding of status for a block device is as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |__ DISK SW*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |______ INTERRUPT*   |   |   |   |   |   |   |   |   |   |   |   |   |   |__________ WRITE PROT*   |   |   |   |   |   |   |   |   |   |   |   |   |______________ 0 RESERVED*   |   |   |   |   |   |   |   |   |   |   |   |__________________ ONLINE*   |   |___|___|___|___|___|___|___|___|___|______________________ 0 RESERVED*   |______________________________________________________________ BLK FLAG** Valid request counts versus returned status list for this status* call are as follows:** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_slist_ptr = Pointer to status list*     <drvr_stat_code = Status code*       <drvr_req_cnt = Number of bytes to be transferred (2 - 6)*               A Reg = Status code * 2*               X Reg = Status code * 2*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************		longa	on		longi	on				dev_stat	lda	#drvr_bad_parm	;assume invalid request count		ldx	<drvr_req_cnt+2	;and validate request count		bne	bad_dev_stat		ldx	<drvr_req_cnt		cpx	#$0002		bcc	bad_dev_stat		cpx	#$0007		bcc	ok_dev_stat		bad_dev_stat	sec		rts* 		Request count is valid.  Deterime device status and *		if appropriate, the total number of blocks for the*		device and return them in the device status list.  *		You insert the code required for this operation.ok_dev_stat	lda	#$10		;flag that media is here		sta	statbuff		* 		Get default block count from DIB.		ldy	#blk_cnt		lda	[<drvr_dib_ptr],y		sta	statbuff+2		iny		iny		lda	[<drvr_dib_ptr],y		sta	statbuff+4* 		Now copy the internal status list to the destination* 		status list specified in the call parameters.not_sos_stat	ldy	#$0000		;status list pointer		sep	#$20		;8 bit 'm'		longa	offcopy_dstat	lda	statbuff,y	;copy device status list to slist_ptr		sta	[<drvr_slist_ptr],y		iny		cpy	<drvr_req_cnt	;copy = request count size		bne	copy_dstat		rep	#$20		;16 bit 'm'		longa	onnot_blk_stat	brl	set_xfer_cnt	;update xfer count & exitstatbuff	ds.b	2+4				eject******************************************************************* This call returns a byte count as the first word in the status* list followed by the data from the configuration parameter list.* The request count specifies how much data is to be returned* from the list.  If the byte count is smaller than the request* count then only the number of bytes specified by the byte* count will be returned and the transfer count will indicate* this.** Status List:  Word    Number of bytes in configuration list (including byte count).*               Data    Data from the configuration list (device specific).** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_slist_ptr = Pointer to status list*     <drvr_stat_code = Status code*       <drvr_req_cnt = Number of bytes to be transferred (2 - $FFFF)*               A Reg = Status code * 2*               X Reg = Status code * 2*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************						longa	on		longi	on		get_ctrl	lda	#drvr_bad_parm		;assume invalid request count		ldx	<drvr_req_cnt+2		;and validate request count		bne	bad_get_ctrl		ldx	<drvr_req_cnt		cpx	#$0002		bcs	ok_get_ctrl		bad_get_ctrl	sec		rts* 		Request count is valid.  Return control list.ok_get_ctrl	lda	#$0000			;no control list this device		sta	[<drvr_slist_ptr]				sta	<drvr_tran_cnt+2	;transfer count always $00000002		lda	#$0002		sta	<drvr_tran_cnt		brl	noerr		eject******************************************************************* This routine returns the Wait/No Wait mode that the driver* is currently operating in.  This is returned in a word* parameter which indicates a request count of $0002.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_slist_ptr = Pointer to status list*     <drvr_stat_code = Status code*       <drvr_req_cnt = Number of bytes to be transferred (2)*               A Reg = Status code * 2*               X Reg = Status code * 2*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************		longa	on		longi	onget_wait	lda	#drvr_bad_parm	  ;assume invalid request count		ldx	<drvr_req_cnt+2	  ;get request count		bne	bad_get_wait	  ;if too large		ldx	<drvr_req_cnt		cpx	#$0002		beq	ok_get_wait	  ;if correct size		bad_get_wait	sec			  ;set error flag		rts* 		Request count is valid. Return the wait mode for this device.ok_get_wait	lda	#$0000		  ;block devices always in wait mode		sta	[<drvr_slist_ptr]		brl	set_xfer_cnt		eject******************************************************************* This routine returns the format options for the device.* Consult the driver specification for the format option list.* This call requires a minimum request count of $00000002.  The* maximum request count may exceed the size of the format list* in which case the request count returned will indicate the* size of the format list.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_slist_ptr = Pointer to status list*     <drvr_stat_code = Status code*       <drvr_req_cnt = Number of bytes to be transferred (2 - n)*               A Reg = Status code * 2*               X Reg = Status code * 2*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************						longa	on		longi	on		get_format	lda	#drvr_bad_parm	  ;assume invalid request count		ldx	<drvr_req_cnt+2	  ;get request count		bne	bad_get_format	  ;if too large		ldx	<drvr_req_cnt		cpx	#$0002		bcs	ok_get_format	  ;if ok		bad_get_format	sec		rts* 		Request count is valid. Return the format options for this device.ok_get_format		ldx	#format_tbl	; point at format options list		lda	|0,x		; get # entries in option list		bne	@nonzero				stz	<drvr_tran_cnt	;no format options to return!		stz	<drvr_tran_cnt+2		brl	noerr		;return with no error@nonzero	asl	a		; list length = (n * 16) + 8		asl	a		asl	a		asl	a		clc		adc	#$0008		; now have option list length		cmp	<drvr_req_cnt	; is request longer then list length?		bge	req_count_ok		sta	<drvr_req_cntreq_count_ok		ldy	#$0000		; status list index		sep	#$20		; 8 bit 'm'		longa	offcopy_format		lda	|0,x		; copy format option list to slist_ptr		sta	[<drvr_slist_ptr],y		inx		iny		cpy	<drvr_req_cnt	; copy = request count size		bne	copy_format		rep	#$20		; 16 bit 'm'		longa	on		brl	set_xfer_cnt		eject******************************************************************* This is a common exit routine for successful status calls.* The transfer count is set to the same value as the request* count prior to returning with no error.** ENTRY: via a 'JSR'*       <drvr_req_cnt = Number of bytes to be transferred (2 - 6)*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code = No Error*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error******************************************************************						longa	on		longi	on		set_xfer_cnt	lda	<drvr_req_cnt	;set transfer count		sta	<drvr_tran_cnt		lda	<drvr_req_cnt+2		sta	<drvr_tran_cnt+2		brl	noerr		;return with no error				EJECT******************************************************************* DRIVER CALL:  CONTROL** This routine supports all the standard device control calls.** Control Code: $0000   Reset Device*               $0001   Format Device*               $0002   Eject Media*               $0003   Set Control Parameters*               $0004   Set Wait/No Wait Mode*               $0005   Set Format Options*               $0006   Assign Partition Owner*               $0007   Arm Event*               $0008   Disarm Event*               $0009   Set Partition Map** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************				longa	on		longi	on		control							* 		Need to verify that the control code specifies a* 		legal control request.		lda	<drvr_stat_code	;is this a legal control request?		cmp	#$000A		bcc	legal_control	;yes		lda	#drvr_bad_code	;else return 'BAD CODE' error		rts* 		It's a legal control.  Dispatch to the appropriate control routine.legal_control	asl	a		tax		jmp	(|control_table,x);	lda	|control_table,x;	pha;	rts			;dispatch is via an 'RTS'		eject******************************************************************* This control call sets the format option in preperation for* a subsequent format control call.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************set_format				;               		longa	on		longi	on				lda	|format_tbl		beq	@inrange		;no options; less than 800k on card				lda	[<drvr_slist_ptr]	;get the format option		beq	@bad			;zero is not a valid option		dec	a		cmp	|format_tbl		inc	a		bcc	@inrange		@bad		lda	#drvr_bad_parm		sec		rts						@inrange	sta	|formatOption		brl	noerr		;return with no error		eject******************************************************************* This routine will physically format the media.  No additional* information associated with any particular file system will* be written to the media. Check task count for disk switch* prior to  execution of read.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*               A Reg = Control code * 2*               X Reg = Control code * 2*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************		longa	on		longi	on				format				lda	|formatOption		beq	@default		dec	a		asl	a		asl	a		asl	a		asl	a		adc	#8		tax		lda	|format_tbl+6,x	;optional block count		bra	@gotit@default	lda	|availableBlocks	;absolute block count@gotit		ldy	#blk_cnt		sta	[<drvr_dib_ptr],y		sta	<scr+2		;save # of blocks to initialize		jsr	gso		;get slot offset				shortm		lda	#0		sta	>slinkadd+1,x	;middle 8 bits of 24 bit address		sta	>slinkadd+2,x	;hi 8 bits of 24 bit address		sta	>slinkadd,x	;lo 8 bits of addressformat1		ldy	#$200		;# of bytes per blockformat2		sta	>slinky,x	;initialize byte to zero		dey		bne	format2		;if more in this block					ldy	<scr+2		;decrement # of blocks to format		dey			;* 25-Feb-93 SS - dec memory won't work in shortm		sty	<scr+2		bne	format1		;if more blocks to do		longm				stz	|formatOption	;always reset to default		brl	noerr		;return with no error				eject******************************************************************* This routine will set the WAIT/NO WAIT mode as specified* by the contents of the control list.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*               A Reg = Control code * 2*               X Reg = Control code * 2*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x x   0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C   E*                       x x 0 0 0 x x 0   0  if no error*                       x x 0 0 0 x x 1   0  if error******************************************************************						longa	on		longi	on		set_wait	lda	#drvr_bad_parm	  ;assume invalid request count		ldx	<drvr_req_cnt+2	  ;and validate request count		bne	bad_set_wait		ldx	<drvr_req_cnt		cpx	#$0002		beq	ok_set_waitbad_set_wait	sec		rts* 		Request count is valid. ok_set_wait	lda	[<drvr_slist_ptr]		beq	wait_mode_ok	  ;if user is clearing wait mode				lda	#drvr_bad_parm	  		sec			  ;error - can only clear wait mode		rts		wait_mode_ok	brl	set_xfer_cnt		eject;;		gso - get slot offset.;;		entry	driver zero page is set up..;;		exit	(x) = offset to use to access slinky card.		longa	on		longi	ongso		ldy	#slot_num		lda	[drvr_dib_ptr],y	;get slot		and	#7			;remove external flag		asl	a		asl	a		asl	a		asl	a		ora	#$88			;offset into soft switches		tax		rts;;		vrw - verify read and write parameters.;;		entry	driver zero page is set up..;;		exit	if no error (c) clear.;			if error, (a) = error #, (c) set.		longa	on		longi	on				vrw		ldx	#drvr_bad_parm	;init error number in X		lda	<drvr_blk_size		cmp	#512		bne	vrw2		;if error in block size				ldx	#drvr_bad_count		lda	<drvr_req_cnt		and	#$1ff		bne	vrw2		;if bad request count				ldx	#drvr_bad_block		lda	<drvr_blk_num+2		bne	vrw2		;if way too big of block number				lda	<drvr_blk_num		ldy	#blk_cnt		cmp	[<drvr_dib_ptr],y		bcc	vrw3		;if ok starting block		vrw2		txa			;put error code into Accumulator		sec			;indicate the errorvrw3		rts		eject;		dummy routines that are meaningless for the slinky driver.;;		All of these routines simply return without an error.		longa	on		longi	onarm_eventclose	dev_resetdisarm_eventflushmedia_ejectget_partitionopen	set_ctrlset_partitionset_partnshutdn		noerr		lda	#no_error	;and exit without error		clc		rts			endp				end