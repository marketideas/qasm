		String	AsIs		print	push		Print	Off		include	'Max.Macros'			include	'common.equ.src'		include	'm16.util2'		Print	pop		blanks	off*******************************************************************               Copyright (c) 1987-1992*               Apple Computer, Inc.*               All rights reserved.********************************************************************               GS/OS DISK][ Driver Version 1.00** NOTE:         All driver files must be installed on the*               boot volume in the subdirectory "/SYSTEM/DRIVERS'.*               Additionally, the FileType for the driver file*               must be set to $00BB.  AuxType is also critical*               to the operating system recognizing the driver*               as a GS/OS device driver.  The AuxType is a long*               word which must have the upper word set to $0000.*               The most significant byte of the least significant*               word in the AuxType must be set to $01 to indicate*               an active GS/OS device driver or $81 to indicate*               an inactive GS/OS device driver.  The least*               significant byte of the least significant word*               of the AuxType field indicates the number of*               devices supported by the driver file.  This value*               should be analogous to the number of DIB's*               contained in the driver file.  GS/OS will only*               install the number of devices indicated in the*               AuxType field.**               GS/OS Device Driver:    FileType = $00BB*                                       AuxType  = $000001XX where:*                                                  XX = number of devices.**               An AuxType of $00000108 indicates eight devices.  When*               building a device driver, the best way to set the*               FileType and AuxType is to use the Exerciser to get*               the current file info (GET_FILE_INFO), modify the*               FileType & AuxType and then SET_FILE_INFO.******************************************************************** REVISION HISTORY:** MM-DD-YY Version Who Description** 11-16-87 0.00e01 RBM Started initial coding.** 01-10-88 0.00e02 RBM Added new status & control calls.*                      Fixed startup for dynamic slot numbers.** 01-12-88 0.00e03 RBM Ported core driver routines to disk][.*                      Completed coding of startup call.*                      Status & Control code moved.*                      Code reduction in status & control*                      Disk switch emulation.** 01-17-88 0.00e04 RBM Appended DISK][ files.*                      Fixed ZP & Absolute references.*                      Call translator installed.*                      Call parameter translation complete.*                      1st attempt media access.*                      Added DIBs for slots 1-3.*                      Seek & Recal fixed (move_sinc_dinc).*                      Self modifying now in correct bank.*                      Realignment of IWM code.** 01-30-88 0.00e05 RBM Added format routines.** 02-01-88 0.01a01 RBM 1st alpha release.** 03-08-88 0.04a01 RBM Added set/get partition call.** 03-18-88 0.04a02 RBM Shutdown returns busy for all but last*                      device to be shutdown.** 06-02-88 0.08a01 RBM Format options to return 140k.** 06-13-88 0.10a01 RBM Repaired slot 2 drive 2 DIB (ProDOS unit number).** 06-22-88 0.10a02 RBM Changed device name from DISK][A to DISK2A.** 07-13-88 0.11b01 RBM Changed DIB name to APPLEDISK5.25** 07-27-88 0.14b01 JOA fixed formating bug for disk2 cards*                      added this line to fix formating to disk2 card problem*                      in wr_adr_16*                      lda     |q6h,x          ;into write sense-setup mode** 07-27-88 0.14b01 JOA added ibwpbit status reporting from rwts level*                      back on every call so the READ routine can maintain*                      the WriteProtect bit in the status word on every call.*                      Also whenever the rwts reports OFFLINE the WP status bit*                      is also cleared (along with the online bit).** 07-27-88 0.14b1  JOA added write protect status bit clearing whenever*                      READ or WRITE call senses the 'fake' timeout and*                      returns the pseudo Disk Switched error.  Likewise in*                      the STATUS call, the Write Protected bit is cleared*                      before returning the status word if the timeout has*                      occured and the volume may have been switched.** 08-13-88 0.18b2  RBM Both read and write now check for a request count*                      of $00000000 prior to executing the call.** 08-16-88 f1      FAB changed sta |wrefd1+1 to sta >wrefd1+1 so it writes*                      into the correct bank of memory. disk2/rwts.nibblize*                                                         (prenib16)** 08-17-88 f3      RBM Block number does not need validated if not*                      a read or write call.** 11-11-88	   RBM Transfer count on a status call to request the*			configuration parameters now returns a value*			of $00000002 in the transfer count rather than*			a value equal to the request count.** 02-23-89	RBM	Readblock now updates internal status so that subsequent*			status call indicates write protect sense from previous*			media access.** 05-17-89	RBM	An experiment: Disable history so that write protect*			is never returned from a status call.  Jim Merritt will*			give final disposition as to whether this change is to*			be checked in or not.** 09-07-90	MVS	Increased reading speed 200%,increased writing speed 275%.** 09-12-90	GAB	The driver is now restartable!*			Added device specific status call:  get_last_volnum ($8001).*			This status call returns the volume number that was read from*			the disk media on the last media access.*			Added device specific control call:  set_next_volnum ($8001).*			This control call allows the caller to specify the volume*			number to be placed in the sector headers when a diskette is*			formatted.  The volume number is reset to 0 after the format*			call is accomplished, which means that the volume number*			normally defaults to 254.** 03-08-91	GAB	Changed flags word in the format options lists to show*			that this driver is an Apple // Format driver only.** 03-22-91	GAB	¥ Fixed status call to return write protected status.*			¥ Fixed xlate_call to ensure that the request count is an*			even multiple of the block size.*			¥ Combined all calls that have no function into a single*			code sequence (see Open)*			¥ Removed format_mode table, since it wasn't being used*			¥ Remove set_format call, since it served no purpose*			¥ Removed set_ctrl (SetConfigParms), since it served no*			useful purpose.** 04/14/91	GAB	¥ Bug fix - LYP281LWA - SetNextVolnum now restricts the*			supplied volume number to 0-254.*			¥ Bug fix - LYP282LWA - DControl Format call now ignores*			the supplied request count.** 07/31/91	GAB	¥ Altered Startup code to check for a physical drive*			connected to the slot.  If no drive is found, Startup*			returns error code $28 (No Device Connected) to the*			device dispatcher, which forces the dispatcher to skip*			installing the DIB into the device list.** 09/18/91	GAB	¥ Fixed Startup call to save and restore the contents*			of CYAREG around the call to ChkDrv0.** 10/02/91	GAB	¥ Changed format options flags to show that this*			driver supports Apple ][ file systems ONLY.** 10/09/91	GAB	¥ Added delay in startup code between the time*			that the drive motor is turned on and the subroutine*			call which checks for the presence of the drive.  This*			was done to allow either the motor to come up to speed*			or the data line to stabilize (in the case of a*			nonexistent drive).  Without the delay, there was*			enough transient noise on the line for the driver*			to recognize the existence of a phantom second*			drive.************************************************************************ System 6.0.1** 08/12/92	DAL	¥ Removed check for drive being present.  For some*			people, it was deciding they had no drive when they*			actually did.  Version $206A.** 2-Apr-93	JCM	¥ During startup we now clear the internal/external*			slot number in our dibs as we scan each slot. This*			stops drives that are attached to a card from disappearing*			when we switch to P8 and come back.** 2-Apr-93	SS	¥Version $2060 for 6.0.1 (final)******************************************************************		sltromsel	equ	$E1C02D		;slot rom select shadow		equ	$E1C035		;shadow register cyareg		equ	$E1C036		;speed and motor on detect statereg	equ	$E1C068		;state register clrrom		equ	$E1CFFF		;switch out $c8 romsphaseoff	equ	$E1C080		; stepper phase off.phaseon		equ	$E1C081		; stepper phase on.ph0off		equ	$E1C080		; phase 0 offph0on		equ	$E1C081		; phase 0 onph1off		equ	$E1C082		; phase 1 offph1on		equ	$E1C083		; phase 1 onph2off		equ	$E1C084		; phase 2 offph2on		equ	$E1C085		; phase 2 onph3off		equ	$E1C086		; phase 3 offph3on		equ	$E1C087		; phase 3 onmotoroff	equ	$E1C088		; disk motor offmotoron		equ	$E1C089		; disk motor ondrv0en		equ	$E1C08A		; select drive 0drv1en		equ	$E1C08B		; select drive 1q6l		equ	$E1C08C		; Q6 lowq6h		equ	$E1C08D		; Q6 highq7l		equ	$E1C08E		; Q7 lowq7h		equ	$E1C08F		; Q7 high;		absolute zero page used by low level routines.ibtype		equ	$000000		; RWTS IOB Typeibslot		equ	$000001		; slot * 16ibdrvn		equ	$000002		; drive number  ($01 or $02)ibvol		equ	$000003		; volume number ($00 = wildcard)ibtrk		equ	$000004		; track number  ($00 - $34)ibsect		equ	$000005		; sector number ($00 - $0F)ibwpbit		equ	$000006		; Word = $0000 or $0004 if WP trueibbufp		equ	$000008		; I/O buffer pointer (in bank $00)ibcmd		equ	$00000C		; RWTS command: $00 = Nullibstat		equ	$00000D		; RWTS status:  $10 = write protectedibsmod		equ	$00000E		; volume number of disk found in driveiobpsn		equ	$00000F		; last slot number accessediobpdn		equ	$000010		; last drive number accessedd2_dct		equ	$000011		; 4 bytes for device char. tablewtemp		equ	$000018midnib1		equ	wtemp+1midnib2		equ	wtemp+2lstnib		equ	wtemp+3yend		equ	wtemp+4intrtry		equ	$000022		; read:   irq retry countblktemp		equ	$000027		; local temp: block numberbuftemp		equ	$000028		; local temp: buffer pointerbuf		equ	$000029		; local temp:sector		equ	$00002A		; local temp: sector numberretryadr	equ	$00002B		; local temp: sector find retriesrecalcnt	equ	$00002D		; local temp: recalibrate countblkcount	equ	$00002E		; blocks required to satisfy blockcntseekwait	equ	$00002F		; <>0 if seek delay neededirqmask		equ	$000030		; entry 'I' bittemp		equ	$000031		; just a tempaa		equ	$000032		; used by formatteridx		equ	$000033		; used by formatternsync		equ	$000034		; used by formatternvol		equ	$000035		; used by formattertrkretry	equ	$000036		; used by formatterl1		equ	$40l2		equ	$44l3		equ	$48w1		equ	$4czp_size		equ	$000050		; must be evenfound		equ	$00D000		; used by formatterdnibl		equ	$00D096-$96	; for now, put nibblize tables herednibl_dest	equ	$00D096twobit3		equ	$00D0A0twobit2		equ	$00D0C0endmrks		equ	$00D0C4twobit1		equ	$00D0E0dnibl2		equ	$00D100dnibl3		equ	$00D101dnibl4		equ	$00D102nibl		equ	$00D103nbuf2		equ	$00D200ontable		equ	$00D256offtable	equ	$00D25Fcurtrk		equ	$00D268drv0trk		equ	$00D269retrycnt	equ	$00D279		; local temp: I/O retriesseekcnt		equ	$00D27A		; seek retry countcount		equ	$00D27Btrkcnt		equ	$00D27B		; half tracks movedlast		equ	$00D27Bcsum		equ	$00D27Ccsstv		equ	$00D27D		; rdadr:  cksumsect		equ	$00D27E		; rdadr:  sectrack		equ	$00D27F		; rdadr:  trackvolume		equ	$00D280		; rdadr:  volumeprior		equ	$00D281trkn		equ	$00D282montimel	equ	$00D283montimeh	equ	$00D284dvmot		equ	$E8		; I have no idea what this issys_buffer	equ	$00AA00		; bank $00 system bufferslot_num	equ	$002E		; (w)  slot numberunit_num	equ	$0030		; (w)  unit numberdib_dev_num	equ	$003E		; (w)  Device number of this devicedriver_unit	equ	$0040		; (w)  driver's internal DIB datadib_pro_unit	equ	$0042		; (w)  ProDOS unit numbermax_command	equ	$0009		; commands $0009 - $ffff undefineddev_name	equ	$000E		; (32) count and ascii name (pstring)blk_cnt		equ	$000A		; (lw) number of blockscurrent_version	equ	$2060		;2-Apr-93 SS;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	alloff		ENTRY	arm_event		ENTRY	check_block		ENTRY	chkdrv		ENTRY	chkprev		ENTRY	chkpv2		ENTRY	ckdrts		ENTRY	close		ENTRY	clrphase		ENTRY	control		ENTRY	ctrl_list		ENTRY	dev_reset		ENTRY	dev_stat		ENTRY	dib_1		ENTRY	dib_2		ENTRY	dib_3		ENTRY	dib_4		ENTRY	dib_5		ENTRY	dib_6		ENTRY	dib_7		ENTRY	dib_8		ENTRY	dib_9		ENTRY	dib_a		ENTRY	dib_b		ENTRY	dib_c		ENTRY	dib_d		ENTRY	dib_e		ENTRY	disarm_event		ENTRY	disk2_task		ENTRY	dispatch		ENTRY	drivsel		ENTRY	drvindx		ENTRY	dstat1		ENTRY	dstat2		ENTRY	dstat3		ENTRY	dstat4		ENTRY	dstat5		ENTRY	dstat6		ENTRY	dstat7		ENTRY	dstat8		ENTRY	dstat9		ENTRY	dstatB		ENTRY	dstatC		ENTRY	dstatD		ENTRY	dstatE		ENTRY	flush		ENTRY	format		ENTRY	format_media		ENTRY	get_ctrl		ENTRY	get_format		ENTRY	get_partition		ENTRY	get_wait		ENTRY	media_eject		ENTRY	msw2		ENTRY	mswait		ENTRY	myseek		ENTRY	ok		ENTRY	ok1		ENTRY	open		ENTRY	prenib1		ENTRY	prenib16		ENTRY	prenib2		ENTRY	prenib3		ENTRY	preset_dsw		ENTRY	prn1		ENTRY	prn2		ENTRY	prn3		ENTRY	rd4		ENTRY	rd5		ENTRY	rd6		ENTRY	rd7		ENTRY	rd8		ENTRY	rda1		ENTRY	rdadr16,rdadr16E		ENTRY	rderr		ENTRY	rderr1		ENTRY	rderr2		ENTRY	rdok		ENTRY	rdright		ENTRY	read		ENTRY	read16		ENTRY	recal1		ENTRY	ref1		ENTRY	ref2		ENTRY	ref3		ENTRY	rsetphse		ENTRY	rttrk		ENTRY	rwts1		ENTRY	seek		ENTRY	set_ctrl		ENTRY	set_dev_stat		ENTRY	set_format		ENTRY	set_partition		ENTRY	set_partn		ENTRY	set_wait		ENTRY	set_xfer_cnt		ENTRY	settrk		ENTRY	shutdn		ENTRY	startup		ENTRY	status		ENTRY	trytrk		ENTRY	trytrk2		ENTRY	verify16		ENTRY	wdata1		ENTRY	wdata4		ENTRY	wdne1		ENTRY	wdone		ENTRY	wexit		ENTRY	wmod1		ENTRY	wmod2		ENTRY	wmod3		ENTRY	wnibl		ENTRY	wnibl7		ENTRY	wnibl9		ENTRY	wr16		ENTRY	write		ENTRY	write16		ENTRY	write_fmt_16		ENTRY	wrtodd		ENTRY	xlate_call		entry	highsc,lowsc,nsec,nsec2,secleft,tk_base,Tscmap,cbl,mts		entry	seccnt,nxtwrt		entry	cblE,pdf				EJECT;;		macros.		MACRO		skip1		dc.b	$24		ENDM******************************************************************* The following table is the header required for all loaded* drivers which consists of the following:**               Word    Offset from start to 1st DIB*               Word    Number of DIBs*               Word    Offset from start to 1st control list*               Word    Offset from start to 2nd control list*               etc.******************************************************************		export	driver_data	driver_data	PROC	align		256		export	herehere		dc.w	dib_1-here	; offset to 1st DIB		dc.w	14		; number of devices		dc.w	ctrl_list-here	; offset to 1st control list		dc.w	ctrl_list-here	; offset to 2nd control list		dc.w	ctrl_list-here	; offset to 3rd control list		dc.w	ctrl_list-here	; offset to 4th control list		dc.w	ctrl_list-here	; offset to 5th control list		dc.w	ctrl_list-here	; offset to 6th control list		dc.w	ctrl_list-here	; offset to 7th control list		dc.w	ctrl_list-here	; offset to 8th control list		dc.w	ctrl_list-here	; offset to 9st control list		dc.w	ctrl_list-here	; offset to And control list		dc.w	ctrl_list-here	; offset to Brd control list		dc.w	ctrl_list-here	; offset to Cth control list		dc.w	ctrl_list-here	; offset to Dth control list		dc.w	ctrl_list-here	; offset to Eth control list** The following are the driver control parameter lists.  Since* the DISK][ has no real control lists, one common list is shared* among all DISK][ devices.*		export	ctrl_listctrl_list	dc.w	0		; 0 bytes in parameter list		export	default_listdefault_list	dc.w	0		; 0 bytes in default list		eject******************************************************************* The following are tables of format options for each device.* The format option tables have the following structure:**               Word    Number of entries in list*               Word    Display count (number of head links)*               Word    Recommended default option*               Word    Option that current online media is formatted with*               Entries 16 bytes per entry in the format list** The twenty byte structure for each entry in the format list* is as follows:**               Word    Media variables reference number*               Word    Link to reference number n.*               Word    Flags / Format environment*               Long    Number of blocks supported by device*               Word    Block size*               Word    Interleave factor*               Long    Number of bytes defined by flag** Bit definition within the flags word is as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |___|__ Format*   |   |   |   |   |   |   |   |   |   |   |   |   |___|__________ Flags*   |___|___|___|___|___|___|___|___|___|___|___|__________________ Reserved** Format Bit Definition: 00   Universal format*                        01   Apple Format*                        02   NonApple Format*                        11   Not Valid** Flag Bit Definition:   00   Size is in bytes*                        01   Size is in Kb*                        02   Size is in Mb*                        11   Size is in Gb******************************************************************		export	format_tblformat_tbl		dc.w	2		; 2 entries this list		dc.w	1		; 1 display entry		dc.w	1		; recommended option is 1		dc.w	0		; current media formatted w/option** List for entry reference number 1.*		dc.w	1		; reference number 1		dc.w	2		; ref num of linked entry		dc.w	7		; flags = Apple //, size in K		dc.l	280		; block count		dc.w	512		; block size		dc.w	0		; interleave factor		dc.w	140		; device byte count in kilobytes** List for entry reference number 2.*		dc.w	2		; reference number 1		dc.w	0		; ref num of linked entry		dc.w	7		; flags = Apple //, size in K		dc.l	560		; block count		dc.w	256		; block size		dc.w	0		; interleave factor		dc.w	140		; device byte count in kilobytes		eject*******************************************************************               Link Pointer*               Entry Pointer*               Device Characteristicscharacteristics	equ	%0000101111101100*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |_ RESERVED*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |_____ RESERVED*   |   |   |   |   |   |   |   |   |   |   |   |   |   |_________ REMOVABLE*   |   |   |   |   |   |   |   |   |   |   |   |   |_____________ FORMAT*   |   |   |   |   |   |   |   |   |   |   |   |_________________ RESERVED*   |   |   |   |   |   |   |   |   |   |   |_____________________ READ*   |   |   |   |   |   |   |   |   |   |_________________________ WRITE*   |   |   |   |   |   |   |   |   |_____________________________ BLOCK DEVICE*   |   |   |   |   |   |   |   |_________________________________ SPEED GROUP (LSB)*   |   |   |   |   |   |   |_____________________________________ SPEED GROUP (MSB)*   |   |   |   |   |   |_________________________________________ FIXED NAME*   |   |   |   |   |_____________________________________________ RESTARTABLE*   |   |   |   |_________________________________________________ BUSY*   |   |   |_____________________________________________________ LINKED*   |   |_________________________________________________________ GENERATED*   |_____________________________________________________________ RAM/ROM DEV**               Block Count*               Device Name*               Slot Number*               Unit Number*               Device ID Number*               Head Device Link*               Forward Device Link*               Extended DIB Pointer*               DIB Device Number******************************************************************		export	dib_1dib_1		dc.l	dib_2		; link pointer to second DIB		dc.l	dispatch	; entry pointer		dc.w	characteristics		dc.l	280		; block count		dc.b	14		; device name (length & ascii)		dc.b	'APPLEDISK5.25A                 ' 		dc.w	7		; slot #		dc.w	1		; unit #		dc.w	current_version	; version # 2.01		dc.w	0		; device ID number		dc.w	0		; head device link		dc.w	0		; forward device link		dc.l	0		; Extended DIB pointer		dc.w	0		; DIB Device Number		dc.w	0		; drivers internal device number		dc.w	$0070		; driver ProDOS unit for RWTS		export	dib_2dib_2		dc.l	dib_3		; link pointer		dc.l	dispatch	; entry pointer		dc.w	characteristics		dc.l	280		; block count		dc.b	14		; device name (length & ascii)		dc.b	'APPLEDISK5.25A                 ' 		dc.w	7		; slot #		dc.w	2		; unit #		dc.w	current_version	; version # 2.01		dc.w	0		; device ID number		dc.w	0		; head device link		dc.w	