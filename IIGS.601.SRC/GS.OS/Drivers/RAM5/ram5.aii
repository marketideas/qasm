******************************************************************************** GS/OS loaded driver for /RAM5 (the SmartPort RAM disk)** Originally by Matt Deatherage** Copyright 1990-92 Apple Computer, Inc.* All rights reserved.********************************************************************************* This driver replaces the generated driver for the built-in SmartPort* RAM disk.  It implements all block driver functions.  It does not* support caching because it's faster to just read from the disk than* to search the cache for memory.** No functions in the RAM disk toolset (#13) are used, although some of* the RAM disk toolset's internal storage locations (such as the RAM disk* handle beginning) must be used so when GS/OS is shut down, P8 has the* same RAM disk.********************************************************************************* 26-Mar-92 Dave Lyons** Converted source to MPW IIgs (from APW).  So far, only ROM 3's RAMdisk* is supported.  ROM 1 is different.** 6-Apr-92 Dave Lyons** Fixed DStatus(0) to not always return 6 bytes.  If you only ask for two,* you only get two.********************************************************************************* 5-Feb-93 Steve Stephenson (for 6.0.1d13)** Added support for ROM 1.** 10-Feb-93 Steve Stephenson** Rewrote the FixUnitNum routine to work when there are no floppies attached.* Changed the ROM 1 error reporter to use 'report_error' vice TLTextMountVolume*  (it is not around at boot time!)** 11-Feb-93 Steve Stephenson (for 6.0.1d13+)** Fixed a stack imbalance bug in ROM 1 format.** 17-Feb-93 JCM (for 6.0.1d14)** Fixed the main call handler, DStatus and DControl subcall handlers* to validate the call requests and return errors on the ones we know* nothing about. I also removed all of the device-specific subcalls,* since they aren't useful any more with the new ROM 01 architecture.** 25-Feb-93 SS** Fixed Read & Write to return an error _and_ copy bytes that are in range when* the request count would take us past the end of the disk (previously it just* returned an error and copied nothing).** Optimized and significantly cleaned up the Status and Control subcalls.  Changed* eject to return no error.  Removed all references to set/get format options -* they now do nothing and return no err.** Removed some dead code and old data.  Changed the version from experimental to beta.** 1-Mar-93 DAL** If the RAM disk has never been formatted, we need to put down an empty ProDOS* directory, like the ROM does.  See routine FormatIfNeeded.  It calls the* ROM to do the work for us.** 4-Mar-93 SS** Fixed a fatal flaw in the ROM1 read/write where <bufferPtr was not being incremented* for each subsequent chunk.** 8-Mar-93 SS** Added more bullet proofing to the startup code to trap for a resized disk on a ROM1* that hasn't yet had all of the handles allocated.** 1-Apr-93 SS (for 6.0.1d16)** Changed version to 1.0 for release.** 6-May-93 DAL (6.0.1d17)** Added NukeIfEmptyPascal routine to cause a reformat as ProDOS in the case that* the ROM formats RAM5 as Pascal because is was slot 5 unit 1 and the startup* scanned past slot 5 before the environment looked like ProDOS.************************************************************************* To Do** Make this work even if slot 5 is not switched in (for ex, Mustang in slot 5)*******************************************************************************DebugSymbols	equ 0		print push	print off	include 'e16.gsos'	include 'all.macros'	macro&lab	DateTimeStamp&lab	dc.b '&Sysdate &SysTime'	mend	print pop	TheVersion	equ $1000	;1.0 (final);; First, GS/OS direct page equates and our additions;deviceNum	equ $00callNum	equ $02bufferPtr	equ $04requestCount	equ $08transferCount	equ $0CblockNum	equ $10blockSize	equ $14controlCode	equ $16statusCode	equ $16fstID	equ $16volumeID	equ $18cachePriority	equ $1AcachePointer	equ $1CdibPointer	equ $20handle	equ dibPointer+4pointer	equ handle+4transferBlocks	equ pointer+4temp	equ transferBlocks+4DPSize	equ temp+4SET_DISKSW	equ $01FC90MOVE_INFO	equ $01FC70moveblkcmd	equ $0800move_sinc_dinc	equ $05+moveblkcmdmove_scon_dinc	equ $04+moveblkcmd	; for zeroing blocksreport_error	equ $01FC94	; GS/OS error message handler;SmartPort globalsRamUnit	equ $E10FBC	;the generated RAM disk's number	ReMap	equ $E10FC0	;where the units got remappedDrvrDiskSw	equ $002E	; disk switched error;; Now some of our private equates;CurDiskSize	equ $E11642DiskHandles	equ $E11646FormatFlag	equ $E1164AOurBlockSize	equ $0200BootRAM	equ $0008	; startup slot value in BRAMStatusWord	equ $0010	; only "disk in drive", normally;; First, the device driver header.  We only support one device with no; device-specific configuration list, so this isn't too hard.;RAMDisk	PROCOffset	dc.w OurDIB-RAMDisk	; offset to our DIBDevCount	dc.w 1	; just one deviceListOffset	dc.w 0	; no configuration list;; Here's our driver's code section.  We dispatch based on the command; number and go do it.;RAMDiskCode	name	phk	plb	cmp #8+1	;Driver_Shutdown+1	bcc @handleCall	lda #drvrBadReq	;invalid driver request		bra @exitDriver	;return the error and condition the carry@handleCall		asl a	; double the accumulator	tax		stz OurError		jsr (DrvrTable,X)	; dispatch to it	lda OurError@exitDriver	cmp #1	; condition the carry	rtl	; and we're out of hereDrvrTable	dc.w Startup	dc.w Open	dc.w Read	dc.w Write	dc.w Close	dc.w Status	dc.w Control	dc.w Flush	dc.w Shutdown************************************************************************ The startup call looks to see if a SmartPort RAM disk exists in* slot 5, and which ROM version we're using.  If we can't find the* SP RAM disk, we return with an error so we get unloaded.	If we* do find it, we claim it and go to town.** Inputs: GS/OS direct page** Outputs: GS/OS direct page***********************************************************************Startup	name;; First, see if there is a RAMdisk installed or not;	lda >DiskHandles	ora >DiskHandles+2	bne gotdiskNoRAMDisk	lda #DrvrNoDevice	; no device found	sta OurError	rts	; goodbye;; OK, so there's a disk.  Find out what ROM version this is.;gotdisk	pha	; space for P	pha	; space for A	pha	; space for X	pha	; space for Y	lda #0	pha	pha	pha	pea $FE1F	; IDROUTINE	_FWEntry	pla	; the ROM version number	plx	; don't care	plx	; don't care	plx	; don't care	and #$00FF	; just in case	sta ROMVersion	; now we know	cmp #1	bne @ok	* for ROM1, both min & max must be the same - we don't support dynamic resizing!	pha	; space for result	pea $0036	; minimum RAM disk size	_ReadBParam	;leave result on stk	pha	; space for result	pea $0037	; maximum RAM disk size	_ReadBParam	pla	sta chunkNum	;temp hold # of 32k chunks for next check	eor 1,s	;compare min and max	sta 1,s	pla	bne @err	;must be the same, or show error msg* Look at the last chunk handle in the chain.  If it's zero, not all of the handles* were allocated.  User probably reset min/max without recycling power.	lda chunkNum	;convert to highest 16k chunk number	asl a	dec a	pha	;(spc for handle)	pha		asl a	;* 20 (size of a handle)	asl a	adc 1,s		asl a		asl a	;= offset	adc >DiskHandles	;+ 1st handle	sta 1,s	lda >DiskHandles+2	sta 3,s	;= last handle	phd	tsc	tcd	ldy #1	lda [3],y	;get mid word in X (MUST be non-zero if handle)	tax	pld	;fix stk	pla	pla	txa	;was there a handle?	bne @ok	; yes	@err	pea 68	; error 68 (size mismatch error)	lda #0	pha	pha	pha	pha	jsl report_error	; cause message to be displayed	brl NoRAMDisk	; and exit with no disk.	@ok	jsr FixUnitNum	; put the right unit # in our DIB	jsr FixBlockCount	; put the right size in our DIB	jsr NukeIfEmptyPascal  ; added 6-May-93 DAL	jsr FormatIfNeeded	; make a ProDOS directory (added 1-Mar-93 DAL)	inc AreWeHere	rts	;; Find the SmartPort Unit Number so we can fill in our DIB's unitNum; field with the same value.  If we don't, the device dispatcher won't kill; the generated driver for the RAM disk.;FixUnitNum		longa off	longi off	sep #$30	lda >RamUnit	;get the orig unitNum (should be a 1)	ldx #4@search	cmp >ReMap-1,x	;find where in the table it ended up (1É4)	beq @found	dex	bne @search	brk $cf	;shouldn't happen!	@found	stx UnitNum		longa on	longi on	rep #$30	rts*** added 6-May-93 DAL -- If we have an empty Pascal RAM5, nuke it***  (This happens if we Scan past slot 5 and there are no floppies attached.***  The ROM decides we are in UCSD Pascal even though we aren't in anything***  yet.)NukeIfEmptyPascal	phd	lda >DiskHandles+2	pha	lda >DiskHandles	pha	tsc	tcd	ldy #2	lda [1],y	tax	lda [1]	sta 1	stx 3	;<1 = ptr to first chunk	ldy #$0400	lda [1],y	bne @notPascal	;blk 2 first word must be $0000 (HFS has signature here)	ldy #$0406	;blk 2 +006 = $04 $52 for Pascal (as in 4 'RAM5')	lda [1],y	cmp #$5204	bne @notPascal	ldy #$0410	;look at io_file_count	lda [1],y	bne @notEmpty	lda #0	sta >FormatFlag	;mark it as unformatted@notEmpty@notPascal	pla	pla	;discard ptr	pld	rts*** end 6-May-93;; FixBlockCount sees how big our RAM disk is supposed to be from the; MemMgr global and sets that parameter in our DIB.;FixBlockCount	lda >CurDiskSize+1	lsr a	sta BlockCount	stz BlockCount+2	rts************************************************************************ FormatIfNeeded** If FormatFlag is $0000, then there has been no access to RAM5* through the firmware, because slot 5 is set to Your Card, and* the firmware never got a chance to write an empty ProDOS directory.** We have to force the directory to be written so the user won't* get an annoying and confusing "GS/OS doesn't recognize the disk* in device .RAMDISK" dialog.** For ROM 1, we call $FF/12C0.* For ROM 3, we call $FC/159D.** In either case, we need B=$E1, and D pointing to some scratch space;* the ROM will uses $00..$1A.  The ROM sets FormatFlag to $FFFF before* returning.** Since the ROM routine ends with an RTS (and we are obviously not in* the same bank as the ROM routine we're calling), we have to push our* 3-byte RTL address manually, then push the 2-byte address (minus 1)* of an RTL in the same bank as the ROM routine, and do a long jump to* the routine.  It RTSs to the RTL, which RTLs to us.***********************************************************************FormatIfNeeded	name	lda >FormatFlag	bmi @alreadyFormatted	phb	pea $E1E1	plb	plb	phd	tsc	sec	sbc #$0020	tcs	inc a	tcd	lda >ROMVersion	dec a	beq @FormatROM1	dec a	dec a	bne @cleanUp	;not ROM 1, not ROM 3, give up@FormatROM3	phk	per @cleanUp-1	pea $FE7F-1	;RTS at $FC/FE7F	jml >$FC159D@FormatROM1	phk	per @cleanUp-1	pea $01E8-1	;RTS at $FF/01E8	jml >$FF12C0@cleanUp	tsc	clc	adc #$0020	tcs	pld	plb@alreadyFormatted	rts************************************************************************ Open does nothing for a block device.** Inputs: GS/OS direct page** Outputs: GS/OS direct page***********************************************************************Open	name	rts************************************************************************ Read is half the meat of the driver - this transfers bytes from the* RAM disk into the destination buffer.	On ROM 03 this does a single,* gigantic MOVE_INFO for the whole transfer.  On ROM 01 this is broken* up into as many 16K or less transfers as necessary.** Inputs: GS/OS direct page** Outputs: GS/OS direct page***********************************************************************Read	name;; Before doing anything else, set up our hybrid DP on the stack;	lda AreWeHere	bne @WereHere	jsl SET_DISKSW	inc AreWeHere	lda #DrvrDiskSw	brl ReadError2@WereHere	jsr MakeOurDP;; Make sure there is something to do;	lda <requestCount	ora <requestCount+2	bne @CheckSize		brl ReadExit	; no action in this case;; Make sure this has our block size;@CheckSize	lda <BlockSize	cmp #OurBlockSize	bne rBadCount		lda <requestCount+2	;clone the amount to do into a local	sta bytesToDo+2	lda <requestCount	sta bytesToDo;; Make sure the requested transfer is within our RAM disk's size;	clc	lda <blockNum	adc <TransferBlocks	sta <temp	lda <BlockNum+2	adc <TransferBlocks+2	sta <temp+2	; temp contains the last block to do	sec	lda BlockCount	sbc <Temp	lda BlockCount+2	sbc <temp+2	bcs @CheckTheCount	; yes, continue			lda #DrvrBadBlock	; no, flag as out of bounds,	sta OurError	stz bytesToDo	; but do what will fit anyway.	stz bytesToDo+2	lda BlockCount	;reset BytesToDo	sec	; to amount between starting blk and last blk	sbc <blockNum	asl a	sta BytesToDo+1;; Make sure the request count is an integral multiple of the block size;@CheckTheCount	lda <requestCount	and #$1FF	; the block size	beq DoTheRead	rBadCount	lda #DrvrBadCount	sta OurError	brl ReadExit;; If we got this far, we have something to read and 'BytesToDo' holds the amount;DoTheRead	lda ROMVersion	cmp #1	beq ROM1read;; If we're on ROM 3, just do a big transfer;ROM3read	name; calc the offset into the block	stz <temp	stz <temp+2	lda <blockNum	asl a	sta <temp+1	; now temp = starting block * $200; add the offset to the start of the block to get the abs addr		clc	lda <temp	adc <Pointer	tay	lda <temp+2	adc <Pointer+2	pha	phy	; source address now on stack	pei <bufferPtr+2	pei <bufferPtr	; destination address on the stack	pushlong BytesToDo	; request count on stack	pea move_sinc_dinc	; the command word	jsl MOVE_INFO	; system service call	lda BytesToDo+2	;return the actual amount copied	sta <transferCount+2	lda BytesToDo	sta <transferCount	brl ReadExit;; On ROM 1, the source may be distributed over 1 or more 16k chunks.  The first; group of bytes may or may not be aligned to the chunk start, but all remaining; groups will be.  The number of bytes to move must be the lesser of: 16k; the; remaining bytes available in the chunk; or the request count.;ROM1read	name	lda <blockNum	;figure the offset addr just like ROM 3	asl a	; (by multiplying by $200)	and #$3F	;but ignore all above 16k	xba	sta chunkOffset	;offset into this 16k chunk	lda <blockNum	;now find the chunk..	lsr a	;div by 32 as there are 32 blocks in 16k	lsr a		lsr a		lsr a		lsr a		sta chunkNum@nextChunk	jsr GetChunkPointer	;convert chunkNum (in A) to its pointer		lda #$4000	;init chunkSize to the remainder in	sec	; this chunk	sbc chunkOffset	sta chunkSize		ldy bytesToDo+2	;if # to do is bigger, OK	bne @useChunkSize	cmp bytesToDo	bcc @useChunkSize	lda bytesToDo	;else use the lesser	sta chunkSize@useChunkSize	jsr ReadAChunk	;read 'chunkSize' # of bytes		jsr DecBytesToDo	;reduce 'to do' by chunkSize	beq ReadExit	; til zero = done.		stz chunkOffset	;read nxt chunk from the beginning	inc chunkNum	lda chunkNum	;repeat with next chunk	bra @nextChunk;; That's all.  Remove our DP and get out of here.;ReadExit	jsr FixDPReadError2	rts;; Move some bytes.  Source addr is within a 16k chunk.  The range starts at; the offset and ends at offset + size (which is pinned to the chunk).;ReadAChunk	name	clc	lda <pointer	adc chunkOffset	tay	lda <pointer+2	adc #0	pha	phy	; source address now on stack	pei <bufferPtr+2	pei <bufferPtr	; destination address on the stack	pea 0	pushword chunkSize	; request count on stack	pea move_sinc_dinc	; the command word	jsl MOVE_INFO	; system service call		lda <transferCount	;keep a running total for final exit	clc	adc chunkSize	sta <transferCount	bcc @nohi	inc <transferCount+2@nohi	rts	************************************************************************ Write takes the buffer and puts it to the RAM disk, after verifying* all the same stuff Read did.** Inputs: GS/OS direct page** Outputs: GS/OS direct page***********************************************************************Write	name;; Before doing anything else, set up our hybrid DP on the stack after checking; for a startup error;	lda AreWeHere	bne @WereHere	jsl SET_DISKSW	inc AreWeHere	lda #DrvrDiskSw	brl WriteError2@WereHere	jsr MakeOurDP;; Make sure there is something to do;	lda <requestCount	ora <requestCount+2	bne @CheckSize		brl WriteExit	; no action in this case;; Make sure this has our block size;@CheckSize	lda <BlockSize	cmp #OurBlockSize	bne wBadCount		lda <requestCount+2	;clone the amount to do into a local	sta bytesToDo+2	lda <requestCount	sta bytesToDo;; Make sure the requested transfer is within our RAM disk's size;	clc	lda <blockNum	adc <TransferBlocks	sta <temp	lda <BlockNum+2	adc <TransferBlocks+2	sta <temp+2	; temp contains the last block to do	sec	lda BlockCount	sbc <Temp	lda BlockCount+2	sbc <temp+2	bcs @CheckTheCount	; yes, continue			lda #DrvrBadBlock	; no, flag as out of bounds,	sta OurError	stz bytesToDo	; but do what will fit anyway.	stz bytesToDo+2	lda BlockCount	;reset BytesToDo	sec	; to amount between starting blk and last blk	sbc <blockNum	asl a	sta BytesToDo+1;; Make sure the request count is an integral multiple of the block size;@CheckTheCount	lda <requestCount	and #$1FF	; the block size	beq DoTheWrite	wBadCount	lda #DrvrBadCount	sta OurError	brl WriteExit;; If we got this far, we have something to write and 'BytesToDo' holds the amount;DoTheWrite	lda ROMVersion	cmp #1	beq ROM1write;; If we're on ROM 3, just do a big transfer;ROM3write	name	pei <bufferPtr+2	pei <bufferPtr	; source address on the stack; calc the offset into the block	stz <temp	stz <temp+2	lda <blockNum	asl a	sta <temp+1	; now temp = starting block * $200; add the offset to the start of the block to get the abs addr		clc	lda <temp	adc <Pointer	tay	lda <temp+2	adc <Pointer+2	pha	phy	; destination address now on stack	pushlong BytesToDo	; request count on stack	pea move_sinc_dinc	; the command word	jsl MOVE_INFO	; system service call	lda BytesToDo+2	;return the actual amount copied	sta <transferCount+2	lda BytesToDo	sta <transferCount	brl WriteExit;; On ROM 1, the source may be distributed over 1 or more 16k chunks.  The first; group of bytes may or may not be aligned to the chunk start, but all remaining; groups will be.  The number of bytes to move must be the lesser of: 16k; the; remaining bytes available in the chunk; or the request count.;ROM1write	name	lda <blockNum	;figure the offset addr just like ROM 3	asl a	; (by multiplying by $200)	and #$3F	;but ignore all above 16k	xba	sta chunkOffset	;offset into this 16k chunk	lda <blockNum	;now find the chunk..	lsr a	;div by 32 as there are 32 blocks in 16k	lsr a		lsr a		lsr a		lsr a		sta chunkNum@nextChunk	jsr GetChunkPointer	;convert chunkNum (in A) to its pointer		lda #$4000	;init chunkSize to the remainder in	sec	; this chunk	sbc chunkOffset	sta chunkSize		ldy bytesToDo+2	;if # to do is bigger, OK	bne @useChunkSize	cmp bytesToDo	bcc @useChunkSize	lda bytesToDo	;else use the lesser	sta chunkSize@useChunkSize	jsr WriteAChunk	;write 'chunkSize' # of bytes		jsr DecBytesToDo	;reduce 'to do' by chunkSize	beq WriteExit	; til zero = done.		stz chunkOffset	;read nxt chunk from the beginning	inc chunkNum	lda chunkNum	;repeat with next chunk	bra @nextChunk;; That's all.  Remove our DP and get out of here.;WriteExit	jsr FixDPWriteError2	rts;; Move some bytes.  Destination addr is within a 16k chunk.  The range starts at; the offset and ends at offset + size (which is pinned to the chunk).;WriteAChunk	name	pei <bufferPtr+2	pei <bufferPtr	; source address on the stack	clc	lda <pointer	adc chunkOffset	tay	lda <pointer+2	adc #0	pha	phy	; destination address now on stack	pea 0	pushword chunkSize	; request count on stack	pea move_sinc_dinc	; the command word	jsl MOVE_INFO	; system service call		lda <transferCount	clc	adc chunkSize	sta <transferCount	bcc @nohi	inc <transferCount+2@nohi	rts	************************************************************************ Close doesn't do anything for block devices.** Inputs: GS/OS direct page** Outputs: GS/OS direct page***********************************************************************Close	name	rts************************************************************************ Status handles all the status subcalls.** Inputs: GS/OS direct page** Outputs: GS/OS direct page***********************************************************************Status	name	lda <statusCode	cmp #4+1	;GetPartitionMap+1	bcc @handleCall		lda #drvrBadCode	;we don't know about this call so return an error	sta OurError	rts	@handleCall	asl a	tax	stz <TransferCount	;preset to zero as most functions return nothing	stz <TransferCount+2		jsr (statusTable,x)	rtsStatusTable	dc.w GetDeviceStatus	dc.w GetConfigParams	dc.w GetWaitStatus	dc.w GetFormatOptions	dc.w GetPartitionMap	;; Do nothing.  Return no error and transfer count of zero.;GetFormatOptions	nameGetPartitionMap	name	rts;; GetDeviceStatus returns our status word and block count;GetDeviceStatus	name	lda #2	sta <transferCount*** added 6-Apr-92 DAL -- Don't always return block count!  Check request count first.	lda <requestCount	cmp #6	bcc @skipBlockCount	lda #6	sta <transferCount*** end 6-Apr-92	ldy #4	lda BlockCount+2	sta [<BufferPtr],y	dey	dey	lda BlockCount	sta [<BufferPtr],y@skipBlockCount;; Ah, yes -- remember to set the disk_switched bit if we are in fact; switched...;	lda AreWeHere	bne NotSwitched	lda #StatusWord+1	; set the disk_sw bit	bra GDSOutNotSwitched	lda #StatusWordGDSOut	sta [<BufferPtr]	rts;; GetConfigParameters returns our configuration list, of which we don't; have one.  Of.;GetConfigParams	name	;fall thru to do same as GetWaitStatus...;; GetWaitStatus returns that we're always in wait mode.;GetWaitStatus	name	lda #0	sta [<BufferPtr]	lda #2	sta <transferCount	rts************************************************************************ Control takes the control list and sets our drivers parameters* accordingly.** Inputs: GS/OS direct page** Outputs: GS/OS direct page***********************************************************************Control	name	lda AreWeHere	bne @WereHere	jsl SET_DISKSW	inc AreWeHere	lda #DrvrDiskSw	bra @error@WereHere	lda <controlCode	cmp #setPartitionMap+1 ;maximum command we know+1	bcc @handleCall		lda #drvrBadCode	;invalid control subcall@error	sta OurError	rts	@handleCall	asl a	tax	stz <TransferCount	;preset to zero as most functions return nothing	stz <TransferCount+2		jsr (controlTable,x)	rtsControlTable	dc.w doResetDevice	dc.w doFormatDevice	dc.w doEjectMedium	dc.w doSetConfigParams	dc.w doSetWaitStatus	dc.w doSetFormatOptions	dc.w doAssignPartitionOwner	dc.w doArmSignal	dc.w doDisarmSignal	dc.w doSetPartitionMap;; The following routines do nothing, return no error, and zero transfer count.;NoAction	namedoResetDevice	namedoEjectMedium	namedoSetFormatOptions	namedoAssignPartitionOwner namedoArmSignal	namedoDisarmSignal	namedoSetPartitionMap	name	rts;; FormatDevice does a physical format.  For us, that's zeroing the entire disk.;doFormatDevice	nameblkHandle	equ transferCount	;borrow some dp vars for ROM 1chunkHandle	equ cachePointer	lda >DiskHandles	;get the first handle	sta <blkHandle	lda >DiskHandles+2	sta <blkHandle+2		lda ROMversion	cmp #1	beq ROM1Format	ROM3Format	name	lda [<blkHandle]	;only 1 handle, deref in place	tax	ldy #2	lda [<blkHandle],y	sta <blkHandle+2	stx <blkHandle			pushlong #ZeroWord	; address of word of $0000	pei <blkHandle+2	pei <blkHandle	pha	pha	pushlong >DiskHandles	_GetHandleSize	; count now on the stack	pea move_scon_dinc	; source constant, destination inc	jsl MOVE_INFO	rts	ROM1Format	name	lda BlockCount	;start at the handle with the last block	dec a	lsr a	;div by 32 to find which 16k it's in	lsr a		lsr a		lsr a		lsr a		sta chunkNum@nextChunk	pha	;(chunkNum * 20) + 1st handle addr	asl a	; = this chunk handle	asl a	adc 1,s		asl a		asl a		plx		adc <blkHandle	sta <chunkHandle	lda <blkHandle+2	sta <chunkHandle+2		ldy #2	lda [chunkHandle],y	;deref in place	tax	lda [chunkHandle]	sta <chunkHandle	stx <chunkHandle+2	jsr FormatAChunk	;zero out this 16k chunk	dec chunkNum	lda chunkNum	bpl @nextchunk	;and loop on remaining chunks	rts	FormatAChunk	name	pushlong #ZeroWord	; address of word of $0000	pei <chunkHandle+2	pei <chunkHandle	pushlong #$4000	pea move_scon_dinc	; source constant, destination inc	jsl MOVE_INFO	rts	;; SetConfigParameters has to make sure they don't do something stupid;doSetConfigParams	name	;fall thru to do same as SetWaitStatus...	;..if input non-zero, return error;; SetWaitStatus checks to make sure they don't ask for no-wait mode;doSetWaitStatus	name	lda [<BufferPtr]	bne ConfigError	rts	ConfigError	name	lda #DrvrBadParm	sta OurError	rts************************************************************************ Flush does nothing for block devices** Inputs: GS/OS direct page** Outputs: GS/OS direct page***********************************************************************Flush	name	rts************************************************************************ Shutdown undoes what we did at Startup.** Inputs: GS/OS direct page, warm_cold_flag** Outputs: GS/OS direct page***********************************************************************Shutdown	name	stz AreWeHere	rts********************************************************************************* Get the pointer to the 16k chunk** Input: A = chunkNum ; <handle valid** Output: <Pointer set** Uses <temp********************************************************************************;To find the handle of the proper block, multiply the chunkNum by 20 (width of; a handle) and add the result to the first handle.  Deref and return the pointer.GetChunkPointer	name	pha		asl a	asl a	adc 1,s	;times 5	asl a	;times 10	asl a	;times 20	plx	;fix stk	adc <handle	sta <temp	lda <handle+2	sta <temp+2		ldy #2	;deref	lda [temp],y	sta <pointer+2	lda [temp]	sta <pointer	rts		********************************************************************************* Reduce the bytes to do count by the amount done*  and step the buffer pointer for the next chunk** Inputs: None** Outputs: Z=1=done (no more to do)********************************************************************************DecBytesToDo	name	lda <bufferPtr	;*** added 4-Mar-93 SS	clc	;*** bump the caller's addr for MOVE_INFO	adc chunkSize	sta <bufferPtr	bcc @nohi	inc <bufferPtr+2@nohi	lda bytesToDo	sec	sbc chunkSize	sta bytesToDo	lda bytesToDo+2	sbc #0	sta bytesToDo+2	ora bytesToDo	rts	************************************************************************ MakeOurDP creates a DPsize-byte direct page on the stack, filling the* first 36 bytes of it with the parameters from GS/OS direct page.** Inputs: None** Outputs: None***********************************************************************MakeOurDP	name	ply	; the RTS address	tdc	sta GSOSDP	; save this for later	tsc	sec	sbc #DPSize	; how many bytes to use	tcs	; now it's the stack pointer	phy	; now the RTS address is back	inc a	; fix the offsets for DP	tcd	; and set up our DP;; Now we get to copy GS/OS direct page to ours without admitting we know; it's at $BD00...;	tay	; y contains destination	ldx GSOSDP	; x contains source	lda #dibPointer+3	; one less than count	phb	mvn $00,$00	; here's the move	plb;; Now we set up the other things on our DP;	lda >DiskHandles	sta <Handle	lda >DiskHandles+2	sta <Handle+2	lda [<Handle]	sta <Pointer	ldy #2	lda [<Handle],y	sta <Pointer+2	; now they point to block zero;; The number of blocks to transfer is the transfer count / $200;	lda <requestCount+1	sta <TransferBlocks	lda <requestCount+3	and #$00FF	; clear the high byte	lsr a	sta <TransferBlocks+2	ror <TransferBlocks	; that's tc / $200	rts************************************************************************ FixDP undoes what MakeOurDP did, and copies the parameters back* to GS/OS direct page.** Inputs: none** Outputs: none***********************************************************************FixDP;; Now we get to copy our stuff to the GS/OS DP without admitting we know; it's at $BD00...;	ldy GSOSDP	; y contains destination	tyx	lda >bufferPtr,x	;*** 4-Mar-93 SS	sta <bufferPtr	;*** restore caller's buffer ptr after using it	lda >bufferPtr+2,x	sta <bufferPtr+2	tdc	tax	; x contains source	lda #dibPointer+3	; one less than count	phb	mvn $00,$00	; here's the move	plb	ply	; the RTS address	tsc	clc	adc #DPSize	tcs	; fixed the stack	lda GSOSDP	tcd	; fixed the direct page	phy	rts	; and this one's done******************************************************************************** Here's our driver's DIB and supporting data.*******************************************************************************OurDIBLinkPtr	dc.l 0	; only one deviceEntryPtr	dc.l RAMDiskCode	; our entry pointDevChars	dc.w %1000101111101000 ; our characteristics:;; For those playing along at home: RAM disk, restartable, not speed-dependent,; block device, allows reading, writing and formatting, no removable media;BlockCount	dc.l 0	; we have to fill this in laterDevName	str 'RAMDISK'	; our device nameDevFiller	dc.b '                        ' ; spaces for fillerSlotNum	dc.w 5	; only in internal SmartPortUnitNum	dc.w 0	; fill this in at startupVersion	dc.w TheVersionDeviceID	dc.w $000E	; RAM diskheadLink	dc.w 0	; no head linkfwdLink	dc.w 0	; no forward linkExtDIBPtr	dc.l 0	; no extended DIBDIBDevNum	dc.w 0	; filled in by the device dispatcher;; These things aren't in the DIB but are in this segment;ZeroWord	dc.w 0	; word of zeroAreWeHere	dc.w 0	; incremented on startupROMVersion	ds.b 2	; for our ROM versionMaxHandles	ds.b 2	; number of handles for ROM 01GSOSDP	ds.b 2	; stored GS/OS direct pageOurError	ds.b 2	; saved error code to returnBytesToDo	ds.b 4	; running count of bytes remaining to r/w;; These are needed for ROM1 support;ChunkNum	ds.b 2	; which 16k handle we are inChunkOffset	ds.b 2	; offset into the 16k handleChunkSize	ds.b 2	; # bytes to read/write in this chunk	dc.b 'by Matt, Dave, Steve, & Jim'	DateTimeStamp		EndP	END