		msb	off		string	asis		print	sym		print	nopage		print	nomdir;--------------------------------------------------------------------------------------;;				.AFPBOOT Driver;;				Copyright (c) 1988;				Apple Computer, Inc.;				All rights reserved.;;--------------------------------------------------------------------------------------;; All drivers go in the */SYSTEM/DRIVERS/ sub-directory.  This driver MUST have the; following attributes set correctly.;;	File		File type	Aux type;;	BOOT.DRIVER	$00 BB		$0000 0181;;--------------------------------------------------------------------------------------;; Here is a list of the files that are needed to build the ATALK driver file...;;	equates			This is a general GS/OS equate file.;	others.aii		This file contains the AFP boot driver code.;;--------------------------------------------------------------------------------------;; Change History:;; 0.01a01	03/27/88	TGH	-First attempt; 0.02		12/08/88	MSD	Allows more than one volume to be;					mounted at boot (ListSessions buffer;					is now 512 bytes).;		06/08/89	MSD	Fixed check for AppleTalk active on ROM 01.;					It now checks the slot 7 internal/external;					setting.  It used to check the printer;					port device connected (printer/modem) setting,;					but I don't know why.;		22-Aug-92	MSD	The slot number is now obtained from the;					ATSlotNumber byte at $E101C1.  Fizzy will make;					sure this is right, even with EtherTalk or;					ROM 01 LocalTalk.;;		14-Dec-92	DAL	Adds 8 to slot number if it's set to external,;					before stuffing it into the boot DIB.;					Removed dead storage word and simplified the;					function dispatch code.;;--------------------------------------------------------------------------------------version		equ	$0000			;Version is ALWAYS zero!RamDispatch	equ	$E11014ATSlotNumber	equ	$E101C1			; Firmware's slot #sltromsel	equ	$C02D		print	off		include	'm16.util'		include	'equates'		print	on		eject		entry	entryvolsheader		proc		entry	pfi_data		entry	status_worddibv1		dc.l	0			;Link pointer to next DIB (=0 MSD)		dc.l	entryvols		;Entry pointer		dc.w	$07E4			;Characteristics		dc.l	$007FFFFF		;Block count		str	'AFPBOOT'		;Device name with length		dcb.b	24,$20dibslot		dc.w	0			;Slot number		dc.w	1			;Unit number		dc.w	version			;Version number		dc.w	$001E			;ID # (AFP generic)		dc.w	0			;No header link		dc.w	0			;No forward link		dc.w	0			;Reserved		dc.w	0			;Reserved		dc.w	0			;Device number		dc.w	0			;Block device #0pfi_data	dc.w	0			;Session reference number		dcb.b	28,0			;Volume name		dc.w	0			;Volume IDstatus_word	dc.w	0			;Device status word		dcb.b	32,0			;Server Name		dcb.b	33,0			;Zone Name		endp;--------------------------------------------------------------------------------------		eject		ENTRY	startup,\			badreq,\			read,\			status,\			control,\			shutdown	:CODE		ENTRY	VUnMountVol	:CODE		eject;--------------------------------------------------------------------------------------;; Following is the dispatch table used for to call the supported call numbers.;;--------------------------------------------------------------------------------------*** These are now plain addresses, not addr-1 (14-Dec-92 DAL)disp_table	proc		dc.w	startup			;startup		dc.w	badreq			;open		dc.w	read			;read		dc.w	badreq			;write		dc.w	badreq			;close		dc.w	status			;status		dc.w	control			;control		dc.w	badreq			;flush		dc.w	shutdown		;shutdown		endp		eject;--------------------------------------------------------------------------------------;; Main entry point for the .AFP driver.;;--------------------------------------------------------------------------------------entryvols	proc		longa	on		longi	on		phb			;Save the GS/OS bank register		phk		plb		pha		lda	FirstCallFlag		bne	@L1		jsr	InitMe		dec	FirstCallFlag@L1		pla		cmp	#0009		;Max command number		bge	illegal_req	;Oops, too big.*** simplified 14-Dec-92 DAL		asl	a		tax		jsr	(disp_table,x)*** end 14-Dec-92 DAL		tay			;Save the returned error code		plb		bcs	gen_exit	;Branch if there is an error		ldy	#no_errorgen_exit	tya		rtlillegal_req	plb		lda	#drvr_bad_req		sec		rtlFirstCallFlag	dc.w	0000InitMe;; 22-Aug-92 MSD	This code commented out.  We now assume that Fizzy has set up;		the correct slot number (of the firmware) at $E1/01C1.  We will;		use this value to set the slot number in the DIB.  This was done;		because peeking at LocalTalk's BRAM settings doesn't do any good;		if we booted over EtherTalk....;;;		pea	0000			;Space for result;		pea	0000			;Space for result;		pea	0000			;Space for result;		pea	0000			;Space for result;		pea	0000			;A on entry;		pea	0000			;X on entry;		pea	0000			;Y on entry;		pea	$FE1F			;Emulation mode entry point;		ldx	#$2403			;Firmware ID routine;		jsl	>$E10000;		pla				;Y on exit;		plx				;X on exit;		plx				;A on exit;		plx				;Status byte;					;At this point, A (Y on exit) holds the;					;ROM version number.;		and	#$007F			;Strip off prototype bit (high bit);;		cmp	#0002			;There really isn't a ROM 2;		bcs	ROM2			;but that's OK.;;ROM0orROM1	pea	$0000			;Space for result;		pea	$0027			;MSD: Slot 7 internal/external;		ldx	#$0C03;		jsl	>$E10000;		ldy	#0007			;Assume Slot 7;		pla				;Pull the data;		cmp	#0000			;MSD: Internal (Built-in AppleTalk)?;		beq	DoneROMCheck		;MSD: Yes, then AppleTalk in slot 7;		brl	BadExit;;ROM2		pea	$0000			;Space for result;		pea	$0021			;Slot 1 setting;		ldx	#$0C03;		jsl	>$E10000;		ldy	#0001			;Assume Slot 1;		pla				;Pull the data;		cmp	#0002;		beq	DoneROMCheck;;		pea	$0000			;Space for result;		pea	$0022			;Slot 2 setting;		ldx	#$0C03;		jsl	>$E10000;		ldy	#0002;		pla				;Pull the data;		cmp	#0002;		bne	BadExit;;DoneROMCheck	tya				;Move slot # to A.		lda	>ATSlotNumber		; get slot of firmware		and	#$00FF			; only a byte		beq	BadExit			; can't be zero!;; End of 22-Aug MSD change.;*** added 14-Dec-92 DAL -- If slot A is external, add 8FixSlotNumber	pha		and	#7		tax		lda	>sltromsel	; get slot rom selectionslot_check	ror	a		dex		bpl	slot_check		pla		bcc	@int_slot		ora	#$0008		; slots 8-15 are external@int_slot*** end 14-Dec-92		ldy	#slot_num		sta	[drvr_dib_ptr],y	; save as slot number of device		ldx	#ListSessions		;Get the list of volumes that		ldy	#^ListSessions		;are already mounted.		jsl	>RamDispatch		bcs	BadExit		ldx	#0			; start at beginning of buffer@loop		lda	NumVols			; any volumes mounted?		beq	BadExit			; if not, there is an error		lda	ListBuffer,x		; get session, slot/drive		and	#$0100			; is user volume bit set?		bne	@copy			; yes, so copy info to DIB				clc		txa				; buffer index to A		adc	#32			; point to next entry		tax				; and back in X		dec	NumVols			; one less volume left		bra	@loop			; try the next one@copy		ldy	#afpn_session		; start of ListSession data in DIB@L1		lda	ListBuffer,x		sta	[drvr_dib_ptr],y		inx		inx				; index to next word in buffer		iny		iny				; index to next word in DIB		cpy	#afpn_session+32	; done it all yet?		bne	@L1			; nope, so copy next word		ldy	#afpn_status		lda	#$8011			; online, disk switched		sta	[drvr_dib_ptr],y		ldx	#SetPFIVecs		;Tell PFI to jump to me when		ldy	#^SetPFIVecs		;anything important happens.		jsl	>RamDispatch		lda	#0000		clc		rtsBadExit		lda	#$FFFF		sec		rtsListSessions	dc.b	00			;Synchronous		dc.b	$2F			;FIListSessions		dc.w	0			;Result		dc.w	512			;Buffer length		dc.l	ListBuffer		;Buffer pointerNumVols		dc.b	00			;Entries returned		dc.b	00			;dummy zero for long compareListBuffer	ds.b	512			;List bufferSetPFIVecs	dc.b	00			;Synchronous		dc.b	$37			;FISetVectors		dc.w	0			;Result code		dc.b	$40			;00 = GS/OS active		dc.l	0			;Mount Vol Vector		dc.l	VUnMountVol		;UnMount Vol Vector		dc.l	0			;Attention Vector		dc.l	0			;Reserved		dc.l	0			;Reserved		endp;--------------------------------------------------------------------------------------;; Below is the startup routine that will prepare this driver.;;--------------------------------------------------------------------------------------startup		proc		longa	on		longi	on		lda	#0000			;No error		clc		rts				;Leave		endp		eject;--------------------------------------------------------------------------------------;; Below is the routine that is called for all un-supported calls.;;--------------------------------------------------------------------------------------badreq		proc		longa	on		longi	on		lda	#drvr_bad_req		sec		rts		endp;--------------------------------------------------------------------------------------;; Below is the routine that is called for all read calls.;;--------------------------------------------------------------------------------------read		proc		longa	on		longi	on		ldy	#afpn_status		lda	[<drvr_dib_ptr],y		bit	#$0001			;offline or disk switched?		beq	read1			; no		and	#$FFFE		sta	[<drvr_dib_ptr],y		lda	#drvr_disk_sw		sec		rtsread1		and	#$0010			;=zero if drive offline		bne	readit		lda	#drvr_off_line		;Disk off line		sec		rtsreadit		lda	<drvr_req_cnt		;If the request count = 0 then		ora	<drvr_req_cnt+2		;we're already done.		beq	GoodExit		lda	<drvr_req_cnt+2		;Check the request count		cmp	#$0080			;If > $007FFFFF, too much.		blt	@L1		lda	#drvr_bad_count		;They asked for too much		sec				;Flag error and leave.		rts@L1		lda	#network_error		sec		rts; The code below transfers a block of zeros into the destination buffer.  This; routine was taken out in favor of the above error condition;;		sta	<drvr_tran_cnt+2	;Set the transfer count =;		lda	<drvr_req_cnt;		sta	<drvr_tran_cnt		;to the request count.;;		pea	SourceBuffer>>16	;Source buffer;		pea	SourceBuffer;		pei	drvr_buf_ptr+2		;Destination buffer;		pei	drvr_buf_ptr;		pei	drvr_req_cnt+2		;Request count;		pei	drvr_req_cnt;		pea	$0804;		jsl	>$01FC70		;MOVE_INFOGoodExit	lda	#no_error		clc		rts;;;SourceBuffer	dc.w	0000			;removed 14-Dec-92 DAL		endp;--------------------------------------------------------------------------------------;; Below is the status call handler.;;--------------------------------------------------------------------------------------status		proc		longa	on		longi	on		lda	<drvr_stat_code		;Check to see if valid call.		beq	S_Status		;If = 0 then status.		cmp	#0001		beq	S_RetCData		;If = 1 then return config data.		lda	#drvr_bad_code		;Else, error.		sec		rtsS_Status	ldx	<drvr_req_cnt+2		;High word		bne	bad_dev_stat		ldx	<drvr_req_cnt		;Low word		beq	dev_stat_exit		cpx	#0007		blt	ok_dev_statbad_dev_stat	lda	#drvr_bad_parm		;Invalid request count		sec		rtsok_dev_stat	ldy	#afpn_status		sec		lda	<drvr_slist_ptr		sbc	#afpn_status		sta	<drvr_slist_ptr		lda	<drvr_slist_ptr+2		sbc	#0000		sta	<drvr_slist_ptr+2		sep	#$20		longa	off		lda	[<drvr_dib_ptr],y		sta	[<drvr_slist_ptr],y		dex		beq	doneit		iny		lda	[<drvr_dib_ptr],y		sta	[<drvr_slist_ptr],y		dex		beq	doneit		ldy	#afpn_status+2		ldx	#0002@L1		lda	blockcount-2,x		sta	[<drvr_slist_ptr],y		inx		iny		cpx	<drvr_req_cnt		bne	@L1doneit		rep	#$20		longa	on;; Now that we're done returning the device status (and block count), we have to; check for OFFLINE or DISKSW state.  If either of these conditions exist then the; driver must call SET_DISKSW via the system service call table.;		ldy	#afpn_status		lda	[<drvr_dib_ptr],y		eor	#$0010			;convert online to offline		and	#$0011			;offline or disk switched?		beq	good_state		; no		ldy	#afpn_status		lda	[<drvr_dib_ptr],y		and	#$FFFE		sta	[<drvr_dib_ptr],y		jsl	set_diskswgood_state	lda	<drvr_req_cnt		;Set the transfer count equal		sta	<drvr_tran_cnt		;to the request count.		lda	<drvr_req_cnt+2		sta	<drvr_tran_cnt+2dev_stat_exit	lda	#no_error		clc		rtsblockcount	dc.l	$0007FFFFS_RetCData	ldx	<drvr_req_cnt+2		;High word		bne	bad_CData		;Branch if != 0		ldx	<drvr_req_cnt		;Low word		beq	RetCData_exit		;If = 0 then just leave (no error)		cpx	#specific_size+3	;Check againts max.		blt	ok_devdatabad_CData	lda	#drvr_bad_parm		;Invalid request count		sec		rtsok_devdata	ldx	#0002		ldy	#dib_specific		sep	#$20		longa	off@L1		lda	[drvr_dib_ptr],y		phy		txy		sta	[<drvr_slist_ptr],y		ply		iny		inx		cpx	<drvr_req_cnt		bne	@L1		rep	#$20		longa	on		lda	<drvr_req_cnt		;Set the transfer count equal		sta	<drvr_tran_cnt		;to the request count.		dea		dea				; transfer := request - 2		sta	[drvr_slist_ptr]	; return transfer count		lda	<drvr_req_cnt+2		sta	<drvr_tran_cnt+2RetCData_exit	lda	#no_error		clc		rts		endp;--------------------------------------------------------------------------------------;; Below is the control call handler.;;--------------------------------------------------------------------------------------control		procwork1		equ	00		longa	on		longi	on		lda	<drvr_ctrl_code		;Check to see if valid call.		cmp	#0000		beq	C_Reset		lda	#drvr_bad_code		sec		rtsC_Reset		lda	#no_error		clc		rts		endp;--------------------------------------------------------------------------------------;; Below is the shutdown call handler.;;--------------------------------------------------------------------------------------shutdown	proc		longa	on		longi	on		lda	#$0000		clc		rts		endp;--------------------------------------------------------------------------------------;; VUnMountVol;; This routine is called by PFI when a volume has gone off line.  It will first; scan all the AFP DIBs.  If the DIB was found it will mark the drive as off-line.; If the DIB was NOT found, the unmount event will be ignored.;; On Entry (via JSL):;;	A Reg = Unknown;	X Reg = Low word of parameter block pointer;	Y Reg = High word of parameter block pointer;	D Reg = PFI direct page;	B Reg = PFI data bank;	P Reg = N V M X D I Z C E;	        x x 0 0 0 x x x 0;; X and Y point to the following data structure:;;		Byte		Session reference number;		Byte		Unit #;		PString[28]	Volume name;		Word		Volume ID;; On Exit (via RTL):;;	A Reg = Unknown;	X Reg = Unknown;	Y Reg = Unknown;	D Reg = PFI direct page;	B Reg = PFI data bank;	P Reg = N V M X D I Z C E;	        x x 0 0 0 x x x 0;VUnMountVol	proc				;UnMount Vol Vector		Work1		equ	$00			;Zero page equates	(LONG)		phb		php				;     and P.		phk		plb		rep	#$30			;Longall		longa	on		longi	on		pei	<Work1			;Save PFI's zero page.		pei	<Work1+2		stx	<Work1			;Put the pointer to the data on zero		sty	<Work1+2		;page so we can access the data.		ldy	#0000ScanLoop	lda	[<Work1],y		cmp	pfi_data,y		bne	Exit		iny		cpy	#30		bne	ScanLoop		lda	#$0001			;Disk NOT in drive, Disk switched		sta	status_wordExit		pla		sta	<Work1+2		pla		sta	<Work1		plp				;Restore the state.		plb				;Restore b				rtl				;And exit.		endp;--------------------------------------------------------------------------------------		END