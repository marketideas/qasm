;======================================================================;;	EtherTalk driver for the Apple IIGS;; This code intercepts the main AppleTalk entry points on the GS and; calls the Apple II EtherTalk Card to perform the actual call.;; The supported entry points are:; $E11014	RamDispatch	Pointer to PB in X, Y; $E11018	RamForbid	Prevents AppleTalk completion;				routines, etc. being called.; $E1101C	RamPermit	Allows AppleTalk interrupts.;; Not supported (yet):; $E1100C	RamGoComp	Used for calling completion;				routines in any bank.;;; This code also handles the necessary initialization to use the card; with GS/OS, and does whatever is appropriate to when switching; between GS/OS and ProDOS 8.;; RamDispatch is not intercepted directly.  Instead, the entry points; (in the CmdTable at $E1D600) point to a common routine that calls; the card.;;  2-Apr-92 MSD	Reorganized the code, especially where it deals with;		interrupt handlers and switching OS's.  For network;		booting, we directly patch the IRQ.OTHER vector; under;		normal booting, we install/remove interrupt handlers;		through the currently running OS.;; 21-Apr-92 MSD	Finished removing the desk accessory-related code.;		The DA is now a stand-alone item.  When network booting,;		it now does a partial Init.;;  4-Jun-92 MSD	I can't do an AddNotifyProc call at boot time on a ROM;		01 GS because it uses a toolbox call not in ROM and;		TOOL.SETUP hasn't been loaded yet.  We modified the;		definition of os_p8_switch so it gets called when either;		P8 or GS/OS is about to shut down.  We can tell which;		by looking in the A register.;;  5-Aug-92 MSD	Implemented functionality of RamGoComp vector.  Since it;		switches into emulation mode, it had used the $Cnxx space;		which may not be available.;; 19-Aug-92 MSD	Removed extra PHB from RamGoComp.  It was causing stack to;		be unbalanced when completion routine was not in bank 0.;;  2-Sep-92 DAL Changed the codes for Forbid and Permit to be $8000 and;		$4000 like DoRight expects.;;  5-Sep-92 DAL	Changed the code for Forbid to $FFFF for DoRight 2.0b1C.3.;; 18-Sep-92 DAL	Sets the card-died vector and tries to give them a nicer;		message.  Initializes *all* the command addresses in;		CmdTable, so we are no longer pre-filtering what a valid;		command is.;; 13-Oct-92 DAL	On fatal error, show card version and time of death.;               Remove timeout.  Add delay & keyboard-clear before letting;               user dismiss the death message.;; 16-Oct-92 DAL On fatal error, check for black text+background colors.;		If it's all black, make the text color white.;; 21-Oct-92 DAL	On fatal error, hitting Esc tries to put you into the;		EtherTalk CDA (using SendRequest to Apple~EtherTalkCDA~;		with reqCode $8000).;; 14-Dec-92 DAL	Added and AND #$0007 because the slot number we get in;		Y from the SCC Manager will be 9..15, not 1..7.  Stores;		slot number into $E101C2 (RPM slot number, as defined for;		ROM 3 and later by AppleTalk Technical Note #4, Printing;		Through the Firmware).;;		Disables interrupts in DoPatchIRQ (low-probability of;		causing a problem, but fixed it anyway).;;		For net booting only ("Handler"), restores MSLOT from;		irq_MSLOT and re-activates the correct expansion ROM,;		because the ROM does not do this for us, and in the;		net-boot case the BindInt handling code can't do it for;		us either (as of 6.0.1d12, BindInt takes care of it for;		the local-boot case, though).;; 9-Mar-93 DAL	¥Added a call that makes the Ethernet card install the;		Network Preferences CDA (see InstallNetPrefs).;		¥Added code in os_p8_switch to shut down the card on an;		OSShutDown (SCM now calls os_p8_switch with A=$8000 on;		a shutdown).;; 17..18-Mar-93 DAL;		¥Added a version of the os_p8_switch stuff that works for;		a network boot, so we can shut down the card on OSShutDown;		when the system is net booted.;		¥If the "Programmer CDAs" bit is set in Battery RAM, now;		we pass an "e" as the "power up key" to the InstallCDAs;		command, so the Ethernet card will install Ethernet CDA;		as well as Network Preferences.;; 25-Mar-93 DAL	¥In the CardDied handler, if we're in ProDOS 8 we restore;		the $BF00 jump to $BF4B, so the user has some chance of;		saving their work to local disks.;; 25-Mar-93 DAL	¥Set the high bit on the 'e' that I pass to install the;		programmer CDAs.;;======================================================================		include 'all.macros'cmdlist		equ	$80		; pointer to parameter blockexecaddr	equ	$84		; pointer to code entryMSLOT		equ	$0007F8RamGoComp	equ	$E1100CRamDispatch	equ	$E11014RamForbid	equ	$E11018RamPermit	equ	$E1101CCmdTable	equ	$E1D600StateReg	equ	$E1C068LCBank2		equ	$E1C083OnExitVector	equ	$E1104A		; 1/4 second exit vectoros_switch	equ	$E100AC		; called on switch of OS'sos_kind		equ	$E100BC		; 0=> P8, 1=> GS/OS, $FF => in-betweenos_p8_switch	equ	$E100B4		; called just before shutting and operating system					; A = 0 on entry if shutting down P8 to go to GS/OS					; A = 1 on entry if shutting down GS/OS to go to P8					; A = $8000 if shutting down GS/OS thru OSShutDownIRQ_Other	equ	$E1005C		; vector for external interrupts;----------------------------------------------------------------------;		Patch;; This routine is executed after the file is loaded.  It does the actual; patching and initialization necessary to use the card in a GS/OS; environment.;; On entry:;	A = Channel number (0 since it doesn't use a serial port);	X = GS ROM version;	Y = Slot #;;----------------------------------------------------------------------Patch		proc		import	CardJump,slotX10,CN00Val,CnProDOS		import	Forbid,Permit,CommonDispatch,GoComp		import	OurSwitch,OurChain		import	OurP8Switch,OurP8Chain		import	CnIntEntry		import	DoBindInt,NotifyPB,DoPatchIRQ		import	SetNaming,SetupCardDied,InstallNetPrefs		phb		phk		plb;; Reset AppleTalk's vectors to point back at ROM so we can patch; over only the ones we want changed.;		phy			; save our slot number				cpx	#1		; was it ROM 1?		bne	rom3		; no, so assume ROM 3				jsl	$FF1C06		; ROM 1 vector reset		bra	continuerom3		jsl	$FDE594		; ROM 3 vector resetcontinue;; Fix up the JML to the card and the slot * $10 value;		pla			; get slot in A*** added 14-Dec-92 DAL		and	#$0007		;strip off the external-slot bit (9 becomes 1, etc)		sep	#$20		sta	>$E101C2	;RPMSlotNumber		rep	#$20*** end 14-Dec-92		xba			; A = $0n00		ora	#$C000		; A = $Cn00		sta	CN00Val		; save for ToCard		ora	#$0014		; A = $Cn14		sta	CnProDOS	; save ProDOS entry point		ora	#$001E		; A = $Cn1E		sta	CardJump+1	; fix up JML address		eor	#$0007		; A = $Cn19		sta	CnIntEntry				lsr	a		lsr	a		lsr	a		lsr	a		; A = $0Cn1		and	#$00F0		; A = $00n0		sta	slotX10;; Patch the RamForbid and RamPermit vectors;		lda	ToForbid		sta	RamForbid		lda	ToForbid+2		sta	RamForbid+2				lda	ToPermit		sta	RamPermit		lda	ToPermit+2		sta	RamPermit+2;; 5-Aug-92 MSD: Patch the RamGoComp vector.;		lda	ToGoComp		sta	RamGoComp		lda	ToGoComp+2		sta	RamGoComp+2;; Patch the entries in CmdTable to point to CommonDispatch.;; The upper byte of the table entry is the number of zero page bytes; to save.  I leave it at zero since the card does its own save/restore.;		sep	#$20		lda	>StateReg		pha			; save LC bank		lda	>LCBank2		lda	>LCBank2	; allow write to language card		rep	#$20		;;;		ldx	#$4F*4		; do up to command $4F		ldx	#$ff*4		; do all the commands!  18-Sep-92 DALloop		lda	#<CommonDispatch		sta	>CmdTable,x		lda	#^CommonDispatch		sta	>CmdTable+2,x		dex		dex		dex		dex		bpl	loop		; down through command $00				sep	#$20		pla		sta	>StateReg	; restore LC bank		rep	#$20;; Install ourselves in the OS switch vector so we can patch P8, change naming; modes, reset the PFI hooks, etc.;		lda	>os_switch	; copy previous OS Switch vector contents		sta	OurChain		lda	>os_switch+2		sta	OurChain+2		lda	ToSwitch	; copy in a JML to our code		sta	>os_switch		lda	ToSwitch+2		sta	>os_switch+2*** this os_p8_switch stuff was under the ELSE below until just now (17-Mar-93 DAL);; Install ourselves in the os_p8_switch vector to get called before switching; from ProDOS 8 to GS/OS, or before switching from GS/OS to ProDOS 8.;		lda	>os_p8_switch	; save previous contents		sta	OurP8Chain		lda	>os_p8_switch+2		sta	OurP8Chain+2		lda	ToP8Switch	; install a JML to our code		sta	>os_p8_switch		lda	ToP8Switch+2		sta	>os_p8_switch+2;; Install interrupt handler.  Because we're loading during net booting, we patch; IRQ.OTHER before GS/OS does.  Therefore GS/OS won't remove us, and we can stay; patched in without regard to switching of OS's.;		IF NetBoot THEN		jsr	DoPatchIRQ	; patch the IRQ.OTHER vector		ELSE;; Install a GS/OS interrupt handler;		jsr	DoBindInt	; bind an interrupt handler into GS/OS				ENDIF;; Init the card;		ldx	#<init		ldy	#^init		jsl	RamDispatch;; Set up naming mode for GS/OS;		lda	#$C0C0		; long naming, disable device table updates		jsr	SetNaming;; Set up the card-died vector to give them a nice message;		jsr	SetupCardDied;; Install the "Network Preferences" CDA;		jsr InstallNetPrefs		plb		rtlToGoComp	jml	GoComp		; call a completion routine "the right way"ToForbid	jml	ForbidToPermit	jml	PermitToSwitch	jml	OurSwitch;;;		IF not NetBoot THENToP8Switch	jml	OurP8Switch;;;		ENDIFinit		dc.b	0,1		; sync Init		dc.w	0		IF NetBoot THEN		dc.b	$00		; partial init, no MLI global page update		ELSE		dc.b	$80		; full init, no MLI global page update		ENDIF			; if NetBoot		dc.l	0		; no ProDOS entry point		dc.b	0		; pick any node		dc.w	0		; reserved				endpForbidCount	dc.w	0slotX10		dc.w	0CN00Val		record	export		dc.w	0		endrCnProDOS	dc.w	0CnIntEntry	dc.w	0;----------------------------------------------------------------------;		ToCard;; This routine sets the index registers to 8-bit mode, sets B=0,; puts slot*16 in X, and does a JML to the card's GS entry point.;;----------------------------------------------------------------------ToCard		proc		import	slotX10,CardDiedFlag		export	CardJump		ldx	CardDiedFlag		bne	CardIsDead				pha			; save command number		sep	#$20		; short A for MSLOT stuff		longa	off		lda	CN00Val+1		sta	>MSLOT		rep	#$20		longa	on				pla			; get command number back				ldx	slotX10		ldy	CN00Val				pea	0		plb		plb			; set bank to 0CardJump	jml	0		; patched at startup		export CardDiedFlagCardDiedFlag	dc.w	0;; CardIsDead;; Ignore Forbid and Permit calls.;; For real calls, return error $0101.;CardIsDead	tax		bne	@doNothing		lda	#$0101		;"invalid command"		ldy	#2		sta	[<cmdlist],y	;store error code@doNothing	pea 0		plb		plb		rtl		endp		;----------------------------------------------------------------------;		CommonDispatch;; This is the common routine that causes calls to be handled by the card.; The address of this routine is placed in the command table for each; call to be passed to the card.;; On entry,;	cmdlist points to the parameter block;;----------------------------------------------------------------------CommonDispatch	proc				phk		plb				pei	cmdlist+2	; push pointer to PB		pei	cmdlist		lda	#0		; tell card it's a call				jsl	ToCard		; call the card		rep	#$30		; force long registers				pla			; strip PB pointer off stack		pla				rtl			; return to dispatcher				endp;----------------------------------------------------------------------;		Forbid;; This routine intercepts the RamForbid vector.  It maintains its own; counting semaphore and calls the card's forbid routine as necessary.;----------------------------------------------------------------------Forbid		proc		pha			; save registers		phx		phy		php			; save M,X bits		phb				phk		plb				rep	#$30		; force long A,X,Y		lda	ForbidCount	; is card forbidden already?		bne	forbidden	; yes, so don't bother again				lda	#$FFFF		; tell card to do RamForbid (was $0080 2-Sep-92)		jsl	ToCard		forbidden		lda	>ForbidCount		ina		sta	>ForbidCount				plb		plp		ply		plx		pla				rtl		endp;----------------------------------------------------------------------;		Permit;; This routine intercepts the RamPermit vector.  It maintains its own; counting semaphore and calls the card's permit routine as necessary.;----------------------------------------------------------------------Permit		proc		pha		phx		phy		php		phb				phk		plb				rep	#$30		dec	ForbidCount	; still forbidden?		bne	forbidden	; yes, don't permit		lda	#$4000		; tell card to do RamPermit (was $0040, 2-Sep-92 DAL)		jsl	ToCardforbidden		plb		plp		ply		plx		pla				rtl				endp;----------------------------------------------------------------------;			GoComp;; This implements the RamGoComp vector which allows user's code to call; a completion routine using the same conventions as AppleTalk does.;; On entry:;	(Note: It is assumed that direct page is already $0000);	$84..$87 on direct page point to the routine to call.;	$80..$83 is usually pointer to PB whose completion routine is;		 being called (so caller can have one routine for many;		 parameter blocks).;	Native mode.;	Called via JSL;; State on entry to called routine:;	If outside bank 0, called in full native mode with data bank;	set to routine's code bank.;;	If routine in bank 0, called in emulation mode.;; This routine preserves it caller's data bank register.  A,X,Y are; undefined at exit.  Always exits in full native mode.;; NOTE: In the LocalTalk code, if a completion routine ended with an; RTL instead of doing a JMP to the completion routine return address,; it still worked.  And, since DoRight's completion routine return is; just an RTL, we have to handle that situation.  Unfortunately, this; means we can't use the toolbox's FWEntry routine (since it expects; to return via an RTS).;; Another complication is that we can't switch to emulation mode until; we're executing in bank 0 (because an interrupt could come along,; and emulation mode interrupts don't get their bank saved).  Therefore,; the switch to and from emulation mode has to be done with code in; bank 0 (i.e. on the stack!).;; Here's what the stack looks like:;;		|	...		|;		|-----------------------|; Part1:	|	sec		|;		|	xce		|;		|	jmp ($0084)	|; Part2:	|	clc		|;		|	xce		|;		|	rtl		|;		|-----------------------|;		|	Return		|;		|	Address		|;		|	to Driver	|;		|-----------------------|;		|	Return		|;		|	Address		|;		|	to Part2	|;		|-----------------------|;		|	Return		|;		|	Address		|;		|	to Part1	|;		|-----------------------|;; We set the registers up, then do an RTL to cause execution to continue; with Part1.  When the completion routine is finished, it RTL's back to; Part2, which goes into native mode and RTL's back to the driver.  Once; in the driver, we go to full native mode and pop the junk off the stack.;----------------------------------------------------------------------GoComp		procCompAddr	equ	$84		; address on direct page containing					; pointer to routine to be called;; Save caller's bank byte;		phb				phk		plb		rep	#$30				lda	CompAddr+2	; is bank non-zero?		beq	emulation	; nope, so call it the hard way		lda	CompAddr+1		pha		plb			; pull page byte		plb			; code's bank byte now in B				jsl	TheJML		; do JSL indirect		rep	#$30		; force full native again				plb			; fix old bank				rtl			; return to RamGoComp's calleremulation		;; Set up Part1 and Part2 code on the stack.;		lda	StackCode+6		pha		lda	StackCode+4		pha		lda	StackCode+2		pha		lda	StackCode		pha;; Put a return address to our driver on the stack;		jsl	CallBank0;; Remove the code from the stack;		rep	#$30		pla			; remove 8 bytes of junk		pla		pla		pla		plb			; restore original caller's bank byte		rtl			; return to RamGoComp's caller;; At this point, there is a return address to the driver at 1,s.  The Part1; code is at 4,s.  Part2 is at 9,s.  We need to construct return addresses; to Part2 and Part1 and push them (in that order).  The two values are; S+8 and S+3 (for the current value of S=stack pointer).;CallBank0		pea	$0000		plb		plb			; set B to zero				tsc		clc		adc	#8				phb		pha			; push RTL to Part 2				sec		sbc	#5				phb		pha			; push RTL to Part 1				rtl			; "return" to Part 1StackCode				; size = 8 bytes		sec		xceTheJML		jml	[CompAddr]		clc		xce		rtl				endp		;----------------------------------------------------------------------;			SetNaming;; On entry, A = direction flag (low), naming flag (high);;----------------------------------------------------------------------SetNaming	proc		sta	FINaming+4	; save direction, naming flags				ldx	#<FINaming		ldy	#^FINaming		jsl	$E11014				rtsFINaming		dc.b	$00,$33		; sync FINaming		dc.w	0		; result		dc.b	0,0		; direction, naming flags				endp*** added 9-Mar-93 DAL;----------------------------------------------------------------------; InstallNetPrefs;----------------------------------------------------------------------InstallNetPrefs	proc*** added 18-Mar-93 DAL -- Read programmer CDAs setting from Battery RAM		pha		pea $0059		; Programmer CDAs location		ldx #$0c03		jsl $e10000;		_ReadBParam		pla		and #$0080		beq @storeKey		lda #$0065+$80	;'e' with high bit set@storeKey	sta progCDAflag*** end 18-Mar-93		ldx	#<InstallThemCDAs		ldy	#^InstallThemCDAs		jsl	RamDispatch		rtsInstallThemCDAs	dc.b	$00,$6F		; sync Control_Cmd		dc.w	$0000		; result		dc.w	$0001		; command 1 = install CDAs (2=shutdown)progCDAflag	dc.l	0		; more info (reserved)		EndP*** end 9-Mar-93;----------------------------------------------------------------------;			SetupCardDied;----------------------------------------------------------------------SetupCardDied	proc		ldx	#<SetupDeath		ldy	#^SetupDeath		jsl	RamDispatch		rtsSetupDeath	dc.b	$00,$72		; Q&D debug vectors		dc.w	0		; result		dc.l	CardDied	; exception handler		dc.l	0		; GSOSmsgHandler		dc.l	0		; reserved (use 0);Notes from Wes's QuickMail on GSOSmsgHandler:;;word Async & cmd - $0072;word results;long   ExceptionHandler;long   GSOSmsgHandler;long   reserved;-------;Handlers called via jsl;;GSOSmsgHandler will be called w/ A,X,Y;  A = msg type;  X = Address Lo;  Y = Address Hi;------;  A     = 0x0000 = A router is available;  X+Y = ptr to zone name str32;-------;  A     = 0x0001 = Node was put into the default zone;  X+Y = ptr to zone name str32;-------;  A    = 0xFFFF   = Print String255;  X+Y = ptr to str255;=====;Buffmove (used to fetch the message strings above);word Async & cmd - $0070;word results;long   SrcBuf;long   DstBuf;word   count;; CardDied;; Input:;   8-bit native mode, called with JSL;   Bank and direct page are zero;   $00/00FB = pointer to $Cn00;; Card2MBPB (in Cn00):;   +0 = P register;   +1 = PC (3 bytes);   +4 = break value;   ;CardDied		import CardDiedFlag,FWEntryCard2MBPB	equ $AEMB_ZP		equ $FB		rep #$30		lda #$ffff		sta >CardDiedFlag*** added 25-Mar-93 DAL -- If we're in ProDOS 8, restore the $BF00 jump so the user***   has some chance of saving their work on local disks.		lda >OS_KIND		;$00 = P8		and #$00ff		bne @not_ProDOS8		lda #$BF4B		sta >$00BF01@not_ProDOS8*** end 25-Mar-93		ldy #Card2MBPB+0	;get P register		jsr GetHexValue		;returns A = high word		sta >Button2+2		ldy #Card2MBPB+3	;get bank register of PC		jsr GetHexValue		sta >Button2+8		ldy #Card2MBPB+1	;get low word of PC		jsr GetHexValue		sta >Button2+12		txa		sta >Button2+10		ldy #Card2MBPB+4	;get BRK value		jsr GetHexValue		sta >Button2+16		pushlong #TextLine4		_ReadAsciiTime		ldy #$00F7		;version # at $CnF7		jsr GetHexValue		sta >TextLine4+30+2		txa		sta >TextLine4+30		jsr ShowPrettyMessage		rtlTextLine1	dc.b 'There is a problem on the Ethernet  'TextLineb	dc.b 'card.  Try to save your work to a   'TextLine2	dc.b 'local disk and restart the system.  'TextLine4	dc.b 'mm/dd/yy hh:mm:ss xM         vXXXX  'Button2		dc.b 'P=xx PC=xxxxxx [xx]   Press Return  'GetHexValue	lda (MB_ZP),y		pha		pha		pha		_HexIt		plx		pla		rtsShowPrettyMessage		phb		pea 0		plb		plb		pha		pha		_SaveTextState*** added 16-Oct-92 DAL -- If text+background are both black, make text white		sep #$20		longa off		lda >$00c022		bne @notBlack		lda #$f0		sta >$00c022@notBlack	rep #$20		longa on*** end 16-Oct-92		lda #$fb2f	;text mode, full window		jsr FWEntry		lda #$fc58	;clear screen		jsr FWEntry		sep #$20		sta $c00c	;40-column mode		rep #$20		lda #$2020		ldy #40-2@topAndBottom	sta $600,y	;line 6		sta $7a8,y	;line 17		dey		dey		bpl @topAndBottom		ldx #18@edges		phx		lda >LineTable,x		tax		lda #$a020		sta |0,x		lda #$20a0		sta |38,x		plx		dex		dex		bpl @edges		ldx #34@theText	lda >TextLine1,x		ora #$8080		sta $700+2,x		lda >TextLineb,x		ora #$8080		sta $780+2,x		lda >TextLine2,x		ora #$8080		sta $428+2,x		lda >TextLine4,x		ora #$8080		sta $528+2,x		lda >Button2,x		ora #$8080		sta $6a8+2,x		dex		dex		bpl @theText@notEsc		jsr GetKeypress		cmp #$0d		beq @hitReturn		cmp #$1b	;Esc for EtherTalk CDA		bne @notEsc		pea $8000	;reqCode		pea $8001	;sendToName+stopAfterOne		pushlong #theCDAName		lda #0		pha		pha		;dataIn = nil		pha		pha		;dataOut = nil		_SendRequest		bcs @notEsc@hitReturn	_RestoreTextState		plb		rtstheCDAName	str 'Apple~EtherTalkCDA~'** Addresses of lines 7 through 16 of 40-column text screen*LineTable	dc.w $680,$700,$780,$428,$4a8,$528,$5a8,$628,$6a8,$728GetKeypress;; Before allowing keypress to dismiss dialog, wait & then clear the buffer;		sep #$20		longa off		lda >$c068		pha		and #$7f		sta >$c068		ldy #5		ldx #0@wait		sta >$c010		dex		bne @wait		dey		bne @wait@getkey		lda >$c000		bpl @getkey		tax		sta >$c010		pla		sta >$c068		rep #$20		longa on		txa		and #$007f		rts		EndP;----------------------------------------------------------------------;		OurSwitch;; This routine is called by the os_switch vector after switching; operating systems or when launching GS/OS applications.;;----------------------------------------------------------------------OurSwitch	proc		import	DoBindInt,DoAllocInt		export	OurChain				phb		phk		plb				lda	>os_kind		and	#$00FF		; os_kind is only a byte		cmp	last_os_kind	; have we changed OS's?		sta	last_os_kind	; remember current OS (won't change flags)		beq	done		; haven't changed OS, don't do anything				cmp	#0		; is os_kind=0 (i.e. P8)		bne	gsos;; We just switched into ProDOS 8;		IF not NetBoot THEN		jsr	DoAllocInt	; allocate a P8 interrupt handler		jsl	Permit		; allow interrupts again		ENDIF		lda	#$00C0		; P8 naming, enable device table		jsr	SetNaming		lda	>$BF01		; get old P8 entry point		sta	hooks+$11	; save for card		lda	CnProDOS	; get card's entry point		sta	>$BF01		; as replacement for MLI		ldx	#<hooks		ldy	#^hooks		jsl	>RamDispatch	; set hooks and P8 entry point		bra	donegsos;; We just switched into GS/OS;		IF not NetBoot THEN		jsr	DoBindInt	; install a GS/OS interrupt handler		jsl	Permit		; enable interrupts		ENDIF				lda	#$C0C0		; long naming, no device table		jsr	SetNamingdone		plbOurChain	dc.l	0		; previous contents of vectorlast_os_kind	dc.w	1		; previous os_kind (GS/OS)hooks		dc.b	0,$37		; sync FIHooks		dc.w	0		dc.b	$E0		; P8 active, set hooks, set P8 entry		dc.l	0		; mount vector		dc.l	0		; unmount vector		dc.l	0		; attention vector		dc.w	0		; P8 entry point (will be modified)		endp		IF NetBoot THEN*** network bootOurP8Switch	proc		export OurP8Chain		tax		bpl	OurP8Chain		jsr	doSysShutdownOurP8Chain	dc.l	0		ELSE*** non-network boot		;----------------------------------------------------------------------;		OurP8Switch;; This routine is called by the os_p8_switch vector just before P8; gets shut down when switching from P8 to GS/OS, or before going; from GS/OS to P8.;; Input:;   A = $0000 if shutting down P8 to go to GS/OS;   A = $0001 if shutting down GS/OS to go to P8;   A = $8000 if shutting down GS/OS through OSShutDown;;----------------------------------------------------------------------OurP8Switch	proc		export	OurP8Chain		import	UnbindIntPB		tax		bmi	SystemShutdown		beq	FromP8	*** switching from GS/OS to P8FromGSOS	jsl	Forbid		;turn off net interrupts				jsl	$E100A8		dc.w	$2032		; class 1 UnbindInt		dc.l	UnbindIntPB		lda	#1		; tell others we're coming from GS/OS		bra	OurP8Chain	; go to next guy in the chain.*** switching from P8 to GS/OSFromP8		jsl	Forbid		; turn off net interrupts		lda	#0		; tell others in chain we're coming from P8OurP8Chain	dc.l	0		; JMP--previous contents of vectorsystemShutdown	jsr	doSysShutdown		bra	OurP8Chain		ENDIF** shutting down the system (OSShutDown)*doSysShutdown	pha		ldx	#<ShutDownCard		ldy	#^ShutDownCard		jsl	RamDispatch*** Wait until the Ethernet card is doing with diagnostics		lda	>CardJump+1		and	#$ff00		tax		sep #$20		longa off@wait0		lda	>$0000FD,X		cmp	#$00f0		bne	@wait0@waiting	lda	>$0000FD,X	; load $CnFD		cmp	#1		bne	@waiting		rep #$20		longa on		pla		rtsShutDownCard	dc.b	$00,$6F		; sync Control_Cmd		dc.w	$0000		; result		dc.w	$0002		; command 2 = shutdown		dc.l	0		; more info (reserved)		EndP	;----------------------------------------------------------------------;			FWEntry;; Given the address of a bank 0 routine in A, make a call to FWEntry.; Zero is passed for all registers.  On return, the processor status; and registers are set as returned by the call.  Return is always; in full native mode.;;----------------------------------------------------------------------FWEntry		proc		phb			; save bank				ldx	#0		; for pushing zeroes		phx			; push room for results		phx		phx		phx		phx			; push zero for all registers		phx		phx		pha			; push entry point				ldx	#$2403		; FWEntry too call		jsl	$E10000		; make the tool call				ply		plx		pla		plb			; high byte of P ignored (trashes bank byte)		plp			; get processor status				plb			; restore bank byte						rts				endp		;----------------------------------------------------------------------;		IntHandler;; This is the GS/OS version of the interrupt handler.  It calls the; card's ProDOS 8 interrupt handler, which returns c=0 if it handled; the interrupt.;;----------------------------------------------------------------------IntHandler	proc		longa	off		longi	off		;		bcs	exit		; if already handled, we won't handle it				rep	#$30		; long mode for tool call		longa	on		longi	on		lda	>CnIntEntry		jsr	FWEntry				sep	#$30		; return in short native mode		longa	off		longi	off		exit		rtl		longa	on		longi	on				endp		IF NetBoot THEN;----------------------------------------------------------------------;			DoPatchIRQ;; Patch the IRQ.OTHER vector to point to our routine that calls the; interrupt handler, and passes it on to the previous routine if our; handler didn't claim the interrupt.;;----------------------------------------------------------------------DoPatchIRQ	proc		php			;added 15-Dec-92 DAL		sei			;added 15-Dec-92 DAL		lda	IRQ_Other		sta	ToOther		lda	IRQ_Other+2		sta	ToOther+2				lda	ToHandler	; JML Handler		sta	IRQ_Other		lda	ToHandler+2		sta	IRQ_Other+2		plp			;added 15-Dec-92 DAL		rts; (8-bit native)Handler		jsl	IntHandler	; try servicing the interrupt*** added 15-Dec-92 DAL		php		longa	off		longi	off		lda	>$e1011b		;irq_MSLOT		sta	>$07f8			;MSLOT		rep	#$10		longi	on		xba		lda	#0			;have $Cn00 in A		tax		lda	>$cfff			;CLRROM -- turn off all expansion ROMs		lda	>0,x			;turn on just the one expansion ROM		sep	#$10		longi	off@never_mind	plp*** end 15-Dec-92		bcs	ToOther		; didn't handle, try other		rtl			; return carry clear, we handled interruptToOther		dc.l	0		; old IRQ.OTHER contents go hereToHandler	jml	Handler		longa on		longi on		endp				ELSE			; if NetBoot;----------------------------------------------------------------------;			DoBindInt;; Install our interrupt handler in GS/OS via a BindInt call.  While; we're at it, install a notification proc so we can remove our; interrupt handler.;----------------------------------------------------------------------DoBindInt	proc		jsl	$E100A8		; GS/OS inline entry		dc.w	$2031		; class 1 BindInt		dc.l	BindIntPB				lda	BindIntPB+2	; get interrupt refnum		sta	UnbindIntPB+2	; save for unbinding				rts		BindIntPB		dc.w	3		dc.w	0		; interrupt refnum		dc.w	$17		; IRQ.OTHER		dc.l	IntHandler		export	UnbindIntPBUnbindIntPB		dc.w	1		dc.w	0		; interrupt refnum				endp						;----------------------------------------------------------------------;			DoAllocInt;; Call ProDOS 8 to install an interrupt handler.;;----------------------------------------------------------------------DoAllocInt	proc		import	CnIntEntry				lda	CnIntEntry		sta	pb+2				ldx	#10		; offset of last word@loop		lda	>$0200,x		sta	Page2Save,x	; save previous contents of page 2		lda	AllocInterrupt,x		sta	>$0200,x	; copy our code to page 2		dex		dex		bpl	@loop				lda	#$0200		jsr	FWEntry		; do the call				ldx	#10@loop2		lda	Page2Save,x		sta	>$0200,x		dex		dex		bpl	@loop2				rtsAllocInterrupt		jsr	$BF00		dc.b	$40		; ALLOC_INTERRUPT		dc.w	pb-AllocInterrupt+$200		rtspb		dc.b	2		dc.b	0		; interrupt handler number		dc.w	0		; interrupt handler entry point		Page2Save	ds.b	12		endp				ENDIF			; if NetBoot						end