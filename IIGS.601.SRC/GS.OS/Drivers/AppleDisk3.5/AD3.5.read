		eject		TITLE	'      READ command'******************************************************************* DRIVER CALL:  READ** This call executes a read from the device.  Block devices must* validate the initial block number and that the request count is* an integral multiple of the block size.  In addition the block* number of each successive block must be validated as it is* accessed when an multiple block I/O transaction is in place.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*       <drvr_buf_ptr = Pointer to I/O buffer*       <drvr_blk_num = Initial block number*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_blk_size = Size of block to be accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0  if no error*                       x x 0 0 0 0 x 1  0  if error******************************************************************		export	read		read		proc		import	Direct_Read	;import the entry pointDNIBTAB		EQU	$01BC00		;addres of page with dnibtab		longa	on		longi	on		jsr	check_access	; did direct access occur?		bcs	read_exit	; yes				lda	drvr_req_cnt+2		ora	drvr_req_cnt	;req count zero? (A = no_error)		clc		beq	read_exit		lda	<drvr_blk_size	; validate the current block size		cmp	#$0200		beq	chk_multi		cmp	#$020C		beq	chk_multiplebad_parm		lda	#drvr_bad_parm	; invalid block size		sec		rts** Now call Int Math Toolset to do req_cnt DIV 524*chk_multiple		ldx	<drvr_req_cnt+2			bmi	bad_parm	;I don't do negative request counts for 524		lda	#0		pha		pha		pha		pha		phx		pei	<drvr_req_cnt		pea	0000		pei	<drvr_blk_size		_LongDivide		;call int math for the remainder		pla			;discard quot		pla		pla			;get remainder		ora	1,s		;get hi & lo word together in A		plx		tax			;is remainder zero?		beq	do_read		; can't be 1:1 candidate if mac readbad_count	lda	#drvr_bad_count	; invalid byte count		secread_exit	rts** Now see if this is a multi-block read candidatechk_multi	lda	<drvr_req_cnt		and	#$01FF		bne	bad_count	;insist req_cnt is divisible by 512		inc	total_reads	;count all the 512 byte reads		bne	@10		inc	total_reads+2@10			if NOT Version6x then		bit	ext_slot	;is slot external?		bpl	@internal		brl	do_read		;later this will do special multi-blk stuff@internal		endif		lda	drvr_req_cnt+1	; Is this a multi-block read of at least 		cmp	#512*5/256	; half of the smallest 800K floppy track+1 sect?		bcc	do_read		;NO. too small for multi-track		inc	total_multiblk	;count all the multiblk candidates		bne	@20		inc	total_multiblk+2@20		lda	<drvr_cache	; caching requested		beq	multi_blkrd	; NO. so do it mmmyyyyy waaaaayy@#$!eek		inc	total_multidisq	; count the ones disqualified for cache/dsw/etc		bne	@30		inc	total_multidisq+2@30				eject************************************************************************ The following routine is executed for read calls* directed toward class 2 block devices.***********************************************************************do_read					; 		bit	<drvr_fst_num	; force device access		bmi	@dev_acc		clc			; specify block search		jsl	cache_find_blk	; is the block in the cache?		bcs	@not_cached	; no, may want to cache it though.		jsl	cache_to_buff	; yes, read block from cache to buffer		jsr	c2_dev_stat	; check for disk switched error		bcs	@error@no_purge				; ** Block has been read.  Need to adjust the block address* and buffer pointer in preperation for the next read if* a multiple block transaction is in process.  If the* request count has been satisfied, no further action is required.*		jsr	next_blk_ptr	; prepare for next block & test if more		bcc	do_read		; more blocks to read		clc			; all done with no errors		lda	#no_error@error		rts** If block is not in cache or volume ID is zero, must force* access to the device to read the block.*@dev_acc				; 		jsr	do_sp_readblk	; execute device read		bcs	@error		; if error from device		bra	@no_purge	; and continue with transaction** If block is not cached, action depends on the cache enable in the* current call.  If the cache enable is zero then must force access* to the device.  If cache enable is nonzero, a request for a block* for caching must be made of the cache manager.  If no block is granted,* then must force access to the device while reading only to the buffer.* if the block is granted, the block is read from the device to the buffer* and then transferred from the buffer to the cache.*@not_cached				; 		lda	<drvr_cache	; is the cache enable OFF?		beq	@dev_acc	; yes, read but don't do caching		jsr	do_sp_readblk	; execute device read		bcs	@error		; if error from device		jsl	cache_add_blk	; request a block for caching		bcs	@no_cache		jsl	buff_to_cache	; copy data to the cache@no_cache				; 		bra	@no_purge	; and continue with transaction		eject;----------------------------------------; exit paths from multi-blkrd back to ; the original code to handle errors;----------------------------------------count_error	REP	#$30		inc	total_multifail		bne	force_error		inc	total_multifail+2		longa	off		longi	offforce_error	SEP	#$30		lda	>deselect	;deactivate drive enable and start timer		jsr	phases_off		jsr	restore_slot6do_error	REP	#$30		longa	on		longi	on		stz	drvr_tran_cnt		stz	drvr_tran_cnt+2	;incase Direct_read was called		bra	do_read		; do it the hard way for some reason		eject******************************************************************   An UNcached read request of at least 5 blocks*****************************************************************		export	multi_blkrdmulti_blkrd			ldy	#dib_last_sts	;was media offline last time?		lda	[drvr_dib_ptr],y		and	#%10000				beq	@doStatus	;offline so do Status to get blockcount		ldy	#blk_cnt		lda	[drvr_dib_ptr],y		bne	@doRead@doStatus	jsr	Fixup_blkcnt	;go do DevStat to see if blockcount is known			bcc	@doRead		;status returned disk switch so ERROR the Read		sta	multi_err		rts			;return the disk switched/offline error@doRead		equ	*	if Version6x then		bit	ext_slot		bpl	@04		;if Internal slot		brl	multi_blk_Ext@04		equ	*	endif		ldy	#blk_cnt		lda	[drvr_dib_ptr],y		cmp	#1600			;is this an 800K disk?		bne	do_error		;multi_blk only works for 800K disks				SEP	#$30		longa	off		longi	off		jsr	FastBufr	; is buffer in bk0/1 with shadowing on?		bcc	@05		inc	total_multidisq		bne	do_error		inc	total_multidisq+2		bra	do_error		** Save slot environment and enable the IWM and set DRIVE from DIB@05		jsr	enable_slot6	;activate /EN35 		jsr	phases_off		ldy	#%00001111		jsr	IFf_set_mode	;set mode if and only if mode reg available		jsr	enable_sense	;enable drive and sense dsw/onl/mtr status		bcc	@09		inc	total_multidisq		bne	force_error		inc	total_multidisq		bra	force_error	;since status is bad use sp to say so.** The drive is enabled and does not have dsw or offline status * so I must switch the IWM mode to do actual I/O to the media.@09		ldy	#%00001111		jsr	set_iwm_mode	;this time I have to wait if IWM busy* activate the drive select which was dropped to change IWM modes		lda	>select** If the motor was not on, turn is on now!		jsr	motoron	;if not on activate the motor** Now setup all the parameters for ReadTrk and check to see* if the buffer spans any slow memory		longa	on		longi	on		REP	#$30			lda	drvr_blk_num+2		bne	@bberrxit	;blknum > 65535 is an error		lda	drvr_blk_num		jsr	blockchker	;block num in range?		bcc	@10		;yep@bberrxit	lda	#drvr_bad_block	;return drvr_bad_blk error@Aerrxit	pha		longa	off		longi	off		SEP	#$30		lda	>deselect	;deactivate drive enable and start timer		jsr	phases_off		jsr	restore_slot6		REP	#$30		longa	on		longi	on		pla		and	#$00FF		sec		rts* Now calc block count and end blocknum		@10		lda	<drvr_req_cnt+2		and	#$FF00		bne	@17		;gigantic req_cnt !		lda	<drvr_req_cnt+1		lsr	a		;req_cnt div 512 = block cnt		stz	multi_err	@15		sta	block_cnt	;		clc		adc	drvr_blk_num		bcs	@17		;any carry means end_blk_num > 65535		dec	a		;beg_blk+blk_cnt-1 ==> end_blk_num		sta	end_blk_num		jsr	blockchker	;check end_blk_num is in range too!		bcc	@20		;block_cnt now not too big!!@17		lda	#drvr_bad_block		sta	multi_err	;record this as if it happens at end of volume		ldy	#blk_cnt		lda	[drvr_dib_ptr],Y	;get max block (last + 1)		sec		sbc	drvr_blk_num		;subtract starting blk num		bra	@15			;and use result as the blk cnt*@20		lda	block_cnt	;retrieve final block count		asl	a		;turn into a byte count		sta	<drvr_req_cnt+1	;make sure we only read this many bytes		ldx	drvr_blk_num		lda	end_blk_num		sta	drvr_blk_num* Now X = beg_blk_num*     A = end_blk_num*     block_cnt is setup for MIN (req_cnt DIV 512 , MaxBlock - BeginBlk) 		jsr	setup_readtrk	;(restores drvr_blk_num);				longa	off		longi	off		SEP	#$30** Now Update my Cur_cyl from the firmware CurCyl		jsr	Get_CURCYL		php		pla			and	#%00000100	;extract IRQ disable bit		sta	irq_state	;and save for the SEEK routine** Do the lead-in seek here with interrupts ON if user left em that way		jsr	Seek	; and wait for Ready with interrupts ON?		bcc	@seekok@not_ready		REP	#$30		longa	on		lda	#drvr_off_line		bra	@Aerrxit		longa	off** NOW INTERRUPTS MUST BE TURNED OFF TO READ the TRACKS@seekok		jsr	Wait_Rdy_TO	;ensure that the drive is ready		bcs	@not_ready	;oops		php 		sei			;disable interrupts 		jsr	Read_tracks	;read the track/tracks 		php			;save error status		jsr	Put_CURCYL	;update firmware CurCyl before irq allowd		plp		bcc	@its_ok		plp			;RESTORE interrupts		brl	count_error	;redo the read because of an error** The ReadTrk worked so now do the ugly stuff@its_OK				lda	>deselect	;deactivate drive enable and start drive's timer		jsr	phases_off		jsr	restore_slot6	;now deactivate /EN35		plp			;RESTORE interrupts* NOW INTERRUPTS ARE BACK ON		longa	on		longi	on		REP	#$30		stz	drvr_tran_cnt		stz	drvr_tran_cnt+2	;clear out direct_read scratch garbage		lda	block_cnt			asl	a		;make it a page cnt		sta	drvr_tran_cnt+1	;set this incase dev_only access		lda	drvr_fst_num	;did caller want only device access?		bmi	@dev_rd_only	;yep. so forget the slow stuff		stz	drvr_tran_cnt+1	;let next_blk_ptr re-fill this		lda	#0002		sta	drvr_call_num	;restore this too just in case** now search the cache incase some of the blocks I read* were in the cache and must be copied from cache to buffer		clc			;for 1st time thru@cach_chk	jsl	cache_find_blk	;is the block in cache		bcs	@not_in_cache	;it aint there try the next one		jsl	cache_to_buff@not_in_cache	jsr	next_blk_ptr	;update blk_num, buf_ptr, & tran_cnt		bcc	@cach_chk@dev_rd_only	lda	multi_err	;incase req count was too big		cmp	#1		;conditionalize carry properly		rts	if Version6x 	then************************************************************************  Multi_blk Read for external slot "Mustang" cards***********************************************************************Multi_blk_Ext		longa	on		longi	on** Setup the slot's c800 space so I can talk to the Mustang cpu		jsr	enable_slotN	* Now calc block count and end blocknum				lda	<drvr_req_cnt+2		and	#$FF00		beq	@10		;gigantic req_cnt !@05		lda	#drvr_bad_block		sta	multi_err	;record this as if it happens at end of volume		ldy	#blk_cnt		lda	[drvr_dib_ptr],Y	;get max block (last + 1)		sec		sbc	drvr_blk_num		;subtract starting blk num		bra	@15			;and use result as the blk cnt*@10		lda	<drvr_req_cnt+1		lsr	a			;req_cnt div 512 = block cnt		stz	multi_err	@15		sta	block_cnt		;		clc		adc	drvr_blk_num		bcs	@05			;any carry means end_blk_num > 65535		dec	a			;beg_blk+blk_cnt-1 ==> end_blk_num		sta	end_blk_num		ldy	#blk_cnt		cmp	[drvr_dib_ptr],y	;is end > volume size?		bcs	@05			;yep. so limit to last block num		lda	drvr_blk_num		sta	beg_blk_num		lda	drvr_buf_ptr		sta	drvr_buf2_ptr		lda	drvr_buf_ptr+2		sta	drvr_buf2_ptr+2		;setup the starting buffer pointer		lda	drvr_buf_ptr+1		sta	basePgBk*     block_cnt is setup for MIN (req_cnt DIV 512 , MaxBlock - BeginBlk) Do_hunk		jsr	SelectBank0		lda	block_cnt		sta	Mu_blk_cnt				ldx	#NuM_CalcBlks		jsr	Send_CPU_Cmd		bcs	Anerror			;device Busy error!				ldy	#-1@waitReply1	lda	>c8_reply		;16-bit fetch of 8-bit item		and	#$0080		beq	replied1		phy		ply		dey		bne	@waitReply1Rdbusyerr	lda	#drvr_busyDSWexit		sec		rts		replied1	lda	>c8_error		and	#$00FF		beq	rd_the_hunk		cmp	#drvr_disk_sw	;if the error is Disk switched JOA 11/15/91		beq	DSWexit		;it must be reported my me NOW JOA 11/15/91Anerror		and	#$00FF		; bad block/Offline/diskSwitched error		sta	multi_err		inc	total_multidisq		bne	@ferr		inc	total_multidisq@ferr		brl	do_error	;since somthin is bad use slow way.rd_the_hunk	equ	*		lda	>c8_xfr_cnt		sta	tail_cnt		sta	Mu_blk_cnt		bne	@01		brl	@done@01				ldx	#NuM_ReadNBlks		jsr	Send_CPU_Cmd	;when CPU is ready		bcs	Rdbusyerr@cmdok		equ	*** Now look for initial reply		php		sei		ldy	#-1@waitReply1	lda	>c8_reply		;16-bit fetch of 8-bit item		bit	#$0080		beq	@replied1		phy		ply		dey		bne	@waitReply1		plp		bra	Rdbusyerr		@replied1	plp		and	#$00FF		bne	@get_blocks		lda	>c8_error		and	#$00FF		bne	Anerror** Now start waiting for sectors@get_blocks	equ	*		stz	block_ctr	;		jsr	SelectBank1		@wait_cnt	lda	>cA_rcount		bmi	@booboo		;Oh Boy! the C800 space must ev gotn LOST		beq	@wait_cnt	;it hasn't read any yet		cmp	#$100		;was there an IOError or such?		bcs	@BADNEWS	;its all fizzed up boys		cmp	block_ctr		beq	@wait_cnt	;not ahead of my count		bcs	@scanrtbl	;CPU's count is > mycounter	*  bad news boys something has switched out the c800 space@booboo		rep	#$30		;force longa and longi		jmp	Rdbusyerr	;cA_rcount is way out of range!		@BADNEWS	ldx	tail_cnt		sep	#$20		longa	off@05		lda	>cA_rtable-1,x		cmp	#$A0		;is this the error code?		bcs	@goterr		;either IO or Offline		dex		bne	@05		lda	#drvr_io_error	;well report it as IO if all else fails@goterr		rep	#$20		longa	on		and	#$007F		;zero unknown hi byte and $80 bit		sec		rts			;WELL FOLKS    I AM OUTA HERE ___....---^^^"""*@scanrtbl	equ	*		ldx	tail_cnt		sep	#$20		longa	off@10		lda	>cA_rtable-1,x		beq	@20		;this one not read yet		bpl	@fnd@20		dex		bne	@10* Now What??? it said another block was done but the rtable doesn't say so		bra	@booboo		@fnd		ora	#$80		sta	>cA_rtable-1,x	;mark this buffer as mooovvvveeeddd		rep	#$20		longa	on		and	#$007F		dex		;convert index to relative block number (0..n-1)** move the buffer given in A to relative block given by X		jsr	Move_blk_buffer		inc	block_ctr		lda	block_ctr		cmp	tail_cnt		bcc	@wait_cnt		@next_hunk	equ	*		lda	tail_cnt		clc		adc	beg_blk_num		sta	beg_blk_num		;add count to begin** Now update the driver tran count and my hunk buffer pointer		lda	tail_cnt		;get block count transferred		xba			;* 256		asl	a		;* 512		pha				;save for ptr update		clc			adc	drvr_tran_cnt		sta	drvr_tran_cnt		bcc	@sk1		inc	drvr_tran_cnt+2	;move up to next 65K transferred@sk1		lda	basePgBk		sta	drvr_buf2_ptr+1	;restore pointer to begin of hunk buffer		pla		clc		adc	drvr_buf2_ptr		sta	drvr_buf2_ptr	;don't use drvr_buf_ptr due to error restart		bcc	@sk2		inc	drvr_buf2_ptr+2	;move up to next bank@sk2		lda	drvr_buf2_ptr+1		sta	basePgBk	;update base adrs upper 16 bits		lda	block_cnt		sec		sbc	tail_cnt	;subtract this hunk from remainder		sta	block_cnt				beq	@done		;remainder == ZERO so must be all done		brl	Do_hunk		;do the next hunk of blocks		@done		lda	multi_err		cmp	#1		;conditionalize carry properly		rts		***********************************************************************	Select_BufX**  INPUT:	X = is relative buffer for this hunk*		A = buffer number of the buffer to select *		basePgBk contains page and bank start for this hunk* OUTPUT:	C = which half of bank is the buffer (0 = $C8, 1 = $CA)***********************************************************************Select_BufX	equ	*		longa	on		longi	on		txy		and	#$001F		;make sure result in 31 max		lsr	a		;convert buffer # into bank select		php			;save carry for result		ora	Slotx16		;combine  $00S0 with $000b		tax		sep	#$20		longa	off		lda	>$C080,x	;select the bank of RAM with the buffer		rep	#$20		longa	on		tya			;get relative block number in A		asl	a		;calc relative page offset (		clc		adc	basePgBk		sta	drvr_buf2_ptr+1	;set the pointer for this block		plp			;get carry back for caller		rts		************************************************************************  Move Block Buffer to User Buffer**  INPUT:	A = buffer to move*		X = relative block number***********************************************************************Move_blk_buffer	equ	*		longa	on		longi	on				jsr	Select_BufX	;select buffer and set Y per buffer offset* return C = 0 for $C800 buffer and C=1 for $CA00 buffer		phb		pea	0000		plb		plb		;set data bank for bank for 00		ldy	#512-2		bcs	@cAloop@c8loop		lda	$C800,y		sta	[drvr_buf2_ptr],y		dey				;$1FD		dey				;$1FC,F8,F4,F0, ... 0004,0000		lda	$C800,y				sta	[drvr_buf2_ptr],y		dey				;$1FB		dey				;$1FA,F6,F2,FE, ... 0002,FFFE		bpl	@c8loop		bra	@done@cAloop		lda	$CA00,y		sta	[drvr_buf2_ptr],y		dey		dey		lda	$CA00,y				sta	[drvr_buf2_ptr],y		dey		dey		bpl	@cAloop@done		equ	*		plb		;restore data bank*	|	|	|*	v	v	v	fall thru into SelectBank1 for exit*********************************************************************** Select Mustang RAM bank 1 for xfer loop**********************************************************************SelectBank1	equ	*		ldx	Slotx16		sep	#$20		longa	off		lda	>$C081,X		rep	#$20		longa	on		rts		************************************************************************ Send Cmd to NuMustang CPU**  INPUT:	x = cmdnum to send**  ASSUMES:	SelectBank0 has been called*		Other parameters are already setup**********************************************************************Send_CPU_Cmd	equ	*		longa	on		longi	on		lda	beg_blk_num		sta	Mu_blk_num		stz	Mu_blk_num+2		ldy	#unit_num				sep	#$20		longa	off* 8-bit A mode				lda	[drvr_dib_ptr],y		sta	Mu_unitnum		txa		ora	#$40		sta	Mu_cmdmode		;make it an "extended" call		ldy	#-1@waitCPUrdy	lda	>c8_cmd_msg		;+5		bmi	@rdy1			;+7		phy		ply		dey				;+9		bne	@waitCPUrdy		;+12		lda	#drvr_busy		sec		rts		@rdy1		phx		ldx	#9-1@mvMu_parms	lda	Mu_cmdmode,x		sta	>c8_parms,x		dex		bpl	@mvMu_parms				lda	#$FF		sta	>c8_reply		;clear the reply		pla		sta	>c8_cmd_msg		pla		; (pull upper half of phx above (longi is ON!!!)		* 16-bit A mode		rep	#$20		longa	on		clc		rts			************************************************************************ Enable SlotN's C800 space ***********************************************************************		longa	on		longi	onEnable_SlotN		ldy 	#slot_num		lda	[drvr_dib_ptr],y	;get slot number		and	#$0007		ora	#$00C0		;A = $00CN				php		sei		;interrupts off for a moment		sep	#$20		longa	off		sta	>mslot		;set mslot to $Cn for interrupt restore of C8space		xba					lda	>$CFFF		;(8-bit fetch) switch out all c800 spaces		lda	#00		; A = $Cs00		rep	#$20		longa	on		tax		lda	>0,x		;(2 8-bit fetches) switch in the desired slot's c800 space		stx	Cn00		plp		;restore interrupts		txa		xba		and	#0007		asl	a		asl	a		asl	a		asl	a		sta	Slotx16		;contains $00s0 where s = slot number*       |       |       |   fall thru into Select Bank 0*       v       v       v*********************************************************************** Select Bank 0 ***********************************************************************		longa	on		longi	onSelectBank0	equ	*		ldx	Slotx16		sep	#$20		longa	off		lda	>$C080,X		rep	#$20		longa	on		rts	endif		eject******************************************************************* The following routine is used to increment the block # and ptr* in preperation for the next I/O transaction. Then the transfer* count is compared to the request count with the carry set as a* result of the compare.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x x  0** EXIT:         A Reg = Unspecified*               X Reg = drvr_blk_size*               Y Reg = Unspecified*               B Reg = Same as entry*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x 1  0 if transfer count ³ request count*                       x x 0 0 0 x x 0  0 if transfer count < request count******************************************************************		export	next_blk_ptrnext_blk_ptr				;               		longa	on		longi	on		clc			; adjust buffer pointer		lda	<drvr_blk_size		TAX		adc	<drvr_buf_ptr		sta	<drvr_buf_ptr		lda	#$0000		adc	<drvr_buf_ptr+2		sta	<drvr_buf_ptr+2		inc	<drvr_blk_num	; point at next block		bne	@10		inc	<drvr_blk_num+2@10				; 		clc			; update transfer count		TXA		adc	<drvr_tran_cnt		sta	<drvr_tran_cnt		lda	#$0000		adc	<drvr_tran_cnt+2		sta	<drvr_tran_cnt+2		cmp	<drvr_req_cnt+2	; compare MSB trans to req		bcc	@20		lda	<drvr_tran_cnt	; compare LSB trans to req		cmp	<drvr_req_cnt@20		rts			; carry set if I/O transaction done		eject******************************************************************* The following routine executes a readblock from the SmartPort* device.** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Same as program bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x x  0** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x 0  0 if no error*                       x x 0 0 0 x x 1  0 if error******************************************************************		export	do_sp_readblkdo_sp_readblk		longa	on		longi	on				jsr	setup_sp_call	; setup SmartPort call parameters				ldy	#dib_last_sts	;was media offline last time?		lda	[drvr_dib_ptr],y		and	#%10000				beq	@doStatus	;offline so do Status to get blockcount		ldy	#blk_cnt		lda	[drvr_dib_ptr],y		bne	@doRead@doStatus	jsr	Fixup_blkcnt	;go do DevStat to see if blockcount is known			bcs	@dswErr		;status returned disk switch so ERROR the Read		@doRead		lda	<drvr_dev_num	; device number to read		ldx	<drvr_blk_size	;which block size to do?		cpx	#$020C		;a mac write?		ldx	#blockread_list		bcc	@10		;NO.		ldx	#readbyts_list	;yes.@10		jsl	to_b0_core@dswErr		rts		eject******************************************************************* The following routine sets up call parameters in the SmartPort* parameter lists for both the readblock and writeblock SmartPort* device calls.** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Same as program bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x x  0** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x x  0******************************************************************		export	setup_sp_call		longa	on		longi	onsetup_sp_call		lda	<drvr_blk_num	; setup block number for SmartPort call		sta	blockrd_blk		sta	blockwr_blk		sta	rdbyts_blk		sta	wrbyts_blk		lda	<drvr_blk_num+2		sta	blockrd_blk+2		sta	blockwr_blk+2		sta	rdbyts_blk+2		sta	wrbyts_blk+2		lda	<drvr_buf_ptr	; setup buffer pointer for SmartPort call		sta	blockrd_buf		sta	blockwr_buf		sta	rdbyts_buf		sta	wrbyts_buf		lda	<drvr_buf_ptr+2		sta	blockrd_buf+2		sta	blockwr_buf+2		sta	rdbyts_buf+2		sta	wrbyts_buf+2		lda	<drvr_blk_size		sta	rdbyts_count		sta	wrbyts_count; now setup the smartport unit number from the DIB		ldy	#unit_num		; get unit number from DIB		sep	#$20			; 8 bit 'm'		longa	off				lda	[<drvr_dib_ptr],y		sta	blockrd_unit		; install in read call list		sta	blockwr_unit		; install in write call list		sta	rdbyts_unit		sta	wrbyts_unit				rep	#$20			; 16 bit 'm'		longa	on		rts******************************************************************                                                               **  blockchker     Check the 16-bit A-reg against the DIB        **                                                               **    This routine checks the block in the A-reg to see          **  if it is within the correct bounds for disk volume size      **                                                               **   Regs:   A,Y  destroyed                                      **           C <-- 1 if block out of range ; 0 otherwise         **                                                               ******************************************************************		longa	on		longi	onBlockChker	ldy	#blk_cnt                cmp     [drvr_dib_ptr],Y	;		bcc	@exit		sec		@exit		rts		eject******************************************************************  Do all the setup calculations for the Read_tracks variables** ENTRY:        A Reg = end_blk_num*               X Reg = drvr_blk_num*               Y Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x x  0** EXIT:         A,X,Y = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x x  0  *****************************************************************		export	setup_readtrk		longa	on		longi	onSetup_ReadTrk	phx		jsr	blkmap		;convert end_blk_num to track,sector		sta	end_sector		sty	end_track		plx		stx	drvr_blk_num		jsr	blkmap		;convert beg_blk_num to track,sector		SEP	#$30		jsr	tracksect	;convert track in Y into curnsect in A		sta	curnsect	;save sect/beg_track		REP	#$30* now Calc the track cnt		lda	end_track		sec		sbc	track		inc	a		sta	trk_ctr		;trk_ctr is number of tracks		tay			;for testing 1 track case; now setup all the parameters		lda	block_cnt		sta	block_ctr	;set up count down for Read_Tracks;		lda	end_sector		inc	a		;E.G. if last sector #= 3 tail cnt = 4		sta	tail_cnt	; this may not get used if 1 trk case		tax			;save end_sector+1		lda	sector		sta	begin_sect	;start at the beginning ;		lda	curnsect	;get sects/begin_track		cpy	#0001		;are all the sectors on 1 track?		bne	@30		;no.		txa			;for 1 trk case use end_sector+1 instead of curnsect@30		sec		sbc	begin_sect	;calc sectors on 1 track		sta	read_ctr;				longa	off		longi	off@40		SEP	#$30		;8 bit native		ldx	#00		lda	#$40		;assume begin_sect is > 0@50		cpx	begin_sect		bcc	@60		lda	#$80		;now fill to (if trk_cnt > 1 then curnsect) @60		cpy	#0001		;      or to (if trk_cnt = 1 then tail_cnt)		bne	@70		cpx	tail_cnt		bcc	@70		LDA	#$40		;if partial 1 trk case fill to end with don't want@70		sta	want_fnd_tbl,x		inx		cpx	curnsect	;am I done yet?		bcc	@50		REP	#$30		longa	on		longi	on		rts		TITLE   '     Block Mapping Routine'   **********************************************************  BlkMap           Map the block number to*                   cyl, track, sector, & side** Assumes:    800K  only and BlkChk has been called 1st* *   Input:    drvr_blk_num <- block to convert*   Output:   track, cyl, sector, side*   Uses:     TrackSect*   Regs:     A <- sector*	      Y <- track*   Destroys: X, temp* ********************************************************		longa	on		longi	on** Preserve the low order six bitsBLKMAP		SEP	#$30		longa	off		longi	off                LDA     drvr_blk_num                AND     #$3F                STA     SECTOR** Obtain a table driven "guess" for the track, sector.*  Get index into table with CmdBlock div 64.                LDA     drvr_blk_num 	;                STA     TEMP		;dexxxxxx                LDA     drvr_blk_num+1	;0000 0abc  (max of 06)                ROL     TEMP                ROL     A               ;0000 abcd                ROL	TEMP                ROL     A               ;000abcde = Block DIV 64** If this disk is 800K GCR offset to second half*  of the track and sector tables.@10             EQU     *                TAX                     ;        set up table index                LDA     SECTAB,X	; sector number                PHA                     ;        save it                LDA     TRACKTAB,X	; track number                TAY                     ;        save it                PLA                     ;        restore sector number** Y now has the track and A has the sector of the*  requested CmdBlock with the low six bits clear.*  Now we add the low six bits and correct an *  illegal mapping by subtracting off tracks*  of sectors.                CLC                ADC     SECTOR@20             PHA                     ;PRESERVE        the sector number                 JSR     TRACKSECT       ;A <- # sectors on current track                 STA	TEMP		;Keep A                 PLA                     ;PULL    back sector number                 CMP	TEMP		;Bigger than # on this track?                 BLT     @30             ;No: block's been mapped ; branch                 INY                     ;NEXT    track                 SBC	TEMP		;Subtract # sectors that track                 BRA     @20             ;Try again ** Acc now has the sector, and X now has the track. *  In the case of a two sided disk, the track is*  actually twice the cylinder, so correct for that.**********************************************  Note that the carry is clear here.   ****@30             STY     CYL		sty	track		;save cyl+side                STA     SECTOR** The track (A) is really the cylinder*2 plus the side.*  -> CCCCCCCS. Div by two puts cyl->A and side->carry.                LSR     CYL	;convert track to cyl and set 		stz	side                ROR     SIDE 	;side = 00 or $80		longa	on		longi	on		REP	#$30		LDA	SECTOR	;return 16 bits                RTS***************************************************                                                **  TrackSect        Determine the number of      **                       sectors for a cylinder   **                                                **   Input:    Y <- the track                     **             X <- the drive                     **   Output:   A <- number of sectors this cyl    **             class <- speed group (0-4)         **   Prsrves:  X & Y (carry is set)               **   Max time: 16 microsec  (2MHZ)                **                                                ***************************************************		longa	off		longi	offTRACKSECT	TYA                LSR     A               ;map trk (0..159) to cyl (0..79)*		export	CYLSECTCYLSECT         LSR     A               ;Alt entry for A <- cyl                 LSR     A                LSR     A                LSR     A                STA     CLASS                 LDA     #12                SEC                SBC     CLASS		; 12-(0,1,2,3,4)=12..8		RTS                  	;A has # of sectors per track*** This table contains the track number of blocks with*  the low six bits clear.  Table has 25 entries for*  a double sided 800K format diskette.*TRACKTAB        DC.B    0,5,10,16,21,26,32,37,43,49                DC.B    55,61,67,73,80,86,92,99,106,113                 DC.B    120,128,136,144,152** This is the sector table.SECTAB          DC.B    0,4,8,0,4,8,0,9,7,5                 DC.B    3,1,2,6,0,4,8,5,6,7                 DC.B    8,0,0,0,0                       TITLE   '     GET & PUT CURCYL to cyr_cyl'    ****************************************************************** The following routine extracts CURCYL from firmware $E1 bank* variables and sets cur_cyl table** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0** EXIT:         A Reg = Undefined*               X Reg = unchanged*               Y Reg = unchanged*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0 ******************************************************************		export	Get_CurCyl		longa	off		longi	offGet_CurCyl	REP	#$20		longa	on		lda	rom_version		cmp	#0002		bge	@10		lda	$E10F22		;rev 01 rom stores this here		bra 	@20@10		lda	$E10F3A		;rev 03 rom stores this here@20		sta	cur_cyl		longa	off		SEP	#$20		rts****************************************************************** The following routine updates CURCYL in firmware $E1 bank* variables from my  cur_cyl table** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0** EXIT:         A Reg = Undefined*               X Reg = drive*               Y Reg = unchanged*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0 ******************************************************************		export	Put_CurCyl		longa	onPut_CurCyl	ldx	drive		REP	#$20		lda	rom_version		cmp	#0002		longa	off		SEP	#$20		lda	cur_cyl,x		bcs	@10		sta	$E10F22,x		;rev 01 rom stores this here		rts@10		sta	$E10F3A,x		;rev 03 rom stores this here 		rts                TITLE   '     Read n Partial/whole Tracks'    ******************************************************* Reads all the sectors on one side of a track into a * buffer.  The routine allows for 1 * retry per sector (2 revs max) to read all sectors.** If a TRKREAD fails for any reason the read must be* retried sector by sector since on 1 retry per sector* is performed.******************************************************;  Assumed;  1) that volume is online and been checked for dsw;  2) the motor is up to speed and the drive is READY;  3) that the TRACK, TRKCNT, SECT_CNT, WANT_FND_TBL, ;     READRET, BEGIN_SECT, and TAIL_CNT have been setup. ;  4) that drvr_buf_ptr points to a contiguous buffer;     large enough to contain SECT_CNT sectors ;  5) that the sectors will be positioned in the buffer;     in ordinal order by sector number beginning with ;     BEGIN_SECT of TRACK ;  6) IF trackcnt > 2 Then all sectors must be 'wanted';     for the tracks other than begin and end tracks.******************************************************		longa	on		longi	on		export	read_tracksRead_tracks	REP	#$30		LDA	drvr_buf_ptr+1                STA     BASESAVE	;save original base pg +bk		longa	off		longi	off		SEP	#$30		lda	drvr_buf_ptr		sta	drvr_buf2_ptr	;low byte to 2nd pg pointer; Track loop begins here		@RDTRK          LDA     TRACK                CMP     #160                BCS     @IOERR          ;oops. an idiot caller!!                STZ     SIDE                LSR     A               ;extract a side bit                STA     CYL		;save cyl for seek                ROR     SIDE		; set side = $00/$80** Convert cyl to curnsect (sects/trk) and setup readret, adrsret		ldx	drive		lda	cyl		jsr	cylsect 	;convert cyl to sects/trk                sta     CURNSECT	;determine current sects/trk		ldy	read_ctr	;was this input or should I fill it in?		bne	@03		;input provided so use it		sta	read_ctr	;must not be first/last track.@03		ASL     A                INC     A               ;plus 1                STA     ADRSRET		;save curnsect*2 as limit ctr		STZ	found_ctr** Set up the maximum number of reseeks                LDA     #02                STA     SEEKRET** Now save drvr_buf_ptr page+bank address		longa	on		REP	#$20                LDA     drvr_buf_ptr+1                STA     basepgbk		longa	off		SEP	#$20** Seek to the cylinder in cyl@30             EQU     *                JSR     SEEK		;                BCC     @50             ;If no error, get an adr field 		CMP	#drvr_off_line	;timeout after waiting 700ms for a seek???		beq	@seterr		;yes!                bra     @35** Seeked to the wrong cylinder.  Use the cylinder*  number found to define our current position. @SEEKERR        EQU     *                LDX     DRIVE                STA     cur_cyl,X	;Use cyl found as reference** There was a seek error ("hard" or "soft"). Maintain seek counter@35             EQU     *                DEC     SEEKRET                BNE     @30             ;Maybe try a reseek ** Set the fatal error flag@IOERR          EQU     *                LDA     #drvr_io_error	;just back down to 1 blk at a time code@SETERR		REP	#$30		longi	on		longa	on		AND	#$00FF		;clear hi byte of a for caller		LDX     BASESAVE                STX     drvr_buf_ptr+1	;restore zpg		longa	off		longi	off		SEP	#$30                SEC		RTS** Count down the address retry counter@40             DEC     ADRSRET                BEQ     @IOERR** Okay, read an address field@50             EQU     *                JSR     RDADDR                BCC     @60                cmp	#ADRERROR+DBSERROR ;was err bit slip or chksum?                bcs	@40             ;yes. so retry it once                BRA     @IOERR          ;no. either timeout or SSfmt err.** Now, see if this is the cylinder we expected @60             EQU     *                LDA     SIDEFND		;00S0000t                 LSR     A               ;000S0000 t->c                LDA     TRKFND                BCC     @66                ORA     #$40@66             CMP     CYL                BNE     @SEEKERR** Is side found what we thought?@70             EQU     *                LDA     #$20                AND     SIDEFND		;00s00000                ASL     A               ;0s000000                ASL     A               ;s0000000                EOR     SIDE		;0&0,1&1 leaves 0                BMI     @40             ;treat this like adrs err** don't double read a sector if it read correctly before                LDX     SECTFND                BIT     WANT_FND_TBL,X	;Have I found or do I want this sector?                BVS     @40             ;Don't want this one so keep looking		BPL	@40		;Already found this one so keep looking** Calc the Direct read addresses 		longa	on		longi	on		REP	#$30                TXA                     ;  (== ldx sectfnd)		SEC		SBC	begin_sect	;in case this is partial track read                ASL     A               ;sect# * 2 is offset in pages                ADC     basepgbk	; add offset to page&bank                STA     drvr_buf_ptr+1		INC	A		STA	drvr_buf2_ptr+1	;set the ptr for 2nd page		SEP	#$30		longa	off		longi	off** Now Direct read this sector into the buffer		lda	sectfnd                jsl     Direct_read	;read direct to user buffer                bcs     @40             ;bad read. so get the next one		inc	found_ctr	;count sectors (blocks) I read** record that this sector has been read into users buffer                LDX     SECTFND 	;                STZ     WANT_FND_TBL,X			REP	#$20		DEC	block_ctr	;all blocks (up to 640 of em) done?		SEP	#$20		BEQ	@99		;yes. so forget this noise                DEC     read_ctr 	;is this track done?                BNE     @40             ;no. so cnt adrs and read next sector		DEC     trk_ctr		;any more tracks to do?                BEQ     @99             ;nope.** now adjust track and drvr_buf_ptr pointer                 INC     TRACK 		;increment to next cyl+side		longa	on		REP	#$20                LDA     found_ctr 	;get sects/trk I just read in                ASL     A               ;sects * 2 = pagecnt I red                CLC                ADC     basepgbk                STA     drvr_buf_ptr+1		SEP	#$20		longa	off		stz	begin_sect	;start next track at sect 00** clear the sector want_found table for next full/partial track		ldy	#12		sty	csum		stz	read_ctr		lda	trk_ctr		;is this the last track?		dec	a		bne	@80		;nope. so read em all		lda	tail_cnt	;yep. so set NOT wanted until tail_cnt		sta	read_ctr				sta	csum@80		LDA     #$40@84		cpy	csum		bne	@88		LDA	#$80		;set 'doread' status from cnt-1..0@88		DEY                STA     want_fnd_tbl,Y                BNE     @84		;fill table with the status                BRL     @RDTRK		;and read this track@99		REP	#$30		longi	on		longa	on		and	#$00FF		LDX     BASESAVE                STX     drvr_buf_ptr+1 		longa	off		longi	off		SEP	#$30                CLC                RTS                EJECT*************************************************** FastBufr** FastBufr determines if the user buffer address* is in fast memory or if the 512 bytes spans a* bank boundary**    INPUT :  cmdbuffl+1,+2 is user buffer adrs*    OUTPUT: DRswtch =  00 if bk spanned or slow (shadowed)*            DRswtch = $FF if fast and not bk spanned ****************************************************		longa	off		longi	offFASTBUFR        EQU     *                LDY     drvr_buf_ptr+2                CPY     #$E0                BCC     @10                CPY     #$E1+1                BCC     @SLOW@10             CPY     #02                BCC     @15                BRA     @FAST		;02..DF and E2..FF*now test the bank 00 and 01 cases		@15             LDA     >SHADOW                AND     #$3E                CMP     #$3E            ;all fast with TenSpeed CYA (nee FPI)?                BEQ     @FAST           ;yep                CMP     #$1E            ;all fast with GS FPI?                BNE     @SLOW		;no. forget it		LDX	drvr_buf_ptr+1		CPX	#$0C		;is buffer above txtpg2?		BCS	@FAST		;yep. it safe                BRA     @SLOW		;nope. might be TenSpeed with txtpg2 shadowing on@FAST           CLC		RTS@SLOW		SEC		RTS		if	0	THEN		TITLE	'     Check a page address of bnk 00/01'*************************************** ChkpgSlow checks the page address* of a page in bank 0/1 to see* if it is shadowed and therefore slow** INPUTS :  X = page address to check*           A = shadow Reg shadow bits*               (Shadow AND $3E)*           Y = Bank address (00/01)* OUTPUT :  C = 1 if slow*           C = 0 if fast    ** PRESERVES : A-reg, X-reg, Y-reg* DESTROYS  : carry  (and P)***************************************		longa	off		longi	offCHKPGSLOW                 CPX     #$FF            ;do bufr pags span bank boundary?                BEQ     @SLOW           ;yes. so do block indirect!                CPX     #$D0                BCS     @FAST                CPX     #$C0                BCS     @SLOW                CPX     #$A0                BCS     @FAST                CPX     #$08                BCC     @SLOW                CPY     #01             ;bank 1 only check?                BNE     @20                CPX     #$60                BCC     @20             ;adrs not in range                BIT     %00001000       ;is $6000..$9FFF fast RAM                BNE     @FAST           ;yep                BRA     @SLOW@20             CPX     #$20            ;in hires 1/2 range?                BCC     @40             ;no.                CPX     #$40            ;hires 1 or 2?                BCS     @30                BIT     #%00000010      ;are HiRes1,1X both fast?                BRA     @35             @30             BIT     #%00000100      ;is HiRes2,2x both fast?@35             BNE     @FAST                CPY     #00                BEQ     @SLOW           ;                BIT     #%00010000      ;is HiRes1x or 2x fast                 BNE     @FAST           ;yes                BRA     @SLOW           ;no.@40             CPX     #$0C            ;txtpg2?                BCS     @FAST                BIT     #%00100000      ;only 1 if Rev D FPI                BEQ     @SLOW@FAST           CLC                RTS@SLOW           SEC                RTS		endif                TITLE   '     Read Address Field'      *************************************************** *  rdaddr                Read an address field*                                 with timeout* *   Output:   sectinfo[0..4] of sector found*             c=0 Read OK*             c=1 Read BAD *	A-reg   Cause*	$20	Single Sided Format*	$24	Timeout no Adrs Mark*	$28	Bit slip error* 	$30	CheckSum error*   Destroys: A, X, Y, temp* **************************************************		longa	off		longi	off		export	RDADDRRDADDR** Set IWM into read mode		JSR     RDMODE          ;Set read mode & hdsel** Set up the timeout                LDA     #>AMTOUT                STA     TEMP                LDY     #<AMTOUT** Find the 3  marks nybbles@10             LDX     #2              ;Three of 'em@20		DEY                     ;MAINTAIN        double byte t.o. ctr                BNE     @30             ;=> no timeout                DEC     TEMP                BMI     @TOERR		;Oops, timeout error* @30		LDA     >L6CLR           ;Look for a byte                BPL     @30             ;Branch if no byte ready                CMP     ADRMARKS,X	;Is it the right mark?                 BNE     @10             ;No, start all over                 DEX                     ;YES,    found a mark                 BPL     @20             ;If more marks, go back ** Found an address field. Now grab the info *                LDY     #4              ;Four pieces of info + csum                STZ     CSUM@40		LDA     >L6CLR           ;Get a byte                BPL     @40             ;If not ready, back again		TAX			;                LDA     >DNIBTAB,X      ;Perform 8 to 6 bit xform                 STA     SECTINFO,Y	;Save that chunk                 EOR     CSUM		;Add into the checksum                STA	CSUM                DEY                     ;ONE     less piece of info                BPL     @40             ;If more, go back** The last byte was the checksum. If our calculated*  checksum is not zero now, we've had a problem*                TAY                BNE     @CSERR** Now identify the bitslip marks*@50             LDA     >L6CLR                BPL     @50                CMP     BSLIP1                BNE	@BSERR*@60             LDA     >L6CLR                BPL     @60                CMP     BSLIP2                BNE     @BSERR*                LDX     DRIVE                LDA     FMTFND		;extract the DS bit from Fmt                 AND     #$20                beq	@ERR		;error if its NOT double sided format!!!	*                CLC                     ;GOT     a good sector                RTS*@TOERR		LDA	#TOERROR				bra	@err@CSERR		LDA	#DCSERROR			bra	@err@BSERR		LDA	#DBSERROR@ERR	        ORA     #ADRERROR	;$20=ssfmt, $24=timeout, $28=BSlip, $30=Cksum                SEC                RTS**RDMODE          EQU     *                LDA     >L7CLR                LDA     #READ0ADR                BIT     SIDE                BPL     @10                LDA     #READ1ADR@10             JSR     READ_BIT                LDA     >L6CLR                RTS		;----------------------------------------		endp