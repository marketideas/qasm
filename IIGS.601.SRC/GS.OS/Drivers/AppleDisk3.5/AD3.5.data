		eject******************************************************************* The following table is the header required for all loaded* drivers which consists of the following:**               Word    Offset from start to 1st DIB*               Word    Number of DIBs*               Word    Offset from start to 1st configuration list*               Word    Offset from start to 2nd configuration list*               etc.******************************************************************		export	driver_data	driver_data	proc	ENTRY		export	herehere					;               		dc.w	dib_1-here	; offset to 1st DIB		dc.w	8		; number of devices		dc.w	conf1-here	; offset to 1st configuration list		dc.w	conf2-here	; offset to 2nd configuration list		dc.w	conf3-here	; offset to 3rd configuration list		dc.w	conf4-here	; offset to 4th configuration list		dc.w	conf3-here	; offset to 5th configuration list		dc.w	conf4-here	; offset to 6th configuration list		dc.w	conf3-here	; offset to 7th configuration list		dc.w	conf4-here	; offset to 8th configuration list** The following are the driver configuration parameter lists.*		export	conf1conf1		dc.w	0		; 0 bytes in parameter list		export	default1default1	dc.w	0		; 0 bytes in default list		export	conf2conf2		dc.w	0		; 0 bytes in parameter list		export	default2default2	dc.w	0		; 0 bytes in default list		export	conf3conf3		dc.w	0		export	default3default3	dc.w	0		export	conf4conf4		dc.w	0		export	default4default4	dc.w	0		eject******************************************************************* The following are tables of format options for each device.* The format option tables have the following structure:**               Word    Number of entries in list*               Word    Display count (number of head links)*               Word    Recommended default option*               Word    Option that current online media is formatted with*               Entries 16 bytes per entry in the format list** The twenty byte structure for each entry in the format list* is as follows:**               Word    Media variables reference number*               Word    Link to reference number n.*               Word    Flags / Format environment*               Long    Number of blocks supported by device*               Word    Block size*               Word    Interleave factor*               Long    Number of bytes defined by flag** Bit definition within the flags word is as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |___|__ Format*   |   |   |   |   |   |   |   |   |   |   |   |   |___|__________ Flags*   |___|___|___|___|___|___|___|___|___|___|___|__________________ Reserved** Format Bit Definition: 00   Universal format*                        01   Apple Format*                        02   NonApple Format*                        11   Not Valid** Flag Bit Definition:   00   Size is in bytes*                        01   Size is in Kb*                        02   Size is in Mb*                        11   Size is in Gb******************************************************************		export	format_tblformat_tbl				;               		dc.w	format1		; pointer to format option list #1		dc.w	format1		; pointer to format option list #2		eject		export	format1format1					; 		dc.w	2		; number of entries		dc.w	2		; number of displayed entries		dc.w	1		; recommended option is 1		dc.w	0		; current media formatted w/option 1		export	format1_entry1format1_entry1				; 		dc.w	1		; RefNum		dc.w	0		; LinkRef		dc.w	4+1		; Apple format / size in kb		dc.l	1600		; block count		dc.w	512		; block size		dc.w	2		; interleave factor		dc.w	800		; media size is 800kb		export	format1_entry2format1_entry2				; 		dc.w	2		; reference number 1		dc.w	0		; LinkRef		dc.w	4+1		; Apple format / size in kb		dc.l	1600		; block count		dc.w	512		; block size		dc.w	4		; interleave factor		dc.w	800		; media size is 800kb	if 0	then		export	format1_entry3format1_entry3				; 		dc.w	3		; reference number 1		dc.w	0		; LinkRef		dc.w	4+1		; Apple format / size in kb		dc.l	800		; block count		dc.w	512		; block size		dc.w	2		; interleave factor		dc.w	400		; media size is 400kb	endif		export	option_xlateoption_xlate				; 		dc.w	2		; option 1 interleave		dc.w	128		; option 1 sides		dc.w	4		; option 2 interleave		dc.w	128		; option 2 sides		dc.w	2		; option 3 interleave		dc.w	0		; option 3 sides		eject*******************************************************************               Link Pointer*               entry Pointer*               Device Characteristics*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |___|_ RESERVED*   |   |   |   |   |   |   |   |   |   |   |   |   |   |_________ REMOVABLE*   |   |   |   |   |   |   |   |   |   |   |   |   |_____________ FORMAT*   |   |   |   |   |   |   |   |   |   |   |   |_________________ RESERVED*   |   |   |   |   |   |   |   |   |   |   |_____________________ READ*   |   |   |   |   |   |   |   |   |   |_________________________ WRITE*   |   |   |   |   |   |   |   |   |_____________________________ BLOCK DEVICE*   |   |   |   |   |   |   |___|_________________________________ SPEED GROUP*   |   |   |   |   |   |_________________________________________ FIXED NAME*   |   |   |   |   |_____________________________________________ RESTARTABLE*   |   |   |   |_________________________________________________ BUSY*   |   |   |_____________________________________________________ LINKED*   |   |_________________________________________________________ GENERATED*   |_____________________________________________________________ RAM/ROM DEV**               Block Count*               Device Name*               Slot Number*               Unit Number*               Device ID Number*               Head Device Link*               Forward Device Link*               Reserved Word*               Reserved Word*               DIB device number******************************************************************* NOTE: dib's are used only in pairs 1&2, 3&4, 5&6, 7&8* with one pair for each "slot" that has SmartPort Firmware* each controller can have two AppleDisk drives *****************************************************************		dc.l	0		;align dibs at 16 byte boundary for debugging		export	dib1acc_flag		export	dib3acc_flag		export	dib5acc_flag		export	dib7acc_flag		export	dib2acc_flag		export	dib4acc_flag		export	dib6acc_flag		export	dib8acc_flag		export	dib_1		export	dib1_slotdib_1					;               		dc.l	dib_2		; link pointer to second DIB		dc.l	dispatch	; entry pointer		dc.w	$0BEC		; characteristics		dc.l	00000000	; block count		dc.b	13		; device name (length & 32 bytes ascii)		dc.b	'APPLEDISK3.5A                  '	dib1_slot	dc.w	$0000		; slot # (valid only after startup)		dc.w	$0000		; unit # (valid only after startup)		dc.w	current_version	; version		dc.w	$0000		; device ID # (valid only after startup)		dc.w	$0000		; head device link		dc.w	$0000		; forward device link		dc.l	stats_tbl	; Extended DIB pointer		dc.w	$0000		; dib device number** The following data is an extension to the DIB required by the generated* driver core routines called the GENERATED DRIVER INFORMATION BLOCK (GDIB).*		dc.w	$0002		; driver class		dc.w	$0001		; SmartPort Type		dc.w	$00C0		; SmartPort Subtype		dc.w	$FFFF		; Cache Mask		dc.w	512		; Device Block Size		dc.w	$0000		; Device Hardware Unit Number(1/2)dib1acc_flag	dc.w	$0000		; External access detect flag		dc.w	$0000		; Selected format option (if non zero)		dc.w	$0000		; Last status result returned by driver		ds.w	4		; slot environ save temps		export	dib_2dib_2					;               		dc.l	dib_3		; link pointer		dc.l	dispatch	; entry pointer		dc.w	$0BEC		; characteristics		dc.l	00000000	; block count		dc.b	13		; device name (length & 32 bytes ascii)		dc.b	'APPLEDISK3.5B                  '			dc.w	$0000		; slot # (valid only after startup)		dc.w	$0000		; unit # (valid only after startup)		dc.w	current_version	; version		dc.w	$0000		; device ID # (valid only after startup)		dc.w	$0000		; head device link		dc.w	$0000		; forward device link		dc.l	stats_tbl	; Extended DIB pointer		dc.w	$0000		; dib device number** The following data is an extension to the DIB required by the generated* driver core routines called the GENERATED DRIVER INFORMATION BLOCK (GDIB).*		dc.w	$0002		; driver class		dc.w	$0001		; SmartPort Type		dc.w	$00C0		; SmartPort Subtype		dc.w	$FFFF		; Cache Mask		dc.w	512		; Device Block Size		dc.w	$0000		; Device Hardware Unit Numberdib2acc_flag	dc.w	$0000		; External access detect flag		dc.w	$0000		; Selected format option (if non zero)		dc.w	$0000		; Last status result returned by driver		ds.w	4		; slot environ save temps		export	dib_3dib_3					;               		dc.l	dib_4		; link pointer		dc.l	dispatch	; entry pointer		dc.w	$0BEC		; characteristics		dc.l	00000000	; block count		dc.b	13		; device name (length & 32 bytes ascii)		dc.b	'APPLEDISK3.5C                  '			dc.w	$0000		; slot # (valid only after startup)		dc.w	$0000		; unit # (valid only after startup)		dc.w	current_version	; version		dc.w	$0000		; device ID # (valid only after startup)		dc.w	$0000		; head device link		dc.w	$0000		; forward device link		dc.l	stats_tbl	; Extended DIB pointer		dc.w	$0000		; dib device number** The following data is an extension to the DIB required by the generated* driver core routines called the GENERATED DRIVER INFORMATION BLOCK (GDIB).*		dc.w	$0002		; driver class		dc.w	$0001		; SmartPort Type		dc.w	$00C0		; SmartPort Subtype		dc.w	$FFFF		; Cache Mask		dc.w	512		; Device Block Size		dc.w	$0000		; Device Hardware Unit Numberdib3acc_flag	dc.w	$0000		; External access detect flag		dc.w	$0000		; Selected format option (if non zero)		dc.w	$0000		; Last status result returned by driver		ds.w	4		; slot environ save temps		export	dib_4dib_4					;               		dc.l	dib_5		; link pointer		dc.l	dispatch	; entry pointer		dc.w	$0BEC		; characteristics		dc.l	00000000	; block count		dc.b	13		; device name (length & 32 bytes ascii)		dc.b	'APPLEDISK3.5D                  '			dc.w	$0000		; slot # (valid only after startup)		dc.w	$0000		; unit # (valid only after startup)		dc.w	current_version	; version		dc.w	$0000		; device ID # (valid only after startup)		dc.w	$0000		; head device link		dc.w	$0000		; forward device link		dc.l	stats_tbl	; Extended DIB pointer		dc.w	$0000		; dib device number** The following data is an extension to the DIB required by the generated* driver core routines called the GENERATED DRIVER INFORMATION BLOCK (GDIB).*		dc.w	$0002		; driver class		dc.w	$0001		; SmartPort Type		dc.w	$00C0		; SmartPort Subtype		dc.w	$FFFF		; Cache Mask		dc.w	512		; Device Block Size		dc.w	$0000		; Device Hardware Unit Numberdib4acc_flag	dc.w	$0000		; External access detect flag		dc.w	$0000		; Selected format option (if non zero)		dc.w	$0000		; Last status result returned by driver		ds.w	4		; slot environ save temps		export	dib_5dib_5					;               		dc.l	dib_6		; link pointer		dc.l	dispatch	; entry pointer		dc.w	$0BEC		; characteristics		dc.l	00000000	; block count		dc.b	13		; device name (length & 32 bytes ascii)		dc.b	'APPLEDISK3.5E                  '			dc.w	$0000		; slot # (valid only after startup)		dc.w	$0000		; unit # (valid only after startup)		dc.w	current_version	; version		dc.w	$0000		; device ID # (valid only after startup)		dc.w	$0000		; head device link		dc.w	$0000		; forward device link		dc.l	stats_tbl	; Extended DIB pointer		dc.w	$0000		; dib device number** The following data is an extension to the DIB required by the generated* driver core routines called the GENERATED DRIVER INFORMATION BLOCK (GDIB).*		dc.w	$0002		; driver class		dc.w	$0001		; SmartPort Type		dc.w	$00C0		; SmartPort Subtype		dc.w	$FFFF		; Cache Mask		dc.w	512		; Device Block Size		dc.w	$0000		; Device Hardware Unit Numberdib5acc_flag	dc.w	$0000		; External access detect flag		dc.w	$0000		; Selected format option (if non zero)		dc.w	$0000		; Last status result returned by driver		ds.w	4		; slot environ save temps		export	dib_6dib_6					;               		dc.l	dib_7		; link pointer		dc.l	dispatch	; entry pointer		dc.w	$0BEC		; characteristics		dc.l	00000000	; block count		dc.b	13		; device name (length & 32 bytes ascii)		dc.b	'APPLEDISK3.5F                  '			dc.w	$0000		; slot # (valid only after startup)		dc.w	$0000		; unit # (valid only after startup)		dc.w	current_version	; version		dc.w	$0000		; device ID # (valid only after startup)		dc.w	$0000		; head device link		dc.w	$0000		; forward device link		dc.l	stats_tbl	; Extended DIB pointer		dc.w	$0000		; dib device number** The following data is an extension to the DIB required by the generated* driver core routines called the GENERATED DRIVER INFORMATION BLOCK (GDIB).*		dc.w	$0002		; driver class		dc.w	$0001		; SmartPort Type		dc.w	$00C0		; SmartPort Subtype		dc.w	$FFFF		; Cache Mask		dc.w	512		; Device Block Size		dc.w	$0000		; Device Hardware Unit Numberdib6acc_flag	dc.w	$0000		; External access detect flag		dc.w	$0000		; Selected format option (if non zero)		dc.w	$0000		; Last status result returned by driver		ds.w	4		; slot environ save temps		export	dib_7dib_7					;               		dc.l	dib_8		; link pointer		dc.l	dispatch	; entry pointer		dc.w	$0BEC		; characteristics		dc.l	00000000	; block count		dc.b	13		; device name (length & 32 bytes ascii)		dc.b	'APPLEDISK3.5G                  '			dc.w	$0000		; slot # (valid only after startup)		dc.w	$0000		; unit # (valid only after startup)		dc.w	current_version	; version		dc.w	$0000		; device ID # (valid only after startup)		dc.w	$0000		; head device link		dc.w	$0000		; forward device link		dc.l	stats_tbl	; Extended DIB pointer		dc.w	$0000		; dib device number** The following data is an extension to the DIB required by the generated* driver core routines called the GENERATED DRIVER INFORMATION BLOCK (GDIB).*		dc.w	$0002		; driver class		dc.w	$0001		; SmartPort Type		dc.w	$00C0		; SmartPort Subtype		dc.w	$FFFF		; Cache Mask		dc.w	512		; Device Block Size		dc.w	$0000		; Device Hardware Unit Numberdib7acc_flag	dc.w	$0000		; External access detect flag		dc.w	$0000		; Selected format option (if non zero)		dc.w	$0000		; Last status result returned by driver		ds.w	4		; slot environ save temps		export	dib_8dib_8					;               		dc.l	0		; link pointer		dc.l	dispatch	; entry pointer		dc.w	$0BEC		; characteristics		dc.l	00000000	; block count		dc.b	13		; device name (length & 32 bytes ascii)		dc.b	'APPLEDISK3.5H                  '			dc.w	$0000		; slot # (valid only after startup)		dc.w	$0000		; unit # (valid only after startup)		dc.w	current_version	; version		dc.w	$0000		; device ID # (valid only after startup)		dc.w	$0000		; head device link		dc.w	$0000		; forward device link		dc.l	stats_tbl	; Extended DIB pointer		dc.w	$0000		; dib device number** The following data is an extension to the DIB required by the generated* driver core routines called the GENERATED DRIVER INFORMATION BLOCK (GDIB).*		dc.w	$0002		; driver class		dc.w	$0001		; SmartPort Type		dc.w	$00C0		; SmartPort Subtype		dc.w	$FFFF		; Cache Mask		dc.w	512		; Device Block Size		dc.w	$0000		; Device Hardware Unit Numberdib8acc_flag	dc.w	$0000		; External access detect flag		dc.w	$0000		; Selected format option (if non zero)		dc.w	$0000		; Last status result returned by driver		ds.w	4		; slot environ save temps		eject******************************************************************* The following table is used to dispatch to GS/OS driver* functions.******************************************************************		export	dispatch_tabledispatch_table				;               		dc.w	startup-1		dc.w	open-1		dc.w	read-1		dc.w	write-1		dc.w	close-1		dc.w	status-1		dc.w	control-1		dc.w	flush-1		dc.w	shutdn-1		export	stats_tbl		export	Total_reads		export	Total_multiblk		export	Total_multifail		export	Total_multidisqstats_tblTotal_reads	dc.l	0	;total calls to Read (BLOCK 512)Total_multiblk	dc.l	0	;total calls of 5 or more blks per calltotal_multidisq	dc.l	0	;total multiblk disqualified by caching/DSWtotal_multifail	dc.l	0	;total multiblk reads that got errors		eject******************************************************************* The following table contains the device status for each* device supported by this driver.** Encoding of status for a block device is as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |__ DISK SW*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |______ INTERRUPT*   |   |   |   |   |   |   |   |   |   |   |   |   |   |__________ WRITE PROT*   |   |   |   |   |   |   |   |   |   |   |   |   |______________ 0 RESERVED*   |   |   |   |   |   |   |   |   |   |   |   |__________________ ONLINE*   |___|___|___|___|___|___|___|___|___|___|______________________ 0 RESERVED******************************************************************		eject******************************************************************* The following table is used to maintain the current head cylinder* position for read's SEEK routine ; indexed by Drive # (0,1)******************************************************************		export	Cur_CylCur_Cyl		dc.b	$FF		; driv 1 Internal current head posn		dc.b	$FF		; dirv 2 Internal current head posn******************************************************************* The following table is used to maintain the current drive status* status bits for dsw (b7), offline(b6), and motoron (b5).******************************************************************		export	drv_stsDrv_Sts		dc.b	$00		; driv 1 Internal status bits		dc.b	$00		; dirv 2 Internal status bits******************************************************************* The following table is used to maintain a flag for detection * of non-driver "external" access to the SmartPort device.* This table requires that the two drives have SmartPort unit #'s* of 1 to 4******************************************************************		export	pre_checkpre_check	dc.w	0		export	bank1_lgthbank1_lgth	dc.w	end_bank1-beg_bank1****************************************************************** Used during Startup process to scan slots and drives *****************************************************************		export	device_countdevice_count	dc.w	0		; number of devices started up		export	slot_unitsslot_units	dc.w	0		; number of the units in this slot		export	slot_count	slot_count	dc.w	0		; number of SmartPort controllers Cards		export	last_slotlast_slot	dc.w	0		;has $5,$D,$F,$E,$C,$A,$9 during startup		export	last_drivelast_drive	dc.w	0		;has 1/2   0 means not known		export	name_charname_char	dc.b	' A'		;driver name suffix character to "count"******************************************************************* The following equates are general workspace used by the driver.******************************************************************		export	rom_versionrom_version	dc.w	0* ext_slot set during all calls except Startup (which set it itself)		export	ext_slotext_slot	dc.w	0		;0 = internal, -1 = external		export	curnsect	;sectors/cyl for current cyl		export	drive		;dib_hw_unit - 1 for current read		export	class		;speed group 		export	cyl		;input to Seek		export	track		;input to READTRK		export	sector		;output from BlkMap		export	side		;input to RDMODE, SetHead		export	msdelayctr	;temp for MSWait routine		export	temp		;scratch for various		export	adrsret		;work for ReadTrk		export	seekret		;  "   		export	basepgbk	;work for ReadTrk		export	basesave	;save for ReadTrk			export	drswtch		;output from FastBuffr		export	irq_state	;control for Seek enable of IRQ		export	prior_stsprior_sts	dc.w	0		;prior contents of drv_sts,drive		irq_state	dc.w	0		;$00 = don't open for interruptsdrswtch		dc.w	0		;$FF = fast buffer; $00 = slow memorybasesave	dc.w	0		;save for drvr_buf_ptr+1 & +2basepgbk	dc.w	0		;base page+bank of current track bufferseekret		dc.w	0		;adrsret		dc.w	0		;temp		dc.w	0msdelayctr	dc.w	0		;counter for # of millisecondsside		dc.w	0		;$00 = side 0; $80 = side 1sector		dc.w	0		; track		dc.w	0		;0..159  (cyl with side bit as lsb)cyl		dc.w	0		;0..79class		dc.w	0		; = cyl div 16drive		dc.w	0		;dib_hw_unit - 1 (0 or 1)curnsect	dc.w	0		export	sectinfo	;output table of adrs field data		export	fmtfnd		; from the RdAddr routine		export	sidefnd		export	sectfnd		export	trkfnd		export	csfnd;  Sectinfo is really a table and must occur in order		sectinfo	csfnd		dc.b	0fmtfnd		dc.b	0sidefnd		dc.b	0sectfnd		dc.b	0trkfnd		dc.b	0;;--------------------------------------------;  Want-Found Table used by Track Read;      Value	Meaning;	$00	Sector Read sucessfully;	$40	Don't Want this sector;	$80	Read this sector (ASAP);--------------------------------------------		export	want_fnd_tbl	want_fnd_tbl	ds.b	18;----------------------------------------; multi-track read input parmaeters;----------------------------------------		export	Cn00		export	Slotx16		export	SlotsReg		export	Mu_cmdmode		export	Mu_unitnum		export	Mu_blk_num		export	Mu_blk_cnt		export	multi_err		export	found_ctr		export	read_ctr	;input to ReadTrk		export	begin_sect	;input to ReadTrk		export	tail_cnt	;input to ReadTrk		export	block_cnt	;work for ReadTrk 		export	block_ctr	;input to ReadTrk		export	trk_ctr		;input to ReadTrk		export	end_blk_num		export	end_sector		export	end_track		export	beg_blk_numbeg_blk_num:end_track	dc.w	0end_blk_num	dc.w	0block_ctr	dc.w	0		; input & counter for ReadTrkblock_cnt	dc.w	0		; total number of blocks to readtail_cnt	dc.w	0		; number of sectors on last tracktrk_ctr		dc.w	0		;number of tracks (not cyls) to read (0..159)begin_sect	dc.w	0		; sector # of 1st sector on first trackend_sector	dc.w	0read_ctr	dc.w	0		;count of number of sect to read on cur trackfound_ctr	dc.w	0		ORG	trk_ctr* The following overlay the above 10 bytesMu_cmdmode	dc.b	0Mu_unitnum	dc.b	0		dc.b	0Mu_blk_num	dc.w	0		dc.w	0Mu_blk_cnt	dc.w	0		dc.b	0		ORGmulti_err	dc.w	0		;temp to record Bad ending Block errorCn00		dc.w	0		;gets $Cs00 Slotx16		dc.w	0		;gets $00s0 SlotsReg	dc.w	0		;saves copy of sltromsel register ($C02D);-----------------------------------; GCR DATA TABLES FOR RDADDRs;-----------------------------------		export	DATAMARKS		export	BSLIP1		export	BSLIP2		export	ADRMARKSADRMARKS	DC.B	$96,$AA,$D5		DATAMARKS       DC.B    $AD,$AA,$D5BSMARKS         DC.B    $FFBSLIP2		DC.B	$AABSLIP1		DC.B	$DE		eject******************************************************************	Following are the parameter lists used by the*	BANK $00 CORE DISPATCHER when calling a SmartPort* 	interface.******************************************************************* The following is the parameter list for a unit 0 status call* to the SmartPort.  This is used to determine the number of* devices logically connected to SmartPort.******************************************************************		export	unit0_statunit0_stat	dc.b	$40		; extended status call		dc.l	unit0_plist	; pointer to parameter listunit0_plist	dc.b	3		; parameter count		dc.b	0		; unit number		dc.l	unit0_slist	; pointer to status list		dc.b	0		; status code		export	unit0_slistunit0_slist	dc.b	0		; number of units		dc.b	0		; interrupt status		dc.b	0		; vendor ID		dc.b	0		; reserved		dc.l	0		; native mode entry point******************************************************************* The following is the parameter list for a unit N status call* to the SmartPort.  This is used to determine characteristics* of the SmartPort device.******************************************************************		export	dib_statdib_stat	dc.b	$40		; extended status call		dc.l	dib_plist	; pointer to parameter listdib_plist	dc.b	3		; parameter count		export	dib_unitdib_unit	dc.b	0		; unit number		dc.l	dib_slist	; pointer to status list		dc.b	3		; status code		export	dib_slist		export	dib_blkcntdib_slist	dc.b	0		; General status bytedib_blkcnt	dc.l	0		; Block count		dc.b	0		; ID string length		dc.b	'0123'		; ID string		dc.b	'4567'				dc.b	'89AB'				dc.b	'CDEF'				export	sp_typesp_type		dc.b	0		; SmartPort Type		export	sp_subtypesp_subtype	dc.b	0		; SmartPort Subtype		export	sp_versionsp_version	dc.w	0		; SmartPort Version******************************************************************* The following parameter list is used to set the number of* sides for the current online media in preperation for a* subsequent format call.******************************************************************		export	set_sidesset_sides	dc.b	$44		; control call		dc.l	sides_plist	; parameter list pointersides_plist	dc.b	3		; parameter count		export	sides_unitsides_unit	dc.b	0		; unit number		dc.l	sides_list	; control list pointer		dc.b	$09		; control codesides_list	dc.w	1		; count word		export	sides_cntsides_cnt	dc.w	0		; number of sides to set******************************************************************* The following parameter list is used to set the interleave* for the current online media in preperation for a subsequent* format call.******************************************************************		export	set_intlvset_intlv	dc.b	$44		; control call		dc.l	ilv_plist	; parameter list pointerilv_plist	dc.b	3		; parameter count		export	ilv_unitilv_unit	dc.b	0		; unit number		dc.l	intlv_list	; control list pointer		dc.b	$0A		; control codeintlv_list	dc.w	1		; count word		export	intlvintlv		dc.w	2		; interleave value******************************************************************* The following is the parameter list used to set the interleave* to 4:1 on Shutdown.******************************************************************		export	clr_interleave		export	clr_intlv_unitclr_interleave	dc.b	$44		; extended control call		dc.l	@plist		; pointer to parameter list@plist		dc.b	3		; parameter countclr_intlv_unit	dc.b	0		; unit number		dc.l	@list		; pointer to control list		dc.b	$0A		; control code@list		dc.w	1		; count byte		dc.b	4		; interleave		export	set_fmt_option		export	set_fmt_unit		export	set_fmt_optset_fmt_option	dc.b	$4A		dc.l	@plist	@plist		dc.b	3set_fmt_unit	dc.b	0		;unit number		dc.l	@plist		dc.w	2@plistset_fmt_opt	dc.w	0		dc.w	0****************************************************************** The following is the parameter list used to read a block*****************************************************************		export	blockread_listblockread_list	dc.b	$41		; extended control call		dc.l	blockrd_plist	; pointer to parameter listblockrd_plist	dc.b	3		; parameter count		export	blockrd_unitblockrd_unit	dc.b	0		; unit number		export	blockrd_bufblockrd_buf	dc.l	0		; pointer to buffer		export	blockrd_blkblockrd_blk	dc.l	0		; block address		****************************************************************** The following is the parameter list used to write a block*****************************************************************		export	blockwrite_listblockwrite_list	dc.b	$42		; extended control call		dc.l	blockwr_plist	; pointer to parameter listblockwr_plist	dc.b	3		; parameter count		export	blockwr_unitblockwr_unit	dc.b	0		; unit number		export	blockwr_bufblockwr_buf	dc.l	0		; pointer to buffer		export	blockwr_blkblockwr_blk	dc.l	0		; block address****************************************************************** The following is the parameter list used to read a MAC block*****************************************************************		export	readbyts_list		export	rdbyts_unit		export	rdbyts_buf		export	rdbyts_count		export	rdbyts_blkreadbyts_list	dc.b	$48		; extended readbytes call		dc.l	rdbyts_plist	; pointer to parameter listrdbyts_plist	dc.b	4		; parameter countrdbyts_unit	dc.b	0		; unit numberrdbyts_buf	dc.l	0		; pointer to bufferrdbyts_count	dc.w	0		; count of bytes to readrdbyts_blk	dc.l	0		; block address		****************************************************************** The following is the parameter list used to write a MAC block*****************************************************************		export	writbyts_list		export	wrbyts_blk		export	wrbyts_buf		export	wrbyts_count		export	wrbyts_unitwritbyts_list	dc.b	$49		; extended writebytes call		dc.l	wrbyts_plist	; pointer to parameter listwrbyts_plist	dc.b	4		; parameter countwrbyts_unit	dc.b	0		; unit numberwrbyts_buf	dc.l	0		; pointer to bufferwrbyts_count	dc.w	0		; count of bytes to readwrbyts_blk	dc.l	0		; block address		eject	******************************************************************* The following is the parameter list used to set the hooks.* Hook reference numbers are as follows:**	$00	Main entry hook (not published)*	$01	Read address field*	$02	Read data field*	$03	Write data field*	$04	Seek*	$05	Format disk*	$06	Write track*	$07	Verify track******************************************************************		export	sethook_listsethook_list	dc.b	$44		; extended control call		dc.l	sethook_plist	; pointer to parameter listsethook_plist	dc.b	3		; parameter count		export	sethook_unitsethook_unit	dc.b	0		; unit number		dc.l	hook_list	; pointer to hook list		dc.b	5		; control code = set hook		export	hook_listhook_list	dc.w	4		; count word		export	hook_refhook_ref	dc.b	0		; hook reference number		export	hook_addrhook_addr	dc.l	0		; new hook address				******************************************************************* The following is the parameter list used to reset the hooks******************************************************************		export	resethook_listresethook_list	dc.b	$44		; extended control call		dc.l	resethook_plist	; pointer to parameter listresethook_plist	dc.b	3		; parameter count		export	resethook_unitresethook_unit	dc.b	0		; unit number		dc.l	rsthook_list	; pointer to hook list		dc.b	6		; control code = set hook		export	rsthook_listrsthook_list	dc.w	4		; count word		export	rsthook_refrsthook_ref	dc.b	0		; hook reference number************************************************************************ This parameter list is used to do a SetAdrs call to UCIC***********************************************************************		export	setAdrs_listsetAdrs_list	dc.b	$44		; extended control call		dc.l	@plist		; pointer to parameter list@plist		dc.b	3		; parameter count		export	setAdrs_unitsetAdrs_unit	dc.b	0		; unit number		dc.l	@data		; pointer to setAdrs list		dc.b	16		; control code = set setAdrs@data		dc.w	2		; count word		export	setAdrs_addrsetAdrs_addr	dc.w	0		; download/execute address				************************************************************************ This parameter list is used for the DownLoad call to UCIC***********************************************************************		export	dnLoad_listdnLoad_list	dc.b	$44		; extended control call		dc.l	@plist		; pointer to parameter list@plist		dc.b	3		; parameter count		export	dnLoad_unitdnLoad_unit	dc.b	0		; unit number		dc.l	@data		; pointer to dnLoad list		dc.b	17		; control code = DownLoad@data		dc.w	7		; byte word		longa	off		lda	#$FF		;		export	dibXflag_adrsdibXflag_adrs	sta	>dib1acc_flag		rts		longa	on************************************************************************ This parameter list is used for the DownLoad call to UCIC when* nullifying the original DownLoad.***********************************************************************		export	dnLoad_list2dnLoad_list2	dc.b	$44		; extended control call		dc.l	@plist		; pointer to parameter list@plist		dc.b	3		; parameter count		export	dnLoad_unit2dnLoad_unit2	dc.b	0		; unit number		dc.l	@data		; pointer to dnLoad list		dc.b	17		; control code = DownLoad@data		dc.w	1		; byte word		rts	if 0	then**********************************************************************				export	dnLd_listdnLd_list	dc.b	$44		; extended control call		dc.l	@plist		; pointer to parameter list@plist		dc.b	3		; parameter count		export	dnLd_unitdnLd_unit	dc.b	0		; unit number		export	dnLd_dataPtrdnLd_dataPtr	dc.l	MediaChk	; pointer to dnLoad list		dc.b	17		; control code = DownLoad	endif************************************************************************	Read Disk Switch Status with phantom unit number status call***********************************************************************		export	dsw_statdsw_stat	dc.b	$40		; extended status call		dc.l	@plist		; pointer to parameter list@plist		dc.b	3		; parameter count		export	dsw_unitdsw_unit	dc.b	0		; unit number		dc.l	dsw_slist	; pointer to status list		dc.b	0		; status code		export	dsw_slistdsw_slist	dc.b	0		; General status byte		dc.l	0		; Block count					endp