		String	AsIs				Print	off		Include	'Max.Macros'			Include	'Common.equ.src'		Include	'driver.equ.src'		Include	'hw.equ.src'		Print	on				eject		include 'AD3.5.revhist'		eject	if &TYPE('VERSION6X') = 'UNDEFINED' thenVERSION6X	EQU	1	endif;---------------------------------------------------------; GS & Driver Equates;---------------------------------------------------------tool_locator 	equ	$E10000		; Tool locator entry pointbank1_org	equ	$01BC00		; address of by bank1 segmentmac_flag	equ	$0F51		; Mac block read/write flagbuf1		equ	$0C00		; Three work buffers for data off diskbuf2		equ	$0D00		;buf3		equ	$0E00		;cmdbuffl	equ	$42		;refed in the Mergeit patchrtl_addr	equ	$C59C		; rtl instruction in bank $FFread_data	equ	$FF6244		; disk 3.5 driver read data routinetry_more	equ	$FF59C7		; read retry code in romsbset		equ	$FF5A1C		; return point back into rom coderd_hook		equ	$E10F77		; Read data hook routinevector_hook	equ	$E10FA7		; main firmware dispatcherjmp_inst	equ	$5C		; jump long instructioncmdid		equ	$00005A		; firmware internal unitid1		equ	$E10F20		; internal internal unit for drive #1id2		equ	$E10F21		; internal internal unit for drive #2dib_hw_unit	equ	$004A		; (w)  Hardware reference unitdib_acc_flag	equ	$004C		; (w)  external access detect flag dib_fmt_optn	equ	$004E		; (w)  last selected format optiondib_last_sts	equ	$0050		; (w)  last status call result worddib_En_save	equ	$0052		; (l)  save temp 4 CYA, SLTROM, DISKREG, spareg_dispatch	equ	$01FC84		; call generated driver core	if Version6X	then;;;current_version equ	$5030		; version for System 6 diskcurrent_version	equ	$5040		; version for 6.0.1 (2-Apr-93 SS)	elsecurrent_version	equ	$4000		; current device version	endif;----------------------------------------;    VARIOUS READ CONSTANTS;----------------------------------------TK0Wait		equ	7recaltrks	equ	80amtout		equ	1950readto		equ	25maxseeks	equ	4skrclthrsh	equ	2inmupwait	equ	500/2stdmupwait	equ	100/2;-----------------------------------------------;      REDEFINE IWM HARDWARE EQUATES;-----------------------------------------------IWM		EQU	ph0off+$60CA0CLR          EQU     IWM+0CA0SET          EQU     IWM+1CA1CLR          EQU     IWM+2CA1SET          EQU     IWM+3CA2CLR          EQU     IWM+4CA2SET          EQU     IWM+5LSTRBCLR        EQU     IWM+6LSTRBSET        EQU     IWM+7DESELECT        EQU     IWM+8SELECT          EQU     IWM+9ENABLE1         EQU     IWM+10ENABLE2         EQU     IWM+11          L6CLR           EQU     IWM+12          L6SET           EQU     IWM+13          L7CLR           EQU     IWM+14          L7SET           EQU     IWM+15          ** AppleDisk 3.5 Drive Control Constants*DIRINADR        EQU     0               ;0 -> /DIRTN : set dir inDIROUTADR       EQU     1               ;1 -> /DIRTN : set dir outREAD0ADR        EQU     1               ;Read data head 0READ1ADR        EQU     3               ;Read data head 1STEP0ADR        EQU     4               ;0 -> /STEP : step a trackSTEP1ADR        EQU     5               ;1 -> /STEPMTRONADR        EQU     8               ;/MOTORONMTROFFADR       EQU     9EJCTADR         EQU     12              ;0   -> Read disk ejected latchEJECT1ADR       EQU     13              ;1 -> /EJECT : eject the diskDIPADR          EQU     2               ;/CSTIN : sense disk in placeWPROTADR        EQU     6               ;/WRTPRT : sense write protectTK0ADR          EQU     10              ;/TK0 : sense recal posnTACHADR         EQU     14              ;/TACH : sense motor speedSIDESADR        EQU     9               ;SIDES : sense single/dual headDRVXSTADR       EQU     13              ;/DRVIN : sense if a drive is thereREADYADR        EQU     11              ;/READY : ready to read or writeEJCT_RESET      EQU     $03             ; reset disk ejected bit;-----------------------------------------------; GS/OS ZERO PAGE OVERLAY EQUATES;-----------------------------------------------;CSUM            EQU	drvr_tran_cnt	;overlayed during Sector/Track readCSUMC           EQU	CSUM+1CSUMB           EQU	CSUM+2CSUMA           EQU	CSUM+3;EXINDEX         EQU	drvr_call_num	;overlayed during Sector/Track readEXINDEX2        EQU	EXINDEX+1	;dispatcher restores these bytes  drvr_buf2_ptr	EQU	drvr_cach_ptr	;overlayed during Sector/Track read;*********************************************************************** Mustang FDHD controller card equates**********************************************************************NuM_CalcBlks	EQU	$0DNuM_ReadNBlks	EQU	$0Ec8_cmd_msg	EQU	$00C800c8_reply	EQU	$00C801c8_parms	equ	$00C802c8_xfr_cnt	EQU	$00C80Bc8_error	EQU	$00C856cA_rcount	EQU	$00CA00 ;reply count for multi_blk readcA_rtable	EQU	$00CA02	;reply vector for multi_blk readHDChk_Org	EQU	$7800******************************************************************  ERROR CODE values for Direct Read Segment *WSERROR       	EQU     $20             ;Wrong Sector # errorDCSERROR        EQU     $10             ;Data Field Checksum errorDBSERROR        EQU     $08             ;Data Field Bitslip errorTOERROR         EQU     $04             ;No Data Field ErrorSFTSKERROR	EQU	$04		;Seek found wrong cylinderSEEKERR		EQU	$02		;NO Seek cmd reply from driveADRERROR	EQU	$20		;Adrs Mark Error****************************************************************;-----------------------------------------------;	BEGIN MAIN CODE SEGMENT;-----------------------------------------------;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		entry	access_detect		entry	check_access		entry	close		entry	conf1		entry	conf2		entry	control		entry	dib_1		entry	dib_2		entry	dispatch		entry	flush		entry	format		entry	format1		entry	fixup_blkcnt		entry	reset_sts_dsw		entry	get_format		entry	open		entry	read		entry	set_format		entry	set_hook		entry	set_option		entry	shutdn		entry	startup		entry	status		entry	write		entry	c2_dev_stat		entry	next_blk_ptr		entry	read_dsw_status		entry	set_iwm_mode		entry	seek		entry	motoron		entry	wait_rdy_to		entry	read_bit		entry	writebit		entry	phases_off		entry	enable_slot6		entry	restore_slot6		entry	Iff_set_mode		entry	enable_sense		entry	cache_to_buff		entry	buff_to_cache		entry	do_sp_readblk		entry	do_sp_writeblk		entry	setup_sp_call		entry	bank1_code		entry	beg_bank1		entry	end_bank1;----------------------------------------------------------------		include 'AD3.5.data'		include	'AD3.5.main'		include 'AD3.5.cmds'		print	on		include 'AD3.5.read'		include 'AD3.5.drivsubs'		print	on;----------------------------------------------------------------;  BEGIN Bank $01 code segment;----------------------------------------------------------------		include	'AD3.5.directRD'				end					