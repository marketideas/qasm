		eject******************************************************************* DRIVER CALL:  OPEN** This call has no application with block device drivers and will* return with no error.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	open		open		proc					;using   driver_data		longa	on		longi	on		lda	#no_error		clc		rts		endp		eject******************************************************************* DRIVER CALL:  WRITE** This call executes a write to the device.  Block devices must* validate the initial block number and that the request count is* an integral multiple of the block size.  In addition the block* number of each successive block must be validated as it is* accessed when an multiple block I/O transaction is in place.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*       <drvr_buf_ptr = Pointer to I/O buffer*       <drvr_blk_num = Initial block number*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_blk_size = Size of block to be accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = 0=m=x=e*                       Carry = 1 if error occured*                       Carry = 0 if no error occured******************************************************************		export	write		write		proc					;using   driver_data		longa	on		longi	on		jsr	check_access	; did dispatch signal a fake DSW error?		bcs	write_exit	; yes		lda	drvr_req_cnt+2		ora	drvr_req_cnt	;req count zero? (A = no_error)		clc		beq	write_exit		lda	<drvr_blk_size	; validate the current block size		cmp	#$0200		beq	chk_multi		cmp	#$020C		beq	chk_multiplebad_parm	lda	#drvr_bad_parm	; invalid block size		sec		rts** Now call Int Math Toolset to do req_cnt DIV 524*chk_multiple		ldx	<drvr_req_cnt+2			bmi	bad_parm	;I don't do negative request counts for 524		lda	#0		pha		pha		pha		pha		phx		pei	<drvr_req_cnt		pha		pei	<drvr_blk_size		_LongDivide		;call int math for the remainder		pla			;discard quot		pla		pla			;get remainder		ora	1,s		;get hi & lo word together in A		plx		tax			;is remainder zero?		beq	do_write	;yes...bad_count	lda	#drvr_bad_count	; invalid byte count		sec		rts** Now see if the request count is an even multiple of the block size* (block size of $0200 is much easier to perform a MOD operation on!)*chk_multi	lda	<drvr_req_cnt		and	#$01FF		bne	bad_count	;insist req_cnt is divisible by 512		eject** The following routine is executed for write calls* directed toward class 2 block devices.*do_write		clc			; specify block search		jsl	cache_find_blk	; is the block in the cache?		bcc	wr_cache	; yes, xfer from buf to cache		lda	<drvr_cache	; add to cache?		beq	wr_dev		; no		jsl	cache_add_blk	; else add block to cache		bcs	wr_dev		; if block was not allocatedwr_cache		jsl	buff_to_cache	; yes, read block from cache to buffer		bit	<drvr_cache	; deferred mode?		bmi	wr_done		; yes, dont xfer to devicewr_dev		jsr	do_sp_writeblk	; write through to the device		bcs	write_exit	; if device returned errorwr_done				; 		jsr	next_blk_ptr	; set next block address & test if more		bcc	do_write	; if more blocks to write		clc			; all done with no errors		lda	#no_errorwrite_exit		rts		eject******************************************************************* The following routine executes a writeblock to the SmartPort* device.** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Same as program bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x x  0** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x 0  0 if no error*                       x x 0 0 0 x x 1  0 if error******************************************************************		export	do_sp_writeblkdo_sp_writeblk		jsr	setup_sp_call	; setup SmartPort call parameters		ldy	#dib_last_sts	;was media offline last time?		lda	[drvr_dib_ptr],y		and	#%10000				beq	@doStatus	;offline so do Status to get blockcount		ldy	#blk_cnt		lda	[drvr_dib_ptr],y		bne	@doWrite@doStatus	jsr	Fixup_blkcnt	;go do DevStat to see if blockcount is known			bcs	@dswErr		;status returned disk switch so ERROR the Read		@doWrite	lda	<drvr_dev_num	; device number to read		ldx	<drvr_blk_size	;which block size to do?		cpx	#$020C		;a mac write?		ldx	#blockwrite_list		bcc	@10		;NO.		ldx	#writbyts_list	;yes.@10		jsl	to_b0_core@dswErr		rts		endp		eject******************************************************************* DRIVER CALL:  CLOSE** This call has no application with block devices and will* return with no error.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	close		close		proc					;using   driver_data		longa	on		longi	on		lda	#no_error		clc		rts		endp		eject******************************************************************* DRIVER CALL:  STATUS** This routine supports all the standard device status calls.* Any status call which is able to detect an OFFLINE or DISK* SWITCHED condition should call the system service routine* SET_DISKSW.  OFFLINE and DISKSW are conditions and not errors* when detected by a status call and should only be returned as* conditions in the status list.** Status Code:  $0000   Return Device Status*               $0001   Return Control Parameters*               $0002   Return Wait/No Wait Mode*               $0003   Return Format Options** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	status		status		proc					;using   driver_data		longa	on		longi	on		lda	<drvr_stat_code	; is this a get_format_options call?		cmp	#drvr_get_format		beq	get_format	; yes		jsr	check_access	; did an access occur?		ror	|pre_check	; save it				jsl	g_dispatch	; pass call on to generic driver		bcs	not_dev_stat	; if error, history cant be updated		lda	<drvr_stat_code	; is this a return from device status?		bne	not_dev_stat	; no		* On return from a device status call, only the first offline and disk switch* status should be returned while the media remains offline.  Subsequent status* calls with the media offline should return only the offline and omit the* disk switched status.*		lda	[<drvr_slist_ptr]		and	#$0001				beq	@05		;no* only reset dsw for the internal SmartPort		bit	ext_slot		bmi	@05* only do the drive ejected latch reset for ROM 0001		lda	|rom_version		cmp	#$0002		bge	@05* for old rom only reset the drive latch		jsr	reset_sts_dsw	;clear drive dsw bit** If a direct firmware access occured then fake a disk switched.*@05		rol	|pre_check	; did an access occur?		bcc	@10		; no, continue with history check		lda	[<drvr_slist_ptr]		ora	#$0001		; yes, simulate a disk switched		sta	[<drvr_slist_ptr]*@10		ldy	#dib_last_sts		lda	[drvr_slist_ptr]	;get status result word		sta	[drvr_dib_ptr],y	;save this for online test		lda	#no_error		clcnot_dev_stat				rts********************************************************************************************************************************************		export	reset_sts_dswreset_sts_dsw	SEP	#$30		longa	off		longi	off		jsr	enable_slot6		jsr	phases_off		ldy	#%00001111		jsr	IFf_set_mode		lda	>select		;reselect in case set_iwm_mode worked		jsr	enable_sense		bcc	@10		;drive ejected bit is not set		bpl	@10		;was just offline not dsw		lda	#ejct_reset		jsr	writebit 	;clear the drive ejected latch@10		lda	#00		sta	>diskreg	;deactivate /EN35 to cancel drive timer		nop		nop		nop		sta	>deselect	;now turn off the drive enable 		jsr	phases_off		jsr	restore_slot6		longa	on		longi	on		REP	#$30		rts		eject******************************************************************* This routine returns the format options for the device.* Consult the driver specification for the format option list.* This call requires a minimum request count of $00000002.  The* maximum request count may exceed the size of the format list* in which case the request count returned will indicate the* size of the format list.** ENTRY: via a 'JSR'*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	get_formatget_format		longa	on		longi	on		lda	#drvr_bad_parm	; assume invalid request count		ldx	<drvr_req_cnt+2	; and validate request count		bne	bad_get_format		ldx	<drvr_req_cnt		cpx	#$0002		bge	ok_get_formatbad_get_format		sec		rts** Request count is valid. Return the format options for this device.*ok_get_format	bit	ext_slot	; Internal device?		bpl	@doInternal*** changed 25-Mar-93 DAL to return useful information in small buffers for FDHDs***   The book says we can return $22 (g_dispatch is returning no error).***   For compatibility, I'm electing to return partial information rather***   than return an error (the book says we can do that, too).;;;		jsr	g_dispatch;;;		bcs	@doInternal	;use internal table if external fails;;;		rts		pei	<drvr_req_cnt		pei	<drvr_slist_ptr+2		pei	<drvr_slist_ptr		lda	#$0080		sta	<drvr_req_cnt		lda	#^kludgeBuffer		sta	<drvr_slist_ptr+2		lda	#kludgeBuffer		sta	<drvr_slist_ptr		jsr	g_dispatch		pla		sta	<drvr_slist_ptr		pla		sta	<drvr_slist_ptr+2		pla		sta	<drvr_req_cnt		bcs	@doInternal*** Figure out what the *real* transfer count is (8 + numFormats*16)		lda	kludgeBuffer		asl	a		asl	a		asl	a		asl	a		adc	#8		cmp	<drvr_req_cnt	; is request longer then list length?		bge	@req_count_ok		sta	<drvr_req_cnt@req_count_ok*** Copy as much data as we can into the user's real buffer		pea	kludgeBuffer>>16		pea	kludgeBuffer		pei	<drvr_slist_ptr+2		pei	<drvr_slist_ptr		pea	0		pei	<drvr_req_cnt		pea	$0805		;move_sinc_dinc		jsl	move_info		lda	<drvr_req_cnt	;already doctored up as necessary		sta	<drvr_tran_cnt		clc		rts*** end 25-Mar-93@doInternal	ldy	#dib_hw_unit	; internal device #		lda	[<drvr_dib_ptr],y		dec	a		asl	a		tax		lda	|format_tbl,x	; get pointer to format option list		tax		lda	|0,x		; get # entries in option list		asl	a		; list length = (n * 16) + 8		asl	a		asl	a		asl	a		clc		adc	#$0008		; now have option list length		cmp	<drvr_req_cnt	; is request longer then list length?		bge	req_count_ok		sta	<drvr_req_cntreq_count_ok				; 		ldy	#$0000		; status list index		sep	#$20		; 8 bit 'm'		longa	offcopy_format				; 		lda	|0,x		; copy format option list to slist_ptr		sta	[<drvr_slist_ptr],y		inx		iny		cpy	<drvr_req_cnt	; copy = request count size		bne	copy_format		rep	#$20		; 16 bit 'm'		longa	on		export	set_xfer_cntset_xfer_cnt				;               		lda	<drvr_req_cnt	; set transfer count		sta	<drvr_tran_cnt		lda	<drvr_req_cnt+2		sta	<drvr_tran_cnt+2		lda	#no_error	; and return with no error		clc		rtskludgeBuffer	ds.b	$80		;added 25-Mar-93 DAL		endp		eject******************************************************************* DRIVER CALL:  CONTROL** This routine supports all the standard device control calls.** Control Code: $0000   Reset Device*               $0001   Format Device*               $0002   eject Media*               $0003   Set Control Parameters*               $0004   Set Wait/No Wait Mode*               $0005   Set Format Option*               $0006   Assign Partition Owner*               $0007   Arm Signal*               $0008   Disarm Signal** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	control		control		proc					;using   driver_data		longa	on		longi	on** restore original read_data hooks before this call or system will*    use patch incorrectly.*		lda	>rd_hook+4	;restore hook with original		sta	>rd_hook+0		lda	>rd_hook+6		sta	>rd_hook+2		lda	<drvr_stat_code	; is this a set format option call?		cmp	#drvr_set_format		beq	set_format	; yes, go set the interleave or sides		cmp	#drvr_format	; is this a format call?		beq	format		; yes, go do format and restore default		jsl	g_dispatch	; pass call on to generated corecontrol_return				; 		longa	on		longi	on		php			;save error status		pha			;save error code		jsr	set_hook	;put back the patch and exit		pla			;restore error code		plp			;restore error status		rts		eject******************************************************************* This control call sets the format option in preperation for* a subsequent format control call.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	set_formatset_format				;               		longa	on		longi	on		lda	[<drvr_slist_ptr]	;get the format option		bne	@10		lda	#drvr_bad_parm		sec		brl	control_return		;zero is not a valid option@10		ldy	#dib_fmt_optn		sta	[drvr_dib_ptr],y	;save format option in case of fmt error				jsr	set_option		;not called from here with a zero		lda	#no_error		clc		brl	control_return		eject******************************************************************* This control call implements the format call and then restores* the format option to the recomended default as specified in the* format options list.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*     <drvr_clist_ptr = Pointer to control list*     <drvr_ctrl_code = Control code*       <drvr_req_cnt = Number of bytes to be transferred*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	formatformat					;               		longa	on		longi	on		jsr	check_access		; did direct access occur?		bcs	@exit			; yes		jsl	g_dispatch		; pass call on to generated core		pha		php		ldy	#dib_fmt_optn				bcc	@setDflts		;if No error  set default option		cmp	#drvr_disk_sw		;did fmt return disk switched error?		bne	@setDflts		;no so reset to defaults		lda	[drvr_dib_ptr],y	;get last selected option@setDflts	lda	#0000			;tell set_option to restore "defaults"@fmtswitch	sta	[drvr_dib_ptr],y	;clear or save the format option 		jsr	set_option		;reset the "default" options in a card 				plp		bcs	@err			;format failed so can't fix the blkcount		php		jsr	Fixup_blkcnt		;after format reset blkcnt in DIB to match		plp@err		pla@exit					brl	control_return************************************************************************  Update the DIB block count by making a DIB status call**********************************************************************		export	Fixup_blkcntFixup_blkcnt				;		longa	on		longi	on				ldy	#unit_num		lda	[drvr_dib_ptr],y		sep	#$20		; 8 bit 'm'		longa	off		sta	dib_unit	;setup unit number for call		 		rep	#$20		; 16 bit 'm'		longa	on				lda	<drvr_dev_num		ldx	#dib_stat	;extended DIB status call to firmware		jsl	to_b0_core			bcs	@error				lda	dib_slist	;get the status byte		and	#%10111		;is media online?		ldy	#dib_last_sts		sta	[drvr_dib_ptr],y	;save last online status		ldx	#no_error		bit	#%00001		;is the result a disk switched status?		beq	@10		pha* only reset dsw for the internal SmartPort		bit	ext_slot		bmi	@05* only do the drive ejected latch reset for ROM 0001		lda	|rom_version		cmp	#$0002		bge	@05* for old rom only reset the drive latch		jsr	reset_sts_dsw	;clear drive dsw bit@05		pla		ldx	#drvr_disk_sw+$100@10		bit	#$0010		;is media online?		bne	@20		;yes.		lda	#drvr_off_line		bra	@exit		;nope@20		lda	dib_blkcnt	;get blockcount from firmware		beq	@exit		;blank media is online!		ldy	#blk_cnt		sta	[drvr_dib_ptr],y		lda	dib_blkcnt+2		iny		iny		sta	[drvr_dib_ptr],y	;update the block count in the dib@exit		txa		cmp	#no_error+1@error		rts		eject******************************************************************* This call actually sets the number of sides and interleave*  or makes a SetFmtOption call to a Mustang card** ENTRY: via a 'JSR'*               A Reg = Option Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	set_optionset_option				;               		longa	on		longi	on		pha			; save format option		ldy	#unit_num	; set unit number in parameter lists		sep	#$20		; 8 bit 'm'		longa	off		lda	[drvr_dib_ptr],y		sta	sides_unit		sta	ilv_unit		sta	set_fmt_unit		rep	#$20		; 16 bit 'm'		longa	on		pla			; restore option number				bit	ext_slot		bpl	@Internal				sta	set_fmt_opt				ldx	#set_fmt_option		lda	<drvr_dev_num		jsl	to_b0_core	;4-Nov-92 DAL (was jsr, but assembler did jsl anyway)		bcs	@05				ldx	set_fmt_opt	;was this a "defaults" or specific option set?		bne	@05		;specific option so all done* Must now suppress the 800K 4:1 "default" option selection of Mustang card		lda	#0002		sta	intlv		;force 2:1 interleave		lda	#$0080		sta	sides_cnt		bra	@setDeflts	;and double sided@05		rts		@Internal			dec	a		bpl	@10		;zero means set the "default" = 0001		lda	#0001@10		cmp	format1		;(number of entries)		bge	option_error		asl	a		asl	a		tax		lda	|option_xlate,x	; get interleave		sta	|intlv		inx		inx		lda	|option_xlate,x	; get sides		sta	|sides_cnt@setDeflts	lda	<drvr_dev_num		ldx	#set_intlv		jsl	to_b0_core		lda	<drvr_dev_num		ldx	#set_sides		jsl	to_b0_core		lda	#no_error		clc		rtsoption_error				; 		longa	on		longi	on		lda	#drvr_bad_parm		sec		rts		endp		eject******************************************************************* DRIVER CALL:  FLUSH** This call writes any data in the devices internal buffer to* the device.  It should be noted that this is a WAIT MODE call* which is only supported by devices which maintain their own* internal I/O buffer.  Devices that cannot write in NO WAIT mode* do not support this call and will return with no error.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	flush		flush		proc					;using   driver_data		longa	on		longi	on		lda	#no_error		clc		rts		endp		eject******************************************************************* DRIVER CALL:  SHUTDOWN** This call prepares the driver for shutdown.  This may include* closing a character device as well as releasing any and all* system resources that may have been aquired by either a* STARTUP or OPEN call.** ENTRY: via a 'JSR'*       <drvr_dev_num = Device Number of current device being accessed*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*      <drvr_tran_cnt = Number of bytes transferred*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	shutdn		shutdn		proc					;using   driver_data		longa	on		longi	on		sep	#$20		; 8 bit 'm'		longa	off		ldy	#unit_num		lda	[drvr_dib_ptr],y		sta	clr_intlv_unit		sta	set_fmt_unit		rep	#$20		; 16 bit 'm'		longa	on		stz	set_fmt_opt	;reset options to defaults				ldy	#dib_hw_unit		lda	[drvr_dib_ptr],y	;is this 1st drive on a slot?		cmp	#0001		bne	@10				ldy	#slot_num		lda	[drvr_dib_ptr],y		bit	#%1000		;external slot shutdown?		beq	@10		;only do 1 clr_fmt_option per External slot				lda	<drvr_dev_num	; control call to set fmt option to defaults		ldx	#set_fmt_option		jsl	to_b0_core@10		ldy	#slot_num	;are we dealing with a Mustang here?		lda	[<drvr_dib_ptr],y		bit	#$80		;(must be an external slot)		bne	@20		;nope, it's the built-in SmartPort; Since Startup downloaded some code to Mustang to have Mustang store a flag into; the DIB when an external access occurs, we have to nullify the code to ensure; that Mustang doesn't try to write the flag byte into memory that no longer; belongs to us (for example, on a subsequent reboot). {GAB - 1/15/92}		ldy	#unit_num		lda	[drvr_dib_ptr],y ;get SmartPort Unit #		sep	#$20		; 8 bit 'm'		longa	off		sta	setAdrs_unit		sta	dnLoad_unit2		rep	#$20		; 16 bit 'm'		longa	on		asl	a		tax		lda	dwnldAdrs-2,x		sta	setAdrs_addr	;fill in the adrs for this unit		lda	<drvr_dev_num	;device number		ldx	#setAdrs_list		jsl	to_b0_core		bcs	@exit		lda	<drvr_dev_num	;device number		ldx	#dnLoad_list2		jsl	to_b0_core	;download the 'rts' to the card's "ROM"@exit@20		dec	|device_count	; number of appledisk3.5's online		bne	not_last				lda	dib1_slot	;1st dib always used but may be external		and	#%1000		;internal slot?		bne	@80** Set default Internal firmware interleave to 4:1.*		lda	<drvr_dev_num	; control call to clr interleave (to 4:1)		ldx	#clr_interleave		jsl	to_b0_core** Remove the merge patch for Internal SmartPort ONLY*		sep	#$20		; 8 bit 'm'		longa	off		ldy	#unit_num		lda	[<drvr_dib_ptr],y		sta	|resethook_unit		lda	#$02		; hook refernece is for read data		sta	|rsthook_ref		rep	#$20		; 16 bit 'm'		longa	on		lda	<drvr_dev_num	; device number to read		ldx	#resethook_list		jsl	to_b0_core** Remove the access detection patch for Internal SmartPort ONLY		sep	#$20		; 8 bit 'm'		longa	off		lda	#$08		; hook refernece is for main entry		sta	|rsthook_ref		stz	dib_unit	;reset 8-bit unit # to zero		rep	#$20		; 16 bit 'm'		longa	on		lda	<drvr_dev_num	; device number to read		ldx	#resethook_list		jsl	to_b0_core** Now clear the startup variables to make driver restartable from memory@80		stz	device_count		stz	dib1acc_flag		stz	dib2acc_flag		stz	dib3acc_flag		stz	dib4acc_flag		stz	dib5acc_flag		stz	dib6acc_flag		stz	dib7acc_flag		stz	dib8acc_flag		stz	slot_count		stz	last_slot		stz	last_drive				lda	#no_error	; no error if all shutdown		clc		rtsnot_last				; 		lda	#drvr_busy	; else return busy		sec		rts		endp