		eject******************************************************************* DRIVER MAIN entry POINT: DISPATCH** This is the main entry point for the device driver.  The* routine validates the call number prior to dispatching to* the requested function.** Call Number:  $0000   Function: Startup*               $0001             Open*               $0002             Read*               $0003             Write*               $0004             Close*               $0005             Status*               $0006             Control*               $0007             Flush*               $0008             Shutdown*               $0009-$FFFF       Reserved** ENTRY: Call via 'JSL'*     [<drvr_dib_ptr] = Points to the DIB for the device being accessed*       <drvr_dev_num = Device number of device being accessed*      <drvr_call_num = Call number*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT:   Direct page = unchanged with the exception of <drvr_tran_cnt*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	dispatch	dispatch	proc						;using   driver_data		longa	on		longi	on		phb			; save environment		phk		plb		cmp	#max_command	; is it a legal command?		bge	illegal_req	; no		ldx	#$0000save_parms				; 		lda	<drvr_dev_num,x	; save GS/OS call parameters		pha		lda	<drvr_blk_num,x		pha		inx		inx		cpx	#$000C		; up to but not including DRVR_TRAN_CNT		bne	save_parms		lda	<drvr_call_num	; is this a startup call?		beq	continue	; yes				ldy	#slot_num	;set the int_slot flag		lda	[<drvr_dib_ptr],y		and	#%1000		; 		beq	@10		; 0 for internal slot 5		lda	#-1		;-1 for external slot N@10		sta	ext_slot	;record if this call's slot is external		jsr	check_access	; did external access occur?		bcc	continue	; no		jsl	set_disksw	; mark the VCRs and flush cache		jsr	set_hook	; reinstall our patchescontinue				; 		lda	<drvr_call_num	; restore command #		pea	func_ret-1	; return address from function		asl	a		; make index to dispatch table		tax		lda	|dispatch_table,x		pha			; push function address for dispatch		rts			; rts dispatches to function** Must clear the access flag on the way out so that any direct* access to an AppleDisk3.5 drive can be detected.*func_ret				; 		php		pha				; save error code		bcc	@80			;no error		cmp	#drvr_disk_sw+$100	;returning with pseudo disk_sw from Fixup?		bne	@10		pla		pea	#drvr_disk_sw		;convert pseudo to read dsw		bra	@80@10		cmp	#drvr_disk_sw		;is this a REAL disk switched ERROR ?		bne	@80			;no.* when firmware gives a disk_sw then go try to get blk count				jsr	Fixup_blkcnt		;go try to get a new blockcount in DIB		@80		ldy	#dib_acc_flag		lda	#00		sta	[<drvr_dib_ptr],y	;clear the access flag		ply				; this is the error code		plp		ldx	#$000A		; number of words to restorerestore_parms			pla			; restore GS/OS call parameters		sta	<drvr_blk_num,x		pla		sta	<drvr_dev_num,x		dex		dex		bpl	restore_parms		plb		bcs	gen_exit	; force error code 0 if flag cleared		ldy	#no_errorgen_exit				; 		tya			; restore error code		rtl** Received an illegal request.  Return with an error.*illegal_req				; 		plb			; restore environement		lda	#drvr_bad_req	; set error		sec		rtl		eject******************************************************************* CHECK_ACCESS** This routine is called by various driver functions to determine* if an invalid external access has occured.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		export	check_accesscheck_access				;               		longa	on		longi	on		phy		clc		ldy	#dib_acc_flag		; determine if this unit was accessed		lda	[<drvr_dib_ptr],y		beq	check_done		; if no direct access ocurred		lda	#drvr_disk_sw+$100		; then return a disk switch error		seccheck_done	ply		rts		endp		eject******************************************************************* DRIVER CALL:  STARTUP** This routine must prepare the driver to accept all other driver* calls.** ENTRY: Call via 'JSR'*     [<drvr_dib_ptr] = Points to the DIB for the device being accessed*       <drvr_dev_num = Device number of device being accessed*      <drvr_call_num = Call number*      <drvr_tran_cnt = $00000000*               A Reg = Call Number*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as program bank*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x 0  0   No error occured*                       x x 0 0 0 0 x 1  0   Error occured******************************************************************		longa	on		longi	on		export	startup		startup		proc		php** Check ROM version number.		lda	#$0000		pha			; space for result		pha		pha		pha		pha			; A Reg on call		pha			; X Reg on call		pha			; Y Reg on call		pea	$FE1F		; call monitor id routine		_fwentry		ply		plx		pla		pla		plp		sty	|rom_version	; save version for conditional patches*****				lda	last_drive		lda	slot_count		lda	last_slot	;last_slot must be zeroed by ShutDown!		beq	@1stTime		bpl	@scanSlots		brl	no_drive_exit	;negative last_slot mean I tried em all@1stTime	lda	#05		;start with Internal slot 5		sta	last_slot		stz	last_drive		stz	device_count		stz	slot_count		lda	#' A'		sta	name_char	;start device names at ...A**  copy the code to bank 1 on the assumption Internal S5 in use		jsr	copy_to_bank1@scanSlots	** setup Y with contents of slots reg		sep	#$20		; 8 bit 'm'		longa	off		lda	>sltromsel	; need slot internal/external		sta	SlotsReg		rep	#$20		; 16 bit 'm'		longa	on				inc	last_drive	;= 1,2,3		lda	last_drive		cmp	#0002		;is this 1st drive for a slot?		bcc	@chkSlot	;< must be a 1		beq	do_2nd_drive	;already checkd the slot 		lda	#0001				sta	last_drive	;back to drive 1 for next slot		jsr	nextSlot	;move last_slot to next candidate** now check the for internal vs external tests@chkSlot	lda	last_slot		bit	#%1000		bne	check_extslots** now check for Slot 5 set to internal! (since slot 5 is the only internal one)		lda	SlotsReg	; bug fix 09/24/91 JOA		and	#$0020		; is slot 5 set for external?		bne	@do_S5_ext	; yes!. so go see if its a SmartPort card** The following 3 lines were added in version 4.1a02. (locks out ROM 0, I think)		lda	>$00C5FB	; is extended supported by this ROM?		and	#$0080		bne	do_a_Slot	; require GS ROM with Extended SmartPort Firmware		@do_S5_ext	lda	#0005+8		;switch to slot 5 external		sta	last_slotcheck_extslots	jsr	is_XSP_slot	;is this a slot with Extended & Addnl SmartPort		beq	do_a_slot	;yep.next_Slot	jsr	nextslot	;move last_slot to the next possible one		bpl	check_extslots	;more slots to checkno_drive_exit	lda	#drvr_no_dev	;assume I found at least 1 slot to use		ldx	slot_count	;did I find anything?		bne	@exit		;yep** Either this is ROM 00 or this system has zero 3.5 drives		lda	#drvr_io_error	;cause the entire Driver to be removed!@exit		sec		rts** Need to determine if any AppleDisk3.5 devices are connected to* the slot's controller.  Get number of devices and walk its chain.do_a_slot	stz	slot_units	;assmue no units attached to controller card		stz	unit0_slist	;zero the slot's unit count		stz	unit0_slist+2	;zero the vendor ID too		sep	#$20		; 8-bit m		longa	off		stz	dib_unit	;zero dib_unit.b		rep	#$20		; 16-bit m		longa	on		jsr	Fillin_dib	;fillin the dib stuff for Unit0 Status call** Get device count by making Unit Zero status call		lda	<drvr_dev_num		ldx	#unit0_stat		jsl	to_b0_core	;returns error code in A		bcc	@10		rts@10		lda	|unit0_slist	; any devices in this slot?		and	#$007F		;(16-bit fetch above of 8 bit item)		beq	next_slot	; no. see if any other slots have SP firmware		sta	slot_units		inc	slot_count	; cnt number of slots with SmartPort		lda	slot_count		cmp	#05		;have I found 4 slots of SmartPorts?		bcs	no_drive_exit	;how'd I get more than 8 dib startup calls?!??				bra	do_a_drivedo_2nd_drive	jsr	Fillin_dib	;fillin the dib stuff for Smartport calls** Devices are connected to the SmartPort device chain.  Find the* first 3.5 drive starting with the next unit number and continue* unitl the end of the chain if neccessary.do_a_drive:		inc	dib_unit	; next SmartPort Unit to check (16-bit INC of 8 bit item!!)		lda	dib_unit	; is unit # valid? (16-bit fetch of 8 bit item!)		and	#$007F		; drop the extra byte		cmp	slot_units	;have I scanned all the units yet?		bcc	call_ok		; no.		beq	call_ok		; no.		lda	last_drive	; yes. 		cmp	#0001		;still looking for 1st drive in this slot?		bne	no_drive_exit	; 1st unit (drive) found for previous dib startup		dec	slot_count	; un count this slot since no AD35 drives found		bra	next_Slot	; this slot doesn't have any AD3.5 drives!*		call_ok				lda	<drvr_dev_num	; make dib status call to see if 		ldx	#dib_stat	; this unit is an AD3.5 or SuperDrive		stz	sp_type		; trash previous device type result		jsl	to_b0_core		bcs	do_a_drive	; check next unit if error		lda	sp_type		; is type/subtype appledisk3.5		and	#$FEFF		; ignore additional cmds bit of SuperDrive		cmp	#$C001		bne	do_a_drive	; if not AD3.5 or FDHD then check next unit				lda	sp_type+1		lsr	a		;C = 1 if FDHD		lda	#0003		;assume AppleDisk3.5 drive		bcc	@10		lda	#$0017		;FDHD ID number@10		ldy	#dev_id_num		sta	[drvr_dib_ptr],y ;mark the dib with proper Device ID number		lda	dib_slist	;get general status byte (16-bit fetch of 8 bit item)		and	#%10111		;save all the status bits		ldy	#dib_last_sts		sta	[drvr_dib_ptr],y	; initialize last-sts in DIB		cmp	#$0010		;c = 1 if Online media so block count is real		lda	dib_blkcnt		bcs	@11		lda	#0000		;zero blocks if Offline@11		ldy	#blk_cnt		sta	[drvr_dib_ptr],y ;init the blockcount in dib		lda	dib_blkcnt+2		bcs	@12		lda	#0000		;zero blocks if Offline@12		iny		iny		sta	[drvr_dib_ptr],y ;init the blockcount in dib@blksNotknown	jsr	Fillin_Unit	;put SmartPort unit# into my DIB		lda	last_slot		and	#%1000		;internal slot?		beq	@20		;no. so make flag zero		lda	#-1		;-1 = External Mustang card@20		sta	ext_slot	;set slot type for set_hook and set_extaccess		jsr	set_extaccess	;download external access detector code		bcs	@err							lda	last_drive			cmp	#0001		;1st drive for this slot ?		clc			;clear carry for dispatch		bne	@30** The rom version requires the driver and slot 5 is set internal.* and this is the first drive  SOOO* Let's install the MERGIT patch before passing control to the* generated driver core routines in order to finish the startup* sequence which includes setting the default interleave to 2:1.		jsr	set_hook	;only need to do this once per slot (after unit 1)		bcs	@30		;might get an error! ** Now set default options and interleave to 2:1.		lda	#0000		;internal call to set "defaults"		jsr	set_option	;just in case last fmt was 400K or something stupid		@30		bcs	@err		inc	device_count	; cnt number of appledisk3.5's online*** added 3-Jun-92 DAL -- Don't rebuild device names on a warm start		lda	>warm_cold_flag	;nonzero = warm startup		bne	@noBuildName*** end 3-Jun-92		ldy	#dev_name		lda	[drvr_dib_ptr],y ;		and	#$003F		clc		adc	#dev_name		tay		lda	name_char		sta	[drvr_dib_ptr],y		inc	name_char		;count to next letter for next device @noBuildName	lda	#no_error		clc@err		rts***********************************************************************	Is_XSP_slot:**	Entry:	m = 1, x = 1*		y = sltromsel register**	Exit:	m = 1, x= 1*		EQ if it is*		NE if it aint (either slot is internal or no SP firmware**  Preserves: 	Y	Uses A,X***********************************************************************		longa	on		longi	onIs_XSP_slot:	lda	last_slot		and	#0007		asl	a		;slot * 2		tax		lda	SlotsReg			and	slotreg_bit-2,x	;is this slot set to external?		beq	@notxSlot	;nope. so don't check any further		txa		lsr	a		ora	#$00C0		xba			;A = $Cs00		tax			;X = $Cs00		longa	off		sep	#$20		lda	>1,x				cmp	#$20		;$Cs01 = $20?		bne	@nextSlot	;nope		lda	>3,x		bne	@nextSlot	;$Cs03 != $00		lda	>5,x		cmp	#$03		;$Cs05 = $03?		bne	@nextSlot		lda	>7,x		bne	@nextSlot	;$Cs07 = $00		lda	>$FB,x		;get smartport ID byte		cmp	#$C0		;have extended and additionals?@nextSlot			longa	on		rep	#$20		rts		@notxSlot	txa			;set NE 		rts		slotreg_bit	dc.w	$0002		;slot 1 slotreg ext bit		dc.w	$0004		;slot 2 slotreg ext bit		dc.w	$0000		dc.w	$0010		;slot 4 slotreg ext bit		dc.w	$0020		;slot 5 slotreg ext bit		dc.w	$0040		;slot 6 slotreg ext bit		dc.w	$0080		;slot 7 slotreg ext bit*********************************************************************** FillinDibStuff*               Entry:*                       m=1, x=1**               Exit:*                       m=1, x=1***********************************************************************Fillin_dib:		lda	last_slot		ldy	#slot_num		sta	[drvr_dib_ptr],y		lda	last_drive		ldy	#dib_hw_unit		sta	[drvr_dib_ptr],y		ldy	#dib_acc_flag		lda	#00		sta	[drvr_dib_ptr],y	;clear the access flagFillin_Unit	lda	dib_unit	;16-bit fetch of 8-bit item!!!		and	#$7F		ldy	#unit_num		sta	[drvr_dib_ptr],y		rts*********************************************************************** NextSlot:	calculates next slot number**	creates slot scan in the following order:*	5int,5ext,7ext,6ext,4ext,2ext,1ext***********************************************************************NextSlot:			lda	last_slot		bmi	@10		asl	a		tax		lda	scanordermap-10,x		sta	last_slot@10		rts		scanordermap	dc.w	$D		;5 -> $D		dc.w	-1		dc.w	-1		dc.w	-1		dc.w	-1		;$9 -> -1		dc.w	9		;$A -> $9		dc.w	-1		dc.w	$A		;$C -> $A		dc.w	$F		;$D -> $F		dc.w	$C		;$E -> $C			dc.w	$E		;$F -> $E******************************************************************	Copy to bank1 the Direct Read routine for multi-blk read**               Entry:	no regs defined**               Exit:	no regs defined******************************************************************		export	copy_to_bank1copy_to_bank1		longa	on		longi	on		ldx	bank1_lgth		longa	off		SEP	#$20@loop		lda	bank1_code,X		sta	>bank1_org,X		dex		bpl	@loop		longa	on		REP	#$20		rts****************************************************************** Merge data from read into a contiguous block.**               Entry:*                       m=1, x=1*                       c = 0 successful data read*                       c = 1 go retry read of data block**               Exit:*                       m=1, x=1*                       X = low byte of number of data bytes read*                       Y = high byte of number of data bytes read*****************************************************************		export	new_merge_it		longa	off		longi	offnew_merge_it				;               		pla			; get return address off stack		pla		bcc	data_read_ok	; if error during read_data try again		jmp	>try_more	; otherwise give data to callerdata_read_ok				; 		php			; Native m=1, x=1 (from disk3.5 rom)		longa	off		;		longi	on		;		sep	#$20		;		rep	#$10		;		ldx	#$0001		;		ldy	#511		; assume non-mac 512 byte blk		lda	|mac_flag	; check for mac read or write		beq	mgit2		;		ldy	#523		; If Mac call move 524 bytes		bra	mgit2		; 512 or 524 bytes not 513 or 525mgit1					; 		lda	|buf3,x		sta	[<cmdbuffl],y		dey			; 255->256 xtion happens here		bmi	exit_merge	;mgit2					; 		lda	|buf2,x		sta	[<cmdbuffl],y		dey			; 511->512 transition occurs here		bmi	exit_merge	;mgit3					; 		lda	|buf1,x		sta	[<cmdbuffl],y		inx			; point to next possible byte		dey			; move destination index		bpl	mgit1		;exit_merge				; 		inx			; form accurate byte count		longa	on		; m=0, x=0		longi	on		;		rep	#$30		;		txa			; byte count		plp			; restore processor state		longa	off		;		longi	off		;		tax			; x = low byte of byte count		xba			;		tay			; y = high byte of byte count		jmp	>sbset		; all done here go back to the rom		eject*******************************************************************               This module will install return addresses*               on the stack which will allow us to call routines*               in the bank $FF rom for the Disk 3.5 driver and*               return back to us when done.**               The routine pushes a 24 bit return address to the*               new Merge_it, pushes a 16 bit address to a rtl*               instruction in bank $FF.*               When a call is made to the ReadData routine in the*               3.5" disk driver control will be passed here. This*               routine pushes the 24 bit address of the new_merge_it*               code, pushes the return address to a RTL instruction*               in bank $FF and then jumps to the read_data routine*               in the rom.*                       When the read_data routine completes, it does*               an RTS to the RTL instruction which will return to the*               new merge_it code.  Merge it in turn will pass control*               back to the rom when it completes.**               Entry:*                       m=1, x=1*                       Data bank = $E1***               Exit:*                       m=1, x=1*                       Data bank = $E1*                       A = trashed**                       Stack layout*                       +-----------+ --------*                       |   Bank    |*                       +-----------+*                       |   High    |   Address of new_merge_it*                       +-----------+*                       |    Low    |*                       +-----------+ --------*                       |   High    |*                       +-----------+   Address to RTL inst. in bank $FF*                       |    Low    |*                       +-----------+ --------*               SP >--> |    ???    |*                       +-----------+******************************************************************		export	merge_patchmerge_patch				;               		longa	off		longi	off		pla			; remove old 'RTL' - 1/9/89 RBM		pla		pla				phk			; push long return address		pea	new_merge_it-1	; of new merge_it routine		pea	rtl_addr-1	; push return addr to rtl		jmp	>read_data	; call the rom read data routine		eject*******************************************************************               This module will modify the read_data hook for*               the AppleDisk 3.5 driver to point to a ram based*               patch which contains a modified Merge it routine.** Entry: via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = $0000*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0** EXIT: via an 'RTS'*               A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 0 x x  0*******************************************************************		export	set_hookset_hook				;               		longa	on		longi	on** Set unit number for hook installation.*		clc		bit	ext_slot		bmi	@doNothing	;				sep	#$20		; 8 bit 'm'		longa	off		ldy	#unit_num		lda	[<drvr_dib_ptr],y		sta	|sethook_unit		lda	#$02		; hook refernece is for read data		sta	|hook_ref		rep	#$20		; 16 bit 'm'		longa	on** Install the merge patch so that the drive can operate at 2:1 interleave.* This patch is only installed on old roms.*		lda	|rom_version	; should merge patch be installed?		cmp	#$0002		bge	@no_merge		lda	#merge_patch	;point to the new merge it code		sta	|hook_addr		lda	#merge_patch>>8		sta	|hook_addr+1		lda	<drvr_dev_num	; device number to read		ldx	#sethook_list		jsl	to_b0_core** Install the patch to detect direct firmware access.*		@no_merge		sep	#$20		; 8 bit 'm'		longa	off		lda	#$08		; hook reference number is for main vector		sta	|hook_ref		rep	#$20		; 16 bit 'm'		longa	on		lda	#access_detect	;point at external access detection		sta	|hook_addr		lda	#access_detect>>8		sta	|hook_addr+1		lda	<drvr_dev_num	; device number to read		ldx	#sethook_list		jsl	to_b0_core@doNothing	rts************************************************************************	Download code for the access detector in UCIC card "ROM"***********************************************************************		export	set_extaccess		longa	on		longi	onset_extaccess	clc		bit	ext_slot		bpl	@exit		ldy	#unit_num		lda	[drvr_dib_ptr],y	;get SmartPort Unit #		sep	#$20		; 8 bit 'm'		longa	off		sta	setAdrs_unit		sta	dnLoad_unit		rep	#$20		; 16 bit 'm'		longa	on		asl	a		tax		lda	dwnldAdrs-2,x		sta	setAdrs_addr		;fill in the adrs for this unit		lda	<drvr_dev_num	; device number to read		ldx	#setAdrs_list		jsl	to_b0_core		bcs	@exit** now fill in the address of this dib's access flag for the detector routine		lda	<drvr_dib_ptr		;get low word of dib adrs		clc		adc	#dib_acc_flag		sta	dibXflag_adrs+1		;+1 to skip the opcode* the bank adrs should have been relocated properly when I was loaded				lda	<drvr_dev_num	; device number to read		ldx	#dnLoad_list		jsl	to_b0_core	;download the 7 bytes to the card's "ROM"@exit		rts		entry	dwnldAdrsdwnldAdrs	dc.w	$0B80		dc.w	$0BA0		dc.w	$0BC0		dc.w	$0BE0		****************************************************************** ACCESS_DETECT** ENTRY: Call via 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = $0000*               B Reg = Undefined*               P Reg = x x 1 1 0 0 x x  0* EXIT: via an 'RTL'*               A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = x x 1 1 0 0 x x  0**  Called from IIgs SmartPort dispatcher firmware *  in 8 bit native mode*****************************************************************		export	access_detect		longa	off		longi	offaccess_detect	php			;save status before changing it		pha		lda	>cmdid		; get internal firmware unit #		cmp	>id1		; is it the same as drive #1?		bne	@10		lda	#$FF		sta	>dib1acc_flag	;set dib1 access flag		bra	@20		;all done@10		cmp	>id2		bne	@20		lda	#$FF		sta	>dib2acc_flag	;set dib2 access flag@20		pla			;restore 8bit A		plp			;restore status		rtl* Switched OFF since time for testing this is not available	if 0	then************************************************************************	Download code for the 800K drive formatter HD media checker***********************************************************************		export	set_extHDchk		longa	on		longi	onset_extHDchk	clc		bit	ext_slot		bpl	@exit		ldy	#unit_num		lda	[drvr_dib_ptr],y	;get SmartPort Unit #		sep	#$20			; 8 bit 'm'		longa	off		sta	setAdrs_unit		sta	dnLd_unit		rep	#$20			; 16 bit 'm'		longa	on		lda	#HDChk_Org		sta	setAdrs_addr		;fill in the adrs for this unit		lda	<drvr_dev_num		; device number to read		ldx	#setAdrs_list		jsl	to_b0_core		bcs	@exit** the bank adrs should have been relocated properly when I was loaded		lda	#<MediaChk		sta	dnLd_dataPtr				lda	<drvr_dev_num		; device number to read		ldx	#dnLd_list		jsl	to_b0_core		;download the patch to Format cmd @exit		rts		endif* end of PROC		endp* Switched Off since time for testing this is not available	if 0	thenMediaChk	PROC	ENTRY,TEMPORG HDChk_Org-2*********************************************************************** Check HD media** Attempt to determine if media is reliable in innner tracks************************************************************************ Make a jump table in ROM so these routine can be accessed without* this code having to know their locations in the romj_U35MtrON	equ	$D100j_Recal		equ	$D103j_Seek		equ	$D106j_WaitRdyTO	equ	$D109j_rdmode	equ	$D10Cj_DoEject	equ	$D10Fm_q6l		equ	$0A0Cm_q6h		equ	$0A0Dm_q7l		equ	$0A0Em_q7h		equ	$0A0Fstart:		dc.w	endCode-start		jsr	j_U35MtrOn	;turn unified motor on		jsr	j_Recal		;start in the right place		bcs	@exit		;can't recal ??				lda	#75		sta	cyl		jsr	j_Seek		;seek inner track		jsr	j_WaitRdyTO	;wait until motor up to	speed		bcc	@rdy		;Never Ready??@exit		clc		rts		@rdy		jsr	j_rdmode		@writetst	ldx	#00		ldy	#6600/256		iny		lda	#$D8		;has 1 XL 8us long transition		bit	m_q6h		sta	m_q7H@TrkFill	bit	m_q6l		bpl	*-3		sta	m_q6h		;writ nth byte		dex		bne	@TrkFill		dey		bne	@TrkFill		bit	m_q7l		;turn write gate off		bit	m_q6l		;back to read mode		ldx	#103@wait600us	phx		plx		DEX		bne	@wait600us				ldx	#00@clrem		stz	$400,x		inx		bne	@clrem		jsr	j_rdmode				lda	#$10		sta	temp		ldy	#00@readback	lda	m_q6l		bpl	@readback		and	#$7F				tax		inc	$0400,x		bne	@nxt		inc	$0480,x@nxt		dey		bne	@readback		dec	temp		bne	@readback		ldx	$00@scantbl	lda	$0400,x		ora	$0480,x		beq	@nxtx		lda	$0400,x		sta	$0500,x		lda	$0480,x		sta	$0580,x@nxtx		inx		bpl	@scantbl				lda	$04D8		;copy hi byte of $D8 count		sta	$0501		lda	$0458		;     lo byte of $D8 count		clc		adc	$0446		;add lo byte of $C6 count		sta	$0500		lda	$04C6		adc	$0501		sta	$0501		;add hi byte of $C6 count				lda	$0431				clc		adc	$0500		sta	$0500		lda	$04B1		adc	$0501		sta	$0501				lda	$040D				clc		adc	$0500		sta	$0500		lda	$048D		adc	$0501		sta	$0501		;$500.501 = count of "correct" readback's		stz	$0502		stz	$0503		ldx	#00@sumloop	cpx	#$58		beq	@skipV		cpx	#$0D		beq	@skipV		cpx	#$46		beq	@skipV		cpx	#$31		beq	@skipV		lda	$0400,x		ora	$0480,x		beq	@skipV		;don't add in zeros		lda	$0400,x		beq	@addit		;low = 00 but hi is not		cmp	#$01		bne	@addit		;low != 01 so do it		lda	$0480,x		; if hi = $00		beq	@skipV		;any count of $0001 is ignored@addit		lda	$0400,x		clc		adc	$0502		sta	$0502		lda	$0480,x		adc	$0503		sta	$0503@skipV		inx		bpl	@sumloop** Now $500.501 = count of "correct" readbacks'* and $502.503 = count of "bad" readbacks** Now if the ratio of bad > good/32 (ie if Bad > 3.125 % of good )* the media is almost certainly HD media instead of DD media		lda	$0500		sta	$0504		lda	$0501		lsr	a		ror	$0504		lsr	a		ror	$0504		lsr	a		ror	$0504		lsr	a		ror	$0504		lsr	a		ror	$0504		sta	$0505				ldx	drive		lda	$0502		;if "bad" count 		cmp	$0504		; >= good count / 32		lda	$0503		sbc	$0505		bcc	@ok		jsr	j_DoEject		sec@ok		rtsendCode:		endp	endif