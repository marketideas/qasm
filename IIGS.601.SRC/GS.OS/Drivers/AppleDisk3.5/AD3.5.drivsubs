                TITLE   '     Seek Routine'  drivsubs	proc***************************************************                                                **  seek                     Seek to a cylinder   **                     Assume cur_cyl is correct  **                                                **   Input:    cyl <- cylinder to seek to         **             drive <- drive on which to seek    **             cur_cyl <- head rests here         **   Output:   C <- set if seek error occurred    **             curnsect <- # sectors this cyl     **   Uses:     recal, sendsteps, WriteBit         **   Regs:     A <- error2 (if carry set)         **   Destroys: X, Y                               **                                                ***************************************************		export	seekSEEK** If drive is offline (cyl unknown), do a recal                LDX     DRIVE                BIT     cur_cyl,X 	;Set N to online                BPL     @05             ;If cyl known, skip recal                JSR     RECAL                BCS     @SERR@05             EQU     *** Determine # of steps to take, and direction                SEC                LDX     DRIVE                LDA     cur_cyl,X                SBC     CYL 		;Calculate delta                 BEQ     @80	        ;If on track, skip down** At this point, C clear means inward seek, ow out                LDY     #DIROUTADR      ;Assume outward seek                 BCS     @10             ;Branch on outward seek*                LDY     #DIRINADR       ;Setnasrt value for inward seek                EOR     #$FF            ;Gotta convert the negative delta                ADC     #1              ;Carry was already clear *@10             EQU     *                TAX                     ;move delta to X reg                TYA                     ;Setup to set the direction                JSR     WRITEBIT** Now do the stepping ; delta in X                JSR     SENDSTEPS       ;Send the step pulses ** NOW THAT a STEP is in progress open and close IRQ		lda	irq_state	;were interrupts disabled?		bne	@40		;yep so leave em that way		cli			;this should allow 1 interrupt per seek		nop		sei			;per track during seek/settling time** Wait until any seeking/speed changing/head settling finishes@40		lda	#readyadr		jsr	Read_bit	;is seek done yet?		bcc	@80		;yes		longi	on		rep	#$10		ldx	#700		;allow at least 80*6+30 =510 Ms@50		ldy	#200@60		lda	>L7clr		;(09) read ready status again		bpl	@70		;(11) It's ready now		dey			;(13)		bne	@60		;=16 *.350 = 5.6 us * 200 >= 1 ms 		dex		beq	@66		;Oh boy I timed out after seek???		bra 	@50		;see if the dumb drive is ready yet.@66		SEP	#$10                BRA     @NVRRDY		;something's wrong if seek takes > .7 secs@70		SEP	#$10		longi	off@80		EQU     ** * Update the current cylinder byte and exit error free                 LDX     DRIVE                LDA     CYL                STA     cur_cyl,X                CLC                     ;RETURN  Good!@SERR		RTS*@NVRRDY		LDA     #drvr_off_line                SEC		RTS***************************************************                                                **  sendsteps           Steps a number of tracks  * *                        assume IWMDIR to drive  **                                   and dir set  * *                                                **   Input:    X <- number of tracks to step      **   Destroys: A, Y                               **             X cleared                          **                                                **  (Delays after stepping until /READY is valid) **                                                ***************************************************SENDSTEPS       EQU     *** Take a step*                LDA     #STEP0ADR                JSR     WRITEBIT** Wait for handshake from drive*@10             JSR     IWM_sense	; IWM_sense leaves IWM in sense mode                BCC     @10** See if more steps to do*                DEX                BNE     SENDSTEPS** The current Sony /READY is not valid for 150 microseconds after a*  step pulse.*                LDX     #$4F            ; constant for 150 usec delay@20		DEX                BNE     @20                RTS                TITLE   '     Recalibrate'   ***************************************************                                                **  recal                       Seek to track 0   **                                                **   Input:    drive <- current drive             **   Output:   cur_cyl <- 0                       **             C <- clr:okay, ow step/sensor err  **             X <- drive                         **   Destroys: A, X, Y                            **                                                ***************************************************RECAL           EQU     *** Set the step direction to out*                LDA     #DIROUTADR                JSR     WRITEBIT*                LDA     #TK0ADR                JSR     READ_BIT        ;is is already at trk0?                BCC     @30             ;yes. so alldone** Send a whole bunch of step pulses*                LDX     #RECALTRKS                JSR     SENDSTEPS** Now wait for /TK0 with timeout*                LDX     #RECALTRKS+5    ;head settling = 5 trk seeks@10             LDA     #TK0WAIT        ;Gonna wait a few ms                JSR     WAITMS*                LDA     #TK0ADR                JSR     READ_BIT                BCC     @30             ;=> Saw track 0 *                DEX                BNE     @10** Never saw /TK0@20             EQU     *                SEC@30             EQU     *                LDX     DRIVE                STZ     cur_cyl,X                RTS                TITLE   '     Low Level Drive Control Routines'        ****************************************************************  Enable & Sense drive status* *   Input:    drive <- current drive*   Output:   drv_sts <- b7,b6,b5*             C <- clr:okay NO dsw or Offline*             C <- set:either dsw or Offline (or both)*             X <- drive *   Destroys: A, X, Y***************************************************************		longa	off		longi	off		export	enable_senseEnable_Sense		ldx	drive		lda	drv_sts,x		sta	prior_sts	;save it for offline-online check		lda	>enable1,x		lda	select		;activate drive enable1/2		stz	drv_sts,x	;clear prior bits		ldy	#03@10		lda	sensbit-1,y		jsr	read_bit		bcc	@20		;status is low		lda	statbit-1,y	;status is high so set		ora	drv_sts,x	;this bit 		sta	drv_sts,x@20		dey			bne 	@10		lda	#$20		bit	drv_sts,x			sec		bmi	@30		;dsw is true!		bvs	@30		;offline is true		clc			;no error status sensed@30		rts		sensbit		dc.b	mtronadr,dipadr,ejctadrstatbit		dc.b	$20,$40,$80				eject****************************************************************** *  WaitRdyTO   Waits for /READY for 1.5 seconds* *****************************************************************		export	wait_rdy_toWAIT_RDY_TO** Set up to read the /READY line*                LDA     #READYADR                JSR     READ_BIT        ;Set the control lines                BCS     @10             ;its not ready on 1st try@RDY            CLC                RTS* Now Poll for /Ready for 1.5 seconds max@10             LDX     #>1500                LDY     #<1500@20             LDA     #01                JSR     WAITMS          ;waste a 1 ms                LDA     >L7clr		;and test again                BPL     @RDY                DEY                BNE     @20                DEX                BNE     @20                SEC                RTS************************************************************* MotorOn************************************************************		export	motoronMOTORON** First check if the motor is on already                LDA     #MTRONADR                JSR     READ_BIT                BCC     @90		;Yeah no waiting** It wasn't.  Turn it on now.  Control lines are already set.                JSR     PULSELSTB		lda	>L6CLR		;back to rd mode** Have to wait 100 milliseconds before proceeding		LDA     #STDMUPWAIT     ;100		JSR     WAIT2MS         ;Wait some time@90             RTS***************************************************** SetHead***************************************************		export	setheadSETHEAD                LDA     >DISKREG         ; get disk/hdsel register                AND     #$7F            ; mask off head select bit                BIT     SIDE ; check which side                BPL     @10		; set head 0                ORA     #$80            ; else set head 1@10		STA     >DISKREG         ; set it                RTS		eject***************************************************                                                **  ReadBit                Control routines for   **  WriteBit       reading/writing signals from   **                               the SONY drive   **                                                **                                                **   Input:    A <-  X X X X CA1 CA0 SEL CA2      **   Regs:     A cleared (ReadBit: IWM status)    **             X preserved                        **             Y destroyed                        **             c = sense bit 1=high  0 = low      ***************************************************		export	read_bitread_bit** Set up the iwm phase 'control' lines*                jsr     SDCLINES** Now read the sense line from the IWM into the C flag* AND leave the IWM in the status sense mode*IWM_sense       cmp     >L6SET		;Set L6                 LDA     >L7CLR		;Read the status		rol	a		;put bit in carry                rts**********************************************************   WriteBit***********************************************************		export	WriteBitWRITEBIT** Set up the lines, then 'LSTRB' Acc's lsb over*                JSR     SDCLINES*PULSELSTB       cmp     >LSTRBSET        ;Raise LSTRB                cmp     >LSTRBCLR        ;Lower it after 2 micros (twice spec)                RTS                eject************************************************************* SDCLINES***********************************************************SDCLINES** Must set CA0, CA1 before changing HDSEL 1->0*                cmp     >CA0CLR		;use CMP long to tag IWM controls                cmp     >CA1SET		;without disturbing the A reg                cmp     >LSTRBCLR        ;** Set CA2 per Acc lsb*                cmp     >CA2CLR          ;Assume lsb clear                LSR     A               ;lsb -> C ; Acc has 0XXXX CA1 CA0 SEL                BCC     @10		;=> We were right                cmp     >CA2SET          ;We were wrong, set CA2** Deal with SEL setting*@10		EQU     *                LSR     A               ;SEL -> C ; Acc has 00XXXX CA1 CA0                xba                     ;HOLD    that thought                LDA     >DISKREG         ;Assume SEL will be 0                AND     #$7F            ; => I'm just psychic                BCC     @20		; Luckily HDSEL is lsb                ORA     #$80            ; set Hdsel to a one@20		STA     >DISKREG         ; Finally set SEL correctly                xba                     ;GET     CA0 & CA1 back** Now for CA0, CA1. CA0 is low, CA1 is high,*  clear them if we were asked to.*                LSR     A               ;C has CA0                BCC     @30		;If 0, nothing to be done                cmp     >CA0SET          ;Okay, set it*@30		LSR     A               ;Get the CA1                BCS     @40                           cmp     >CA1CLR          ;Clear it*@40		RTS                TITLE   '     Time Delay Subroutines'          ***************************************************                                                **  waitms        Wait the specified # millisecs  * *                         assuming a 2MHZ clock  **                   (accurate to roughly +0.7%)  * *                                                **  If code straddles pages, it is less accurate  **                                                **   Input:    A <- milliseconds of delay         **   Destroys: A ; msdelayctr                     **   Prserves: X, Y                               **                                                ***************************************************WAIT2MS         EQU     *                PHA                JSR     WAITMS                PLA*****************WAITMS          EQU     *               ;Time = Acc * 1.007 millisecs                STA	msdelayctr	;(4)                 LDA     >CYAREG		; slow down to 1Mhz                PHA			;        save old settings                AND     #$7F		;                STA     >CYAREG		;@10		LDA     #102		;(2) loop is 1020 1 Mhz cycles *@20		DEC     A		;(2) waita is 10 cycles		BNE	@30		;(3)@30		NOP                     ;(2)                     BNE     @20		;(3,2) *		DEC	msdelayctr	;(6)                BNE     @10		;(3,2) *                PLA                     ;        restore cya register                STA     >CYAREG          ;                RTS                     ;(6)     		title	'     Device DSW Status'******************************************************************* The following routine issues a status call to a class 2 device* to check for disk switched.  Class 2 devices indicate disk* switched through bit 0 of the general status byte returned* on a device status call.*** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x x  0** EXIT:         A Reg = Condition code*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x 0  0 if no error*                       x x 0 0 0 x x 1  0 if error******************************************************************		export	c2_dev_statc2_dev_stat               		longa	on		longi	on		phx		phy		bit	ext_slot		bmi	@notInternal		sep	#$30		; 8 bit 'm' & 'x'		longa	off		longi	off		jsr	Enable_Slot6	;save environ & enable the Internal IWM ;				jsr	phases_off	; all IWM phase lines off** REVISION: Driver does its own disk switch sensing and activates the 3.5 drive *           timer (unlike SmartPort status which cancels the 3.5 drive timer)*           thus leaving the drive light on and motor running iff a media read*           has preceeded this status sense done for a cached read!** NOTE:  It is not necessary to change the IWM mode register to do a Status Sense!*        A 3.5 drive status sense can be done with the IWM in either 5.25 or 3.5 mode*        A 3.5 drive status sense can ALSO be done the the IWM timer running!**        if the IWM timer is NOT running the timer must be disabled before the*        drive enable is DE-activated to prevent the IWM timer from starting!*		ldy	#%00000100		jsr	Iff_set_mode ;prevent IWM timer activation iff its now off				jsr	read_dsw_status	; read disk switched status 		php		ldy	#$00		jsr	Iff_set_mode	;reset IWM mode if Iff its off		jsr	phases_off		jsr	Restore_Slot6	;reset slotromsel etc		plp				rep	#$30		; 16 bit 'm' & 'x'		longa	on		longi	on@25		ldx	#no_error	; assume no disk switched error		bcc	@30		; if assumed correct		ldx	#drvr_disk_sw+$100	; else set disk switched error@30		txa			; restore error code		ply		plx		rts************************************************************************	External Slot Device Status Sense *	How the hell do I do this Without disturbing drive?***********************************************************************@notInternal			ldy	#unit_num		lda	[drvr_dib_ptr],y				sep	#$20		longa	off		ora	#$80		sta	dsw_unit	;phantom unit number for dsw sense		rep	#$20		longa	on				lda	<drvr_dev_num		ldx	#dsw_stat	;make a seemingly invalid status call		jsl	to_b0_core	;just doit bozo		lda	dsw_slist		and	#$0001		cmp	#$0001		bra	@25				******************************************************************* The following routine accesses one of two AppleDisk3.5 drives to* determine if the media has been switched.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = unspecified*               B Reg = Unspecified*               D Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0*               Drive = (0/1) setup from dib_hw_unit* ASSUMES:      IWM is switched** EXIT:         A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*               D Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x 0  0   No disk switch occured*                       x x 1 1 0 x x 1  0   Disk switch occured******************************************************************		export	read_dsw_statusread_dsw_status				; 		longa	off		longi	off				ldx	drive				lda	>enable1,x	; select desired drive		lda	>select		; Activate the drive interface		lda	#ejctadr		jsr	read_bit	; was device ejected? (preserves X)		lda	>L6clr		;   (restore IWM to read mode)		bcc	@10		; no		lda	#ejct_reset		jsr	writebit		sec@10		lda	>deselect	;DeActivate, Thus starting drive's Timer		rts		eject******************************************************************* Save Slot 6 environment and enable internal slot 6 IWM* Setup the Drive work temp from the DIB hw_unit parm* ** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*               D Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0** EXIT:         A Reg = Unspecified*               X Reg = unchanged*               Y Reg = unchanged*               B Reg = unchanged*               D Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0 ******************************************************************		export	enable_slot6enable_slot6 				;  		longa	off		longi	off				ldy	#dib_en_save		lda	>cyareg		sta	[drvr_dib_ptr],Y		and	#%11111011	;disable slot 6 motor on detector		sta	>cyareg;		lda	>sltromsel		iny		sta	[drvr_dib_ptr],Y		and 	#%10111111	;enable internal IWM in slot 6		sta	>sltromsel;		lda	>diskreg		iny		sta	[drvr_dib_ptr],Y		ora	#%01000000		sta	>diskreg;		ldy	#dib_hw_unit		lda	[drvr_dib_ptr],Y		dec	a		sta	drive		;set 0 or 1 into work variable;			rts		eject******************************************************************* Restore Slot 6 environment to the saved values in DIB* ** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*               D Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0** EXIT:         A Reg = Unspecified*               X Reg = unchanged*               Y Reg = 00*               B Reg = unchanged*               D Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0 ******************************************************************		export	restore_slot6restore_slot6 				;  		longa	off		longi	off		ldy	#dib_en_save+2		lda	[drvr_dib_ptr],Y		sta	>diskreg;		dey		lda	[drvr_dib_ptr],Y		sta	>sltromsel;		dey				lda	[drvr_dib_ptr],Y		sta	>cyareg;			rts				eject****************************************************************** This routine checks to see if the iwm Timer is off* If it is then the IWM mode register is set to the Y-reg mode* Otherwise nothing is done, leaving the timer running** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = New IWM mode*               B Reg = Unspecified*               D Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0** EXIT:         Y Reg = unchanged*****************************************************************		export	Iff_set_mode		longa	off		longi	offIff_set_mode 				;               		lda	>L7clr		; besure not in Write mode		lda	>L6set		; enable status sense mode		lda	>L7clr		; read status reg 		and	#$20 		; is the timer running?		beq	set_iwm_mode	; NO. Thus set mode won't hangup@10		cmp	>L6clr		; leave IWM in read mode		rts		****************************************************************** This routine is used to set the IWM mode register.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = New IWM mode*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0** EXIT:         A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0******************************************************************		export	set_iwm_mode		longa	off		longi	offset_iwm_mode				;               		lda	>deselect	; motor must be off		lda	>l6set		; set up access to status register@10		lda	>l7clr		; read iwm status reg		and 	#%00100000	; is enable OFF?		bne	@10		; wait for access to IWM mode register		bra	@30@20				; 		tya			; attempt to set new mode		sta	>L7set@30				; 		tya			; need new mode		eor	>L7clr		; does mode need set?		and	#%00011111	; 5 LSB's are only relevant parameters		bne	@20		; still need new mode to be set		lda	>L6clr	; leave IWM in read mode		rts		eject******************************************************************* This routine turns off all IWM motor phase lines.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*               D Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0** EXIT:         A Reg = Unspecified*               X Reg = #$0060 = Slot * 16*               Y Reg = Unspecified*               B Reg = Unspecified*               D Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 1 1 0 x x x  0******************************************************************		export	phases_offphases_off				;               		longa	off		longi	off		lda	>ca0clr	; turn off all phases		lda	>ca1clr		lda	>ca2clr		lda	>lstrbclr		rts;-----------------------------------				endp		eject******************************************************************* The following routine copies the contents of a block that* resides in the cache to the buffer specified by the driver* call.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'** EXIT:         A Reg = Unspecified*               X Reg = Same as entry*               Y Reg = Unspecified*               B Reg = Same as entry*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'******************************************************************		export	cache_to_buffcache_to_buff	proc		pei	<drvr_cach_ptr+2 ; source buffer		pei	<drvr_cach_ptr		pei	<drvr_buf_ptr+2	; destination buffer		pei	<drvr_buf_ptr		pea	$0000		; transfer count		pei	<drvr_blk_size		pea	move_sinc_dinc	; src incr & dest incr		jsl	move_info	; go do it to it		rtl		eject******************************************************************* The following routine copies the contents of a block that* resides in the buffer specified by the driver call to the* cache.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'** EXIT:         A Reg = Unspecified*               X Reg = Same as entry*               Y Reg = Unspecified*               B Reg = Same as entry*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'******************************************************************		export	buff_to_cachebuff_to_cache				;               		pei	<drvr_buf_ptr+2	; source buffer		pei	<drvr_buf_ptr		pei	<drvr_cach_ptr+2 ; destination buffer		pei	<drvr_cach_ptr		pea	$0000		; transfer count		pei	<drvr_blk_size		pea	move_sinc_dinc	; src incr & dest incr		jsl	move_info	; go do it to it		rtl		endp