********************************************************************************* File: 	    APTALK* Contents:	    APTALK.Aii,*		    atp_includes.aii,*		    lap_includes.aii** rev 00	    Original ROM* rev 01	    Second ROM** This file contains the 65816 implementation of DDP for the Apple IIGS.** Copyright Apple Computer, 1986* Original Author: Ed Lai, Greg Seitz********************************************************************************** NOTE** This file would normally just patch any correction in ROMs =< 01, but* since there were so many corrections to those roms, we just patch out* the entire thing with the APTALK file.********************************************************************************** Modification History** REV 02** 8/19/88    TGH   - Started working on RevD ROM** 26-Jun-91 MSD	Rewrote CmpItem to handle the 'Å' wildcard and diacriticals.*		This change requires saving and restoring two more bytes on*		direct page so that I can store offsets into the strings for*		a function that compares substrings.*  1-Jul-91 MSD	All instances of the UpChar macro have been changed to:*			JSR	ToUpper*		so that case-insensitive diacritical comparisons work for*		RegisterName.* 12-Jul-91 MSD	Fixed the ToUpper routine so that it uses absolute long addressing*		to access the tables of diacrtitical characters.*  7-Oct-91 MSD	The code that calculates the length of a DDP packet was ignoring*		overflow and then calling LAP and passing its error back up.  It*		was also interpreting any length field in the BDS with its high bit*		set as an end-of-BDS flag when it should check for $FFFF.  RemoveName*		now returns error on async call.*******************************************************************************		MACHINE M65816		PRINT	GEN		IMPORT	ADispatch		IMPORT	GoComp		IMPORT	LAPRead		IMPORT	lattachprot		IMPORT	lforbid		IMPORT	lpermit		IMPORT	restoreZP		IMPORT	saveZP		import	CheckAsync				ENTRY	AddName		ENTRY	DoWrtDDP		ENTRY	GetName		ENTRY	calcleng		ENTRY	calclng1		ENTRY	calcnmln		ENTRY	discard		ENTRY	getlisten		entry	checkvalidtype		entry	ToUpper		;-------------------------------------------------------------------------------;		 Global Equates;-------------------------------------------------------------------------------CodeBank	equ	$ff0000ramdata 	equ	$E1D000;-------------------------------------------------------------------------------;		General ZP usage;-------------------------------------------------------------------------------cmndlist	equ	$80execaddr	equ	cmndlist+4zpCurBuf	equ	execaddr+4;-------------------------------------------------------------------------------;		DDP parameters;-------------------------------------------------------------------------------ldlength	equ	0ldchksum	equ	2lddnet		equ	4ldsnet		equ	6lddnode 	equ	8ldsnode 	equ	9lddsckt 	equ	10ldssckt 	equ	11ldprotocol	equ	12buf_len 	equ	2buf_cksum	equ	4buf_dest	equ	6buf_data	equ	9;-------------------------------------------------------------------------------;		Common RAM usage;-------------------------------------------------------------------------------lapdest 	equ	CodeBank+$D000	; packet header infolapsrce 	equ	lapdest+1lapprot 	equ	lapsrce+1ddphead 	equ	lapprot+1thisnet 	equ	ddphead+13	; this network numberourNode 	equ	thisnet+2	; this node numberabridge 	equ	OurNode+1	; bridge node numbertmpNBPPtr	equ	abridge+1	; pointer to buffer, pass from DDP to NBPDDPRAM		equ	tmpNBPPtr+2;-------------------------------------------------------------------------------;		Commands for other modules;-------------------------------------------------------------------------------LapWrtCmd	equ	$0700InstTimCmd	equ	$0480RmvTimCmd	equ	$0500OpnSktCmd	equ	$0B00CnclTmCmd	equ	$4500;-------------------------------------------------------------------------------;; Equates from procedure WriteDDP;;-------------------------------------------------------------------------------;; RAM usage;wddphead	equ	DDPRAM;wdlapcmnd	equ	wddphead+13	; write lap commandwdlaprslt	equ	wdlapcmnd+2wdlapdest	equ	wdlaprslt+2wdlaptype	equ	wdlapdest+1wdlapwds	equ	wdlaptype+1wdddpmax	equ	wdlapwds+4;tempnet 	equ	wdddpmax+2	; temp area for RTMPbridgebit	equ	tempnet+2tempbridge	equ	bridgebit+1;lastIndex	equ	tempbridge+1	; socket listener tablelistentable	equ	lastIndex+2dynamtable	equ	listentable+512;RTMPTmCmd	equ	dynamtable+512	; RTMP timerRTMPTmTsk	equ	RTMPTmCmd+4RTMPTmTimer	equ	RTMPTmTsk+6RTMPEnd 	equ	RTMPTmTimer+6;-------------------------------------------------------------------------------;; Equates for NBP;;-------------------------------------------------------------------------------; RAM usage for NBPnbpwrarea	equ	RTMPEnd 	; DDP parameter for NBP lookupnbpchksmf	equ	nbpwrareanbpdnet 	equ	nbpchksmf+1nbpdnode	equ	nbpdnet+2nbpdsckt	equ	nbpdnode+1nbpssckt	equ	nbpdsckt+1nbpprot 	equ	nbpssckt+1nbpwrtab	equ	nbpprot+1outnbp		equ	nbpwrtab+4	; lkup with 1 tupleoutnbpid	equ	outnbp+1	; NBP ID to identify transactionnbpentity	equ	outnbpid+1	; entity during lookupnbpptrsave	equ	nbpentity+5	; current active NBP commandnbpwds		equ	nbpptrsave+4	; wds for replyentitylen	equ	nbpwds+12	; part of wds that points to entity nameentityadr	equ	entitylen+2nbpwdsend	equ	entityadr+4	; wds end flag (should be FFFF)tuplect 	equ	nbpwdsend+2	; number of tuples in packetNBPTmCmd	equ	tuplect+1	; NBP timerNBPTmTsk	equ	NBPTmCmd+4NBPTmTime	equ	NBPTmTsk+6namelist	equ	NBPTmTime+6	; list head for registered namerptupcount	equ	namelist+4	; NBP header during replyreplyNID	equ	rptupcount+1nbprptable	equ	replyNID+1	; 4 tuples, 1 empty 1 NID + FFFF markerNBPEnd		equ	nbprptable+38; command numberNBPREGN 	equ	$0E		; name registerNBPLKUP 	equ	$10		; name look upNBPCFRM 	equ	$11		; name reply; parametersCmEntAdr	equ	8CmTimOut	equ	12CmRetry 	equ	13CmTimLft	equ	14CMTryLft	equ	15CmRsbSiz	equ	16		; for look up, buffer sizeCmRsbAdr	equ	18CmMaxrsp	equ	22CmRspCnt	equ	23CmCfmNet	equ	16		; for confirm, network numberCmCfmNode	equ	18CmCfmSckt	equ	19CmCfmActSkt	equ	20CmRegSkt	equ	16		; for register, socket numberCmSetIt 	equ	17		; if nonzero, don't check nameCmRmvEntity	equ	4; ZP usagetblptr		equ	cmndlist+4nbpbfptr	equ	cmndlist+8nbprcvct	equ	cmndlist+12nameleng	equ	cmndlist+12regsckt 	equ	cmndlist+12regenum 	equ	cmndlist+13nbptbdisp	equ	cmndlist+11tempy1		equ	cmndlist+12tempy2		equ	cmndlist+13nbpoff1		equ	cmndlist+14	; %%% 26-Jun-91 MSDnbpoff2		equ	cmndlist+15	; %%% 26-Jun-91 MSDwildoff		equ	cmndlist+16	; %%% 27-Jun-91 MSDtempChar	equ	cmndlist+3; errorsAsyncErr	equ	$0104		; can't be made Async (7-Oct-91 MSD)toomanynames	equ	$401duplname	equ	$402wrongName	equ	$403buffull 	equ	$404badName 	equ	$406diffsckt	equ	$407manyNBP 	equ	$408NBPaborted	equ	$409BadParamBlock	equ	$40A		MACRO		USE16BIT		LONGA	ON		LONGI	ON		rep	#$30		MEND		MACRO		USE8BIT		LONGA	OFF		LONGI	OFF		sep	#$30		MEND		MACRO		USE16M		LONGA	ON		LONGI	OFF		rep	#$20		MEND		MACRO		use16X		LONGA	OFF		LONGI	ON		rep	#$10		MEND		MACRO		_16BIT16M		LONGA	ON		LONGI	OFF		sep	#$10		MEND		MACRO		IS16BIT		LONGA	ON		LONGI	ON		MEND		MACRO		IS8BIT		LONGA	OFF		LONGI	OFF		MEND		MACRO		IS16M		LONGA	ON		LONGI	OFF		MEND		MACRO		BANK0ENTRY		pea	$E1E1		plb		plb		MEND;_______________________________________________________________________________DDPWrite	PROC	EXPORT; ZP equswdsadr		equ	cmndlist+4databuf 	equ	cmndlist+8wdchksmf	equ	cmndlist+11tmpcksum	equ	cmndlist+12; paramters in write DDPCmChkSum	equ	4CmDstNet	equ	5CmDstNode	equ	7CmDstSckt	equ	8CmSrcSckt	equ	9CmProtTyp	equ	10CmWDS		equ	11; the following constant is incorrect in the rom, it has a bad value of 587 so we need; to patch the write routine to get the correct value.; This has been fixed in ROM 2.maxDDPp1	equ	600		; max number of bytes in long DDP packet + 1maxDDPps	equ	592		; max number of bytes in short DDP packet + 1; error equstablefull	equ	$301scktnotopen	equ	$302socketopen	equ	$303badsocket	equ	$304largeDDP	equ	$305nobridge	equ	$306sdlength	equ	0sddsckt 	equ	2sdssckt 	equ	3sdprotocol	equ	4;...............................................................;; Write DDP packet, use command list;;...............................................................		jsr	CheckAsync	; 7-Oct-91 MSD				IS16BIT		ldy	#CmProtTyp		lda	[cmndlist],y		and	#$00ff		; only want 1 byte		bne	ddpwrite1	; not zero, so valid		lda	#badsocket	; report the error		bra	wderr_1ddpwrite1				;		ldy	#CmDstSckt		lda	[cmndlist],y	; get destination socket		jsr	checkvalidtype	; see if it is ok		bcs	wderr_1 	; no it isn't		ldy	#CmSrcSckt		lda	[cmndlist],y		jsr	checkvalidtype	; see if it is ok		bcs	wderr_1 	; no it isn't		jsr	getlisten	; is socket open ?		beq	wderr		; socket not found		ldx	cmndlist		ldy	cmndlist+2		jsr	DoWrtDDP		bra	wderr_1wderr		lda	#scktnotopen	; else errorwderr_1 	ldy	#2		sta	[cmndlist],y		rtl;...............................................................;; checkvalidtype; checks the socket passed in the low; byte of the accumulator to see if it; is in the valid range;; returns carry clear if it is ok; returns with carry set and error in accum if not ok;;...............................................................		entry	checkvalidtype	;EXPORT -> ENTRY **TGHcheckvalidtype		and	#$00ff		beq	@checkfail	; the check failed		cmp	#$00ff		; see if $ff		beq	@checkfail	; yes, so set error code an leave		clc			; no error		rts@checkfail	sec			; an error occurred		lda	#badsocket	; so return invalid socket type		rts;;...............................................................;;  Internal write DDP routine, (Y,X) points to command list;    result returns in Acc;;...............................................................		IS16BIT		entry	DoWrtDDP	;EXPORT -> ENTRY **TGHDoWrtDDP				;	; make a ddp packet and write it out		stx	databuf		sty	databuf+2		jsr	lforbid		_16BIT16M		ldy	#CmWds		lda	[databuf],y		sta	wdsadr		sta	|wdlapwds		ldy	#CmWds+2		lda	[databuf],y		sta	wdsadr+2		sta	|wdlapwds+2		ldy	#CmDstNet		lda	[databuf],y	; get newtwork #		beq	wrtshort	; 0 is local		cmp	|thisnet		bne	wrtlong 	; another netwrtshort	lda	#5		; short DDP header is 5 byte		sta	[wdsadr]		xba			; reverse of 6502 convention		sta	|wddphead+sdlength		lda	#maxDDPps	; get max short packet size		sta	|wdddpmax	; and save for later compare		USE8BIT		ldy	#CmDstNode		lda	[databuf],y		sta	|wdlapdest		iny		lda	[databuf],y		sta	|wddphead+sddsckt		ldy	#CmSrcSckt		lda	[databuf],y		sta	|wddphead+sdssckt		iny		lda	[databuf],y		sta	|wddphead+sdprotocol		ldx	#1		stx	|wdlaptype	; short ddp is type 1		stz	wdchksmf	; never do checksum on short ddp		USE16M		bra	wddp_2wrtlong 	lda	#13		; long atp header is 13 bytes		sta	[wdsadr]		xba			; reverse of 6502 convention		sta	|wddphead+ldlength		lda	#maxDDPp1	; get max long packet size		sta	|wdddpmax	; and save for later compare		ldy	#CmDstNet		lda	[databuf],y		sta	|wddphead+lddnet		lda	|thisnet		sta	|wddphead+ldsnet		USE8BIT		ldy	#CmDstNode		lda	[databuf],y		sta	|wddphead+lddnode		iny		lda	[databuf],y		sta	|wddphead+lddsckt		lda	|ournode		sta	|wddphead+ldsnode		ldy	#CmSrcSckt		lda	[databuf],y		sta	|wddphead+ldssckt		iny		lda	[databuf],y		sta	|wddphead+ldprotocol		USE16M		ldx	#2		stx	|wdlaptype	; long ddp is protocol 2		stz	|wddphead+ldchksum ; assume no checksum		ldy	#CmChkSum		lda	[databuf],y		tax			; make into 8 bits		stx	wdchksmf		beq	wddp_0		lda	#wddphead+4		sta	databuf 	; calculate checksum of ddp header		ldx	#^ramdata		stx	databuf+2		stz	tmpcksum		lda	#9		jsr	calcchksumwddp_0		lda	|thisnet	; do we have a netwokr # ?		beq	wddp_1a 	; no, send to node		ldx	|abridge	; do we have a bridge		bne	wddp_1b 	; then send it to bridge		USE16BIT		lda	#nobridge		jmp	wddp_8		IS16Mwddp_1a 	ldx	|wddphead+lddnode ; else send it to node in same netwddp_1b 	stx	|wdlapdest	; send to bridge or nodewddp_2		ldy	#2		; copy our header addr to first 4 byte of wds		lda	#wddphead		sta	[wdsadr],y		ldy	#4		lda	#^ramdata		sta	[wdsadr],ywddp_4		clc			; first adjust for size of datagram header		lda	#6		adc	wdsadr		sta	wdsadr		lda	[wdsadr]		ina			; was it $FFFF (7-Oct-91 MSD)		beq	wddp_6		; end of list reached (7-Oct-91 MSD bmi->beq)		clc		lda	|wddphead+sdlength		xba			; convention is opposite of 6502		adc	[wdsadr]		bcs	@toobig		; overflow means way too big! (7-Oct-91 MSD)		cmp	|wdddpmax	; too many bytes?		blt	wddp_4A 	; size still OK@toobig		USE16BIT		lda	#largeDDP	; else error		bra	wddp_8		IS16Mwddp_4A 	xba		sta	|wddphead+sdlength		ldx	wdchksmf		beq	wddp_4		; no need to calculate checksum		ldy	#2		lda	[wdsadr],y		sta	databuf		ldy	#4		lda	[wdsadr],y		tax			; 8 bits		stx	databuf+2	; 24 bit address		lda	[wdsadr]	; get size		jsr	calcchksum		bra	wddp_4wddp_6		ldx	wdchksmf	; done with list		beq	wddp_7		; no need to adjust checksum		lda	tmpcksum		bne	wddp_6a		dec	A		; if zero use $FFFFwddp_6a 	xba			; appletalk conventin opps of 6502		sta	|wddphead+ldchksumwddp_7					;		USE16BIT		lda	#LapWrtCmd		sta	|wdlapcmnd		ldx	#wdlapcmnd		ldy	#^ramdata		jsr	ADispatch		lda	|wdlaprslt	; get back errorwddp_8		jsr	lpermit		rts;...............................................................;;  calculate checksum for a number of bytes;  running checksum in tmpcksum;  buffer point to by databuf;  byte count in Acc;...............................................................;		IS16Mcalcchksum				;		USE16BIT		ldy	#0		tax			; number of bytes		inxchksum_0	dex		beq	chksum_9		lda	[databuf],y		and	#$00FF		clc		adc	tmpcksum		clc		bpl	chksum_1		secchksum_1	rol	A		sta	tmpcksum		iny		bra	chksum_0chksum_9				;		_16BIT16M		rts;...............................................................;;  open a DDP socket using parameter list;...............................................................		IS16BITCmOSKSkt	equ	4CmOSKLst	equ	5		EXPORT	opensktopenskt 		jsr	CheckAsync	; 7-Oct-91 MSD				USE8BIT		ldy	#CmOSKSkt		lda	[cmndlist],y		USE16BIT		bmi	opnskt_6	; dynamic may not be fixed		bne	opnskt_3	; well known, then try it		ldx	|lastIndex	; dynamic, generate oneopnskt_1	inx		inx		inx		inx		cpx	#127*4		bcc	opnskt_2	; OK if less than max		ldx	#0opnskt_2	cpx	|lastIndex	; did we use it all		beq	opnskt_8	; yes		bit	|dynamtable+2,x ; is it occupied ?		bmi	opnskt_1	; yes, check more		stx	|lastIndex		txa		lsr	a		lsr	a		USE8BIT		adc	#$80		; find dynamic socket #		ldy	#CmOSKSkt		sta	[cmndlist],y		USE16BITopnskt_3	and	#$00FF		asl	a		asl	a		tax		lda	#socketopen	; assume error		bit	|listenTable+2,X ; check if occupied for well known		bmi	opnskt_9	; yes, then error		ldy	#CmOSKLst		lda	[cmndlist],y		sta	|listentable,x		iny		iny		lda	[cmndlist],y		ora	#$8000		sta	|listentable+2,x		lda	#0		bra	opnskt_9opnskt_6	lda	#badsocket		bra	opnskt_9opnskt_8	lda	#tablefullopnskt_9	ldy	#2		sta	[cmndlist],y		rtl;...............................................................;;  close a DDP socket using parameter list;...............................................................;		IS16BITCmClsSkt	equ	4		EXPORT	closesktcloseskt		jsr	CheckAsync	; 7-Oct-91 MSD				ldy	#CmClsSkt		lda	[cmndlist],y		jsr	checkvalidtype	; see if socket type is valid		bcs	clseddp_9	; return the error		asl	a		asl	a		tax		lda	#scktnotopen	; assume error		bit	|listenTable+2,x ; check into table		bpl	clseddp_9	; no entry there, error		stz	|listenTable+2,xclseddp_8	lda	#0clseddp_9	ldy	#2		sta	[cmndlist],y		rtl;...............................................................;;  get listener address for a socket	;      socket in Acc;      listener address return in Y,X (3 bytes only);      if no listener, zero flag is set;...............................................................;		IS16BIT		entry	getlisten	;EXPORT -> ENTRY  **TGHgetlisten				;		EXPORT	ddpchecksktddpcheckskt				;			and	#$00FF		; zero is illegal		asl	a		asl	a		tax		bit	|listentable+2,x		bpl	nocontent		ldy	|listentable+2,x		lda	|listentable,x		tax		rep	#02		; set nonzero flag		rtsnocontent	ldx	#0		; empty, return NIL		txy		rts;...............................................................;;  read header part of protocol into reserved memory	;      size in Acc;      buffer in in X			;      carry set if error;...............................................................		IS16BITreadheader	ldy	#^ramdata		sec		jsr	LAPRead		clc		tay		beq	RdRts		jsr	discard		secRdRts		rts;...............................................................;;  discard the packet;...............................................................		IS16BIT		entry	discard 	;EXPORT -> ENTRY  **TGHdiscard 				;			sec		lda	#$8000		jmp	lapread;...............................................................;;  protocol handler for short DDP;...............................................................		IS16BIT		entry	ShortDDP	;EXPORT -> ENTRY  **TGHShortDDP				;			jsr	checkLength		beq	sddp_0		jmp	reject_2sddp_0		clc		lda	#5+buf_data		adc	cmndlist		sta	|tmpNBPPtr		lda	#5		ldx	#ddphead		jsr	readheader	; read the DDP header		bcc	sddp_1		rtlsddp_1					;		_16BIT16M		ldx	#1		; short DDP is protocol 1		stx	|lapprot		lda	|ddphead+sddsckt ; since 16 bit inculde ssckt		sta	|ddphead+lddsckt ; since 16 bit inculde ssckt		ldx	|ddphead+sdprotocol		stx	|ddphead+ldprotocol		ldx	|lapdest		stx	|ddphead+lddnode		ldx	|lapsrce		stx	|ddphead+ldsnode		stz	|ddphead+ldsnet ; short ddp has zero net number		stz	|ddphead+lddnet ; ' '		stz	|ddphead+ldchksum ; zero out the checksum on short packet				bra	readddp;...............................................................;;  protocol handler for long DDP;...............................................................		IS16BIT		entry	LongDDP 	;EXPORT -> ENTRY  **TGHLongDDP 				;			jsr	checkLength		bne	reject_2		ldy	#buf_data+ldchksum		lda	(cmndlist),y		beq	long_0		xba		ldy	#buf_CkSum		cmp	(cmndlist),y		bne	reject_2long_0		clc		lda	#13+buf_data		adc	cmndlist		sta	|tmpNBPPtr		lda	#13		ldx	#ddphead		jsr	readheader		bcs	rddpdone	; if error try next packet		_16BIT16M		ldx	#2		; long DDP is prot 2		stx	|lapprot		lda	|ddphead+lddnet		beq	long_1		; zero match anything		cmp	|thisnet	; filter out wrong net		bne	reject_1long_1		ldx	|ddphead+lddnode ; is it address to us ?		cpx	|ournode		beq	readddp		cpx	#$FF		; is it broadcast		bne	reject_1readddp 	ldx	|ddphead+lddsckt ; packet for which socket		beq	reject_1	; type 0 not allowed		txa		USE16BIT		jsr	getlisten	; search the socket table		beq	reject_2	; no listener		stx	execaddr		tya		and	#$00FF		; mask off high byte		sta	execaddr+2		ora	execaddr	; any routine ?		beq	reject_2	; none, throw away packet		lda	#lapdest		sta	cmndlist		jmp	GoComprddpdone	rtl;		IS16Mreject_1				;		USE16BITreject_2	jsr	discard		rtl;; make sure packet is of right length;checkLength				;		BANK0ENTRY		ldy	#buf_dest		lda	(cmndlist),y		sta	|lapdest		ldy	#buf_data	; get header claim length		lda	(cmndlist),y		xba		and	#$03FF		ldy	#buf_len		cmp	(cmndlist),y		rts;;...............................................................;;  socket listener for RTMP	;...............................................................;		entry	RTMPlisten	;EXPORT -> ENTRY  **TGHRTMPlisten				;			BANK0ENTRY		lda	|ddphead+ldprotocol ; RTMP is type 1		and	#$00FF		cmp	#1		bne	rtmp_8		; not RTMP, discard		lda	#4		ldx	#tempnet		jsr	readheader		bcs	rtmp_9		; if error, already discarded		USE8BIT		lda	|bridgebit		cmp	#8		bne	rtmp_7		lda	|tempbridge	; we can update bridge information		sta	|abridge		USE16BIT		lda	|tempnet		sta	|thisnet		lda	#4*180		; we need 180 seconds since interrupts		sta	|RTMPTmTimer	; get turned off so much...		lda	|RTMPTmCmd	; do we have a timer yet		bne	rtmp_8		; then no need to install one		lda	#InstTimCmd		sta	|RTMPTmCmd	; command for install		lda	#RTMPTimer		sta	|RTMPTmTsk		lda	#^RTMPTimer		sta	|RTMPTmTsk+2		ldx	#RTMPTmCmd		ldy	#^ramdata		jsr	ADispatchrtmp_7					;		USE16BITrtmp_8		jsr	discard 	; disregard everything elsertmp_9		rtl;...............................................................;;  RTMP timer has expired, bridge information no longer valid	;...............................................................;RTMPTimer				;			BANK0ENTRY		USE8BIT		stz	|abridge		USE16BIT		stz	|RTMPTmCmd	; no more RTMP timer		rtl		ENDP;_______________________________________________________________________________;...............................................................;;  NBP Name register						;...............................................................;nbpregname	PROC	EXPORT		IS16BIT		ldy	#$10		; offset to socket number		lda	[cmndlist],y		jsr	checkvalidtype	; see if it is ok		bcc	@regoksofar	; no it isn't@regbadskt	lda	#diffsckt	; bad socket number		brl	NBPImdErr	; exit with error@regoksofar		jsr	getlisten	; is socket open ?		beq	@regbadskt	; socket is not open, so error		ldy	#CmEntAdr		lda	[cmndlist],y		clc		adc	#9		sta	nbpbfptr		ldy	#CmEntAdr+2		lda	[cmndlist],y		adc	#0		; add in any carry that might have happened		sta	nbpbfptr+2		jsr	checkvalidzentity ; check for all three fields as valid		USE16BIT		; put back into 16 bit mode		bcc	checkSetIt	; name was validrgnameisbad				;		lda	#badName		bra	NBPImdErrcheckSetIt				;		USE8BIT		ldy	#CmSetIt		lda	[cmndlist],y		USE16BIT		beq	checkfirst		jsr	GetName 	; see if name already in table		bne	RegFail 	; yes, so return error		jsr	AddName 	; don't bother to check		bra	NBPImdErr	; store error that came back from addcheckfirst	jsr	GetName 	; is name alreay in table		beq	NBPst1		; no then look in netRegFail 	lda	#duplname		bra	NBPImdErrNBPFail 				;		USE16BIT		lda	#manyNBPNBPImdErr	ldy	#2		sta	[cmndlist],y		jmp	chkiocmpcheckvalidname				; ;checks to see if the name passed with offset of y		IS8BIT		lda	[nbpbfptr],y	;get length field		beq	nameisbad	;zero len names not allowed		cmp	#33		;see if too large		bcs	nameisbad		clc			;return no error		rtsnameisbad	sec		rts			;return with error;		    entry checkvalidentity  ; COMMENTED OUT  **TGHcheckvalidentity			;			USE8BIT		ldy	#0		;offset to name field		jsr	checkvalidname	;see if name is valid		bcs	checkvaliddone	;no, so return the error		ldx	#1		;find offset to type field		ldy	#0		jsr	calclng1	;find position of type field		jsr	checkvalidname		bcs	checkvaliddone	;type is bad		ldx	#1		;find offset to zone field		jsr	calclng1	;find position of zone field		lda	[nbpbfptr],y	;get length of zone field		cmp	#33		;see if too large (sets carry if it is)checkvaliddone				;		rts			;will return with carry set if error		entry	checkvalidzentity ; EXPORT -> ENTRY  **TGHcheckvalidzentity		USE8BIT		ldy	#0		; points to entity name		ldx	#2		; skip two fileds			jsr	calclng1	; calulate length of first two fields		tay		USE16BIT		lda	[nbpbfptr],y		cmp	#$2A01		; zone must be '*'		bne	chkvzeisbad	; it was not '*' so it is bad		jsr	checkvalidentity ;see if entity name is valid		bcc	chkvzereturn	; name is ok, so no error yetchkvzeisbad	sec			; indicate an errorchkvzereturn		rtsBadNameErr				;		USE16BIT		lda	#badName		bra	NBPImdErr;;...............................................................;;  NBP Name Look Up						;...............................................................;;		IS16BIT		EXPORT	nbplookupnbplookup				;			ldy	#CmRspCnt	; no reply received yet		bra	preNBPsetup	; call NBP set up and return;;...............................................................;;  NBP Name Confirm						;...............................................................;;		IS16BIT		EXPORT	nbpconfirmnbpconfirm				;			ldy	#CmCfmActSkt	; no socket receivedpreNBPsetup				; ;come here to set nbpbfptr		phy			;save previous offset		ldy	#CmEntAdr	;offset to entity name		lda	[cmndlist],y	;get low word		sta	nbpbfptr		iny		iny		lda	[cmndlist],y	;get high word		sta	nbpbfptr+2		ply			;recover offset and fall through;;...............................................................;; common routine between LookUp, Confirm and Register;     they all send out LKUP packets and wait for reply;...............................................................;NBPsetup				;		USE8BIT		lda	#0		sta	[cmndlist],y		USE16BITNBPst1					;		USE8BIT		jsr	checkvalidentity ;see if the entity name is valid		bcs	BadNameErr	;no, so leave		USE16BIT		lda	|nbpptrsave+1	; are we still doing another NBP operation ?		beq	@nbpnottoomuch	; we are ok		jmp	NBPFail 	; NBP is already in use@nbpnottoomuch		jsr	lforbid 	; play it safe		lda	#$04FF		; make it busy		ldy	#2		sta	[cmndlist],y		USE8BIT		inc	|outnbpid		ldy	#CmRetry		lda	[cmndlist],y	; retry count		ldy	#CMTryLft		sta	[cmndlist],y		jsr	NBPquery	; make the first query to the network		USE16BIT		lda	cmndlist		sta	|nbpptrsave		lda	cmndlist+2		sta	|nbpptrsave+2		jsr	lpermit 	; done, just wait for result		rtl;...............................................................;; NBP timeout, maybe time to resend packet or terminate command; ZP used are those used by dowrtddp;...............................................................;		IS16BITNBPtimeout				;			BANK0ENTRY		USE16M		lda	|nbpptrsave+1		sta	cmndlist+1		beq	Ntrts		; pointer nil, just return		USE8BIT		lda	|nbpptrsave		sta	cmndlist		USE16BIT		lda	|NBPTmCmd+2		cmp	#$0106		;timer cancled?		bne	conttout	;branch if not.		stz	|NBPTmCmd	;out timer is out.		lda	#NBPaborted		bra	nbperrorconttout	USE8BIT		ldy	#CMTryLft		lda	[cmndlist],y		beq	querycmp	; all retry has been used, terminate command		sec		sbc	#1		sta	[cmndlist],y		jsr	NBPquery	; send another LKUPNtRts					;		USE16BIT		rtl; operation completed, request failed if CONFIRM, but succeed if REGISTER;		IS8BITquerycmp	stz	|NBPTmCmd	; since timer expired, no need to remove it		stz	|NBPTmCmd+1		ldy	#1		lda	[cmndlist],y		cmp	#NBPLKUP	; what operation ?		USE16BIT		beq	nbpallOK	; look up, it is done		bcs	cfrmcmp 	; confirm, then it has failed		jsr	AddName 	; register and not duplicate, now we can put it up		bra	nbperror	; return error from AddnbpallOK	lda	#0		bra	nbperrorcfrmcmp 	lda	#wrongName	; if to confirm, then it was not confirmed		entry	nbperror	; EXPORT -> ENTRY  **TGHnbperror				;			ldy	#2		; return asyn result byte and also set carry		sta	[cmndlist],y		stz	|nbpptrsave+1	; no more ongoing NBP operation		lda	|NBPTmCmd	; do we still have a timer		beq	chkiocmp	; if no, then do not remove		lda	#RmvTimCmd		sta	|NBPTmCmd	; command for remove		ldx	#NBPTmCmd		ldy	#^ramdata		jsr	ADispatchchkiocmp				;		lda	[cmndlist]	;see if async mode		xba			;we are concerned with the first byte		xba			;so swap twice to get condition for low byte set		bpl	nocomp		;get out, don't do completion		ldy	#4		lda	[cmndlist],y		sta	execaddr		iny		iny		lda	[cmndlist],y		sta	execaddr+2		ora	execaddr		beq	nocomp		jmp	GoComp		; go and execute I/O completion routinenocomp					;		rtl;...............................................................;; send out a LKUP packet;...............................................................		IS8BITNBPquery	ldy	#CmTimOut		lda	[cmndlist],y		ldy	#CmTimLft		sta	[cmndlist],y		lda	#$21		; assume it is LKUP		sta	|outnbp		ldy	#1		lda	[cmndlist],y		cmp	#NBPCFRM		USE16M		beq	nbptim_3	; confirm		stz	|nbpdnet	; it is just local, zero dest net		ldx	|abridge	; do we have a bridge ?		bne	nbptim2A	; yes		dex			; else broadcast		bra	nbptim2Bnbptim2A	ldy	#$11		; go to bridge, command is BRRQ		sty	|outnbpnbptim2B	stx	|nbpdnode	; destination is bridge or broadcast		bra	nbptim_4nbptim_3	ldy	#CmCfmNet		lda	[cmndlist],y		sta	|nbpdnet	; copy dest net		ldy	#CmCfmNode		lda	[cmndlist],y		tay		sty	|nbpdnode	; destination nodenbptim_4	ldy	#2		sty	|nbpprot	; NBP is type 2		sty	|nbpssckt	; from socket 2		sty	|nbpdsckt	; to socket 2		sty	|nbpentity+3	; entity socket ; may not be needed		lda	|thisnet		sta	|nbpentity		lda	[cmndlist]		xba		tax		ldy	#CmEntAdr		lda	[cmndlist],y		cpx	#NBPREGN		bne	nbptim_5		adc	#8		; include carry is plus 9		bra	nbptim_6	; add in any carrynbptim_5	clc			; if we came here we don't want to add any offsetnbptim_6	sta	nbpbfptr		sta	|entityadr		ldy	#CmEntAdr+2		lda	[cmndlist],y		adc	#0		; add in any carry for bank crossing		sta	nbpbfptr+2		sta	|entityadr+2		USE8BIT		ldy	#0		jsr	calcnmln		sta	|entitylen		stz	|entitylen+1		lda	|OurNode		sta	|nbpentity+2		stz	|nbpentity+4		stz	|nbpchksmf	; do not do checksum		USE16BIT		lda	#nbpwds		sta	|nbpwrtab		lda	#^ramdata		sta	|nbpwrtab+2		ldx	#nbpwrarea-4		ldy	#^ramdata		jsr	DoWrtDDP		ldy	#CmTimOut		lda	[cmndlist],y		and	#$00FF		sta	|NBPTmTime		lda	#InstTimCmd	; install timer for repeat query and timeout		sta	|NBPTmCmd		lda	#NBPTimeout		sta	|NBPTmTsk		lda	#^NBPTimeout		sta	|NBPTmTsk+2		ldx	#NBPTmCmd		ldy	#^ramdata		jsr	ADispatch		USE8BIT		rts			; OK, done		ENDP;_______________________________________________________________________________;...............................................................;; socket listener for NBP;...............................................................;		IS16BITNBPlisten	PROC		BANK0ENTRY		ldx	#nbpbfptr		lda	#9		; %%% 27-Jun-91 MSD (was 6)		jsr	saveZP		USE8BIT		lda	#2		; NBP has protocol 2		cmp	|ddphead+ldprotocol		bne	nbplsdone	; if not, discard it		USE16BIT		lda	|tmpNBPPtr		sta	nbpbfptr		USE8BIT		lda	#^ramdata		sta	nbpbfptr+2		ldy	#0		lda	(nbpbfptr),y		tax		and	#$0F		beq	nbplsdone	; no tuple, discard it		sta	|tuplect		txa		and	#$F0		cmp	#$30		; LKUP-REPLY ?		beq	ChkReply	; then put it into tablenbpls_00	cmp	#$20		; LKUP ?		bne	nbplsdone	; no, discard it		jsr	NbpReply	; lookup our table and reply to itnbplsdone				;		USE16BIT		jsr	discard		ldy	#nbpbfptr		lda	#9		; %%% 27-Jun-91 MSD		jsr	restoreZP		rtl;		IS8BITChkReply				;		USE16BIT		lda	|nbpptrsave+1	; are we processing any NBP		sta	cmndlist+1		USE8BIT		beq	nbplsdone	; no, then discard it		lda	|outnbpid		ldy	#1		cmp	(nbpbfptr),y	; is this the one we asked		bne	nbplsdone	; no, then discard it		lda	|nbpptrsave		sta	cmndlist		ldy	#1		lda	[cmndlist],y		cmp	#NBPLKUP		beq	nbpls_04	; try to add it to user buffer		bcs	nbpls3A 	; confirm, then check socket		USE16BIT		lda	#duplname	; register name allow no duplicate		bra	cancellist		IS8BITnbpls3A 	ldy	#5		; confirm, we get a reply, done		lda	(nbpbfptr),y	; get actual socket		ldy	#CmCfmActSkt		sta	[cmndlist],y		dey		cmp	[cmndlist],y	; did it agree with what we ask for?		USE16BIT		bne	nbpls3B 	; different socket		lda	#0		bra	cancellist	; everything is OKnbpls3B 	lda	#diffsckt	; confirmed with wrong socket		IS16BITcancellist	pha		jsl	nbplsdone		pla		jmp	nbperror;		IS8BITnbpls_04				; ; name lookup		USE16BIT		clc		lda	nbpbfptr		adc	#2		sta	nbpbfptr	; skip to first tuple		USE8BITnbpls4A 	dec	|tuplect		bmi	nbplsdone	; all taken care of		USE16BIT		ldy	#CmRsbAdr		lda	[cmndlist],y	; get response buffer and its boundary		sta	tblptr		USE8bit		ldy	#CmRsbAdr+2		lda	[cmndlist],y		sta	tblptr+2		ldy	#CmRspCnt	; get response received, this is current size		lda	[cmndlist],y		tax		inx		stx	nbprcvctnbpls_05	dec	nbprcvct		beq	nbpls_10	; not in table		ldy	#4		; check if item is already in table; here we want to avoid the case when a bridge is turn on and we have a name; record twice, once with network # 0 and once with network number X, so all; local net is made to be 0, since this occur very rarely, we may accept; the error and remove that part;	  USE16M;	  lda (nbpbfptr),y    ; get network number;	  cmp |thisnet;	  bne nbpls_06;	  lda #0;	  sta (nbpbfptr),y    ; local net is same as 0;	  USE8BIT;nbpls_06	lda	[tblptr],y		cmp	(nbpbfptr),y		bne	nbpls_07	; not the same entry		dey		bpl	nbpls_06		jsr	calcleng	; duplicate, ignore itnbpls_6A	clc		adc	nbpbfptr		sta	nbpbfptr		bcc	nbpls4A		inc	nbpbfptr+1		bra	nbpls4Anbpls_07	ldy	#5		; points to entity name		ldx	#3		; repeat for all three fieldsnbpls_08	sec			; add 1 extra		tya		adc	[tblptr],y	; add length count		tay		dex		bne	nbpls_08		clc		adc	tblptr		sta	tblptr		bcc	nbpls_05		inc	tblptr+1		bne	nbpls_05	; second byte not wrapping		inc	tblptr+2	; need to bump third byte		bra	nbpls_05	; check more from tablenbpls_10	jsr	calcleng	; calculate length of name		tax			; save it		use16M		and	#$00FF		clc		adc	tblptr		sec		ldy	#CmRsbAdr		sbc	[cmndlist],y		ldy	#CmRsbSiz		cmp	[cmndlist],y		use8bit		beq	nbpls10A	; just made it		bcs	noroom		; it is buffer fullnbpls10A	txy			; size of itemnbpls_11	dey			; else copy into table		bmi	nbpls_12		lda	(nbpbfptr),y		sta	[tblptr],y		bra	nbpls_11nbpls_12	ldy	#CmRspCnt		clc		lda	[cmndlist],y	; increase item count		adc	#1		sta	[cmndlist],y		dey			; point to CmMaxRsp		cmp	[cmndlist],y	; compare number of response		beq	nbpls_13	; reach required number		txa			; size of item		bra	nbpls_6A	; check morenbpls_13				;		USE16BIT		lda	#0		jmp	cancellistnoroom					;		USE16BIT		lda	#buffull	; assume buffer full		jmp	cancellist;...............................................................;; calculate length of entity name, has three entry points;      calcleng calculate length of name plus address;      calcnmln calculate name only, y points to start location 		;      calclng1 then calcalute 1 or 2 fields by setting X and Y;      use nbpbfptr to point to buffer;      length returns in Acc;;...............................................................		IS8BIT		entry	calcleng	; EXPORT -> ENTRY  **TGHcalcleng	ldy	#5		; points to entity name		entry	calcnmln	; EXPORT -> ENTRY  **TGHcalcnmln	ldx	#3		; repeat for all three fields		entry	calclng1	; EXPORT -> ENTRY  **TGHcalclng1	sec			; add 1 extra		tya		adc	[nbpbfptr],y	; add length count		tay		dex		bne	calclng1		rts;...............................................................;; Add a name to register name link list;...............................................................;;		IS16BIT		entry	AddName 	; EXPORT -> ENTRY  **TGHAddName 				;			jsr	lforbid		USE8BIT		ldy	#CmRegSkt		lda	[cmndlist],y		sta	regsckt		stz	regenum		USE16MAdNam1		ldx	regenum		inx		stx	regenum 	; pick an enumerator		lda	|namelist	; and check the list		sta	tblptr		lda	|namelist+2		sta	tblptr+2AdNam2		lda	tblptr+1	; see if conflict with this one		beq	AdNam5		ldy	#7		lda	[tblptr],y	; queue element socket+enum		tax		cpx	regsckt 	; same socket ?		bne	AdNam4		; then no need to worry		ldx	regenum 	; have we use it all ?		bne	AdNam3		; no, we still have some available		lda	#toomanynames	;there are too many names on this socket		brl	ExitAddName	;exit with errorAdNam3					;		cmp	regsckt 	; same enumerator ?		beq	AdNam1		; then try another oneAdNam4		ldy	#2		; get next queue element		lda	[tblptr],y		pha		lda	[tblptr]		sta	tblptr		pla		sta	tblptr+2		bra	AdNam2		; and keep lookingAdNam5		ldy	#CmEntAdr+2	; now we can fill the entity address		lda	[cmndlist],y		sta	tblptr+2		ldy	#CmEntAdr		lda	[cmndlist],y		sta	tblptr		lda	|namelist		sta	[tblptr]		lda	|namelist+2		ldy	#2		sta	[tblptr],y		lda	tblptr		sta	|namelist		lda	tblptr+2		sta	|namelist+2		lda	|thisnet		ldy	#4		sta	[tblptr],y		lda	regsckt 	; put socket and enumerator in		ldy	#7		sta	[tblptr],y		USE8BIT		lda	|OurNode		ldy	#6		sta	[tblptr],y		USE16BIT		lda	#0		; return with no errorExitAddName				;		USE16BIT		jsr	lpermit		rts;...............................................................;; Check name list for name, exact match only, wild card not used;     name is point to by nbpbfptr;     if found in list, point to it by tblptr, else return 0 in tblptr;...............................................................;;		IS16BIT		entry	GetName 	; EXPORT -> ENTRY  **TGHGetName 				;			USE8BIT		ldy	#0		jsr	calcnmln		sta	nameleng		USE16BIT		lda	|namelist		sta	tblptr		lda	|namelist+2		sta	tblptr+2GetNam_1	lda	tblptr+1		beq	GetNam_9		clc		lda	tblptr		adc	#9		sta	tblptr		; point to entity name		lda	tblptr+2	; add in high word for bank wrap		adc	#0		sta	tblptr+2		USE8BITGetNam_2	ldy	nameleng		deyGetNm2A 	lda	[tblptr],y		jsr	ToUpper		; 1-Jul-91 MSD		sta	tempChar		lda	[nbpbfptr],y		jsr	ToUpper		; 1-Jul-91 MSD		cmp	tempChar		bne	GetNam_4	; name does not agree		dey		bpl	GetNm2A		USE16BIT		sec			; name found, point back to entry element		lda	tblptr		sbc	#9		sta	tblptr		lda	tblptr+2	; subtract any bank wrap		sbc	#0		sta	tblptr+2		lda	#1		; set non-zero flag		rtsGetNam_4				;		USE16BIT		sec		lda	tblptr		sbc	#9		sta	tblptr		lda	tblptr+2	; subtract any bank wrap		sbc	#0		sta	tblptr+2		ldy	#2		lda	[tblptr],y		tax		lda	[tblptr]		sta	tblptr		stx	tblptr+2		bra	GetNam_1GetNam_9	rts;...............................................................;; Remove name from registration;...............................................................;		IS16BIT		EXPORT	nbpremovenbpremove		jsr	CheckAsync	; 7-Oct-91 MSD		jsr	lforbid		ldy	#CmRmvEntity		lda	[cmndlist],y		sta	nbpbfptr		ldy	#CmRmvEntity+2		lda	[cmndlist],y		sta	nbpbfptr+2		jsr	checkvalidzentity ; check for all three fields as valid		USE16BIT		; put back into 16 bit mode		bcc	nbpremovenmvld	; name is ok, so no error yet		lda	#badName	; the name is bad so return with error		jmp	RmvNam_9	; show the errornbpremovenmvld				;		jsr	GetName		beq	RmvNam_8		lda	|namelist		sta	nbpbfptr		cmp	tblptr		php		lda	|namelist+2		sta	nbpbfptr+2		plp		bne	RmvNam_1	; is it the first entry ?		cmp	tblptr+2		beq	RmvNam_4	; it is the first entryRmvNam_1	lda	[nbpbfptr]	; is it the next entry?		tax		ldy	#2		lda	[nbpbfptr],y		cmp	tblptr+2		bne	RmvNam_2		cpx	tblptr		beq	RmvNam_3	; yes, it is the next entryRmvNam_2	stx	nbpbfptr	; not the next, look more in queue		sta	nbpbfptr+2		bra	RmvNam_1RmvNam_3	lda	[tblptr]	; remove next item from queue		sta	[nbpbfptr]		lda	[tblptr],y		sta	[nbpbfptr],y		bra	RmvNam_5RmvNam_4	ldy	#2		; first name on list, update namelist		lda	[tblptr],y		sta	|namelist+2		lda	[tblptr]		sta	|namelistRmvNam_5	lda	#0		bra	RmvNam_9RmvNam_8	lda	#wrongnameRmvNam_9	ldy	#2		sta	[cmndlist],y		jsr	lpermit		rtl;...............................................................;; Check register list to see if name matches, if it agree, reply to it;...............................................................;;		IS8BITNbpReply	ldy	#1		lda	(nbpbfptr),y		sta	|replyNID		ldy	#4		lda	(nbpbfptr),y	; request node		cmp	|OurNode	; check if same as ours		USE16M		bne	NbpRp_0 	; nothing to worry		ldy	#2		lda	(nbpbfptr),y	; net work number		beq	ItIsMe		; I am the requestor, ignore it		cmp	|thisNet	; same net work ?		bne	NbpRp_0ItIsMe					;		USE8BIT		rts		IS16MNbpRp_0 	jsr	InitReply		lda	|namelist		sta	tblptr		lda	|namelist+2		sta	tblptr+2NbpRp_1 	lda	tblptr+1		beq	NbpRp_8		ldy	#7		sty	tempy1		ldy	#9		sty	tempy2		jsr	CmpItem 	; does object name agree ?		bne	NbpRp_2 	; no,		jsr	CmpItem 	; does type agree		beq	NbpRp_3 	; yes, then we can replyNbpRp_2 	ldy	#2		; no, then check next element		lda	[tblptr],y		pha		lda	[tblptr]		sta	tblptr		pla		sta	tblptr+2		bra	NbpRp_1NbpRp_3 	lda	|thisnet	; get latest net number		ldy	#4		; in case net number not available earlier		sta	[tblptr],y					;		USE8BIT		sec			; add in field length		ldy	tempy2		tya		adc	[tblptr],y		sec			; find name length		sbc	#4		USE16M		and	#$00FF		ldx	nbptbdisp		sta	|nbprptable,x		inx		inx		clc		lda	tblptr		adc	#4		sta	|nbprptable,x		inx		inx		lda	tblptr+2		adc	#0		; add in for bank wrap		sta	|nbprptable,x		inx		inx		stx	nbptbdisp		ldy	|rptupcount		iny		sty	|rptupcount		cpy	#4		bne	NbpRp_2 	; go and check more		USE16BIT		ldx	#tblptr 	; clobbered so save it first		lda	#7		jsr	saveZP		_16BIT16M		jsr	DoNbpReply	; table filled, write it out		USE16BIT		ldy	#tblptr		lda	#7		jsr	restoreZP		_16BIT16M		bra	NbpRp_2NbpRp_8 	ldx	|rptupcount	; do we have any matches		beq	NbpRp_9 	; no		jsr	DoNbpReply	; else write it outNbpRp_9 				;		USE8BIT		rts;...............................................................;; do the actual reply						;...............................................................;;		IS16MDoNbpReply	lda	#$FFFF		ldx	nbptbdisp		sta	|nbprptable,x	; end of table marker		ldy	#2		lda	(nbpbfptr),y	; dest network		sta	|nbpdnet		ldy	#4		lda	(nbpbfptr),y	; dest node and socket		sta	|nbpdnode		USE8BIT		stz	|nbpchksmf		lda	|rptupcount		ora	#$30		; a LkUp-reply tuple		sta	|rptupcount		USE16BIT		lda	#nbprptable		sta	|nbpwrtab		lda	#^ramdata		sta	|nbpwrtab+2		ldx	#nbpwrarea-4		ldy	#^ramdata		jsr	DoWrtDDP	; reply to it, ignore any error		_16BIT16M		jsr	InitReply		rts;		IS16MInitReply				;		ldx	#12		stx	nbptbdisp		ldx	#0		stx	|rptupcount		rts;...............................................................;; CmpItem --	Compare a string from a tuple in a packet (source);		to a tuple in a names table entry (destination).;;		The source string can be '=' or 'Å' to match all;		of the destination.  The source string can contain;		a single 'Å' to match zero or more characters in;		the destination.  Matches are case-insensitive,;		including diacriticals defined in Inside AppleTalk;		Second Edition, Appendix D, Table D-2 (page D-3).;; On entry:;	16-bit A, 8-bit X,Y;	(nbpbfptr) + tempy1;		points to length byte of string from packet;	[tblptr] + tempy2;		points to length byte of string in names table; On exit:;	16-bit A, 8-bit X,Y;	Z flag set iff strings match (i.e. BEQ will branch on match);; General Algorithm:;	If source is "=" or "Å", then it matches (return with Z set);	WildOffset := position of first 'Å' in source;	If no 'Å' in source, just compare whole string directly;	See if part to left of 'Å' matches:;		Match left hand (WildOffset - 1) characters;		Don't test length bytes!;	See if part to right of 'Å' matches:;		Compute length of part to right of 'Å';		Compute offset of part to right of 'Å';		Match right hand parts of both strings;...............................................................;;WildChar	equ	'Å'		; $C5		IS16MCmpItem		ldy	tempy1		; point to start of source string		lda	(nbpbfptr),y	; get length byte and first char		cmp	#$3D01		; test special case of "="		beq	@return		; it matches!		cmp	#$C501		; test special case of "Å"		beq	@return		; it matches, too!		USE8BIT;; Search for first 'Å' in source string;		tax			; put string length in X@scan		iny			; point to next char in string		lda	(nbpbfptr),y		cmp	#WildChar	; is it the wildcard?		beq	@found		; yes, remember where we found it		dex			; any more chars left to scan?		bne	@scan;; Here, no wildcard was found.  Therefore, test the whole string; including the length bytes (test source length + 1 bytes).;		ldy	tempy1		; get offset in lookup buffer		sty	nbpoff1		; save as offset for first item		lda	tempy2		; get offset in names table entry		sta	nbpoff2		; save as offset for second item		lda	(nbpbfptr),y	; get length byte		ina			; add 1 for length byte + string		jsr	@cmpsub		; do case-insensitive substring compare		bra	@return		; return the results;; Here, there was a wildcard found.  See if there was anything to; the left of the wildcard.  If so, compare the substrings.; Y = index of wildcard.  So, Y - tempy1 - 1 is amount to left of; the wildcard.;@found;; First, if length(source)-1 > length(dest) than it is not possible; to match since if you replaced the wildcard character with the empty; string (hence the -1 above), the result would be longer than the dest; string (and no longer substitution could match either).;; For ease of comparison, I will test for length(dest)+1 < length(source);		sty	wildoff		; remember offset of wildcard				ldy	tempy2		lda	[tblptr],y	; get length(dest)		ina			; length(dest)+1		ldy	tempy1		cmp	(nbpbfptr),y	; compare to length(source)		ldy	wildoff		; restore Y.  Will set Z=0.		blt	@return		; len(dest)+1 < len(source), so exit				tya			; get back index of wildcard char		clc			; subtract one for length byte		sbc	tempy1		; find amount left of wildcard		beq	@end		; nothing to left, must be to the right				ldy	tempy1		; offst of source length byte		iny			; offset of first char in source		sty	nbpoff1		; that's where we start to compare				ldy	tempy2		; offset of dest length byte		iny			; offset of first char in dest		sty	nbpoff2		; that's where we start compare				jsr	@cmpsub		; compare left hand parts		bne	@return		; exit now if they don't match		;; Here, see if there is something to the right of the wildcard.; Note that Y still has offset in buffer of wildcard.;; The number of characters to the right of the wildcard is:;	offset of length byte + string length - offset of wildcard; (Trust me.  Try it out on paper.);@end		ldy	tempy1		; get offset to length byte		tya			; it's one of the things we add		clc		adc	(nbpbfptr),y	; add length byte.  A now has					; offset of last char of string		sec		sbc	wildoff		; minus wildcard offset gives us					; number of chars to right of wildcard		beq	@return		; none, so it matches!		pha			; save # of chars to compare;; Now we need to figure out the offset into the dest string where we start; comparing.  That value is:;	offset of length byte + length byte - size of right side + 1;		ldy	tempy2		; get offset of length byte		tya			; it's one of the things we add		sec			; here's the "+1" above		adc	[tblptr],y	; add length byte		sec		sbc	1,s		; subtract size of right side		sta	nbpoff2		; save as offset to dest string		pla			; get back # of chars to compare; Did we underflow (i.e. carry clear) on SBC above?  If so, the dest; string was shorter than the part of source to the right of wildcard; Note: the PLA above cleared Z since A cannot be zero (otherwise we; would have taken the BEQ @RETURN above).		bcc	@return		; dest is too short, no match				ldy	wildoff		iny		sty	nbpoff1		; compare starting after wildcard char				jsr	@cmpsub		; see if right side matches;; Here, the Z flag is set correctly.  Make sure we're in the right mode.;@return		USE8BIT			; make sure we're in 8-bit mode!		php			; save state of Z flag;; Point tempy1 past end of string;		ldy	tempy1		tya		sec			; add 1 for length byte		adc	(nbpbfptr),y		sta	tempy1;; Point tempy2 past end of string;		ldy	tempy2		tya		sec			; add 1 for length byte		adc	[tblptr],y		sta	tempy2				plp			; restore Z flag				USE16M		rts;------------------------------------------------------------; @cmpsub -- like CmpItem except it uses nbpoff1 and nbpoff2; instead of tempy1 and tempy2.  It also doesn't check for; wildcards.  It does do case-insensitive compares of the; characters and knows about AppleTalk's diacriticals.;; On entry:;	8-bit A,X,Y;	(nbpbfptr),nbpoff1 is first substring;	[tblptr],nbpoff2 is second substring;	A = number of characters to compare.;	(A is non-zero); On exit:;	8-bit A,X,Y;	Z = 1 iff strings are equal;------------------------------------------------------------		IS8BIT@cmpsub		tax@cmploop		ldy	nbpoff1		inc	nbpoff1		lda	(nbpbfptr),y		jsr	ToUpper				sta	tempChar				ldy	nbpoff2		inc	nbpoff2		lda	[tblptr],y		jsr	ToUpper				cmp	tempChar		bne	@nomatch		dex		bne	@cmploop					; Z=1 => match, return@nomatch		rts;------------------------------------------------------------; ToUpper -- Convert char in A to its upper-case equivalent.; Diacriticals recognized by AppleTalk are also converted.;; Note: Only A and the processor status are changed.;------------------------------------------------------------		export	ToUpperToUpper		bit	#$80		; high bit set?		bne	@diacritical	; yes, so try diacriticals				cmp	#'a'		blt	@gotit		; less than lower case letters		cmp	#'z'+1		bge	@gotit		; greater than lower case letters				and	#$5F		; convert lower to upper@gotit		rts@diacritical		phx			; preserve X		ldx	#diac_count-1	; max index into table + 1 for dex below@loop		cmp	>@lower,x	; is it that lower case diacritical?		beq	@found		; yes, so convert it		dex		bpl	@loop		plx			; here, no match so leave it alone		rts@found		lda	>@upper,x	; get corresponding upper case		plx		rts@lower		dc.b	$88,$8A,$8B,$8C,$8D,$8E,$96,$9A,$9B,$9F,$BE,$BF,$CF@upper		dc.b	$CB,$80,$CC,$81,$82,$83,$84,$85,$CD,$86,$AE,$AF,$CEdiac_count	equ	@upper-@lower				ENDPnbpkill 	PROC			EXPORT		IS16BIT		jsr	CheckAsync				ldy	#4		lda	[cmndlist],y		cmp	|nbpptrsave		bne	badexit		iny		iny		lda	[cmndlist],y		cmp	|nbpptrsave+2		beq	goodpbbadexit 	lda	#BadParamBlock		bra	exitgoodpb		lda	|nbptmcmd		beq	justleave		pei	cmndlist		pei	cmndlist+2		lda	#CnclTmCmd		sta	|nbptmcmd		ldx	#nbptmcmd		ldy	#^ramdata		jsr	ADispatch		pla		sta	cmndlist+2		pla		sta	cmndlistjustleave	lda	#0exit		ldy	#2		sta	[cmndlist],y		rtl		ENDP;_______________________________________________________________________________DDPInit 	PROC	EXPORT		IS16BIT		stz	|lapdest	; clear to zero		ldx	#lapdest		ldy	#lapdest+1		lda	#NBPEnd-lapdest-2		mvn	ramdata,ramdata		USE8BIT		ldy	#9		; findout node number		lda	[cmndlist],y		sta	|ourNode		USE16BIT		lda	#7		; initialize nbpwds		sta	|nbpwds+6		lda	#outnbp		sta	|nbpwds+8		lda	#^ramdata		sta	|nbpwds+10		lda	#$FFFF		sta	|nbpwdsend		lda	#2		sta	|nbprptable+6		lda	#rptupcount		sta	|nbprptable+8		lda	#^ramdata		sta	|nbprptable+10		lda	#1		; install short DDP handler		ldx	#ShortDDP		ldy	#^ShortDDP		sec		jsr	lattachprot		lda	#2		; install long DDP handler		ldx	#LongDDP		ldy	#^LongDDP		sec		jsr	lattachprot		ldx	#OpenRTMP	; install RTMP listener		ldy	#^OpenRTMP		jsr	ADispatch		ldx	#OPENNBP	; install NBP listener		ldy	#^OPENNBP		jsr	ADispatch		ldx	#RTMPreq	; do RTMP request		ldy	#^RTMPreq		jsr	ADispatch		rts;;OpenRTMP	DC.W	OpnSktCmd		DC.W	0		DC.B	1		DC.L	RTMPListenOpenNBP 	DC.W	OpnSktCmd		DC.W	0		DC.B	2		DC.L	NBPListenRTMPReq 	DC.W	LapWrtCmd		DC.W	0		DC.B	$FF		; broadcast		DC.B	1		; short DDP		DC.L	RTMPBDSRTMPBDS 	DC.W	6		; 6 byte header		DC.L	RTMPhead		DC.W	$FFFF		; end of tableRTMPhead	DC.B	0,6		; header length		DC.B	1		; to socket 1		DC.B	1		; from socket 1		DC.B	5		; prototype 5		DC.B	1		; command 1		ENDP;_______________________________________________________________________________		END