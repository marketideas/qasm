********************************************************************************* File:	APTALK** Contents:	aptalk.aii,*	ATP_INCLUDES.Aii,*	lap_includes.aii** rev 00	Original ROM* rev 01	Second ROM** This file contains the 65816 implementation of ATP for the Apple IIGS.* This file also contains the main AppleTalk dispatcher and core routines.** Copyright Apple Computer, 1986-1992* Original Author: Ed Lai, Greg Seitz********************************************************************************** NOTE** This file would normally just patch any correction in ROMs =< 01, but* since there were so many corrections to those roms, we just patch out* the entire thing with the APTALK file.** NOTE: the following lines were changed to get around a problem* in the Mac2Gs assembler:**  atp.ddpstuff (label opendriver) changed resetcode**  atp.core (before	label vectortab) changed Dispatch********************************************************************************** Modification History** REV 03** 8/19/88    TGH   - Started working on RevD ROM** 3/27/88    TGH   - Added OnExitVector**  1-Jul-91  MSD	Added support for variable TRel timeouts on XO Treq packets.*	This forced the response control block to grow by one byte*	to accomodate a 2-byte timeout field.**  2-Jul-91  MSD	Added code for ROM 3 to change the hard-coded references to*	$C7xx to either $C1xx or $C2xx.** 10-Aug-91  MSD	Changed maxatpsize from $578 to 578.** 23-Aug-91  MSD	Changed version string to 3.0d1.** 26-Sep-91  MSD	Version 3.0d2.  The values from the TRel timers were being*	gotten from bank $E1 instead of the code bank.  Use long*	indexed with X instead of absolute indexed with Y.** 27-Sep-91  MSD	Changed watppkt to check for a length of $FFFF and return*	ATP data too large ($0501).  Normally, DDP would catch*	this error but $FFFF signals the end of a WDS.**  4-Oct-91  MSD	The routines that handled retransmission of ATP send requests*	and timed out response control blocks for XO send responses*	were not doing a SEC before they did SBC DECVAL (where DECVAL*	is the number of ticks that have elapsed).  This was causing*	response control blocks to time out too fast (it would*	subtract 2 instead of 1 from the timer because carry was*	clear when the routine was called).**  7-Oct-91  MSD	Sync-only calls now check the async flag.**  8-Oct-91  MSD	The 7-Oct-91 change caused opening of an ATP socket to fail*	because it wasn't clearing the async flag before doing trying*	to open a DDP socket.  Fixed ddpopenskt and closeddpskt to*	explicitly clear the async flag at parmlist ($E1/DA18).**  7-Feb-92  MSD	Changed version to 4.0 final for 6.0d70 (GM) build.********************************************************************************	MACHINE M65816	IMPORT Dispatch	IMPORT attachprot	IMPORT ddpcheckskt	IMPORT ddpinit	IMPORT ddpwrite	IMPORT forbid	IMPORT getglobal	IMPORT getinfo;	IMPORT invalidseq		;We don't need this	IMPORT lapresetinit	IMPORT lapinit	IMPORT lapread	IMPORT lapwrite	IMPORT nbpconfirm	IMPORT nbplookup	IMPORT nbpregname	IMPORT nbpremove	IMPORT nbpkill	IMPORT openskt	IMPORT permit	IMPORT removeprot	IMPORT stackrestore	IMPORT stacksave	import longforbid,longpermit,closeskt	import CheckAsync		ENTRY opendriver,\		;Command vectors	      installqtr,\	      removeqtr,\	      bootcode,\	      atpsendrequest,\	      cancelreq,\	      openatpsocket,\	      closeatpsocket,\	      getrequest,\	      sendresponse,\	      relrspcb;	entry opendriver,installqtr,removeqtr,bootcode;	entry atpsendrequest,cancelreq,openatpsocket,closeatpsocket;	entry getrequest,sendresponse,relrspcb		entry gocomp,bootstart,bootend,iend	entry atplisten,ddpopenskt,sndrqpkt,waitdone,retasynflag	entry readatpheader,rsptable,onebitmask,readrbds,lowbitmask	entry killrequest,watppkt	entry canceltable,closeddpskt,attachtable	entry lowbitmask,reltable,grqtable	entry rspcbtable,iparmstart,entityblk	entry openparms,initparms	ENTRY hardreset	;cold boot entry point	ENTRY softhandler	;soft reset entry;------------------------------------------------------------------------------;; Equates from procedure constants;;------------------------------------------------------------------------------small	equ 1	;remove addresponsecode	equ $000800	;boot code comes in	heresline	equ $000480	;print on this lineromread	equ $c081lcbank2	equ $c083statereg	equ $c068cyareg	equ $c036fixstatereg	equ $6024	;Now in LAP......emulstack	equ $010100databank	equ $e1e1e1incbusyflag	equ $e10064	;scheduler routinesdecbusyflag	equ $e10068nbit	equ $80vbit	equ $40mbit	equ $20xbit	equ $10ibit	equ $04zbit	equ $02cbit	equ $01rspval	equ 120	;30 seconds for rspcb timeratpxobit	equ $20atpeombit	equ $10atpstsbit	equ $08;------------------------------------------------------------------------------;; Equates from procedure intface;;------------------------------------------------------------------------------Extended	equ $e11000	;RAM vectors.  Extended interface entry.Basic	equ Extended+4	;Basic entry.Pascal	equ Basic+4	;Pascal entry.RamGoComp	equ Pascal+4	;users gocomp entry	for completionsSoftReset	equ RamGoComp+4	;Soft reset chain.RamDispatch	equ SoftReset+4	;Command dispatcher.RamForbid	equ RamDispatch+4	;RAM vector to long	entry of forbid.RamPermit	equ RamForbid+4	;For Permit.ProEntry	equ RamPermit+4	;Original ProDOS entry point.Prodos	equ ProEntry+2	;Prodos entry.SerStatus	equ Prodos+4	;Serial interface status hookSerWrite	equ SerStatus+4	;" " write hook.SerRead	equ SerWrite+4	;For Read.SerBackgnd	equ SerRead+4	;For background printing.PDispatch	equ SerBackgnd+4	;For dispatching packets.lapzplen	equ $10e1ddpend	equ $d600	;really $e1d600 (gets around dumb link)ddpzplen	equ 14;------------------------------------------------------------------------------;; Equates from procedure C7Defs;;------------------------------------------------------------------------------C7xx	equ $C7A0	;emulation mode entryC7xxGo	equ $C7A1	;native mode entryC7xxRet	equ $C7A8	;return point for routinesC7Error	equ $C7AB	;error point for pascal not installedC7Prodos	equ $C7AE	;bank 0 entry for prodosCnxx	equ $E11042	;emulation mode entryCnxxGo	equ $E11046	;native mode entryOnExitVector	equ $E1104A	;Exit vector for QTRIRQ;------------------------------------------------------------------------------;; Equates from procedure errors;;------------------------------------------------------------------------------maxatpsize	equ 578lapendbuf	equ $0202lapextra	equ $0209largeddp	equ $0305	;only ddp err we care aboutnoatperr	equ $0000largeatp	equ $0501atpbadskt	equ $0502noatpcb	equ $0503noatprel	equ $0505addnosnd	equ $0506reqabort	equ $0507requestfail	equ $0508sktclsd	equ $0509toomuchrsp	equ $050bnoddpskt	equ $050crsprel	equ $050datpbusy	equ $05ffnoqtrerr	equ $0000noentry	equ $0101	;dispatcher item not foundnorspcbmem	equ $0102	;can't allocate rspcbqtrnotfound	equ $0103noatalkerr	equ $0105qtrcanceled	equ $0106qtrbusy	equ $01ff;------------------------------------------------------------------------------;; Equates from procedure qsecint;;------------------------------------------------------------------------------insqtr_parmcnt	equ $00insqtr_command	equ insqtr_parmcnt+1insqtr_result	equ insqtr_command+1insqtr_iocomp	equ insqtr_result+2insqtr_ticks	equ insqtr_iocomp+4insqtr_count	equ insqtr_ticks+2insqtr_link	equ insqtr_count+2rmvqtr_parmcnt	equ $00rmvqtr_command	equ rmvqtr_parmcnt+1rmvqtr_result	equ rmvqtr_command+1rmvqtr_rsvd	equ rmvqtr_result+13 ;13 reserved bytes;------------------------------------------------------------------------------;; Equates from procedure sendrqint;;; SendATPReq;; 	   !!! NOTE !!!;; The order of the following 8 paramaters must not change; since some internal assumptions are made about the order; of the data in order to save execution time and code space.;;------------------------------------------------------------------------------atprq_parmcnt	equ $00atprq_command	equ atprq_parmcnt+1atprq_result	equ atprq_command+1atprq_iocomp	equ atprq_result+2atprq_dymskt	equ atprq_iocomp+4atprq_dnet	equ atprq_dymskt+1atprq_dnode	equ atprq_dnet+2atprq_dskt	equ atprq_dnode+1atprq_tid	equ atprq_dskt+1atprq_bufsize	equ atprq_tid+2atprq_bufptr	equ atprq_bufsize+2atprq_user	equ atprq_bufptr+4atprq_rbnum	equ atprq_user+4atprq_rbdsad	equ atprq_rbnum+1atprq_flag	equ atprq_rbdsad+4atprq_interval	equ atprq_flag+1atprq_rtrycnt	equ atprq_interval+1atprq_bitmap	equ atprq_rtrycnt+1atprq_response	equ atprq_bitmap+1atprq_link	equ atprq_response+1atprq_timeleft	equ atprq_link+4atprq_trysleft	equ atprq_timeleft+1;------------------------------------------------------------------------------;; Equates from procedure canrqint;;------------------------------------------------------------------------------creq_parmcnt	equ $00creq_command	equ creq_parmcnt+1creq_result	equ creq_command+1creq_tid	equ creq_result+2;------------------------------------------------------------------------------;; Equates from procedure sendrspint;;------------------------------------------------------------------------------sdrsp_parmcnt	equ $00sdrsp_command	equ sdrsp_parmcnt+1sdrsp_result	equ sdrsp_command+1sdrsp_iocomp	equ sdrsp_result+2sdrsp_sskt	equ sdrsp_iocomp+4sdrsp_dnet	equ sdrsp_sskt+1sdrsp_dnode	equ sdrsp_dnet+2sdrsp_dskt	equ sdrsp_dnode+1sdrsp_tid	equ sdrsp_dskt+1sdrsp_rbnum	equ sdrsp_tid+2	;number of buffers send on this callsdrsp_tpkts	equ sdrsp_rbnum+1	;maximum number of packets being sentsdrsp_rbdsad	equ sdrsp_tpkts+1sdrsp_flag	equ sdrsp_rbdsad+4sdrsp_bitmap	equ sdrsp_flag+1sdrsp_addrtn	equ sdrsp_bitmap+1sdrsp_aflag	equ sdrsp_addrtn+4	;pass free packets back hereaddrsp_parmcnt	equ $00addrsp_command	equ addrsp_parmcnt+1addrsp_result	equ addrsp_command+1addrsp_sskt	equ addrsp_result+2addrsp_dnet	equ addrsp_sskt+1addrsp_dnode	equ addrsp_dnet+2addrsp_dskt	equ addrsp_dnode+1addrsp_tid	equ addrsp_dskt+1addrsp_bsize	equ addrsp_tid+2addrsp_bptr	equ addrsp_bsize+2addrsp_user	equ addrsp_bptr+4addrsp_flag	equ addrsp_user+4	;only used for eom bitaddrsp_seqnum	equ addrsp_flag+1	;packet number we are adding;------------------------------------------------------------------------------;; Equates from procedure getrqint;;------------------------------------------------------------------------------getrq_parmcnt	equ $00getrq_command	equ getrq_parmcnt+1getrq_result	equ getrq_command+1getrq_iocomp	equ getrq_result+2getrq_ourskt	equ getrq_iocomp+4getrq_snet	equ getrq_ourskt+1getrq_snode	equ getrq_snet+2getrq_sskt	equ getrq_snode+1getrq_tid	equ getrq_sskt+1getrq_bufsize	equ getrq_tid+2	;size of memory buffer points to    getrq_bufptr	equ getrq_bufsize+2	;address of buffer to put requests intogetrq_user	equ getrq_bufptr+4getrq_actlen	equ getrq_user+4	;actual length of data read ingetrq_flag	equ getrq_actlen+2getrq_bitmap	equ getrq_flag+1getrq_link	equ getrq_bitmap+1;------------------------------------------------------------------------------;; Equates from procedure opensktint;;------------------------------------------------------------------------------opskt_parmcnt	equ $00opskt_command	equ opskt_parmcnt+1opskt_result	equ opskt_command+1opskt_skt	equ opskt_result+2clsskt_parmcnt	equ $00clsskt_command	equ clsskt_parmcnt+1clsskt_result	equ clsskt_command+1clsskt_skt	equ clsskt_result+2;------------------------------------------------------------------------------;; Equates from procedure cbint;;------------------------------------------------------------------------------relcb_parmcnt	equ $00relcb_command	equ relcb_parmcnt+1relcb_result	equ relcb_command+1relcb_ourskt	equ relcb_result+2relcb_snet	equ relcb_ourskt+1relcb_snode	equ relcb_snet+2relcb_sskt	equ relcb_snode+1relcb_tid	equ relcb_sskt+1rspcb_link	equ $00	;first item is link	to next rspcbrspcb_sndptr	equ rspcb_link+4	;points to associated sndatprsprspcb_sskt	equ rspcb_sndptr+4	;source socketrspcb_dnet	equ rspcb_sskt+1	;destination netrspcb_dnode	equ rspcb_dnet+2	;destination noderspcb_dskt	equ rspcb_dnode+1	;destination socketrspcb_tid	equ rspcb_dskt+1	;transaction idrspcb_timeout	equ rspcb_tid+2	;internal release timerrspcbsize	equ rspcb_timeout+2	;size of rspcb (1-Jul-91 MSD: changed to +2).bds_bufsize	equ $00bds_bufptr	equ bds_bufsize+2bds_user	equ bds_bufptr+4bds_actlen	equ bds_user+4	;actual len returned by atp;------------------------------------------------------------------------------;; Equates from procedure zeropage;;------------------------------------------------------------------------------cmdlist	equ $80	;global ptr to paramatersexecaddr	equ cmdlist+4stackzp	equ execaddr+4	;for use in gocompprev	equ execaddr+4	;previous node pointercurr	equ prev+4	;current node pointernext	equ curr+4	;pointer to next nodeR0	equ next+4	;4 byte registerR1	equ R0+4	;and anotherR2	equ R1+4laphead	equ R2+4	;4 byte pointer to lap headerbdsptr	equ laphead+4	;holds pointer to bdszplen	equ bdsptr+4-cmdlist ;length of zero pageatpzplen	equ zplen-8	;length minus first	two vars*           using  intface*           using  initblock* the following will be fixed vectors that may be used by* others, the order	of these items is fixed and should not* change after we go to rom.* now we have the vars that are internal only, therefore they may* be moved and changed as needed* ram locations for	relocated rom stuff* this section needs to be initialized to 0 on reset, or normal init;------------------------------------------------------------------------------;; Equates from procedure datablock;;------------------------------------------------------------------------------initoff	equ $0copenoff	equ $05closeoff	equ $05lookoff	equ $18srqoff	equ $29dataorg	equ e1ddpend	;start data after ddp's datarcmdaddrs	equ dataorg	;ram version of dispatch tablercmdaddrs2	equ dataorg+$114	;ram version of dispatch table 2tickcount	equ rcmdaddrs+1024	;global tick countlsp	equ tickcount+4	;current stack pointerapnode	equ lsp+2	;for append routineatpheader	equ apnode+4	;atp header goes herelookflag	equ atpheader+10	;flag for looklistmoveflag	equ lookflag+2	;flag to tell looklist to moveparmlist	equ moveflag+2	;general parm listwdsbase	equ parmlist+20	;use part of parm list areadecval	equ wdsbase+20status	equ decval+2	;status returned hereysave	equ status+2cursor	equ ysave+2currpart	equ cursor+2tempstate	equ currpart+2tempspeed	equ tempstate+1currstack	equ tempspeed+1	;special stack for listmngrfreechunk	equ currstack+40	;big block of memoryourstack	equ freechunk+512	;our psuedo stacklookbuf	equ ourstack+256	;used only during booting (xtra for stk)rbootstart	equ lookbuf+100rinitparms	equ rbootstart	;boot stuff gets put hereropenparms	equ rinitparms+initoffrcloseparms	equ ropenparms+openoffrlookparms	equ rcloseparms+closeoffrsrqparms	equ rlookparms+lookoffrsrqbds	equ rsrqparms+srqoffrparmstart	equ rsrqbds+14	;normal init data moves hereratpreadp	equ rparmstart	;past lookbufinitsec	equ ratpreadp+13	;init this section to 0rqhead	equ initsec	;head of atp request listavailhead	equ rqhead+4	;points to list of free memoryrspcbhead	equ availhead+4	;points to rspcb listgrqhead	equ rspcbhead+4	;holds all getrequests issuedqtrhead	equ grqhead+4	;head of 1/4 sec tasksgnext	equ qtrhead+4	;needed for re-entrant removeatptid	equ gnext+4currsp	equ atptid+2	;special listmngr spintrlevel	equ currsp+2	;interrupt disable flagatalkon	equ intrlevel+2	;tells us if appletalk has been initedstartcount	equ atalkon+2	;real time counter initial valueintervalticks	equ startcount+2	;number of ticks in	a real time intervalsavecnt	equ intervalticks-initsec+2 ;number of bytes to zero oute1atpend	equ intrlevel+2	;allow 10 bytes for	ram readprotmain	PROC	import vectortab,toC7xxgo,toC7xx,toSlotScan,GetInfo1		longa on	longi on	bra ATROMInit	dc.b 'ATROM VERSION 4.0'	EXPORT ATROMInitATROMInit;; 2-Jul-91 MSD: Based on the slot passed to us by SCC.Manager, modify; the references to code at $C7xx.;; 8-Jul-91 MSD: below, it was doing a STA toC7xx (I left out the +2) so; it was causing the JSL opcode to be changed instead of the opcode....;; 10-Jul-91 MSD: Forced the data bank to be set to our code;	phb	phk	plb	; set data bank to our code		sta OurChannel	; =1 for port A, =2 for port B	tya	; slot in A	sep #$20	; just do 8-bit stores	longa off	ora #$C0	; make A = $Cn		sta vectortab+10	; fix JML C7Error	sta toC7xxgo+2	; fix JSL C7xxgo	sta toC7xx+2	; fix JSL C7xx	sta toSlotScan+1	; fix lda #$C7 (before going to ROM slot scan loop)	sta GetInfo1+2	; fix completion return address from GetInfo call		rep #$20	; back to full native	longa on;; End of 2-Jul-91 MSD change;	jsr hardreset	;long entry point for hardreset	plb	; restore data bank (10-Jul-91 MSD)	rtl	jmp hardreset	;cold boot entry point (in rom this goes first)	jmp softhandler	;soft reset entry	export OurChannelOurChannel	dc.w 0	ENDPcmdaddrs	PROC	;data area for jump	table	DC.L 0	;no command 0	DC.A opendriver	;call this to init everything	DC.B atpzplen	;save zero page used, sp is set	DC.A getinfo	;$02	DC.B lapzplen	;save zp for lap	DC.A getglobal	;$03	DC.B lapzplen	;save zp for lap	DC.A installqtr	;$04	DC.B atpzplen	;save this much	DC.A removeqtr	;$05	DC.B atpzplen	;save this much	DC.A bootcode	;$06	DC.B 0	;no need to save zp	  	DC.A lapwrite	;$07	DC.B lapzplen	;save zp for lap	DC.A lapread	;$08	DC.B lapzplen	;save zp for lap	DC.A attachprot	;$09	DC.B lapzplen	;save zp for lap	DC.A removeprot	;$0a	DC.B lapzplen	;save zp for lap	DC.A openskt	;$0b	DC.B ddpzplen	;length of zero page wanted saved	DC.A closeskt	;$0c	DC.B ddpzplen	;length of zero page wanted saved	DC.A ddpwrite	;$0d	DC.B ddpzplen	;length of zero page wanted saved	DC.A nbpregname	;$0e	DC.B ddpzplen	;length of zero page wanted saved	DC.A nbpremove	;$0f	DC.B ddpzplen	;length of zero page wanted saved	DC.A nbplookup	;$10	DC.B ddpzplen	;length of zero page wanted saved	DC.A nbpconfirm	;$11	DC.B ddpzplen	;length of zero page wanted saved	DC.A atpsendrequest	;$12	DC.B atpzplen	;length of zero page wanted saved	DC.A cancelreq	;$13	DC.B atpzplen	;length of zero page wanted saved	DC.A openatpsocket	;$14	DC.B atpzplen	;length of zero page wanted saved	DC.A closeatpsocket	;$15	DC.B atpzplen	;length of zero page wanted saved	DC.A getrequest	;$16	DC.B atpzplen	;length of zero page wanted saved	DC.A sendresponse	;$17	DC.B atpzplen	;length of zero page wanted saved	IF  small	GOTO .noadd	DC.A addresponse	;$18	DC.B atpzplen	GOTO .tl1.noadd	DC.L 0	;pad out addresponse ($18).tl1	DC.A relrspcb	;$19	DC.B atpzplen	;length of zero page wanted saved	entry cmdtabendcmdtabend		;used in calculation later	ENDPcmdaddrs2	PROC	;data area for jump	table	DC.A removeqtr	;call this to init everything	DC.B atpzplen	;save zero page used, sp is set	DC.A nbpkill	;$02	DC.B ddpzplen	;save zp for lap	entry cmdtabend2cmdtabend2		;used in calculation later	ENDP********************************************************************************			                  ** ATPENTRY - Main entry point to the AppleTalk command dispatcher             **			                  **			                  ** Entry:			                  **			                  **	X = Pointer to command call block (Low Word)              **	Y = Pointer to command call block (High Word)             **			                  **  Necessary items in the command call block:	                  **			                  **      	 ______________________________	                  **	|                              |	                  **	|         Async Flag           |	                  **	|______________________________|	                  **	|                              |	                  **	|         Command              |	                  **	|______________________________|	                  **	|                              |	                  **	|         Result Code          |	                  **	|______________________________|	                  **	|                              |	                  **	.                              .	                  **	|      <Command Specific>      |	                  **	.                              .	                  **	|                              |	                  **			                  ********************************************************************************atpentry	PROC	;ATP entry point	EXPORT adispatchadispatch		;       	longa on	;16 bit accum	longi on	;and index registers	phd	;save direct page	lda #0000	;and make sure direct page	tcd	;is zero	phb	;save old data bank	pea databank/256	;databank in both bytes        	plb	plb	;get new data bank	longa off	sep #mbit	;keep 16 bit x, but	use 8 bit a	lda statereg	;save previous state	pha	and #$cf	;bits 4&5 zero force read and write main bank	sta statereg	lda lcbank2	lda lcbank2	;make sure correct bank is in for $e1	lda cyareg	;get speed register	pha	;and save for later	ora #$80	;make it fast	sta cyareg	longa on	longi on	rep #mbit+xbit	;back to full x,a	phy	phx	ldx #cmdlist	lda #8	;save zp used by dispatcher	jsr savezp	plx	ply	;recover parms	sty cmdlist+2	;and save x & y as cmdlist	stx cmdlist	ldy #atprq_command	;offset to command field	lda [cmdlist],y	;get command byte in lower 8 bits	and #$00ff	;strip off unnecessary bits	asl a	;*2	asl a	;*4 for offset into	table	tax	;set up for jsr	lda rcmdaddrs,x	;get low word of address	sta execaddr	;save it in memory	lda rcmdaddrs+2,x	;get high bytes	tax	;hold in x	and #$00ff	;strip high byte (24 bit addresses)	sta execaddr+2	;and save them	ora execaddr	;see if routine exists	beq dispatcherr	;we can't dispatch this	txa	;get back high word	xba	;swap in # of zp bytes to save	and #$00ff	;only use low byte	pha	;and save on stack for restore	ldx #cmdlist+8	;save from this point	jsr savezp	;save what routine wants	clc	;call long form of routine	pei cmdlist+2	;high word of cmdlist	pei cmdlist	;and low word	phb	;save data bank	jsl incbusyflag	;tell scheduler we are busy	jsr stacksave	;save stack space if needed	jsl goexec	;go to routine	rep #mbit+xbit	;make sure full native	jsr stackrestore	;restore stack space	jsl decbusyflag	;let scheduler call	code if neededgoback		; 	plb	;and restore bank	rep #mbit+xbit+cbit	;force back to 16 bit x,a	pla	;get low word of cmdlist	sta cmdlist	pla	;and high word	sta cmdlist+2	pla	;recover # of bytes	to restoregoback1		; ;entry point for bad cmd	adc #8	;add in original amount saved	tax	;and hold on for later	sep #mbit+xbit+cbit	;back to 8 bit mode, assume err	longa off	longi off	ldy #2	lda [cmdlist]	;get async flag	bmi seterr	;so set flagssynchold		; 	lda [cmdlist],y	;get result field	bmi synchold	;and loop while busyseterr		; ;now set the error flags	lda [cmdlist],y	;get low byte	beq noerr	bpl cok	;it's an error c=1noerr		; 	clc	;no error <=0	pea $0000	;no error	bra cok1cok		; 	pea $8888	;dummy network errorcok1		; 	rep #mbit+xbit	;back to full native	longa on	longi on	php	;save c,x,a	txa	;get length	ldy #cmdlist	;and base to restore	jsr restorezp	;and restore it	plp	;recover c, (x,a=16	bit mode)	pla	;recover error	sep #mbit+xbit	;back to 8 bit mode, assume err	longa off	longi off	plx	;get cyareg (speed register)	stx cyareg	;and restore it	plx	;get back statereg	stx statereg	;restore state	rep #mbit+xbit	longa on	longi on	plb	;restore old data bank	pld	;restore their direct page	rtsdispatcherr		; 	ldy #2	lda #noentry	;dispatch entry was	empty	sta [cmdlist],y	clc	lda #0000	bra goback1	;and returngoexec		;so others can see this	jml [|execaddr]	entry ldispatch	; EXPORT -> ENTRY  **TGHldispatch		;       	jsr atpentry	;provide a long entry	rtl	;to the dispatcher* saves a range of memory* must be called in	16 bit mode* x=source address* a=number of bytes** NOTE: This routine also accounts for zero page being* moved, and thus must treat zp as relative to the D register*	EXPORT savee1savee1		;       	sep #vbit+cbit	;e1 mode	bra saveit	EXPORT savezpsavezp		;       ;saves zero	page usage	clvsaveit		; 	longa on	longi on	rep #mbit+xbit+cbit	;make sure 16 bit	ora #0000	;see if no bytes to	move	beq rtnzp	;none, so return	phb	;save data bank	pha	;save move count	php	;save v & c=0 bits	ldy lsp	;destination address (current sp)	adc lsp	;compute new lsp value	sta lsp	;and save it	plp	;recover v & c=0dskip1		; 	pla	;get count	dec a	;adjust for mvn	bvs dskip2	;skip if E1 mode	mvn $00,databank	;save in databank	plb	;and restore bank	rtsdskip2		; 	mvn databank,databank ;save in databank	plb	;and restore data bankrtnzp		; 	rts* restores a range of memory* y=first address to restore* a=number of bytes	EXPORT restoree1restoree1		;       	sep #vbit	;E1 mode	bra restoreit	EXPORT restorezprestorezp		;       	clv	;direct page moderestoreit		; 	rep #mbit+xbit+cbit	;16 bits, c = 0	dec a	;get number to move	- 1	bmi rtnzp	;if negative, was 0	phb	;save data bank	pha	;save for mvn	php	;save v bit and c =	0	lda lsp	;get stack pointer	sbc $2,s	;subtract count c=0	but a=a-1	plp	;get back v and c =	0	tax	;use for sourcedskip3		; 	pla	;recover count	phx	;and save new sp (but don't update yet)	bvs dskip4	;do e1 mode	mvn databank,$00	;restore from databank	bra finishdskip4		; 	mvn databank,databankfinish		; 	pla	;get lsp	plb	;restore databank before store	sta lsp	rts	ENDP** hardreset* this routine is called only after hard reset* it should set everything up that needs to be* initialized*hardreset	PROC	php	;save status	phb	jsr setup	;set speed and databank	rep #mbit+xbit	longa on	longi on	lda #ourstack	;set up the stack	sta lsp	stz atalkon	;appletalk is not yet active	lda #0000	sta rcmdaddrs	;clear some memory	ldx #rcmdaddrs	;first address	ldy #rcmdaddrs+1	;destination	lda #1024-2	;number of bytes to	zero	mvn databank,databank ;and move it* now we might want	to call ddp & lap to let them do what they want	ldx #cmdaddrs	;get rom dispatch table	ldy #rcmdaddrs	;and ram address as	destination	lda #(cmdtabend-cmdaddrs)-1 ;length of command table	mvn main,databank	;move from rom to ram	ldx #cmdaddrs2	;get rom dispatch table	ldy #rcmdaddrs2	;and ram address as	destination	lda #(cmdtabend2-cmdaddrs2)-1 ;length of command table	mvn main,databank	;move from rom to ram;	FIX OUR CNXX VECTORS HERE!	lda #$006B	;Put an rtl into the ONEXITVECTOR	sta OnExitVector	lda #$0000	sta OnExitVector+2	ldx #bootstart	;relocate boot parms	ldy #rbootstart	;into ram	lda #(bootend-bootstart)-1 ;length of boot parms	mvn main,databank	;from rom to ram	ldx #vectortab	;jump vectors	ldy #Extended	;address of first ram vector	lda #vectlen-1	;number of bytes to	move	mvn main,databank	;from rom to ram* after we check the code out we must put a jml to dispatch	at PDispatch*	lda >jdispatch	sta PDispatch	lda >jdispatch+2	sta PDispatch+2	jsr lapresetinit	;let lap set up variables before any calls are made	jsr cleanup	plb	;restore old bank	plp	;and mode bits	rts	;and return to bootjdispatch	jml Dispatch	;code to call built	in dispatch	export vectortabvectortab		;this is the vector table	DC.L $6b	;rtl for extended	DC.L $6b	;rtl for basic	DC.B $5c	;jml c7error for pascal	DC.A C7Error	DC.B $5c	;jml gocomp	DC.A gocomp	DC.B $5c	;jml anrtl for soft	reset chain	DC.A anrtl	DC.B $5c	;jml ldispatch for dispatcher entry	DC.A ldispatch	DC.B $5c	;jml longforbid	DC.A longForbid	DC.B $5c	;jml longPermit	DC.A longPermitvectlen	equ *-vectortabsetup		;       	sep #mbit+xbit	;short mode	longa off	longi off	lda #databank	pha	plb	lda statereg	;get previous state.	bit lcbank2	bit lcbank2	;make sure correct bank is in for $e1	sta tempstate	;save previous state.	lda cyareg	;get speed register	sta tempspeed	;and save for later	ora #$80	;make it fast	sta cyareg	rtscleanup		;       	sep #mbit+xbit	longa off	longi off	lda tempspeed	sta cyareg	lda tempstate	;get state reg	sta statereg	rts	entry softhandler	; EXPORT -> ENTRYsofthandler		;call here to dispatch reset chain	php	;save mode bits	phb	;save databank	jsr setup	rep #mbit+xbit	longa on	longi on	jsl softreset	;call code in reset	chain	jsr cleanup	plb	;restore old databank	plp	;and mode bitsanrtl	rtl	ENDP** atp.listmngr*******************************************************************  listmanager-**  This is the main	linked list handler*  It loops through	a given linked list	and calls a special*  routine for each	node that is found.	 That routine can then*  return a control	code to listmanager, telling it what to	do*  with the node.  The currently available options are:**  when returning to the list manager if the carry is set then*  we will stop scanning the list, otherwise we will continue***  Inputs:  the following are passed on	the stack:**           head address -      16 bits*	            address	of pointer to head of linked*	            list.  This points to head-link offset.*           special	routine -   16 bits*	            special	routine to be called for each*	            node encountered*           return address -    16 bits*	            return address put here by jsr*  Register Inputs:**           offset to link -    y-reg (16 bits)*	            offset from node address to	next link*	            field**  Outputs: none currently*****************************************************************listmanager	PROC	;main list loop** set up pointers before loop*	longa on	longi on	rep #mbit+xbit	lda $5,s	;get low word of head address	sta prev	;save low word of previous ptr (head)	lda #^databank	;get high word	sta prev+2	tyx	;hold link offset temporarily	lda [prev],y	;get low word of first node	sta curr	;and save it	iny	iny	lda [prev],y	;and get high word	sta curr+2	txy	;recover link offset	sty ysave	;and save globallytestcurr		; ;top of while loop	lda curr	;get low word	ora curr+2	;check against high	word	beq listdone	;we are done if both are zero	lda [curr],y	;get low word of next link	sta next	;and save it	tyx	;save index	iny	;and bump up to	iny	;high word	lda [curr],y	;get it	sta next+2	;and save	phx	;save link offset on stack	txy	;set up link offset	for call	pea comeback	;address to return to	lda $7,s	;get routine off stack	dec a	;make it so we can rts to	pha	;fake an indirect jsrcomeback	rts	;we actually will return to the		;next instruction after the RTS		;this will call routine pushed on stk	* this is where we return to from that pea comeback done a few lines earlier	rep #mbit+xbit	;make sure 16 bit x,a	ply	;finally, restore link offset	bcs listdone	;we are done since the want to stop	lda curr	;otherwise continue	to scan list	sta prev	;prev=curr	lda curr+2	sta prev+2	lda next	;curr=next (move to	next node)	sta curr	lda next+2	sta curr+2	brl testcurr	;loop for morelistdone		; ;clean up and leave	lda $1,s	;get return address	sta $5,s	;move it up to where it belongs	tsc	;get stack pointer in accum	clc	;set up for add	adc #4	;scrape garbage of stack	tcs	;fix stack pointer	rts	;and return	entry dodelete	; EXPORT -> ENTRY  **TGHdodelete		;delete the	current node	tyx	;save link offset	lda next	sta [prev],y	;cut out current node	iny	;bump to high word	iny	lda next+2	sta [prev],yexitdelete		; ;leave through here** now, since we are	allowing the list manager to be recursively* re-entrant, if we	happen to be deleting someone elses curr node* we must update their curr value on the stack to the real curr item* we must do this for each item on the stack that matches the node* being deleted.*	ldy currsp	;get special stack pointer	beq stackok	;stack is ok now since nothing there* now check to see if the node we just deleted was somebodies current * node, and if so, adjust the special stack to let give them our prev* node to compensate for the just deleted nodechkprev		; ;check special stack	lda curr+2	;check node deleted	against	cmp currstack-2,y	;their prev node	bne backup	;check next item on	stack	lda curr	cmp currstack-4,y	;check low word	bne backup	;not a match	lda prev	;give them a new curr value	sta currstack-4,y	;since we are deleting theirs	lda prev+2	sta currstack-2,ybackup		; ;move down stack	dey	dey	dey	dey	bne chkprev	;still something on	stackstackok		; 	lda prev	;curr=prev to adjust for	sta curr	;deleted node	lda prev+2	sta curr+2	txy	;restore link offset	rts	;and returnldodelete	jsr dodelete	;use for long entry to delete	rtl	entry pushcurr	; EXPORT -> ENTRY  **TGHpushcurr		;       ;push current node	ldx currsp	;get current stack value	inx	inx	inx	inx	stx currsp	;update stack before pushing	lda curr	sta currstack-4,x	lda curr+2	sta currstack-2,x	rts	entry pullcurr	; EXPORT -> ENTRY  **TGHpullcurr		;       ;recover current and next values	ldx currsp	lda currstack-2,x	;get high word of next	sta curr+2	;and save it	lda currstack-4,x	;and get low word	sta curr	;and save low word	dex	dex	dex	dex* now that we have recovered curr, lets	get the next value from it	lda [curr],y	;get low word of next node	sta next	;and save it	iny	iny	lda [curr],y	;and get high word	sta next+2	dey	dey	;re-adjust y to original value	stx currsp	;and save the new stack	rts	ENDP** atp.listrtns** this is a group of routines that make	use* of the list manager to provide extended list* functions*******************************************************************  addlist-    **  This routine adds a node    that is passed on the stack*  to the front of a list whose head address is also passed*  on the stack.**  Stack Inputs:**           head address -	16 bits*		address of pointer to head*		of linked list*           item address -	32 bits*		address of item to be appended*           return address -	16 bits*		return address**  Register Inputs:**           offset to link -	y-reg (16 bits)*		offset from node address to*		next link field**  Outputs:**           none currently**  Destroys:*           nothing*****************************************************************addlist	PROC	plx	;get return address	pla	;get low word of node to insert	sta curr	;save locally	pla	;get high word	sta curr+2	pla	;get low word of head address	sta prev	;save in zp	phx	;put return address	back on stack	tyx	;save link offset	lda (prev),y	sta [curr],y	;save low word	iny	iny	lda (prev),y	sta [curr],y	lda curr+2	sta (prev),y	;save new head high	word	txy	;get original offset	lda curr	sta (prev),y	ldy currsp	;check special stack	beq stackok	;nothing on itchkprev		; 	lda prev	;see if we have a match	cmp currstack-4,y	;check head against	their curr	bne backup	lda #^databank	;high word of head	cmp currstack-2,y	bne backup	;keep checking	lda curr+2	;change curr val on	stack	sta currstack-2,y	lda curr	sta currstack-4,ybackup		; 	dey	dey	dey	dey	bne chkprevstackok	rts	;and return	ENDP******************************************************************  looklist -**  This routine looks in a list for a node that*  belongs to the packet that was just received.*  It does this by using a comparison table that*  tells it what items are expected to match.*  The packet that was read must be at a fixed*  location, and must use the long ddp form.*  This is acceptable since our implementation of*  ddp puts all packets into long form before*  passing control to its socket listener.**  Stack Inputs:*                  head address -	16 bits*		address of pointer to*		head of list to search*                  compare table -	16 bits*		this is the table that*		tells what items relative*		to the beginning of	the*		protocol layers need to*		be examined.*		NOTE: it is assumed	that this*		table is in the same bank as the*		code.*                  return address -	16 bits**  Register Inputs:*                  y-reg	link offset**  Status Flags:*                  z=1	no match found*                  z=0	match found**  Memory Outputs:*                  cmdlist	holds value of node	found**  Destroys:*                  R0,R1,R2******************************************************************looklist	PROC	longa on	longi on	rep #mbit+xbit	tyx	;save offset	stz lookflag	;not found yet	stz moveflag	;no move wanted	pla	;get return address	sta R2	;only uses 16 bits for return	pla	;get compare table address	sec	;for subtract	sbc #sdrsp_sskt	;back up pointer to	table	sta R0	;and save for spcl routine	phk	;push program bank	phk	;and again (since 16 bit mode)	pla	;now recover it and	use it for	sta R0+2	;high word of our code bank	pea lookspcl	;set up stack for listmanager	jsr listmanager	;and loop through list	pei R2	;push return address	lda lookflag	;set status bit	rts	;and return	entry listmove	; EXPORT -> ENTRY  **TGHlistmove		;alternate entry for moving	longa off	longi off	sep #mbit+xbit	;go to 8 bit	lda #01	;set move flag	sta moveflaglookspcl		; ;special node routine** R0 contains a pointer to the compare table - sdrsp_sskt* the reason it points to this is that the comparing does* not start until sdrsp_sskt, and therefore the previous* bytes in the command list do not matter*	sep #xbit+mbit+vbit	;8 bit x,a, force v	for ddp mode	ldy #sdrsp_sskt-1	;this is where we will comparelooksp1		; 	iny	;move to next item in lists	lda [R0],y	;get the compare table item	beq looksp1	;keep going with next item	bpl checkvbit	;it's a real index	inc a	;see if was 255	beq found	;we passed all tests	dec a	;back up a	and #$7f	;strip high bit	rep #vbit	;clear vbit for atp	mode switchcheckvbit		; 	phy	;save loop index	tay	;set up index to packet data	lda [laphead],y	;assume from lap and ddp	bvs goodguess	;we were right	lda atpheader,y	;we were wrong (no big deal)goodguess		; 	ply	;get back loop index	ldx moveflag	;see if move or compare should be done	beq compare	;do a compare	sta [curr],y	;do a move	bra looksp1	;do next bytecompare		; 	cmp [curr],y	;see if matches data in list	beq looksp1	;yes so keep checkingnomatch	clc	;skip code (this is	why we use 8 bits)goback	rep #mbit+xbit	;back to 16 x,a	rts	;and returnfound	ldx moveflag	;see if move or compare	bne goback	;just return if move	rep #mbit+xbit	;back to 16 x,a	longa on	longi on	lda curr	sta cmdlist	;this is where we return the pointer	lda curr+2	sta cmdlist+2	inc lookflag	;tell main routine that we found it	sec	;set stop bit	rts	;and return	ENDP** atp.sndrequest**atpsendrequest	PROC	jsr forbid	;hold off ints	ldy #atprq_bufsize	lda [cmdlist],y	;get size of buffer	to send	cmp #maxatpsize+1	;see if too big	bcc bufsizeok	;its ok	lda #largeatp	;atp data too large	bra badskt	;and report the errorbufsizeok		; 	sep #mbit+xbit	longa off	longi off	ldy #atprq_rbnum	lda [cmdlist],y	;see how many response buffers	cmp #9	;see if too many	bcc bufsok	;number of bufs is ok	rep #mbit+xbit	;back to 16 bit a,x	longa on	longi on	lda #toomuchrsp	;too many rsp buffers	bra badskt	;and report the errorbufsok		; 	rep #mbit+xbit	longa on	longi on	ldx #<atplisten	;get low word	ldy #^atplisten	;and high word	lda #0	;ask for dynamic socket	jsr ddpopenskt	;open socket listener	bne badskt	;some kind of ddp error 	sep #mbit+xbit	;8 bit x,a	longa off	longi off	txa	;get socket from x	ldy #atprq_dymskt	;get offset to socket	sta [cmdlist],y	;put socket in list	ldy #atprq_rtrycnt	;get offset to retry count	lda [cmdlist],y	;get it	ldy #atprq_trysleft	;set up trysleft first time	sta [cmdlist],y	lda #00	;zero out number of	responses	ldy #atprq_response	;received	sta [cmdlist],y	rep #mbit+xbit	;back to 16 bit a,x	longa on	longi on	pea rqhead-atprq_link ;low word of head-offset	pei cmdlist+2	;high word of cmdlist	pei cmdlist	ldy #atprq_link	;offset to link	jsr addlist	;add to this list	inc atptid	;bump tid	lda atptid	;get the trans id	xba	;switch high & low bytes	ldy #atprq_tid	;offset to tid field	sta [cmdlist],y	;save it	jsr sndrqpkt	;send out the request packetrqok		; ;the request was ok, so exit busy	jmp waitdone	;general exit routinebadskt		; 	jmp retasynflag	;and return from there	ENDP** atplisten** this is the socket listener for send requests.* it reads the atp header out of the packet.   *atplisten	PROCatpls1		; 	rep #mbit+xbit	longa on	longi on	pea databank	;set up databank properly	plb	plb	ldx #cmdlist	;save zero page from here	lda #zplen	jsr savezp	ldx cmdlist	ldy #$00e1	;lap header in bank	$e1	stx laphead	sty laphead+2	pei laphead+1	;push bytes 2 & 3 (3=$e1)	plb	;discard byte 2	plb	;and get bank e1	stz status	;assume no error for return   	jsr readatpheader	;read in the header	to known location	sep #mbit+xbit	;make sure 8 bit x,a	longa off	longi off	bne dumprest	;error so ignore this packet	lda atpheader	;get the function code	and #$C0	;strip unwanted bits	cmp #$80	;check for reply	bne dumprest	;nope	pea rqhead-atprq_link ;address of head for list routines	pea rsptable	;push response table address	ldy #atprq_link	;link offset	jsr looklist	;look for a match	sep #mbit+xbit	;make sure 8 bit x,a	beq dumprest	;no match found so throw out packet** cmdlist now contains address of node that matched*	lda atpheader+1	;get sequence number	ldy #atprq_rbnum	;for compare against num of	cmp [cmdlist],y	;buffers	bcc goodsofar1	;so far its okdumprest		; ;throw out packet	rep #mbit	;16 bit A.	sec	;use internal mode of call	longa on	lda #$8000	;Set purge bit, read 0 bytes	longa off	jsr LAPRead	;and purge packet		entry doneatp	; EXPORT -> ENTRY  **TGHdoneatp		;	rep #mbit+xbit	;make sure 16 bit mode	longa on	longi on	ldy #cmdlist	;restore from here	lda #zplen	jsr restorezp	rtl	;and returngoodsofar1		; 	longa off	longi off	tax	;transfer sequence num	lda >onebitmask,x	;get mask from table	ldy #atprq_bitmap	;go to bitmap field	and [cmdlist],y	;see if wanted	beq dumprest	;nope so leave	rep #mbit+xbit	;16 bit x,a	longa on	longi on	txa	;get back sequence number	asl a	;*2	asl a	;*4	pha	;hold temporarily	asl a	;now a=a*8, carry is clear	adc $1,s	;add a*4 to get a=a*12	plx	;discard stack temp	ldy #atprq_rbdsad	;offset to rddsad pointer	jsr readrbds	;read data into rbds	bne doneatp	;bad read so ignore	sep #mbit+xbit	;back to 8 bit mode	longa off	longi off	ldy #atprq_response	;move to responses received fld	lda [cmdlist],y	;get previous value	inc a	;add 1	sta [cmdlist],y	;and put back new value	ldy #atprq_bitmap	;update bitmap	ldx atpheader+1	;get sequence number	lda atpheader	;get flags	and #atpeombit	;see if eom	beq clearbit	;nope so just set bitmap	lda >lowbitmask,x	;get mask for this sequence number	and [cmdlist],y	;see if all bits below are zero	bra newbitmap	;store new bitmapclearbit	lda >onebitmask,x	;get bit to set	eor [cmdlist],y	;flip what was therenewbitmap	sta [cmdlist],y	;and store the new one	php	;save result of bitmap stuff	lda atpheader	;get flag byte again	and #atpstsbit	;see if status wanted	beq checkdone	;no, so see if done	with packet	jsr sndrqpkt	;re-send request packetcheckdone	plp	;get status from bitmap back	bne listendone	;still bits set so leave	rep #mbit+xbit	;make sure full 16 bit mode	lda status	;call is done so complete	jsl killrequest	;by killing the requestlistendone	bra doneatp	;back to caller	ENDP** waitdone** indicate a call is busy*waitdone	PROC	rep #mbit+xbit	;16 bit x,a	longa on	longi on	lda #atpbusy	;show busy first	entry retasynflag	; EXPORT -> ENTRY  **TGHretasynflag		;       ;alternate entry point	rep #mbit+xbit	;make sure 16 bit x,a	ldy #atprq_result	;offset to result byte	sta [cmdlist],y	;save it	jsr permit	;back down interrupt hold off	sep #mbit+xbit	;go to 8 bit x,a	longa off	longi off	ora #00	;test low byte to set status bits	bpl procdone	;if positive we are	donegoback		; 	rtl	;return long to dispatcherprocdone		; *		;fall through to io	completion stuff	entry chkiocmp	; EXPORT -> ENTRY  **TGHchkiocmp		;another alternate entry point	sep #mbit+xbit	;again force 8 bit x,a	lda [cmdlist]	;get async flag	bpl goback	;not async so no completion routine	ldy #atprq_result	lda [cmdlist],y	;get result	bmi goback	;not completed yet	ldy #atprq_iocomp	;offset to completion routine	entry callcomp	; EXPORT -> ENTRY  **TGHcallcomp		;       ;come here if y already set	rep #mbit+xbit	;back to full 16 bit mode	longa on	longi on	tax	;hold onto a	lda [cmdlist],y	;get low word	sta execaddr	iny	iny	;bump to high word	lda [cmdlist],y	sta execaddr+2	;save high word	ora execaddr	;check against low word	beq goback	;no completion routine wanted* now, since we are	temporarily giving up control, we must make* sure we preserve the next field, since it was possible that* we were in the middle of scanning a list when we called this* routine.  This way, if the next node happens to be deleted* the delete routine will have a value on the special nextstack* that it can update to reflect the 'real' next node	jsr pushcurr	;save next value	lda ysave	;get y offset to link	pha	jsl gocomp	;call completion routine	ply	;recover y offset to link	sty ysave	;restore ysave since it could have gotten changed	jsr pullcurr	;recover value (possibly changed)	rtl	;and return	EXPORT gocompgocomp		;       ;general completion routine** passes value in x*	rep #mbit+xbit	;force full native	longa on	longi on	tsc	tax	;save stack for return	lda execaddr+2	;get high word	beq callemul	;calling bank 0, do	so in emulation	phx	;save current stack	for return	phb		export toC7xxgotoC7xxgo	jsl C7xxgo	;call exec address,	full nativexxx		; 	rep #mbit+xbit	;full native	plb	pla	;recover full stack	pointer	tcs	;and use it	rtl	;and returncallemul		; ;call completion in emulation mode	cpx #$0200	;see if out of emulation range	bcc stackok	;no, stack is ok	lda >emulstack	;get emulation stack	and #$00ff	;strip out high word	ora #$0100	;and put stack in page 1	tcs	;set new stackstackok	sec	;call C7xx with carry set for emulation	phx	phb		export toC7xxtoC7xx	jsl C7xx	bra xxx* the following c7 code belongs in the c700 space of the appletalk card*c7xx	anop	;switch into emulation mode*	xce* use following code when code is in rom (leave out for testing)*	pei execaddr+1	;push 2 & 3 rd bytes*	plb*	plb	;set db to same as pb in execaddr*c7xxgo	anop*	jml (execaddr)	;call the stinking	routine*** completion routine must jump directly	here (no rts or rtl)**c7xxret	anop*	clc*	xce*	rtl	;and return	ENDP** sndrqpkt* sends out an atp request packet*sndrqpkt	PROC	sep #mbit+xbit	;force 8 bit x,a	longa off	longi off	ldy #atprq_interval	;time interval for retran	lda [cmdlist],y	ldy #atprq_timeleft	sta [cmdlist],y	;reset timeout counter	ldy #atprq_flag	lda [cmdlist],y	;get flag value	bit #atpxobit	; is it an exactly-once transaction? (1-Jul-91 MSD)	bne @xo	; yes, so leave TRel timer bits (1-Jul-91 MSD)	and #atpxobit	;strip all but xo bit@xo	and #atpxobit|7	; strip all but xo bit and TRel timer bits (1-Jul-91 MSD)	ora #$40	;and make it a request** now fall through to the generic* send atp packet routine*	entry sndatppkt	; EXPORT -> ENTRY  **TGHsndatppkt		;       ;alternate entry point	sep #mbit+xbit	;force 8 bit x,a	sta atpheader	;store command byte	ldy #atprq_bitmap	lda [cmdlist],y	;get the bitmap	sta atpheader+1	;and put in parm list	rep #mbit+xbit+cbit	;back to 16 bit x,a, clear carry	longa on	longi on	lda cmdlist	;get low word	adc #atprq_bufsize	;add in offset to user data  	sta bdsptr	;to get fake bds pointer	lda cmdlist+2	;get high word	adc #00	;add in carry bit	sta bdsptr+2	;now bds points to parm list	lda #$00ff	;tell write that we	did bds already	jsr watppkt	;write atp packetgoodsend	rts	;and return to our caller (internal)	ENDP** atp.killrequest*** cancelreq** this call removes	a request from the request pending* list, and calls a	completion routine if necessary.* It only expects to be passed a tid, that it will match* to an item in the	list.  It then deletes that item.*cancelreq	PROC	jsr CheckAsync	; 7-Oct-91 MSD		longa on	longi on	rep #mbit+xbit	;full native	jsr forbid	;don't bother us in here	ldy #creq_result	;assume good call	lda #noatperr	;so store no error	sta [cmdlist],y	lda cmdlist	sta laphead	;set up for looklist routine	lda cmdlist+2	sta laphead+2	pea rqhead-atprq_link ;this is the list	to search	pea canceltable	;this is the match table	ldy #atprq_link	;offset to link field	jsr looklist	;look it up	beq nomatch	;not in list	lda #reqabort	;show request aborted	jsl killrequest	;kill the request officially	jsr permit	;allow ints again	rtl	;and returnnomatch		; 	lda #noatpcb	;control block not found	jmp retasynflag	;does permit for us** killrequest** this call cancels	a pending sendrequest by removing* it from the rqhead list if it exists.	 It then calls* a completion routine if there is one to be executed.* Also, on exactly once packets it sends a release before* exiting.*	entry killrequest	; EXPORT -> ENTRY  **TGHkillrequest		;	longa on	longi on	rep #mbit+xbit	pha	;save result	pea rqhead-atprq_link ;search through this list	ldy #atprq_link	;offset to link field	jsr delitem	;and remove cmdlist	beq killexit	;nothing deleted	pla	;adjust stackkillonly		;kill without delete	pha	;save error code	cmp #largeatp	;see if atp too large err	beq closeskt	;yes so don't send release	ldy #atprq_flag	lda [cmdlist],y	;get flag	and #atpxobit	;see if xo mode	beq closeskt	;nope so close and leave	lda #$c0	;send release	jsr sndatppkt	;packet	bra closesktkill	phacloseskt	sep #mbit+xbit	longa off	longi off	ldy #atprq_dymskt	lda [cmdlist],y	;get socket of this	list	jsr closeddpskt	;close the socketkillexit		; 	rep #mbit+xbit	longa on	longi on	pla	;recover error code	ldy #atprq_result	sta [cmdlist],y	;save result	jmp chkiocmp	;do i/o completion,	and return** delitem* * this routine deletes the item in the list that is passed us that* cmdlist contains.* the address of the list head is passed on the stack*	entry delitem	; EXPORT -> ENTRY  **TGHdelitem		;	longa on	longi on	rep #mbit+xbit	;force 16 bit x,a	stz lookflag	;nothing found yet	pla	;get return address	sta R0	;hold in temp	pea delspec	;special delete routine	jsr listmanager	;loop through this list	pei R0	;restore return	lda lookflag	;and set condition codes	rts	;and returndelspec		; ;comes here for each node	lda cmdlist	cmp curr	;see if match found	bne donext	;keep looking	lda cmdlist+2	;check high word	cmp curr+2	bne donext	;no match	jsr dodelete	;delete a node	sec	;and stop	inc lookflag	;show that it was found	rtsdonext	clc	;skip this one	rts** atptimer** this routine is called directly by the 1/4 sec scheduler* and is responsible for updating and maintaining* the linked lists (decrementing timers, retrans, etc).**	entry atptimer	; EXPORT -> ENTRY  **TGHatptimer		;assume comes here in full native	longa on	longi on	pea rqhead-atprq_link ;scan this list	pea rqscan	;request list scanner	ldy #atprq_link	;offset to link field	jsr listmanager	;scan the list	pea rspcbhead-rspcb_link ;check for expire of xo	pea rspscan	;timer	ldy #rspcb_link	jsr listmanager	rts	;and return to our callerrspscan;; 1-Jul-91 MSD: Changed this to a 2-byte decrement.;	ldy #rspcb_timeout	lda [curr],y	;get timeout for this rspcb	sec	; 4-Oct-91 MSD	sbc decval	;number of ticks that have occured	beq gone	;it went to zero	bcc gone	;it went minus	sta [curr],y	;otherwise, just store new valuegonext		; ;on to next item	clc	;skip to next item	rtsgone		; ;remove the node	lda curr	sta cmdlist	lda curr+2	sta cmdlist+2	jsr relcb1	;free up memory and	get sndresponse	php	;save result from release	ldy #rspcb_link	jsr dodelete	;delete the node	plp	;get result back from release	beq gonext	;no sndresponse was	attached	jsr forbid	;balance with permit in retasynflag	lda #noatprel	;no release ever received	jsl retasynflag	bra gonext	;and go to next itemrqscan		; ;this is where we	check the rq list	lda curr	sta cmdlist	;move it since others expect it here	lda curr+2	sta cmdlist+2	longa off	longi off	sep #mbit+xbit+cbit	;go to 8 bit mode	ldy #atprq_timeleft	;check retran timer	lda [cmdlist],y	sec	; 4-Oct-91 MSD	sbc decval	;subtract number of	ticks	sta [cmdlist],y	;save result	beq sendagain	;send it again and dec trysleft	bcs rqnext	;not down to zero yetsendagain		; 	ldy #atprq_trysleft	;now dec number of tries	lda [cmdlist],y	;if it is not $ff or $00	beq kickout	;get rid of this one	dec a	;back it up	cmp #$fe	;see if was $ff	beq sendit	;yep, so don't dec & do send	sta [cmdlist],y	;save new valuesendit	jsr sndrqpkt	;send the packetrqnext		; 	clc	;skip to next one	rtskickout		; 	longa on	longi on	rep #mbit+xbit	ldy #atprq_link	;offset to link field	jsr dodelete	;delete it	lda #requestfail	;timeout without response	jsl kill	;pkt already deleted, kill only	bra rqnext	;go on to next packet** atp.sndresponse*	entry sendresponse	; EXPORT -> ENTRY  **TGHsendresponse		;	longa off	longi off	sep #mbit+xbit	jsr forbid	;don't allow interrupts	ldy #sdrsp_sskt	lda [cmdlist],y	jsr checkskt	;see if ok socket	bne doerr1	;we got an error so	leavegoodsocket		; * NOTE: it is up to	the user to properly set the bitmap.*	sep #mbit+xbit	longa off	longi off	ldy #sdrsp_flag	;get xo flag	lda [cmdlist],y	and #atpxobit	;and isolate xo bit	beq csendrsp	;just send it	jsr attachrspcb	;see if we can attach to a rspcb	rep #mbit+xbit	;make sure full native	longa on	longi on	bne doxosend	;do exactly once send	lda #noatpcb	;couldn't find rspcb	bra doerr1	;and report the errordoxosend		; 	jsr sendrsp	;send response packets	jmp waitdone	;and leavecsendrsp		; ;do at least	jsr sendrsp	;send itdoerr1		; 	jmp retasynflag	;and post itsendrsp		; 	sep #mbit+xbit	longa off	longi off	ldy #sdrsp_bitmap	;get user supplied bitmap	lda [cmdlist],y	jsr sendnrsp	;and send the corresponding packets	rts** attachrspcb** looks for a match	in the rspcb list, and if found* attaches cmdlist to it, also sets up expire timer** On entry, cmdlist points to the SendATPResp parameter block.* Note: The caller must copy the ATP flags byte from the GetATPReq* parameter block to the SendATPResp parameter block in order for the* variable TRel timer to work properly (since I don't store the original* timer value in the Response Control Block, I depend on the caller* to supply me with the original flags byte).*attachrspcb		;       	rep #mbit+xbit	;make sure full native	longa on	longi on	lda cmdlist	;set up for looklist call	sta laphead	lda cmdlist+2	sta laphead+2	pea rspcbhead-rspcb_link ;push head of list	pea attachtable	;address of match table	ldy #rspcb_link	;offset to link field	jsr looklist	;check for a match	php	;save status	beq notattached	;nope so wasn't xo	ldy #rspcb_sndptr	;offset to attach field	lda laphead	;now points to sndresponse	pha	;save for later	sta [cmdlist],y	;cmdlist now points	to rspcb	iny	iny	lda laphead+2	pha	;save for later	sta [cmdlist],y;; 1-Jul-91 MSD: Get the TRel timer bits from the control information byte; (as given to us by the caller).  Use as an index into a table of timer; values and then store it in the Response Control Block as usual.;	ldy #sdrsp_flag	; offset to flags byte in SendATPResp	lda [laphead],y	; get control information (command) byte	and #7	; get just TRel timer bits	asl a	; times 2 as index to table of words; Begin 26-Sep-91 MSD	tax	lda >TRelTimers,x	; get the corresponding timeout in ticks; End 26-Sep-91 MSD	ldy #rspcb_timeout	;set timeout	sta [cmdlist],y	;save it;; End of 1-Jul-91 MSD change.;	pla	;recover high word of sndresponse	sta cmdlist+2	;back into cmdlist	pla	sta cmdlist	;and low wordnotattached		; ;exit point	plp	;recover processor state	rts	;and return	entry sendnrsp	; EXPORT -> ENTRY  **TGHsendnrsp		;       	longa off	longi off	sep #mbit+xbit	;8 bit x,a	pha	;save bitmap	ldy #sdrsp_rbnum	;get number of active responses	lda [cmdlist],y	tax	pla	;recover bitmap	and >lowbitmask,x	;and strip unnecessary bits	pha	;and save bitmap again	lda #$80	;this is a response	packet	sta atpheader	lda #$ff	;no response to start	sta atpheader+1sdrsp1	pla	;get current bitmap	beq sdrsp9	;done	inc atpheader+1	;bump sequence number	lsr a	;move bit to carry	pha	;save new bitmap	bcc sdrsp1	;no packet for this	bit	bne sdrsp2	;not last buffer in	sequence	ldy #sdrsp_flag	;offset to flags	lda [cmdlist],y	;get the flag	and #atpstsbit	;see if sts wanted	ora atpheader	;set bit if on since last buffer	sta atpheader	;in this sequencesdrsp2	lda atpheader+1	;get sequence number	tax	;hold for a while	inc a	;bump by 1 for test	ldy #sdrsp_tpkts	;total number of bds's 	cmp [cmdlist],y	;check against # of	packets	bcc sdrsp3	;not last so send normally	bne sdrsp1	;too big if > # packets (need add)	lda #atpeombit	;last packet so get	eom bit	ora atpheader	;and set it	sta atpheadersdrsp3		; 	ldy #sdrsp_flag	lda [cmdlist],y	;get xo bit	and #atpxobit	;and isolate it	ora atpheader	sta atpheader	;and save it	txa	;get back sequence #	asl a	;*2	asl a	;*4	pha	;save * 4 value	asl a	;*8	adc $1,s	;add to * 4 to get * 12	plx	;throw away junk	jsr watppkt	;write this packet	beq sdrsp1	;no error so keep sending	ply	;discard stack junksdrsp9	rep #mbit+xbit	;go to full native	rts	;and return** openatpsocket** opens a ddp socket and sets up a socket listener* to handle incoming requests and releases*	entry openatpsocket	; EXPORT -> ENTRY  **TGHopenatpsocket		;	longa on	longi on	jsr CheckAsync	; 7-Oct-91 MSD		jsr forbid	ldy #opskt_skt	;get their socket	lda [cmdlist],y	ldx #rsplstn	;our socket listener	ldy #^rsplstn	;high word	jsr ddpopenskt	;open the socket	bne goback	;error, so return	longa off	longi off	sep #mbit+xbit	txa	;get socket from open	ldy #opskt_skt	sta [cmdlist],y	;save new socket	longa on	longi on	rep #mbit+xbit	;back to full native	lda #noatperr	;no errorgoback	jmp retasynflag	;return through here (calls permit)** closeatpsocket** closes up an atp socket opened through openatpsocket.* This includes removing all references	to this socket* from any of our lists, and freeing any associated memory. *	entry closeatpsocket ; EXPORT -> ENTRY  **TGHcloseatpsocket		;       	jsr CheckAsync	; 7-Oct-91 MSD		jsr forbid	longa on	longi on	rep #mbit+xbit	ldy #clsskt_result	lda #noatperr	sta [cmdlist],y	;no error	longa off	longi off	sep #mbit+xbit	ldy #clsskt_skt	lda [cmdlist],y	sta r1	;hold onto skt	jsr closeddpskt	;close socket	longa on	;comes back in full	16 bit	longi on	beq closeok	;socket closed ok	jmp retasynflag	;return the errorcloseok		; 	pea grqhead-getrq_link ;scan this list	pea clsgrq	;close out grq's	ldy #getrq_link	jsr listmanager	pea rspcbhead-rspcb_link ;now remove rspcb's	pea clsrspcb	;remove rspcb's that match	ldy #rspcb_link	jsr listmanager	jsr permit	rtl	;and returnclsgrq		; 	longa off	longi off	sep #mbit+xbit	ldy #getrq_ourskt	lda [curr],y	;get socket from list	cmp r1	;see if need to delete	beq delit	;delete it if matches	clc	;skip only	rtsdelit		; 	rep #mbit+xbit	;use full native	longa on	longi on	lda curr	;put pntr into cmdlist	sta cmdlist	;since that's where retasynflag	lda curr+2	;wants it	sta cmdlist+2	ldy #getrq_link	jsr dodelete	;delete the nodesktclose		; ;calls completion	routine	jsr forbid	;balance permit in retasyn	lda #sktclsd	;socket was closed	jsl retasynflag	;set result and do completionskipon		; 	clc	;keep going	rtsclsrspcb		; 	sep #mbit+xbit	longa off	longi off	ldy #rspcb_sskt	lda [curr],y	cmp r1	beq delcb	;remove the rspcb	clc	rtsdelcb		; 	longa on	longi on	rep #mbit+xbit	lda curr	sta r0	sta cmdlist	lda curr+2	sta r0+2	sta cmdlist+2	ldy #rspcb_link	jsr dodelete	;remove from linked	list	jsr freemem	;free up the space	jsr getsndrsp	;get sndrsp that was attached	beq skipon	;the snd was never attached	bra sktclose	;do completion stuff** relrspcb** call this to manually free a rspcb if	you need to.*	entry relrspcb	; EXPORT -> ENTRY  **TGHrelrspcb	jsr CheckAsync	; 7-Oct-91 MSD		longa on	longi on	rep #mbit+xbit	jsr forbid	;don't bother us here	ldy #relcb_result	lda #noatperr	sta [cmdlist],y	;assume no error	lda cmdlist	sta laphead	;compare against this	lda cmdlist+2	sta laphead+2	pea rspcbhead-rspcb_link ;search through this list	pea reltable	ldy #rspcb_link	;offset to link field	jsr looklist	beq notfound	;no match found	jsr relcb	;free the rspcb	beq nosndatt	;no send response was attached** if we need to here, we can put code to call the completion routine* for the sndresponse which is now held	in cmdlist*	lda #rsprel	;close up and complete	jmp retasynflag	;and exit from therenosndatt	jsr permit	;permit ints again	rtl	;and returnnotfound	lda #noatpcb	;no control block	jmp retasynflag	;and exit with error* don't use add since small wanted	IF  small	GOTO .tl2           ** addresponse*	entry addresponse	; EXPORT -> ENTRY  **TGHaddresponse		;       ;add a response to sendrsp	longa on	longi on	jsr forbid	lda cmdlist	;adjust this to account for	sta laphead	lda cmdlist+2	sta laphead+2	pea rspcbhead-rspcb_link ;look through rspcb's	pea addtable	;match table for add	ldy #rspcb_link	;link field of list	to scan	jsr looklist	;and see if we get a match	bne getsnd	;find attached sndrsp         	brl nosndrsp	;there was nonegetsnd		; 	jsr getsndrsp	;sets cmdlist=attached sndresponse	longa off	longi off	sep #mbit+xbit	ldy #addrsp_seqnum	;sequence number of	this packet	lda [laphead],y	;laphead is pointing to addrsp	ldy #sdrsp_tpkts	;see if too many packets	cmp [cmdlist],y	bcs badsqnum	;bad sequence number	ldy #sdrsp_rbnum	;currently active	cmp [cmdlist],y	;see if too low	bne badsqnum	;bad sequence number	tax	;save for later	inc a	;adjust highest active packet	sta [cmdlist],y	;and save as new rbnum	txa	;get back real sequence num	asl a	;*2	asl a	;*4	pha	;save *4 value	asl a	;*8	adc $1,s	;carry should be clear get *4+*8	ply	;discard stack junk	ldy #sdrsp_rbdsad	;get offset to rbds	rep #mbit+xbit+cbit	;go to full native	longa on	longi on	and #$00ff	;strip high byte	adc [cmdlist],y	;add to low word of	rbds	sta bdsptr	lda #0000	;add high word of 0	to add carry	iny	iny	adc [cmdlist],y	sta bdsptr+2	clc	lda laphead	;now get address of	packet to add	adc #addrsp_bsize	sta r0	lda laphead+2	adc #0000	sta r0+2movebuf	ldy #bds_bufsizemovelp		; 	lda [r0],y	;get source WORD	sta [bdsptr],y	;and move WORD	iny	;move to next word	iny	cpy #bds_actlen	;stop when >= to this	bcc movelp	;not done yet	sep #mbit+xbit	longi off	longa off	inx	;now make sequence num 1-8	lda >onebitmask-1,x	;set bit in bitmap	ldy #sdrsp_bitmap	ora [cmdlist],y	sta [cmdlist],y	ldy #addrsp_flag	;get eom flag	lda [laphead],y	and #atpeombit	;see if eom wanted	beq adddone	;our work is almost	done	ldy #sdrsp_tpkts	;and update total number of packets	txa	;recover sequence number+1	sta [cmdlist],y	;and change tpktsadddone		; ;now clean up and	leave	ldy #sdrsp_bitmap	;get the bitmap	lda [cmdlist],y	jsr sendnrsp	;and send out the packets	longa on	longi on	rep #mbit+xbit	lda #noatperrexit		; 	ldy #addrsp_result	sta [laphead],y	;set result	jsr permit	;allow ints again 	rtl	;and leavebadsqnum		; 	rep #mbit+xbit	lda #invalidseq	;bad sequence number	bra exit	;and returnnosndrsp		; 	rep #mbit+xbit	lda #addnosnd	;trying to add without a send	bra exit.tl2** atp.getrequest** implements getrequest call* and the associated socket listener*	entry getrequest	; EXPORT -> ENTRY  **TGHgetrequest		;	longa off	longi off	sep #mbit+xbit	jsr forbid	ldy #getrq_ourskt	;get the socket they got from atp	lda [cmdlist],y	jsr checkskt	;see if valid	beq @goodsocket	;yes, ok	jmp retasynflag	;bad, so return with error@goodsocket		; 	longa on	longi on	rep #mbit+xbit	;full native mode	pea grqhead-getrq_link ;head of getrequest list	pei cmdlist+2	;high word of this node	pei cmdlist	;low word of this node	ldy #getrq_link	;offset to link field	jsr addlist	;add to get request	list	jmp waitdone	;return with busy flag set** rsplstn* this is the socket listener that is called when requests and* releases come to us.  It is responsible for searching rspcb's,* & grq's, and takes the appropriate action*	entry rsplstn	; EXPORT -> ENTRY  **TGHrsplstn		;       	longa on	longi on	rep #mbit+xbit	;force full native	pea databank	;make sure we are in right bank	plb	plb	lda #zplen	;save zero page	ldx #cmdlist	;from here	jsr savezp	ldx cmdlist	ldy #$00e1	;always in e1	stx laphead	;save address of lapheader	sty laphead+2	pei laphead+1	;push bytes 2 & 3 (3=$e1)	plb	;discard byte 2	plb	;and get bank e1	stz status	;assume no error to	return   	jsr readatpheader	;read in the header	sep #mbit+xbit	;make sure 8 bit x,a	longa off	longi off	bne dumprest	;error so ignore	lda atpheader	;get function code	tax	;make a copy	asl a	;check function	bpl dumprest	;ignore it since it's a response	bcs release	;it's a release	txa	;get back original function code	and #atpxobit	;see if xo	beq atprpls4	;nope* this is an exactly once request, so now it is time to check* and see if there is a response matching this packet already* waiting in a rspcb.  If so, then we re-tranmit the original* response.  Otherwise, if the rspcb exists but does not have* a response attached to it, we simply ignore this packet.* If no rspcb is found at all, then see	if there is a getrequest* pending for this packet, and handle it for the getrequest.*	jsr lookrspcb	;look for a match in rspcb list	beq atprpls4	;no rspcb so do getrequest check* a rspcb was found, so check to see if	a response already exists* cmdlist now points to the rspcb that matched;; 1-Jul-91 MSD: Get the TRel timer bits from the control information byte; (the first byte of the ATP header).  Use as an index into a table of timer; values and then store it in the Response Control Block as usual.;	lda atpheader	; get control information (command) byte	and #7	; get just TRel timer bits	asl a	; times 2 as index to table of words; Begin 26-Sep-91 MSD	tax	lda >TRelTimers,x	; get the corresponding timeout in ticks; End 26-Sep-91 MSD	ldy #rspcb_timeout	;set timeout	sta [cmdlist],y	;save it;; End of 1-Jul-91 MSD change.;	jsr getsndrsp	;get sndrsp in cmdlist	sep #mbit+xbit	;back to 8 bit x,a	beq dumprest	;nothing attached yet so leave	lda atpheader+1	;get bitmap from request	ldy #sdrsp_bitmap	and [cmdlist],y	;and with internal bitmap	pha	;packets to send (save for free pkts)	jsr sendnrsp	;snd pkts they want	and we have	sep #mbit+xbit	;make sure 8 bit x,a	pla	;get packets to send	tax	;hold for awhile	ldy #sdrsp_bitmap	;get internal bitmap again	eor [cmdlist],y	;operation gives us	packets to free	pha	;hold on stack	txa	;get packets to send (new bitmap)	sta [cmdlist],y	;save it	pla	;now get packets to	free	beq dumprest	;there are none	jsr freepkts	;call free packets routinedumprest		; ;throw out remaining data	rep #mbit	;16 bit A	sec	;do internal call	longa on	lda #$8000	;do purge, read 0 bytes	jsr lapread	longa offrsplstngoback		; 	jmp doneatp	;return through common exitrelease		; ;comes here with release pkt	longa on	longi on	jsr lookrspcb	;search for a match	beq dumprest	;no match so leave	jsr relcb	;free this cb	beq dumprest	;there was no sndresponse attached	bra goodexit	;there was a sndresponse to release it	entry relcb	; EXPORT -> ENTRY  **TGHrelcb		;       	rep #mbit+xbit	pea rspcbhead-rspcb_link ;delete from this list	ldy #rspcb_link	;offset to link	jsr delitem	;remove from list	longa on	longi on	;comes back in 16 bit mode	entry relcb1	; EXPORT -> ENTRY  **TGHrelcb1		;       	lda cmdlist	;get node to put back on free	sta r0	;list	lda cmdlist+2	sta r0+2	;node to free is in	r0	jsr freemem	;puts back on list of avail nodes	jsr getsndrsp	;gets sendrsp attached to rspcb	rts	;return all set upgoodexit	jsr forbid	;balance permit in retasynflag	rep #mbit+xbit	;16 bit x,a	lda status	;get error code if any    	jsl retasynflag	;call completion stuff (does permit)	bra dumprest	;and returnatprpls4		; ;check for a matching getrequest	rep #mbit+xbit	;make sure full native	pea grqhead-getrq_link ;search the getrequest list	pea grqtable	;make sure a getrequest is pending	ldy #getrq_link	;offset to link	jsr looklist	;call search routine	beq dumprest	;no match found* a match was found, and cmdlist now contains the matching getrequest	clc	lda cmdlist	adc #getrq_bufsize	sta bdsptr	lda cmdlist+2	adc #^getrq_bufsize	sta bdsptr+2	jsr readrbd2	;alternate entry if	bds already set	bne rsplstngoback	;and return, packet	already purged	pei cmdlist+2	;high word	pei cmdlist	;low word of destination	jsr moveinfo	;move the data	longa off	longi off	sep #mbit+xbit	pea grqhead-getrq_link ;remove from grq	list	ldy #getrq_link	jsr delitem	;and delete it	sep #mbit+xbit	;put back in 8 bit x,a	ldy #getrq_bitmap	;update bitmap	lda atpheader+1	sta [cmdlist],y	ldy #getrq_flag	;update flag field	lda atpheader	;get command byte	sta [cmdlist],y	and #atpxobit	;isolate this bit	beq goodexit	;all done, not xo	jsr getmem	;get a free node	beq nomem	;no memory left	longa on	;comes back in full	native	longi on	lda #0000	ldy #rspcb_sndptr	sta [r0],y	iny	iny	sta [r0],y	;clear sndptr field	(not attached yet);; 1-Jul-91 MSD: Get the TRel timer bits from the control information byte; (the first byte of the ATP header).  Use as an index into a table of timer; values and then store it in the Response Control Block as usual.;	lda atpheader	; get control information (command) byte	and #7	; get just TRel timer bits	asl a	; times 2 as index to table of words; Begin 26-Sep-91 MSD	tax	lda >TRelTimers,x	; get the corresponding timeout in ticks; End 26-Sep-91 MSD	ldy #rspcb_timeout	;set initial timeout	sta [r0],y	;and save in parm block;; End of 1-Jul-91 MSD change.;	pea rspcbhead-rspcb_link ;push parms on	stack for second call	pei r0+2	;now, since r0 will	be destroyed by	pei r0	;moveinfo	pei r0+2	pei r0	jsr moveinfo	;now set up data for this rspcb	ldy #rspcb_link	;parms are already on stack (above)	jsr addlist	;and do it	brl goodexit	;do iocomp and leavenomem		; ;no memory for rspcb	rep #mbit+xbit	;make sure full native	lda #norspcbmem	sta status	brl goodexit	;call completion routinemoveinfo		; 	plx	;get return	pla	;get low word	sta curr	;set up	pla	;get high word	sta curr+2	pea rspcbtable-sdrsp_sskt ;calculate base of movetable	pla	;get it back	sta r0	phk	phk	;push program bank	pla	;get it back	sta r0+2	;and use for high word	phx	;restore return addr	jsr listmove	;do the move	rts	entry lookrspcb	; EXPORT -> ENTRY  **TGHlookrspcb		;       	rep #mbit+xbit	pea rspcbhead-rspcb_link ;search the rspcb list	pea rspcbtable	;match table  	ldy #rspcb_link	;offset to link	jsr looklist	;call search routine	sep #mbit+xbit	;make sure 8 x,a	rts	entry getsndrsp	; EXPORT -> ENTRY  **TGHgetsndrsp		;       ;puts sndrsp field of rspcb in cmdlist	longa on	longi on	rep #mbit+xbit	ldy #rspcb_sndptr	;check attach field	lda [cmdlist],y	;get low word	pha	;save	iny	iny	lda [cmdlist],y	;get high word	sta cmdlist+2	;new cmdlist is sndrsp	pla	;get low word	sta cmdlist	ora cmdlist+2	;see if 0	rts;; This is a table of words giving the number of ticks for the various; possible TRel timer values (from an XO TReq packet).  The undefined; values result in the old 30 second timeout.;TRelTimers	dc.w 30*4,60*4,2*60*4,4*60*4,8*60*4,30*4,30*4,30*4	** freepkts* this routine will	call the special routine attached to the sndresponse* call for every packet that is no longer needed in the response* The ones that are	no longer needed are the ones which have been sent* and a new bitmap has been returned saying those packets were received* if a bit is set in aflag, it means that that packet is now free.*freepkts		; 	longa off	longi off	;comes here in 8 bit mode	sep #mbit+xbit	;just to be safe	ldy #sdrsp_aflag	;store the packets to add flag	sta [cmdlist],y	ldy #sdrsp_addrtn	;offset to routine wanted	jsl callcomp	;and call it	rts	;and return** atp.memory** this is the memory management stuff* that is neccessary to support xo sendresponses*	entry freemem	; EXPORT -> ENTRY  **TGHfreemem		;free node that is in R0	longa on	longi on	rep #mbit+xbit	lda availhead	;get low word of head	sta [r0]	;save in low link field	ldy #0002	;offset to high link	lda availhead+2	sta [r0],y	;save that (r0->link=availhead)	lda r0	;now get this node	sta availhead	;and let availhead = r0	lda r0+2	sta availhead+2	;node was just released	rts	;by adding to front	of availhead	entry makefreelist	; EXPORT -> ENTRY  **TGHmakefreelist		;       ;create a list of free memory	rep #mbit+xbit	;force full native mode	lda #freechunk	;use fixed memory for now	sta r0	;but later call memory manager	lda #^databank	;for this memory	sta r0+2	;	ldx #512/rspcbsize	;512 bytes so get as many as we canmakeloop		; 	jsr freemem	;free first node	clc	lda r0	;get low word	adc #rspcbsize	;move to next entry	sta r0	lda r0+2	;get high byte	adc #^rspcbsize	;add high word (always 0)	sta r0+2	;and save result	dex	;	bne makeloop	;add next node to free list	rts	;and return	entry getmem	; EXPORT -> ENTRYgetmem		;       ;this gets a node from availhead	rep #mbit+xbit	;force full native	pea availhead-0	;push address of head	pea getspc	;getmem special routine	stz r0	;clear return field	stz r0+2	;and high byte	ldy #0000	;offset to avail link	jsr listmanager	;call list handler	lda r0	ora r0+2	;set flags for caller (z=1 if no mem)	rts	;return to callergetspc		; ;special handler	lda curr	;get this node	sta r0	;and take from list	lda curr+2	sta r0+2	jsr dodelete	;delete node and stop	sec	;stop	rts	;that's it** atp.qtr** this is the general quarter second task scheduler* it allows addition and removal of 1/4	second routines* that will be called at user specifiable times.** NOTE: RemoveQtr is completely re-entrant, and can   * be called whenever a routine is no-longer needed.      * InstallQtr is safe to call when servicing a 1/4 sec* interrupt or AppleTalk packets.  In other words, if* you are in a 1/4 second handler, it is allowable to* call InstallQtr without ill effect.*	entry InstallQtr	; EXPORT -> ENTRY  **TGHInstallQtr		;	longa on	longi on	rep #mbit+xbit	jsr forbid	;don't bother us in here	ldy #insqtr_ticks	;update tick counter	lda tickcount	;get global tick count	sta [cmdlist],y	ldy #insqtr_count	;get number of ticks wanted	lda [cmdlist],y	beq rqgoback	;return only global	tick count* always add to the	head of the queue, since it is possible	that* the 1/4 scheduler	could be scanning the list when we were	called.* If the node where	appended to the end, it could be called	before* time had really elapsed!	pea qtrhead-insqtr_link ;add to this list	pei cmdlist+2	;add this item	pei cmdlist	ldy #insqtr_link	;get offset to link	field	jsr addlist	lda #qtrbusy	;show that we are in progress	jmp retasynflag	entry RemoveQtr	; EXPORT -> ENTRY  **TGHRemoveQtr		;       ;delete from list	jsr CheckAsync	; 7-Oct-91 MSD		rep #mbit+xbit	;force 16 bits	jsr forbid	;no ints in here	pea qtrhead-insqtr_link	ldy #insqtr_link	jsr delitem	beq rqnotfound	;error	ldy #rmvqtr_command	;Load the command number.	lda [cmdlist]	and #$FF00	;Only the command number!	cmp #$4500	;Is it a cancel or remove?	bne @L1	;Branch if remove.	lda [cmdlist]	ora #$0080	sta [cmdlist]	lda #qtrcanceled	bra rqgoback@L1	lda #noqtrerr	;no errorrqgoback		; 	jmp retasynflag	;and returnrqnotfound	lda #qtrnotfound	bra rqgoback	;return with error* this is the quarter second dispatcher* it is called by lap directly, and comes* here with int's disabled*	EXPORT qtrschedqtrsched		;       ;the 1/4 sec scheduler	ldx atalkon	;see if appletalk really active	beq qtrscheddone	;no, so don't try to dispatch	and #$00ff	;lap only counts low byte as valid	sta decval	;decrement value	clc	adc intervalticks	;running ticks in real time interval	sta intervalticks	;save them;	pea $0000	;push space for result of readtime;	pea $0000	;push space for result of readtime;	pea $0000	;push space for result of readtime;	pea $0000	;push space for result of readtime;	ldx #$0d03	;call readtimehex;	jsl >$e10000;	pla	;get seconds and minutes;	plx;	plx;	plx	;discard other stuff;	and #$00ff	;just want number of seconds;	tax	;save in case we need it again	php	;This routine is cheaper	sep #$30	;in cycles than the above routine.	jsl >$E1008C	; 3/6/89  *** TGH	plp	lda >$E103E1	and #$00FF	taxchecktimedif		; 	sec	sbc startcount	;subtract the previous counter	bcs numsok	;no need to do 60 second adjust	txa	;recover time again	adc #256	;add 60 seconds to real time and check for difference	bra checktimedif	;go check the difference nownumsok		; 	cmp #10	;see if above threshold	bcc dontadjustyet	;no, so lets not adjust right now	stx startcount	;new counter	asl a	;multiply by 4	asl a	;to find number of 1/4 seconds	sec	sbc intervalticks	;see if more ticks need to be dispatched	stz intervalticks	;zero out the interval timer	bcc dontadjustyet	;intervalticks were	valid	clc	adc decval	;add to value we just got	sta decval	;dispatch with adjusted tick countdontadjustyet		; 	lda decval	;get decrement value	clc	adc tickcount	;add to old tickcount	sta tickcount	;and save new value	lda #zplen	;entire length of zp used	ldx #cmdlist	;base of zp to save	jsr savezp	;and save it	jsr atptimer	;our internal routine	pea qtrhead-insqtr_link ;scan this list	pea qtrroutine	;special routine for each node	ldy #insqtr_link	;offset to link	jsr listmanager	;do it	lda #zplen	;length of zero page to restore	ldy #cmdlist	;restore starting here	jsr restorezp	;and restore itqtrscheddone		; 	rts	;and returnqtrroutine		; ;gets each node	sec	;for subtract	ldy #insqtr_count	lda [curr],y	;get value	sbc decval	;subtract number of	ticks that expired	sta [curr],y	;update value	beq callit	;call the handler	bcc callit	;if <=0scanmore		; 	clc	;skip to next node	rtscallit		; 	ldy #insqtr_ticks	lda tickcount	sta [curr],y	;update users tick count field	lda curr	;copy to cmdlist for calling	sta cmdlist	;routine	lda curr+2	sta cmdlist+2	ldy #insqtr_link	jsr dodelete	;delete before completion	jsr forbid	;balance permit in retasynflag	lda #noqtrerr	;call is completing	jsl retasynflag	;and call completion if there	bra scanmore	;keep scanning** atp.ddpstuff** these are the interface routines from	atp to* dpp.  They will change when the 'real' version* of ddp goes into use.*	EXPORT ddpopensktddpopenskt		;	sta parmlist+4	; save socket ID	stx parmlist+5	;store address of skt listener	sty parmlist+7	lda #$0b00	;command for sync open ddp socket	sta parmlist	jsr makecall	;call routine	beq ok	;leave it alone	lda #noddpskt	;no ddp socket errorok		; 	rts	entry makecall	; EXPORT -> ENTRY  **TGHmakecall		;       ;call with parm list	rep #mbit+xbit	longa on	longi on	ldx #<parmlist	ldy #^databank	jsr atpentry	;do the open	sep #mbit+xbit	;make sure in 8 bit	x,a	ldx parmlist+4	;get socket number assigned	rep #mbit+xbit	;back to full native mode	lda parmlist+2	;z=1 if no error	rts	;and return	EXPORT closeddpsktcloseddpskt	rep #mbit+xbit	; make sure we're called in 16-bit mode	longa on	longi on	sta parmlist+4	;close this socket	lda #$0c00	;command for sync close	sta parmlist	jsr makecall	;call routine	beq okfine	;leave it alone	lda #atpbadskt	;no ddp socket errorokfine		; 	rts** opendriver* opens the atalk driver for testing*	entry opendriver	; EXPORT -> ENTRY  **TGHopendriver	jsr CheckAsync	; 7-Oct-91 MSD	longa on	longi on* assume our reset is always first installed, so it can be* in rom, since it need not know who it	should call	lda >jresetcode	;$5c+(resetcode<<8)	  ;put jml to resetcode	sta softreset	;routine into the vector	lda >jresetcode+2	sta softreset+2initdriver		;       ;only init the driver	longa on	;comes here in full	16	longi on	rep #mbit+xbit;	php;	sei	;don't want to be interrupted in here;	pea $0000	;push space for result of readtime;	pea $0000	;push space for result of readtime;	pea $0000	;push space for result of readtime;	pea $0000	;push space for result of readtime;	ldx #$0d03	;call readtimehex;	jsl >$e10000;	pla	;get seconds and minutes;	plx;	plx;	plx	;discard other stuff;	and #$00ff	;just want number of seconds;	sta startcount	;initialize for 1/4	sec irq routine;	plp	;restore state	php	;This routine is cheaper	sei	sep #$30	;in cycles than the above routine.	jsl >$E1008C	; 3/6/89  *** TGH	longa on	longi on	rep #mbit+xbit	lda >$E103E1	and #$00FF;	sta startcount;	plp	;Restore interupts	pha	ldx #iparmstart	;init parms start	ldy #rparmstart	;ram parm start	lda #(iend-iparmstart)-1 ;length of initialized data	mvn main,databank	;from rom to ram	sep #mbit+xbit	longa off	longi off	;8 bit x,a	lda #00	;clear them bytes	ldy #savecnt	;number of bytes to	clearclre1lp		; 	sta initsec-1,y	;clear bytes in $e1	dey	bne clre1lp	longa on	longi on	rep #mbit+xbit+cbit	pla	sta startcount	plp	;Restore interupts	jsl lapinit	;through dipatcher.	When LAP returns,*		;A MUST be the result.	tax	;set codes	bne GetOuttaHere	;error so exit	inc atalkon	;appletalk is on	jsr ddpinit	jsr makefreelist	;create free list of memGetOuttaHere		; 	rtl	;and returnjresetcode	jml resetcode	;code to call built	in dispatch** this is where soft resets come*resetcode		;       ;this code will be moved to ram	lda #ourstack	;get base of stack	sta lsp	;and set up stack pointer	jsr lapresetinit	;let lap zero info before calling it for node init	ldx #cmdlist	;save zp	lda #zplen	;length of stuff not saved yet	jsr savezp	stz rinitparms+9	;change to stz later	lda #rinitparms	;do the init with boots list	sta cmdlist	lda #^databank	sta cmdlist+2	jsl initdriver	;init driver stuff and rtl	ldy #cmdlist	;restore from here	lda #zplen	;and this much	jsr restorezp	rtlrscodelen	equ *-resetcode	;length of code to relocate	entry readatpheader	; EXPORT -> ENTRY  **TGHreadatpheader		;	;call ddp to read header	longa off	longi off	rep #mbit+xbit	longa on	longi on	ldx #<ratpreadp	;low byte of header	ldy #^databank	;high byte of header	jsr atpentry	;call dispatcher for read	lda ratpreadp+2	;get result	rts	;and return** readrbds* reads in the data	in the packet into our bds structure* y=offset to bds pointer field* a=offset from bds	pointer to actual bds entry*	entry readrbds	; EXPORT -> ENTRY  **TGHreadrbds		;	longa on	longi on	rep #mbit+xbit+cbit	;force 16 bit x,a and clear carry	adc [cmdlist],y	;add a to low byte of pointer	sta bdsptr	iny	iny	;go to high word	lda #00	adc [cmdlist],y	;add carry to high word	sta bdsptr+2	entry readrbd2	; EXPORT -> ENTRY  **TGHreadrbd2		;       ;entry point if bdsptr already set	rep #mbit+xbit	stz status	;assume no error	lda #$0800	;make a readprot call	sta parmlist	sta parmlist+9	;use 6 to mean purge in parm list	ldy #bds_user	;prepare to move user bytes	lda atpheader+4	;get first 2	sta [bdsptr],y	lda atpheader+6	;pick up last 2	iny	;move to upper 2 bytes	iny	sta [bdsptr],y	;done with user bytes	ldy #bds_bufptr	;offset to buffer pointer	lda [bdsptr],y	;get low word	sta parmlist+6	;save low word	iny	;move to high word	iny	lda [bdsptr],y	sta parmlist+8	;and save it	ldy #bds_bufsize	;offset to size of buf	lda [bdsptr],y	;get maximum amount	of data to read	sta parmlist+4	;and save it	jsr makecall	;make call using parmlist	beq noerr	cmp #lapendbuf	beq noerr	;not an error	cmp #lapextra	;special ok type error	bne leave	;leave	lda parmlist+11	ora #$8000	;set error bit	sta parmlist+11noerr		; 	lda parmlist+11	ldy #bds_actlen	;offset to actual bds len	sta [bdsptr],y	lda status	;return error code	rtsleave		; 	sta status	bra noerr	;and leave through there** watppkt* write atp packet - this routine puts together an atp packet and* sends it out through ddp.  If it is called with a=$ff then it is* assumed that the bdsptr has already been calculated, otherwise* it will calculate	it for you based on	an offset passed in	a** exits in 8 bit mode*	entry watppkt	; EXPORT -> ENTRY  **TGHwatppkt		;	rep #mbit+xbit	longa on	longi on	tax	;save for compare later	lda #$0d00	;do ddp write command	sta parmlist	sep #mbit+xbit	;8 bit x,a	longa off	longi off	lda #$03	;atp is ddp protocol type 3	sta parmlist+10	ldy #atprq_dymskt	lda [cmdlist],y	;get socket from atp list	sta parmlist+9	;save in ddp list	ldy #atprq_flag	lda [cmdlist],y	;get flag	and #$01	;strip all but checksum bit	sta parmlist+4	rep #mbit	;16 bit a	longa on	ldy #atprq_dnet	lda [cmdlist],y	sta parmlist+5	;16 bit store	ldy #atprq_dnode	;destination node &	skt	lda [cmdlist],y	sta parmlist+7	lda #wdsbase	;get base of wds	sta parmlist+11	;and store it	lda #^databank	;get high word	sta parmlist+13** now the parm list	is all set up, so we now set up the wds	stuff* we should be in 16 bit a mode here*	txa	;save in case we need to use it	inx	;see if they set bds	beq bdsset	;yep so no need	clc	;we need to set it up	ldy #sdrsp_rbdsad	;offset to bds pointer	adc [cmdlist],y	sta bdsptr	;save low word	ldy #sdrsp_rbdsad+2	lda #00	;prepare to add carry	adc [cmdlist],y	sta bdsptr+2bdsset		; ;bdsptr is now pointing to the bds	ldy #atprq_tid	lda [cmdlist],y	;get tid	sta atpheader+2	ldy #bds_user	;offset to user low	word	lda [bdsptr],y	;get it	sta atpheader+4	;put in header	iny	iny	lda [bdsptr],y	;get high user bytes	sta atpheader+6	lda #atpheader	;only do low word for now	sta wdsbase+8	;first 4 bytes are reserved	lda #^databank	;high word	sta wdsbase+10	lda #08	sta wdsbase+6	;length of above	ldy #bds_bufptr	;offset to buffer address	lda [bdsptr],y	;get low word	sta wdsbase+14	;and save it (ignore high for now)	iny	iny	lda [bdsptr],y	sta wdsbase+16	ldy #bds_bufsize	;move to length field	lda [bdsptr],y	;get it	ldx atpheader	;get atp type	cpx #$c0	;see if release	bne uselen	;use len as is	lda #0000	;otherwise use len of 0uselen	sta wdsbase+12; BEGIN 27-Sep-91 MSD	ina	; was length $FFFF?	bne @short	; no, so pass it on	sec	; error	lda #largeatp	; ATP data too large	bcs @exit	; return the error@short; END 27-Sep-91 MSD	lda #$ffff	;end of list	sta wdsbase+18* now the parm list	for ddpwrite is completely set up, so off we go* to write the packet	jsr makecall	;make call using parmlist@exit		; 27-Sep-91 MSD	sep #mbit+xbit	;always exit in 8 bit mode from	rts	;and return to our caller	entry checkskt	; EXPORT -> ENTRY  **TGHcheckskt		;       	rep #mbit+xbit	longa on	longi on	jsr ddpcheckskt	;check socket through ddp	cpx #<rsplstn	;see if matches our	listener skt	bne skterr	;bad socket	tya	;get high word	and #$00ff	;use only low byte	cmp #^rsplstn	bne skterr	;got an error	rts	;all is okskterr		; 	lda #atpbadskt	;return socket error	rts** rom based booting*   atp.boot*	entry bootcode	; EXPORT -> ENTRY  **TGHbootcode		;	jsr CheckAsync	; 7-Oct-91 MSD	longa on	longi on	stz cursor	;clear cursor position	ldy #^databank	ldx #rinitparms	jsr atpentry	ldx #$01ff	;set stack below where code loads	txs** see if we can find somebody to boot from*tryboot		; ;try booting	ldy #^databank	ldx #rlookparms	jsr atpentry	lda rlookparms+23	;see if got any	and #$00ff	beq nocanboot	;nothing received	sep #mbit+xbit	;go to 8 bit	longa off	longi off	ldx #39	;clear line	lda #' '+$80clrlp		; 	sta >sline,x	;put on screen	dex	bpl clrlp	lda #'.'+$80	;reading char	sta currpart	ldy #03mvlp		; 	lda lookbuf,y	sta rsrqparms+atprq_dnet,y ;and put in sendrequest list	dey	bpl mvlp	;and loop till negative	rep #mbit+xbit	longa on	longi on	lda #$0001	;tell them cortland, and packet 0	sta rsrqparms+atprq_user	lda #code	;start code here	sta rsrqbds+bds_bufptr ;init bds	lda #^code	sta rsrqbds+bds_bufptr+2getnext		; ;get next buffer	sep #mbit+xbit	longa off	longi off	lda #01	;reset bitmap for next request	sta rsrqparms+atprq_bitmap	rep #mbit+xbit	longa on	longi on	ldy #^databank	ldx #rsrqparms	jsr atpentry	;and do it sync	bcs tryboot	;try again, got an error	sep #mbit+xbit	;go to 8 bit x,a	longa off	longi off	lda currpart	;get char	ldx cursor	inx	;bump cursor	cpx #41	;see if past end of	line	bcc charok	;char is in bounds	ldx #01	;back to beginning of line	eor #$80	;flip high bit of char	sta currpartcharok		; 	stx cursor	sta >sline-1,x	;put char on screen	inc rsrqparms+atprq_user+1 ;ask for next packet	lda rsrqbds+bds_user ;get eof flag	bne done	;we are done	clc	inc rsrqbds+bds_bufptr+1 ;multiply high	byte by 2	inc rsrqbds+bds_bufptr+1 ;and again to give effect of *512	bra getnext	;get next packetdone		;       	rep #mbit+xbit	longa on	longi on	jml code	;really jump to code in real versionnocanboot		; 	pea $0000	;switch in bank 0 data	plb	plb	sec	;go to emulation mode	xce	longa off	longi off	lda romread	;switch in the rom;The following load has been changed from a lda #$c7.  We can't assume;slot 7 anymore.	export toSlotScantoSlotScan	LDA #$C7	sta $1	jml $faba	ENDP** atp.vars*initblock	PROC	;initialized data	entry bootstart	; EXPORT -> ENTRY  **TGHbootstart		; 	entry initparms	; EXPORT -> ENTRY  **TGHinitparms	DC.B $00,$01,$00,$00 ;open the drivers	DC.B $80,$00,$00,$00,$00 ;past junk	DC.B $00	;pick a node, any node	DC.B $00,$00	entry openparms	; EXPORT -> ENTRY  **TGHopenparms	DC.B $00,$14,$00,$00,$00 ;open a dynamic socket	entry closeparms	; EXPORT -> ENTRY  **TGHcloseparms	DC.B $00,$15,$00,$00,$00 ;for closing up	entry lookparms	; EXPORT -> ENTRY  **TGHlookparms	DC.B $00,$10,$00,$00 ;cnt, cmd, result	DC.B $00,$00,$00,$00 ;completion routine	DC.L entityblk	;entity name stuff	DC.B 1	;look every 1/4 sec	DC.B 30	;look up to 30 times	DC.B $00,$00	;reserved bytes	DC.W 100	;100 byte buffer	DC.W lookbuf	DC.W $e1	DC.B $01	;only want 1 match total	DC.B $00	;number gotten	entry srqparms	; EXPORT -> ENTRY  **TGHsrqparms	DC.B $00,$12,$00,$00 ;cnt, cmd, result	DC.B $00,$00,$00,$00 ;io completion	DC.B $00	;our socket (listener socket)	DC.B $00,$00	;their network	DC.B $00	;their node	DC.B $00	;their skt	DC.B $00,$00	;their tid	DC.W 0	;buffer to send size	DC.L 0	;no buffer used	DC.B $00,$00,$00,$00 ;user bytes	DC.B $01	;1 response buffer	DC.W rsrqbds	;bds for input	DC.W $e1	DC.B $00	;flag	DC.B $02	;every 1/2 second	DC.B 20	;try 20 times	DC.B $01	;bitmap for request	DC.B $00	DC.B $00,$00,$00,$00,$00,$00 ;reserved fields	entry srqbds	; EXPORT -> ENTRY  **TGHsrqbds	DC.W 512	;max buf size	DC.L code	;start code here   	DC.B $00,$00,$00,$00 ;user bytes filled	in 	DC.B $00,$00	;and actual length received	entry bootend	; EXPORT -> ENTRY  **TGHbootend		;           ;end of	boot code to be moved	entry iparmstart	; EXPORT -> ENTRY  **TGHiparmstart		; atpreadp		; 	DC.B 00	DC.B 8	DC.B $00,$00	DC.W 8	DC.W atpheader	DC.W $e1	DC.B $00	;don't purge	DC.B $00,$00	;number of bytes read returned here	entry iend	; EXPORT -> ENTRY  **TGHiend		; ;end of inited data	ENDPromblock	PROC	;this data is romable	entry rsptable	; EXPORT -> ENTRY  **TGHrsptable	DC.B 13	;ld.dskt	DC.B 00	;ld.snet	DC.B 00	;ld.snet+1	DC.B 12	;ld.snode	DC.B 14	;ld.sskt	DC.B $82	;tidh (atp) switch to atp header	DC.B 03	;tidl (atp)	DC.B $ff	;end of compare table	entry rspcbtable	; EXPORT -> ENTRY  **TGHrspcbtable	DC.B 13	;ld.dskt	DC.B 09	;ld.snet	DC.B 10	;ld.snet+1	DC.B 12	;ld.snode	DC.B 14	;ld.sskt	DC.B $82	;tidh (atp) switch to atp header	DC.B 03	;tidl (atp)	DC.B $ff	;end of compare table	entry grqtable	; EXPORT -> ENTRY  **TGHgrqtable	DC.B 13	;only verify against ourskt	DC.B $ff	;end of table	entry canceltable	; EXPORT -> ENTRY  **TGHcanceltable	DC.B $00,$00,$00,$00,$00 ;skip first 5 items	DC.B creq_tid	;low byte of tid in	list	DC.B creq_tid+1	;high byte of tid in list	DC.B $ff	;end of list	entry attachtable	; EXPORT -> ENTRY  **TGHattachtable	DC.B rspcb_sskt	;table corresponds directly	DC.B rspcb_dnet	;to the sendresponse packet	DC.B rspcb_dnet+1	;so the order of these should	DC.B rspcb_dnode	;match the order of	sendresponse	DC.B rspcb_dskt	;stuff	DC.B rspcb_tid	DC.B rspcb_tid+1	DC.B $ff	entry addtable	; EXPORT -> ENTRY  **TGHaddtable	DC.B addrsp_sskt	DC.B addrsp_dnet	DC.B addrsp_dnet+1	DC.B addrsp_dnode	DC.B addrsp_dskt	DC.B addrsp_tid	DC.B addrsp_tid+1	DC.B $ff	entry reltable	; EXPORT -> ENTRY  **TGHreltable	DC.B relcb_ourskt	DC.B relcb_snet	DC.B relcb_snet+1	DC.B relcb_snode	DC.B relcb_sskt	DC.B relcb_tid	DC.B relcb_tid+1	DC.B $ff	entry onebitmask	; EXPORT -> ENTRY  **TGHonebitmask	DC.B $01,$02,$04,$08,$10,$20,$40,$80	entry lowbitmask	; EXPORT -> ENTRY  **TGHlowbitmask	DC.B $00,$01,$03,$07,$0f,$1f,$3f,$7f,$ff	entry entityblk	; EXPORT -> ENTRY  **TGHentityblk		; 	DC.B 1	DC.B '='	DC.B tylen	;length of type	entry tystart	; EXPORT -> ENTRY  **TGHtystart		; 	DC.B 'Apple //gs'tylen	equ *-tystart	DC.B 1	DC.B '*'	ENDP;xxxxxx	equ (openparms-initparms)	END