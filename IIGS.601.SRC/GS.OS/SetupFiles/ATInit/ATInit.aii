		msb	off		string	asis		print	sym		print	nopage		print	nomdir*opennet* this file moves all new code that is going into bank* $e0 language card	area.  It checks for a card and calls init.* After init it calls the start vectors	for any protocols that* have been added, like PAP, RPM, ZIP, and any patches.*           by*           Greg Seitz*           15-Apr-86** Copyright Apple Computer, Inc.  1986* All Rights Reserved* Version 1.2** 27-Aug-86 (gws)* -now supports running under both types of prodos,* and has an entry point for a seperate	loader to call* it in full native	mode.** 19-Jun-86 (GWS)* -it now relocates	pap, rpm, & zip into bank e1*  and calls them to allow themselves to be installed*** 24-Sept-86 (RBH)* Changed interrupt	vector for the ParaMIS card for the umpteenth time* it is now CN19** 30-Sept-86 (RBH)* Turn on interrupts for the Apple //** 28-Oct-86 (gws)* -installed code to call nbppatch routine within zip* -added 1 more page to size of area to	move, now ends at $3aff** 17-Nov-86 (gws)* -added patch to low level LAP packet dispatch routine to verify proper bank* configuration.** 24-Nov-86 (par)* -added call to HardReset to reinitialize ATalk variables when ATINIT is* loaded. now done by atpatch** 30-Apr-87 (gws)* -re-configured atinit to handle only starting the system from prodos 16,* it starts the paramis card if found when running p16.  This file previously* contained all the	ram based protocols	such as pap,rpm,zip.  Those files* are now kept in atload which is dynamically loaded into available memory* by the loader.  Therefore, built in Appletalk no longer requires use of* the language card	area in bank $e0.** 19-APR-88 (gws)* file is now only a stub to hold data,	the only code here is an rts* at the start to prevent old load files from crashing if they attempt* to execute this.************************************************************************************		print	off		INCLUDE 'm16.util'		print	onopennet		PROC		rts			;not allowed to boot prodos 8 with this	file		ENDPloadrec		PROCusername	str ''			;No default user name so that ATRESPONDERnamelen		equ *-username		;will ask for a name.		DS.B 33-namelenprflag		DC.B $a0		;Printer flag.prnameobjname		str 'WBJ'		;Default printer name goes here.typename	str 'LaserWriter'zonename	str '*'ptrlen		equ *-prname		DS.B 99-ptrlen		ENDP;---------------------------------------------------------------------------------		END	