		msb	off		string	asis		print	sym		print	nopage		print	nomdir;-----------------------------------------------------------------------------------;; This is an implementation of Responder (Snitch) for the Apple IIgs. It; is designed to kludge up a Macintosh like Responder packet so that the; application Inter-Poll (007) will be able to display system info.;; Tim Harrington	February 2nd, 1988;; Modification history:;;Version	Date		Who	Comments;-------	---------	---	---------------------------------------------;0.10A	Ã	02-Feb-88	TGH	Project started;;0.11A	Ã	05-Feb-88	TGH	Fixed BDS buffer length from a byte to a word;	Ã			TGH	Added support for P16 version number and OS;					type currently loaded.;	Ã			TGH	Ignore anything but a command = 1;;0.12A	Ã	05-Feb-88	TGH	OS Loaded field now reports ?? if the OS type;					byte (E100BC) = $FF;;0.13A	Ã	08-Feb-88	TGH	Fixed ignore bug. If I got anything but a;					command 1 from 007, I didn't que up the next;					request.;;0.14A	Ã	09-Feb-88	TGH	I now look for the user name in ATINIT as;					the name to register.;;0.15A	Ã	09-Feb-88	TGH	The user name gets bumped up by digits when;					a duplicate name error occurs when registering;					the user's name.;;0.16B	Ã	12-Feb-88	TGH	Converted to MACtoGS assembler.;;0.17B	Ã	18-Feb-88	TGH	Added Current Application string as the third;					string in the response packet.;	Ã			TGH	I now register the default printer entity name;					to RPM.;	Ã			TGH	Replaced 'Apple IIgs Snitch' with just 'Apple IIgs';	Ã			TGH	Put myself into the priority vector to make sure I;					run after AppleTalk has been initialized.;0.18B	Ã	19-Feb-88	TGH	Prompt the user if the user name is null in the;					ATINIT file.;	Ã			TGH	Changed AppleTalk version number in response;					packet from 0 to 1.;;0.19B	Ã	22-Feb-88	TGH	Fixed bug in ATP Response packet.  The bytes are;					now correct and the AT version word says 0001.;					The bug was in the MACtoGS assembler!;	Ã			TGH	Added check to see if AppleTalk is active.;	Ã			TGH	Save off the user name if it was null and they;					typed in a new one.;	Ã			TGH	No longer return application name, I now return;					the currently choosen/selected LaserWriter name.;;0.20B	Ã			TGH	Released to the outside for review.;;0.21B	Ã			TGH	Added RTS to the end of the BuildPacket routine.;	Ã			TGH	Took beep out if I ever error out.;	Ã			TGH	Fixed crash if the number at the end of the user;					name got bumped past 99.;;0.22B	Ã			TGH	Changed response message. Took out ' - ' and;					changed them to ': ';;0.23B	Ã	25-Feb-88	TGH	Fixed bug in default name <Unnamed>. I had a;					comment on the same line as a STR directive.;;10A1	Ã	1-MAR-88	TGH	Added extra checking to make sure AppleTalk;					really got loaded.;					This file resides on disk as a STR (Init) and;					$BC (Load) file.;;10A2	Ã	3-MAR-88	TGH	Fixed RPM call so that I get the status of;					the printer instead of setting it.;;10A3	Ã	8-MAR-88	TGH	Now saving off prefix 0 during the loading of;					the ATINIT file.;;10A5	Ã	9-MAR-88	TGH	Changed to an asyncronous call to register the;					name.;		11-MAR-88	TGH	No longer display a name when registering.;;10A6	Ã				No changes;;10B1	Ã	13-APRIL-88	TGH	Changed maximum name length to 31 instead of 32.;					Added Flush call after Write to fix the problem;					with write protected disks in a UniDisk drive.;					Took out debuging code that was causing some;					crashes.;;10B2	Ã	18-APRIL-88	TGH	Changed timeout value in RPM setup from 15;					seconds to 30 seconds.;;10B3		25-APRIL-88	TGH	Now re-register the user name on RESET.;;11B1		14-July-88	MSD	Console forces text mode (for GS/OS).;;11B2		12-Aug-88	TGH	Save and restore SHR mode when asking for;					a user name (for GS/OS).;;11B3		12-Aug-88	TGH	Changed the order of saving and setting the;					SHR mode byte.;					Took responder out of the priority chain.;;11B4		8-Sept-88	TGH	Uses GS/OS console driver.;;		26-Jan-89	MSD	Closes console driver (had the wrong command;					number, $1C = GetDirEntry).;;11B5		13-March-89	TGH	Changed 'ProDOS 16' -> 'GS/OS';; 101		24-April-89	TGH	Added CancelReq call if not a Inter¥Poll;					packet.  Fixed stack bug in error handling;					condition code in GetRequest completion;					routine.  Changed version number.;; 		26-April-89	TGH	Changed verticle bars in user name prompt;					box to left and right verticle bars;					(mousetext.);;		15-May-89	MSD	Now turns off SuperHiRes after the console;					driver is initialized and just before it;					is read from.  This minimizes the text;					garbage one will see before being asked;					for your user name.;; 102		24-Jul-89	MSD	Changed check for AppleShare FST version.;					If there is no AppleShare FST, the version;					is set to 0.00.  It used to abort without;					registering the user's name, or setting;					the default printer.  It now continues.;; 103		30-Jan-91	MSD	Removed a STA >$0A0000 instruction that was;					trashing memory (it was probably left over;					from some debugging).;;-------------------------------------------------------------------------------------;; Things yet to do:;;	Check the system type to determine what kind of Apple II I'm;	running on.;;-------------------------------------------------------------------------------------		MACHINE	M65816	R0		equ	0			;Zero page location (4 bytes)R1		equ	4			;Zero page location (4 bytes)Version		equ	$0301			;This is the version of Responder (1.0.3)softreset	equ	$E11010AT_Entry	equ	$E11014			;AppleTalk entry pointPriorityVec	equ	$E1103A			;Address of vector listP16_Entry	equ	$E100A8			;Entry point for all P16 OS callsOS_Type		equ	$E100BC			;Currently running ProDOS type (8 or 16)		print	off		INCLUDE	'm16.util'		print	on;----------------------------------------------------------------------------------------; Below is the main entry point for this file.  We aren't quit sure in what state we're; called, so we better save it off and reset it.MAIN		PROC		clc				;Make sure we're in native mode.		xce		php				;Save the current state of the		phb				;processor and bank registers.		phk				;Set the data bank to our		plb				;program bank.		rep	#$30			;Long all		longa	on		longi	on		stz	DeviceNumDeviceLoop	inc	DeviceNum		jsl	P16_Entry		;Do a DInfo call on every driver		dc.w	$202C			;until we find DeviceID=001D or		dc.l	DInfoList		;we run out of drivers.		bcs	ATNotThere		;Branch to exit on any error!		lda	DeviceID		cmp	#$001D		bne	DeviceLoop		jsr	realinstallATNotThere	plb		plp		rtlDInfoList	dc.w	0008			;Parameter countDeviceNum	dc.w	0000			;Device number		dc.l	DeviceName		;Device name pointer		dc.w	0000			;Characteristics		dc.l	00000000		;Total blocks		dc.w	0000			;Slot number		dc.w	0000			;Unit numberDeviceVersion	dc.w	0000			;VersionDeviceID	dc.w	0000			;DeviceIDDeviceName	dc.w	0037			;Buffer size		ds.b	35			;33 bytes in buffer;----------------------------------------------------------------------------------------; SetVec will install us into the priority chain vector.  If there's nothing in the; vector, then we just install ourselves.  Otherwise we put ourselves in the correct; order so we get called last.realinstall	jsl	P16_Entry		;P16 version call		DC.W	$2A		DC.L	P16Version		bcc	VerOKBad_Exit2	jmp	Bad_ExitVerOK		lda	#0512		sta	BlockBuffer		stz	FSTNumber@L1		inc	FSTNumber		jsl	P16_Entry		;P16 GetFSTInfo call		dc.w	$202B		dc.l	GetFSTVersion		bcs	no_fst		lda	FSTID		cmp	#$000D			;Is it AppleShare?		bne	@L1		beq	got_fst_versno_fst		stz	FSTVersion		; FST v0.00 means no FST foundgot_fst_vers		sep	#$30		longa	off		longi	off;------------------------------------------------------------------------------; The following code will take a version number and change it as follows:;; 102B (1.02B) -> 12;; I have to do this because Interpoll only wants a byte version string.  This; will look somewhat funny but I think it's the easiest to figure out for; a lab administrator.;------------------------------------------------------------------------------		lda	DeviceVersion+1		;Load the most significant byte.		and	#$F0			;Strip of low nibble (discard).		sta	RespPacket+1		;Store it in packet buffer.		lda	DeviceVersion		;Load the least significant byte.		lsr	a			;Shift it into the low nibble.		lsr	a		lsr	a		lsr	a		ora	RespPacket+1		;Add it to most significant byte		sta	RespPacket+1		;and store it in packet buffer.;------------------------------------------------------------------------------; The following code will take the FST version number and change it as follows:;; 8201 (2.01P) -> "2.01";------------------------------------------------------------------------------		lda	FSTVersion+1		and	#$0F		ora	#$30		sta	AFPVersion1		lda	FSTVersion		lsr	a		lsr	a		lsr	a		lsr	a		ora	#$30		sta	AFPVersion2		lda	FSTVersion		and	#$0F		ora	#$30		sta	AFPVersion3		rep	#$30		longa	on		longi	on		jsr	BuildPacket		bcs	Bad_Exit2		lda	GICompl			;Shove the completion vector into...		sta	RegCompl		;The RegisterName call block,		sta	ATPDone			;The GetATPReq completion routine,		lda	GICompl+2		;Don't forget the high bytes!		sta	RegCompl+2		sta	ATPDone+2;	Ask for a ATP socket number		ldx	#OATPSocket		;OpenATPSocket		ldy	#^OATPSocket		;Open a listener socket for our		jsl	AT_Entry		;ATP packets		bcs	Bad_Exit		;Branch if error		sep	#$20			;Go short		longa	off		lda	Socket			;Store the ATP socket number into...		sta	RegSocket		;The RegisterName call block		sta	ReqSocket		;The GetATPRequest call block		sta	ResSocket		;The SendATPResp call block		sta	RelSocket		;The RecATPCB call block		rep	#$30			;Back to long		longa	on		jsl	P16_Entry		;Save prefix 0		DC.W	$0A		DC.L	SavePrefix		jsr	Find_ATINIT		;Get the name to register from ATINIT		jsr	ShowName		;Ask for one if we need it		jsl	P16_Entry		;Restore prefix 0		DC.W	09		DC.L	SavePrefix		jsr	ConcatName		;Build entity name		ldx	#RegName		;RegisterName		ldy	#^RegName		;Register our name onto the net		jsl	AT_Entry		lda	PRegFlag		;Is there a printer to register?		beq	StartReq		;Branch if not		ldx	#NetPrinter		;Set the default net printer		ldy	#^NetPrinter		jsl	AT_Entry		;If there's an error, oh well.StartReq	; ;	Start the asyncronous request call		ldx	#ATPReq			;GetATPReq		ldy	#^ATPReq		;Asyncronous get.request call		jsl	AT_Entry		php		sei		lda	softreset		;get the current reset vector		sta	proldreset		;and store internally		lda	softreset+2		sta	proldreset+2		;now we have the old vector		lda	jpatchesreset		;store a jml ourreset		sta	softreset		;into vector		lda	jpatchesreset+2		sta	softreset+2		plpBad_Exit	rts;		we re-install misc patches herepatchesreset					 ;should come here during reset		php				;save mode bits		phb				;and databank		jsl	proldreset		;let lower protocol get called first		phk				;set up data bank		plb		jsl	reinstall		;re-install echo code		plb				;restore bank		plp				;and mode bits		rtl				;and return to our callerjpatchesreset	jml	>patchesresetproldreset	jml	>000000reinstall	php		rep	#$30		longa	on		longi	on		pha		phx		phy		jsr	BuildPacket		bcs	ReQExit		lda	GICompl			;Shove the completion vector into...		sta	RegCompl		;The RegisterName call block,		sta	ATPDone			;The GetATPReq completion routine,		lda	GICompl+2		;Don't forget the high bytes!		sta	RegCompl+2		sta	ATPDone+2;	Ask for a ATP socket number		lda	#0000		sta	Socket		ldx	#OATPSocket		;OpenATPSocket		ldy	#^OATPSocket		;Open a listener socket for our		jsl	AT_Entry		;ATP packets		bcs	ReQExit			;Branch if error		sep	#$20			;Go short		longa	off		lda	Socket			;Store the ATP socket number into...		sta	RegSocket		;The RegisterName call block		sta	ReqSocket		;The GetATPRequest call block		sta	ResSocket		;The SendATPResp call block		rep	#$30			;Back to long		longa	on		jsr	ConcatName		;Build entity name		ldx	#RegName		;RegisterName		ldy	#^RegName		;Register our name onto the net		jsl	>AT_Entry		lda	PRegFlag		;Is there a printer to register?		beq	ReQ			;Branch if not		ldx	#NetPrinter		;Set the default net printer		ldy	#^NetPrinter		jsl	>AT_Entry		;If there's an error, oh well.ReQ		ldx	#ATPReq			;GetATPReq		ldy	#^ATPReq		;Asyncronous get.request call		jsl	>AT_EntryReQExit		ply		plx		pla		plp		rtl;-------------------------------------------------------------------------;; This routine will put any information I can get into the ATP response; packet. We do add more information later though.BuildPacket	; ;	Now we get some AppleTalk information		ldx	#GIMisc			;GetInfo		ldy	#^GIMisc		;I do this so I can get the completion		jsl	AT_Entry		;vector for my asyncronous calls.		bcs	Skip1			;Branch if error		lda	GIROMVers		;Store the ROM version into the		xba				;ATP response packet		sta	RespROM			;ROM 85 version field		sep	#$30		longi	off		longa	off		lda	P16Version		;Load the low byte		ora	#$30			;Make it ASCII		sta	SVLow			;Store it in buffer		lda	P16Version+1		;Load the high byte		pha				;Save it for later		and	#$7F			;Mask off prototype bit		ora	#$30			;Make it ASCII		sta	SVHigh			;Store it in buffer		lda	#$20			;Default prototype byte to space ' '		sta	SVBit		pla				;Get high byte of version number		and	#$80			;Mask off all but prototype bit		beq	Skip1			;If it's equal to 0, use the space		lda	#$50			;Otherwise use a 'P'		sta	SVBitSkip1		rep	#$30		longi	on		longa	on		rts;-------------------------------------------------------------------------;; This routine will attempt to do a block read from the boot volume. If; it returns with a network error, then I know I booted of the network and; I have to get the user's system path from the net. Otherwise I just grab; the ATINIT file from the */SYSTEM/SYSTEM.SETUP/ directory.; If for any reason I can't extract a user name from either method, I just; use the entity name <Unnamed>:Apple IIgs@*.		longa	on		longi	onFind_ATINIT	stz	PRegFlag		;printer name to register.		jsl	P16_Entry		;Get the deviceID for device #1		dc.w	$202C			;DInfo		dc.l	DInfo		bcs	NoName		lda	DInfoID		cmp	#$001E			;Is is = .AFPn?		bne	LocalDisk		;Branch if not.NetDisk		ldx	#UserPrefix		;Get the user's boot prefix		ldy	#^UserPrefix		jsl	AT_Entry		bcs	NoName			;Branch if error		jsl	P16_Entry		;Set prefix 0 out to that path		DC.W	09		DC.L	SetNet0		bcs	NoName			;Branch if error		jsl	P16_Entry		;Set prefix 0 to prefix 0 + SETUP/		DC.W	09		DC.L	SetNet1		bcs	NoName			;Branch if error		bra	OpenIt			;Try to open ATINITLocalDisk	jsl	P16_Entry		;Set the prefix out to		DC.W	$09			;'*/SYSTEM/SYSTEM.SETUP/'		DC.L	SetLocal		bcc	OpenItNoName		sep	#$30		longa	off		longi	off		jsr	MoveUnnamed		bra	BuildRest		;Append the rest of the name and exit;						 If this happens, no printer will be selected;						 to print to.  Ahhhh, too bad!		longa	on		longi	onOpenIt		jsl	P16_Entry		;Open the ATINIT file		DC.W	$10		DC.L	InitFile		bcs	NoName			;Branch if error		lda	InitFile		;Move the file reference number		sta	EOFBlock		;into the get and set eof call blocks		sta	ReadName		;and the read file call block		jsr	SetTheMark		bcs	CheckError		jsl	P16_Entry		;Read in the default user name		DC.W	$12		DC.L	ReadNameCheckError	pha				;Save the error state		jsl	P16_Entry		;Close the file		DC.W	$14		DC.L	InitFile		pla				;Get the old error state back		bne	NoName			;Branch if it's an error		sep	#$30		longa	off		longi	off		ldx	BlockBuffer		;Load the default user name length		stx	RealLength		;Store it for later use by BumpName		beq	NSkip			;If it's zero then don't move anythingNLoop1		lda	BlockBuffer,x		;Move the default user name into our		sta	UserName,x		;user name.		dex		bpl	Nloop1NSkip		lda	BlockBuffer+33		;Load the printer flag and store		sta	PFlag			;it into the setprinter call block		dec	PRegFlag		;Flag that we have a cadidate for the;						 printer name to register.BuildRest	rep	#$30		longa	on		longi	on		rts				;Exit in long native mode		longa	off		longi	offMoveUnnamed	ldx	Unnamed			;This routine will move the string		stx	RealLength		;'<Unnamed>' into the UserName field.NLoop3		lda	Unnamed,x		sta	UserName,x		dex		bpl	NLoop3		rts		longa	on		longi	onSetTheMark	jsl	P16_Entry		;Get ATINIT's EOF marker		DC.W	$19		DC.L	EOFBlock		bcs	SetSkip			;Branch if error, close file first		sec				;Subtract 133 ($85) from the EOF to		lda	EOF			;get to the user's default name and		sbc	#133			;store the result back into the		sta	EOF			;call block		lda	EOF+2		sbc	#0		sta	EOF+2		jsl	P16_Entry		;Set the mark to this new value		DC.W	$16		DC.L	EOFBlockSetSkip		rtsSavePrefix	DC.W	0		;Save and restore prefix 0		DC.L	ReqBufferDInfo		dc.w	8		;PCount		dc.w	1		;Device number		dc.l	DevName		;Device name (result)		dc.w	0		;Characteristics (result)		dc.l	0		;Total blocks (result)		dc.w	0		;Slot number (result)		dc.w	0		;Unit number (result)		dc.w	0		;Version (result)DInfoID		dc.w	0		;Device ID (result) <- We want only thisDevName		ds.b	34		;Device name gets put here from DINFO callSetLocal	DC.W	0		DC.L	LocPtrLocPtr		str	'*/SYSTEM/SYSTEM.SETUP/'InitFile	DS.B	2		;Open and close parameter blocks		DC.L	InitName	;for the ATINIT file.		DS.B	4InitName	str	'ATINIT'SetNet0		DC.W	0		DC.L	BlockBufferBlockBuffer	DS.B	512		;This is a general purpose bufferSetNet1		DC.W	0		DC.L	NetPtrNetPtr		str	'SETUP/'EOFBlock	DS.B	2EOF		DS.B	4ReadName	DS.B	2		;Read block for reading the ATINIT file		DC.L	BlockBuffer		DC.L	133		;Request count		DS.B	4		;Transfer countWriteName	DS.B	2		;Write block for writting the ATINIT file		DC.L	UserName		DC.L	33		DS.B	4Unnamed		str	'<Unnamed>'					;Default user name if I can't get one.UserPrefix	DC.B	0		;Sync		DC.B	$2A		;FIUserPrefix		DS.B	2		;Result		DC.B	0		;1 byte of reserved 0		DC.L	BlockBufferNetPrinter	DC.B	0		;Sync		DC.B	$28		;PMSetPrinter		DS.B	2		DC.L	BlockBuffer+34	;Entity name pointerPFlag		DS.B	1		DC.W	2		DC.W	30*4		DC.W	20PRegFlag	DS.B	2			;This flag is clear (zero) if I couldn't;						 get to a possible printer name.  It's;						 $FFFF if I did find a possible name.;*******************************************************************************************;-----------------------------------------------------------------------------------------; 		Screen routines and data are below.;ShowName	php				;Save the state of the m and x bits.		sep	#$30		longa	off		longi	off		lda	UserName		;Load the default user name length.		beq	GetOneShowExitShort	jmp	ShowExit		;Jump if it's non-zero.GetOne		rep	#$30		longa	on		longi	on		jsl	P16_Entry		;Get the console drivers dev #		DC.W	$2020		DC.L	CDevNumber		bcs	ShowExitShort		jsl	P16_Entry		;Open the console driver		DC.W	$2010		DC.L	OpenCon		bcs	ShowExitShort		lda	ConDevNum		sta	ResetConDev		sta	GetIDevNum		sta	SetIDevNum		sta	SetTDevNum		sta	SetWDevNum		sta	SetRDevNum		lda	ConRefNum		sta	ReadConRef		sta	DrawConRef		sta	CloseConRef		jsr	PrepareConsole		bcs	SCloseExit		sep	#$20			; MSD: short A for I/O		longa	off		lda	>$E1C029		;Save the current state of the		sta	HoldSHR			;SHR screen.		and	#$7F			;Turn off SHR mode.		sta	>$E1C029		rep	#$20			; MSD: return to long A		longa	on				jsl	P16_Entry		;Read		dc.w	$2012		dc.l	ReadCon		bcs	SCloseExit		jsl	P16_Entry		;Get the current input settings		dc.w	$202D		dc.l	GetInputParms		bcs	SCloseExit		lda	InputPort+8		;Get the last terminator		and	#$00FF		cmp	#0013		beq	@L1		stz	ReadCount@L1		lda	ReadCount		and	#$00FF		ora	UserName		sta	UserName		sep	#$30		longa	off		longi	off		lda	HoldSHR			;Restore the old state of the		sta	>$E1C029		;SHR screen.		jsr	SaveName		;Save the new name to disk.		lda	UserName		;Load the new user name length.		sta	RealLength		;Save it for the BumpName routine.		bne	ShowExit		;Branch if it's non-zero.		jsr	MoveUnnamed		;They entered no name or hit escape, just;						 use <Unnamed>.SCloseExit	jsl	P16_Entry		;Close the console driver		DC.W	$2014			; MSD		DC.L	CloseConShowExit	plp				;Restore the m and x bits		rts		longa	on		longi	onPrepareConsole	jsl	P16_Entry		;Reset the console driver		DC.W	$202E		DC.L	ResetCon		bcs	@L1		jsl	P16_Entry		;Draw the main screen.		DC.W	$2013		DC.L	DrawCon		bcs	@L1		jsl	P16_Entry		;Get the current input settings		dc.w	$202D		dc.l	GetInputParms		bcs	@L1		lda	#$80C9		sta	InputPort		;Set fillchar ('ghost space')						;and cursor mode (defualt)		jsl	P16_Entry		;Set the new input settings		dc.w	$202E		dc.l	SetInputParms		bcs	@L1		jsl	P16_Entry		;Set the terminators		dc.w	$202E		dc.l	SetTerminators		bcs	@L1		jsl	P16_Entry		;Set the wait mode		dc.w	$202E		dc.l	SetWaitMode		bcs	@L1		jsl	P16_Entry		;Set the read mode		dc.w	$202E		dc.l	SetReadMode		bcs	@L1		clc@L1		rts		longa	off		longi	offHoldSHR		ds.b	1			;For holding the state of the SHR						;mode byte (just the high bit);------------------------------------------------------------------------------------------;	Console data is below;CDevNumber	dc.w	0002			;Parameter count		dc.l	ConName			;Device name pointerConDevNum	dc.w	0000			;Device numberConName		dc.w	0008			;Device name length		dc.b	'.CONSOLE'		;Device nameResetCon	dc.w	0005			;Parameter countResetConDev	dc.w	0000			;Device number		dc.w	0000			;Reset Device		dc.l	Reset			;List pointer		dc.l	0			;Request count		dc.l	0			;Transfer countReset		dc.w	0OpenCon		dc.w	0002			;Parameter countConRefNum	dc.w	0000			;File reference number		dc.l	ConName			;File name pointerCloseCon	dc.w	0001			;Parameter countCloseConRef	dc.w	0000			;File referenc numberDrawCon		dc.w	0004			;Parameter countDrawConRef	dc.w	0000			;Reference number		dc.l	DrawBuff		;Pointer to write buffer		dc.l	DrawLength		;Request count		dc.l	0			;Transfer countReadCon		dc.w	0004			;Parameter countReadConRef	dc.w	0000			;Reference number		dc.l	UserName+1		;Pointer to write buffer		dc.l	0031			;Request countReadCount	dc.l	0			;Transfer countGetInputParms	dc.w	0005			;Parameter countGetIDevNum	dc.w	0			;Device number		dc.w	$8001			;GetInputPort		dc.l	InputPort		;List pointer		dc.l	12			;Request count		dc.l	0			;Transfer countSetInputParms	dc.w	0005			;Parameter countSetIDevNum	dc.w	0			;Device number		dc.w	$8000			;SetInputPort		dc.l	InputPort		;List pointer		dc.l	12			;Request count		dc.l	0			;Transfer countSetTerminators	dc.w	0005			;Parameter countSetTDevNum	dc.w	0			;Device number		dc.w	$8001			;SetTerminators		dc.l	Terminators		;List pointer		dc.l	TermLength		;Request count		dc.l	0			;Transfer countSetWaitMode	dc.w	0005			;Parameter countSetWDevNum	dc.w	0			;Device number		dc.w	$0004			;SetWaitStatus		dc.l	WaitMode		;List pointer		dc.l	0002			;Request count		dc.l	0			;Transfer countWaitMode	dc.w	0SetReadMode	dc.w	0005			;Parameter countSetRDevNum	dc.w	0			;Device number		dc.w	$8003			;SetReadMode		dc.l	ReadMode		;List pointer		dc.l	0002			;Request count		dc.l	0			;Transfer countReadMode	dc.w	0DrawBuff	dc.b	$0C			;Clear the screen		dc.b	$1B			;Moustext on		dc.b	$02,10+32,9+32,69+32,16+32 ;Set text port size		dc.b	$1E,2+32,6+32		;GotoXY		dc.b	'OK: '		msb	on		dc.b	'M'		msb	off		dc.b	$1E,47+32,6+32		;GotoXY		dc.b	'Esc: Cancel'		dc.b	$1E,4+32,2+32		dc.b	'Please Enter a User Name: '		dc.b	$19			;Home cursor		dc.b	$15,$01			;Set cursor movement.		dc.b	' __________________________________________________________ '		dc.b	$1E,0+32,1+32		;GotoXY		msb	on		dc.b	'Z',$0A,$08,'Z',$0A,$08,'Z',$0A,$08,'Z',$0A,$08,'Z',$0A,$08,'Z',$0A,$08		msb	off		dc.b	$1E,59+32,1+32		;GotoXY		msb	on		dc.b	'_',$0A,'_',$0A,'_',$0A,'_',$0A,'_',$0A,'_',$0A		msb	off		dc.b	$1E,0+32,7+32		;GotoXY		dc.b	' '		msb	on		dcb.b	58,'L'		msb	off		dc.b	' '				dc.b	$15,$1F			;Set cursor movement.		dc.b	$1E,4+32,4+32		;GotoXY (for input)DrawLength	equ	*-DrawBuffInputPort	ds.b	12Terminators	dc.w	$007F			;AND mask		dc.w	$0002			;Term count		dc.w	0027		;Escape		dc.w	0013		;ReturnTermLength	equ	*-Terminators;-----------------------------------------------------------------------------------------; The routine below will save the new username off to disk.  The prefix should be already; set to the appropriate setup directory.SaveName	lda	UserName		;Only save the name if it's a non-null		beq	ShowS1		rep	#$30		longa	on		longi	on		jsl	P16_Entry		;Open the ATINIT file		DC.W	$10		DC.L	InitFile		bcs	ShowS1			;Branch if error		lda	InitFile		;Move the file reference number		sta	EOFBlock		;into the get and set eof call blocks		sta	WriteName		;and the read file call block		jsr	SetTheMark		bcs	ShowS2		jsl	P16_Entry		;Write out the default user name		DC.W	$13		DC.L	WriteName		jsl	P16_Entry		;Flush in case we're working on a		DC.W	$15			;UniDisk and it's write protected.		DC.L	WriteNameShowS2		jsl	P16_Entry		;Close the file		DC.W	$14		DC.L	InitFileShowS1		sep	#$30		longa	off		longi	off		rts;*******************************************************************************************;-------------------------------------------------------------------------; RegAgain is the completion routine for the asyncronous RegisterName call.; If there was an error in registering the name, it will bump the number at; the end of the name and try to re-register it.		longa	on		longi	onRegAgain	php		phb		lda	RegResult		;Load the error		cmp	#$0402			;Does the name already exist?		bne	RegExit			;Branch if different error		jsr	BumpName		;Add number to user name		bcs	RegExit		jsr	ConcatName		;Add the type and zone fields.RegSkip		ldx	#RegName		;RegisterName		ldy	#^RegName		;Register our name onto the net		jsl	AT_EntryRegExit		plb		plp		jmp	>$FFFFFF		;Seeya-RegCompl	equ	*-3		nop				;This nop gets overlayed by the store;						 in the Main segment. This byte never;						 gets executed anyways, so we don't;						 care.;-------------------------------------------------------------------------;; This routine will add a digit to the end of the user name. If a digit; has already been added then it gets incremented. When it rolls over; 9, then another digit is added.BumpName	php				;Save the old state of m and x		sep	#$30		longa	off		longi	off		ldy	RealLength		;Load the original length of the name		bit	BracFlag		;Have we already added a '>' to the end?		bmi	BumpS0			;Branch if so		lda	UserName,y		;Else check to see if there is a '>' on		cmp	#'>'			;the end.		bne	BumpS1			;Branch if there isn't		dec	BracFlag		;Else flag that there is a '>' at the end.BumpS0		dey				;Bump our length byte down by 1 if there;						 is a '>' at the end of the user name.BumpS1		sed				;Decimal mode please		clc				;Bump the number to add to the end of		lda	Num2Add			;the user name by one.		adc	#1		sta	Num2Add		cld		bcs	BumpTooFar		;Branch if we went past 99.		pha				;Save the number for later		and	#$F0			;Get the high nibble (number) only.		beq	BumpS2			;If it's zero, don't use it.		lsr	a			;Shift it into the lower nibble		lsr	a		lsr	a		lsr	a		ora	#$30			;Make it ASCII		iny				;Bump our user name length		sta	UserName,y		;Store this first number at the end.BumpS2		pla				;Get the original number to add, back.		and	#$0F			;Get the low nibble (number) only.		ora	#$30			;Make it ASCII		iny				;Bump our user name length		sta	UserName,y		;Store this second/first number at the end.		bit	BracFlag		;Do we have to add a '>' to the end?		bpl	BumpS3			;Branch if not.		iny				;Else, bump the length and store it at		lda	#'>'			;the end.		sta	UserName,yBumpS3		sty	UserName		;Store the new length of the user name.		plp				;Restore old m and x bits		clc				;Flag successful and exit.		rtsBumpTooFar	plp				;Restore old m and x bits.		sec				;Flag unseccessful and exit.		rtsRealLength	DS.B	1			;This is the original length of the user name.BracFlag	DS.B	1			;This flag is 0 for no '>' else $FF.Num2Add		DS.B	1			;Number to append to end of user name.;--------------------------------------------------------------------------------------;; This routine will add the string 'Apple IIgs*' to the user name with the appropriate; length bytes imbedded. This is to create a entity name for our ATP socket.ConcatName	php				;Save the state of the m and x bits.		sep	#$30		longa	off		longi	off		ldy	UserName		ldx	#0			;Now append the stringNLoop2		inx				;'Apple IIgs''*' to it along		iny				;with the appropriate length bytes		lda	DefStruc,x		sta	UserName,y		cpx	DefStruc		bne	NLoop2		plp				;Restore the state of the m and x bits		rts;*******************************************************************************************;-------------------------------------------------------------------------;; This routine is the ATP socket listener. It gets control when a suspected; Responder packet arrives. A response is sent if appropriate and the request; is re-qeued.		longa	on		longi	onATPComplete	php				;Save the current processor status and		phb				;data bank.		phk				;Set our data bank up		plb		rep	#$30		longa	on		longi	on		lda	ATPReqResult		;Result code to GetRequest		beq	@L1			;If no error, continue		cmp	#$102		beq	Skip0		jmp	ATPExit			;Else leave and never return.@L1		lda	#1			;Make sure we GET the RPM		sta	GetArgs			;printer variables.		ldx	#WhichPrinter		;Find out which printer they are		ldy	#^WhichPrinter		;printing to.		jsl	AT_Entry 		bcs	Skip			;Branch if error.		sep	#$30		longa	off		longi	off		ldx	#30			;Blank out printer name		lda	#' '			;destination in RespPacketLoop0		sta	Printer,x		;buffer.		dex		bpl	Loop0		ldx	BlockBuffer+34		;Move Printer name into		beq	Skip			;destination in ResPacketLoop1		lda	BlockBuffer+34,x	;buffer.		sta	Printer-1,x		dex		bne	Loop1Skip		rep	#$30		longa	on		longi	on		lda	FromUBytes+3		;Load the command from the user bytes field		and	#$00FF		cmp	#1			;Is it a one (1)?		beq	ATPDoIt		lda	FromNet			;Put the source info from the		sta	RelAddr			;GetATPReq call block to the		lda	FromNode		;SendATPResp call block		sta	RelAddr+2		lda	FromTID		sta	RelTID		ldx	#ATPRel			;Release control block		ldy	#^ATPRel		;for bogus packet in case it		jsl	AT_Entry		;was a XO packet.Skip0		jmp	Ignore			;If not, I don't know what it is.;	Below we load the OS type byte.	If it's = $FF then it's;	Unnamed and we just use '??', if it's = $00 then it's P8 and;	we use '8 ', if it's anything else, it's P16 and we use '16'ATPDoIt		lda	OS_Type			;Load the OS type byte		and	#$00FF		beq	Skip2			;If zero then we'll assume P8		cmp	#$00FF			;Unnamed?		beq	Skip3			;Branch if yes		ldx	#GSOSName		bra	Skip4Skip2		ldx	#P8Name		bra	Skip4Skip3		ldx	#UnKnownNameSkip4		pei	<R0		stx	<R0		sep	#$30		longa	off		longi	off		lda	(<R0)		tay@L1		lda	(<R0),y		sta	FOSType-1,y		dey		bne	@L1		rep	#$30		longa	on		longi	on		pla		sta	<R0		lda	FromNet			;Put the source info from the		sta	ToNet			;GetATPReq call block to the		lda	FromNode		;SendATPResp call block		sta	ToNode		lda	FromTID		sta	ToTID		lda	FromFlags		and	#$00FF			;only the low byte		ora	#$0100			;make BitMap = 1		sta	ToFlags			;store flag and bitmap		ldx	#ATPResp		;Send our response		ldy	#^ATPResp		jsl	AT_Entry Ignore		ldx	#ATPReq			;Re-que the request		ldy	#^ATPReq		jsl	AT_Entry ATPExit		plb				;Restore AppleTalk's data bank and		plp				;processor status		jmp	>$FFFFFF		;Seeya-ATPDone		equ	*-3		nop				;This nop gets overlayed by the store;						 in the Main segment. This byte never;						 gets executed anyways, so we don't;						 care.WhichPrinter	DC.B	0			;Sync		DC.B	$28			;PMSetPrinter		DS.B	2		DC.L	BlockBuffer+34		;Entity name pointerGetArgs		DC.B	1			;Get arguments		DS.B	2		DS.B	2		DS.B	2;-------------------------------------------------------------------------;	DATA IS BELOW;-------------------------------------------------------------------------P16Version	DS.B	2GetFSTVersion	dc.w	4			;PCountFSTNumber	dc.w	0FSTID		dc.w	0		dc.l	BlockBufferFSTVersion	dc.w	0GIMisc		DC.B	0		DC.B	2		DS.B	2GICompl		DS.B	4GIThisNet	DS.B	2GIABridge	DS.B	1GIHardID	DS.B	1GIROMVers	DS.B	2GINodeNum	DS.B	1OATPSocket	DC.B	0		DC.B	$14		DS.B	2Socket		DS.B	2			;2 bytes because of word storeRegName		DC.B	$80		DC.B	$0ERegResult	DS.B	2		DC.L	RegAgain		DC.L	NameStruc		DC.B	2			;Retry ever 1/2 second		DC.B	8			;Retry eight times (4 seconds)		DS.B	2			;ReservedRegSocket	DS.B	1			;Socket number		DC.B	0			;Check for duplicates.NameStruc	DS.B	9UserName	DS.B	99DefStruc	DC.B	DefLength		str	'Apple IIgs'		str	'*'DefLength	equ	*-DefStruc+1ATPReq		DC.B	$80		DC.B	$16ATPReqResult	DS.B	2		DC.L	ATPCompleteReqSocket	DS.B	1FromNet		DS.B	2			;Source network numberFromNode	DS.B	1			;Source node number		DS.B	1			;Source socket numberFromTID		DS.B	2			;ATP transactive ID		DC.W	600			;Request buffer length		DC.L	ReqBuffer		;Request buffer pointerFromUBytes	DS.B	4			;User bytes		DS.B	2			;Actual request lengthFromFlags	DS.B	1			;ATP flags		DS.B	1			;Bitmap		DS.B	4			;ReservedATPRel		dc.b	$00			;Sync Flag		dc.b	$19			;RelATPCB call number		dc.w	0			;Result codeRelSocket	dc.b	0			;Response socket #RelAddr		dc.w	0			;Dest Net		dc.b	0			;Dest node		dc.b	0			;Dest socketRelTID		dc.w	0			;TIDATPResp		DC.B	$80		DC.B	$17		DS.B	2		DC.L	0			;No completion routine.ResSocket	DS.B	1ToNet		DS.B	2ToNode		DS.B	1		DS.B	1ToTID		DS.B	2		DC.B	1			;1 response buffer		DC.B	1			;1 ATP packet		DC.L	RespBDSToFlags		DC.B	0			;ATP Flags		DC.B	1			;Current bitmap		DC.L	0			;Add routine pointer		DS.B	1			;Add bitmapRespBDS		DC.W	ATPLength		;Length of packet (53)		DC.L	RespPacket		;Pointer to packet		DC.B	1			;User's bytes (4)		DC.B	0		DC.W	Version		DC.W	0			;Actual lengthRespPacket	DC.W	$0100			;AppleTalk driver version		DC.B	0			;Rom version		DC.B	$25			;System type (Apple IIgs)		DC.B	$02			;System subclass (Apple II series)		DC.B	$02			;Hardware flags (ADB bus only)RespROM		DC.W	0			;ROM 85 version		DC.B	0			;Status byte 1		DC.B	0			;Status byte 2RespStrOffSet	DC.B	str1lenstr1		DC.B	'GS/OS Version: 'SVHigh		DC.B	'1.'SVLow		DC.B	'1'SVBit		DC.B	'P'str1len		equ	*-str1		DC.B	str2lenstr2		DC.B	'OS Loaded: 'FOSType		DC.B	'ProDOS 8'str2len		equ	*-str2		DC.B	str3lenstr3		DC.B	'Network Printer: 'Printer		dcb.b	31,$20str3len		equ	*-str3		dc.w	$0C00			;This has to be 12 in order for						;Interpoll to use the string below.		dc.b	str4lenstr4		AFPVersion1	dc.b	' '		dc.b	'.'AFPVersion2	dc.b	' 'AFPVersion3	dc.b	' 'str4len		equ	*-str4ATPLength	equ	*-RespPacketReqBuffer	DS.B	600P8Name		str	'ProDOS 8'GSOSName	str	'GS/OS   'UnKnownName	str	'Unknown '		ENDP;**********************************************************************************		END