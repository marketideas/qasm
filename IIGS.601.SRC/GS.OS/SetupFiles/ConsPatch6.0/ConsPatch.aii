** ConsPatch.aii - INIT to fix bugs in the System 6.0 Console Driver** written by Greg Branche** Copyright (c) 1992* Apple Computer, Inc.* All Rights Reserved*		include	'M16.GSOS'ptr		equ	1patch_version	equ	$3020new_version	equ	$3030version_addr	equ	$0040remove_trap	equ	$0678		;offset to remove_trap routinecout_addr	equ	$09C5		;offset to COut vectorcout_1_addr	equ	cout_addr+4keyin_addr	equ	$09E5		;offset to KeyIn vectorkeyin_1_addr	equ	keyin_addr+4start		Proc		Import	consPatch				bra	consPatch		EndPdevName		Record		dc.w	8		dc.b	'.CONSOLE'dNumParms	Record		dc.w	2		dc.l	devNamedevNum		dc.w	0dInfoParms	Record		dc.w	7		;pCountdevNum		dc.w	0		;devNum		dc.l	0		;devName (NULL pointer)		dc.w	0		;characteristics		dc.l	0		;totalBlocks		dc.w	0		;slotNum		dc.w	0		;unitNumversion		dc.w	0		;versionopenParms	RecordpCount		dc.w	2		;pCountrefnum		dc.w	0		dc.l	devNamestatList	RecordcOutVector	dc.l	0keyInVector	dc.l	0dStatusParms	Record		dc.w	5		;pCountdevNum		dc.w	0		;devNum		dc.w	$8007		;GetVectors code		dc.l	statList		dc.l	8		;requestCount		dc.l	0		;transferCountconsPatch	Proc		phb			;set DBR properly		phk		plb				phd			;make local direct page		pha			;space for pointer		pha		tsc		tcd; determine device number for .Console driver		_GetDevNumberGS dNumParms		bcs	@to_skip_it	;huh???		lda	dNumParms.devNum		sta	dInfoParms.devNum		sta	dStatusParms.devNum; make a DInfo call to ensure we're looking at the buggy driver		_DInfoGS dInfoParms		bcs	@to_skip_it	;huh???				lda	dInfoParms.version		cmp	#patch_version		sec		bne	@to_skip_it	;not correct version number, skip it; OK, we've got the right driver.  Now get the vector addresses		_OpenGS openParms	;first we have to open the driver		bcc	@no_problems@to_skip_it		brl	skip_it@no_problems		_DStatusGS dStatusParms	;get the vector values		bcs	close_skip	;huh???; Calculate the beginning address of the driver; (makes it easier to look up the addresses in the listing)		lda	statList.cOutVector		sec		sbc	#cout_addr	;calculate beginning of driver segment		sta	ptr		;store into pointer		lda	statList.cOutVector+2		sta	ptr+2		; Look at the current values at remove_trap to make sure the bug is still there		ldy	#remove_trap+$15		lda	[ptr],y		;at lda #<char_out		sec		sbc	ptr		;calculate offset from beginning of driver		cmp	#$0a3d		sec		bne	close_skip	;no match, skip it		ldy	#remove_trap+$21		lda	[ptr],y		;at lda #<read_key		sec		sbc	ptr		cmp	#$155e		sec		bne	close_skip; OK, the incorrect values are still there.  Fix 'em		lda	statList.cOutVector		clc		adc	#4		;proper address is just after vector		ldy	#remove_trap+$15		sta	[ptr],y		;at lda #<char_out (should have been lda #<cout_1)		ldy	#cout_addr+1	;patch the vector directly too		sta	[ptr],y		sep	#$20		;8-bit mode		lda	statList.cOutVector+2	;get bank byte		rep	#$20		xba			;put bytes into proper order		ldy	#remove_trap+$1b		sta	[ptr],y		;at lda #char_out>>8		ldy	#cout_addr+2		sta	[ptr],y				lda	statList.keyInVector		clc		adc	#4		ldy	#remove_trap+$21		sta	[ptr],y		;at lda #<read_key (should have been lda #<keyin_1)		ldy	#keyin_addr+1		sta	[ptr],y		sep	#$20		lda	statList.keyInVector+2		rep	#$20		xba		ldy	#remove_trap+$27		sta	[ptr],y		;at lda #read_key>>8		ldy	#keyin_addr+2		sta	[ptr],y; now we can update the version number stored in the DIB		ldy	#version_addr		lda	#new_version		sta	[ptr],y		clcclose_skip		php			;save carry		lda	#1		;set the proper pCount		sta	openParms.pCount		_CloseGS openParms		plp			;retrieve original carry		bcc	no_errorskip_it		ldx	#$2C03		;SysBeep		jsl	$E10000no_error		pla			;clean up stack		pla		pld		plb		rtl			;done		EndP		End